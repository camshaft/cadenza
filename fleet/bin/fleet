#!/usr/bin/env bash
# fleet — the first-class window-env command for the fleet verbs (operator seq-987 "foolproof tooling").
# Agents run `fleet inbox` / `fleet heartbeat` / `fleet send …` / `fleet sync` with NO `cargo xtask`
# prefix. Combined with the name-autodetect (fleet inbox/heartbeat default to the CALLING window's agent
# via $TMUX_PANE → window name, landed in the xtask), the command "always does the right thing" — it is
# impossible to glob the wrong (shadow) inbox path or forget the calling identity. This structurally kills
# the stale-prompt / shadow-glob drain-stall class rather than relying on the tick prompt's conventions.
#
# This is a thin, self-contained shim: the fleet HUB is a BARE repo (no Cargo workspace), so it resolves a
# real worktree and runs `cargo xtask fleet "$@"` there. REBUILD-FROM-SOURCE off the FRESHEST-HEAD worktree
# so the fleet logic is always the newest landed code (the same deploy-gap discipline as
# compact-nudge.sh/watchdog.sh — an agent's `fleet` must not run a stale binary), with a prebuilt-binary
# FALLBACK if cargo is unavailable. `$TMUX_PANE` is inherited by the child, so the calling agent's identity
# autodetect works regardless of which worktree we run cargo from.
#
# NOTE: this file is the COMMAND. Wiring `fleet/bin` onto each agent's PATH is a SEPARATE step
# (window.sh / refresh-tools.sh); until that lands this shim is inert (agents keep using `cargo xtask`).
#
# TRACKED at <repo>/fleet/bin/fleet; `fleet up` materializes it into <hub>/.claude/fleet/bin/fleet, which
# is what ends up on PATH. Both locations sit at `<…>/fleet/bin/`, so the worktrees dir is `../../worktrees`.
set -uo pipefail

# cron/non-interactive shells can have a minimal PATH lacking cargo; prepend the toolchain dirs (the #8989
# lesson — validate wrappers under `env -i PATH=/usr/bin:/bin`, not just an interactive shell).
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"

# Resolve THIS script's REAL path first: refresh-tools.sh SYMLINKS it into ~/.local/bin/fleet (onto the
# agent's PATH), so `${BASH_SOURCE[0]}` may be that symlink. `readlink -f` follows it back to the real
# hub file, so the walk-up below anchors at the actual `.claude` tree — NOT ~/.local/bin (which has no
# `worktrees/` ancestor). Falls back to the raw path if readlink is unavailable.
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
BIN_DIR="$(cd "$(dirname "$SELF")" && pwd)"     # real …/fleet/bin

# Locate the fleet worktrees dir by walking UP from this script to the nearest ancestor that contains a
# `worktrees/` subdir (the `.claude` root). This is robust to WHERE the shim runs from: the materialized
# hub copy (`.claude/fleet/bin`) and a tracked worktree copy (`.claude/worktrees/<agent>/fleet/bin`) have
# DIFFERENT relative paths to `worktrees/`, so a fixed `../worktrees` would only work for one of them.
WORKTREES=""
_d="$BIN_DIR"
while [ "$_d" != "/" ]; do
  if [ -d "$_d/worktrees" ]; then WORKTREES="$_d/worktrees"; break; fi
  _d="$(dirname "$_d")"
done

if [ -z "${WORKTREES:-}" ] || [ ! -d "$WORKTREES" ]; then
  echo "fleet: could not locate a fleet worktrees/ dir above $BIN_DIR (a 'fleet up' provides one)." >&2
  exit 127
fi

# Pick the worktree to BUILD xtask from. We want the newest LANDED fleet code — so prefer the FRESHEST-HEAD
# worktree whose HEAD is on the main line (== or ancestor-of origin/main), NOT merely the freshest by commit
# time: a peer's diverged FEATURE branch (e.g. a design/vms branch) can have the most recent commit yet an
# xtask/ that is BEHIND origin/main, and building from it would run STALE fleet logic for every `fleet`
# caller (the stale-binary trap that has repeatedly made tooling look buggy). Fall back to the overall
# freshest only if NONE are on the main line (e.g. all forked/ahead). Mirrors stage-oracle-lean.sh's
# freshest-at/behind-origin-main selection. (Object store is shared, so origin/main resolves the same
# everywhere; read it from the first Cargo worktree.)
main_sha=""
for wt in "$WORKTREES"/*/; do
  [ -f "${wt}xtask/Cargo.toml" ] || continue
  main_sha="$(git -C "$wt" rev-parse --verify -q origin/main 2>/dev/null || true)"
  [ -n "$main_sha" ] && break
done
best="" best_ct=-1 fallback="" fallback_ct=-1
for wt in "$WORKTREES"/*/; do
  [ -f "${wt}xtask/Cargo.toml" ] || continue
  head="$(git -C "$wt" rev-parse --verify -q HEAD 2>/dev/null || true)"; [ -n "$head" ] || continue
  ct="$(git -C "$wt" show -s --format=%ct HEAD 2>/dev/null || echo 0)"
  [ "$ct" -gt "$fallback_ct" ] && { fallback_ct="$ct"; fallback="$wt"; }
  if [ -n "$main_sha" ] && { [ "$head" = "$main_sha" ] || git -C "$wt" merge-base --is-ancestor "$head" "$main_sha" 2>/dev/null; }; then
    [ "$ct" -gt "$best_ct" ] && { best_ct="$ct"; best="$wt"; }
  fi
done
best="${best:-$fallback}"

if [ -z "$best" ]; then
  echo "fleet: no worktree with an xtask Cargo project under $WORKTREES (a 'fleet up' provides one)." >&2
  exit 127
fi

# Primary: rebuild-from-source (always current). Fallback: the freshest worktree's prebuilt binary (may be
# slightly stale, but WORKS) if cargo is unresolvable — degrade gracefully, never leave `fleet` dark.
# `exec` so the exit code propagates cleanly and no wrapper process lingers.
# Build the FRESHEST xtask (newest landed fleet logic) in a SUBSHELL — so our OWN cwd stays the CALLER's —
# then exec that binary FROM the caller's cwd. This decouples WHAT to build (freshest source, the deploy-gap
# discipline) from WHERE to run (the caller's own worktree). CRITICAL for cwd-scoped verbs: `fleet sync`
# operates on `git rev-parse HEAD` of its cwd, so the OLD `cd "$best" && cargo xtask` ran `sync` in the
# FRESHEST worktree instead of the caller's — silently syncing the WRONG worktree and stranding the caller's
# own branch (v-hivemind-deploy 2026-09-20: correct cwd + no GIT_DIR, yet sync moved a different worktree).
# Agent-scoped verbs (inbox/heartbeat/send, keyed on $TMUX_PANE, inherited by the child) are cwd-independent,
# so running them from the caller's cwd is equally correct. `--profile release` matches the `xtask` alias.
if command -v cargo >/dev/null 2>&1 \
   && ( cd "$best" && cargo build -q --package xtask --profile release ) \
   && [ -x "${best}target/release/xtask" ]; then
  exec "${best}target/release/xtask" fleet "$@"
elif [ -x "${best}target/release/xtask" ]; then
  # cargo unavailable OR the freshest-source build failed → the freshest prebuilt binary (may be slightly
  # stale but WORKS), still run from the caller's cwd. Degrade gracefully, never leave `fleet` dark.
  exec "${best}target/release/xtask" fleet "$@"
else
  echo "fleet: cargo unavailable AND no prebuilt ${best}target/release/xtask — run a fleet build first." >&2
  exit 127
fi
