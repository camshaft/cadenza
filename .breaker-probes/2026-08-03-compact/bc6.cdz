(do
  (def (main (: k Int64))
    (let ((rope (Bytes.concat (Bytes.of (list (UInt8.wrap 65))) (Bytes.of (list (UInt8.wrap 66))))))
      (let ((flat (Bytes.compact rope)))
        (+ (if (= rope flat) 1 0)
           (* 10 (if (< rope (Bytes.concat flat (Bytes.of (list (UInt8.wrap 67))))) 1 0))))))
  (def (go) (main 0))
  (export go))
