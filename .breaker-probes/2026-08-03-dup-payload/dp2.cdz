(do
  (type Pair (Mk (List Int64) (List Int64)))
  (def (swap (: p Pair))
    (match p ((Mk a b) (Mk b a))))
  (def (main (: k Int64))
    (let ((xs (list k)))
      (let ((p (Mk xs xs)))
        (match (swap (swap p))
          ((Mk a b)
            (+ (match (List.at a 0) ((Some v) v) ((None _u) -1))
               (* 10 (match (List.at b 0) ((Some v) v) ((None _u) -1)))))))))
  (def (go) (main 7))
  (export go))
