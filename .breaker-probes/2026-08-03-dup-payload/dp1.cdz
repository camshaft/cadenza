(do
  (def (f (: p (Tuple Int64 (List Int64))))
    (match p
      ((tuple n xs) (+ n (List.len xs)))))
  (def (main (: k Int64))
    (let ((shared (list k (+ k 1))))
      (let ((p1 (tuple 10 shared))
            (p2 (tuple 20 shared)))
        (+ (f p1)
           (+ (* 10 (f p2))
              (* 1000 (match (List.at shared 0) ((Some v) v) ((None _u) -1))))))))
  (def (go) (main 5))
  (export go))
