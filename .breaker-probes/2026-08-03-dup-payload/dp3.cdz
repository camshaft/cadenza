(do
  (type Pair (Mk (List Int64) (List Int64)))
  (def (consume-left (: p Pair))
    (match p ((Mk a _b) (List.push a 99))))
  (def (main (: k Int64))
    (let ((xs (list k)))
      (let ((p (Mk xs xs)))
        (let ((grown (consume-left p)))
          (+ (List.len grown)
             (* 10 (match p ((Mk _a b) (List.len b)))))))))
  (def (go) (main 7))
  (export go))
