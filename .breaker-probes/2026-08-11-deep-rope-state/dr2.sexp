(case "dr2 the 100-deep rope state CONTENT is exact — the drain slices head, seam, and tail windows"
  (input  (do
            (effect S (op add (-> Int64)) (op dump (-> String)))
            (def (walk (: k Int64))
              (if (< k 1) 0 (let ((_d (S.add))) (walk (- k 1)))))
            (def (win (: t String) (: i Int64))
              (match (String.slice t i (+ i 2))
                ((Some w) (String.byte-len w))
                ((None _u) -1)))
            (def (main (: n Int64))
              (handle S "x"
                ((add () s (resume 0 (String.concat s "ab")))
                 (dump () s (resume s s)))
                (let ((_w (walk n)))
                  (let ((t (S.dump)))
                    (+ (* 10000 (String.byte-len t))
                       (+ (* 100 (win t 0))
                          (+ (* 10 (win t (- (String.byte-len t) 2)))
                             (win t (- (String.byte-len t) 1)))))))))
            (export main)))
  (call   main (: 100 Int64)) (output (: 2010219 Int64))
  (call   main (: 5 Int64)) (output (: 110219 Int64)))
