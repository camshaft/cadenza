@test
def list-push-grows-len(n: Int64, v: Int64) =
  let base = [rem-euclid(n, 10), rem-euclid(v, 10)] in
  let grown = List.push(base, v) in
  if List.len(grown) == List.len(base) + 1 then unit else trap("push grows len by 1")

def rem-euclid(a: Int64, m: Int64) =
  let r = a % m in
  if r < 0 then r + m else r

@test
def set-insert-idempotent(x: Int64) =
  let s = Set.of([rem-euclid(x, 7)]) in
  if Set.len(Set.insert(s, rem-euclid(x, 7))) == 1 then unit else trap("re-insert is idempotent")
