def rem-euclid(a: Int64, m: Int64) =
  let r = a % m in
  if r < 0 then r + m else r

@test
def map-insert-lookup-roundtrip(k: Int64, v: Int64) =
  let key = rem-euclid(k, 1000) in
  let m = Map.insert(Map.empty, key, v) in
  match Map.lookup(m, key) with
    | Option.Some(got) => (if got == v then unit else trap("lookup returns the inserted value"))
    | Option.None(_) => trap("inserted key must be present")

@test
def concat-assoc(a: Int64, b: Int64, c: Int64) =
  let xs = [rem-euclid(a, 9)] in
  let ys = [rem-euclid(b, 9)] in
  let zs = [rem-euclid(c, 9)] in
  if List.concat(List.concat(xs, ys), zs) == List.concat(xs, List.concat(ys, zs))
  then unit else trap("concat is associative")

@test
def set-union-commutes(a: Int64, b: Int64) =
  let s1 = Set.of([rem-euclid(a, 6), rem-euclid(b, 6)]) in
  let s2 = Set.of([rem-euclid(b, 6), rem-euclid(a, 6)]) in
  if Set.union(s1, s2) == Set.union(s2, s1) then unit else trap("union commutes")
