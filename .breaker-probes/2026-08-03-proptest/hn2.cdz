def rem-euclid(a: Int64, m: Int64) =
  let r = a % m in
  if r < 0 then r + m else r

@test
def concat-scalar-len-additive-or-less(a: Int64) =
  // NFC can COMPOSE at the seam: scalar-len(concat) <= len(a)+len(b); byte-len likewise.
  let left = if rem-euclid(a, 2) == 0 then "abc" else "xé" in
  let joined = String.concat(left, "z") in
  if String.scalar-len(joined) <= String.scalar-len(left) + 1
  then unit else trap("concat scalar-len is at most additive")

@test
def concat-preserves-prefix-scalars(a: Int64) =
  // the LEFT operand's scalars survive a concat unless the seam composes
  let left = if rem-euclid(a, 2) == 0 then "ab" else "é!" in
  let joined = String.concat(left, "tail") in
  match String.at(joined, 0) with
    | Option.Some(c0) => (match String.at(left, 0) with
        | Option.Some(l0) => (if c0 == l0 then unit else trap("first scalar survives"))
        | Option.None(_) => trap("left nonempty"))
    | Option.None(_) => trap("joined nonempty")
