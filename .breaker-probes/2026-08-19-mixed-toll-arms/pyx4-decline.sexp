(case "pyx4 probe" (input (do
  (effect E (op tick (-> Int64)) (op poke (-> Int64 Int64)))
  (def (main (: n Int64))
    (handle E (% n 3)
      ((tick () s (+ (resume (* s 10) (+ s 1)) (* 1000 s)))
       (poke (v) s (resume (+ s v) (+ s v))))
      (+ (E.tick)
         (+ (* 10 (E.poke 7))
            (* 100 (E.tick))))))
  (export main)))
  (call   main (: 10 Int64)) (output (: 999999 Int64))
  (call   main (: 0 Int64)) (output (: 999998 Int64)))
