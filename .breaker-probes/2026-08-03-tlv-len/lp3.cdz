(do
  (def (main (: k UInt8))
    (let ((framed (bin (u8 7) (u16 2) (bytes (Bytes.of (list k (UInt8.wrap 2) (UInt8.wrap 3)))))))
      (match framed
        ((bin (u8 7) (u16 n) (bytes body n))
          (+ (Int64.of n) (* 10 (Bytes.len body))))
        ((bin (u8 7) (u16 n) (bytes body n) (bytes _rest))
          (+ 1000 (Int64.of n)))
        (_ -1))))
  (def (go) (main 5))
  (export go))
