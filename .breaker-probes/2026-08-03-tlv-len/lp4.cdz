(do
  (def (main (: k Int64))
    (let ((data (String.to-bytes (String.concat "ab" (if (> k 100) "zz" "cde")))))
      (match (bin (u8 9) (u16 (UInt16.of (Bytes.len data))) (bytes data))
        ((bin (u8 9) (u16 n) (bytes body n))
          (match (String.from-bytes body)
            ((Some s) (+ (Int64.of n) (* 10 (String.byte-len s))))
            ((None _u) -1)))
        (_ -2))))
  (def (go) (main 5))
  (export go))
