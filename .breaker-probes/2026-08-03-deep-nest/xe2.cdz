(do
  (def (main (: k Int64))
    (let ((deep (tuple (list (record (x k) (tag "a"))
                             (record (x (+ k 1)) (tag "b")))
                       (Map.insert Map.empty "key" (Set.of (list k (+ k 1)))))))
      (match deep
        ((tuple recs m)
          (+ (match (List.at recs 1) ((Some r) (. r x)) ((None _u) -1))
             (* 10 (match (Map.lookup m "key") ((Some s) (Set.len s)) ((None _u) -1))))))))
  (def (go) (main 5))
  (export go))
