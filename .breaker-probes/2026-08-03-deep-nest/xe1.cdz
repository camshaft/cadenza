(do
  (type T (A (Map Int64 (List Int64))) (B))
  (def (main (: k Int64))
    (let ((v1 (A (Map.insert Map.empty k (list k (+ k 1)))))
          (v2 (A (Map.insert Map.empty k (list k (+ k 1)))))
          (v3 (A (Map.insert Map.empty k (list k (+ k 2))))))
      (+ (if (= v1 v2) 1 0)
         (+ (* 10 (if (= v1 v3) 1 0))
            (* 100 (if (= v1 (B)) 1 0))))))
  (def (go) (main 5))
  (export go))
