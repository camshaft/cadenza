(case "pv2 the arm ALTERNATES prepend and append by payload parity — both rope ends grow, first and last bytes pin the ends"
  (input  (do
            (effect S (op add (-> Int64 Int64)) (op dump (-> String)))
            (def (walk (: k Int64))
              (if (< k 1) 0 (let ((_d (S.add k))) (walk (- k 1)))))
            (def (digit (: v Int64))
              (if (= v 1) "a" (if (= v 2) "b" (if (= v 3) "c" (if (= v 4) "e" "d")))))
            (def (first-byte (: t String))
              (match (Bytes.at (String.to-bytes t) 0) ((Some b) b) ((None _u) -1)))
            (def (last-byte (: t String))
              (match (Bytes.at (String.to-bytes t) (- (String.byte-len t) 1)) ((Some b) b) ((None _u) -1)))
            (def (main (: n Int64))
              (handle S ""
                ((add (v) s (resume 0 (if (= (% v 2) 0)
                                          (String.concat s (digit v))
                                          (String.concat (digit v) s))))
                 (dump () s (resume s s)))
                (let ((_w (walk n)))
                  (let ((t (S.dump)))
                    (+ (* 100000 (String.byte-len t))
                       (+ (* 1000 (- (first-byte t) 90)) (- (last-byte t) 90)))))))
            (export main)))
  (call   main (: 4 Int64)) (output (: 407008 Int64))
  (call   main (: 3 Int64)) (output (: 307008 Int64)))
