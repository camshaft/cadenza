(do
  (def (main (: k Int64))
    (let ((s (String.concat "abc" "defgh")))
      (match (String.slice s k 6)
        ((Some t)
          (let ((b (String.to-bytes t)))
            (match (Bytes.slice b 1 3)
              ((Some v) (+ (match (Bytes.at v 0) ((Some x) x) ((None u) 0))
                           (match (Bytes.at v 1) ((Some y) y) ((None u) 0))))
              ((None u) -1))))
        ((None u) -2))))
  (def (go) (main 2))
  (export go))
