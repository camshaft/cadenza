/// BLOCKED WITNESS (2026-07-14, iter 42) — a SCOPE / FREE-VARIABLE resolver over the canonical homoiconic
/// `Ast` (imported from `ast`), counting FREE `Name`s under a `Set String` of bound names. It `cdz check`s
/// CLEAN and its `fn`-binder + leaf tests PASS, but the `let`-binder tests FAIL: the still-live-binding
/// family strikes when `free-count` matches `node` binding `elems` and passes `elems` to `free-let`, which
/// does `Set.insert(scope, x)` then two recursive `free-count` calls — the shared `elems` payload is
/// corrupted through the recursion, so the extended scope's bindings are LOST (`free-vars (let ((x 5)) (+
/// x x))` → 3 not 1; the bound `x`s read as free). Even the SINGLE-FUNCTION index-based walk here (chosen
/// to avoid the mutual `check`/`check-list` corruption — see
/// `miscompile-node-payload-consumed-by-mutual-recursion-corrupts-sibling-read.cdz`) still loses the scope
/// once a `let` binder inserts into it and recurses. So a resolver over the canonical Ast cannot yet be
/// written; WITHHELD from `src/` so the running suite stays green. Same root as the whole still-live
/// family (a value read after its payload/an extended collection is consumed needs a `dup` the recursion
/// arg path omits). Kept here as the resolver a working seed would run.

/// (inlined here — the canonical `Ast`; in `src/` this would `import { Ast } from "ast"`, but a repro
/// under `repros/` has no sibling `ast.cdz` to resolve, so the type is inlined to keep it self-contained.)
type Ast =
  | Int(Int64)
  | Str(String)
  | Bool(Bool)
  | Name(String)
  | List(List(Ast))

/// The `Name` at position `i` of `elems`, or None. (Used to read a binder head/param without consuming
/// the list — `List.at` borrows.)
def name-at(elems: List(Ast), i: Int64) = match List.at(elems, i) with
  | Option.Some(Ast.Name(n)) => Some(n)
  | _ => None(unit)

/// The child `Ast` at position `i`, or a Unit-Int sentinel (never a Name, so it contributes 0).
def child-at(elems: List(Ast), i: Int64) = match List.at(elems, i) with
  | Option.Some(c) => c
  | Option.None(_) => Ast.Int(0)

/// Count free (unbound) Name occurrences in `node` under `scope`.
///   • an `Int`/`Str`/`Bool` leaf contributes 0;
///   • a `Name` contributes 1 unless it is in `scope`;
///   • a `List` dispatches on its head Name: `let`/`fn` bind, everything else is a generic form whose
///     children are all checked under the same scope (walked by index, keeping `node` live).
def free-count(scope: Set(String), node: Ast) = match node with
  | Ast.Int(_) => 0
  | Ast.Str(_) => 0
  | Ast.Bool(_) => 0
  | Ast.Name(x) => (if Set.contains(scope, x) then 0 else 1)
  | Ast.List(elems) => (match name-at(elems, 0) with
    | Some(h) => (if h == "let" then free-let(scope, elems)
                  else (if h == "fn" then free-fn(scope, elems)
                  else free-generic(scope, elems, 0, 0)))
    | None(_) => free-generic(scope, elems, 0, 0))

/// A generic form: sum the free counts of every child (index walk; `elems` read via borrowing `List.at`).
def free-generic(scope: Set(String), elems: List(Ast), i: Int64, acc: Int64) =
  if i == List.len(elems) then
    acc
  else
    free-generic(scope, elems, i + 1, acc + free-count(scope, child-at(elems, i)))

/// `(let ((x <val>)) <body>)` — element 1 is the bindings clause `((x <val>))`, element 2 the body. Bind
/// `x` (from the binding pair's head Name) for BOTH the RHS and the body (recursive-let scoping).
def free-let(scope: Set(String), elems: List(Ast)) =
  match binding-name(child-at(elems, 1)) with
    | Some(x) =>
      let inner = Set.insert(scope, x) in
      free-count(inner, binding-val(child-at(elems, 1))) + free-count(inner, child-at(elems, 2))
    | None(_) => free-generic(scope, elems, 0, 0)

/// From a bindings clause `((x <val>))` (a `List` holding one `(x <val>)` pair), the bound name `x`.
def binding-name(clause: Ast) = match clause with
  | Ast.List(pairs) => (match child-at(pairs, 0) with
    | Ast.List(pair) => name-at(pair, 0)
    | _ => None(unit))
  | _ => None(unit)

/// From a bindings clause, the RHS value `<val>` (element 1 of the pair).
def binding-val(clause: Ast) = match clause with
  | Ast.List(pairs) => (match child-at(pairs, 0) with
    | Ast.List(pair) => child-at(pair, 1)
    | _ => Ast.Int(0))
  | _ => Ast.Int(0)

/// `(fn (p…) <body>)` — element 1 is the params list, element 2 the body. Bind every param Name.
def free-fn(scope: Set(String), elems: List(Ast)) =
  match child-at(elems, 1) with
    | Ast.List(params) =>
      let inner = bind-params(scope, params, 0) in
      free-count(inner, child-at(elems, 2))
    | _ => free-generic(scope, elems, 0, 0)

/// Insert every parameter Name from `params` into `scope` (index walk, keeping `params` live).
def bind-params(scope: Set(String), params: List(Ast), i: Int64) =
  if i == List.len(params) then
    scope
  else
    (match name-at(params, i) with
      | Some(p) => bind-params(Set.insert(scope, p), params, i + 1)
      | None(_) => bind-params(scope, params, i + 1))

/// The number of free variables under the empty scope.
def free-vars(node: Ast) = free-count(Set.of([]), node)

/// Is `node` closed (no free variables)?
def is-closed(node: Ast) = free-vars(node) == 0

/// Builders for readable tests.
def nm(s: String) = Ast.Name(s)
def lst(xs: List(Ast)) = Ast.List(xs)
def mk-let(x: String, val: Ast, body: Ast) = lst([nm("let"), lst([lst([nm(x), val])]), body])
def mk-fn1(p: String, body: Ast) = lst([nm("fn"), lst([nm(p)]), body])
def plus(a: Ast, b: Ast) = lst([nm("+"), a, b])

@test
def sc-literal-closed() = if is-closed(Ast.Int(5)) then unit else trap("a literal is closed")

@test
def sc-free-name() = if free-vars(nm("x")) == 1 then unit else trap("bare x is free")

@test
def sc-let-binds() =
  // (let ((x 5)) (+ x x)) — x bound, + free → 1 free
  let e = mk-let("x", Ast.Int(5), plus(nm("x"), nm("x"))) in
  if free-vars(e) == 1 then unit else trap("only + is free in let x=5 in x+x")

@test
def sc-let-body-unbound() =
  // (let ((x 5)) (+ x y)) — y free, + free → 2
  let e = mk-let("x", Ast.Int(5), plus(nm("x"), nm("y"))) in
  if free-vars(e) == 2 then unit else trap("y and + are free")

@test
def sc-fn-binds-param() =
  // (fn (y) (+ y 1)) — y bound, + free → 1
  let e = mk-fn1("y", plus(nm("y"), Ast.Int(1))) in
  if free-vars(e) == 1 then unit else trap("only + free in fn y")

@test
def sc-fn-body-unbound() =
  // (fn (y) (+ y z)) — z free, + free → 2
  let e = mk-fn1("y", plus(nm("y"), nm("z"))) in
  if free-vars(e) == 2 then unit else trap("z and + free")

@test
def sc-nested-shadowing() =
  // (let ((x 1)) (fn (x) x)) — inner fn's x shadows; body x bound → 0 free
  let e = mk-let("x", Ast.Int(1), mk-fn1("x", nm("x"))) in
  if free-vars(e) == 0 then unit else trap("shadowed x is bound, 0 free")

@test
def sc-outer-visible-inside() =
  // (let ((x 1)) (fn (y) (+ x y))) — x + y bound, + free → 1
  let e = mk-let("x", Ast.Int(1), mk-fn1("y", plus(nm("x"), nm("y")))) in
  if free-vars(e) == 1 then unit else trap("x visible inside fn; only + free")

@test
def sc-rhs-sees-binding() =
  // (let ((x x)) x) — recursive-let: RHS x and body x both bound → 0 free
  let e = mk-let("x", nm("x"), nm("x")) in
  if free-vars(e) == 0 then unit else trap("recursive-let: RHS x is bound")

@test
def sc-deep-nested-frees() =
  // (+ (let ((a 1)) a) (fn (b) (+ b c))) — a,b bound; c free; two + free → 3
  let e = plus(mk-let("a", Ast.Int(1), nm("a")), mk-fn1("b", plus(nm("b"), nm("c")))) in
  if free-vars(e) == 3 then unit else trap("c + outer-+ + inner-+ = 3 free")

export { free-vars, is-closed }

