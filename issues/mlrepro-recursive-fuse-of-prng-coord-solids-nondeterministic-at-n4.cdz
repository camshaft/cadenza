// mlrepro — a RECURSIVE fold building a `fuse` (Union) tree of Solids whose coordinates come from a PRNG
// becomes NONDETERMINISTIC across two IDENTICAL calls once the tree has ~5 leaves (n=4 children + base).
// n=3 passes, n=4 FAILS. Same seed, same pure function → different bounding box. A pure Int64 fold over the
// same PRNG draws (no geometry) is deterministic (see zzrec-nogeo below), and a NON-recursive 2-piece build
// is deterministic — so the trigger is RECURSION × building a `Solid`/heap tree from the draws, at size ≥4.
//
// Impact: blocks v-cad's procedural snowflake (a recursive branch builder — many fused PRNG-placed pieces).
// The geometry math itself is exact/pure; something in the recursive build of the heap `Solid` tree (fuse
// nesting? rope/CHAMP canonicalization? a stale slot reused across the self-call?) diverges run-to-run.
//
// SMELL: this looks like the "impure/nondeterministic behavior in a pure function" miscompile class — a
// value that should be recomputed identically is instead reading stale/reused heap state as the fused tree
// grows. NOT a PRNG bug (the draws are deterministic in isolation) and NOT a bbox bug (bbox is a pure fold).

@!default-fraction Rational

import { Solid, Vec3, Aabb, bounding-box } from "exact"
import { box, fuse, move-x } from "helpers"
import { seed, roll } from "prng"

// Build a Union of `n` boxes, each shifted in +x by a PRNG draw derived from (seed0, i). No tuple-state
// threading — each draw is a fresh reseed on the index, so the function is manifestly pure in seed0.
def go(seed0: Int64, n: Int64, i: Int64, acc: Solid(Rational)) =
  if i == n then acc
  else
    let d = roll(seed(seed0 + i), (10 : Int64)) in
    let piece = move-x(Rational.of(d + (1 : Int64), (1 : Int64)), box(1 / 1, 1 / 1, 1 / 1)) in
    go(seed0, n, i + (1 : Int64), fuse(acc, piece))

def x-width(s: Solid(Rational)) =
  match bounding-box(s) with | Aabb.Box(lo, hi) =>
    (match lo with | Vec3.V3(lx, _, _) => (match hi with | Vec3.V3(hx, _, _) => hx - lx))

def det(n: Int64) =
  let a = go((42 : Int64), n, (0 : Int64), box(1 / 1, 1 / 1, 1 / 1)) in
  let b = go((42 : Int64), n, (0 : Int64), box(1 / 1, 1 / 1, 1 / 1)) in
  if x-width(a) == x-width(b) then unit else trap("same seed → different geometry (MISCOMPILE)")

@test
def n3-is-deterministic() = det((3 : Int64))       // PASSES

@test
def n4-is-deterministic() = det((4 : Int64))       // FAILS — the miscompile

// Control: the SAME recursion summing the draws (no geometry) is deterministic → isolates the bug to the
// recursive heap-Solid build, not the PRNG or the recursion shape.
def sum-go(seed0: Int64, n: Int64, i: Int64, acc: Int64) =
  if i == n then acc else sum-go(seed0, n, i + (1 : Int64), acc + roll(seed(seed0 + i), (10 : Int64)))

@test
def n4-sum-is-deterministic-control() =
  if sum-go((42 : Int64), (4 : Int64), (0 : Int64), (0 : Int64))
     == sum-go((42 : Int64), (4 : Int64), (0 : Int64), (0 : Int64))
  then unit else trap("control should be deterministic")

export { go, det }
