// VERIFIED single-task DES Sim scheduler in the ML surface (cdz convert from the delivered s-expr;
// compiled to wasm + ran → 5000000000 on trunk, tick 149). Basis for the importable DES module
// (implementation/des/) the concierge directed (answer 9978): package this so v-music imports it
// instead of inlining def-sets. NEXT: wrap as a project (Project.cdz entry+tests) + add @test nullary
// cases (a @test PASSES by returning unit, FAILS by trapping) + wire into `cdz test`/`xtask check`.
// KNOWN: `wake` param unused in this minimal form (CDZ0306 warning) — the real module threads it as the
// clock advance; keep the (resume unit wake) form (that IS the clock-at-apply contract).

type Instant =
  | Instant(UInt64)

def inst-ns(t: Instant) = match t with
  | Instant.Instant(n) => n

effect Sim =
  | sleep : Instant -> Unit
  | now : Unit -> Instant

def scheduler-step(wake: Instant, resume-thunk) = resume-thunk(unit)

def run-one() =
  handle Sim(Instant.Instant(0)) with
    | now(u, s) => resume(s, s)
    | sleep(wake, s) => scheduler-step(wake, fn(_u) => resume(unit, wake))
  in
  (
    Sim.sleep(Instant.Instant(5000000000));
    inst-ns(Sim.now())
  )

export { run-one }
