/// ML SURFACE / RESOLVER BUG (2026-07-15, seed rcdzc, iter 45). A DOTTED nullary-variant pattern (`T.LP`)
/// used as a match ARM whose body contains a NESTED match on a value of the SAME sum type `T` is
/// mis-resolved as MEMBER ACCESS: CDZ0201 "member access requires a record — did you mean `LP`?".
/// `cdz check` FAILS. A residual of the iter-24/25 nested-nullary-pattern bug (which a sibling fixed for
/// the simpler nestings — a lone nested nullary arm, an intermediate irrefutable arm, a mixed-scrutinee
/// nest all `cdz check` CLEAN now); THIS combination still bites.
///
///   type T = Num(Int64) | LP | RP | End
///   match tok with
///     | T.Num(v) => …                                  -- payload arm: FINE
///     | T.LP => (match tok2 with | T.Num(m) => m | _ => …)   -- DOTTED nullary arm whose body nests a
///                                                             -- match on another T → CDZ0201 on `T.LP`
///     | _ => …
///
/// SHARP (each necessary):
///   • the arm pattern is a DOTTED nullary variant `T.LP` — the BARE-name form `LP` in the same position
///     `cdz check`s CLEAN (the workaround);
///   • the arm's BODY contains a NESTED match on a value of the SAME sum type `T` — a nullary arm whose
///     body is a plain expr, or a nested match on a DIFFERENT (scalar) scrutinee, or an all-wildcard inner
///     match, all `cdz check` CLEAN;
///   • the OUTER arm is NULLARY — a payload arm (`T.Num(v)`) in the same shape is CLEAN.
/// So the resolver, when an arm's body opens a same-type sum match, retroactively treats a sibling DOTTED
/// nullary arm pattern as a `(. T LP)` member-access expression rather than a nullary-ctor pattern.
///
/// WORKAROUND: write nullary variant patterns with the BARE name (`LP`, `RP`, `End`) — no `T.` prefix.
/// (Hit organically building `src/parse-checked.cdz`: `Tok.TLP => (match tok(...) with | Tok.TRP => …)`
/// for the `'(' expr ')'` grammar rule declined; using bare `TLP`/`TRP` fixes it.)
///
/// This file uses the WORKING bare-name form so it CHECKS CLEAN (a regression witness); the rejected
/// dotted form is in the comment above.
type T =
  | Num(Int64)
  | LP
  | RP
  | End

def tok(xs: List(T), i: Int64) = match List.at(xs, i) with
  | Option.Some(t) => t
  | Option.None(_) => End

/// The `'(' Num ')'` shape: a nullary `LP` arm whose body nests a match on the next token (a `T`). Uses
/// BARE nullary names (`LP`/`RP`), the workaround. With dotted `T.LP`/`T.RP` this file would fail CDZ0201.
def paren-num(xs: List(T), i: Int64) = match tok(xs, i) with
  | Num(v) => v
  | LP => (match tok(xs, i + 1) with
    | Num(m) => (match tok(xs, i + 2) with
      | RP => m + 1000
      | _ => 0 - 5)
    | _ => 0 - 6)
  | _ => 0 - 1

@test
def bare-nullary-nested-match-works() =
  // "( 7 )" → 7 + 1000 = 1007 via the bare-name nullary arms
  if paren-num([LP, Num(7), RP], 0) == 1007 then unit else trap("(7) → 1007")

@test
def bare-nullary-plain-num() =
  if paren-num([Num(42)], 0) == 42 then unit else trap("42")

export { paren-num }
