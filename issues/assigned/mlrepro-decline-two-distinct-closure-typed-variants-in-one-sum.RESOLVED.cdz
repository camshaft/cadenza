/// REPRO (iterators vertical, 2026-07-15) — a sum type with TWO variants that each box a closure of a
/// DIFFERENT function type fails at LOWERING with "a runtime closure application has no matching function
/// type" the moment either closure is applied. `cdz check` PASSES; the failure is in lowering, so this is
/// a monomorphization / closure-dispatch gap, not a type rejection.
///
/// TRIGGER (minimized): ONE sum with
///   - a variant storing a BINARY closure `Int64 -> Int64 -> Int64` (here `ScanI`), and
///   - a variant storing a closure that RETURNS THE SUM ITSELF `Int64 -> Iter` (here `FlatMapI`),
/// where `next` APPLIES a boxed closure (`f(acc, v)` in the Scan arm, `f(x)` in the FlatMap arm). Running
/// any consumer that reaches an applied closure declines. The Scan arm alone (drop `FlatMapI`) compiles
/// and runs; the FlatMap arm alone compiles and runs; only the COEXISTENCE of the two distinctly-typed
/// boxed closures in one sum breaks — the shared closure-dispatch table cannot reconcile the two function
/// types.
///
/// DISCRIMINATORS (all verified):
///   - Two variants with distinct-arity closures NOT wrapped in a recursive-sum position compile+run
///     (`Box.Unary(Int64->Int64)` + `Box.Binary(Int64->Int64->Int64)`, applied — OK).
///   - A variant that merely STORES an `Int64 -> Iter` closure but never applies it compiles+run
///     alongside an applied `ScanI` — the returns-own-sum closure must actually be APPLIED to trigger.
///   - List-free (producer = `RangeI`) still reproduces, so it is not a `List`/`collect` interaction.
///
/// IMPACT: blocks composing lazy-iterator combinators whose closures differ in type — e.g. `scan`
/// (binary accumulator) coexisting with `flat-map` (element → sub-iterator). Each is fine alone; a
/// library that offers both cannot compile. Landed `scan` alone (safe); `flat-map` is gated on this fix.

type Iter =
  | RangeI(Tuple(Int64, Int64))
  | ScanI(Tuple((Int64 -> Int64 -> Int64), Tuple(Int64, Iter)))
  | FlatMapI(Tuple((Int64 -> Iter), Tuple(Iter, Iter)))

def next(it) = match it with
  | Iter.RangeI(r) => (match r with | (lo, hi) =>
    if lo < hi then Option.Some((lo, Iter.RangeI((lo + 1, hi)))) else Option.None(unit))
  | Iter.ScanI(sf) => (match sf with | (f, acc-src) => (match acc-src with | (acc, src) =>
    (match next(src) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(p) => (match p with | (v, rest) =>
          let acc2 = f(acc, v) in Option.Some((acc2, Iter.ScanI((f, (acc2, rest)))))))))
  | Iter.FlatMapI(ff) => (match ff with | (f, cur-src) => (match cur-src with | (cur, src) =>
    (match next(cur) with
      | Option.Some(p) => (match p with | (v, rest) => Option.Some((v, Iter.FlatMapI((f, (rest, src))))))
      | Option.None(_) => (match next(src) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(ps) => (match ps with | (x, srest) => next(Iter.FlatMapI((f, (f(x), srest)))))))))

def count(it) = match next(it) with
  | Option.None(_) => 0
  | Option.Some(p) => (match p with | (v, rest) => 1 + count(rest))

// APPLYING the boxed binary closure (scan) is enough to trip the shared closure-dispatch table
// because the sum ALSO contains the distinctly-typed `Int64 -> Iter` (FlatMapI) closure.
@test
def scan-counts() =
  if count(Iter.ScanI((fn(a, x) => a + x, (0, Iter.RangeI((0, 3)))))) == 3 then unit else trap("scan of 0..3 has 3 elements")

/// RESOLVED 2026-07-15 (trunk@1f3b3c348): fix-sum-boxed-closure-dispatch merged (c861ae571). A provably-dead
/// CallClosure (operand type matches no lift) now emits unreachable instead of declining the whole program.
/// Migrated to spec/semantics/09-functions.sexp ("boxed closures of two fn types in one sum").
