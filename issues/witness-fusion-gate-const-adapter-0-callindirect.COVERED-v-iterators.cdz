type Iter = | Mk(List(Int64), List(Int64) -> Option((Int64, List(Int64))))
def from-list(xs) = Iter.Mk(xs, fn(s) => match s with
  | [] => Option.None(unit)
  | [h, .. t] => Option.Some((h, t)))
def map(it, f: Int64 -> Int64) = match it with
  | Iter.Mk(s0, step) => Iter.Mk(s0, fn(s) => match step(s) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(p) => (match p with | (x, s2) => Option.Some((f(x), s2))))
def filter-step(const step: List(Int64) -> Option((Int64, List(Int64))), s: List(Int64), const p: Int64 -> Bool) =
  match step(s) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(pr) => (match pr with | (x, s2) => if p(x) then Option.Some((x, s2)) else filter-step(step, s2, p))
def filter(it, p: Int64 -> Bool) = match it with
  | Iter.Mk(s0, step) => Iter.Mk(s0, fn(s) => filter-step(step, s, p))
def drive(const step: List(Int64) -> Option((Int64, List(Int64))), s: List(Int64), acc: Int64, const g: Int64 -> Int64 -> Int64) =
  match step(s) with
  | Option.None(_) => acc
  | Option.Some(p) => (match p with | (x, s2) => drive(step, s2, g(acc, x), g))
def sum(it) = match it with | Iter.Mk(s, step) => drive(step, s, 0, fn(a, x) => a + x)
def run() = sum(filter(map(from-list([1, 2, 3, 4, 5]), fn(x) => x * 2), fn(x) => x > 4))
export { run }

