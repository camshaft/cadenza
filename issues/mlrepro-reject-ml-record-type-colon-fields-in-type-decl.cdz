/// ML SURFACE INCONSISTENCY (2026-07-14, seed rcdzc reader). The `Record(field: Type, …)` inline
/// record-TYPE spelling with COLON fields is accepted by the PARAMETER-annotation type parser but
/// REJECTED by the TYPE-DECLARATION type parser — the two type-position parsers disagree.
///
///   def f(r: Record(a: Int64, b: Int64)) = r.a      // OK — colon fields in a PARAM annotation
///   type R = Record(a: Int64, b: Int64)             // FAILS: "expected `,`" at the `:` (col 18)
///
/// The PAREN-field spelling `Record(a(Int64), b(Int64))` parses in BOTH positions (it is what the ML
/// PRINTER emits for a record type — `cdz convert … --to ml` renders `Record(x(Int64), y(Int64))`), so
/// it is the portable form. But a user who writes the colon form (natural, and legal in a param
/// annotation) gets a confusing `expected ,` when they lift the same type into a `type` decl. The two
/// parsers should agree: either accept `field: Type` in both, or reject it in both and canonicalize on
/// `field(Type)`.
///
/// SEPARATE, related gap: there is NO `{ field: Type }` brace sugar for an inline record type at all —
/// `def f(r: { a: Int64 }) = r.a` → "expected `,`" (parsed as a record VALUE `{ a = … }`). A record type
/// must be written `Record(…)`; a NAMED record type is a newtype over it, `type R = R(Record(a(Int64)))`.
///
/// This file uses the PORTABLE `Record(a(Int64), …)` spelling in a type decl so it CHECKS CLEAN (a
/// regression witness for the accepted form); the rejected colon-in-type-decl form is in the comment.
type Point =
  | Mk(Record(x(Int64), y(Int64)))

def px(p: Point) = p.x

def py(p: Point) = p.y

def manhattan(p: Point) = px(p) + py(p)

@test
def record-type-decl-paren-fields-work() =
  if manhattan(Point.Mk({ x = 3, y = 4 })) == 7 then unit else trap("3+4=7 through a named record type")

@test
def record-type-colon-fields-work-in-param-position() =
  // the SAME Record(...) spelling with COLON fields is accepted HERE (param annotation), unlike a type decl
  if pair-sum({ a = 10, b = 5 }) == 15 then unit else trap("10+5=15")

def pair-sum(r: Record(a: Int64, b: Int64)) = r.a + r.b

export { px, py, manhattan }
