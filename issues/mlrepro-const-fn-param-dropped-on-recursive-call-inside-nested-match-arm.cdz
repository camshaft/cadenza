// ===== UPDATE 2026-07-19 (v-iterators) — TRIGGER SHARPENED; v-core-opt's "match-depth"/">=2 const re-passed"
// hypotheses are BOTH FALSIFIED by counterexamples. The real trigger is a MIXED innermost match: =====
//   TRUE TRIGGER: a recursive self-call re-passing >=2 CONST params, in a match arm whose SIBLING arm(s) do
//   NOT recurse (they return a value). When EVERY arm of that innermost match recurses, it COMPILES + RUNS;
//   the moment one sibling returns a value instead, the const binding on the recursive arm is dropped (CDZ0101).
//   DECISIVE PAIR (identical 4-param shape `(const step, s, acc, const f)`, differ ONLY in the sibling arm):
//     - `gAll` (both inner arms recurse) -> PASS.
//     - `fmH`  (Some-arm RETURNS `acc + y`, None-arm recurses) -> FAIL "unbound step".
//   COUNTEREXAMPLES to the earlier hypotheses (all PASS, all >=2 const re-passed recursively):
//     - my SHIPPING `drive`/`filter-step`/`any-drive` (2 const `step`+`g`, 2 match levels) — green at 287/0.
//     - `driveC` (2 const, THREE match levels, recurse in a binding arm) — so NOT match depth, NOT arity.
//   So it is NOT "two match levels" and NOT "2 const params" per se — it is a const-param recursive call that
//   is a SIBLING of a non-recursive (value-returning) arm at the innermost match. Likely `type_specialize`
//   spec-body copy: when only SOME arms are the recursive edge, the const-arg substitution/memo drops the
//   const binder for the recursive arm. (Original narrower framing below kept for history.)
// =============================================================================================================
//
// BUG (filed by v-iterators 2026-07-19): a `const` FUNCTION-typed parameter's binding is DROPPED on the
// recursive self-call path when that self-call sits inside a match arm nested TWO levels deep — the compiler
// reports `CDZ0101: unbound name step` for the const param that is plainly in scope. The identical recursive
// worker, recursing from ONE match level (or from an if/else), compiles + runs fine.
//
// WHY IT MATTERS: this is the natural `filter-map` combinator for the adapter-record iterator. `filter-map`
// applies `f : elem -> Option(elem)` and keeps the `Some`s; the idiomatic worker MUST `match f(x)` (f returns
// Option) and, on the `None` arm, recurse to skip that element — re-passing the upstream `const step`. That
// recursion is inside `(match pair with (x,s2) => (match f(x) with None => <recurse> | Some => ...))` — two
// match levels — and it declines. The only workaround is to compute `f(x)` into a Bool + a getter and recurse
// from an `if/else` (see CONTROL C) — which evaluates `f` TWICE and is a contortion, so per the idiomatic-code
// directive this is SURFACED, not worked around. It blocks the I4 filter-map combinator (extensibility demo).
//
// DISCRIMINATORS (minimized on trunk 36415f852):
//   - CONTROL A (`filter-step` shape, already in adapter.cdz): recurse from an if/else inside ONE (match pair)
//     arm, re-passing `const step` -> COMPILES + RUNS. So a const fn-param recursed from a single match level
//     is fine.
//   - CONTROL C below: recurse from if/else even INSIDE the (match pair) arm, deriving a Bool from f -> RUNS.
//   - THE BUG (`fmstep` below): recurse from the `None` arm of a match NESTED inside the (match pair) arm,
//     re-passing `const step` -> CDZ0101 "unbound name step". <-- the delta is purely the extra match nesting
//     on the recursive path; the const fn-param binding is lost across the second match level.
//   - CONTROL D (decisive): the EXACT `fmstep` shape but with `step`/`f` NON-const -> COMPILES + RUNS. So the
//     bug is `const`-SPECIFIC: only the const-param binding is dropped across the nested-match recursive edge.
//     A plain param in the identical position survives. This pins the locus to const-param scope/threading.
//
// LOCUS (confirmed const-specific by CONTROL D): const-parameter scope/threading. The const marker is the ONLY
// difference between THE BUG and CONTROL D; `drive`/`filter-step`/`any-drive` all use `const step` and work at
// ONE match level, but a SECOND match level on the self-recursive edge drops the const binding, surfacing as a
// NAME-RESOLUTION error (CDZ0101). v-core-opt const-handling / rcdzc lowering territory — the const-elaboration
// (partial-eval / specialization) pass appears not to carry the const param's binding into a deeply-nested
// match arm on the recursive call. Not v-inference name-resolution (non-const resolves fine in the same spot).

type Iter = | Mk(List(Int64), List(Int64) -> Option((Int64, List(Int64))))
def from-list(xs) = Iter.Mk(xs, fn(s) => match s with
  | [] => Option.None(unit) | [h, .. t] => Option.Some((h, t)))

// THE BUG — recurse re-passing `const step` from inside a match NESTED in the (match pair) arm.
def fmstep(const step: List(Int64) -> Option((Int64, List(Int64))), s: List(Int64), const f: Int64 -> Option(Int64)) =
  match step(s) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(pair) => (match pair with | (x, s2) =>
    (match f(x) with
     | Option.None(_) => fmstep(step, s2, f)
     | Option.Some(y) => Option.Some((y, s2))))
def run(it, f: Int64 -> Option(Int64)) = match it with
  | Iter.Mk(s0, step) => fmstep(step, s0, f)
@test
def filter-map-nested-match-recurse-runs() =
  match run(from-list([1, 2, 3, 4]), fn(x) => if x > 2 then Option.Some(x) else Option.None(unit)) with
  | Option.None(_) => trap("none")
  | Option.Some(p) => (match p with | (v, _r) => if v == 3 then unit else trap("v"))

// CONTROL C — same worker but recurse from an if/else (evaluating f twice via a Bool + getter): COMPILES+RUNS.
def isSome(o: Option(Int64)) = match o with | Option.None(_) => false | Option.Some(_) => true
def getv(o: Option(Int64)) = match o with | Option.None(_) => 0 | Option.Some(v) => v
def fmstepC(const step: List(Int64) -> Option((Int64, List(Int64))), s: List(Int64), const f: Int64 -> Option(Int64)) =
  match step(s) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(pair) => (match pair with | (x, s2) =>
    if isSome(f(x)) then Option.Some((getv(f(x)), s2)) else fmstepC(step, s2, f))
def runC(it, f: Int64 -> Option(Int64)) = match it with
  | Iter.Mk(s0, step) => fmstepC(step, s0, f)
@test
def control-if-else-recurse-runs() =
  match runC(from-list([1, 2, 3, 4]), fn(x) => if x > 2 then Option.Some(x) else Option.None(unit)) with
  | Option.None(_) => trap("none")
  | Option.Some(p) => (match p with | (v, _r) => if v == 3 then unit else trap("v"))

// CONTROL D (decisive) — the EXACT fmstep shape but NON-const params: COMPILES + RUNS. Proves const-specific.
def fmstepD(step: List(Int64) -> Option((Int64, List(Int64))), s: List(Int64), f: Int64 -> Option(Int64)) =
  match step(s) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(pair) => (match pair with | (x, s2) =>
    (match f(x) with
     | Option.None(_) => fmstepD(step, s2, f)
     | Option.Some(y) => Option.Some((y, s2))))
def runD(it, f: Int64 -> Option(Int64)) = match it with
  | Iter.Mk(s0, step) => fmstepD(step, s0, f)
@test
def control-nonconst-nested-match-recurse-runs() =
  match runD(from-list([1, 2, 3, 4]), fn(x) => if x > 2 then Option.Some(x) else Option.None(unit)) with
  | Option.None(_) => trap("none")
  | Option.Some(p) => (match p with | (v, _r) => if v == 3 then unit else trap("v"))

// ===== THE DECISIVE PAIR (2026-07-19) — identical 4-param `(const step, s, acc, const f)` shape; the ONLY
// difference is whether the innermost match's SIBLING arm recurses. This isolates the true trigger. =====

// gAll — BOTH inner arms recurse (re-passing step+f): PASS. (all-arms-recursive innermost match is fine.)
def gAll(const step: List(Int64) -> Option((Int64, List(Int64))), s: List(Int64), acc: Int64, const f: Int64 -> Option(Int64)) =
  match step(s) with
  | Option.None(_) => acc
  | Option.Some(pair) => (match pair with | (x, s2) =>
    (match f(x) with
     | Option.None(_) => gAll(step, s2, acc, f)
     | Option.Some(y) => gAll(step, s2, acc + y, f)))
@test
def all-inner-arms-recurse-runs() =
  if (match from-list([1, 2, 3]) with | Iter.Mk(s, step) => gAll(step, s, 0, fn(x) => Option.Some(x))) == 6
  then unit else trap("gAll")

// fmH — SAME shape but the Some arm RETURNS `acc + y` (does not recurse) while None recurses: FAIL
// "unbound step". The mixed innermost match — one recursive-const-repass arm beside a value-returning
// sibling — is the trigger. (This is exactly filter-map's shape: keep -> return, drop -> recurse.)
def fmH(const step: List(Int64) -> Option((Int64, List(Int64))), s: List(Int64), acc: Int64, const f: Int64 -> Option(Int64)) =
  match step(s) with
  | Option.None(_) => acc
  | Option.Some(pair) => (match pair with | (x, s2) =>
    (match f(x) with
     | Option.None(_) => fmH(step, s2, acc, f)
     | Option.Some(y) => acc + y))
@test
def mixed-innermost-arm-drops-const() =
  if (match from-list([1, 2, 3]) with | Iter.Mk(s, step) => fmH(step, s, 0, fn(x) => if x > 1 then Option.Some(x) else Option.None(unit))) == 2
  then unit else trap("fmH")
