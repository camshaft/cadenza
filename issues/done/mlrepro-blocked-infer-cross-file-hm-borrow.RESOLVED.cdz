/// BLOCKED WITNESS (2026-07-14): a tiny Hindley-Milner inference pass over an expression language. It
/// `cdz check`s CLEAN but its `@test`s DECLINE at emit with "borrowing op operand has an ownership this
/// backend cannot yet prove" — the same seed bug as `decline-borrow-map-lookup-returned-then-matched`
/// (the `Ref` arm looks a binding up in a `Map String Ty` env and returns it; the returned heap value
/// is then inspected). So this is a REAL compiler pass the port cannot yet RUN until that borrow-
/// analysis gap is fixed. Kept here as the full-shape witness (the minimal repro is the sibling file).
///
/// It was ALSO the port's first genuine CROSS-FILE module — it imported `Ty`/`unify`/`resolve`/`empty`
/// from `src/unify.cdz`. That import mechanism now works end to end: `cdz test` follows the import
/// closure (this iteration's toolchain fix, mirroring `cdz check`), verified by
/// `crates/cdz/tests/test_manifest_cli.rs::a_test_follows_an_import_and_uses_a_cross_file_type`. Only
/// the borrow bug — not the linking — blocks running it. To make this file self-contained here in
/// `repros/` (no sibling `unify.cdz`), the `Ty`/`unify`/`resolve`/`empty` it needs are inlined below.
type Ty =
  | Var(Int64)
  | Con(String)
  | Arrow(Ty, Ty)

def resolve(s: Map(Int64, Ty), t: Ty) -> Ty = match t with
  | Ty.Var(v) => (match Map.lookup(s, v) with
    | Option.Some(u) => resolve(s, u)
    | Option.None(_) => t)
  | _ => t

def occurs(v: Int64, t: Ty, s: Map(Int64, Ty)) -> Bool = match resolve(s, t) with
  | Ty.Var(w) => v == w
  | Ty.Con(_) => false
  | Ty.Arrow(a, b) => occurs(v, a, s) or occurs(v, b, s)

def bind-var(s: Map(Int64, Ty), v: Int64, t: Ty) -> Result(Map(Int64, Ty), String) = match t with
  | Ty.Var(w) => (if v == w then Result.Ok(s) else Result.Ok(Map.insert(s, v, t)))
  | _ => (if occurs(v, t, s) then Result.Err("occurs") else Result.Ok(Map.insert(s, v, t)))

def unify-struct(s: Map(Int64, Ty), a: Ty, b: Ty) -> Result(Map(Int64, Ty), String) = match a with
  | Ty.Con(n) => (match b with
    | Ty.Con(m) => (if n == m then Result.Ok(s) else Result.Err("con"))
    | _ => Result.Err("con-arrow"))
  | Ty.Arrow(a1, a2) => (match b with
    | Ty.Arrow(b1, b2) => (match unify(s, a1, b1) with
      | Result.Ok(s1) => unify(s1, a2, b2)
      | Result.Err(e) => Result.Err(e))
    | _ => Result.Err("arrow-con"))
  | Ty.Var(_) => Result.Err("unreachable")

def unify(s: Map(Int64, Ty), a: Ty, b: Ty) -> Result(Map(Int64, Ty), String) =
  let ra = resolve(s, a) in
  let rb = resolve(s, b) in
  match ra with
  | Ty.Var(v) => bind-var(s, v, rb)
  | _ => (match rb with
    | Ty.Var(w) => bind-var(s, w, ra)
    | _ => unify-struct(s, ra, rb))

def empty() -> Map(Int64, Ty) = #{}

type Expr =
  | Lit(Int64)
  | Flag(Bool)
  | Ref(String)
  | Cond(Expr, Expr, Expr)
  | Apply(Expr, Expr)

/// The inference state threaded through: the next fresh variable id and the current substitution.
type State =
  | St(Int64, Map(Int64, Ty))

/// A successful inference carries the solved type and the advanced state.
type Outcome =
  | Ok(Ty, State)
  | Err(String)

def fresh(s: State) -> Outcome = match s with
  | State.St(n, sub) => Outcome.Ok(Ty.Var(n), State.St(n + 1, sub))

/// Infer the type of `e` under environment `env`, starting from state `s`.
def infer(env: Map(String, Ty), e: Expr, s: State) -> Outcome = match e with
  | Expr.Lit(_) => Outcome.Ok(Ty.Con("Int"), s)
  | Expr.Flag(_) => Outcome.Ok(Ty.Con("Bool"), s)
  | Expr.Ref(name) => (match Map.lookup(env, name) with
    | Option.Some(t) => Outcome.Ok(t, s)
    | Option.None(_) => Outcome.Err(String.concat("unbound: ", name)))
  | Expr.Cond(c, then-e, else-e) => infer-cond(env, c, then-e, else-e, s)
  | Expr.Apply(f, a) => infer-apply(env, f, a, s)

/// `if`: the condition must be Bool, and the two branches must unify to one type.
def infer-cond(env: Map(String, Ty), c: Expr, then-e: Expr, else-e: Expr, s: State) -> Outcome =
  match infer(env, c, s) with
  | Outcome.Err(m) => Outcome.Err(m)
  | Outcome.Ok(ct, s1) => (match unify(sub-of(s1), ct, Ty.Con("Bool")) with
    | Result.Err(m) => Outcome.Err(m)
    | Result.Ok(sub2) => (match infer(env, then-e, with-sub(s1, sub2)) with
      | Outcome.Err(m) => Outcome.Err(m)
      | Outcome.Ok(tt, s2) => (match infer(env, else-e, s2) with
        | Outcome.Err(m) => Outcome.Err(m)
        | Outcome.Ok(et, s3) => (match unify(sub-of(s3), tt, et) with
          | Result.Err(m) => Outcome.Err(m)
          | Result.Ok(sub3) => Outcome.Ok(resolve(sub3, tt), with-sub(s3, sub3))))))

/// application: infer `f` and `a`, mint a result var `r`, unify `f`'s type with `a -> r`, yield `r`.
def infer-apply(env: Map(String, Ty), f: Expr, a: Expr, s: State) -> Outcome =
  match infer(env, f, s) with
  | Outcome.Err(m) => Outcome.Err(m)
  | Outcome.Ok(ft, s1) => (match infer(env, a, s1) with
    | Outcome.Err(m) => Outcome.Err(m)
    | Outcome.Ok(at, s2) => (match fresh(s2) with
      | Outcome.Err(m) => Outcome.Err(m)
      | Outcome.Ok(rv, s3) => (match unify(sub-of(s3), ft, Ty.Arrow(at, rv)) with
        | Result.Err(m) => Outcome.Err(m)
        | Result.Ok(sub) => Outcome.Ok(resolve(sub, rv), with-sub(s3, sub)))))

def sub-of(s: State) -> Map(Int64, Ty) = match s with
  | State.St(_, sub) => sub

def with-sub(s: State, sub: Map(Int64, Ty)) -> State = match s with
  | State.St(n, _) => State.St(n, sub)

def start() -> State = State.St(0, empty())

/// Run inference in the empty environment and report the solved constructor name (or "?"/error tag).
def infer-con(e: Expr) -> String = match infer(#{}, e, start()) with
  | Outcome.Err(m) => String.concat("err:", m)
  | Outcome.Ok(t, s) => (match resolve(sub-of(s), t) with
    | Ty.Con(n) => n
    | Ty.Var(_) => "var"
    | Ty.Arrow(_, _) => "arrow")

@test
def infer-lit() = if infer-con(Expr.Lit(3)) == "Int" then unit else trap("lit : Int")

@test
def infer-flag() = if infer-con(Expr.Flag(true)) == "Bool" then unit else trap("flag : Bool")

@test
def infer-if-ok() =
  if infer-con(Expr.Cond(Expr.Flag(true), Expr.Lit(1), Expr.Lit(2))) == "Int" then
    unit
  else
    trap("if bool int int : Int")

@test
def infer-if-branch-mismatch() =
  match infer(#{}, Expr.Cond(Expr.Flag(true), Expr.Lit(1), Expr.Flag(false)), start()) with
  | Outcome.Err(_) => unit
  | Outcome.Ok(_, _) => trap("branches Int vs Bool must fail")

@test
def infer-if-cond-not-bool() =
  match infer(#{}, Expr.Cond(Expr.Lit(0), Expr.Lit(1), Expr.Lit(2)), start()) with
  | Outcome.Err(_) => unit
  | Outcome.Ok(_, _) => trap("cond Int must fail")

@test
def infer-ref-env() =
  if infer-con-in(Map.insert(#{}, "x", Ty.Con("Bool")), Expr.Ref("x")) == "Bool" then
    unit
  else
    trap("x : Bool from env")

@test
def infer-ref-unbound() = match infer(#{}, Expr.Ref("y"), start()) with
  | Outcome.Err(_) => unit
  | Outcome.Ok(_, _) => trap("unbound y must fail")

@test
def infer-apply-ok() =
  let env = Map.insert(#{}, "f", Ty.Arrow(Ty.Con("Int"), Ty.Con("Bool"))) in
  if infer-con-in(env, Expr.Apply(Expr.Ref("f"), Expr.Lit(1))) == "Bool" then
    unit
  else
    trap("f(1) : Bool")

@test
def infer-apply-argtype-mismatch() =
  let env = Map.insert(#{}, "f", Ty.Arrow(Ty.Con("Int"), Ty.Con("Bool"))) in
  match infer(env, Expr.Apply(Expr.Ref("f"), Expr.Flag(true)), start()) with
  | Outcome.Err(_) => unit
  | Outcome.Ok(_, _) => trap("f(true) with f:Int->Bool must fail")

/// Like `infer-con` but under a supplied environment (for the ref/apply tests).
def infer-con-in(env: Map(String, Ty), e: Expr) -> String = match infer(env, e, start()) with
  | Outcome.Err(m) => String.concat("err:", m)
  | Outcome.Ok(t, s) => (match resolve(sub-of(s), t) with
    | Ty.Con(n) => n
    | Ty.Var(_) => "var"
    | Ty.Arrow(_, _) => "arrow")

export { infer }

