/// DECLINE (2026-07-14, seed rcdzc) — borrow-ownership at the TEST-EMIT layout, THRESHOLD-dependent.
/// "borrowing op operand has an ownership this backend cannot yet prove". `cdz check` is CLEAN;
/// `cdz test` DECLINES at emit. This is the CONTEXT-DEPENDENT (aggregate/threshold) face of the
/// borrow-ownership bug family (see `decline-borrow-map-lookup-returned-then-matched.cdz` for the
/// minimal always-fires case).
///
/// WHAT IT IS: a real name-resolution pass — walk an `Expr`, thread a `Set String` lexical scope down,
/// accumulate the unbound variable references into a `List String`. The pass THREADS a heap `Set` + a
/// heap `List` through its recursion and reads a matched-sum `String` payload into the list. Every piece
/// works in isolation:
///   - the resolver LOGIC runs correctly standalone (a single `(export unbound-vars)` / a `main`
///     exercising nested-let shadowing returns the right count),
///   - the SAME defs with 1 `@test` compile + run,
///   - 2 `@test`s of a SMALLER resolver (fewer arms / no `Let`) compile + run.
/// But the FULL module (this file — the recursive `Let`+`App`+`Set.insert` resolver + its ~9 `@test`s)
/// DECLINES under the `EmitTests` layout. It is THRESHOLD-dependent on total locals across the
/// test-emit boundary (the same shape as the slot-alias bug's threshold sensitivity): the test-emit
/// layout exports every `@test` as its own entry, and past some local-count the borrow analysis can no
/// longer prove ownership of a heap value (`Set`/`List`/matched-`String`) that flows across the
/// per-test boundary.
///
/// ROOT (same family): a heap value read from a persistent collection / matched out of a sum, then
/// carried across a call/boundary, defeats the current Perceus/borrow ownership proof. Here it is
/// aggravated by the test-emit layout laying out many diverging exports at once.
///
/// IMPACT: a resolver is a core compiler pass; it CANNOT currently be `@test`ed as one module past a
/// couple of tests. The logic is proven (this file `cdz check`s clean and its `unbound-vars` runs
/// correctly when exported singly); only the test harness's whole-module emit trips the borrow gap.
type Expr =
  | Lit(Int64)
  | Var(String)
  | Let(String, Expr, Expr)
  | App(Expr, Expr)

def unbound(e: Expr, scope: Set(String), acc: List(String)) = match e with
  | Expr.Lit(_) => acc
  | Expr.Var(n) => (if Set.contains(scope, n) then acc else List.concat(acc, [n]))
  | Expr.Let(n, rhs, body) =>
    (let acc2 = unbound(rhs, scope, acc) in unbound(body, Set.insert(scope, n), acc2))
  | Expr.App(f, a) => unbound(a, scope, unbound(f, scope, acc))

def unbound-vars(e: Expr) = unbound(e, #(), [])
def is-closed(e: Expr) = List.len(unbound-vars(e)) == 0
def unbound-count(e: Expr) = List.len(unbound-vars(e))

def first-unbound(e: Expr) = match unbound-vars(e) with
  | [] => "<none>"
  | [h, .. _] => h

@test
def resolve-closed-lit() = if is-closed(Expr.Lit(5)) then unit else trap("lit is closed")

@test
def resolve-free-var() = if unbound-count(Expr.Var("x")) == 1 then unit else trap("bare var unbound")

@test
def resolve-let-binds-body() =
  if is-closed(Expr.Let("x", Expr.Lit(1), Expr.Var("x"))) then unit else trap("let binds body")

@test
def resolve-rhs-outside-scope() =
  if unbound-count(Expr.Let("x", Expr.Var("x"), Expr.Lit(0))) == 1 then unit else trap("rhs unscoped")

@test
def resolve-app-both-sides() =
  if unbound-count(Expr.App(Expr.Var("x"), Expr.Var("y"))) == 2 then unit else trap("app both free")

@test
def resolve-partial-bind() =
  if first-unbound(Expr.Let("x", Expr.Lit(1), Expr.App(Expr.Var("x"), Expr.Var("y")))) == "y" then
    unit
  else
    trap("only y unbound")

@test
def resolve-encounter-order() =
  match unbound-vars(Expr.App(Expr.Var("a"), Expr.Var("b"))) with
  | [x, y] => (if x == "a" then (if y == "b" then unit else trap("second b")) else trap("first a"))
  | _ => trap("expected two")

@test
def resolve-nested-let-shadow() =
  if is-closed(Expr.Let("x", Expr.Lit(1), Expr.Let("y", Expr.Lit(2), Expr.App(Expr.Var("x"), Expr.Var("y"))))) then
    unit
  else
    trap("nested lets bind both")

@test
def resolve-inner-let-only() =
  let e = Expr.Let("x", Expr.Lit(1), Expr.App(Expr.Var("y"), Expr.Let("z", Expr.Lit(2), Expr.Var("z")))) in
  if unbound-count(e) == 1 then
    (if first-unbound(e) == "y" then unit else trap("y is the unbound one"))
  else
    trap("exactly one unbound")

export { unbound-vars, is-closed }

