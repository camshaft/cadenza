+/// SLICE-5 repro helper: the refinement KEY a scrutinee occurrence resolves to (a `Param`/`LocalRef`
+/// binder), or `None`.
+fn refinement_binder_of(db: &mut Db, scrutinee: StructId) -> Option<StructId> {
+    match core_of(db, scrutinee) {
+        Core::Param { binder } | Core::LocalRef { binder } => Some(binder),
+        _ => None,
+    }
+}
