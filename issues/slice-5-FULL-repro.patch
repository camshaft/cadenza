+    db: &mut Db,
+    scrutinee: StructId,
+    path: &[crate::core::PathStep],
+    disc: u32,
+) -> bool {
+    if !path.is_empty() {
+        return false;
+    }
+    let Some(binder) = refinement_binder_of(db, scrutinee) else {
+        return false;
+    };
+    let mut frame = crate::fxhash::FxHashMap::default();
+    frame.insert(binder, disc);
+    db.push_variant_refinement(frame);
+    true
+}
