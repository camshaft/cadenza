// S2 fusion witnesses for v-core-opt (recursive-drive specialization). Each is a same-state adapter chain
// that MUST fuse to one loop / 0 call_indirect once S2 threads the constant step closure into the drive
// recursion. All RUN correct today (values noted); the bar is the EMIT shape (call_indirect -> 0), not
// correctness. Compile each at --opt-level o2/o3 + wasm-tools print; count call_indirect.
type Iter = | Mk(List(Int64), List(Int64) -> Option((Int64, List(Int64))))
def from-list(xs) = Iter.Mk(xs, fn(s) => match s with
  | [] => Option.None(unit) | [h, .. t] => Option.Some((h, t)))
def map(it, f: Int64 -> Int64) = match it with
  | Iter.Mk(s0, step) => Iter.Mk(s0, fn(s) => match step(s) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(p) => (match p with | (x, s2) => Option.Some((f(x), s2))))
def filter-step(step: List(Int64) -> Option((Int64, List(Int64))), s: List(Int64), p: Int64 -> Bool) =
  match step(s) with | Option.None(_) => Option.None(unit)
  | Option.Some(pr) => (match pr with | (x, s2) => if p(x) then Option.Some((x, s2)) else filter-step(step, s2, p))
def filter(it, p: Int64 -> Bool) = match it with | Iter.Mk(s0, step) => Iter.Mk(s0, fn(s) => filter-step(step, s, p))
def drive(step: List(Int64) -> Option((Int64, List(Int64))), s: List(Int64), acc: Int64, g: Int64 -> Int64 -> Int64) =
  match step(s) with | Option.None(_) => acc | Option.Some(p) => (match p with | (x, s2) => drive(step, s2, g(acc, x), g))
def sum(it) = match it with | Iter.Mk(s, step) => drive(step, s, 0, fn(a,x) => a + x)
// W1: from-list |> sum   (baseline: 1 step closure) -> expect 15
def w1() = sum(from-list([1,2,3,4,5]))
// W2: from-list |> map |> sum   (2 closures) -> expect 65 (each +10, 11..15 sum=65)
def w2() = sum(map(from-list([1,2,3,4,5]), fn(x) => x + 10))
// W3: from-list |> map |> filter |> sum   (3 closures, the showcase) -> 24 (*2 then >4: 6+8+10)
def w3() = sum(filter(map(from-list([1,2,3,4,5]), fn(x) => x * 2), fn(x) => x > 4))
export { w1, w2, w3 }

