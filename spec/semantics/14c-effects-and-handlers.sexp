          (<= k 0)
          (+ (* 100 acc) (* 10 kept))
          (let
            ((d (E.next)))
            (if (= (% d 2) 0) (fold (- k 1) (+ acc d) (+ kept 1)) (fold (- k 1) acc kept)))))
      (def
        (main (: n Int64))
        (handle
          E
          n
          ((next () s (resume s (+ s 1))) (probe () s (resume s s)))
          (+ (fold 4 0 0) (- (E.probe) n))))
      (export main)))
