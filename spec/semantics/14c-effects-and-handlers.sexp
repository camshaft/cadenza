(case
  "ts1 a tuple-returning op SPLIT-refed — each destructured half feeds a DIFFERENT later op against advancing state"
  (input
    (do
      (effect
        E
        (op split (-> (Tuple Int64 Int64)))
        (op mixa (-> Int64 Int64))
        (op mixb (-> Int64 Int64)))
      (def
        (main (: n Int64))
