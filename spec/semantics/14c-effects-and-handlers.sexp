          ((next () s (resume s (+ s 1))))
          (do (handle I 0 ((pick () t (resume t t))) (do (E.next) (I.pick))) (E.next))))
      (export main)))
  (call main (: 5 Int64))
  (output (: 6 Int64))
  (call main (: 0 Int64))
  (output (: 1 Int64))
  (call main (: -7 Int64))
  (output (: -6 Int64)))

(case
  "ds4 a DISCARDED if whose arms draw DIFFERENT counts — the taken branch's advances survive the discard"
