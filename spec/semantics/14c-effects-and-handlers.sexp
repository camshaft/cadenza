        (if (<= k 0) (+ (* 100 a) b) (let ((d (E.next))) (fold2 (- k 1) (+ a d) (+ b (+ a d))))))
      (def (main (: n Int64)) (handle E n ((next () s (resume s (+ s 1)))) (fold2 3 0 0)))
      (export main)))
