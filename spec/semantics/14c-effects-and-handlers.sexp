          ((split () s (resume #tuple(s (* 2 s)) (+ s 1)))
            (mixa (a) s (resume (+ a s) (+ s 2)))
            (mixb (b) s (resume (* b s) s)))
          (match (E.split) (#tuple(a b) (+ (E.mixa a) (E.mixb b))))))
