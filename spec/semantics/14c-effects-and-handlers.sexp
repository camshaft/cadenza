            (handle B (E.next) ((get (u) t (resume t (+ t 2)))) (+ (B.get) (B.get)))
            (handle B (* 10 (E.next)) ((get (u) t (resume t (+ t 3)))) (+ (B.get) (B.get))))))
      (export main)))
