          n
          ((next () s (resume s (% (+ s 1) 3))))
          (let
            ((st #set((E.next) (E.next) (E.next) (E.next) (E.next))))
            (+ (* 100 (Set.len st)) (+ (if (Set.contains st n) 10 0) (if (Set.contains st 5) 1 0))))))
      (export main)))
  (call main (: 0 Int64))
  (output (: 310 Int64))
  (call main (: 5 Int64))
  (output (: 411 Int64))
  (call main (: 7 Int64))
  (output (: 410 Int64)))

(case
  "se2 MEMBERSHIP of a draw decides a branch that draws again — the set gates the thread's continuation"
