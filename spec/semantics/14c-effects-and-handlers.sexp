(case
  "xar5 a RECURSIVE performer with the arm capturing a main-local heap list folds and answers (the threaded heap capture leaks per dispatch through the resume-escape fence)"
  (input
    (do
      (effect St (op get (-> Unit Int64)))
      (def (loop2 (: k Int64)) (if (= k 0) 0 (+ (St.get) (loop2 (- k 1)))))
      (def
        (main (: n Int64))
        (let
