      (def
        (main (: n Int64))
        (let
          ((xs (if (> n 0) #list(#list(n) #list(n (+ n 1))) #list(#list(9)))))
          (handle
            St
            0
            ((get
                (u)
                s
                (resume
                  (match (List.at xs 1) ((Option.Some inner) (List.len inner)) ((Option.None) -1))
                  s)))
            (+ (St.get) (St.get)))))
      (export main)))
  (call main (: 5 Int64))
  (output (: 4 Int64))
  (live-objects 0))

(case
