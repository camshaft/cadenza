            ((r0 #record((= x 1) (= y 2))))
            (let
              ((r1 (Record.with r0 #"x" (+ (* 10 r0.x) (E.next)))))
              (let ((r2 (Record.with r1 #"y" (+ r1.x (+ r1.y (E.next)))))) (+ (* 100 r2.x) r2.y))))))
      (export main)))
  (call main (: 2 Int64))
