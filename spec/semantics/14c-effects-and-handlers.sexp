          n
          ((a () s (resume s (+ s 2))) (b (x) s (resume (+ x s) (+ s 3))) (probe () s (resume s s)))
          (do (E.b (E.a)) (E.probe))))
      (export main)))
  (call main (: 5 Int64))
  (output (: 10 Int64))
  (call main (: 0 Int64))
  (output (: 5 Int64))
  (call main (: -9 Int64))
  (output (: -4 Int64)))

