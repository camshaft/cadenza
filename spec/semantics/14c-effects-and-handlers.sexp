                (match
                  (get2 m k)
                  (#tuple(a b) (match (get2 m (if (= k 1) 2 1)) (#tuple(c d) (+ a (+ b (+ c d))))))))))))
      (export main)))
  (call main (: 2 Int64))
  (output (: 42 Int64))
  (call main (: 0 Int64))
  (output (: 76 Int64))
  (call main (: 4 Int64))
  (output (: 48 Int64))
  (live-objects known-leak))

(case
