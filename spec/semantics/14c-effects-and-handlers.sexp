        (handle
          E
          n
          ((next () s (resume s (+ s 10))))
          (let
            ((st #set(10 20 30)))
            (if (Set.contains st (E.next)) (+ 1000 (E.next)) (+ 2000 (E.next))))))
      (export main)))
  (call main (: 10 Int64))
  (output (: 1020 Int64))
  (call main (: 5 Int64))
  (output (: 2015 Int64))
  (call main (: 30 Int64))
  (output (: 1040 Int64)))

(case
  "se3 a set BUILT from cycling draws probed by a LATER state read — the in-cycle probe hits, the off-cycle probe misses"
  (input
