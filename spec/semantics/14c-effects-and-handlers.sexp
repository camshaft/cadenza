        (main (: n Int64))
        (let
          ((r1 (handle St n ((next () s (resume s (+ s 1)))) (+ (St.next) (St.next)))))
          (let
            ((r2 (handle St r1 ((next () s (resume s (* s 2)))) (+ (St.next) (St.next)))))
            (handle St r2 ((next () s (resume s (- s 5)))) (+ (St.next) (St.next))))))
