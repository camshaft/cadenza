{
  "name": "cadenza-guide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "codegen": "node scripts/codegen-chapters.mjs && node scripts/codegen-registry.mjs",
    "codegen:registry": "node scripts/codegen-registry.mjs",
    "build": "npm run codegen && tsc -b && vite build",
    "preview": "vite preview",
    "wasm": "cd ../implementation/seed/crates/cdz-wasm && wasm-pack build --target web --release && node ../../../../guide/scripts/stage-wasm.mjs",
    "check:examples": "node --expose-gc scripts/check-examples.mjs",
    "check:wasm-queries": "node scripts/check-wasm-queries.mjs",
    "check:cdz-render": "node scripts/check-cdz-render.mjs",
    "check:diagnostics": "node scripts/check-diagnostics.mjs",
    "check:worker-stack": "node scripts/check-worker-stack.mjs",
    "check:tuple-collection": "node scripts/check-tuple-collection.mjs",
    "check:parameterized-entry": "node scripts/check-parameterized-entry.mjs",
    "check:cad-preload": "node scripts/check-cad-preload.mjs",
    "check:music-preload": "node scripts/check-music-preload.mjs",
    "audit:mobile": "LD_PRELOAD=/usr/lib64/libstdc++.so.6 LD_LIBRARY_PATH=/usr/lib64:/lib64 node scripts/mobile-audit.mjs",
    "check:calculator": "node scripts/check-calculator.mjs",
    "check:prose": "node scripts/check-prose-annotations.mjs",
    "check:prose-native": "node scripts/check-prose-native-compound.mjs",
    "check:sexpr-concat": "node scripts/check-sexpr-concat.mjs",
    "check:registry-derive": "node scripts/check-registry-derive.mjs",
    "check:codegen": "node scripts/check-codegen.mjs",
    "check:codegen-sync": "node scripts/codegen-chapters.mjs --check",
    "check:registry-sync": "node scripts/codegen-registry.mjs --check",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:visual": "LD_PRELOAD=/usr/lib64/libstdc++.so.6 LD_LIBRARY_PATH=/usr/lib64:/lib64 node scripts/check-visual.mjs",
    "check:notebook": "LD_PRELOAD=/usr/lib64/libstdc++.so.6 LD_LIBRARY_PATH=/usr/lib64:/lib64 node scripts/notebook-verify.mjs",
    "test:unit": "node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@bytecodealliance/jco": "^1.25.2",
    "@bytecodealliance/preview2-shim": "^0.17.4",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.0",
    "@jscadui/3mf-export": "^0.5.0",
    "@lezer/highlight": "^1.2.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/katex": "^0.16.8",
    "@uiw/react-codemirror": "^4.23.7",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "katex": "^0.16.47",
    "lz-string": "^1.5.0",
    "manifold-3d": "^3.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
