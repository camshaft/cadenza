{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,

    "types": ["vite/client"]
  },
  "include": ["src", "src/wasm/pkg/cdz_wasm.d.ts"],
  // Unit tests (`*.test.ts`) run under `node --test` (which strips types + provides `node:*` types);
  // they are not part of the app bundle, so keep them out of the app typecheck/build.
  "exclude": ["src/**/*.test.ts"]
}
