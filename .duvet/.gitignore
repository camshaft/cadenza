/reports/

# Ad-hoc `duvet extract -o` output — regenerable scratch, never committed.
/requirements/

# The coverage snapshot is a per-build artifact: its coverage tags come from the
# citations in the (gitignored) implementation/ code, so it is only reproducible
# on the machine that ran the build and churns on every regeneration. It stays a
# useful LOCAL coverage-regression check, but is not a durable, shareable
# baseline, so it is not committed.
/snapshot.txt

