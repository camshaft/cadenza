{
  "comments": {
    "lineComment": "//"
  },
  "wordPattern": "([A-Za-z_][A-Za-z0-9_]*(-[A-Za-z0-9_]+)*)|(\\d[\\d_]*(\\.[\\d_]+)?)",
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ]
}
