/// chor-consistency.cdz — CROSS-PASS coverage for the CHOREOGRAPHIC-PROTOCOLS vertical: pin that the three
/// projection passes AGREE. project (Inc 2) derives a role's local type; codegen (Inc 3a) emits its program;
/// run (Inc 3b) executes it. A drift bug in any one — a dropped recv in projection, a mis-emitted `let` in
/// codegen, a mis-counted inbox consume in run — would make a role's RUNTIME behaviour diverge from its
/// STATIC local type. No single-module test catches that; this file gates the composition.
///
/// THE INVARIANT (for a choice-free / single-session protocol, where the run is deterministic): the number
/// of labels a role's generated program CONSUMES from its inbox, when run against exactly its projected recv
/// labels, equals the number of RECV obligations in its projected local type. I.e. codegen emits one `let
/// (perform (recv …))` per `LRecv` in the local type, and run consumes one inbox label per `let`. If any
/// pass drops or adds a half, the consumed count and the obligation count disagree.

import { Chor } from "chor"
import { project } from "chor-local"
import { Local } from "chor-local"
import { gen-role } from "chor-codegen"
import { run } from "chor-run"
import { inbox-of } from "chor-run"
import { sends-of } from "chor-run"
import { Msg } from "chor-run"

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// Helpers: obligation counts from the local type; a label list of a role's recvs (to feed as an inbox).
// ─────────────────────────────────────────────────────────────────────────────────────────────────────

def len-strs(xs: List(String)) -> Int64 = match xs with
  | [] => 0
  | [_h, .. rest] => 1 + len-strs(rest)

/// The recv labels of a role's local type, in order (choice-free spine; branches unioned). Re-derived
/// straight from the local type here (not via chor-safety's IO type) to keep this coverage file's deps
/// minimal — we only need label sequences + counts.
def recv-labels(l: Local) -> List(String) = match l with
  | Local.LEnd => []
  | Local.LSend(_to, _lbl, k) => recv-labels(k)
  | Local.LRecv(_from, lbl, k) => List.concat([lbl], recv-labels(k))
  | Local.LIntC(brs) => recv-labels-brs(brs)
  | Local.LExtC(_from, brs) => recv-labels-brs(brs)
  | Local.LBranch(_lbl, k) => recv-labels(k)
  | Local.LRecT(_v, body) => recv-labels(body)
  | Local.LVarT(_v) => []

def recv-labels-brs(brs: List(Local)) -> List(String) = match brs with
  | [] => []
  | [b, .. rest] => List.concat(recv-labels(b), recv-labels-brs(rest))

/// The send labels of a role's local type, in order.
def send-labels(l: Local) -> List(String) = match l with
  | Local.LEnd => []
  | Local.LSend(_to, lbl, k) => List.concat([lbl], send-labels(k))
  | Local.LRecv(_from, _lbl, k) => send-labels(k)
  | Local.LIntC(brs) => send-labels-brs(brs)
  | Local.LExtC(_from, brs) => send-labels-brs(brs)
  | Local.LBranch(_lbl, k) => send-labels(k)
  | Local.LRecT(_v, body) => send-labels(body)
  | Local.LVarT(_v) => []

def send-labels-brs(brs: List(Local)) -> List(String) = match brs with
  | [] => []
  | [b, .. rest] => List.concat(send-labels(b), send-labels-brs(rest))

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// The consistency property: run a role's generated program against its projected recv labels; the inbox
// must fully drain (it consumed exactly as many labels as it has recv obligations) and it must emit exactly
// as many messages as it has send obligations.
// ─────────────────────────────────────────────────────────────────────────────────────────────────────

def consistent-role(g: Chor, r: String) -> Bool =
  let l = project(g, r) in
  let recvs = recv-labels(l) in
  let sends = send-labels(l) in
  let t = run(gen-role(g, r), recvs) in      // feed exactly the role's projected recv labels as its inbox
  // inbox fully drained ⇒ codegen emitted one recv per LRecv and run consumed one label per recv.
  (if len-strs(inbox-of(t)) == 0 then
     // sent-message count equals send-obligation count ⇒ codegen emitted one send per LSend.
     (len-msgs(sends-of(t)) == len-strs(sends))
   else false)

/// Count sent messages (length only — no need to inspect Msg fields).
def len-msgs(xs: List(Msg)) -> Int64 = match xs with
  | [] => 0
  | [_h, .. rest] => 1 + len-msgs(rest)

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// Fixtures + tests.
// ─────────────────────────────────────────────────────────────────────────────────────────────────────

def purchase-linear() =
  Chor.Seq(Chor.Comm("Buyer", "Seller", "Title"),
    Chor.Seq(Chor.Comm("Seller", "Buyer", "Quote"),
      Chor.Comm("Seller", "Shipper", "Ship")))

@test
def buyer-run-agrees-with-projection() =
  if consistent-role(purchase-linear(), "Buyer") then unit
  else trap("Buyer's generated run consumes/sends exactly its projected recv/send obligations")

@test
def seller-run-agrees-with-projection() =
  if consistent-role(purchase-linear(), "Seller") then unit
  else trap("Seller's generated run agrees with its projection (2 sends: Quote, Ship; 1 recv: Title)")

@test
def shipper-run-agrees-with-projection() =
  if consistent-role(purchase-linear(), "Shipper") then unit
  else trap("Shipper's generated run agrees with its projection (1 recv: Ship; 0 sends)")

@test
def all-roles-consistent-on-purchase() =
  if consistent-role(purchase-linear(), "Buyer") then
    (if consistent-role(purchase-linear(), "Seller") then
       (if consistent-role(purchase-linear(), "Shipper") then unit
        else trap("Shipper consistent")) else trap("Seller consistent")) else trap("Buyer consistent")

@test
def recv-labels-match-projection() =
  // Concrete: Seller's projected recv labels are exactly [Title].
  let seller-recvs = recv-labels(project(purchase-linear(), "Seller")) in
  if len-strs(seller-recvs) == 1 then unit
  else trap("Seller has exactly one recv obligation (Title)")

@test
def send-labels-match-projection() =
  // Seller's projected send labels are exactly [Quote, Ship] → length 2.
  let seller-sends = send-labels(project(purchase-linear(), "Seller")) in
  if len-strs(seller-sends) == 2 then unit
  else trap("Seller has exactly two send obligations (Quote, Ship)")

@test
def choice-free-single-comm-consistent() =
  let g = Chor.Comm("Buyer", "Seller", "Title") in
  if consistent-role(g, "Buyer") then (if consistent-role(g, "Seller") then unit else trap("Seller")) else trap("Buyer")

export { recv-labels, send-labels, consistent-role }
