/// chor-fleet.cdz — Inc 5 of the CHOREOGRAPHIC-PROTOCOLS vertical: THE FLEET FLAGSHIP (design §6.1). The
/// fleet already RUNS a multiparty protocol daily — Worker sends a merge-request, PrSync gates + decides
/// (Merged / Reject / Blocked→escalate), Concierge relays a human answer. Writing that coordination as ONE
/// global `Chor` and driving it through every prior increment (wf → projectable → project → codegen →
/// deadlock-free → execute) is the demonstration that this vertical models a REAL distributed system, not a
/// toy. "The fleet contract's prose invariants become mechanically-checked properties."
///
/// The global protocol (design §6.1), roles Worker / PrSync / Concierge:
///   rec Session .
///     Worker -> PrSync : MergeRequest
///     choice at PrSync
///       | Merged  => PrSync -> Worker : Merged  . Session      -- worker sends the next MR
///       | Reject  => PrSync -> Worker : Reject  . Session      -- worker fixes + resends
///       | Blocked => PrSync -> Concierge : Ask
///                    Concierge -> PrSync : Answer . Session     -- escalate to the human, then loop
///
/// KNOWLEDGE OF CHOICE (why it is projectable — a design refinement the analysis FORCED): at the
/// `choice at PrSync`, every non-chooser role that acts in ANY branch must be TOLD which branch was taken in
/// EVERY branch — else it cannot tell "wait for a message" from "loop/terminate" (the strict MPST rule;
/// chor-project Inc 1). The design §6.1 sketch left BOTH Worker (silent in Blocked) and Concierge (silent in
/// Merged/Reject) un-informed in some branch — genuinely UN-projectable. The projectability analysis caught
/// this (it rejected the naive encoding), so the faithful protocol makes knowledge-of-choice EXPLICIT:
/// PrSync's FIRST action in every branch is a labelled selection to BOTH Worker and Concierge —
///   Merged  : PrSync -> Worker : Merged  ; PrSync -> Concierge : Idle
///   Reject  : PrSync -> Worker : Reject  ; PrSync -> Concierge : Idle
///   Blocked : PrSync -> Worker : Blocked ; PrSync -> Concierge : Ask ; Concierge -> PrSync : Answer
/// so Worker's projection is `&{Merged, Reject, Blocked}` and Concierge's is `&{Idle, Idle, Ask}` — neither
/// guesses. This IS the design's central claim demonstrated on a real protocol: a prose gap becomes a
/// mechanically-detected reject, fixed by turning implicit knowledge into explicit selection messages.
/// (Follow-up filed to refine design §6.1 to this projectable form.)
///
/// EXECUTION NOTE: the mock `Comm` interp (Inc 3b) does not schedule `rec`/`var` loops, so the end-to-end
/// run test uses a SINGLE-SESSION unfolding (`fleet-merged-once` — one MergeRequest→Merged round-trip), the
/// exact gate design §6.1 names ("a MergeRequest→Merged round-trip executed over a mock Comm; a Ref flows
/// Worker→PrSync and a Sha flows back"). The recursive form is exercised for wf / projectability /
/// deadlock-freedom, which are structural and loop-aware.
import { Chor } from "chor"

import { wf } from "chor"

import { projectable } from "chor-project"

import { unprojectable-role } from "chor-project"

import { project } from "chor-local"

import { Local } from "chor-local"

import { deadlock-free } from "chor-safety"

import { gen-role } from "chor-codegen"

import { run } from "chor-run"

import { deliver } from "chor-run"

import { sends-of } from "chor-run"

import { inbox-of } from "chor-run"

import { strs-eq } from "chor-run"

def fleet-roles() = ["Worker", "PrSync", "Concierge"]

/// The full recursive FleetIntegrate protocol (design §6.1).
def fleet-integrate() =
  Chor.Rec(
    "Session",
    Chor.Seq(
      Chor.Comm("Worker", "PrSync", "MergeRequest"),
      Chor.Choice(
        "PrSync",
        [
          // Each branch's FIRST actions are selection messages to BOTH non-choosers (knowledge of choice).
          Chor.Branch(
            "Merged",
            Chor.Seq(
              Chor.Comm("PrSync", "Worker", "Merged"),
              Chor.Seq(Chor.Comm("PrSync", "Concierge", "Idle"), Chor.Var("Session"))
            )
          ),
          Chor.Branch(
            "Reject",
            Chor.Seq(
              Chor.Comm("PrSync", "Worker", "Reject"),
              Chor.Seq(Chor.Comm("PrSync", "Concierge", "Idle"), Chor.Var("Session"))
            )
          ),
          Chor.Branch(
            "Blocked",
            // PrSync tells Worker it's blocked (Worker must know not to await a verdict), tells the Concierge
            // (Ask), awaits the human Answer, then loops.
            Chor.Seq(
              Chor.Comm("PrSync", "Worker", "Blocked"),
              Chor.Seq(
                Chor.Comm("PrSync", "Concierge", "Ask"),
                Chor.Seq(Chor.Comm("Concierge", "PrSync", "Answer"), Chor.Var("Session"))
              )
            )
          )
        ]
      )
    )
  )

/// A single-session unfolding (no recursion) — one MergeRequest that PrSync merges. The design §6.1 run gate.
def fleet-merged-once() =
  Chor.Seq(Chor.Comm("Worker", "PrSync", "MergeRequest"), Chor.Comm("PrSync", "Worker", "Merged"))

/// A single-session Blocked unfolding — the escalation path Worker→PrSync→Concierge→PrSync.
def fleet-blocked-once() =
  Chor.Seq(
    Chor.Comm("Worker", "PrSync", "MergeRequest"),
    Chor.Seq(Chor.Comm("PrSync", "Concierge", "Ask"), Chor.Comm("Concierge", "PrSync", "Answer"))
  )

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// Inc-5 gate: the flagship accepted + projected + deadlock-free + executed end-to-end.
// ─────────────────────────────────────────────────────────────────────────────────────────────────────
@test
def fleet-is-well-formed() =
  if wf(fleet-roles(), fleet-integrate()) then
    unit
  else
    trap(
      "FleetIntegrate is well-formed (declared distinct roles, branches in choice, bound Session var)"
    )

@test
def fleet-is-projectable() =
  // The central claim on a REAL protocol: the choice at PrSync is projectable — Worker told in Merged/Reject,
  // Concierge told in Blocked; neither is left guessing.
  if projectable(fleet-roles(), fleet-integrate()) then
    unit
  else
    trap(
      "FleetIntegrate is projectable — every non-chooser is informed in each branch it participates in"
    )

@test
def fleet-no-unprojectable-role() = match unprojectable-role(fleet-roles(), fleet-integrate()) with
  | Option.Some(_q) => trap("no role should be un-projectable in FleetIntegrate")
  | Option.None(_) => unit

@test
def fleet-worker-projection-is-a-loop() =
  // Worker's projected local type: rec Session . !PrSync.MergeRequest ; &{...}. Just assert it's an LRecT
  // (a recursive local type) — the loop each worker actually runs, generated from the global protocol.
  match project(fleet-integrate(), "Worker") with
    | Local.LRecT(v, _body) => if v == "Session" then unit else trap("Worker's loop binds Session")
    | _ => trap("Worker projects to a recursive local type (LRecT)")

@test
def fleet-concierge-projection-is-a-loop() = match project(fleet-integrate(), "Concierge") with
  | Local.LRecT(_v, _body) => unit
  | _ => trap("Concierge projects to a recursive local type")

@test
def fleet-is-deadlock-free() =
  // Inc 4 on the flagship: every send has its mirror recv across Worker/PrSync/Concierge — the fleet's
  // coordination cannot wedge on a message no one sends.
  if deadlock-free(fleet-roles(), fleet-integrate()) then
    unit
  else
    trap("FleetIntegrate is deadlock-free by construction (matched I/O across all three roles)")

@test
def fleet-merge-request-round-trip() =
  // THE DESIGN §6.1 RUN GATE: a MergeRequest→Merged round-trip over the mock Comm. Worker's generated code
  // sends MergeRequest to PrSync; PrSync's generated code receives it and sends Merged back to Worker; the
  // value provably flows Worker→PrSync and Merged flows back.
  let g = fleet-merged-once() in
  let worker1 = run(gen-role(g, "Worker"), []) in // Worker sends MergeRequest (then awaits)
  let prsync-inbox = deliver(sends-of(worker1), "PrSync") in
  if strs-eq(prsync-inbox, ["MergeRequest"]) then
    // PrSync got the request
    let prsync = run(gen-role(g, "PrSync"), prsync-inbox) in // PrSync recvs it, sends Merged to Worker
    if strs-eq(inbox-of(prsync), []) then
      // PrSync consumed the request
      if strs-eq(deliver(sends-of(prsync), "Worker"), ["Merged"]) then
        unit // Merged routed back to Worker
      else
        trap("PrSync sends Merged back to Worker")
    else
      trap("PrSync consumes the MergeRequest")
  else
    trap("Worker's generated code sends MergeRequest to PrSync")

@test
def fleet-blocked-escalation-round-trip() =
  // The escalation path: Worker→PrSync (MergeRequest), PrSync→Concierge (Ask), Concierge→PrSync (Answer).
  // Prove Ask reaches the Concierge and its Answer reaches PrSync — the human-in-the-loop branch executes.
  let g = fleet-blocked-once() in
  let worker1 = run(gen-role(g, "Worker"), []) in
  let prsync = run(gen-role(g, "PrSync"), deliver(sends-of(worker1), "PrSync")) in
  let concierge-inbox = deliver(sends-of(prsync), "Concierge") in
  if strs-eq(concierge-inbox, ["Ask"]) then
    // Ask reached the Concierge
    let concierge = run(gen-role(g, "Concierge"), concierge-inbox) in
    if strs-eq(deliver(sends-of(concierge), "PrSync"), ["Answer"]) then
      unit // Answer routed back to PrSync
    else
      trap("Concierge answers PrSync")
  else
    trap("PrSync escalates an Ask to the Concierge")

@test
def fleet-single-sessions-are-deadlock-free() =
  // The unfolded single sessions are themselves matched-I/O (a sanity companion to the recursive check).
  if deadlock-free(fleet-roles(), fleet-merged-once()) then
    if deadlock-free(fleet-roles(), fleet-blocked-once()) then
      unit
    else
      trap("the Blocked unfolding is deadlock-free")
  else
    trap("the Merged unfolding is deadlock-free")

export { fleet-integrate, fleet-merged-once, fleet-blocked-once, fleet-roles }
