/// chor-codegen.cdz — Inc 3a of the CHOREOGRAPHIC-PROTOCOLS vertical: CODE GENERATION from a projected
/// local (session) type to each actor's PROGRAM (design §6 Inc 3, §2.1, Q2). Given `Local` (the Inc-2
/// `project` output for one role), `codegen : Local -> Ast` emits that role's standalone program as an
/// `Ast` spine in terms of `Comm` EFFECT OPS — `perform Comm.send(to, label)` / `perform Comm.recv(from)`.
/// This is the "the author wrote NO endpoint code; the compiler GENERATES every actor" half of the
/// choreographic-programming vision: one global protocol projects (Inc 2) to a per-role `Local`, and this
/// fold turns each `Local` into the actual program that role runs. A later sub-slice (Inc 3b) EXECUTES the
/// composed generated actors over a mock in-memory `Comm` handler to prove the value flow end-to-end.
///
/// The emission (a structural fold, exactly the shape of `chor.to-ast` — a `Local` node → an `Ast.List`
/// whose head names the construct, children are the recursively-generated continuations):
///   LEnd              →  (done)
///   LSend(to,l,k)     →  (seq (perform (send to l)) <k>)      -- send label l to `to`, then k
///   LRecv(from,l,k)   →  (let l (perform (recv from)) <k>)    -- bind the recv'd label l, then k
///   LIntC(brs)        →  (ichoice <br>...)                    -- this role decides: emit internal choice
///   LExtC(from,brs)   →  (ematch from <br>...)                -- match on the selection from `from`
///   LBranch(l,k)      →  (branch l <k>)                       -- one labelled arm
///   LRecT(v,body)     →  (rec v <body>)                       -- a loop
///   LVarT(v)          →  (var v)                              -- jump back
///
/// The emitted `Ast` is deliberately a small, explicit s-expr that names each `Comm` op — an intermediate
/// the runtime inc (effect-backed `Comm`) or the rcdzc splice inc lowers further. Keeping it as a named
/// `Ast` (not raw rcdzc surface) keeps Inc 3a self-contained + gate-able as `@test` goldens, mirroring how
/// `chor.to-ast` renders a protocol without a reader seam.
import { Local } from "chor-local"

import { project } from "chor-local"

import { Chor } from "chor"

import { Ast } from "ast"

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// The code-generation fold: Local -> Ast.
// ─────────────────────────────────────────────────────────────────────────────────────────────────────
def codegen(l: Local) -> Ast = match l with
  | Local.LEnd => Ast.List([Ast.Name("done")])
  | Local.LSend(to, label, k) =>
    Ast.List(
      [
        Ast.Name("seq"),
        Ast.List([Ast.Name("perform"), Ast.List([Ast.Name("send"), Ast.Name(to), Ast.Name(label)])]),
        codegen(k)
      ]
    )
  | Local.LRecv(from, label, k) =>
    Ast.List(
      [
        Ast.Name("let"),
        Ast.Name(label),
        Ast.List([Ast.Name("perform"), Ast.List([Ast.Name("recv"), Ast.Name(from)])]),
        codegen(k)
      ]
    )
  | Local.LIntC(brs) => Ast.List(List.concat([Ast.Name("ichoice")], codegen-branches(brs)))
  | Local.LExtC(from, brs) =>
    Ast.List(List.concat([Ast.Name("ematch"), Ast.Name(from)], codegen-branches(brs)))
  | Local.LBranch(label, k) => Ast.List([Ast.Name("branch"), Ast.Name(label), codegen(k)])
  | Local.LRecT(v, body) => Ast.List([Ast.Name("rec"), Ast.Name(v), codegen(body)])
  | Local.LVarT(v) => Ast.List([Ast.Name("var"), Ast.Name(v)])

/// Generate each `LBranch` arm in order (preserving the selection label).
def codegen-branches(brs: List(Local)) -> List(Ast) = match brs with
  | [] => []
  | [b, .. rest] => List.concat([codegen(b)], codegen-branches(rest))

/// Generate the program for role `r` of global protocol `g` — project (Inc 2) then emit.
def gen-role(g: Chor, r: String) -> Ast = codegen(project(g, r))

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// Structural Ast equality (for golden tests). `ast-eq.cdz` exists but keep this file self-contained.
// ─────────────────────────────────────────────────────────────────────────────────────────────────────
def a-eq(a: Ast, b: Ast) -> Bool = match a with
  | Ast.Int(x) =>
    (match b with
      | Ast.Int(y) => x == y
      | _ => false
    )
  | Ast.Str(x) =>
    (match b with
      | Ast.Str(y) => x == y
      | _ => false
    )
  | Ast.Bool(x) =>
    (match b with
      | Ast.Bool(y) => if x then y else if y then false else true
      | _ => false
    )
  | Ast.Name(x) =>
    (match b with
      | Ast.Name(y) => x == y
      | _ => false
    )
  | Ast.List(xs) =>
    match b with
      | Ast.List(ys) => a-list-eq(xs, ys)
      | _ => false

def a-list-eq(xs: List(Ast), ys: List(Ast)) -> Bool = match xs with
  | [] =>
    (match ys with
      | [] => true
      | _ => false
    )
  | [x, .. xr] =>
    match ys with
      | [] => false
      | [y, .. yr] => if a-eq(x, y) then a-list-eq(xr, yr) else false

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// Fixtures + tests — the Inc-3a gate: golden generated programs per role.
// ─────────────────────────────────────────────────────────────────────────────────────────────────────
/// Buyer decides Yes/No, telling Seller each way (same fixture shape as chor-local).
def yes-no() =
  Chor.Choice(
    "Buyer",
    [
      Chor.Branch("Yes", Chor.Comm("Buyer", "Seller", "Yes")),
      Chor.Branch("No", Chor.Comm("Buyer", "Seller", "No"))
    ]
  )

@test
def gen-send-is-perform-send() =
  // Buyer sends Title to Seller → (seq (perform (send Seller Title)) (done)).
  let g = Chor.Comm("Buyer", "Seller", "Title") in
  let expect = Ast.List(
      [
        Ast.Name("seq"),
        Ast.List(
          [Ast.Name("perform"), Ast.List([Ast.Name("send"), Ast.Name("Seller"), Ast.Name("Title")])]
        ),
        Ast.List([Ast.Name("done")])
      ]
    ) in
  if a-eq(gen-role(g, "Buyer"), expect) then
    unit
  else
    trap("Buyer's send generates a perform-send then done")

@test
def gen-recv-binds-label() =
  // Seller receives Title from Buyer → (let Title (perform (recv Buyer)) (done)).
  let g = Chor.Comm("Buyer", "Seller", "Title") in
  let expect = Ast.List(
      [
        Ast.Name("let"),
        Ast.Name("Title"),
        Ast.List([Ast.Name("perform"), Ast.List([Ast.Name("recv"), Ast.Name("Buyer")])]),
        Ast.List([Ast.Name("done")])
      ]
    ) in
  if a-eq(gen-role(g, "Seller"), expect) then
    unit
  else
    trap("Seller's recv generates a let-bound perform-recv then done")

@test
def gen-bystander-is-done() =
  let g = Chor.Comm("Buyer", "Seller", "Title") in
  if a-eq(gen-role(g, "Shipper"), Ast.List([Ast.Name("done")])) then
    unit
  else
    trap("an uninvolved role generates just (done)")

@test
def gen-seq-nests-continuation() =
  // Buyer: send Title, then recv Quote → (seq (perform (send Seller Title)) (let Quote (perform (recv Seller)) (done))).
  let g = Chor.Seq(Chor.Comm("Buyer", "Seller", "Title"), Chor.Comm("Seller", "Buyer", "Quote")) in
  let expect = Ast.List(
      [
        Ast.Name("seq"),
        Ast.List(
          [Ast.Name("perform"), Ast.List([Ast.Name("send"), Ast.Name("Seller"), Ast.Name("Title")])]
        ),
        Ast.List(
          [
            Ast.Name("let"),
            Ast.Name("Quote"),
            Ast.List([Ast.Name("perform"), Ast.List([Ast.Name("recv"), Ast.Name("Seller")])]),
            Ast.List([Ast.Name("done")])
          ]
        )
      ]
    ) in
  if a-eq(gen-role(g, "Buyer"), expect) then
    unit
  else
    trap("a sequence generates a nested send-then-recv program")

@test
def gen-chooser-is-ichoice() =
  // Buyer chooses → (ichoice (branch Yes (seq (perform (send Seller Yes)) (done))) (branch No ...)).
  let arm = fn(lbl) =>
      Ast.List(
        [
          Ast.Name("branch"),
          Ast.Name(lbl),
          Ast.List(
            [
              Ast.Name("seq"),
              Ast.List(
                [
                  Ast.Name("perform"),
                  Ast.List([Ast.Name("send"), Ast.Name("Seller"), Ast.Name(lbl)])
                ]
              ),
              Ast.List([Ast.Name("done")])
            ]
          )
        ]
      ) in
  let expect = Ast.List([Ast.Name("ichoice"), arm("Yes"), arm("No")]) in
  if a-eq(gen-role(yes-no(), "Buyer"), expect) then
    unit
  else
    trap("the chooser generates an internal-choice program")

@test
def gen-told-role-is-ematch() =
  // Seller is told → (ematch Buyer (branch Yes (let Yes (perform (recv Buyer)) (done))) (branch No ...)).
  let arm = fn(lbl) =>
      Ast.List(
        [
          Ast.Name("branch"),
          Ast.Name(lbl),
          Ast.List(
            [
              Ast.Name("let"),
              Ast.Name(lbl),
              Ast.List([Ast.Name("perform"), Ast.List([Ast.Name("recv"), Ast.Name("Buyer")])]),
              Ast.List([Ast.Name("done")])
            ]
          )
        ]
      ) in
  let expect = Ast.List([Ast.Name("ematch"), Ast.Name("Buyer"), arm("Yes"), arm("No")]) in
  if a-eq(gen-role(yes-no(), "Seller"), expect) then
    unit
  else
    trap("a told role generates an external-match program on the chooser's selection")

@test
def gen-uninvolved-in-choice-is-done() =
  if a-eq(gen-role(yes-no(), "Shipper"), Ast.List([Ast.Name("done")])) then
    unit
  else
    trap("a role uninvolved in a choice generates (done)")

@test
def gen-rec-is-loop() =
  // rec Loop . (Buyer -> Seller : Ping ; Loop) → Buyer: (rec Loop (seq (perform (send Seller Ping)) (var Loop))).
  let g = Chor.Rec("Loop", Chor.Seq(Chor.Comm("Buyer", "Seller", "Ping"), Chor.Var("Loop"))) in
  let expect = Ast.List(
      [
        Ast.Name("rec"),
        Ast.Name("Loop"),
        Ast.List(
          [
            Ast.Name("seq"),
            Ast.List(
              [
                Ast.Name("perform"),
                Ast.List([Ast.Name("send"), Ast.Name("Seller"), Ast.Name("Ping")])
              ]
            ),
            Ast.List([Ast.Name("var"), Ast.Name("Loop")])
          ]
        )
      ]
    ) in
  if a-eq(gen-role(g, "Buyer"), expect) then
    unit
  else
    trap("a guarded rec generates a loop program with a back-jump")

@test
def gen-rec-receiver-side() =
  let g = Chor.Rec("Loop", Chor.Seq(Chor.Comm("Buyer", "Seller", "Ping"), Chor.Var("Loop"))) in
  let expect = Ast.List(
      [
        Ast.Name("rec"),
        Ast.Name("Loop"),
        Ast.List(
          [
            Ast.Name("let"),
            Ast.Name("Ping"),
            Ast.List([Ast.Name("perform"), Ast.List([Ast.Name("recv"), Ast.Name("Buyer")])]),
            Ast.List([Ast.Name("var"), Ast.Name("Loop")])
          ]
        )
      ]
    ) in
  if a-eq(gen-role(g, "Seller"), expect) then
    unit
  else
    trap("the receiver's rec generates a recursive recv loop")

@test
def gen-distinguishes-roles() =
  // Non-vacuous: sender's and receiver's generated programs must differ.
  let g = Chor.Comm("Buyer", "Seller", "Title") in
  if a-eq(gen-role(g, "Buyer"), gen-role(g, "Seller")) then
    trap("sender and receiver programs must differ")
  else
    unit

@test
def gen-is-deterministic() =
  // Re-generating the same role yields an identical program (a-eq reflexive on the real output).
  if a-eq(gen-role(yes-no(), "Buyer"), gen-role(yes-no(), "Buyer")) then
    unit
  else
    trap("code generation is deterministic")

export { codegen, gen-role, a-eq }
