/// The abstract syntax tree the compiler operates on — a homoiconic node tree. Mirrors rcdzc's ast.rs (Leaf + Struct) in ideal Cadenza form: ONE recursive sum, no arena indirection — a node CONTAINS its children rather than indexing them by id. The leaf variants are the subset the pipeline observes so far (Int/Str/Bool value leaves + the Name identifier + the List form); the richer wire leaves (Float, Char, Bytes, Sym, markers) join as the passes that read them land.
type Ast =
  | Int(Int64)
  | Str(String)
  | Bool(Bool)
  | Name(String)
  | List(List(Ast))

/// The number of nodes in a tree — the node itself plus every descendant. The archetypal pure recursive traversal the later passes follow.
def node-count(node: Ast) = match node with
  | Ast.Int(_) => 1
  | Ast.Str(_) => 1
  | Ast.Bool(_) => 1
  | Ast.Name(_) => 1
  | Ast.List(elems) => 1 + node-count-list(elems)

def node-count-list(elems: List(Ast)) = match elems with
  | [] => 0
  | [head, .. rest] => node-count(head) + node-count-list(rest)

/// The head NAME of a node when it is a non-empty list whose first element is a Name — the operator a compiler pass keys on. None otherwise.
def head-name(node: Ast) = match node with
  | Ast.List(elems) => (
    match elems with
    | [] => None(unit)
    | [first, .. _] =>
      match first with
      | Ast.Name(n) => Some(n)
      | _ => None(unit)
  )
  | _ => None(unit)

@test
def node-count-int-leaf() =
  if node-count(Ast.Int(5)) == 1 then unit else trap("an Int leaf counts 1")

@test
def node-count-name-leaf() =
  if node-count(Ast.Name("x")) == 1 then unit else trap("a Name leaf counts 1")

@test
def node-count-bool-leaf() =
  if node-count(Ast.Bool(true)) == 1 then unit else trap("a Bool leaf counts 1")

@test
def node-count-empty-list() =
  if node-count(Ast.List([])) == 1 then unit else trap("an empty List counts 1 (the node itself)")

@test
def node-count-flat-list() =
  if node-count(Ast.List([Ast.Int(1), Ast.Int(2)])) == 3 then
    unit
  else
    trap("List[Int,Int] counts 3")

@test
def node-count-nested() =
  if node-count(Ast.List([Ast.Name("f"), Ast.List([Ast.Int(1), Ast.Int(2)])])) == 5 then
    unit
  else
    trap("(f (1 2)) counts 5")

@test
def head-name-on-form() = match head-name(Ast.List([Ast.Name("add"), Ast.Int(1)])) with
  | Option.Some(_) => unit
  | Option.None(_) => trap("head-name of (add 1) should be Some")

@test
def head-name-int-is-none() = match head-name(Ast.Int(5)) with
  | Option.Some(_) => trap("head-name of an Int should be None")
  | Option.None(_) => unit

@test
def head-name-empty-is-none() = match head-name(Ast.List([])) with
  | Option.Some(_) => trap("head-name of empty List should be None")
  | Option.None(_) => unit

@test
def head-name-int-headed-is-none() = match head-name(Ast.List([Ast.Int(9)])) with
  | Option.Some(_) => trap("head-name of an Int-headed list should be None")
  | Option.None(_) => unit

export { Ast.*, node-count, head-name }
