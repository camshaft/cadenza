/// chor.cdz — Inc 0 of the CHOREOGRAPHIC-PROTOCOLS vertical: the GLOBAL-PROTOCOL AST + its canonical
/// homoiconic-node encoding (round-trip) + a well-formedness checker. This is the "define the interaction
/// once" artifact (design: implementation/design/DESIGN-choreographic-protocols.md): a distributed protocol
/// written as a SINGLE global description that a later increment PROJECTS ("shreds") into one program per
/// actor at compile time. Here we lay the foundation — the AST every later pass (projectability Inc 1,
/// projection Inc 2, code-gen Inc 3) folds over.
///
/// `Chor` is ONE recursive sum (the same "a node CONTAINS its children" shape as `ast.cdz`'s `Ast`), so
/// projection will be an ordinary structural recursion over it — exactly the fold shape the self-host
/// corpus (constprop/inline/cfold/infer/tycheck) already runs. A choreography is a global type in the
/// classical MPST sense (Honda–Yoshida–Carbone): a sequence of communications `p -> q : Label`, internal
/// CHOICE at a role, guarded RECURSION, and `Done`.
///
///   Chor.Comm(from, to, label)   — `from -> to : label`: role `from` sends message `label` to `to`.
///   Chor.Seq(a, b)               — do `a`, then `b`.
///   Chor.Choice(chooser, brs)    — `chooser` internally selects one labelled branch (each a `Branch`).
///   Chor.Branch(label, cont)     — one labelled arm of a choice; `chooser` picks `label`, continues `cont`.
///   Chor.Rec(var, body)          — `rec var . body`: a recursion point named `var`.
///   Chor.Var(var)                — a jump back to the enclosing `rec var`.
///   Chor.Done                    — protocol end.
///
/// The CANONICAL NODE (design §7: "one fixed rule producing a canonical node") is an s-expr `Ast` tree, so
/// a choreography round-trips through the port's existing homoiconic `Ast` — `to-ast`/`from-ast` are a
/// structural identity (`from-ast(to-ast(c)) = Some(c)` and `to-ast(from-ast(a)) = a` on well-formed input),
/// the Inc-0 gate. The surface READER (`choreography …` concrete syntax) is a deferred `rcdzc` reader-rule
/// seam (design §7); Inc 0 works over the canonical node so it is fully self-contained in Cadenza.
import { Ast } from "ast"

import { ast-eq } from "ast-eq"

/// The global-protocol AST. One recursive sum; `Choice` holds a list of `Branch` nodes (a `Branch` outside
/// a `Choice` is ill-formed — see `wf`), mirroring how `Ast.List` holds arbitrary `Ast` children.
type Chor =
  | Done
  | Comm(String, String, String)
  | Seq(Chor, Chor)
  | Choice(String, List(Chor))
  | Branch(String, Chor)
  | Rec(String, Chor)
  | Var(String)

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// Structural equality over `Chor` (the Inc-0 round-trip witness, and reused by later increments).
// ─────────────────────────────────────────────────────────────────────────────────────────────────────
/// Structural equality of two choreographies.
def chor-eq(a: Chor, b: Chor) = match a with
  | Chor.Done => (match b with
    | Chor.Done => true
    | _ => false
  )
  | Chor.Comm(f, t, l) => (match b with
    | Chor.Comm(f2, t2, l2) => if f == f2 then if t == t2 then l == l2 else false else false
    | _ => false
  )
  | Chor.Seq(x, y) => (match b with
    | Chor.Seq(x2, y2) => if chor-eq(x, x2) then chor-eq(y, y2) else false
    | _ => false
  )
  | Chor.Choice(c, brs) => (match b with
    | Chor.Choice(c2, brs2) => if c == c2 then chor-list-eq(brs, brs2) else false
    | _ => false
  )
  | Chor.Branch(l, k) => (match b with
    | Chor.Branch(l2, k2) => if l == l2 then chor-eq(k, k2) else false
    | _ => false
  )
  | Chor.Rec(v, body) => (match b with
    | Chor.Rec(v2, body2) => if v == v2 then chor-eq(body, body2) else false
    | _ => false
  )
  | Chor.Var(v) => match b with
    | Chor.Var(v2) => v == v2
    | _ => false

def chor-list-eq(xs: List(Chor), ys: List(Chor)) = match xs with
  | [] => (match ys with
    | [] => true
    | _ => false
  )
  | [x, .. xr] => match ys with
    | [] => false
    | [y, .. yr] => if chor-eq(x, y) then chor-list-eq(xr, yr) else false

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// The canonical node: `Chor` ⇄ homoiconic s-expr `Ast`. Round-trip is a structural identity.
// ─────────────────────────────────────────────────────────────────────────────────────────────────────
/// Print a choreography to its canonical s-expr `Ast` node.
def to-ast(c: Chor) = match c with
  | Chor.Done => Ast.List([Ast.Name("done")])
  | Chor.Comm(f, t, l) => Ast.List([Ast.Name("comm"), Ast.Name(f), Ast.Name(t), Ast.Name(l)])
  | Chor.Seq(a, b) => Ast.List([Ast.Name("seq"), to-ast(a), to-ast(b)])
  | Chor.Choice(chooser, brs) => Ast.List(
    List.concat([Ast.Name("choice"), Ast.Name(chooser)], to-ast-list(brs))
  )
  | Chor.Branch(l, k) => Ast.List([Ast.Name("branch"), Ast.Name(l), to-ast(k)])
  | Chor.Rec(v, body) => Ast.List([Ast.Name("rec"), Ast.Name(v), to-ast(body)])
  | Chor.Var(v) => Ast.List([Ast.Name("var"), Ast.Name(v)])

def to-ast-list(cs: List(Chor)) = match cs with
  | [] => []
  | [h, .. r] => List.concat([to-ast(h)], to-ast-list(r))

/// Parse a canonical s-expr `Ast` node back to a `Chor`. TOTAL: returns `None` on any malformed node (an
/// unknown head, wrong arity, or a non-`Name` where a role/label is expected) — so a malformed node is
/// REJECTED, not silently reinterpreted.
def from-ast(a: Ast) = match a with
  | Ast.List(es) => from-form(es)
  | _ => Option.None(unit)

def from-form(es: List(Ast)) = match es with
  | [] => Option.None(unit)
  | [head, .. rest] => match head with
    | Ast.Name(op) => from-op(op, rest)
    | _ => Option.None(unit)

def from-op(op: String, rest: List(Ast)) =
  if op == "done" then
    match rest with
      | [] => Option.Some(Chor.Done)
      | _ => Option.None(unit)
  else if op == "comm" then
    from-comm(rest)
  else if op == "seq" then
    from-seq(rest)
  else if op == "choice" then
    from-choice(rest)
  else if op == "branch" then
    from-branch(rest)
  else if op == "rec" then
    from-rec(rest)
  else if op == "var" then
    from-var(rest)
  else
    Option.None(unit)

/// `(comm from to label)` — three names.
def from-comm(rest: List(Ast)) = match rest with
  | [f, t, l] => (match name-of(f) with
    | Option.Some(fs) => (match name-of(t) with
      | Option.Some(ts) => (match name-of(l) with
        | Option.Some(ls) => Option.Some(Chor.Comm(fs, ts, ls))
        | Option.None(_) => Option.None(unit)
      )
      | Option.None(_) => Option.None(unit)
    )
    | Option.None(_) => Option.None(unit)
  )
  | _ => Option.None(unit)

/// `(seq a b)` — two choreographies.
def from-seq(rest: List(Ast)) = match rest with
  | [a, b] => (match from-ast(a) with
    | Option.Some(ca) => (match from-ast(b) with
      | Option.Some(cb) => Option.Some(Chor.Seq(ca, cb))
      | Option.None(_) => Option.None(unit)
    )
    | Option.None(_) => Option.None(unit)
  )
  | _ => Option.None(unit)

/// `(choice chooser br…)` — a chooser name then zero-or-more branch nodes.
def from-choice(rest: List(Ast)) = match rest with
  | [] => Option.None(unit)
  | [chooser, .. brs] => match name-of(chooser) with
    | Option.Some(cs) => (match from-ast-list(brs) with
      | Option.Some(cbrs) => Option.Some(Chor.Choice(cs, cbrs))
      | Option.None(_) => Option.None(unit)
    )
    | Option.None(_) => Option.None(unit)

/// `(branch label cont)` — a label name then a continuation choreography.
def from-branch(rest: List(Ast)) = match rest with
  | [l, k] => (match name-of(l) with
    | Option.Some(ls) => (match from-ast(k) with
      | Option.Some(ck) => Option.Some(Chor.Branch(ls, ck))
      | Option.None(_) => Option.None(unit)
    )
    | Option.None(_) => Option.None(unit)
  )
  | _ => Option.None(unit)

/// `(rec var body)` — a rec-var name then a body choreography.
def from-rec(rest: List(Ast)) = match rest with
  | [v, body] => (match name-of(v) with
    | Option.Some(vs) => (match from-ast(body) with
      | Option.Some(cb) => Option.Some(Chor.Rec(vs, cb))
      | Option.None(_) => Option.None(unit)
    )
    | Option.None(_) => Option.None(unit)
  )
  | _ => Option.None(unit)

/// `(var v)` — one rec-var name.
def from-var(rest: List(Ast)) = match rest with
  | [v] => (match name-of(v) with
    | Option.Some(vs) => Option.Some(Chor.Var(vs))
    | Option.None(_) => Option.None(unit)
  )
  | _ => Option.None(unit)

/// Parse a list of `Ast` nodes into a list of `Chor`, failing the whole list if any element is malformed.
def from-ast-list(es: List(Ast)) = match es with
  | [] => Option.Some([])
  | [h, .. r] => match from-ast(h) with
    | Option.Some(ch) => (match from-ast-list(r) with
      | Option.Some(cr) => Option.Some(List.concat([ch], cr))
      | Option.None(_) => Option.None(unit)
    )
    | Option.None(_) => Option.None(unit)

/// The `String` of a `Name` node, else `None`.
def name-of(a: Ast) = match a with
  | Ast.Name(n) => Option.Some(n)
  | _ => Option.None(unit)

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// Well-formedness: every communication names DECLARED, DISTINCT roles; a `Branch` appears only inside a
// `Choice`; and every `Choice`/`Rec` names a declared role / binds its `Var`s. This is the Inc-0 reject
// path — the projectability (knowledge-of-choice) analysis is Inc 1 (design §3.1).
// ─────────────────────────────────────────────────────────────────────────────────────────────────────
/// Is `x` a member of the declared-role list?
def role-declared(roles: List(String), x: String) = match roles with
  | [] => false
  | [h, .. r] => if h == x then true else role-declared(r, x)

/// Well-formed against a declared-role set: comms use declared, distinct roles; choosers are declared;
/// choice children are all branches; and every `Var` is bound by an enclosing `Rec`. `bound` is the list
/// of rec-var names in scope.
def wf-in(roles: List(String), bound: List(String), c: Chor) = match c with
  | Chor.Done => true
  | Chor.Comm(f, t, _l) => if role-declared(roles, f) then
    if role-declared(roles, t) then if f == t then false else true else false
  else
    false
  | Chor.Seq(a, b) => if wf-in(roles, bound, a) then wf-in(roles, bound, b) else false
  | Chor.Choice(chooser, brs) => if role-declared(roles, chooser) then
    if all-branches(brs) then wf-branches(roles, bound, brs) else false
  else
    false
  | Chor.Branch(_, k) => wf-in(roles, bound, k)
  | Chor.Rec(v, body) => wf-in(roles, List.concat([v], bound), body)
  | Chor.Var(v) => role-declared(bound, v)

def wf-branches(roles: List(String), bound: List(String), brs: List(Chor)) = match brs with
  | [] => true
  | [b, .. r] => if wf-in(roles, bound, b) then wf-branches(roles, bound, r) else false

/// Every element is a `Branch` (a `Choice`'s children must all be labelled arms).
def all-branches(brs: List(Chor)) = match brs with
  | [] => true
  | [b, .. r] => match b with
    | Chor.Branch(_, _) => all-branches(r)
    | _ => false

/// Well-formed at top level (no rec-vars in scope yet).
def wf(roles: List(String), c: Chor) = wf-in(roles, [], c)

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// The `Purchase` example (design §4) — the Inc-0 round-trip fixture. Buyer/Seller/Shipper.
// ─────────────────────────────────────────────────────────────────────────────────────────────────────
/// The declared roles of `Purchase`.
def purchase-roles() = ["Buyer", "Seller", "Shipper"]

/// The `Purchase` choreography, structured:
///   Buyer -> Seller : Title ; Seller -> Buyer : Quote ;
///   choice at Buyer { Accept => Buyer->Seller:Accept ; Seller->Shipper:Ship | Reject => Buyer->Seller:Reject }
def purchase() =
  Chor.Seq(
    Chor.Comm("Buyer", "Seller", "Title"),
    Chor.Seq(
      Chor.Comm("Seller", "Buyer", "Quote"),
      Chor.Choice(
        "Buyer",
        [
          Chor.Branch(
            "Accept",
            Chor.Seq(Chor.Comm("Buyer", "Seller", "Accept"), Chor.Comm("Seller", "Shipper", "Ship"))
          ),
          Chor.Branch("Reject", Chor.Comm("Buyer", "Seller", "Reject"))
        ]
      )
    )
  )

// ─────────────────────────────────────────────────────────────────────────────────────────────────────
// Tests — the Inc-0 gate.
// ─────────────────────────────────────────────────────────────────────────────────────────────────────
/// `Chor` → `Ast` → `Chor` is the identity on `Purchase` (the flagship round-trip).
@test
def rt-purchase() = match from-ast(to-ast(purchase())) with
  | Option.Some(c) => if chor-eq(c, purchase()) then
    unit
  else
    trap("Purchase Chor→Ast→Chor must be identity")
  | Option.None(_) => trap("Purchase must parse back from its canonical node")

/// The dual direction: `Ast` → `Chor` → `Ast` is the identity on Purchase's canonical node.
@test
def rt-purchase-ast() =
  let node = to-ast(purchase()) in
    match from-ast(node) with
    | Option.Some(c) => if ast-eq(to-ast(c), node) then
      unit
    else
      trap("Purchase Ast→Chor→Ast must be identity")
    | Option.None(_) => trap("Purchase canonical node must parse")

/// Round-trip of each leaf/spine shape.
@test
def rt-done() = match from-ast(to-ast(Chor.Done)) with
  | Option.Some(c) => if chor-eq(c, Chor.Done) then unit else trap("Done round-trips")
  | Option.None(_) => trap("Done parses")

@test
def rt-comm() =
  let c = Chor.Comm("A", "B", "M") in
    match from-ast(to-ast(c)) with
    | Option.Some(c2) => if chor-eq(c2, c) then unit else trap("Comm round-trips")
    | Option.None(_) => trap("Comm parses")

@test
def rt-rec() =
  let c = Chor.Rec("Loop", Chor.Seq(Chor.Comm("A", "B", "M"), Chor.Var("Loop"))) in
    match from-ast(to-ast(c)) with
    | Option.Some(c2) => if chor-eq(c2, c) then unit else trap("Rec round-trips")
    | Option.None(_) => trap("Rec parses")

/// Round-trip must be non-vacuous: distinct choreographies must not compare equal.
@test
def chor-eq-distinguishes() =
  if chor-eq(Chor.Comm("A", "B", "M"), Chor.Comm("A", "B", "N")) then
    trap("distinct labels must not be equal")
  else
    unit

@test
def from-ast-rejects-unknown-head() = match from-ast(Ast.List([Ast.Name("bogus"), Ast.Name("x")])) with
  | Option.Some(_) => trap("unknown head must not parse")
  | Option.None(_) => unit

@test
def from-ast-rejects-wrong-arity() = match from-ast(Ast.List([Ast.Name("comm"), Ast.Name("A")])) with
  | Option.Some(_) => trap("comm with 1 arg must not parse")
  | Option.None(_) => unit

@test
def from-ast-rejects-non-name-role() = match from-ast(
    Ast.List([Ast.Name("comm"), Ast.Int(1), Ast.Name("B"), Ast.Name("M")])
  ) with
  | Option.Some(_) => trap("comm with a non-name role must not parse")
  | Option.None(_) => unit

/// Well-formedness — Purchase is well-formed against its declared roles.
@test
def wf-purchase-ok() =
  if wf(purchase-roles(), purchase()) then unit else trap("Purchase is well-formed")

/// A comm to an UNDECLARED role is rejected.
@test
def wf-rejects-undeclared-role() =
  if wf(["Buyer", "Seller"], Chor.Comm("Buyer", "Shipper", "Ship")) then
    trap("a comm to the undeclared role Shipper must be rejected")
  else
    unit

/// A self-communication (`from == to`) is rejected.
@test
def wf-rejects-self-comm() =
  if wf(["Buyer"], Chor.Comm("Buyer", "Buyer", "M")) then
    trap("a role cannot send to itself")
  else
    unit

/// A choice at an undeclared chooser is rejected.
@test
def wf-rejects-undeclared-chooser() =
  if wf(["Seller"], Chor.Choice("Buyer", [Chor.Branch("A", Chor.Done)])) then
    trap("a choice at the undeclared role Buyer must be rejected")
  else
    unit

/// A `Choice` whose children are not all branches is rejected.
@test
def wf-rejects-non-branch-in-choice() =
  if wf(["Buyer"], Chor.Choice("Buyer", [Chor.Done])) then
    trap("a choice child must be a Branch")
  else
    unit

/// An unbound `Var` (no enclosing `Rec`) is rejected; a bound one is accepted.
@test
def wf-rejects-unbound-var() =
  if wf(["A", "B"], Chor.Var("Loop")) then trap("an unbound rec-var must be rejected") else unit

@test
def wf-accepts-bound-var() =
  if wf(["A", "B"], Chor.Rec("Loop", Chor.Seq(Chor.Comm("A", "B", "M"), Chor.Var("Loop")))) then
    unit
  else
    trap("a guarded rec with a bound var is well-formed")

@test
def nested-rec-round-trips() =
  // PIN: a rec nested inside another rec's body round-trips through to-ast/from-ast. Only single-level rec
  // was witnessed before. rec Outer . (A->B:M ; rec Inner . (B->A:N ; var Inner)).
  let g = Chor.Rec(
      "Outer",
      Chor.Seq(
        Chor.Comm("A", "B", "M"),
        Chor.Rec("Inner", Chor.Seq(Chor.Comm("B", "A", "N"), Chor.Var("Inner")))
      )
    ) in
    match from-ast(to-ast(g)) with
    | Option.Some(g2) => if chor-eq(g, g2) then unit else trap("nested rec must round-trip")
    | Option.None(_) => trap("from-ast(to-ast) of a nested rec")

@test
def wf-accepts-inner-var-bound-by-inner-rec() =
  // A var bound by an INNER rec is in scope inside that inner body — wf accepts.
  let g = Chor.Rec(
      "Outer",
      Chor.Seq(
        Chor.Comm("A", "B", "M"),
        Chor.Rec("Inner", Chor.Seq(Chor.Comm("B", "A", "N"), Chor.Var("Inner")))
      )
    ) in
    if wf(["A", "B"], g) then unit else trap("a var bound by the inner rec is well-formed")

@test
def wf-rejects-rec-var-referenced-out-of-its-scope() =
  // SCOPING PIN (the unsound direction): `var Inner` referenced in the OUTER body — AFTER the inner rec
  // closes — is UNBOUND, so wf must REJECT. `wf-in` threads `bound` lexically (adds `v` only for that Rec's
  // body), so the inner var is out of scope once its rec returns. A naive "collect every rec-var anywhere"
  // would false-accept this; pin the correct lexical behaviour.
  let g = Chor.Rec(
      "Outer",
      Chor.Seq(Chor.Rec("Inner", Chor.Comm("B", "A", "N")), Chor.Var("Inner"))
    ) in
    if wf(["A", "B"], g) then
    trap("Inner is out of scope in the outer body — must be rejected")
  else
    unit

export { Chor.*, chor-eq, to-ast, from-ast, wf, purchase, purchase-roles }
