// dispatch-loop.cdz — the agent loop routing the model's chosen tool to ONE OF SEVERAL named tools,
// authored in Cadenza (Increment 2d).
//
// string-loop.cdz proved the loop at the real Model.converse : String -> String boundary and dispatched
// on the completion, but its mock dispatcher recognized a SINGLE tool name. A real harness offers the
// model a TOOL SET and routes whichever tool the model selects. This module is that step: a `route`
// helper matches the model's chosen tool NAME (a String) against several tool literals — "search",
// "calc", "write" — each yielding a distinct scalar result, an unknown name yielding 0 (the "no such
// tool" fallback a dispatcher needs). So it exercises CHAINED String-equality routing over runtime rope
// handles, composed through the effect+recursion loop, on top of the String boundary the earlier modules
// established. The `route` table is the reusable piece a real dispatcher grows.
//
// Same single-shot tail-resumptive recursion as the sibling loops, fuel-bounded, accumulator threaded
// through run's own `acc` PARAMETER (never handler state — mock handlers resume with a fresh `0`, the
// convention aligned across these modules). The in-program `handle … with` supplies the mock model +
// tools; the SAME loop swaps to the cadenza:bedrock/api peer + a real tool-dispatch peer with no code
// change once those shims land (a nearer handler wins over the peer binding).
//
// The mock model names the tool via a `run-with(fuel, tool)` PARAMETER captured in the handler arm
// (`converse(q, s) => resume(tool, 0)`). This capture — a handler arm closing over an enclosing fn param
// while the loop also performs a second effect (`Tools.dispatch`) reached by the recursive driver — was a
// v-effects CDZ0101 miscompile this module's dogfood surfaced (merged-nested specialization didn't thread
// the captured param); v-effects fixed it (trunk 4da9e70bd), so the parameterized form now lowers and this
// collapses four near-identical literal-per-tool mocks into one.
// The model effect: a turn's prompt in, the model's chosen tool NAME out (the string the loop routes).
effect Model =
  | converse : String -> String

// The tools effect: `dispatch` runs the named tool (returns its scalar result, folded into acc); `done`
// ends the loop with the accumulator. `dispatch` takes the tool NAME as a String — the model's selection.
effect Tools =
  | dispatch : String -> Int64
  | done : Int64 -> Int64

// Route a chosen tool NAME to its result: a real tool set is a chained String-equality match, with an
// unknown name falling through to 0 (a dispatcher must handle "the model named a tool I don't have").
// Scores are distinct per tool so a test can tell WHICH tool a turn routed. This is the pure routing
// table; the loop calls it from the `dispatch` handler.
def route(name: String) =
  if name == "search" then 10 else if name == "calc" then 20 else if name == "write" then 30 else 0

// One agent RUN: drive up to `fuel` turns; each turn the model names a tool, and unless it says "stop"
// the loop routes that tool (via `route` in the dispatch handler) and folds the result into `acc`. `fuel`
// is the max-turns guard; "stop" is the terminal completion.
def run(fuel: Int64, acc: Int64) =
  if fuel == 0 then
    Tools.done(acc)
  else
    let choice = Model.converse("turn") in
    if choice == "stop" then Tools.done(acc) else run(fuel - 1, acc + Tools.dispatch(choice))

// Run `fuel` turns with a mock that names `tool` every turn, routing through `route`. The tool name is a
// PARAMETER captured in the model handler arm (`resume(tool, 0)`) — so one function drives ANY tool,
// instead of a near-identical copy per tool. Handlers carry no state (the running total is in `run`'s
// `acc`), so each resumes with a fresh `0`. So `run-with(fuel, tool)` = fuel * route(tool).
def run-with(fuel: Int64, tool: String) =
  handle Model(0) with
    | converse(q, s) => resume(tool, 0)
  in
  handle Tools(0) with
    | dispatch(a, s) => resume(route(a), 0)
    | done(a, s) => resume(a, 0)
  in
  run(fuel, 0)

@test
def route-search-scores-ten() = if route("search") == 10 then unit else trap("search routes 10")

@test
def route-unknown-falls-through-to-zero() =
  if route("frobnicate") == 0 then unit else trap("an unknown tool routes 0")

@test
def dispatch-routes-search-across-turns() =
  if run-with(3, "search") == 30 then unit else trap("3 * search(10) = 30")

@test
def dispatch-routes-calc-across-turns() =
  if run-with(2, "calc") == 40 then unit else trap("2 * calc(20) = 40")

@test
def dispatch-routes-write-across-turns() =
  if run-with(1, "write") == 30 then unit else trap("1 * write(30) = 30")

@test
def dispatch-unknown-tool-routes-zero-through-the-loop() =
  if run-with(4, "frobnicate") == 0 then unit else trap("an unknown tool routes 0 through the loop")

@test
def dispatch-tools-route-independently() =
  if run-with(3, "search") + run-with(2, "calc") + run-with(1, "write") == 100 then
    unit
  else
    trap("search(30) + calc(40) + write(30) = 100")

@test
def dispatch-stops-on-stop-completion() =
  let stopped = handle Model(0) with
      | converse(q, s) => resume("stop", 0)
    in
    handle Tools(0) with
      | dispatch(a, s) => resume(route(a), 0)
      | done(a, s) => resume(a, 0)
    in
    run(5, 0) in
  if stopped == 0 then unit else trap("a \"stop\" completion ends the loop with no dispatch")
