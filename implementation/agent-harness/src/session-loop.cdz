// session-loop.cdz — the agent loop that BOTH multi-routes tools AND builds a transcript (Increment 2e).
//
// The earlier modules each proved one capability: transcript-loop.cdz builds a String accumulator via
// String.concat; dispatch-loop.cdz routes the model's chosen tool among a set via a `route` table. A real
// agent session does BOTH at once — each turn the model names a tool, the loop routes it, and the tool's
// output is appended to the running transcript. This module composes the two: a `label` table maps the
// chosen tool NAME to the transcript TOKEN that tool contributes, and the loop concatenates that token
// onto the transcript each turn. So it exercises multi-tool String-equality routing AND String transcript
// construction together, through the effect+recursion loop — the closest scalar-free shape yet to the
// real read→route→append cycle the harness runs.
//
// Same single-shot tail-resumptive recursion, fuel-bounded, transcript threaded through run's own `acc`
// PARAMETER (a String; handler state is inert Int64, resumed with a fresh `0` per the aligned convention).
// Mock model in-program; the SAME loop swaps to the cadenza:bedrock/api + tool-dispatch peers with no code
// change once those shims land (a nearer handler wins over the peer binding).
//
// The mock names the tool via a `run-with(fuel, tool)` PARAMETER captured in the model handler arm. That
// capture (a handler arm closing over an enclosing fn param while the loop performs a second effect in the
// recursive driver) was a CDZ0101 miscompile this module's sibling dogfood surfaced; v-effects fixed it
// (trunk 4da9e70bd), so the parameterized form lowers and drives every tool from one function.
// The model effect: a turn's prompt in, the model's chosen tool NAME out (the string the loop routes).
effect Model =
  | converse : String -> String

// The tools effect: `dispatch` runs the named tool and returns its TRANSCRIPT TOKEN (a String appended to
// the running transcript); `done` ends the loop with the final transcript. Both return String now — the
// tool's textual contribution, not a scalar score.
effect Tools =
  | dispatch : String -> String
  | done : String -> String

// Map a chosen tool NAME to the transcript TOKEN it contributes: a chained String-equality routing table,
// with an unknown name contributing "?" (the "no such tool" marker a transcript should still record). The
// distinct tokens let a test read back WHICH tools ran, in order.
def label(name: String) =
  if name == "search" then
    "S"
  else
    if name == "calc" then "C" else if name == "write" then "W" else "?"

// One agent RUN: drive up to `fuel` turns; each turn the model names a tool, and unless it says "stop" the
// loop routes that tool (`dispatch` → its token via `label`) and APPENDS the token to the transcript
// `acc`. `fuel` is the max-turns guard; "stop" is the terminal completion, returning the transcript so far.
def run(fuel: Int64, acc: String) =
  if fuel == 0 then
    Tools.done(acc)
  else
    let choice = Model.converse("turn") in
    if choice == "stop" then
      Tools.done(acc)
    else
      run(fuel - 1, String.concat(acc, Tools.dispatch(choice)))

// Run `fuel` turns with a mock naming `tool` every turn → the transcript is that tool's token repeated
// fuel times. The tool name is a PARAMETER captured in the model handler arm (`resume(tool, 0)`), so one
// function drives ANY tool. Handler state is inert (the transcript lives in `run`'s `acc`), so each
// resumes with a fresh `0`. So `run-with(fuel, "write")` = "W" repeated fuel times.
def run-with(fuel: Int64, tool: String) =
  handle Model(0) with
    | converse(q, s) => resume(tool, 0)
  in
  handle Tools(0) with
    | dispatch(a, s) => resume(label(a), 0)
    | done(a, s) => resume(a, 0)
  in
  run(fuel, "")

// The tests assert the EXACT transcript CONTENT (String `==`), not just its byte-length — a length-only
// check would pass any same-length string (a mis-routed tool emitting "SSSS" for write, a wrong per-turn
// token, or a non-"?" unknown marker would all slip through). Copilot PR#502.
@test
def label-maps-each-tool-to-its-exact-token() =
  if label("search") == "S" then
    if label("write") == "W" then
      if label("mystery") == "?" then unit else trap("unknown → \"?\"")
    else
      trap("write → \"W\"")
  else
    trap("search → \"S\"")

@test
def session-builds-the-exact-search-transcript() =
  if run-with(3, "search") == "SSS" then unit else trap("3 search turns build exactly \"SSS\"")

@test
def session-zero-fuel-is-the-empty-transcript() =
  if run-with(0, "search") == "" then unit else trap("zero fuel yields exactly \"\"")

@test
def session-records-the-exact-different-tool-transcript() =
  if run-with(4, "write") == "WWWW" then unit else trap("4 write turns build exactly \"WWWW\"")

@test
def session-records-the-exact-unknown-marker() =
  if run-with(2, "mystery") == "??" then unit else trap("unknown tools record exactly \"??\"")

@test
def session-stops-on-stop-completion-with-empty-transcript() =
  let stopped = handle Model(0) with
      | converse(q, s) => resume("stop", 0)
    in
    handle Tools(0) with
      | dispatch(a, s) => resume(label(a), 0)
      | done(a, s) => resume(a, 0)
    in
    run(5, "") in
  if stopped == "" then unit else trap("a \"stop\" completion ends with exactly \"\"")
