/// authz-loop.cdz — the agent loop with a CEDAR AUTHORIZATION GATE before every tool dispatch (Inc-3).
///
/// Extends the base loop (`loop.cdz`) with the "no ambient authority" property the whole harness rests
/// on (DESIGN-agent-harness.md §4): before the loop dispatches a tool it PERFORMS `Cedar.authorize` on
/// that tool's action, and only proceeds when the decision is ALLOW — a DENY skips the dispatch (the
/// tool never runs). The authorization decision is an EFFECT, exactly like the model call: here handled
/// in-program by a MOCK policy, but the SAME loop swaps to the real Cedar evaluator (the cdz-agent
/// embedder's `cedar::authorize` host closure, backed by the `cedar-policy` crate) with no code change —
/// a nearer in-program handler wins over the peer/host binding (v-effects §A-Handler-May-Interpose).
///
/// The authorize op crosses as `(action: Int64) -> Int64` (an action id → 1 allow / 0 deny) so the SPINE
/// is gate-protected independent of the String-crossing ABI; the real embedder binding takes a `String`
/// action and returns the scalar decision (probed e2e — a String arg + scalar result both cross a peer).
/// A run TALLIES the actions it was allowed to dispatch, so the test can distinguish "gate honored"
/// (denied actions contribute nothing) from "gate ignored" (everything dispatched).

/// The authorization effect: given a tool's action id, return 1 (allow) or 0 (deny). Performed before
/// every dispatch — the single choke point through which all tool authority flows.
effect Cedar =
  | authorize : Int64 -> Int64

/// The tools effect: `dispatch` runs the authorized tool (returns a result the loop folds); `done` ends
/// the loop with the accumulator.
effect Tools =
  | dispatch : Int64 -> Int64
  | done : Int64 -> Int64

/// Drive `fuel` turns over actions `fuel, fuel-1, …, 1`, threading the accumulator; then `done`. Each
/// turn is the GATE: authorize the action, and dispatch it (folding its result) ONLY on ALLOW — a DENY
/// recurses with the accumulator unchanged (the tool never runs). A tool is reached ONLY through a
/// passing `Cedar.authorize`.
///
/// The per-turn authorize+dispatch is INLINED into `run` (not a `turn` helper): a separate effect-
/// performing helper called from this recursion currently declines ("unbound name" in the effect
/// specialization — a cross-function two-effect edge; reported to v-effects). The inlined form is the
/// natural single-loop shape anyway and compiles cleanly.
def run(fuel: Int64, acc: Int64) =
  if fuel == 0 then
    Tools.done(acc)
  else if Cedar.authorize(fuel) == 1 then
    run(fuel - 1, acc + Tools.dispatch(fuel))
  else
    run(fuel - 1, acc)

/// Run the loop under a MOCK Cedar policy + mock tools, all in-program. The mock policy ALLOWS even
/// action ids and DENIES odd ones (`a % 2 == 0`) — a stand-in for a real permit/forbid set; the real
/// binding routes `Cedar.authorize` to the embedder's `cedar-policy`-backed closure. `dispatch` returns
/// the action id it ran (folded into `acc`); `done` hands back the accumulator.
def run-mock(fuel: Int64) =
  handle Cedar(0) with
    | authorize(a, s) => resume(if a % 2 == 0 then 1 else 0, s)
  in
  handle Tools(0) with
    | dispatch(a, s) => resume(a, a)
    | done(a, s) => resume(a, a)
  in
  run(fuel, 0)

/// The closed form: over actions fuel..1, only the EVEN ids are allowed + dispatched, so the accumulator
/// is the sum of the even action ids in `1..=fuel`. (sum of evens up to n = k*(k+1) where k = n/2.)
def expected(fuel: Int64) =
  let k = fuel / 2 in
  k * (k + 1)

@test
def authz-allows-even-denies-odd() =
  // fuel 4: actions 4,3,2,1 → allowed {4,2} → acc 6; denied {3,1} contribute nothing.
  if run-mock(4) == 6 then unit else trap("only even actions dispatch: 4+2 = 6")

@test
def authz-one-allowed-turn() =
  // fuel 2: actions 2,1 → allowed {2} → acc 2 (action 1 denied).
  if run-mock(2) == 2 then unit else trap("action 2 allowed, 1 denied → 2")

@test
def authz-all-denied-when-no-even() =
  // fuel 1: action 1 only → denied → acc 0 (the gate blocked the sole dispatch).
  if run-mock(1) == 0 then unit else trap("the only action is denied → nothing dispatched")

@test
def authz-matches-closed-form() =
  // the gated accumulator equals the sum of even action ids for a bigger run
  let fuel = 6 in
  if run-mock(fuel) == expected(fuel) then unit else trap("gated sum is the even-id closed form")

@test
def authz-gate-actually-blocks() =
  // Prove the gate is LOAD-BEARING: an ALLOW-EVERYTHING policy dispatches every action (sum 1..fuel),
  // strictly MORE than the even-only run — so the deny path in run-mock genuinely suppresses dispatches
  // (not a coincidence of the numbers). fuel 4: allow-all → 4+3+2+1 = 10 > 6.
  let allow-all =
    handle Cedar(0) with
      | authorize(a, s) => resume(1, s)
    in
    handle Tools(0) with
      | dispatch(a, s) => resume(a, a)
      | done(a, s) => resume(a, a)
    in
    run(4, 0)
  in
  if allow-all == 10 then unit else trap("allow-all dispatches every action: 4+3+2+1 = 10")
