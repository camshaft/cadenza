// delegation-loop.cdz — the ON-BEHALF-OF authorized loop: agent ∩ delegation (Increment 3c).
//
// string-authz-loop.cdz gated a tool on a SINGLE policy (the agent's own permissions). But the operator's
// explicit ask (DESIGN-agent-harness.md §4.2) is that an agent acting ON BEHALF OF a user is bounded by
// the INTERSECTION of its own policies AND the user's delegation grant — the NARROWER bound wins, so the
// agent can never exceed what the user delegated, even if its own policy is broader. The embedder already
// implements this as `cedar_delegated_authorizer` (agent-authorizer ∩ delegation-authorizer). This module
// is that intersection authored in Cadenza: `Cedar.authorize` allows an action only when BOTH the agent
// policy AND the delegation grant permit it.
//
// The gate is the composition `authorized(a) = agent-permits(a) AND deleg-permits(a)` over the action
// NAME (a String). A tool dispatches only when authorized; a denial from EITHER side short-circuits it —
// so this proves the four intersection cases: both-allow (dispatch), agent-only (deny — delegation is the
// narrower bound), delegation-only (deny — the agent lacks it), neither (deny). In the embedder the SAME
// `Cedar.authorize` performs route to the host delegated cedar closure with no code change.
//
// Single-shot tail-resumptive, fuel-bounded, dispatch count in run's own `count` PARAMETER (handler state
// inert Int64, resumed fresh `0`). Each test fixes a LITERAL action + a specific agent/delegation policy
// pair, rather than one parameterized run-with — the v-effects merged-nested-context capture limit (ACKED
// + owned) drops an outer-param capture when two effects are both reached by the recursive driver.
// The authorization effect: given a tool's ACTION NAME, return 1 (allow) or 0 (deny) — here the DELEGATED
// decision (agent ∩ delegation). Performed before every dispatch; the embedder binds it to the delegated
// cedar-policy closure over the same name.
effect Cedar =
  | authorize : String -> Int64

// The tools effect: `dispatch` runs the authorized tool (result folded into the count); `done` ends the
// loop with the running dispatch count.
effect Tools =
  | dispatch : String -> Int64
  | done : Int64 -> Int64

// The AGENT's own policy: what the agent is permitted to do at all (before considering whom it acts for).
// Stand-in: the agent may search and delete (a broad agent), deny everything else.
def agent-permits(action: String) =
  if action == "tool:search" then 1 else if action == "tool:delete" then 1 else 0

// The user's DELEGATION grant: what the user allowed this agent to do ON THEIR BEHALF. Stand-in: the user
// delegated only search + read — deliberately NARROWER than the agent's own policy (the user did not
// delegate delete), so the intersection can demonstrate the narrower bound winning.
def deleg-permits(action: String) =
  if action == "tool:search" then 1 else if action == "tool:read" then 1 else 0

// The ON-BEHALF-OF decision: the INTERSECTION — allow only if BOTH the agent policy AND the delegation
// grant permit the action. Either denial denies. This is the narrower-bound-wins rule the embedder's
// cedar_delegated_authorizer enforces, authored in Cadenza.
def authorized(action: String) = if agent-permits(action) == 1 then deleg-permits(action) else 0

// One on-behalf-of RUN: drive up to `fuel` turns on a fixed `action`; each turn authorizes via the
// intersection and dispatches the tool ONLY on allow, else ends. `fuel` bounds the turns.
def run(fuel: Int64, action: String, count: Int64) =
  if fuel == 0 then
    Tools.done(count)
  else
    if Cedar.authorize(action) == 1 then
      run(fuel - 1, action, count + Tools.dispatch(action))
    else
      Tools.done(count)

// Run `fuel` turns on `action` under the delegated (intersection) authorizer. Handler state is inert
// (the count lives in `run`'s `count`), so each resumes with a fresh `0`.
def run-search(fuel: Int64) =
  handle Cedar(0) with
    | authorize(a, s) => resume(authorized(a), 0)
  in
  handle Tools(0) with
    | dispatch(a, s) => resume(1, 0)
    | done(a, s) => resume(a, 0)
  in
  run(fuel, "tool:search", 0)

// "tool:delete": the AGENT permits it but the DELEGATION does not → intersection denies (narrower bound).
def run-delete(fuel: Int64) =
  handle Cedar(0) with
    | authorize(a, s) => resume(authorized(a), 0)
  in
  handle Tools(0) with
    | dispatch(a, s) => resume(1, 0)
    | done(a, s) => resume(a, 0)
  in
  run(fuel, "tool:delete", 0)

// "tool:read": the DELEGATION permits it but the AGENT does not → intersection denies (agent lacks it).
def run-read(fuel: Int64) =
  handle Cedar(0) with
    | authorize(a, s) => resume(authorized(a), 0)
  in
  handle Tools(0) with
    | dispatch(a, s) => resume(1, 0)
    | done(a, s) => resume(a, 0)
  in
  run(fuel, "tool:read", 0)

// "tool:write": NEITHER the agent nor the delegation permits it → denied.
def run-write(fuel: Int64) =
  handle Cedar(0) with
    | authorize(a, s) => resume(authorized(a), 0)
  in
  handle Tools(0) with
    | dispatch(a, s) => resume(1, 0)
    | done(a, s) => resume(a, 0)
  in
  run(fuel, "tool:write", 0)

@test
def intersection-both-permit-allows() =
  if authorized("tool:search") == 1 then unit else trap("both permit → allow")

@test
def intersection-agent-only-denies() =
  if authorized("tool:delete") == 0 then
    unit
  else
    trap("agent-only permit → deny (delegation narrower)")

@test
def intersection-delegation-only-denies() =
  if authorized("tool:read") == 0 then
    unit
  else
    trap("delegation-only permit → deny (agent lacks it)")

@test
def intersection-neither-denies() =
  if authorized("tool:write") == 0 then unit else trap("neither permits → deny")

@test
def on-behalf-of-allowed-action-dispatches-every-turn() =
  if run-search(3) == 3 then unit else trap("both-permit action dispatches every turn")

@test
def on-behalf-of-agent-only-never-dispatches() =
  if run-delete(5) == 0 then unit else trap("agent-only action never dispatches on-behalf-of")

@test
def on-behalf-of-delegation-only-never-dispatches() =
  if run-read(5) == 0 then
    unit
  else
    trap("delegation-only action never dispatches (agent lacks it)")

@test
def on-behalf-of-neither-never-dispatches() =
  if run-write(4) == 0 then unit else trap("an action neither permits never dispatches")
