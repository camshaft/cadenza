; ─── infer : Hir → typed-Hir, the Hindley-Milner pass (via effects) ─────────────
; Mirrors the native reference compiler `rcdzc`'s `infer.rs`. Real HM (the ask-75
; plan): inference solves over ACTUAL type variables + unification, NOT a coarse
; wasm-valtype lattice re-derived at emit. A yet-unknown operand or branch is a fresh
; var that unifies with its concrete sibling ORDER-INDEPENDENTLY — the whole ask-14/
; …/77 order-dependence family cannot arise.
;
; The distinctive Cadenza shape: rcdzc's `Infer` struct threads `&mut supply` and
; `&mut subst`; here `infer-expr` performs the `Fresh`/`Subst`/`Fail` effects from
; `22-ty.cdz` and the ONE `handle`-stack in `run-infer` discharges them. The pass is
; a pure recursive walk; all state + abort live in the handlers.
;
; SCOPE: this covers cdzc's CURRENT Hir (HInt/HArith/HBit/HShift/HError). As the
; front-end grows the nodes rcdzc already has (HBool/HLocal/HIf/HLet/HCall), each is a
; new `infer-expr` arm (+ a `Ty` variant / unify arm if it introduces structure),
; never a new mechanism — exactly the nanopass discipline.

; A typed Hir node: the node paired with its SOLVED type. (Mirrors rcdzc's `Typed`.)
; Lowering READS `ty-of`; it never re-derives a type.
(type Typed
  (TypedInt (Tuple Int64 Ty)                 ; a literal + its type (TInt)
   | TypedArith (Tuple ArithOp Typed Typed)  ; checked arithmetic, result TInt
   | TypedBit (Tuple BitOp Typed Typed)      ; bitwise/div, result TInt
   | TypedShift (Tuple ShiftOp Typed Typed)  ; shift, result TInt
   | TypedError Int64))                       ; a propagated decline code

(def (ty-of t)
  (doc "The solved type annotation of a typed node (rcdzc's `Typed.ty`).")
  (match t
    ((Typed.TypedInt (tuple n ty)) ty)
    ((Typed.TypedArith (tuple o a b)) (Ty.TInt ()))
    ((Typed.TypedBit (tuple o a b)) (Ty.TInt ()))
    ((Typed.TypedShift (tuple o a b)) (Ty.TInt ()))
    ((Typed.TypedError c) (Ty.TInt ()))))    ; a declined node types trivially; select emits its trap

; ─── infer-expr : the recursive inference walk (performs Fresh/Subst/Fail) ──────
; Each arm mirrors the corresponding `infer.rs` match arm. Operands of a binary op are
; unified against `TInt` (they must be integers); the result is `TInt`. A fresh var is
; NOT needed for these monomorphic ops — it enters with HIf/HLet/HCall (a branch/call
; result), where `run-infer`'s unification makes order irrelevant.
(def (infer-expr h)
  (doc "Infer the type of Hir node `h`, returning the typed node. Performs `must-unify` (→ Subst/Fail) to
        constrain operands. Mirrors rcdzc `Infer::expr`.")
  (match h
    ((Hir.HInt n) (Typed.TypedInt (tuple n (Ty.TInt ()))))
    ((Hir.HArith (tuple o a b)) (Typed.TypedArith (tuple o (infer-int-operand a) (infer-int-operand b))))
    ((Hir.HBit (tuple o a b)) (Typed.TypedBit (tuple o (infer-int-operand a) (infer-int-operand b))))
    ((Hir.HShift (tuple o a b)) (Typed.TypedShift (tuple o (infer-int-operand a) (infer-int-operand b))))
    ((Hir.HError c) (Typed.TypedError c))))

(def (infer-int-operand h)
  (doc "Infer an operand that MUST be an integer: infer it, then unify its type against TInt (aborting via
        Fail on a mismatch — e.g. a Bool operand to `+`). Returns the typed operand.")
  (let ((t (infer-expr h)))
    (do (must-unify (ty-of t) (Ty.TInt ())) t)))

; ─── finalize : resolve every node's type against the completed substitution ────
; rcdzc's `finalize` + `ground`: after the walk, replace each node's type with its
; fully-applied solution; a residual TVar is a compiler bug surfaced as a decline (never
; a silent default). For the current leaf grammar every type is already ground (TInt),
; so finalize is structural; it grows arms with HIf/HLet/HCall. Kept as the explicit
; seam so the "solve, then read the solved type" discipline is visible.
(def (finalize t)
  (doc "Resolve every node's type against the completed substitution (rcdzc `finalize`+`ground`). Current
        grammar is already ground; the seam exists for when vars enter (HIf/HLet/HCall).")
  (match t
    ((Typed.TypedInt (tuple n ty)) (Typed.TypedInt (tuple n (ground ty))))
    ((Typed.TypedArith (tuple o a b)) (Typed.TypedArith (tuple o (finalize a) (finalize b))))
    ((Typed.TypedBit (tuple o a b)) (Typed.TypedBit (tuple o (finalize a) (finalize b))))
    ((Typed.TypedShift (tuple o a b)) (Typed.TypedShift (tuple o (finalize a) (finalize b))))
    ((Typed.TypedError c) (Typed.TypedError c))))

(def (ground ty)
  (doc "Resolve `ty` to a GROUND type against the substitution; a residual var is undetermined — surfaced
        as a decline (rcdzc returns Err; here the sentinel TInt keeps the pass total and select traps). ")
  (let ((r (apply ty)))
    (match r
      ((Ty.TVar v) (Ty.TInt ()))   ; unsolved: a decline (select emits a trap); never a silent wrong type
      (_ r))))

; ─── run-infer : the handler stack that discharges Fresh + Subst + Fail ─────────
; This is where the effects meet their handlers — the Cadenza analogue of rcdzc's
; `infer_module` allocating the supply + subst and threading them. The stack, outside
; in: Fail (abortive — a type error yields a declined result WITHOUT resuming), then
; Subst (state = the CHAMP map TVar→Ty), then Fresh (state = the counter), then the
; inference walk + finalize.
;   • Fresh.next  : returns the current counter, resumes with counter+1.
;   • Subst.bind  : inserts (v→t) into the map state, resumes Unit with the extended map.
;   • Subst.find  : looks the var up, resumes with the Option, state unchanged.
;   • Fail.type-error : does NOT resume — the whole `handle` yields a TypedError decline.
(def (run-infer h)
  (doc "Run the HM inference pass on Hir `h`, returning the finalized typed node — or a TypedError decline
        if a type error aborted it. Discharges the Fresh (counter), Subst (TVar→Ty map), and Fail
        (abortive) effects with one handler stack. Mirrors rcdzc `infer_module`'s supply+subst threading.")
  (handle unit
    ((Fail.type-error (p) s (Typed.TypedError 201)))          ; CDZ0201; abortive — no resume
    (handle Map.empty
      ((Subst.bind (vt) s (match vt ((tuple v t) (resume () (Map.insert s v t)))))
       (Subst.find (v) s (resume (Map.lookup s v) s)))
      (handle 0
        ((Fresh.next (u) s (resume s (+ s 1))))
        (finalize (infer-expr h))))))
