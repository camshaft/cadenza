; @generated by `make` from cdzc/*.cdz — DO NOT EDIT; edit the sources.
;
; The Cadenza compiler, rewritten from scratch (Ast -> Hir -> Mir -> Lir).
; Authored as separate files under cdzc/ and merged here (no imports yet).

; ─── Byte-stream primitives (carried over from compiler.cdz; unchanged) ──────
(def (u8 b)
  (doc "A one-byte Bytes value; `b` must be in 0..=255.")
  (Bytes.of (list b)))

(def (cat a b)
  (doc "Concatenate two byte streams.")
  (Bytes.concat a b))

(def (empty-bytes)
  (doc "The zero-length byte stream.")
  (Bytes.of (list)))

(def (uleb n)
  (doc "Unsigned LEB128 of a non-negative Int64 — section/vector lengths, indices, u32 operands.")
  (if (< n 128)
      (u8 (Int64.to-byte n))
      (cat (u8 (Int64.to-byte (| (& n 127) 128))) (uleb (>> n 7)))))

(def (sleb n)
  (doc "Signed LEB128 of an Int64 — the operand of i64.const.")
  (if (sleb-done n)
      (u8 (Int64.to-byte (& n 127)))
      (cat (u8 (Int64.to-byte (| (& n 127) 128))) (sleb (>> n 7)))))

(def (sleb-done n)
  (doc "A signed value is complete when the shifted remainder is all sign bits and the current
        group's sign bit agrees.")
  (if (= (>> n 7) 0)
      (if (= (& n 64) 0) true false)
      (if (= (>> n 7) -1) (if (= (& n 64) 64) true false) false)))

(def (section id contents)
  (doc "A wasm section: a one-byte id, the ULEB byte-length of the contents, then the contents.")
  (cat (u8 id) (cat (uleb (Bytes.len contents)) contents)))

(def (wvec count items)
  (doc "A wasm vector: a ULEB element count, then the concatenated element bytes.")
  (cat (uleb count) items))

(def (sized payload)
  (doc "Prefix a byte stream with its own ULEB length (the wasm 'sized' shape).")
  (cat (uleb (Bytes.len payload)) payload))

(def (locals-decl nlocals)
  (doc "The wasm code-entry local-declaration vector for `nlocals` i64 scratch locals: `00` (empty vector)
        if none, else `01 <nlocals-uleb> 7E` — one group of `nlocals` i64s. (Compiler logic, not a generated
        frame segment — a code body's local count is computed from its scratch needs, not fixed.)")
  (if (< nlocals 1)
      (u8 0x00)
      (cat (u8 0x01) (cat (uleb nlocals) (u8 0x7E)))))

; @generated by `cargo run -p xtask -- build` from xtask/src/opcodes.rs. DO NOT EDIT.
;
; WebAssembly opcode bytes for the Cadenza-authored compiler — the SAME table the Rust seed's
; `mod op` is generated from (via wasm-encoder, the authoritative source of the spec's opcode
; numbers), so both compiler implementations agree on every byte. This is the magic-value sharing
; the code generator makes possible: one source of truth feeds both compilers.
(def op
  (doc "WebAssembly opcode bytes — the SAME table the Rust seed's `mod op` is
        generated from, so both compiler implementations agree on every byte.")
  (record
    (unreachable 0x00)
    (call 0x10)
    (drop 0x1A)
    (local-get 0x20)
    (local-set 0x21)
    (local-tee 0x22)
    (i32-const 0x41)
    (i64-const 0x42)
    (f64-const 0x44)
    (if 0x04)
    (else 0x05)
    (end 0x0B)
    (block 0x02)
    (loop 0x03)
    (br 0x0C)
    (br-if 0x0D)
    (return 0x0F)
    (i64-add 0x7C)
    (i64-sub 0x7D)
    (i64-mul 0x7E)
    (i64-div-s 0x7F)
    (i64-rem-s 0x81)
    (i64-and 0x83)
    (i64-or 0x84)
    (i64-xor 0x85)
    (i64-shl 0x86)
    (i64-shr-s 0x87)
    (i64-eqz 0x50)
    (i64-eq 0x51)
    (i64-ne 0x52)
    (i64-lt-s 0x53)
    (i64-gt-s 0x55)
    (i64-le-s 0x57)
    (i64-ge-s 0x59)
    (i64-ge-u 0x5A)
    (i32-eqz 0x45)
    (i32-eq 0x46)
    (i32-lt-u 0x49)
    (i32-gt-u 0x4B)
    (i32-le-u 0x4D)
    (i32-ge-u 0x4F)
    (i32-add 0x6A)
    (i32-sub 0x6B)
    (i32-mul 0x6C)
    (i32-load 0x28)
    (i64-load 0x29)
    (f64-load 0x2B)
    (i32-load8-u 0x2D)
    (i32-store 0x36)
    (i64-store 0x37)
    (f64-store 0x39)
    (i32-store8 0x3A)
    (global-get 0x23)
    (global-set 0x24)
  ))

; ─── The IR sum types (the ladder) ──────────────────────────────────────────
; Each rung is a user-declared sum matched exhaustively by the pass below it. As
; later phases add forms, each rung grows a variant and the passes grow an arm —
; an unhandled variant is a compile error, never a silent fall-through.
; This ladder mirrors the native reference compiler `rcdzc` (crate rcdzc, ir.rs) —
; the two are deliberate twins; port a design here, not re-invent it.

; ─── operator enums (the operator is DATA the node carries, not a string head) ──
; A binary operator category is a small sum carried in ONE node variant (HArith/HBit/
; HShift/HCmp), so a pass has ONE arm per category and dispatches on the op — instead
; of N node variants. (rcdzc's ArithOp/BitOp/ShiftOp/CmpOp.)

(type ArithOp                    ; Int64 → Int64, CHECKED: traps on overflow, never wraps
  (OpAdd Unit | OpSub Unit | OpMul Unit))

(type BitOp                      ; Int64 → Int64. And/Or/Xor total; Div/Rem = i64.div_s/rem_s
  (OpAnd Unit | OpOr Unit        ;   (trap natively on /0 and on Int64.min/-1 — a defined trap)
   | OpXor Unit | OpDiv Unit | OpRem Unit))

(type ShiftOp                    ; << / >>. Count guarded (>=64 → trap); left also traps on overflow.
  (OpShl Unit | OpShr Unit))

; Hir — resolved, desugared. A binary op is a node carrying its operator (an op enum)
; and its two operand subtrees — no string heads.
(type Hir
  (HInt Int64                    ; an integer literal
   | HArith (Tuple ArithOp Hir Hir)   ; checked Int64 +/-/*  (traps on overflow)
   | HBit (Tuple BitOp Hir Hir)       ; bitwise & | ^ and div/rem
   | HShift (Tuple ShiftOp Hir Hir)   ; guarded << >>
   | HError Int64))              ; an unsupported/rejected form; carries a CDZ code (0 = silent decline)

; Mir — the resolved mid rung. Same structure as Hir here (Phase 1); the passes
; that will distinguish them (fold/monomorphize) grow later.
(type Mir
  (MInt Int64
   | MArith (Tuple ArithOp Mir Mir)
   | MBit (Tuple BitOp Mir Mir)
   | MShift (Tuple ShiftOp Mir Mir)
   | MError Int64))

; Lir — a single flat stock-wasm instruction. A function body is a `list Lir`
; (the real wasm code-body shape: a sequence). `serialize-body` maps each to bytes.
; The checked-arithmetic guard is emitted as a run of these flat instructions over
; scratch locals — no tree, matching wasm's stack+locals model.
; The nullary opcodes carry a `Unit` payload (a nullary variant is a single-arity function of Unit —
; core-semantics.md; the seed requires the payload slot, `(Lir.LAdd ())`, not a bare `| LAdd`).
(type Lir
  (LConst Int64                  ; i64.const n
   | LLocalGet Int64             ; local.get i
   | LLocalSet Int64             ; local.set i
   | LAdd Unit                   ; i64.add
   | LSub Unit                   ; i64.sub
   | LMul Unit                   ; i64.mul
   | LDivS Unit                  ; i64.div_s  (traps on x/0 and on Int64.min/-1 — the latter IS a mul overflow)
   | LRemS Unit                  ; i64.rem_s  (traps on x/0 and on Int64.min/-1)
   | LXor Unit                   ; i64.xor
   | LAnd Unit                   ; i64.and
   | LOr Unit                    ; i64.or
   | LShl Unit                   ; i64.shl
   | LShrS Unit                  ; i64.shr_s
   | LGeU Unit                   ; i64.ge_u  (→ i32 bool; the shift-count guard)
   | LLtS Unit                   ; i64.lt_s  (→ i32 bool)
   | LNe Unit                    ; i64.ne    (→ i32 bool)
   | LIfOpen Unit                ; if (empty blocktype) — opens a stack-neutral conditional block
   | LEnd Unit                   ; end       — closes a block opened by LIfOpen
   | LIfUnreachableEnd Unit      ; if (empty) unreachable end   — trap when the i32 cond is nonzero
   | LUnreachable Unit))         ; unreachable (the bare decline trap)

; ─── decode : Bytes → Ast ───────────────────────────────────────────────────
; The front end's keystone: a hand-rolled recursive-descent parser over the
; program's CBOR bytes, producing the LANGUAGE'S OWN built-in `Ast` sum (which
; `resolve` then consumes). We build `Ast.*` values at run time (verified to flow
; through the seed) rather than calling a runtime `Ast.decode` host op — the parser
; lives IN the compiler, keeping the runtime tag-free.
;
; The binary-sexpr format (spec/contracts/ast-encoding.md, options/ast-encoding/):
;   root = CBOR array [version:uint, prelude:array-of-tstr, node]
;   node:
;     uint / nint            → an integer literal      → Ast.Int
;     tstr                   → a string literal         → Ast.Str
;     tag 39 (0xD8 0x27) uint→ a bare name by prelude ix → Ast.Name prelude[ix]
;     array [head-ix, child…]→ an application; head-ix names the head in the prelude,
;                              children follow → Ast.List [Ast.Name prelude[head-ix], child…]
; (Ast.Bool/Ast.Float appear via CBOR simple/float heads; added when a program needs them.)
;
; Position threading: each `decode-*` returns a `(tuple <Ast> <next-offset>)`; the
; caller destructures and threads the offset — the standard recursive-descent shape.

; ─── CBOR head decoding ──────────────────────────────────────────────────────
; A CBOR item begins with an initial byte: major type = byte >> 5, additional-info
; = byte & 0x1F. info < 24 is the immediate argument; 24/25/26 are 1/2/4 trailing
; big-endian argument bytes. (The AST encoder never needs 8-byte args here.)
(def (cbor-major b i)
  (doc "The CBOR major type (0..7) of the item whose initial byte is at i.")
  (match (Bytes.at b i) ((Some x) (>> x 5)) ((None _) -1)))

(def (cbor-info b i)
  (doc "The CBOR additional-info (low 5 bits) of the item's initial byte at i.")
  (match (Bytes.at b i) ((Some x) (& x 31)) ((None _) -1)))

(def (byte-at b i)
  (doc "The unsigned byte at i, or 0 past the end (callers guard bounds via the CBOR structure).")
  (match (Bytes.at b i) ((Some x) x) ((None _) 0)))

(def (cbor-arg b i)
  (doc "The CBOR argument value of the item at i: the immediate info if < 24, else the 1/2/4 trailing
        big-endian bytes for info 24/25/26.")
  (let ((info (cbor-info b i)))
    (if (< info 24) info
    (if (= info 24) (byte-at b (+ i 1))
    (if (= info 25) (| (<< (byte-at b (+ i 1)) 8) (byte-at b (+ i 2)))
    (if (= info 26) (| (| (<< (byte-at b (+ i 1)) 24) (<< (byte-at b (+ i 2)) 16))
                       (| (<< (byte-at b (+ i 3)) 8) (byte-at b (+ i 4))))
        (- 0 1)))))))

(def (cbor-arg-len b i)
  (doc "How many bytes the item's ARGUMENT occupies after the initial byte: 0 for info<24, else 1/2/4
        for info 24/25/26. The item's payload (array elements, string bytes) begins at i+1+this.")
  (let ((info (cbor-info b i)))
    (if (< info 24) 0 (if (= info 24) 1 (if (= info 25) 2 (if (= info 26) 4 0))))))

(def (cbor-payload-off b i)
  (doc "The offset of the item's payload (first array element / first string byte): past the initial
        byte and its argument bytes.")
  (+ (+ i 1) (cbor-arg-len b i)))

; ─── prelude access ──────────────────────────────────────────────────────────
; The root is [version, prelude, node]. The prelude is a CBOR array of tstr symbol
; names; an application head and a bare name reference the prelude by index. To
; resolve an index to its name we walk the prelude array to the k-th tstr and read
; its bytes into a String.
(def (prelude-off b)
  (doc "The offset of the prelude array within the root: root is an array whose element 0 is `version`
        (a uint) and element 1 is the prelude. Skip the root's initial byte, then skip element 0.")
  (let ((e0 (cbor-payload-off b 0)))                 ; offset of element 0 (version)
    (skip-item b e0)))                               ; the prelude begins right after version

(def (prelude-name b k)
  (doc "The Ast.Name for prelude index k: walk the prelude array's tstr entries to the k-th, read its
        byte range as a String. The prelude array's first entry is at its payload offset.")
  (prelude-name-go b (cbor-payload-off b (prelude-off b)) k))

(def (prelude-name-go b entry k)
  (doc "From prelude entry at `entry`, return the name at index k (0 = this entry), skipping k tstrs.")
  (if (= k 0)
      (match (Bytes.slice b (cbor-payload-off b entry) (cbor-arg b entry))
        ((Some sub) (match (String.from-bytes sub) ((Some s) (Ast.Name s)) ((None _) (Ast.Name ""))))
        ((None _) (Ast.Name "")))
      (prelude-name-go b (skip-item b entry) (- k 1))))

; ─── skip-item : the offset just past the CBOR item at i (for walking siblings) ─
(def (skip-item b i)
  (doc "The offset immediately after the complete CBOR item at i. uint/nint/tag-arg: past the head+arg.
        tstr: past the string bytes. array: recursively past every element. (tag 39 is handled by
        skipping the tag head then its single tagged item.)")
  (let ((mt (cbor-major b i)))
    (if (= mt 3)                                         ; tstr: payload = arg bytes
        (+ (cbor-payload-off b i) (cbor-arg b i))
    (if (= mt 4)                                         ; array: skip each of `arg` elements
        (skip-elems b (cbor-payload-off b i) (cbor-arg b i))
    (if (= mt 6)                                         ; tag: skip the head, then the tagged item
        (skip-item b (cbor-payload-off b i))
        (cbor-payload-off b i))))))                      ; uint/nint/simple: just the head+arg

(def (skip-elems b i n)
  (doc "Skip n consecutive CBOR items starting at i; return the offset past the last.")
  (if (< n 1) i (skip-elems b (skip-item b i) (- n 1))))

; ─── the recursive node decoder ──────────────────────────────────────────────
(def (decode-node b i)
  (doc "Decode the CBOR node at offset i to `(tuple <Ast> <next-offset>)`. uint/nint → Ast.Int; tstr →
        Ast.Str; tag 39 + uint → Ast.Name (prelude); array → Ast.List headed by the head-index's name
        followed by the decoded children.")
  (let ((mt (cbor-major b i)))
    (if (= mt 0) (tuple (Ast.Int (cbor-arg b i)) (skip-item b i))            ; uint literal
    (if (= mt 1) (tuple (Ast.Int (- (- 0 1) (cbor-arg b i))) (skip-item b i)); nint literal (= -1-arg)
    (if (= mt 3)                                                             ; tstr literal
        (tuple (match (Bytes.slice b (cbor-payload-off b i) (cbor-arg b i))
                 ((Some sub) (match (String.from-bytes sub) ((Some s) (Ast.Str s)) ((None _) (Ast.Str ""))))
                 ((None _) (Ast.Str "")))
               (skip-item b i))
    (if (= mt 6)                                                             ; tag 39: bare name by index
        (tuple (prelude-name b (cbor-arg b (cbor-payload-off b i))) (skip-item b i))
    (if (= mt 4)                                                             ; array: application
        (tuple (Ast.List (decode-app-children b
                            (skip-item b (cbor-payload-off b i))             ; first CHILD (past head-index)
                            (- (cbor-arg b i) 1)                             ; child count = arity - 1
                            (list (prelude-name b (cbor-arg b (cbor-payload-off b i))))))  ; seed acc = [head-name]
               (skip-item b i))
        (tuple (Ast.Int 0) (skip-item b i)))))))))                           ; unknown head → placeholder

(def (decode-app-children b i n acc)
  (doc "Decode n consecutive child nodes starting at offset i, appending each decoded Ast to acc (which
        already holds the head name). Returns the full element list for the Ast.List.")
  (if (< n 1)
      acc
      (match (decode-node b i)
        ((tuple child nxt) (decode-app-children b nxt (- n 1) (List.push acc child))))))

; ─── decode : Bytes → Ast (the program's root node) ──────────────────────────
(def (decode b)
  (doc "Decode the program's CBOR bytes to its root Ast node. The root is [version, prelude, node]; the
        program node is element 2 — skip version (element 0, at the root payload) and the prelude
        (element 1), then decode the node. Returns the Ast (the `(tuple _ pos)` position is discarded —
        the root is the whole input).")
  (match (decode-node b (skip-item b (prelude-off b)))    ; node = past version, past prelude
    ((tuple ast pos) ast)))

; ─── resolve : Ast → Hir ──────────────────────────────────────────────────────
; ⚠⚠⚠ BROKEN MODEL — TO BE REPLACED (user directive 2026-07-08; task #16). ⚠⚠⚠
; `find-main-body`/`def-is-main` HUNT the module for a def named "main". This
; single-entry, name-hunting model is COMPLETELY BROKEN — the ratified model is
; MULTI-EXPORT: visibility is EXPLICIT via `(export name…)`, names VERBATIM (no
; main→run rename), a module has ONE OR MORE exports each carried by its SIGNATURE.
; The native reference compiler `rcdzc` (seed/crates/rcdzc/: resolve.rs collects
; (export …); layout.rs carries every export by signature; component.rs emits the
; N-export envelope byte-identical to the wasm-encoder oracle at N=1 AND N=2) is the
; design to MIRROR here. Deleting this front-end + 40-frame's single-`run` envelope
; to rebuild clean is sanctioned. (The IR-port / op-enum / bit-shift work is fine and
; STAYS; this flag is about the export/entry model only.)
;
; PHASE 0 (the code below, being replaced): recognize `(module <name> (def (main) <body>))`
; and resolve the main body. A scalar-int body → HInt; else HError 0 (decline).
(def (resolve-program a)
  (doc "Resolve a decoded program Ast to the Hir of its `main` body. PHASE 0: the program is a
        `(module <name> <def>…)` list; find `main`'s body and resolve it. Non-scalar bodies decline.")
  (match a
    ((Ast.List forms) (resolve-main-body (find-main-body forms)))
    ((Ast.Int n) (Hir.HInt n))              ; a bare-expression program (harness wraps, but be total)
    ((Ast.Float f) (Hir.HError 0))
    ((Ast.Str s) (Hir.HError 0))
    ((Ast.Bool b) (Hir.HError 0))
    ((Ast.Name nm) (Hir.HError 0))))

(def (find-main-body forms)
  (doc "Given the top-level module form's element list `[Name \"module\", Name, def…]`, return the body
        Ast of the `(def (main) <body>)` definition, or a sentinel `(Ast.Name \"\")` if absent (declines).
        PHASE 0: scan for the first def whose signature head is `main`.")
  (find-main-body-go forms 0 (List.len forms)))

(def (find-main-body-go forms i n)
  (doc "Scan module elements i..n for the `(def (main) body)` form; return its body Ast.")
  (if (< i n)
      (match (List.at forms i)
        ((None _) (Ast.Name ""))
        ((Some e) (if (def-is-main e) (def-body e) (find-main-body-go forms (+ i 1) n))))
      (Ast.Name "")))

(def (def-is-main e)
  (doc "Is Ast `e` a `(def (main) <body>)` — a list whose head is Name `def`, whose element 1 is a list
        headed by Name `main`?")
  (match e
    ((Ast.List xs)
      (if (and (name-head-is xs "def") (>= (List.len xs) 3))
          (match (List.at xs 1)
            ((Some sig) (match sig ((Ast.List sxs) (name-head-is sxs "main"))
                                   ((Ast.Int n) false) ((Ast.Float f) false) ((Ast.Str s) false)
                                   ((Ast.Bool b) false) ((Ast.Name nm) false)))
            ((None _) false))
          false))
    ((Ast.Int n) false) ((Ast.Float f) false) ((Ast.Str s) false)
    ((Ast.Bool b) false) ((Ast.Name nm) false)))

(def (def-body e)
  (doc "The body Ast (element 2) of a `(def (main) body)` list. Callers guarantee the shape via def-is-main.")
  (match e
    ((Ast.List xs) (match (List.at xs 2) ((Some b) b) ((None _) (Ast.Name ""))))
    ((Ast.Int n) (Ast.Name "")) ((Ast.Float f) (Ast.Name "")) ((Ast.Str s) (Ast.Name ""))
    ((Ast.Bool b) (Ast.Name "")) ((Ast.Name nm) (Ast.Name ""))))

(def (name-head-is xs s)
  (doc "Is the head (element 0) of Ast-list `xs` an `Ast.Name` equal to string `s`?")
  (match (List.at xs 0)
    ((None _) false)
    ((Some h) (match h ((Ast.Name nm) (= nm s))
                       ((Ast.Int n) false) ((Ast.Float f) false) ((Ast.Str t) false)
                       ((Ast.Bool b) false) ((Ast.List ys) false)))))

(def (resolve-main-body a)
  (doc "Resolve a `main` body Ast to Hir. A scalar Int literal → HInt; a binary operator application
        (`+ - *` → HArith, `& | ^ / %` → HBit, `<< >>` → HShift) over the resolved operands (a decoded
        application is `(Ast.List (Ast.Name <op>) <arg>…)` — head prepended as an Ast.Name); else declines.")
  (match a
    ((Ast.Int n) (Hir.HInt n))
    ((Ast.Float f) (Hir.HError 0))
    ((Ast.Str s) (Hir.HError 0))
    ((Ast.Bool b) (Hir.HError 0))
    ((Ast.Name nm) (Hir.HError 0))
    ((Ast.List xs) (resolve-app xs))))

(def (resolve-app xs)
  (doc "Resolve an application list `xs` = [head, arg…] to Hir. A binary operator head over exactly two
        operands → the matching node: `+ - *` → checked HArith; `& | ^ / %` → HBit; `<< >>` → HShift; any
        other head/arity declines (0). Operands are themselves resolved (nested ops compose).")
  (if (arith-app? xs "+" 2)  (Hir.HArith (tuple (ArithOp.OpAdd ()) (resolve-arg xs 1) (resolve-arg xs 2)))
  (if (arith-app? xs "-" 2)  (Hir.HArith (tuple (ArithOp.OpSub ()) (resolve-arg xs 1) (resolve-arg xs 2)))
  (if (arith-app? xs "*" 2)  (Hir.HArith (tuple (ArithOp.OpMul ()) (resolve-arg xs 1) (resolve-arg xs 2)))
  (if (arith-app? xs "&" 2)  (Hir.HBit (tuple (BitOp.OpAnd ()) (resolve-arg xs 1) (resolve-arg xs 2)))
  (if (arith-app? xs "|" 2)  (Hir.HBit (tuple (BitOp.OpOr ()) (resolve-arg xs 1) (resolve-arg xs 2)))
  (if (arith-app? xs "^" 2)  (Hir.HBit (tuple (BitOp.OpXor ()) (resolve-arg xs 1) (resolve-arg xs 2)))
  (if (arith-app? xs "/" 2)  (Hir.HBit (tuple (BitOp.OpDiv ()) (resolve-arg xs 1) (resolve-arg xs 2)))
  (if (arith-app? xs "%" 2)  (Hir.HBit (tuple (BitOp.OpRem ()) (resolve-arg xs 1) (resolve-arg xs 2)))
  (if (arith-app? xs "<<" 2) (Hir.HShift (tuple (ShiftOp.OpShl ()) (resolve-arg xs 1) (resolve-arg xs 2)))
  (if (arith-app? xs ">>" 2) (Hir.HShift (tuple (ShiftOp.OpShr ()) (resolve-arg xs 1) (resolve-arg xs 2)))
      (Hir.HError 0))))))))))))

(def (arith-app? xs op nargs)
  (doc "Is application list `xs` headed by the Ast.Name `op` with exactly `nargs` operands (so len = nargs+1)?")
  (and (name-head-is xs op) (= (List.len xs) (+ nargs 1))))

(def (resolve-arg xs i)
  (doc "Resolve the i-th element of application list `xs` (element 0 is the head) to Hir; a missing element
        declines. Recurses through resolve-main-body so nested arithmetic composes.")
  (match (List.at xs i)
    ((Some a) (resolve-main-body a))
    ((None _) (Hir.HError 0))))

; ─── ty : the type language + the Hindley-Milner engine, via EFFECTS ────────────
; Mirrors the native reference compiler `rcdzc`'s `ty.rs` — but where the Rust threads
; two pieces of MUTABLE STATE (`&mut TVarSupply`, `&mut Subst`), the Cadenza version
; performs two EFFECTS, so `unify`/`apply`/`occurs` are PURE functions that perform
; operations and one `handle` per effect discharges them. The imperative "extend the
; substitution" becomes "perform `Subst.bind`; the handler folds it into its state".
;
;   rcdzc (Rust, mutable)        cdzc (Cadenza, effects)
;   ─────────────────────        ───────────────────────
;   supply.fresh()          →    (Fresh.next ())          ; handler state = the counter
;   subst.bind(v, t)        →    (Subst.bind (tuple v t)) ; handler state = the TVar→Ty map
;   subst.apply(ty)         →    (apply ty)  (reads Subst.find)
;
; Three effect FLAVORS appear, which is much of the point of doing it this way:
;   • Fresh  — STATE (a monotonic counter): the type-variable supply.
;   • Subst  — STATE (a CHAMP map TVar→Ty): the growing substitution.
;   • Fail   — ABORTIVE (never resumes): a type error aborts inference to a diagnostic.
; The `handle` wrappers live in `24-infer.cdz` (the pass); this file is the engine.

; ─── the type language (rcdzc `Ty`) ────────────────────────────────────────────
; Inference solves STRUCTURE; the wasm valtype is a read-off of the SOLVED type later
; (Int→i64, Bool→i32), never the thing inferred. `TVar` carries a fresh integer from
; the Fresh supply. (Tuple/Record/Sum/Fn grow as new variants + unify arms, not a new
; mechanism — exactly as rcdzc notes.)
(type Ty
  (TInt Unit          ; the 64-bit signed integer
   | TBool Unit       ; the boolean
   | TUnit Unit       ; the empty product
   | TVar Int64))     ; an unsolved type variable (bound in the Subst once unified)

; The result of unifying two types: success, or a mismatch carrying the two SOLVED
; conflicting types (rcdzc's `Result<(), UnifyError>`).
(type UnifyResult
  (UOk Unit | UMismatch (Tuple Ty Ty)))

; ─── the two state effects + the abortive error effect ──────────────────────────
; A supply of fresh type variables — a monotonic counter (rcdzc's `TVarSupply`).
(effect Fresh
  (op next (-> Unit Int64)))

; The substitution: TVar → its solved Ty. `bind` records a solution; `find` reads one.
; The handler carries a CHAMP map as its state (rcdzc's `Subst`'s `HashMap`).
(effect Subst
  (op bind (-> (Tuple Int64 Ty) Unit))
  (op find (-> Int64 (Option Ty))))

; A unification failure — ABORTIVE: the handler does NOT resume, so a type error
; short-circuits the whole inference to a diagnostic (rcdzc surfaces this as CDZ0201).
(effect Fail
  (op type-error (-> (Tuple Ty Ty) Unit)))

; ─── fresh : a brand-new type variable ──────────────────────────────────────────
(def (fresh-ty)
  (doc "A fresh, never-before-issued type variable — `(TVar n)` for the next counter value.")
  (Ty.TVar (Fresh.next ())))

; ─── apply : resolve a type under the current substitution ──────────────────────
; rcdzc's `Subst::apply`: follow TVar→Ty chains to a ground type or an unbound var. A
; var may resolve to another var, so recurse. (Occurs-check in `unify` prevents cycles.)
(def (apply t)
  (doc "Fully resolve `t` under the current substitution (performs Subst.find), following var→type
        chains transitively to a ground type or an unbound var.")
  (match t
    ((Ty.TVar v)
     (match (Subst.find v)
       ((Some u) (apply u))       ; bound → keep resolving
       ((None _) t)))             ; unbound → itself
    (_ t)))                       ; already ground

; ─── occurs-check ───────────────────────────────────────────────────────────────
; Does TVar `v` appear in `t` (under the substitution)? Prevents an infinite type
; (`a = a → a`). No type constructor CONTAINS a type yet (TInt/TBool/TUnit are leaves),
; so after `apply` this only compares var identities; written to recurse so later
; structural variants (TTuple …) are covered by adding an arm, not new logic.
(def (occurs v t)
  (doc "Whether TVar `v` occurs in `t` under the substitution (after apply). Leaf types can't contain a
        var, so this compares var identities; a structural type would recurse into its elements.")
  (match (apply t)
    ((Ty.TVar w) (= v w))
    (_ false)))

; ─── ground-type equality ───────────────────────────────────────────────────────
(def (ty-eq a b)
  (doc "Structural equality of two GROUND (non-var) types. Two leaves are equal iff same constructor.")
  (match a
    ((Ty.TInt _)  (match b ((Ty.TInt _) true)  (_ false)))
    ((Ty.TBool _) (match b ((Ty.TBool _) true) (_ false)))
    ((Ty.TUnit _) (match b ((Ty.TUnit _) true) (_ false)))
    ((Ty.TVar _)  false)))   ; a var is not a ground type (unify handles vars before calling this)

; ─── unify : make two types equal, extending the substitution ───────────────────
; Standard HM (rcdzc's `unify`), ORDER-INDEPENDENT by construction — the whole point of
; real unification (the seed's coarse-Kind bugs ask-14/…/77 were order-dependence the
; old compiler faked with tie-break tables; here it comes free):
;   • a var unifies with anything (after occurs-check) by binding it;
;   • the SAME var unifies with itself with no change;
;   • two identical ground types succeed; two different ground types FAIL.
; `unify` READS the substitution via `apply` and EXTENDS it via `Subst.bind` — all
; through effects; it takes/returns no substitution.
(def (unify a b)
  (doc "Unify `a` and `b` under the substitution (performs Subst.find via apply, Subst.bind to extend).
        Order-independent: (unify var int) and (unify int var) both bind the var to int. Returns UOk, or
        UMismatch of the two solved conflicting types.")
  (let ((a2 (apply a)) (b2 (apply b)))
    (match a2
      ((Ty.TVar v)
       (match b2
         ((Ty.TVar w) (if (= v w) (UnifyResult.UOk ()) (bind-var v b2)))  ; same var: nothing to do
         (_ (bind-var v b2))))
      (_ (match b2
           ((Ty.TVar w) (bind-var w a2))                                  ; symmetric: bind the var side
           (_ (if (ty-eq a2 b2)
                  (UnifyResult.UOk ())
                  (UnifyResult.UMismatch (tuple a2 b2)))))))))

(def (bind-var v t)
  (doc "Bind TVar `v := t` after the occurs-check. Occurs failure → UMismatch (an infinite type). Success
        performs `Subst.bind` and returns UOk.")
  (if (occurs v t)
      (UnifyResult.UMismatch (tuple (Ty.TVar v) t))
      (do (Subst.bind (tuple v t)) (UnifyResult.UOk ()))))

; ─── must-unify : unify or ABORT with a type error ──────────────────────────────
; The abortive bridge the inference pass uses: on a mismatch, perform `Fail.type-error`
; (the handler does not resume) so inference short-circuits to a diagnostic — instead of
; threading a Result through every node the way rcdzc must in Rust.
(def (must-unify a b)
  (doc "Unify `a` and `b`, or ABORT via the Fail effect on a mismatch (the abortive handler yields the
        diagnostic). Returns Unit on success — the caller need not thread a result.")
  (match (unify a b)
    ((UnifyResult.UOk _) unit)
    ((UnifyResult.UMismatch p) (Fail.type-error p))))

; ─── infer : Hir → typed-Hir, the Hindley-Milner pass (via effects) ─────────────
; Mirrors the native reference compiler `rcdzc`'s `infer.rs`. Real HM (the ask-75
; plan): inference solves over ACTUAL type variables + unification, NOT a coarse
; wasm-valtype lattice re-derived at emit. A yet-unknown operand or branch is a fresh
; var that unifies with its concrete sibling ORDER-INDEPENDENTLY — the whole ask-14/
; …/77 order-dependence family cannot arise.
;
; The distinctive Cadenza shape: rcdzc's `Infer` struct threads `&mut supply` and
; `&mut subst`; here `infer-expr` performs the `Fresh`/`Subst`/`Fail` effects from
; `22-ty.cdz` and the ONE `handle`-stack in `run-infer` discharges them. The pass is
; a pure recursive walk; all state + abort live in the handlers.
;
; SCOPE: this covers cdzc's CURRENT Hir (HInt/HArith/HBit/HShift/HError). As the
; front-end grows the nodes rcdzc already has (HBool/HLocal/HIf/HLet/HCall), each is a
; new `infer-expr` arm (+ a `Ty` variant / unify arm if it introduces structure),
; never a new mechanism — exactly the nanopass discipline.

; A typed Hir node: the node paired with its SOLVED type. (Mirrors rcdzc's `Typed`.)
; Lowering READS `ty-of`; it never re-derives a type.
(type Typed
  (TypedInt (Tuple Int64 Ty)                 ; a literal + its type (TInt)
   | TypedArith (Tuple ArithOp Typed Typed)  ; checked arithmetic, result TInt
   | TypedBit (Tuple BitOp Typed Typed)      ; bitwise/div, result TInt
   | TypedShift (Tuple ShiftOp Typed Typed)  ; shift, result TInt
   | TypedError Int64))                       ; a propagated decline code

(def (ty-of t)
  (doc "The solved type annotation of a typed node (rcdzc's `Typed.ty`).")
  (match t
    ((Typed.TypedInt (tuple n ty)) ty)
    ((Typed.TypedArith (tuple o a b)) (Ty.TInt ()))
    ((Typed.TypedBit (tuple o a b)) (Ty.TInt ()))
    ((Typed.TypedShift (tuple o a b)) (Ty.TInt ()))
    ((Typed.TypedError c) (Ty.TInt ()))))    ; a declined node types trivially; select emits its trap

; ─── infer-expr : the recursive inference walk (performs Fresh/Subst/Fail) ──────
; Each arm mirrors the corresponding `infer.rs` match arm. Operands of a binary op are
; unified against `TInt` (they must be integers); the result is `TInt`. A fresh var is
; NOT needed for these monomorphic ops — it enters with HIf/HLet/HCall (a branch/call
; result), where `run-infer`'s unification makes order irrelevant.
(def (infer-expr h)
  (doc "Infer the type of Hir node `h`, returning the typed node. Performs `must-unify` (→ Subst/Fail) to
        constrain operands. Mirrors rcdzc `Infer::expr`.")
  (match h
    ((Hir.HInt n) (Typed.TypedInt (tuple n (Ty.TInt ()))))
    ((Hir.HArith (tuple o a b)) (Typed.TypedArith (tuple o (infer-int-operand a) (infer-int-operand b))))
    ((Hir.HBit (tuple o a b)) (Typed.TypedBit (tuple o (infer-int-operand a) (infer-int-operand b))))
    ((Hir.HShift (tuple o a b)) (Typed.TypedShift (tuple o (infer-int-operand a) (infer-int-operand b))))
    ((Hir.HError c) (Typed.TypedError c))))

(def (infer-int-operand h)
  (doc "Infer an operand that MUST be an integer: infer it, then unify its type against TInt (aborting via
        Fail on a mismatch — e.g. a Bool operand to `+`). Returns the typed operand.")
  (let ((t (infer-expr h)))
    (do (must-unify (ty-of t) (Ty.TInt ())) t)))

; ─── finalize : resolve every node's type against the completed substitution ────
; rcdzc's `finalize` + `ground`: after the walk, replace each node's type with its
; fully-applied solution; a residual TVar is a compiler bug surfaced as a decline (never
; a silent default). For the current leaf grammar every type is already ground (TInt),
; so finalize is structural; it grows arms with HIf/HLet/HCall. Kept as the explicit
; seam so the "solve, then read the solved type" discipline is visible.
(def (finalize t)
  (doc "Resolve every node's type against the completed substitution (rcdzc `finalize`+`ground`). Current
        grammar is already ground; the seam exists for when vars enter (HIf/HLet/HCall).")
  (match t
    ((Typed.TypedInt (tuple n ty)) (Typed.TypedInt (tuple n (ground ty))))
    ((Typed.TypedArith (tuple o a b)) (Typed.TypedArith (tuple o (finalize a) (finalize b))))
    ((Typed.TypedBit (tuple o a b)) (Typed.TypedBit (tuple o (finalize a) (finalize b))))
    ((Typed.TypedShift (tuple o a b)) (Typed.TypedShift (tuple o (finalize a) (finalize b))))
    ((Typed.TypedError c) (Typed.TypedError c))))

(def (ground ty)
  (doc "Resolve `ty` to a GROUND type against the substitution; a residual var is undetermined — surfaced
        as a decline (rcdzc returns Err; here the sentinel TInt keeps the pass total and select traps). ")
  (let ((r (apply ty)))
    (match r
      ((Ty.TVar v) (Ty.TInt ()))   ; unsolved: a decline (select emits a trap); never a silent wrong type
      (_ r))))

; ─── run-infer : the handler stack that discharges Fresh + Subst + Fail ─────────
; This is where the effects meet their handlers — the Cadenza analogue of rcdzc's
; `infer_module` allocating the supply + subst and threading them. The stack, outside
; in: Fail (abortive — a type error yields a declined result WITHOUT resuming), then
; Subst (state = the CHAMP map TVar→Ty), then Fresh (state = the counter), then the
; inference walk + finalize.
;   • Fresh.next  : returns the current counter, resumes with counter+1.
;   • Subst.bind  : inserts (v→t) into the map state, resumes Unit with the extended map.
;   • Subst.find  : looks the var up, resumes with the Option, state unchanged.
;   • Fail.type-error : does NOT resume — the whole `handle` yields a TypedError decline.
(def (run-infer h)
  (doc "Run the HM inference pass on Hir `h`, returning the finalized typed node — or a TypedError decline
        if a type error aborted it. Discharges the Fresh (counter), Subst (TVar→Ty map), and Fail
        (abortive) effects with one handler stack. Mirrors rcdzc `infer_module`'s supply+subst threading.")
  (handle unit
    ((Fail.type-error (p) s (Typed.TypedError 201)))          ; CDZ0201; abortive — no resume
    (handle Map.empty
      ((Subst.bind (vt) s (match vt ((tuple v t) (resume () (Map.insert s v t)))))
       (Subst.find (v) s (resume (Map.lookup s v) s)))
      (handle 0
        ((Fresh.next (u) s (resume s (+ s 1))))
        (finalize (infer-expr h))))))

; ─── lower : Hir → Mir ─────────────────────────────────────────────────────────
(def (lower h)
  (doc "Lower resolved Hir to Mir. Structural 1:1 at this rung: HInt→MInt; HArith/HBit/HShift→
        MArith/MBit/MShift over the lowered operands (the operator enum carried through); HError→MError.")
  (match h
    ((Hir.HInt n) (Mir.MInt n))
    ((Hir.HArith (tuple o a b)) (Mir.MArith (tuple o (lower a) (lower b))))
    ((Hir.HBit (tuple o a b)) (Mir.MBit (tuple o (lower a) (lower b))))
    ((Hir.HShift (tuple o a b)) (Mir.MShift (tuple o (lower a) (lower b))))
    ((Hir.HError c) (Mir.MError c))))

; ─── eval : Mir → Mir (the one compile-time evaluator) ──────────────────────────
; Identity over arithmetic: the IDEAL lowering of `+ - *` is a RUNTIME checked op that
; TRAPS on overflow (spec numeric-model: `(+ Int64.max 1)` traps, never wraps). Const-
; folding `(+ 1 2)`→3 would be a valid future optimization, but folding must preserve the
; overflow TRAP (a fold that turns an overflowing const add into a value is a miscompile),
; so it is deferred to when the evaluator carries that check. Phase 1: no fold — emit the
; runtime checked op, which is correct for both in-range and overflow inputs.
(def (eval-mir m)
  (doc "The compile-time evaluator (Mir→Mir). Phase 1: identity (ops are emitted as runtime checked ops,
        not folded — folding must preserve the overflow/div/shift traps, deferred to when eval carries them).")
  (match m
    ((Mir.MInt n) (Mir.MInt n))
    ((Mir.MArith (tuple o a b)) (Mir.MArith (tuple o (eval-mir a) (eval-mir b))))
    ((Mir.MBit (tuple o a b)) (Mir.MBit (tuple o (eval-mir a) (eval-mir b))))
    ((Mir.MShift (tuple o a b)) (Mir.MShift (tuple o (eval-mir a) (eval-mir b))))
    ((Mir.MError c) (Mir.MError c))))

; ─── scratch-local budget: how many i64 scratch locals a Mir body needs ─────────
; A node uses DISJOINT scratch slots from its operands (an inner op must not clobber an
; outer's mid-evaluation), so the budget is (this node's own slots) + (sum over operands).
; Own slots by category: checked arith = 3 ($a $b $r); a left shift = 3 ($a $b $r); a
; right shift = 2 ($a $b); a bit op (and/or/xor/div/rem) = 0 (pure stack, div/rem trap
; natively). `select` assigns each op a unique base by threading a running slot counter.
(def (mir-scratch-count m)
  (doc "The number of i64 scratch locals a Mir body needs, summed over the tree: arith=3, left-shift=3,
        right-shift=2, bit-op=0, plus each operand's own need (disjoint slots).")
  (match m
    ((Mir.MInt n) 0)
    ((Mir.MArith (tuple o a b)) (+ 3 (+ (mir-scratch-count a) (mir-scratch-count b))))
    ((Mir.MBit (tuple o a b)) (+ 0 (+ (mir-scratch-count a) (mir-scratch-count b))))
    ((Mir.MShift (tuple o a b)) (+ (shift-scratch o) (+ (mir-scratch-count a) (mir-scratch-count b))))
    ((Mir.MError c) 0)))

(def (shift-scratch o)
  (doc "Own scratch slots for a shift: left needs 3 ($a $b $r — the overflow guard re-shifts the result),
        right needs 2 ($a $b — count guard then arithmetic shift).")
  (match o ((ShiftOp.OpShl _) 3) ((ShiftOp.OpShr _) 2)))

; ─── select : Mir → list Lir (a flat instruction sequence for the body) ─────────
; Emits the body as a flat instruction list, threading `base` = the next free scratch
; slot. An arithmetic op emits: <operand-A code> local.set $a ; <operand-B code>
; local.set $b ; get$a get$b <op> local.set $r ; <overflow guard on $a $b $r> ; get$r.
; The op claims slots [base, base+1, base+2] and gives its operands the slots ABOVE that
; (base+3 onward), threaded left-to-right so no two live ops share a slot.
(def (select m base)
  (doc "Select Mir → a flat `list Lir` body, using scratch slots from `base` up. MInt→[LConst]; MArith→the
        overflow-guarded checked sequence (ideal — traps on overflow, never wraps); MBit→raw stack ops
        (div/rem trap natively); MShift→the guarded shift sequence; MError→[LUnreachable]. Operands recurse
        with a higher base so live ops never share a scratch slot.")
  (match m
    ((Mir.MInt n) (list (Lir.LConst n)))
    ((Mir.MArith (tuple o a b)) (select-arith o a b base))
    ((Mir.MBit (tuple o a b)) (select-bit o a b base))
    ((Mir.MShift (tuple o a b)) (select-shift o a b base))
    ((Mir.MError c) (list (Lir.LUnreachable ())))))

(def (select-arith o a b base)
  (doc "Checked Int64 arithmetic. Map the ArithOp to its operator Lir + overflow-guard tag, then emit the
        common checked-binary sequence. add=0, sub=1, mul=2 (see overflow-guard).")
  (match o
    ((ArithOp.OpAdd _) (select-checked a b base (Lir.LAdd ()) 0))
    ((ArithOp.OpSub _) (select-checked a b base (Lir.LSub ()) 1))
    ((ArithOp.OpMul _) (select-checked a b base (Lir.LMul ()) 2))))

(def (select-bit o a b base)
  (doc "Bitwise & | ^ and div/rem — raw i64 stack ops (no scratch): `<a> <b> <op>`. div_s/rem_s trap
        natively on /0 and Int64.min/-1 (numeric-model: a defined trap, not wrap). Operands take slots from
        `base` up (b after a's need), disjoint.")
  (let ((acode (select a base))
        (bcode (select b (+ base (mir-scratch-count a)))))
    (cat-lir acode (cat-lir bcode (list (bit-instr o))))))

(def (bit-instr o)
  (doc "The single stack instruction for a BitOp.")
  (match o
    ((BitOp.OpAnd _) (Lir.LAnd ())) ((BitOp.OpOr _) (Lir.LOr ())) ((BitOp.OpXor _) (Lir.LXor ()))
    ((BitOp.OpDiv _) (Lir.LDivS ())) ((BitOp.OpRem _) (Lir.LRemS ()))))

(def (select-shift o a b base)
  (doc "A guarded shift `(<< a b)`/`(>> a b)` (numeric-model #Overflow Is Defined). $a=base (value),
        $b=base+1 (count); a LEFT shift also uses $r=base+2. Count guard: `(u64)count >= 64` traps (also
        catches a negative count = a huge unsigned). RIGHT shift = arithmetic `i64.shr_s`. LEFT shift also
        traps on overflow (a bit shifted past the sign): re-shift the result right and compare to $a.
        Matches the native rcdzc `emit_shift`. Operands take slots above this op's own.")
  (let ((sa base) (sb (+ base 1)))
    (let ((acode (select a (+ base (shift-scratch o))))
          (bcode (select b (+ (+ base (shift-scratch o)) (mir-scratch-count a)))))
      (cat-lir acode
      (cat-lir (list (Lir.LLocalSet sa))
      (cat-lir bcode
      (cat-lir (list (Lir.LLocalSet sb))
      (cat-lir (count-guard sb)                                   ; (u64)count>=64 → trap
               (shift-op-body o sa sb base)))))))))

(def (count-guard sb)
  (doc "Shift-count guard: `local.get $b ; i64.const 64 ; i64.ge_u ; if unreachable end` — trap when the
        count (as unsigned) is >= 64 (also catches a negative count).")
  (list (Lir.LLocalGet sb) (Lir.LConst 64) (Lir.LGeU ()) (Lir.LIfUnreachableEnd ())))

(def (shift-op-body o sa sb base)
  (doc "The shift proper after the count guard. RIGHT: `get$a get$b i64.shr_s`. LEFT: `get$a get$b i64.shl`
        into $r=base+2, then overflow guard `get$r get$b i64.shr_s get$a i64.ne → if unreachable`, then get$r.")
  (match o
    ((ShiftOp.OpShr _)
     (list (Lir.LLocalGet sa) (Lir.LLocalGet sb) (Lir.LShrS ())))
    ((ShiftOp.OpShl _)
     (let ((sr (+ base 2)))
       (cat-lir (list (Lir.LLocalGet sa) (Lir.LLocalGet sb) (Lir.LShl ()) (Lir.LLocalSet sr))
       (cat-lir (list (Lir.LLocalGet sr) (Lir.LLocalGet sb) (Lir.LShrS ()) (Lir.LLocalGet sa) (Lir.LNe ()) (Lir.LIfUnreachableEnd ()))
                (list (Lir.LLocalGet sr))))))))

(def (select-checked a b base opinstr optag)
  (doc "Emit the flat checked-binary sequence for `(op a b)` — scratch slots $a=base, $b=base+1, $r=base+2,
        `opinstr` the operator Lir (LAdd/LSub/LMul), `optag` selecting the overflow guard (0=add, 1=sub,
        2=mul). Operands take slots from base+3 up (a: base+3..; b: after a's) so nested ops never share a
        slot; A is stored to $a right after its code so B's code can't disturb it. SIGNED-OVERFLOW GUARD
        (trap when the true mathematical result is out of Int64 range), and the correct test DIFFERS by op:
          add r=a+b: overflow iff ((r xor a) and (r xor b)) < 0
          sub r=a-b: overflow iff ((a xor b) and (a xor r)) < 0
          mul r=a*b: overflow iff a≠0 and r/a≠b   (r/a is i64.div_s of the wrapped product; the one case
                     div can't express — Int64.min/-1 — is where div_s itself traps, which IS the overflow)
        All VALIDATED against exact arithmetic (add: 1+2→3, -5+-3→-8, traps max+1; sub: 10-3→7, 5--3→8, traps
        min-1, max--1; mul: exhaustive edge + 172k random, 0 mismatches — 2*3→6, traps max*2, min*-1, √-boundary).
        `overflow-guard` builds the right one; a nonzero test result trips `if unreachable`.")
  (let ((sa base) (sb (+ base 1)) (sr (+ base 2)))
    (let ((acode (select a (+ base 3)))
          (bcode (select b (+ (+ base 3) (mir-scratch-count a)))))
      (cat-lir acode
      (cat-lir (list (Lir.LLocalSet sa))
      (cat-lir bcode
      (cat-lir (list (Lir.LLocalSet sb))
      (cat-lir (list (Lir.LLocalGet sa) (Lir.LLocalGet sb) opinstr (Lir.LLocalSet sr))
      (cat-lir (overflow-guard sa sb sr optag)
               (list (Lir.LLocalGet sr)))))))))))

(def (overflow-guard sa sb sr optag)
  (doc "The signed-overflow guard instruction run for slots $a=sa,$b=sb,$r=sr: leaves nothing on the stack
        except via a trap. add (0): `((r^a) & (r^b)) < 0` → if-unreachable. sub (1): `((a^b) & (a^r)) < 0`.
        mul (2): `if a≠0 { if r/a ≠ b { unreachable } }` — the nested-if guards div against a=0 (a=0 can't
        overflow); the inner i64.div_s traps on Int64.min/-1 on its own, which is exactly the sole overflow
        case r/a can't detect, so no extra check is needed for it.")
  (if (= optag 0)
      (list (Lir.LLocalGet sr) (Lir.LLocalGet sa) (Lir.LXor ())
            (Lir.LLocalGet sr) (Lir.LLocalGet sb) (Lir.LXor ())
            (Lir.LAnd ()) (Lir.LConst 0) (Lir.LLtS ()) (Lir.LIfUnreachableEnd ()))
  (if (= optag 1)
      (list (Lir.LLocalGet sa) (Lir.LLocalGet sb) (Lir.LXor ())
            (Lir.LLocalGet sa) (Lir.LLocalGet sr) (Lir.LXor ())
            (Lir.LAnd ()) (Lir.LConst 0) (Lir.LLtS ()) (Lir.LIfUnreachableEnd ()))
      (list (Lir.LLocalGet sa) (Lir.LConst 0) (Lir.LNe ()) (Lir.LIfOpen ())     ; if a != 0 {
            (Lir.LLocalGet sr) (Lir.LLocalGet sa) (Lir.LDivS ())                ;   r / a
            (Lir.LLocalGet sb) (Lir.LNe ()) (Lir.LIfUnreachableEnd ())          ;   if (r/a) != b { unreachable }
            (Lir.LEnd ())))))                                                   ; }

(def (cat-lir xs ys)
  (doc "Concatenate two `list Lir` instruction sequences (List.concat — landed 2026-07-08, ask-76).")
  (List.concat xs ys))

; ─── serialize : list Lir → bytes (exhaustive per instruction) ──────────────────
(def (serialize-body code)
  (doc "Serialize a flat `list Lir` body to its wasm bytes, in order. Folds `serialize` over the list.")
  (serialize-body-go code 0 (List.len code) (empty-bytes)))

(def (serialize-body-go code i n acc)
  (doc "Append the bytes of instructions [i,n) of `code` to `acc`, in order.")
  (if (< i n)
      (match (List.at code i)
        ((Some ins) (serialize-body-go code (+ i 1) n (cat acc (serialize ins))))
        ((None _) acc))
      acc))

(def (serialize ins)
  (doc "Serialize one Lir instruction to its wasm opcode bytes. Exhaustive over Lir. Opcode bytes come from
        the shared generated `op` table (05-op.cdz, @generated from wasm-encoder) — NOT hardcoded here — so
        cdzc and the Rust seed share one authoritative opcode source and can never disagree on a byte.")
  (match ins
    ((Lir.LConst n) (cat (u8 op.i64-const) (sleb n)))         ; i64.const n
    ((Lir.LLocalGet i) (cat (u8 op.local-get) (uleb i)))      ; local.get i
    ((Lir.LLocalSet i) (cat (u8 op.local-set) (uleb i)))      ; local.set i
    ((Lir.LAdd _) (u8 op.i64-add))                            ; i64.add
    ((Lir.LSub _) (u8 op.i64-sub))                            ; i64.sub
    ((Lir.LMul _) (u8 op.i64-mul))                            ; i64.mul
    ((Lir.LDivS _) (u8 op.i64-div-s))                         ; i64.div_s
    ((Lir.LRemS _) (u8 op.i64-rem-s))                         ; i64.rem_s
    ((Lir.LXor _) (u8 op.i64-xor))                            ; i64.xor
    ((Lir.LAnd _) (u8 op.i64-and))                            ; i64.and
    ((Lir.LOr _) (u8 op.i64-or))                              ; i64.or
    ((Lir.LShl _) (u8 op.i64-shl))                            ; i64.shl
    ((Lir.LShrS _) (u8 op.i64-shr-s))                         ; i64.shr_s
    ((Lir.LGeU _) (u8 op.i64-ge-u))                           ; i64.ge_u
    ((Lir.LLtS _) (u8 op.i64-lt-s))                           ; i64.lt_s
    ((Lir.LNe _) (u8 op.i64-ne))                              ; i64.ne
    ((Lir.LIfOpen _) (cat (u8 op.if) (u8 0x40)))              ; if (empty blocktype)
    ((Lir.LEnd _) (u8 op.end))                                ; end
    ((Lir.LIfUnreachableEnd _) (cat (u8 op.if) (cat (u8 0x40) (cat (u8 op.unreachable) (u8 op.end)))))  ; if(empty) unreachable end
    ((Lir.LUnreachable _) (u8 op.unreachable))))              ; unreachable

; ─── fold : the ONE compile-time evaluator (constant folding) ───────────────────
; Mirrors the native reference compiler `rcdzc`'s `fold.rs`. metaprogramming.md §"Compile-Time
; Evaluation Is One Tier": macro expansion, generic reduction, monomorphization, and constant folding
; MUST be the SAME mechanism. This pass is that mechanism; today it does constant folding, and the same
; reduction extends to call β-reduction / generics / macros as the IR grows (MCall/MLet/MIf land).
; It is pure and deterministic — reads no host, no clock, no randomness.
;
; ── Three-way fold, over `Mir` ITSELF (no separate value type) ──
; Each node folds to one of three shapes, ALL expressed in `Mir` (so `fold : Mir → Mir`, and a
; partially-reduced program is the same kind of thing as a fully-reduced one — what keeps "one tier"
; honest):
;   • a CONST   — `MInt` (later MBool/MUnit/const-MTuple);
;   • a POISON  — `MError code`: a constant op with NO value (overflow / div0 / bad shift). Poison
;                 PROPAGATES through strict operators like a value, but is DROPPED by dead-code
;                 elimination at an unreached branch (when MIf lands);
;   • DYNAMIC   — anything else (a runtime op with a non-const child), left as code with folded children.
;
; ── Traps are compile-time diagnostics, but only when REACHED (the operator ruling: CDZ0304) ──
; A CONSTANT operation that would trap is POISON carrying CDZ0304 — the compiler FAILS THE BUILD rather
; than shipping a component that traps ("where this language shines"). But a poison in a branch folding
; proves is never taken is DROPPED — reachability falls out of the fold. A trap over RUNTIME operands is
; never folded and stays a runtime trap (select emits the guard): folding neither MANUFACTURES a trap the
; source didn't denote nor ERASES one it did.
;
; ── ⚡ THE SELF-HOSTING TWIST — and its clean resolution ──
; rcdzc folds `+` with Rust's `checked_add` — Option, no trap. In Cadenza `+` is the CHECKED op that
; TRAPS on overflow, so the folder CANNOT compute `(+ x y)` to inspect it — that would trap the COMPILER
; on `(+ Int64.max 1)` instead of yielding poison. The RIGHT answer is NOT to hand-roll overflow
; predicates but to use the LANGUAGE'S OWN fallible companions: `Int64.checked-add/sub/mul :
; (Int64,Int64) -> Option<Int64>` (spec 06-numeric-model.sexp #Overflow Is Defined — the exact result
; when it fits, `(None)` on overflow). So the folder mirrors rcdzc's `x.checked_add(y)` VERBATIM, with
; `Int64.checked-add` in place of Rust's method — `Some v`→`MInt v`, `None`→poison. (div/rem/shift trap
; only on inputs the folder tests cheaply — `y=0`, `y=-1`, count range — so no checked primitive needed.)

; ── the diagnostic channel: a Diag EFFECT (continues the 22-ty.cdz effects theme) ──
; A reached poison is a diagnostic. Rather than thread an accumulator list (rcdzc's `out: &mut Vec`),
; the collector PERFORMS `Diag.emit`; a handler accumulates the codes. This is the SAME diagnostic
; currency as inference's `Fail` — all of infer's type errors, fold's const-traps, and select's declines
; become one `Diag` channel (rcdzc's `CompileOutput { diagnostics }`, effect-shaped).
(effect Diag
  (op emit (-> Int64 Unit))       ; record a diagnostic code
  (op count (-> Unit Int64)))     ; read how many have accumulated (the pipeline reads this to decide
                                  ; success/failure; a nonzero count = the build failed)

; ── const / poison shape readers ──
(def (is-const m)
  (doc "Whether `m` is a fully-known compile-time constant. (MInt today; MBool/MUnit/const-MTuple as the
        IR grows.) A poison is NOT a const — it has no value.")
  (match m ((Mir.MInt n) true) (_ false)))

(def (is-poison m)
  (doc "Whether `m` is a poison — a constant op with no value (MError).")
  (match m ((Mir.MError c) true) (_ false)))

(def (as-int m)
  (doc "The Int of a const `MInt` as `(Some n)`, else `(None)`.")
  (match m ((Mir.MInt n) (Some n)) (_ (None ()))))

(def (poison)
  (doc "A fresh poison carrying the constant-trap diagnostic code CDZ0304.")
  (Mir.MError 304))

(def (first-poison a b)
  (doc "The first of two operands that is a poison (so poison propagates through a strict op), as an
        Option Mir.")
  (if (is-poison a) (Some a) (if (is-poison b) (Some b) (None ()))))

; ── the fold (three-way, bottom-up) ──
(def (fold m)
  (doc "Fold one Mir node bottom-up → a const, a poison (MError), or a dynamic node with folded children.
        Mirrors rcdzc `Ctx::fold`. Leaves are already reduced; each binary op folds its operands then
        tries to reduce.")
  (match m
    ((Mir.MInt n) m)                                       ; const leaf
    ((Mir.MError c) m)                                     ; already poison
    ((Mir.MArith (tuple o a b)) (fold-arith o (fold a) (fold b)))
    ((Mir.MBit (tuple o a b)) (fold-bit o (fold a) (fold b)))
    ((Mir.MShift (tuple o a b)) (fold-shift o (fold a) (fold b)))))

; ── checked arithmetic: the language's OWN fallible companions (mirrors rcdzc verbatim) ──
(def (fold-arith o a b)
  (doc "Fold checked +/-/*. Poison propagates. Two const ints: use `Int64.checked-{add,sub,mul}` (→
        Option) — `(Some v)`→MInt v, `(None)`→poison. This is rcdzc's `x.checked_add(y)` with the
        language's own primitive, so the folder never runs the TRAPPING op on constants it hasn't proven
        safe. Non-const → a dynamic node.")
  (match (first-poison a b)
    ((Some p) p)
    ((None _)
     (match (tuple (as-int a) (as-int b))
       ((tuple (Some x) (Some y)) (from-checked (checked-arith o x y)))
       (_ (Mir.MArith (tuple o a b)))))))

(def (checked-arith o x y)
  (doc "The fallible companion of the checked operator `o` on two const ints → Option Int64.")
  (match o
    ((ArithOp.OpAdd _) (Int64.checked-add x y))
    ((ArithOp.OpSub _) (Int64.checked-sub x y))
    ((ArithOp.OpMul _) (Int64.checked-mul x y))))

(def (from-checked r)
  (doc "An `Option Int64` fold result → a const `MInt` (fits) or a poison (overflow).")
  (match r ((Some v) (Mir.MInt v)) ((None _) (poison))))

; ── bitwise / division ──
(def (fold-bit o a b)
  (doc "Fold & | ^ / %. And/Or/Xor never trap → always compute when const. Div traps on /0 and MIN/-1
        (→ poison). Rem traps on /0, but MIN%-1 (and n%-1) is DEFINED as 0 (never manufacture that trap
        — the numeric-model rem-by-minus-one ruling). Poison propagates; non-const → dynamic node.")
  (match (first-poison a b)
    ((Some p) p)
    ((None _)
     (match (tuple (as-int a) (as-int b))
       ((tuple (Some x) (Some y))
        (match o
          ((BitOp.OpAnd _) (Mir.MInt (& x y)))
          ((BitOp.OpOr _) (Mir.MInt (| x y)))
          ((BitOp.OpXor _) (Mir.MInt (^ x y)))
          ((BitOp.OpDiv _)
           (if (= y 0) (poison)
           (if (and (= x Int64.min) (= y -1)) (poison)
               (Mir.MInt (/ x y)))))
          ((BitOp.OpRem _)
           (if (= y 0) (poison)
           (if (= y -1) (Mir.MInt 0)                       ; n % -1 = 0 for all n (incl. MIN) — NOT a trap
               (Mir.MInt (% x y)))))))
       (_ (Mir.MBit (tuple o a b)))))))

; ── shifts ──
(def (fold-shift o a b)
  (doc "Fold << >>. Count out of range [0,64) → poison (matches the runtime count guard). Right shift is
        arithmetic (never overflows). LEFT shift traps on overflow (a bit shifted past the sign): detect
        via an arithmetic RIGHT shift on the operand (which never traps) BEFORE the left shift, then
        compute only if safe. Poison propagates; non-const → dynamic node.")
  (match (first-poison a b)
    ((Some p) p)
    ((None _)
     (match (tuple (as-int a) (as-int b))
       ((tuple (Some v) (Some c))
        (if (bad-shift-count c) (poison)
            (match o
              ((ShiftOp.OpShr _) (Mir.MInt (>> v c)))       ; arithmetic right shift: always safe
              ((ShiftOp.OpShl _) (if (shl-overflows v c) (poison) (Mir.MInt (<< v c)))))))
       (_ (Mir.MShift (tuple o a b)))))))

(def (bad-shift-count c)
  (doc "Whether a shift count is out of range — `c < 0 or c >= 64` (matches the runtime `(u64)c >= 64`
        guard, which also catches a negative as a huge unsigned).")
  (if (< c 0) true (if (>= c 64) true false)))

(def (shl-overflows v c)
  (doc "Whether `v << c` overflows (a bit shifted past the sign), WITHOUT doing the trapping left shift.
        `v << c` fits iff bits [63-c .. 63] of v are all the sign bit — i.e. `(v >> (63-c))` (ARITHMETIC
        right shift, never traps; 63-c is a valid count for c in [0,63]) is 0 (v small +) or -1 (small -).
        c=0 → v>>63 = the sign (always fits, identity); c=63 → v>>0 = v, fits iff v ∈ {0,-1}.")
  (let ((s (>> v (- 63 c))))
    (if (= s 0) false (if (= s -1) false true))))

; ── reached-poison collection → the Diag effect ──
; rcdzc's `collect_reached_poisons` appends to `out: &mut Vec<&Reject>`; here it PERFORMS `Diag.emit`
; for each poison at an UNCONDITIONALLY-REACHED position (the effect-shaped multi-diagnostic). A reached
; poison is a build failure (the operator ruling); an UNREACHED one (in a dropped if-branch) never
; reaches this walk because `fold` already dropped it. With the CURRENT node set EVERY position is strict
; (no MIf yet ⇒ no shielding), so this descends every operand; the `if`-branch shielding arm lands with
; MIf (descend the condition, NOT the branches — a runtime-conditional trap stays a runtime trap).
(def (collect-poisons m)
  (doc "Emit (via Diag.emit) the CDZ code of every poison at a reached position in folded `m`. All current
        positions are strict, so descend every operand. Mirrors rcdzc `collect_reached_poisons`.")
  (match m
    ((Mir.MError c) (Diag.emit c))
    ((Mir.MArith (tuple o a b)) (do (collect-poisons a) (collect-poisons b)))
    ((Mir.MBit (tuple o a b)) (do (collect-poisons a) (collect-poisons b)))
    ((Mir.MShift (tuple o a b)) (do (collect-poisons a) (collect-poisons b)))
    ((Mir.MInt n) unit)))

; ── eval-mir : the pass entry (replaces the identity stub in 30-lower.cdz) ──
; NOTE: 30-lower.cdz currently defines `eval-mir` as the IDENTITY (folding a trap without this poison
; machinery would be a miscompile — precisely why it was deferred). This IS that machinery, so `eval-mir`
; should now delegate here. (Kept as a distinct name so the pipeline seam is unchanged; when this file is
; live, DELETE the identity `eval-mir` in 30-lower.cdz and use this one.)
(def (eval-mir-folding m)
  (doc "The compile-time evaluator pass: fold the Mir tree. The pipeline then runs `collect-poisons` under
        a Diag handler; any emitted CDZ0304 FAILS the build (a proven constant trap is not shipped).")
  (fold m))

; @generated by `cargo run -p xtask` from xtask/src/frame.rs. DO NOT EDIT — edit the generator.
;
; The scalar-int component frame for cdzc.cdz: a nullary `run : () -> s64` component around a serialized
; i64 body. The FIXED byte segments below are top-level VALUE definitions derived from wasm-encoder (the
; authoritative encoder of the wasm/component-model bytes) — the same magic-value sharing as op.cdz and the
; heap envelope. The length-computing assembly (section/wvec/sized) stays in Cadenza because a section's
; length prefix depends on the body length.

(def frame-core-magic (Bytes.of (list 0x00 0x61 0x73 0x6D 0x01 0x00 0x00 0x00)))   ; core module: \0asm v1 preamble
(def frame-functype-run (Bytes.of (list 0x60 0x00 0x01 0x7E)))   ; functype () -> i64
(def frame-run-name (Bytes.of (list 0x72 0x75 0x6E)))   ; the export name "run"
(def frame-comp-magic (Bytes.of (list 0x00 0x61 0x73 0x6D 0x0D 0x00 0x01 0x00)))   ; component: preamble
(def frame-comp-instance (Bytes.of (list 0x02 0x04 0x01 0x00 0x00 0x00)))   ; section 2: core instance (instantiate module 0)
(def frame-comp-type-run (Bytes.of (list 0x07 0x05 0x01 0x40 0x00 0x00 0x78)))   ; section 7: component type () -> s64 (0x78)
(def frame-comp-canon-lift (Bytes.of (list 0x06 0x09 0x01 0x00 0x00 0x01 0x00 0x03 0x72 0x75 0x6E)))   ; section 6: canon lift of core run
(def frame-comp-func-alias (Bytes.of (list 0x08 0x06 0x01 0x00 0x00 0x00 0x00 0x00)))   ; section 8: component func alias
(def frame-comp-export-run (Bytes.of (list 0x0B 0x09 0x01 0x00 0x03 0x72 0x75 0x6E 0x01 0x00 0x00)))   ; section 11: export "run"

(def (core-module code-bytes)
  (doc "The embedded core module for a nullary `run : () -> i64` with NO scratch locals — the scalar case.
        Delegates to core-module-locals with a 0 local count.")
  (core-module-locals code-bytes 0))

(def (core-module-locals code-bytes nlocals)
  (doc "The embedded core module for a nullary `run : () -> i64`, given main's serialized body bytes and
        `nlocals` i64 scratch locals (0 for a scalar body; 3 per checked arithmetic op). Assembles the
        generated fixed segments with the length-computing structure; the code entry declares the locals.")
  (cat frame-core-magic
  (cat (section 1 (wvec 1 frame-functype-run))                          ; type: () -> i64
  (cat (section 3 (wvec 1 (u8 0x00)))                                   ; func 0 : type 0
  (cat (section 7 (wvec 1 (cat (u8 0x03) (cat frame-run-name (Bytes.of (list 0x00 0x00))))))  ; export "run"
       (section 10 (wvec 1 (sized (cat (locals-decl nlocals) (cat code-bytes (u8 0x0B))))))))))) ; code: <locals> <body> end

(def (wrap-component core)
  (doc "Wrap the core module in the component envelope, presenting core func 0 (run) as the component
        export run : () -> s64. Assembles the generated component-section segments around the core module.")
  (cat frame-comp-magic
  (cat (cat (u8 0x01) (sized core))                                     ; section 1: embedded core module
  (cat frame-comp-instance
  (cat frame-comp-type-run
  (cat frame-comp-canon-lift
  (cat frame-comp-func-alias
       frame-comp-export-run)))))))

; ─── compile-bytes : Bytes → Bytes (the pipeline; the harness/ABI entry) ────────
; ⚠ SINGLE-ENTRY PIPELINE — TO BE REPLACED (user directive 2026-07-08; task #16).
; This runs ONE resolve-program→…→wrap-component for a single `main`. The ratified
; model is MULTI-EXPORT: resolve collects `(export name…)`, a layout carries EVERY
; export by SIGNATURE, and the frame emits the N-export envelope mechanically (mirror
; rcdzc — seed/crates/rcdzc/{resolve,layout,component,serialize}.rs). The single-`run`
; envelope in the @generated 40-frame.cdz (fix its generator xtask/src/frame.rs) is
; part of what's replaced. See 20-resolve.cdz's header flag for the full picture.
(def (compile-bytes b)
  (doc "The whole pipeline: `decode` the program bytes to an Ast with our own recursive-descent parser
        (NOT a runtime `Ast.decode` host op — ask-69 retired), resolve → Hir, lower → Mir, eval-mir,
        select → a flat `list Lir` body (threading scratch-local slots from 0), serialize-body → bytes,
        and frame the scalar component with the body's scratch-local count. A scalar `main` needs 0 scratch
        locals; a checked arithmetic op needs 3 per op (see mir-scratch-count). Any unhandled shape lowers
        to MError → `unreachable` (a clean decline trap), still a valid component.")
  (let ((m (eval-mir (lower (resolve-program (decode b))))))
    (wrap-component (core-module-locals (serialize-body (select m 0)) (mir-scratch-count m)))))

(export compile-bytes)
