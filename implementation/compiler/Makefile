# Build the Cadenza-authored compiler `cdzc.cdz` by concatenating its submodule
# sources under `cdzc/`. The language has no imports yet, so the "module" is one
# file the seed compiles — but we AUTHOR it as separate files (one per pass /
# concern) and merge them here. Top-level `def`/`type` ordering does not matter to
# the seed (use-before-def and type-after-use both compile), so a plain
# lexicographic concatenation of `cdzc/*.cdz` is a sound module body.
#
# Some sources under `cdzc/` are themselves @generated by the seed's xtask
# (`cargo run -p xtask` in implementation/seed/xtask) — the opcode table and the
# component/frame byte blobs, whose authoritative encoder is wasm-encoder. The
# Makefile only MERGES; it does not hand-maintain those bytes.
#
# Usage:  make            # (re)build cdzc.cdz if any source changed
#         make clean      # remove the generated cdzc.cdz

SRC_DIR := cdzc
SRCS    := $(sort $(wildcard $(SRC_DIR)/*.cdz))
OUT     := cdzc.cdz

.PHONY: all clean
all: $(OUT)

# The generated compiler = a header comment, the `(module cdzc` open, every source
# file's body in sorted order, then the closing `)`. Written atomically via a temp
# file so a partial write never leaves a broken cdzc.cdz.
$(OUT): $(SRCS) Makefile
	@printf '; @generated by `make` from %s/*.cdz — DO NOT EDIT; edit the sources.\n' '$(SRC_DIR)' > $(OUT).tmp
	@printf ';\n; The Cadenza compiler, rewritten from scratch (Ast -> Hir -> Mir -> Lir).\n' >> $(OUT).tmp
	@printf '; Authored as separate files under %s/ and merged here (no imports yet).\n\n' '$(SRC_DIR)' >> $(OUT).tmp
	@for f in $(SRCS); do cat "$$f" >> $(OUT).tmp; printf '\n' >> $(OUT).tmp; done
	@printf '(export compile-bytes)\n' >> $(OUT).tmp
	@mv $(OUT).tmp $(OUT)
	@echo "built $(OUT) from $(words $(SRCS)) source(s)"

clean:
	@rm -f $(OUT) $(OUT).tmp
