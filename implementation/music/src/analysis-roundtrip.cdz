/// analysis-roundtrip.cdz — a GATE pinning that chord construction and identification are inverses.
///
/// chord.cdz builds a named chord (major-triad, dominant-seventh, …) FROM a root; analysis.cdz's
/// `identify` names a note set's quality. They MUST round-trip: build a named chord, realize its notes,
/// identify them against the same root, and you must get the quality you started with. This file is pure
/// coverage — it witnesses the construct↔identify inverse for every named quality at several roots, so a
/// future change to EITHER chord.cdz's stacks OR analysis.cdz's matching can't silently drift them apart
/// (the shared gate rejects it). Both modules are already on trunk; this pins their relationship.
///
/// No new surface — it only imports the two landed layers + pitch, and asserts.
import { Pitch } from "pitch"

import { Chord } from "chord"

import { major-triad, minor-triad, diminished-triad, augmented-triad } from "chord"

import { major-seventh, dominant-seventh, minor-seventh, half-diminished, diminished-seventh } from "chord"

import { chord-notes, chord-inversion } from "chord"

import { Quality, identify } from "analysis"

/// Identify the notes of a chord (built at root `r`), against that same root.
def id-of(c: Chord, r: Pitch) = identify(chord-notes(c), r)

/// ============================ @test suite (construct↔identify round-trip) ============================
@test
def every-named-triad-round-trips-at-c() =
  // Build each named triad at C (60), realize + identify against C → the same quality.
  let c = Pitch.Pitch(60) in
  match id-of(major-triad(c), c) with
    | Quality.MajorTriad => (match id-of(minor-triad(c), c) with
      | Quality.MinorTriad => (match id-of(diminished-triad(c), c) with
        | Quality.DiminishedTriad => (match id-of(augmented-triad(c), c) with
          | Quality.AugmentedTriad => unit
          | _ => trap("aug triad round-trip")
        )
        | _ => trap("dim triad round-trip")
      )
      | _ => trap("minor triad round-trip")
    )
    | _ => trap("major triad round-trip")

@test
def every-named-seventh-round-trips-at-c() =
  // The four (well, five) named sevenths at C round-trip through construct→identify.
  let c = Pitch.Pitch(60) in
  match id-of(major-seventh(c), c) with
    | Quality.MajorSeventh => (match id-of(dominant-seventh(c), c) with
      | Quality.DominantSeventh => (match id-of(minor-seventh(c), c) with
        | Quality.MinorSeventh => (match id-of(half-diminished(c), c) with
          | Quality.HalfDiminished => (match id-of(diminished-seventh(c), c) with
            | Quality.DiminishedSeventh => unit
            | _ => trap("dim7 round-trip")
          )
          | _ => trap("half-dim round-trip")
        )
        | _ => trap("min7 round-trip")
      )
      | _ => trap("dom7 round-trip")
    )
    | _ => trap("maj7 round-trip")

@test
def round-trip-is-root-independent() =
  // The inverse holds at ANY root, not just C: a major triad built at F#4 (66) identifies as MajorTriad
  // against F#, and a dominant seventh at Bb3 (58) identifies as DominantSeventh against Bb.
  let fsharp = Pitch.Pitch(66) in
  let bflat = Pitch.Pitch(58) in
  match id-of(major-triad(fsharp), fsharp) with
    | Quality.MajorTriad => (match id-of(dominant-seventh(bflat), bflat) with
      | Quality.DominantSeventh => unit
      | _ => trap("dom7 at Bb round-trips")
    )
    | _ => trap("major triad at F# round-trips")

@test
def identify-survives-every-actual-inversion() =
  // End-to-end inversion invariance against chord.cdz's OWN inversions (not hand-built note lists): a
  // C-major triad in root position, 1st and 2nd inversion all identify as MajorTriad against C. This ties
  // analysis's inversion-invariance to chord-inversion's real output — if either drifts, this fails.
  let c = Pitch.Pitch(60) in
  let cmaj = major-triad(c) in
  match identify(chord-inversion(cmaj, 0), c) with
    | Quality.MajorTriad => (match identify(chord-inversion(cmaj, 1), c) with
      | Quality.MajorTriad => (match identify(chord-inversion(cmaj, 2), c) with
        | Quality.MajorTriad => unit
        | _ => trap("2nd inversion")
      )
      | _ => trap("1st inversion")
    )
    | _ => trap("root position")

@test
def augmented-triad-inversion-is-still-augmented-against-original-root() =
  // The augmented triad {0,4,8} is symmetric: every inversion is another augmented triad. Against the
  // ORIGINAL root C, its 1st and 2nd inversions still identify as AugmentedTriad (the symmetry doesn't
  // confuse the identifier — the signature folds back to {0,4,8}).
  let c = Pitch.Pitch(60) in
  let aug = augmented-triad(c) in
  match identify(chord-inversion(aug, 1), c) with
    | Quality.AugmentedTriad => (match identify(chord-inversion(aug, 2), c) with
      | Quality.AugmentedTriad => unit
      | _ => trap("2nd inversion augmented")
    )
    | _ => trap("1st inversion augmented")

@test
def half-diminished-and-diminished-seventh-are-distinguished() =
  // The subtle pair: half-diminished [0,3,6,10] and diminished-seventh [0,3,6,9] share the SAME lower
  // triad (diminished, [0,3,6]) and differ ONLY in the seventh (minor 10 vs diminished 9). identify must
  // not confuse them — pins that the full 4-note signature (not just the triad) decides the quality.
  let c = Pitch.Pitch(60) in
  match id-of(half-diminished(c), c) with
    | Quality.HalfDiminished => (match id-of(diminished-seventh(c), c) with
      | Quality.DiminishedSeventh => unit
      | Quality.HalfDiminished => trap("dim7 must not read as half-dim — the seventh differs")
      | _ => trap("dim7")
    )
    | Quality.DiminishedSeventh => trap("half-dim must not read as dim7 — the seventh differs")
    | _ => trap("half-dim")

@test
def a-seventh-analyzed-against-the-wrong-root-is-not-its-named-quality() =
  // Root-relative guarantee at the 4-note level: a C dominant-seventh (C E G Bb) analyzed against the
  // WRONG root E is NOT DominantSeventh (its signature relative to E is a different, non-dom7 set). Pins
  // that identification of sevenths — like triads — is anchored to the given root, not a rootless set match.
  let cdom7 = dominant-seventh(Pitch.Pitch(60)) in
  match identify(chord-notes(cdom7), Pitch.Pitch(64)) with
    | Quality.DominantSeventh => trap("against the wrong root E it must not read as a C dom7")
    | _ => unit

@test
def identification-works-in-a-sub-zero-register() =
  // Robustness: a major triad built low (root C at MIDI 0 = C-1) still identifies as MajorTriad — the
  // pitch-class folding handles the low register the same as the middle one (no sign/negative-note bug).
  let low-c = Pitch.Pitch(0) in
  match id-of(major-triad(low-c), low-c) with
    | Quality.MajorTriad => unit
    | _ => trap("a major triad at C-1 (MIDI 0) still identifies")

@test
def a-triad-is-not-mis-identified-as-a-seventh() =
  // Cross-guard: a three-note triad must NOT identify as any four-note seventh (different signature
  // length), and vice versa — the construct/identify inverse is exact, not fuzzy.
  let c = Pitch.Pitch(60) in
  match id-of(major-triad(c), c) with
    | Quality.MajorSeventh => trap("a triad is not a seventh")
    | Quality.DominantSeventh => trap("a triad is not a seventh")
    | _ => match id-of(dominant-seventh(c), c) with
      | Quality.MajorTriad => trap("a seventh is not a triad")
      | _ => unit

export { id-of }
