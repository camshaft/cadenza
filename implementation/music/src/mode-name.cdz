/// mode-name.cdz — name a scale's MODE from its step pattern (the inverse of scale.cdz's `mode`).
///
/// scale.cdz builds a diatonic mode FROM an index (`mode(root, i)`, 0 = Ionian … 6 = Locrian) by rotating
/// the major step pattern. This goes the other way: given a scale's STEP LIST, identify which diatonic
/// mode it is — the analysis complement (like analysis.cdz names a chord, key.cdz names a key). Matches the
/// step list against each `mode-steps(i)`; returns the mode, or `Unknown` for a non-diatonic scale.
///
/// Grounds only on scale.cdz (`scale-steps`, `mode-steps`) — a fresh inverse primitive, no new theory.
import { Scale } from "scale"

import { scale-steps, mode-steps } from "scale"

// ---- the diatonic modes ------------------------------------------------------------------------------
/// A named diatonic mode, or `Unknown` for a step pattern that is not a rotation of the major scale.
type Mode =
  | Ionian
  | Dorian
  | Phrygian
  | Lydian
  | Mixolydian
  | Aeolian
  | Locrian
  | Unknown

/// The `Mode` for a diatonic mode index 0..6 (the order `scale.cdz`'s `mode` uses); anything else Unknown.
def mode-of-index(i: Int64) = match i with
  | 0 => Mode.Ionian
  | 1 => Mode.Dorian
  | 2 => Mode.Phrygian
  | 3 => Mode.Lydian
  | 4 => Mode.Mixolydian
  | 5 => Mode.Aeolian
  | 6 => Mode.Locrian
  | _ => Mode.Unknown

// ---- comparing step lists ----------------------------------------------------------------------------
/// Exact equality of two Int64 step lists (element-wise). Recursive, annotated (CDZ0201).
def steps-eq(a: List(Int64), b: List(Int64)) = match a with
  | [] => (match b with
    | [] => true
    | [_, .. _] => false
  )
  | [ha, .. ta] => match b with
    | [] => false
    | [hb, .. tb] => if ha == hb then steps-eq(ta, tb) else false

// ---- identifying the mode ----------------------------------------------------------------------------
/// Scan mode indices `i .. 6`, returning `Some(index)` of the mode whose `mode-steps(i)` equals `steps`, or
/// `None` if none match. Returns a typed Option — no sentinel index flows in-band. Recursive, annotated.
def match-mode-go(steps: List(Int64), i: Int64) =
  if i > 6 then
    Option.None(unit)
  else if steps-eq(steps, mode-steps(i)) then
    Option.Some(i)
  else
    match-mode-go(steps, i + 1)

/// Identify the diatonic MODE of a scale from its step pattern: the mode whose rotation of the major scale
/// matches, or `Unknown` if the step list is not a diatonic-mode rotation. Aeolian/Ionian etc. fall out.
def name-mode(s: Scale) = match match-mode-go(scale-steps(s), 0) with
  | Option.Some(idx) => mode-of-index(idx)
  | Option.None(_) => Mode.Unknown

/// Identify a mode directly from a step list (not wrapped in a `Scale`).
def name-mode-steps(steps: List(Int64)) = match match-mode-go(steps, 0) with
  | Option.Some(idx) => mode-of-index(idx)
  | Option.None(_) => Mode.Unknown

/// Is a scale one of the seven diatonic modes (i.e. `name-mode` is not `Unknown`)?
def is-diatonic-mode(s: Scale) = match name-mode(s) with
  | Mode.Unknown => false
  | _ => true

/// ============================ @test suite (mode-naming laws) ============================
@test
def the-major-pattern-is-ionian() =
  // [2,2,1,2,2,2,1] is Ionian (the major scale).
  match name-mode-steps([2, 2, 1, 2, 2, 2, 1]) with
    | Mode.Ionian => unit
    | _ => trap("the major step pattern is Ionian")

@test
def the-natural-minor-pattern-is-aeolian() =
  // Natural minor [2,1,2,2,1,2,2] is Aeolian (mode index 5 = major rotated left by 5).
  match name-mode-steps([2, 1, 2, 2, 1, 2, 2]) with
    | Mode.Aeolian => unit
    | _ => trap("natural minor is Aeolian")

@test
def dorian-and-phrygian-and-lydian-are-named() =
  // Dorian [2,1,2,2,2,1,2], Phrygian [1,2,2,2,1,2,2], Lydian [2,2,2,1,2,2,1].
  match name-mode-steps([2, 1, 2, 2, 2, 1, 2]) with
    | Mode.Dorian => (match name-mode-steps([1, 2, 2, 2, 1, 2, 2]) with
      | Mode.Phrygian => (match name-mode-steps([2, 2, 2, 1, 2, 2, 1]) with
        | Mode.Lydian => unit
        | _ => trap("Lydian")
      )
      | _ => trap("Phrygian")
    )
    | _ => trap("Dorian")

@test
def locrian-is-the-last-mode() =
  // Locrian [1,2,2,1,2,2,2] (index 6).
  match name-mode-steps([1, 2, 2, 1, 2, 2, 2]) with
    | Mode.Locrian => unit
    | _ => trap("Locrian")

@test
def a-non-diatonic-pattern-is-unknown() =
  // The harmonic minor [2,1,2,2,1,3,1] (with its augmented second) is NOT a rotation of the major scale,
  // so it is Unknown — a non-vacuous negative.
  match name-mode-steps([2, 1, 2, 2, 1, 3, 1]) with
    | Mode.Unknown => unit
    | _ => trap("harmonic minor is not a diatonic mode")

@test
def round-trips-scale-cdz-mode-steps() =
  // The inverse law: for every mode index 0..6, name-mode-steps(mode-steps(i)) recovers that mode. Ties
  // this module to scale.cdz's OWN mode-steps output (if either drifts, this fails).
  let ok0 = match name-mode-steps(mode-steps(0)) with
      | Mode.Ionian => true
      | _ => false in
  let ok2 = match name-mode-steps(mode-steps(2)) with
      | Mode.Phrygian => true
      | _ => false in
  let ok6 = match name-mode-steps(mode-steps(6)) with
      | Mode.Locrian => true
      | _ => false in
  if ok0 then
    if ok2 then if ok6 then unit else trap("Locrian round-trip") else trap("Phrygian round-trip")
  else
    trap("Ionian round-trip")

@test
def is-diatonic-mode-rejects-a-non-mode() =
  // is-diatonic-mode is true for a real mode's scale, false for a non-diatonic step list.
  if is-diatonic-mode(Scale.Scale(0, [2, 2, 1, 2, 2, 2, 1])) then
    if is-diatonic-mode(Scale.Scale(0, [2, 1, 2, 2, 1, 3, 1])) then
      trap("harmonic minor is not diatonic")
    else
      unit
  else
    trap("major scale is a diatonic mode")

export { Mode.*, mode-of-index, name-mode, name-mode-steps, is-diatonic-mode }
