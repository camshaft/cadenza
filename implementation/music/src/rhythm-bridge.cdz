/// rhythm-bridge.cdz — the cross-layer consistency gate for TIME (the layer-bridge twin for rhythm).
///
/// The operator's rationals-everywhere directive applies to time as well as pitch: rhythm-ratio.cdz models
/// a duration as an exact RATIONAL fraction of a whole note (`r-quarter` = 1/4), while rhythm.cdz models it
/// as an Int64 TICK count on a PPQ grid (`quarter` = 960 = ppq). They must AGREE: a duration's tick count,
/// as a fraction of the whole-note tick count, must equal its rational whole-note fraction. This gate pins
/// that so a future change to EITHER rhythm layer (a PPQ change, a rational redefinition) can't silently
/// drift the two representations of time apart — the exact analogue of layer-bridge for pitch.
///
/// The comparison stays in RATIONAL space (`Rational.of(tick-count(d), tick-count(whole))` vs
/// `whole-notes(r-d)`), so it needs no Rational->Int64 conversion (which the prelude still lacks) — it's a
/// pure exact-rational equality.
import { Duration, tick-count, whole, half, quarter, eighth, sixteenth } from "rhythm"

import { RDuration, whole-notes, r-whole, r-half, r-quarter, r-eighth, r-sixteenth } from "rhythm-ratio"

/// Assert an Int64 tick duration `d` agrees with the rational duration `rd`: `d`'s tick count as a fraction
/// of a whole note (`tick-count d / tick-count whole`) equals `rd`'s whole-note fraction, exactly (rational
/// equality). Traps on mismatch. Whole is the reference unit both layers share.
def rhythm-agree(d: Duration, rd: RDuration) =
  let as-fraction = Rational.of(tick-count(d), tick-count(whole)) in
  if as-fraction == whole-notes(rd) then
    unit
  else
    trap("rhythm tick-fraction and rational whole-note-fraction disagree")

/// ============================ @test suite (cross-layer time agreement) ============================
@test
def a-whole-note-agrees() = rhythm-agree(whole, r-whole)

@test
def a-half-note-agrees() = rhythm-agree(half, r-half)

@test
def a-quarter-note-agrees() = rhythm-agree(quarter, r-quarter)

@test
def an-eighth-note-agrees() = rhythm-agree(eighth, r-eighth)

@test
def a-sixteenth-note-agrees() = rhythm-agree(sixteenth, r-sixteenth)

@test
def the-whole-note-family-round-trips() =
  // Batch witness: every note value's Int64-tick fraction equals its rational whole-note fraction, so a
  // drift in either rhythm layer (a PPQ change, a rational redefinition) is caught across the family.
  let _w = rhythm-agree(whole, r-whole) in
  let _h = rhythm-agree(half, r-half) in
  let _q = rhythm-agree(quarter, r-quarter) in
  let _e = rhythm-agree(eighth, r-eighth) in
  rhythm-agree(sixteenth, r-sixteenth)

@test
def the-quarter-is-exactly-a-fourth-of-the-whole() =
  // Spot-pin the projection concretely: quarter = 960 ticks, whole = 3840, so 960/3840 = 1/4 = r-quarter's
  // whole-note fraction. Ties the PPQ grid to the rational model at a specific value.
  let frac = Rational.of(tick-count(quarter), tick-count(whole)) in
  if frac == Rational.of(1, 4) then
    if frac == whole-notes(r-quarter) then unit else trap("quarter fraction is r-quarter")
  else
    trap("quarter is a fourth of the whole")

export { rhythm-agree }
