/// interval-vector.cdz — the INTERVAL-CLASS VECTOR (ICV) of a pitch-class set (Allen Forte set theory).
///
/// For a set of pitch classes, the interval-class vector counts, over every UNORDERED PAIR, how many land
/// in each of the six interval classes (1..6). An interval class is the octave- AND inversion-folded
/// distance between two pitch classes: `ic(a,b) = let d = |a-b| mod 12 in min(d, 12-d)`, so ic ranges 1..6
/// (0 = same pitch class, not counted). The vector is `[ic1, ic2, ic3, ic4, ic5, ic6]`. It is the
/// canonical fingerprint of a set's INTERVALLIC CONTENT — the analysis primitive behind "these two chords
/// sound alike because they contain the same intervals" (Z-related sets share a vector), and it grounds
/// consonance/dissonance profiling (ic5 = fourths/fifths, ic6 = tritones, ic1 = semitones).
///
/// Pure pitch-class arithmetic over Int64, total. Input note numbers are folded to a canonical pitch-class
/// SET first — via the shared `pc-set` primitive (`pc-set.cdz`) — so a pitch class appearing in two octaves
/// is one set member and the vector counts SET pairs, matching the set-theoretic definition. The six counts
/// are returned as a dedicated `Icv` value (a single-constructor type holding the six counts positionally)
/// read through accessor helpers — `icv-count(v, k)` for interval class `k`, `ic-tritone(v)` for the common
/// ic6 — NOT a bare `List(Int64)` a caller would index by a magic position.
import { pc-of, pc-set } from "pc-set"

// ---- the interval-class vector -----------------------------------------------------------------------
/// The six interval-class counts of a pitch-class set: `ic1` (semitones/major sevenths) through `ic6`
/// (tritones), held positionally in a single-constructor type. Read the counts through `icv-count`/
/// `ic-tritone` rather than a raw `List(Int64)` index, so callers never hard-code a magic position.
type Icv =
  | Icv(Int64, Int64, Int64, Int64, Int64, Int64)

/// The INTERVAL CLASS of two pitch classes: the octave- and inversion-folded distance, in `1..6` (or 0
/// when the two pitch classes are equal). `ic(0,7) = ic(0,5) = 5` (a fifth and its inverted fourth share
/// an interval class); `ic(0,6) = 6` (the self-inverting tritone). Uses the shared `pc-of` fold.
def interval-class(a: Int64, b: Int64) =
  let d = pc-of(a - b) in
    if d < 12 - d then d else 12 - d

/// Add 1 to the count of `v` selected by interval class `ic` (1..6); ic 0 (same pitch class) is a no-op.
/// The interval class chooses which of the six positional counts to increment (rebuilding the Icv), never
/// a list index.
def bump(v: Icv, ic: Int64) =
  let Icv.Icv(c1, c2, c3, c4, c5, c6) = v in
    if ic == 1 then
    Icv.Icv(c1 + 1, c2, c3, c4, c5, c6)
  else if ic == 2 then
    Icv.Icv(c1, c2 + 1, c3, c4, c5, c6)
  else if ic == 3 then
    Icv.Icv(c1, c2, c3 + 1, c4, c5, c6)
  else if ic == 4 then
    Icv.Icv(c1, c2, c3, c4 + 1, c5, c6)
  else if ic == 5 then
    Icv.Icv(c1, c2, c3, c4, c5 + 1, c6)
  else if ic == 6 then
    Icv.Icv(c1, c2, c3, c4, c5, c6 + 1)
  else
    v

/// Count each interval class from `head` against every pitch class in `rest`, bumping `v`. Recursive over
/// `rest`; `head` is fixed for this pass. Annotated params.
def count-pairs-from(head: Int64, rest: List(Int64), v: Icv) = match rest with
  | [] => v
  | [h, .. t] => count-pairs-from(head, t, bump(v, interval-class(head, h)))

/// Walk the pitch-class SET, counting every UNORDERED pair exactly once: each element against all elements
/// AFTER it in the sorted set. Recursive driver threading the accumulating vector. Annotated params.
def icv-go(pcs: List(Int64), v: Icv) = match pcs with
  | [] => v
  | [h, .. t] => icv-go(t, count-pairs-from(h, t, v))

/// The INTERVAL-CLASS VECTOR of a note list: fold to a pitch-class set, then count every unordered pair's
/// interval class into the six positional counts. Octave- and inversion-invariant, order-independent.
def interval-class-vector(notes: List(Int64)) = icv-go(pc-set(notes), Icv.Icv(0, 0, 0, 0, 0, 0))

// ---- count accessors ---------------------------------------------------------------------------------
/// The count of interval class `k` (1..6) in a vector — the accessor a caller uses instead of destructuring
/// the Icv or reaching into a raw list. A `k` of 0 (the unison — not an interval class) or otherwise out of
/// `1..6` traps: a caller should ask only for `k` in `1..6`, since there is no interval class outside it.
def icv-count(v: Icv, k: Int64) =
  let Icv.Icv(c1, c2, c3, c4, c5, c6) = v in
    if k == 1 then
    c1
  else if k == 2 then
    c2
  else if k == 3 then
    c3
  else if k == 4 then
    c4
  else if k == 5 then
    c5
  else if k == 6 then
    c6
  else
    trap("icv-count: interval class k must be 1..6 (0 is the unison, not an interval class)")

/// The tritone count (interval class 6) — the classic tension marker a harmony tool reads directly.
def ic-tritone(v: Icv) = icv-count(v, 6)

/// The total number of interval classes counted = the number of unordered pairs in the set = n*(n-1)/2.
def icv-total(v: Icv) =
  let Icv.Icv(c1, c2, c3, c4, c5, c6) = v in
    c1 + c2 + c3 + c4 + c5 + c6

/// ============================ @test suite (interval-class vector) ============================
@test
def the-major-triad-vector-has-one-each-of-ic-three-four-five() =
  // C major {0,4,7}: pairs (0,4)=ic4, (0,7)=ic5, (4,7)=ic3 → one each of ic3, ic4, ic5 → [0,0,1,1,1,0].
  // The textbook major/minor triad interval-class vector.
  let v = interval-class-vector([60, 64, 67]) in
    if icv-count(v, 1) == 0 then
    if icv-count(v, 2) == 0 then
      if icv-count(v, 3) == 1 then
        if icv-count(v, 4) == 1 then
          if icv-count(v, 5) == 1 then
            if icv-count(v, 6) == 0 then unit else trap("ic6")
          else
            trap("ic5")
        else
          trap("ic4")
      else
        trap("ic3")
    else
      trap("ic2")
  else
    trap("ic1")

@test
def a-minor-triad-shares-the-major-triad-vector() =
  // Any consonant triad (major OR minor) has vector [0,0,1,1,1,0] — same intervallic content, different
  // ordering. A minor {0,3,7}: (0,3)=ic3, (0,7)=ic5, (3,7)=ic4. Same multiset as the major triad.
  let maj = interval-class-vector([60, 64, 67]) in
  let min = interval-class-vector([60, 63, 67]) in
    if icv-count(min, 3) == 1 then
    if icv-count(min, 4) == 1 then
      if icv-count(min, 5) == 1 then
        if icv-total(maj) == icv-total(min) then unit else trap("same pair count")
      else
        trap("min ic5")
    else
      trap("min ic4")
  else
    trap("min ic3")

@test
def the-vector-is-octave-and-inversion-invariant() =
  // Spreading C major across octaves ([C, E', G''] = [60, 76, 91]) and re-voicing does not change the
  // vector — it is a property of the pitch-class SET, not the voicing.
  let close = interval-class-vector([60, 64, 67]) in
  let spread = interval-class-vector([60, 76, 91]) in
    if icv-count(close, 3) == icv-count(spread, 3) then
    if icv-count(close, 4) == icv-count(spread, 4) then
      if icv-count(close, 5) == icv-count(spread, 5) then unit else trap("ic5 invariant")
    else
      trap("ic4 invariant")
  else
    trap("ic3 invariant")

@test
def duplicate-pitch-classes-collapse-to-one-set-member() =
  // Doubling a pitch class in another octave (C in two octaves) does NOT add pairs — the set dedupes, so
  // [60, 64, 67, 72] (72 = C an octave up) has the SAME vector and pair total (3) as the bare triad.
  let bare = interval-class-vector([60, 64, 67]) in
  let doubled = interval-class-vector([60, 64, 67, 72]) in
    if icv-total(bare) == 3 then
    if icv-total(doubled) == 3 then
      if icv-count(bare, 4) == icv-count(doubled, 4) then
        unit
      else
        trap("same vector after doubling")
    else
      trap("doubled still three pairs")
  else
    trap("bare has three pairs")

@test
def the-diminished-seventh-is-all-tritones-and-minor-thirds() =
  // The fully-symmetric dim7 {0,3,6,9}: its six pairs are ic3 (0-3,3-6,6-9,9-0=ic3) four times and ic6
  // (0-6, 3-9) twice → vector [0,0,4,0,0,2]. A sharp test of tritone counting + the symmetric wrap
  // (9 to 0 is ic3, not ic9). icv-total = 6 = 4*3/2.
  let v = interval-class-vector([60, 63, 66, 69]) in
    if icv-count(v, 3) == 4 then
    if ic-tritone(v) == 2 then
      if icv-count(v, 1) == 0 then
        if icv-total(v) == 6 then unit else trap("four notes → six pairs")
      else
        trap("no semitones in dim7")
    else
      trap("two tritones in dim7")
  else
    trap("four minor thirds in dim7")

@test
def the-whole-tone-scale-has-the-maximal-tritone-count() =
  // The whole-tone set {0,2,4,6,8,10}: all six pairs of even pitch classes. It is famous for containing
  // NO semitones (ic1=0), NO fourths/fifths (ic5=0), and the MAXIMUM tritones for a six-note set (ic6=3).
  // Vector [0,6,0,6,0,3]. A strong structural fingerprint test.
  let v = interval-class-vector([60, 62, 64, 66, 68, 70]) in
    if icv-count(v, 1) == 0 then
    if icv-count(v, 5) == 0 then
      if ic-tritone(v) == 3 then
        if icv-count(v, 2) == 6 then
          if icv-count(v, 4) == 6 then
            if icv-total(v) == 15 then unit else trap("six notes → fifteen pairs")
          else
            trap("ic4 is six")
        else
          trap("ic2 is six")
      else
        trap("three tritones")
    else
      trap("no fifths")
  else
    trap("no semitones")

@test
def a-single-note-and-the-empty-set-have-the-zero-vector() =
  // Fewer than two members → no pairs → the zero vector (total 0). The base case of the pair walk.
  let one = interval-class-vector([60]) in
  let none = interval-class-vector([]) in
    if icv-total(one) == 0 then
    if icv-total(none) == 0 then
      if ic-tritone(one) == 0 then unit else trap("a lone note has no tritone")
    else
      trap("empty set is zero")
  else
    trap("single note is zero")

@test
def the-chromatic-aggregate-has-the-maximal-symmetric-vector() =
  // The full 12-tone aggregate {0..11}: every interval class appears the maximum number of times. Its
  // deep-symmetry vector is [12,12,12,12,12,6] — ic1..5 twelve each, the self-inverting tritone six —
  // totalling 66 = 12*11/2 pairs. The canonical maximal fingerprint; a strong whole-vector correctness
  // check (any off-by-one in the fold or the pair walk shifts these counts).
  let v = interval-class-vector([60, 61, 62, 63, 64, 65, 66, 67, 68, 69, 70, 71]) in
    if icv-count(v, 1) == 12 then
    if icv-count(v, 2) == 12 then
      if icv-count(v, 3) == 12 then
        if icv-count(v, 4) == 12 then
          if icv-count(v, 5) == 12 then
            if ic-tritone(v) == 6 then
              if icv-total(v) == 66 then unit else trap("66 pairs")
            else
              trap("six tritones")
          else
            trap("ic5 is twelve")
        else
          trap("ic4 is twelve")
      else
        trap("ic3 is twelve")
    else
      trap("ic2 is twelve")
  else
    trap("ic1 is twelve")

@test
def the-vector-is-independent-of-input-note-order() =
  // The vector counts UNORDERED pairs of a SET, so the order the notes are supplied in must not matter:
  // [67,60,64] and [60,64,67] produce the same vector.
  let scrambled = interval-class-vector([67, 60, 64]) in
  let sorted = interval-class-vector([60, 64, 67]) in
    if icv-count(scrambled, 3) == icv-count(sorted, 3) then
    if icv-count(scrambled, 4) == icv-count(sorted, 4) then
      if icv-count(scrambled, 5) == icv-count(sorted, 5) then unit else trap("ic5 order-invariant")
    else
      trap("ic4 order-invariant")
  else
    trap("ic3 order-invariant")

@test
def interval-class-folds-past-the-tritone() =
  // The fold is inversion-symmetric: ic(0,7)=5 (a fifth folds to its inverted fourth's class), ic(0,6)=6
  // (the tritone is its own inversion), ic(0,11)=1 (a major seventh folds to a semitone), and ic of two
  // equal pitch classes is 0 (not counted).
  if interval-class(0, 7) == 5 then
    if interval-class(0, 6) == 6 then
      if interval-class(0, 11) == 1 then
        if interval-class(5, 5) == 0 then unit else trap("equal pcs are ic0")
      else
        trap("major seventh folds to ic1")
    else
      trap("tritone is ic6")
  else
    trap("fifth folds to ic5")

export { Icv.*, interval-class, interval-class-vector, icv-count, ic-tritone, icv-total }
