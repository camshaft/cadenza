/// pitch.cdz — Phase-1 PRIMITIVE #1: pitch, pitch-class, octave, and intervals.
///
/// The whole music library is grounded on the 12-tone equal-tempered chromatic scale, indexed the way
/// MIDI does: an integer note number where 60 = middle C (C4) and +1 = one semitone up. That single
/// integer is the atom every later primitive (scales, chords, rhythm-placed events) is built from, so we
/// pin its arithmetic HERE with a witnessing @test for every law.
///
/// Design reference (studied, not depended on): camshaft/euphony-rs models pitch as an interval offset
/// from a tonic; we take the concrete-MIDI-integer view because it grounds cleanly in the browser MIDI
/// drivers (phase 2) and in `cdz-run` value tests. A `Pitch` is a newtype over the note number and an
/// `Interval` a newtype over a signed semitone count — the euphony newtype discipline, written fresh in
/// Cadenza. Both are total over all of Int64 (notes below 0 / above 127 are representable; the MIDI
/// drivers clamp at their boundary, the theory layer does not).
/// Floored modulus into `0 .. m-1`. Int64 `%` is SIGN-FOLLOWING (a negative dividend yields a negative
/// remainder), but a pitch class must be a canonical `0..11` regardless of how low the note sits, so we
/// fold a negative remainder up by one modulus. (Same idiom as compiler-ml's leb128 `mod-floor`.)
def mod-floor(n: Int64, m: Int64) =
  let r = n % m in
  if r < 0 then r + m else r

/// Floored division to match `mod-floor`: `q` such that `n == q*m + mod-floor(n, m)`. Rounds toward
/// negative infinity, so the octave of a sub-zero note stays consistent with its pitch class.
def div-floor(n: Int64, m: Int64) =
  let q = n / m in
  let r = n % m in
  if r < 0 then q - 1 else q

// ---- Pitch: a concrete note on the MIDI chromatic grid (60 = middle C) ------------------------------
/// A pitch is one note number on the 12-TET grid. 60 = middle C (C4); each +1 is a semitone up.
type Pitch =
  | Pitch(Int64)

/// Build a pitch from a raw MIDI note number.
def pitch(n: Int64) = Pitch.Pitch(n)

/// The raw MIDI note number of a pitch.
def note(p: Pitch) =
  let Pitch.Pitch(n) = p in
  n

/// The PITCH CLASS `0..11` (C=0, C#=1, … B=11): the note folded into a single octave, floored so it is
/// canonical even for notes below C-1.
def pitch-class(p: Pitch) = mod-floor(note(p), 12)

/// The OCTAVE in MIDI numbering: note 60 (middle C) is octave 4, so octave = floor(note/12) - 1.
def octave(p: Pitch) = div-floor(note(p), 12) - 1

/// Rebuild a pitch from an octave + pitch class — the inverse of `octave` / `pitch-class`.
def pitch-of(oct: Int64, pc: Int64) = Pitch.Pitch((oct + 1) * 12 + pc)

/// Two pitches are ENHARMONICALLY/exactly equal iff they name the same note number.
def pitch-eq(a: Pitch, b: Pitch) = note(a) == note(b)

/// Same PITCH CLASS (equal up to octave) — C4 and C5 are pitch-class-equal but not pitch-equal.
def same-pitch-class(a: Pitch, b: Pitch) = pitch-class(a) == pitch-class(b)

// ---- Interval: a signed semitone distance ------------------------------------------------------------
/// An interval is a signed number of semitones. Positive = ascending, negative = descending, 0 = unison.
type Interval =
  | Interval(Int64)

/// Build an interval from a semitone count.
def interval(semis: Int64) = Interval.Interval(semis)

/// The semitone count of an interval.
def semitones(i: Interval) =
  let Interval.Interval(s) = i in
  s

/// The interval FROM `a` TO `b` (`b - a` semitones): positive if `b` is higher.
def interval-between(a: Pitch, b: Pitch) = Interval.Interval(note(b) - note(a))

/// TRANSPOSE a pitch UP by an interval (down if the interval is negative).
def transpose(p: Pitch, i: Interval) = Pitch.Pitch(note(p) + semitones(i))

/// INVERT a pitch around an axis pitch: reflect it so it is as far below the axis as it was above (and
/// vice versa). `invert(axis, axis) == axis`; used for melodic/harmonic inversion.
def invert(axis: Pitch, p: Pitch) = Pitch.Pitch(2 * note(axis) - note(p))

/// The interval class `0..6`: an interval folded into a single octave AND folded so a tritone is its own
/// inverse (a fifth and a fourth share interval-class 5). This is what harmonic equivalence uses.
def interval-class(i: Interval) =
  let m = mod-floor(semitones(i), 12) in
  if m > 6 then 12 - m else m

// ---- named interval constants (the common ones, ascending from unison) ------------------------------
def unison = Interval.Interval(0)

def minor-second = Interval.Interval(1)

def major-second = Interval.Interval(2)

def minor-third = Interval.Interval(3)

def major-third = Interval.Interval(4)

def perfect-fourth = Interval.Interval(5)

def tritone = Interval.Interval(6)

def perfect-fifth = Interval.Interval(7)

def minor-sixth = Interval.Interval(8)

def major-sixth = Interval.Interval(9)

def minor-seventh = Interval.Interval(10)

def major-seventh = Interval.Interval(11)

def octave-interval = Interval.Interval(12)

/// ============================ @test suite (pitch/interval laws) ============================
@test
def middle-c-is-note-sixty() =
  // The grounding convention: middle C is MIDI 60, pitch class 0, octave 4.
  let c4 = pitch(60) in
  if pitch-class(c4) == 0 then
    if octave(c4) == 4 then unit else trap("middle C octave")
  else
    trap("middle C pitch class")

@test
def pitch-class-folds-into-one-octave() =
  // Every octave of C is pitch class 0; a note one above C is pitch class 1.
  if pitch-class(pitch(0)) == 0 then
    if pitch-class(pitch(72)) == 0 then
      if pitch-class(pitch(61)) == 1 then unit else trap("C#")
    else
      trap("C5")
  else
    trap("C-1")

@test
def pitch-class-is-canonical-for-negative-notes() =
  // A note below zero still folds to a canonical 0..11 (floored mod, not sign-following).
  if pitch-class(pitch(-1)) == 11 then
    if pitch-class(pitch(-12)) == 0 then
      if octave(pitch(-1)) == -2 then unit else trap("octave of -1")
    else
      trap("-12 pitch class")
  else
    trap("-1 pitch class")

@test
def octave-and-pitch-class-round-trip() =
  // pitch-of inverts octave/pitch-class for a spread of notes.
  let p = pitch(75) in
  let q = pitch-of(octave(p), pitch-class(p)) in
  if pitch-eq(p, q) then
    if pitch-eq(pitch-of(4, 0), pitch(60)) then unit else trap("C4 rebuild")
  else
    trap("round trip")

@test
def transpose-up-a-fifth-then-down-is-identity() =
  // Transposing up then down by the same interval returns the original pitch.
  let c4 = pitch(60) in
  let g4 = transpose(c4, perfect-fifth) in
  if note(g4) == 67 then
    if pitch-eq(transpose(g4, interval(0 - 7)), c4) then unit else trap("round trip")
  else
    trap("fifth above C4 is G4")

@test
def interval-between-is-signed-difference() =
  // The interval from C4 up to G4 is +7; from G4 down to C4 is -7.
  let c4 = pitch(60) in
  let g4 = pitch(67) in
  if semitones(interval-between(c4, g4)) == 7 then
    if semitones(interval-between(g4, c4)) == 0 - 7 then unit else trap("descending")
  else
    trap("ascending")

@test
def inversion-reflects-around-the-axis() =
  // Inverting E4 (64) around C4 (60) gives Ab3 (56): as far below C4 as E4 was above.
  let c4 = pitch(60) in
  let e4 = pitch(64) in
  if note(invert(c4, e4)) == 56 then
    if pitch-eq(invert(c4, c4), c4) then unit else trap("axis fixed")
  else
    trap("reflection")

@test
def interval-class-folds-fifths-and-fourths-together() =
  // A perfect fifth (7) and a perfect fourth (5) are complementary — both interval-class 5.
  if interval-class(perfect-fifth) == 5 then
    if interval-class(perfect-fourth) == 5 then
      if interval-class(octave-interval) == 0 then
        if interval-class(tritone) == 6 then unit else trap("tritone")
      else
        trap("octave")
    else
      trap("fourth")
  else
    trap("fifth")

@test
def same-pitch-class-across-octaves() =
  // C4 and C5 share a pitch class but are not the same pitch.
  let c4 = pitch(60) in
  let c5 = pitch(72) in
  if same-pitch-class(c4, c5) then
    if pitch-eq(c4, c5) then trap("should differ") else unit
  else
    trap("same class")

export {
  Pitch.*,
  Interval.*,
  mod-floor,
  div-floor,
  pitch,
  note,
  pitch-class,
  octave,
  pitch-of,
  pitch-eq,
  same-pitch-class,
  interval,
  semitones,
  interval-between,
  transpose,
  invert,
  interval-class,
  unison,
  minor-second,
  major-second,
  minor-third,
  major-third,
  perfect-fourth,
  tritone,
  perfect-fifth,
  minor-sixth,
  major-sixth,
  minor-seventh,
  major-seventh,
  octave-interval
}
