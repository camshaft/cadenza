/// interval-ratio.cdz — the RATIONAL interval representation (operator directive 2026-07-19, via
/// concierge): "use rational numbers everywhere; an interval is an OCTAVE, and each step is a FRACTION of
/// it — chromatic note = 1/12, heptatonic step = 1/7 — so the representation is MODE-INDEPENDENT and the
/// relationships are preserved across modes." This is euphony's model (euphony-units/src/pitch/interval.rs:
/// `Interval` is a ratio, UNISON = 0/1, OCTAVE = 1/1), written fresh in Cadenza on the builtin `Rational`.
///
/// WHY RATIONAL (the operator's point): a step is a fraction of the octave, so it means the same thing in
/// EVERY mode — a heptatonic "second" is 1/7 of an octave whether you're in Ionian or Dorian; a chromatic
/// semitone is always 1/12. Nothing is tied to a fixed integer semitone grid, and it dovetails with
/// Cadenza's rational-by-default numerics. This is the CORE music-theory representation; the concrete
/// 12-TET MIDI note number is only a PROJECTION at the driver boundary (schedule.cdz / a WebMIDI driver),
/// exactly as euphony keeps `frequency.rs` separate from `interval.rs`.
///
/// An `RInterval` is a `Rational` count of OCTAVES: 0 = unison, 1 = one octave up, 1/12 = a chromatic
/// semitone, 7/12 = a perfect fifth (7 semitones), 1/7 = a heptatonic scale step. Positive = ascending,
/// negative = descending. All arithmetic is exact rational arithmetic (no float, no rounding until the
/// MIDI projection).
/// A rational interval: a `Rational` number of octaves above (or below, if negative) a reference pitch.
type RInterval =
  | RInterval(Rational)

/// Build a rational interval from a `Rational` number of octaves.
def rinterval(octaves: Rational) = RInterval.RInterval(octaves)

/// The octave-fraction of a rational interval (a `Rational`).
def octaves(i: RInterval) =
  let RInterval.RInterval(r) = i in
    r

// ---- constructing intervals as fractions of the octave ----------------------------------------------
/// The `n`-th step of an `m`-EDO (equal division of the octave) system, as a fraction of the octave:
/// `n/m` octaves. Chromatic step = `edo-step(1, 12)`; heptatonic degree = `edo-step(n, 7)`. This is THE
/// mode-independent primitive — a degree means the same fraction of the octave in every mode.
def edo-step(n: Int64, m: Int64) = RInterval.RInterval(Rational.of(n, m))

/// A chromatic interval of `semis` twelfths of an octave (the 12-TET view): `semis/12` octaves.
def semitones-r(semis: Int64) = RInterval.RInterval(Rational.of(semis, 12))

/// A heptatonic (diatonic) scale degree `n` (0 = tonic … 6 = seventh) as `n/7` of an octave.
def degree-r(n: Int64) = RInterval.RInterval(Rational.of(n, 7))

// ---- named intervals (fractions of the octave) ------------------------------------------------------
def r-unison = RInterval.RInterval(Rational.of(0, 1))

def r-octave = RInterval.RInterval(Rational.of(1, 1))

def r-double-octave = RInterval.RInterval(Rational.of(2, 1))

/// The 12-TET named intervals as twelfths of an octave.
def r-semitone = RInterval.RInterval(Rational.of(1, 12))

def r-wholetone = RInterval.RInterval(Rational.of(2, 12))

def r-minor-third = RInterval.RInterval(Rational.of(3, 12))

def r-major-third = RInterval.RInterval(Rational.of(4, 12))

def r-perfect-fourth = RInterval.RInterval(Rational.of(5, 12))

def r-tritone = RInterval.RInterval(Rational.of(6, 12))

def r-perfect-fifth = RInterval.RInterval(Rational.of(7, 12))

def r-minor-sixth = RInterval.RInterval(Rational.of(8, 12))

def r-major-sixth = RInterval.RInterval(Rational.of(9, 12))

def r-minor-seventh = RInterval.RInterval(Rational.of(10, 12))

def r-major-seventh = RInterval.RInterval(Rational.of(11, 12))

// ---- rational interval arithmetic (exact; no rounding) ----------------------------------------------
/// STACK two intervals (add the octave-fractions): a fifth + a fourth = an octave.
def r-add(a: RInterval, b: RInterval) = RInterval.RInterval(octaves(a) + octaves(b))

/// The interval FROM `a` TO `b` (subtract octave-fractions).
def r-sub(a: RInterval, b: RInterval) = RInterval.RInterval(octaves(b) - octaves(a))

/// NEGATE an interval (turn an ascending interval into the descending one).
def r-negate(i: RInterval) = RInterval.RInterval(Rational.of(0, 1) - octaves(i))

/// Are two intervals exactly equal (as reduced rationals)? `Rational` `==` compares reduced, so 2/4 == 1/2.
def r-eq(a: RInterval, b: RInterval) = octaves(a) == octaves(b)

/// The OCTAVE COMPLEMENT of an interval within one octave: `1 - i` octaves. This is interval INVERSION
/// expressed rationally — a fifth (7/12) complements to a fourth (5/12), a major third (4/12) to a minor
/// sixth (8/12) — and by construction `i + complement(i) = 1 octave` exactly, for ANY rational interval
/// (mode-independent). The tritone (6/12) is its own complement.
def r-complement(i: RInterval) = RInterval.RInterval(Rational.of(1, 1) - octaves(i))

// ---- the MIDI PROJECTION (rational octave-fraction -> 12-TET semitone count) -------------------------
//
// The rational theory core projects to the integer MIDI wire here. The Rational→Int64 conversion this
// needed was a LANGUAGE GAP early in this vertical (the prelude had only `Rational.of`/`of-int`/`value`,
// no floor/round/etc); it was FILED, and the prelude now provides the full checked-narrow surface
// (`Rational.truncate`/`floor`/`ceil`/`round : Rational → Int64`, trap-on-overflow — landed 2026-07-21).
// So the projection IS now expressible in pure Cadenza, in two forms:
//   - `to-semitones-exact` — the EXACT on-grid read (a 12-TET interval is `s/12`, recovered by equality
//     `r-eq(i, semitones-r(s))`); returns `Option` (`None` off-grid). Use when you want a total-only-on-grid
//     answer with no rounding.
//   - `to-semitones` (+ `-floor`/`-ceil`/`-round`) — the GENERAL projection: `round(octaves × 12)` to a
//     whole semitone, defined for ANY interval (incl. off-grid microtonal/just-intonation, which it snaps).
//     On the 12-TET grid all forms agree with `to-semitones-exact`'s `Some k`.
// The theory core stays PURELY rational (the operator's point — rationals everywhere in the model); these
// projections are the honest boundary where an exact rational meets the integer MIDI wire.
/// The exact 12-TET semitone count of an interval that lies ON the 12-TET grid, searched in `lo..hi`
/// (inclusive). Returns `Option`: `Some(s)` if `i == s/12` for some `s` in range, else `None` (a non-12-TET
/// or out-of-range interval — those need the (missing) rounding conversion). Recursive, annotated.
def to-semitones-in-range(i: RInterval, lo: Int64, hi: Int64) =
  if lo > hi then
    Option.None(unit)
  else if r-eq(i, semitones-r(lo)) then
    Option.Some(lo)
  else
    to-semitones-in-range(i, lo + 1, hi)

/// The exact 12-TET semitone count of an in-grid interval within +/- two octaves (the useful MIDI range for
/// a single interval), or `None` if it is not exactly a twelfth-of-octave in that range.
def to-semitones-exact(i: RInterval) = to-semitones-in-range(i, 0 - 24, 24)

/// The GENERAL rational→MIDI-semitone projection (unblocked 2026-07-21 by the prelude's `Rational.truncate
/// : Rational → Int64`, checked-narrow/trap-on-overflow). An `RInterval` is an octave-fraction; its semitone
/// value is `octaves × 12`, and this TRUNCATES that toward zero to a whole semitone — the total,
/// always-defined projection any interval (even a microtonal/just-intonation one off the 12-TET grid) needs
/// to reach the integer MIDI wire. For an interval EXACTLY on the 12-TET grid (`k/12` of an octave) the
/// product `k/12 × 12 = k` is a whole number, so `to-semitones` == `to-semitones-exact`'s `Some k` — the two
/// agree on the grid (pinned in @tests). They can only differ OFF the grid, where `to-semitones-exact`
/// declines (`None`) but `to-semitones` still snaps to a semitone. NB: truncate is TOWARD ZERO, so a
/// descending off-grid interval rounds up toward 0 (a `floor`/`round` variant awaits the later prelude
/// increments; toward-zero is the honest name for what's available now).
def to-semitones(i: RInterval) = Rational.truncate(octaves(i) * Rational.of-int(12))

/// The FLOOR projection: `octaves × 12` rounded DOWN (toward -infinity) to a whole semitone (prelude's
/// `Rational.floor`, landed 2026-07-21). This is the projection a downward-consistent snap wants: unlike
/// `to-semitones` (truncate = toward-zero, which rounds a descending off-grid interval UP toward 0), floor
/// always rounds down, so successive off-grid intervals map monotonically. On the 12-TET grid floor ==
/// truncate == the exact value (no fractional part), so all three agree there.
def to-semitones-floor(i: RInterval) = Rational.floor(octaves(i) * Rational.of-int(12))

/// The CEIL projection: `octaves × 12` rounded UP (toward +infinity) to a whole semitone (prelude's
/// `Rational.ceil`). The upward complement of `to-semitones-floor`; on the grid it too equals the exact
/// value. `floor(x) <= truncate(x)/exact <= ceil(x)`, with equality for any on-grid (integer) x.
def to-semitones-ceil(i: RInterval) = Rational.ceil(octaves(i) * Rational.of-int(12))

/// The ROUND projection: `octaves × 12` rounded to the NEAREST whole semitone, ties half-AWAY-from-zero
/// (prelude's `Rational.round`, landed 2026-07-21 — the operator-ruled MIDI-snap tie-break). This is the
/// RECOMMENDED default for snapping an arbitrary rational interval (a microtonal/just-intonation pitch) to
/// the closest 12-TET semitone: 7.4→7, 7.5→8, -7.5→-8. On the 12-TET grid it equals the exact value like
/// the others. Prefer this over truncate/floor/ceil when you want nearest-semitone (the usual "quantize to
/// MIDI" intent); use the directed variants when you specifically want toward-zero / down / up.
def to-semitones-round(i: RInterval) = Rational.round(octaves(i) * Rational.of-int(12))

/// ============================ @test suite (rational intervals) ============================
@test
def a-fifth-is-seven-twelfths-of-an-octave() =
  // The perfect fifth is 7/12 of an octave, and projects to 7 semitones.
  if r-eq(r-perfect-fifth, semitones-r(7)) then
    match to-semitones-exact(r-perfect-fifth) with
      | Option.Some(s) => if s == 7 then unit else trap("projects to 7 semitones")
      | Option.None(_) => trap("fifth is in-grid")
  else
    trap("fifth is 7/12")

@test
def a-fifth-plus-a-fourth-is-an-octave() =
  // Stacking a perfect fifth (7/12) and a perfect fourth (5/12) gives exactly one octave (1/1).
  if r-eq(r-add(r-perfect-fifth, r-perfect-fourth), r-octave) then
    unit
  else
    trap("fifth + fourth = octave")

@test
def complement-inverts-an-interval-within-the-octave() =
  // Interval inversion, rationally: a fifth complements to a fourth, a major third to a minor sixth, and
  // i + complement(i) = an octave for any interval. The tritone is its own complement.
  if r-eq(r-complement(r-perfect-fifth), r-perfect-fourth) then
    if r-eq(r-complement(r-major-third), semitones-r(8)) then
      if r-eq(r-add(r-major-third, r-complement(r-major-third)), r-octave) then
        if r-eq(r-complement(r-tritone), r-tritone) then
          unit
        else
          trap("tritone is self-complement")
      else
        trap("i + complement = octave")
    else
      trap("major third complements to minor sixth 8/12")
  else
    trap("fifth complements to fourth")

@test
def a-chromatic-step-is-one-twelfth-mode-independent() =
  // A chromatic semitone is 1/12 of an octave — the mode-independent atom.
  if r-eq(r-semitone, edo-step(1, 12)) then
    if r-eq(r-wholetone, edo-step(2, 12)) then unit else trap("wholetone is 2/12")
  else
    trap("semitone is 1/12")

@test
def a-heptatonic-step-is-one-seventh() =
  // A heptatonic scale step is 1/7 of an octave (the operator's example) — the same fraction in every mode.
  if r-eq(degree-r(1), edo-step(1, 7)) then
    if r-eq(degree-r(7), r-octave) then unit else trap("seventh degree wraps to the octave")
  else
    trap("degree 1 is 1/7")

@test
def twelve-semitones-make-an-octave() =
  // Twelve chromatic steps sum to exactly one octave (exact rational, no drift).
  let twelve = r-add(semitones-r(6), semitones-r(6)) in
    if r-eq(twelve, r-octave) then
    match to-semitones-exact(r-octave) with
      | Option.Some(s) => if s == 12 then unit else trap("octave projects to 12 semitones")
      | Option.None(_) => trap("octave is in-grid")
  else
    trap("12 semitones = octave")

@test
def negate-turns-ascending-into-descending() =
  // Negating a fifth gives -7/12; from-to is the signed difference.
  if r-eq(r-negate(r-perfect-fifth), rinterval(Rational.of(0, 1) - Rational.of(7, 12))) then
    match to-semitones-exact(r-negate(r-perfect-fifth)) with
      | Option.Some(s) => if s == 0 - 7 then unit else trap("projects to -7")
      | Option.None(_) => trap("negated fifth is in-grid")
  else
    trap("negate")

@test
def seven-sevenths-is-an-octave-across-any-mode() =
  // The operator's mode-independence: seven heptatonic steps of 1/7 sum to the octave, exactly, with no
  // reference to which mode — the relationship holds relative to the octave regardless of mode.
  let two = r-add(degree-r(1), degree-r(1)) in
  let four = r-add(two, two) in
  let six = r-add(four, two) in
  let seven = r-add(six, degree-r(1)) in
    if r-eq(seven, r-octave) then unit else trap("7 * (1/7) = 1 octave")

@test
def in-grid-projects-exactly-off-grid-declines() =
  // 2/3 of an octave IS on the 12-TET grid (8/12), so it projects exactly to 8. But 5/8 of an octave is
  // NOT a twelfth (7.5 semitones) — with no Rational->Int rounding available, the exact projection
  // declines with None (pins the language-gap boundary; a rounding form waits on the conversion op).
  match to-semitones-exact(rinterval(Rational.of(2, 3))) with
    | Option.Some(s) => if s == 8 then
      match to-semitones-exact(rinterval(Rational.of(5, 8))) with
        | Option.None(_) => unit
        | Option.Some(_) => trap("5/8 octave is off-grid, should decline")
    else
      trap("2/3 octave = 8 semitones")
    | Option.None(_) => trap("2/3 octave is on-grid (8/12)")

@test
def minor-sixth-and-minor-seventh-close-the-grid() =
  // Semitones 8 (minor sixth) and 10 (minor seventh) were the two 12-TET grid points with no rational
  // counterpart, so the layer-bridge gate silently skipped them. Pin both: each rational named interval
  // equals its `semitones-r` projection AND projects back to the exact integer semitone count, closing the
  // 12-TET grid to the true full twelve (reviewer coverage gap on 44bdb682e).
  if r-eq(r-minor-sixth, semitones-r(8)) then
    match to-semitones-exact(r-minor-sixth) with
      | Option.Some(s) => if s == 8 then
        if r-eq(r-minor-seventh, semitones-r(10)) then
          match to-semitones-exact(r-minor-seventh) with
            | Option.Some(t) => if t == 10 then unit else trap("minor seventh projects to 10")
            | Option.None(_) => trap("minor seventh is in-grid")
        else
          trap("minor seventh is 10/12")
      else
        trap("minor sixth projects to 8")
      | Option.None(_) => trap("minor sixth is in-grid")
  else
    trap("minor sixth is 8/12")

@test
def minor-sixth-complements-a-major-third() =
  // The new named intervals participate in rational arithmetic: a minor sixth (8/12) is the octave
  // complement of a major third (4/12), and a minor seventh (10/12) complements a wholetone (2/12). Also
  // a minor third (3/12) stacked on a minor sixth (8/12) is a major seventh (11/12) — exact, no drift.
  if r-eq(r-complement(r-major-third), r-minor-sixth) then
    if r-eq(r-complement(r-wholetone), r-minor-seventh) then
      if r-eq(r-add(r-minor-third, r-minor-sixth), r-major-seventh) then
        unit
      else
        trap("minor third + minor sixth = major seventh")
    else
      trap("wholetone complements to minor seventh")
  else
    trap("major third complements to minor sixth")

@test
def to-semitones-projects-the-twelve-tet-grid-exactly() =
  // The general projection agrees with the exact on-grid one for every 12-TET interval: k/12 → k.
  if to-semitones(semitones-r(7)) == 7 then
    if to-semitones(r-octave) == 12 then
      if to-semitones(r-unison) == 0 then
        if to-semitones(r-minor-third) == 3 then unit else trap("minor third → 3")
      else
        trap("unison → 0")
    else
      trap("octave → 12")
  else
    trap("fifth → 7")

@test
def to-semitones-agrees-with-to-semitones-exact-on-grid() =
  // Where to-semitones-exact returns Some(k), to-semitones returns the same k — the general projection is a
  // superset of the exact one on the grid (they can only diverge OFF the grid, where -exact declines).
  match to-semitones-exact(r-perfect-fifth) with
    | Option.Some(s) => if to-semitones(r-perfect-fifth) == s then
      unit
    else
      trap("fifth: general == exact")
    | Option.None(_) => trap("fifth is on-grid")

@test
def to-semitones-projects-a-negative-interval() =
  // A descending fifth is -7/12 of an octave → -7 semitones (exact on-grid, so truncate is unambiguous).
  if to-semitones(r-negate(r-perfect-fifth)) == 0 - 7 then unit else trap("descending fifth → -7")

@test
def to-semitones-snaps-an-off-grid-interval-toward-zero() =
  // OFF the 12-TET grid (where to-semitones-exact declines), to-semitones still snaps: a quarter-tone above
  // a fifth (7/12 + 1/24 = 15/24 of an octave) is 7.5 semitones → truncate toward zero = 7. This is the
  // capability the projection adds over to-semitones-exact (which returns None here).
  let quarter-sharp-fifth = rinterval(Rational.of(15, 24)) in
    match to-semitones-exact(quarter-sharp-fifth) with
    | Option.None(_) => if to-semitones(quarter-sharp-fifth) == 7 then
      unit
    else
      trap("7.5 semitones truncates to 7")
    | Option.Some(_) => trap("a quarter-sharp fifth is OFF the 12-TET grid")

@test
def floor-and-ceil-agree-with-truncate-on-the-grid() =
  // On the 12-TET grid every projection agrees (the value is a whole semitone, no fractional part): a
  // fifth → 7 by floor, ceil, AND truncate; the octave → 12 all three ways.
  if to-semitones-floor(r-perfect-fifth) == 7 then
    if to-semitones-ceil(r-perfect-fifth) == 7 then
      if to-semitones(r-perfect-fifth) == 7 then
        if to-semitones-floor(r-octave) == 12 then unit else trap("octave floor")
      else
        trap("fifth truncate")
    else
      trap("fifth ceil")
  else
    trap("fifth floor")

@test
def floor-rounds-down-where-truncate-rounds-toward-zero() =
  // The point of the floor variant: a DESCENDING off-grid interval. -15/24 octave = -7.5 semitones.
  // truncate (toward zero) → -7; floor (toward -inf) → -8; ceil (toward +inf) → -7. So floor gives the
  // monotone downward snap truncate can't (truncate and floor DIFFER here — the reason floor was worth
  // adding once the prelude op landed).
  let desc-quarter-sharp-fifth = rinterval(Rational.of(0 - 15, 24)) in
    if to-semitones(desc-quarter-sharp-fifth) == 0 - 7 then
    if to-semitones-floor(desc-quarter-sharp-fifth) == 0 - 8 then
      if to-semitones-ceil(desc-quarter-sharp-fifth) == 0 - 7 then unit else trap("ceil -> -7")
    else
      trap("floor -> -8")
  else
    trap("truncate -> -7")

@test
def ceil-rounds-up-for-a-positive-off-grid-interval() =
  // A positive off-grid 7.5 semitones: ceil → 8 (up), vs truncate/floor → 7. Pins ceil's upward rounding.
  let quarter-sharp-fifth = rinterval(Rational.of(15, 24)) in
    if to-semitones-ceil(quarter-sharp-fifth) == 8 then
    if to-semitones-floor(quarter-sharp-fifth) == 7 then unit else trap("floor -> 7")
  else
    trap("ceil -> 8")

@test
def round-snaps-to-the-nearest-semitone-ties-away-from-zero() =
  // The recommended default snap. Just under a tie: 7/12 + 1/48 octave = 29/48 → 7.25 semitones → 7.
  // Exactly a tie: 15/24 octave = 7.5 → 8 (half-AWAY-from-zero). Its negative -7.5 → -8 (away from zero).
  let near-fifth = rinterval(Rational.of(29, 48)) in
  let quarter-sharp-fifth = rinterval(Rational.of(15, 24)) in
    if to-semitones-round(near-fifth) == 7 then
    if to-semitones-round(quarter-sharp-fifth) == 8 then
      if to-semitones-round(r-negate(quarter-sharp-fifth)) == 0 - 8 then unit else trap("-7.5 → -8")
    else
      trap("7.5 → 8 (tie away from zero)")
  else
    trap("7.25 → 7")

@test
def round-agrees-with-the-others-on-the-grid() =
  // On the 12-TET grid round == truncate == floor == ceil == the exact value (no fractional part).
  if to-semitones-round(r-perfect-fifth) == 7 then
    if to-semitones-round(r-octave) == 12 then
      if to-semitones-round(r-negate(r-perfect-fifth)) == 0 - 7 then
        unit
      else
        trap("descending fifth → -7")
    else
      trap("octave → 12")
  else
    trap("fifth → 7")

export {
  RInterval.*,
  rinterval,
  octaves,
  edo-step,
  semitones-r,
  degree-r,
  r-unison,
  r-octave,
  r-double-octave,
  r-semitone,
  r-wholetone,
  r-minor-third,
  r-major-third,
  r-perfect-fourth,
  r-tritone,
  r-perfect-fifth,
  r-minor-sixth,
  r-major-sixth,
  r-minor-seventh,
  r-major-seventh,
  r-add,
  r-sub,
  r-negate,
  r-eq,
  r-complement,
  to-semitones-exact,
  to-semitones,
  to-semitones-floor,
  to-semitones-ceil,
  to-semitones-round
}
