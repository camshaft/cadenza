// ---- consonance classification -----------------------------------------------------------------------
/// consonance.cdz — classify an interval as consonant or dissonant (traditional common-practice).
///
/// A small, independent classifier over interval SIZE (folded into an octave): the perfect consonances
/// (unison 0, perfect fourth 5, perfect fifth 7, octave 0) and imperfect consonances (minor/major third
/// 3/4, minor/major sixth 8/9) are consonant; the seconds (1/2), the tritone (6), and the sevenths (10/11)
/// are dissonant. This is the common-practice classification a harmony/analysis tool uses to flag tension.
/// (The perfect fourth is treated as a consonance here — the traditional interval-class view; a
/// counterpoint-specific tool may reclassify it against the bass, out of scope.)
///
/// Grounds only on pitch.cdz idioms (folded semitones); pure integer arithmetic, total.
/// Floored modulus into `0 .. m-1` (local; matches pitch.cdz's mod-floor for negative sizes).
def mod-floor(n: Int64, m: Int64) =
  let r = n % m in
    if r < 0 then r + m else r

/// Is an interval (given as a signed semitone count) CONSONANT? Folds by absolute size into 0..11, then
/// classifies: 0,3,4,5,7,8,9 consonant; 1,2,6,10,11 dissonant.
def is-consonant(semitones: Int64) =
  let a = if semitones < 0 then 0 - semitones else semitones in
  let f = mod-floor(a, 12) in
    if f == 0 then
    true
  else if f == 3 then
    true
  else if f == 4 then
    true
  else if f == 5 then
    true
  else if f == 7 then
    true
  else if f == 8 then
    true
  else if f == 9 then
    true
  else
    false

/// Is an interval DISSONANT (the complement of consonant)?
def is-dissonant(semitones: Int64) = if is-consonant(semitones) then false else true

/// Is an interval a PERFECT consonance (unison/fourth/fifth/octave: folded 0, 5, or 7)?
def is-perfect-consonance(semitones: Int64) =
  let f = mod-floor(if semitones < 0 then 0 - semitones else semitones, 12) in
    if f == 0 then true else if f == 5 then true else if f == 7 then true else false

/// ============================ @test suite (consonance laws) ============================
@test
def perfect-intervals-are-consonant() =
  // unison 0, fourth 5, fifth 7, octave 12 — all consonant, and all perfect consonances.
  if is-consonant(0) then
    if is-consonant(7) then
      if is-consonant(12) then
        if is-perfect-consonance(5) then unit else trap("fourth is a perfect consonance")
      else
        trap("octave")
    else
      trap("fifth")
  else
    trap("unison")

@test
def thirds-and-sixths-are-imperfect-consonances() =
  // 3,4 (thirds) and 8,9 (sixths) are consonant but NOT perfect consonances.
  if is-consonant(3) then
    if is-consonant(4) then
      if is-consonant(8) then
        if is-consonant(9) then
          if is-perfect-consonance(4) then trap("a third is not a perfect consonance") else unit
        else
          trap("major sixth")
      else
        trap("minor sixth")
    else
      trap("major third")
  else
    trap("minor third")

@test
def seconds-tritone-and-sevenths-are-dissonant() =
  // 1,2 (seconds), 6 (tritone), 10,11 (sevenths) are dissonant.
  if is-dissonant(1) then
    if is-dissonant(2) then
      if is-dissonant(6) then
        if is-dissonant(10) then
          if is-dissonant(11) then unit else trap("major seventh")
        else
          trap("minor seventh")
      else
        trap("tritone")
    else
      trap("major second")
  else
    trap("minor second")

@test
def classification-is-direction-and-octave-independent() =
  // A descending fifth (-7) and a compound fifth (19 = octave + fifth) are both consonant like +7.
  if is-consonant(0 - 7) then
    if is-consonant(19) then
      if is-dissonant(0 - 1) then unit else trap("descending minor second is dissonant")
    else
      trap("compound fifth is consonant")
  else
    trap("descending fifth is consonant")

@test
def consonant-and-dissonant-partition-the-octave() =
  // Every semitone 0..11 is exactly one of consonant/dissonant (a total partition) — check all twelve.
  let check = fn(s: Int64) =>
      if is-consonant(s) then if is-dissonant(s) then false else true else is-dissonant(s) in
    if check(0) then
    if check(1) then
      if check(2) then
        if check(3) then
          if check(4) then
            if check(5) then
              if check(6) then
                if check(7) then
                  if check(8) then
                    if check(9) then
                      if check(10) then if check(11) then unit else trap("11") else trap("10")
                    else
                      trap("9")
                  else
                    trap("8")
                else
                  trap("7")
              else
                trap("6")
            else
              trap("5")
          else
            trap("4")
        else
          trap("3")
      else
        trap("2")
    else
      trap("1")
  else
    trap("0")

@test
def the-tritone-is-a-lone-dissonance-between-two-consonances() =
  // The sharp classification boundary: the tritone (6) is dissonant, but BOTH its neighbours — the perfect
  // fourth (5) and perfect fifth (7) — are consonant. The tritone is the lone dissonant size wedged between
  // the two perfect consonances (the "diabolus in musica" sitting between P4 and P5).
  if is-dissonant(6) then
    if is-consonant(5) then
      if is-consonant(7) then
        if is-perfect-consonance(6) then trap("the tritone is not a perfect consonance") else unit
      else
        trap("fifth consonant")
    else
      trap("fourth consonant")
  else
    trap("tritone dissonant")

export { is-consonant, is-dissonant, is-perfect-consonance }
