/// pc-set.cdz — the PITCH-CLASS SET primitive shared by the set-theory layer (interval-vector, set-class).
///
/// Folding a list of note numbers into a canonical pitch-class SET — octave-fold each to `0..11`, then
/// insert into a sorted, DEDUPED list — is the common first step of every set-theoretic operation (the
/// interval-class vector, transpositional equivalence, …). interval-vector.cdz and set-class.cdz each
/// carried a byte-identical copy of this fold; this module is the single source of truth they now import,
/// so the canonical-set contract can't drift between them.
///
/// Pure integer arithmetic over Int64, total, no imports. `pc-of` matches analysis.cdz / chord.cdz's
/// floored pitch class exactly, so the whole music layer agrees on what "pitch class" means.
/// Floored pitch class `0..11` of a note number (negative notes fold up; matches analysis.cdz/chord.cdz).
def pc-of(n: Int64) =
  let r = n % 12 in
  if r < 0 then r + 12 else r

/// Insert `x` into a sorted ascending list, keeping it sorted and DEDUPED (a duplicate is dropped). This
/// is what makes a pitch-class list a canonical SET. Recursive, annotated params.
def insert-sorted(xs: List(Int64), x: Int64) = match xs with
  | [] => [x]
  | [h, .. t] => if x == h then
    xs
  else if x < h then
    List.prepend(xs, x)
  else
    List.prepend(insert-sorted(t, x), h)

/// Fold a note list into its sorted, deduped pitch-class SET. Recursive driver threading the sorted set.
def pc-set-go(notes: List(Int64), acc: List(Int64)) = match notes with
  | [] => acc
  | [h, .. t] => pc-set-go(t, insert-sorted(acc, pc-of(h)))

/// The sorted, deduped set of pitch classes of a note list — the canonical form the set-theory ops work on.
def pc-set(notes: List(Int64)) = pc-set-go(notes, [])

/// ============================ @test suite (pitch-class set primitive) ============================
@test
def pc-of-folds-into-zero-to-eleven() =
  // Middle C (60) is pc 0, a fifth up (67) is pc 7, and a NEGATIVE note folds up: -1 is pc 11.
  if pc-of(60) == 0 then
    if pc-of(67) == 7 then
      if pc-of(0 - 1) == 11 then unit else trap("-1 folds to pc 11")
    else
      trap("67 is pc 7")
  else
    trap("60 is pc 0")

@test
def a-pc-set-is-sorted-deduped-and-octave-folded() =
  // Notes given out of order, spread across octaves, with an octave-doubling (60 and 72 are both C):
  // fold to the sorted deduped set {0,4,7}.
  match pc-set([67, 60, 64, 72]) with
    | [a, b, c] => if a == 0 then
      if b == 4 then if c == 7 then unit else trap("third is 7") else trap("second is 4")
    else
      trap("first is 0")
    | _ => trap("three distinct pitch classes")

@test
def the-empty-note-list-is-the-empty-set() = match pc-set([]) with
  | [] => unit
  | _ => trap("empty in, empty out")

@test
def insert-sorted-drops-a-duplicate-and-orders() =
  // Inserting 4 into [0,7] gives [0,4,7]; inserting an existing 7 is a no-op.
  match insert-sorted([0, 7], 4) with
    | [a, b, c] => if a == 0 then
      if b == 4 then
        if c == 7 then
          match insert-sorted([0, 4, 7], 7) with
            | [_, _, _] => unit
            | _ => trap("dup dropped, still three")
        else
          trap("7 last")
      else
        trap("4 middle")
    else
      trap("0 first")
    | _ => trap("three after insert")

export { pc-of, insert-sorted, pc-set }
