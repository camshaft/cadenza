/// piece.cdz — a complete SHOWCASE composition, built from the theory + composition primitives as pure
/// data. This is the "built from visible primitives, not an opaque library fn" showcase (the CAD-snowflake
/// discipline): a real multi-part piece — a I–V–vi–IV chord progression with an arpeggiated accompaniment
/// and a bass line — assembled ENTIRELY from scale/chord/rhythm/compose, returning one `List(Note)` the
/// scheduler lowers to MIDI. It is the raw material the phase-2 DES-composed-piece demo plays over the Sim
/// clock, and it doubles as an end-to-end gate: if any lower primitive regresses, the piece's note count /
/// balance changes and these @tests fail.
///
/// Harmony: C major. Progression I–V–vi–IV = C–G–Am–F (roots 60,67,69,65), one bar each in 4/4 (a bar =
/// 3840 ticks at PPQ 960). Accompaniment arpeggiates each chord across the bar; the bass plays each chord
/// root as a whole note. Channels: 0 = accompaniment, 1 = bass. All Int64 ticks, all built fresh (dodges
/// issue 9927 the same way compose.cdz does).
import { Note } from "schedule"

import { schedule, balanced, note-pitch, note-chan, note-start } from "schedule"

import { chord-notes, major-triad, minor-triad } from "chord"

import { pitch, note } from "pitch"

import { arpeggiate, melody-note } from "compose"

/// Ticks per bar in 4/4 at PPQ 960.
def bar = 3840

/// A quarter note (one arpeggio step). A 4/4 bar holds four of these; the arpeggio emits ONE per chord
/// tone, so a triad covers 3 of the 4 beats (beat 4 rests) — see accompaniment-bar.
def step = 960

/// The arpeggiated accompaniment for ONE chord (given its realized note numbers) over a bar starting at
/// `start`: one note per chord tone, spread a quarter apart, each a quarter long, on channel 0. A triad
/// (3 tones) therefore sounds beats 1-3 and rests beat 4; it does NOT fill the whole bar.
def accompaniment-bar(nums: List(Int64), start: Int64) = arpeggiate(nums, 0, 90, start, step, step)

/// The bass note for a bar: the chord root as a whole note on channel 1.
def bass-bar(root: Int64, start: Int64) = melody-note(root, 1, 110, start, bar)

/// The four chords of the I–V–vi–IV progression in C major, as realized note-number lists.
def chord-c = chord-notes(major-triad(pitch(60)))

// I  — C major
def chord-g = chord-notes(major-triad(pitch(67)))

// V  — G major
def chord-am = chord-notes(minor-triad(pitch(69)))

// vi — A minor
def chord-f = chord-notes(major-triad(pitch(65)))

// IV — F major
/// The full progression piece: for each bar, the arpeggiated accompaniment plus the bass root. Built by
/// concatenating the per-bar note lists (four bars, bars start at 0/3840/7680/11520).
def progression =
  List.concat(
    List.concat(accompaniment-bar(chord-c, 0), bass-bar-list(60, 0)),
    List.concat(
      List.concat(accompaniment-bar(chord-g, bar), bass-bar-list(67, bar)),
      List.concat(
        List.concat(accompaniment-bar(chord-am, bar * 2), bass-bar-list(69, bar * 2)),
        List.concat(accompaniment-bar(chord-f, bar * 3), bass-bar-list(65, bar * 3))
      )
    )
  )

/// The bass note as a singleton list (so it concatenates uniformly with the accompaniment list).
def bass-bar-list(root: Int64, start: Int64) = [bass-bar(root, start)]

/// ============================ @test suite (the showcase piece) ============================
@test
def the-progression-has-every-note() =
  // 4 bars * (3 arpeggio notes + 1 bass) = 16 notes.
  if List.len(progression) == 16 then unit else trap("sixteen notes")

@test
def the-progression-schedules-with-no-stuck-keys() =
  // The end-to-end gate: the whole piece lowers to paired on/off events, net zero — no stuck keys.
  let evs = schedule(progression) in
  if List.len(evs) == 32 then
    if balanced(evs) then unit else trap("balanced")
  else
    trap("32 events")

@test
def the-bass-carries-the-progression-roots() =
  // The bass line (channel 1) plays C, G, A, F roots (60, 67, 69, 65) in order — the harmonic skeleton.
  if bass-note-at-or-trap(progression, 0) == 60 then
    if bass-note-at-or-trap(progression, bar) == 67 then
      if bass-note-at-or-trap(progression, bar * 2) == 69 then
        if bass-note-at-or-trap(progression, bar * 3) == 65 then unit else trap("F")
      else
        trap("A")
    else
      trap("G")
  else
    trap("C")

@test
def the-two-parts-live-on-their-own-channels() =
  // The piece is two voices: the arpeggiated accompaniment on channel 0 and the bass on channel 1.
  // Every note sits on one of those two channels (no stray channel), and there are exactly 4 bass notes
  // (one root per bar) and 12 accompaniment notes (3 arpeggio tones * 4 bars) — 16 in all.
  if count-on-chan(progression, 1) == 4 then
    if count-on-chan(progression, 0) == 12 then
      if all-on-chan-0-or-1(progression) then unit else trap("no note strays off channels 0/1")
    else
      trap("twelve accompaniment notes on channel 0")
  else
    trap("four bass notes on channel 1")

// ---- test helpers -----------------------------------------------------------------------------------
/// How many notes are on channel `c`? Recursive, annotated.
def count-on-chan(notes: List(Note), c: Int64) = match notes with
  | [] => 0
  | [h, .. rest] => (if note-chan(h) == c then 1 else 0) + count-on-chan(rest, c)

/// Is every note on channel 0 or channel 1 (the two voices)? Recursive, annotated.
def all-on-chan-0-or-1(notes: List(Note)) = match notes with
  | [] => true
  | [h, .. rest] =>
    let c = note-chan(h) in
    if c == 0 then all-on-chan-0-or-1(rest) else if c == 1 then all-on-chan-0-or-1(rest) else false

/// The note number of a note — via the exported accessors, NOT a nested `Note.Note(Pitch.Pitch(k),…)`
/// destructure (a nested match on the imported boxed `Pitch` traps at runtime; issue-9927 family).
def note-num(n: Note) = note(note-pitch(n))

/// The note number of the CHANNEL-1 (bass) note starting at tick `t` as `Some(num)`, or `None` if no bass
/// note starts there (recursive search, annotated). Typed absence — no sentinel note number flows in-band.
def bass-note-at(notes: List(Note), t: Int64) = match notes with
  | [] => Option.None(unit)
  | [h, .. rest] =>
    if note-chan(h) == 1 then
      if note-start(h) == t then Option.Some(note-num(h)) else bass-note-at(rest, t)
    else
      bass-note-at(rest, t)

/// Test helper: the bass note number at tick `t`, trapping if none is found (the tests below assert a bass
/// note IS present at each bar downbeat, so absence is a real failure, not an in-band value).
def bass-note-at-or-trap(notes: List(Note), t: Int64) = match bass-note-at(notes, t) with
  | Option.Some(num) => num
  | Option.None(_) => trap("no bass note starts at the queried tick")

export { progression, accompaniment-bar, bass-bar, chord-c, chord-g, chord-am, chord-f }
