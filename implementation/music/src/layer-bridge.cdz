/// layer-bridge.cdz — the CROSS-LAYER CONSISTENCY gate: pin that the RATIONAL theory core and the Int64
/// MIDI-projection layer AGREE on every 12-TET interval.
///
/// The library has two representations (see DESIGN.md): the rational CORE (`RInterval` = octave-fraction,
/// mode/tuning-independent) and the Int64 PROJECTION (`Interval` = signed semitones, what the MIDI wire
/// consumes). They must agree on the 12-TET grid — a rational `s/12`-octave interval must project to
/// exactly `s` semitones. This module is a GATE that fails if a future change to EITHER layer silently
/// drifts them apart: for each named interval, `to-semitones-exact(<rational>)` must equal
/// `Some(semitones(<int64>))`. It witnesses the two-layer invariant so neither side can regress unnoticed.
import { Interval, semitones } from "pitch"

import {
  unison,
  major-second,
  minor-third,
  major-third,
  perfect-fourth,
  tritone,
  perfect-fifth,
  major-sixth,
  major-seventh,
  octave-interval
} from "pitch"

import { minor-second, minor-sixth, minor-seventh } from "pitch"

import { RInterval, to-semitones-exact } from "interval-ratio"

import {
  r-unison,
  r-semitone,
  r-wholetone,
  r-minor-third,
  r-major-third,
  r-perfect-fourth,
  r-tritone,
  r-perfect-fifth,
  r-minor-sixth,
  r-major-sixth,
  r-minor-seventh,
  r-major-seventh,
  r-octave
} from "interval-ratio"

import { RChord, rchord-stack, major-triad-r, dominant-seventh-r } from "chord-ratio"

import { major-triad-stack, dominant-seventh-stack } from "chord"

/// Assert the rational interval `ri` projects (exactly, on the 12-TET grid) to the same semitone count the
/// Int64 interval `ii` carries. Returns unit on agreement, traps on mismatch or an off-grid rational.
def agree(ri: RInterval, ii: Interval) = match to-semitones-exact(ri) with
  | Option.Some(s) => if s == semitones(ii) then unit else trap("rational/Int64 semitone mismatch")
  | Option.None(_) => trap(
    "rational interval is off the 12-TET grid — cannot bridge to Int64 semitones"
  )

/// ============================ @test suite (cross-layer 12-TET agreement) ============================
@test
def unison-agrees() = agree(r-unison, unison)

@test
def minor-second-agrees() = agree(r-semitone, minor-second)

@test
def major-second-agrees() = agree(r-wholetone, major-second)

@test
def minor-third-agrees() = agree(r-minor-third, minor-third)

@test
def major-third-agrees() = agree(r-major-third, major-third)

@test
def perfect-fourth-agrees() = agree(r-perfect-fourth, perfect-fourth)

@test
def tritone-agrees() = agree(r-tritone, tritone)

@test
def perfect-fifth-agrees() = agree(r-perfect-fifth, perfect-fifth)

@test
def minor-sixth-agrees() = agree(r-minor-sixth, minor-sixth)

@test
def major-sixth-agrees() = agree(r-major-sixth, major-sixth)

@test
def minor-seventh-agrees() = agree(r-minor-seventh, minor-seventh)

@test
def major-seventh-agrees() = agree(r-major-seventh, major-seventh)

@test
def octave-agrees() = agree(r-octave, octave-interval)

@test
def the-whole-twelve-tet-grid-round-trips() =
  // Every one of the named intervals bridges: this is the batch witness that the two layers agree across
  // the FULL 12-TET set — all thirteen grid points 0..12 semitones, with no gap — so a drift in either
  // representation is caught anywhere on the grid.
  let _u0 = agree(r-unison, unison) in
  let _u1 = agree(r-semitone, minor-second) in
  let _u2 = agree(r-wholetone, major-second) in
  let _u3 = agree(r-minor-third, minor-third) in
  let _u4 = agree(r-major-third, major-third) in
  let _u5 = agree(r-perfect-fourth, perfect-fourth) in
  let _u6 = agree(r-tritone, tritone) in
  let _u7 = agree(r-perfect-fifth, perfect-fifth) in
  let _u8 = agree(r-minor-sixth, minor-sixth) in
  let _u9 = agree(r-major-sixth, major-sixth) in
  let _u10 = agree(r-minor-seventh, minor-seventh) in
  let _u11 = agree(r-major-seventh, major-seventh) in
    agree(r-octave, octave-interval)

/// Assert a rational chord's STACK (list of RInterval offsets) projects, entry-by-entry, to the Int64
/// semitone stack `ints` — the chord-level twin of `agree`. Traps on any mismatch or off-grid entry.
def chord-agree(rstack: List(RInterval), ints: List(Int64)) = match rstack with
  | [] => (match ints with
    | [] => unit
    | [_, .. _] => trap("rational chord has fewer intervals")
  )
  | [rh, .. rt] => match ints with
    | [] => trap("rational chord has more intervals")
    | [ih, .. it] => match to-semitones-exact(rh) with
      | Option.Some(s) => if s == ih then
        chord-agree(rt, it)
      else
        trap("chord stack semitone mismatch")
      | Option.None(_) => trap("rational chord interval off the 12-TET grid")

@test
def rational-and-int64-chords-agree-on-twelve-tet() =
  // Cross-layer chord invariant (the operator's rationals-everywhere directive, extended from intervals to
  // CHORDS): the rational chord stacks project to the SAME semitone stacks as the Int64 chord.cdz stacks.
  // major-triad-r → [0,4,7] = major-triad-stack; dominant-seventh-r → [0,4,7,10] = dominant-seventh-stack.
  let _t = chord-agree(rchord-stack(major-triad-r(r-unison)), major-triad-stack) in
    chord-agree(rchord-stack(dominant-seventh-r(r-unison)), dominant-seventh-stack)

export { agree, chord-agree }
