// ---- the cadence kinds -------------------------------------------------------------------------------
/// cadence.cdz — recognize the standard harmonic CADENCES from a pair of scale degrees.
///
/// A cadence is the harmonic punctuation that closes (or suspends) a phrase, named by the two chords at
/// its end. Working in SCALE-DEGREE space (0-based: I=0, ii=1, iii=2, IV=3, V=4, vi=5, vii°=6 — the same
/// indexing progression.cdz uses), this classifies the motion from one degree to the next:
///   - AUTHENTIC   V → I   (degree 4 → 0): the strongest close.
///   - PLAGAL      IV → I  (3 → 0): the "amen" close.
///   - HALF        _ → V   (anything → 4): an open, suspended ending on the dominant.
///   - DECEPTIVE   V → vi  (4 → 5): the dominant resolves to the submediant instead of the tonic.
///   - NONE        anything else.
///
/// Pure integer degree analysis (degrees folded mod 7), no imports — it composes with progression.cdz at
/// the degree-index boundary (classify successive entries of a `progression`'s degree list). The Half test
/// is checked LAST so V→I reads as Authentic (not Half), matching how theory names the stronger cadence.
/// A recognized cadence between two scale degrees, or `NoCadence`.
type Cadence =
  | Authentic
  | Plagal
  | Half
  | Deceptive
  | NoCadence

/// Floored modulus into `0 .. m-1` (degrees fold into 0..6).
def mod-floor(n: Int64, m: Int64) =
  let r = n % m in
  if r < 0 then r + m else r

/// Classify the cadence from scale degree `a` to scale degree `b` (0-based, folded mod 7). Authentic (V→I)
/// and Plagal (IV→I) and Deceptive (V→vi) are checked before Half (→V), so V→I is Authentic not Half.
def cadence-of(a: Int64, b: Int64) =
  let from = mod-floor(a, 7) in
  let to = mod-floor(b, 7) in
  if to == 0 then
    if from == 4 then
      Cadence.Authentic // V → I
    else if from == 3 then
      Cadence.Plagal // IV → I
    else
      Cadence.NoCadence // some other → I is not a named cadence here
  else if from == 4 then
    if to == 5 then
      Cadence.Deceptive // V → vi (dominant resolves away from the tonic)
    else if to == 4 then
      Cadence.Half // V → V (still on the dominant)
    else
      Cadence.NoCadence // V → something else is not a named cadence
  else if to == 4 then
    Cadence.Half // anything → V (open, suspended)
  else
    Cadence.NoCadence

/// Does a cadence CLOSE a phrase (Authentic or Plagal land on the tonic)? Half and Deceptive do not.
def is-closing(c: Cadence) = match c with
  | Cadence.Authentic => true
  | Cadence.Plagal => true
  | _ => false

/// ============================ @test suite (cadence laws) ============================
@test
def authentic-is-five-to-one() = match cadence-of(4, 0) with
  | Cadence.Authentic => unit
  | _ => trap("V->I is authentic")

@test
def plagal-is-four-to-one() = match cadence-of(3, 0) with
  | Cadence.Plagal => unit
  | _ => trap("IV->I is plagal")

@test
def deceptive-is-five-to-six() = match cadence-of(4, 5) with
  | Cadence.Deceptive => unit
  | _ => trap("V->vi is deceptive")

@test
def half-ends-on-the-dominant() =
  // Anything landing on V (that isn't itself a stronger named cadence) is a half cadence: ii->V, I->V.
  match cadence-of(1, 4) with
    | Cadence.Half => (match cadence-of(0, 4) with
      | Cadence.Half => unit
      | _ => trap("I->V is half")
    )
    | _ => trap("ii->V is half")

@test
def five-to-one-is-authentic-not-half() =
  // Precedence: V->I must read as Authentic even though I is not V — the stronger cadence wins. And a
  // non-cadential motion (I->IV) is NoCadence.
  match cadence-of(4, 0) with
    | Cadence.Authentic => (match cadence-of(0, 3) with
      | Cadence.NoCadence => unit
      | _ => trap("I->IV is not a cadence")
    )
    | _ => trap("V->I authentic")

@test
def closing-only-for-tonic-cadences() =
  // is-closing: Authentic + Plagal close; Half + Deceptive + NoCadence do not.
  if is-closing(Cadence.Authentic) then
    if is-closing(Cadence.Plagal) then
      if is-closing(Cadence.Half) then
        trap("half does not close")
      else if is-closing(Cadence.Deceptive) then
        trap("deceptive does not close")
      else
        unit
    else
      trap("plagal closes")
  else
    trap("authentic closes")

@test
def degrees-fold-mod-seven() =
  // A degree index past the octave folds: degree 11 == 4 (V), so 11 -> 7(==0, I) is still authentic.
  match cadence-of(11, 7) with
    | Cadence.Authentic => unit
    | _ => trap("folded V->I is authentic")

export { Cadence.*, cadence-of, is-closing }
