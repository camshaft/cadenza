/// examples-typed.cdz — P1 "units everywhere", stage S3: worked models built through the STRONG-UNIT-TYPED
/// boundary (units-typed.cdz), on the operator's exact-Rational-METER internal model.
///
/// THE SHOWCASE the operator asked for: a model author writes dimensions as LENGTHS in whatever unit is
/// natural — `meters(…)`, or an inch/mm length — and the constructor (`v3-len`) TYPE-CHECKS that each is a
/// length (a bare number is a compile error), converts it to exact Rational meters, and hands the exact
/// geometry to the existing CSG/bbox core via `to-vec3r`. Author in any unit, store exact meters, no float.
///
/// This is the S2 API in action; when the file-top `default-fraction` pragma lands (v-syntax, greenlit),
/// the `Rational.of` here becomes bare `n/d` and the models read even cleaner. The TYPES don't change.

import { Solidr, Vec3r, Aabbr } from "exact"
import { bounding-box, aabbr-size, v3r-x, v3r-y, v3r-z } from "exact"
import { Vec3m, v3-len, len-m, meters, to-vec3r } from "units-typed"

/// A length in inches, converted to an exact Rational-METER quantity at the boundary (the language's exact
/// inch↔meter conversion: 1 inch = 127/5000 m). This is how an author writes an inch dimension and still
/// stores exact meters — the operator's "author in any unit, the language converts" model.
def inches(n: Int64) =
  Qty.of(Qty.value(Unit.in(Unit.of(#"meter"), Qty.of(Rational.of(n, 1), Unit.of(#"inch")))), Unit.of(#"meter"))

/// A meter-model axis-aligned box: width/depth/height given as LENGTHS (type-checked), stored as exact
/// meters, built into the exact `Solidr` CSG the drivers consume. Mixing a length with a bare number here
/// is a CDZ0301 type error — the strong unit typing the operator wants, at the point of authoring.
def box-len(w: Qty(Rational, Unit.base(#"meter")), d: Qty(Rational, Unit.base(#"meter")), h: Qty(Rational, Unit.base(#"meter"))) =
  Solidr.Cuber(to-vec3r(v3-len(w, d, h)))

/// ---- worked models: author in real units, exact meters underneath ----

/// A 2m × 1m × 1m plinth, authored in meters. Exact.
def plinth() = box-len(meters(2), meters(1), meters(1))

/// A mixed-unit block: 1m wide, but 12-inch deep and 6-inch high (author freely mixes meters + inches; both
/// convert to exact Rational meters — 12 inch = 1524/5000 m, 6 inch = 762/5000 m — no rounding). THE
/// showcase: units mix EXACTLY in one model.
def mixed-block() = box-len(meters(1), inches(12), inches(6))

/// ============================ @test suite (S3 — units-typed worked models, exact meters) ============================

@test
def plinth-bbox-is-exact-meters() =
  // The plinth is a full-size 2×1×1 m box centred at origin; its bounding-box size is exactly 2×1×1 m
  // (bare Rational meters — the stored model unit). Exact, via the existing exact bbox fold.
  let sz = aabbr-size(bounding-box(plinth())) in
  if v3r-x(sz) == Rational.of(2, 1) then
    (if v3r-y(sz) == Rational.of(1, 1) then (if v3r-z(sz) == Rational.of(1, 1) then unit else trap("z")) else trap("y"))
  else trap("x")

@test
def mixed-units-block-is-exact() =
  // 1 m wide, 12-inch deep, 6-inch high — the mixed-unit showcase. 12 inch = 1524/5000 m, 6 inch =
  // 762/5000 m, EXACTLY (no float). The bbox reports these exact meter magnitudes.
  let sz = aabbr-size(bounding-box(mixed-block())) in
  if v3r-x(sz) == Rational.of(1, 1) then
    (if v3r-y(sz) == Rational.of(1524, 5000) then
       (if v3r-z(sz) == Rational.of(762, 5000) then unit else trap("z = 6 inch in m"))
     else trap("y = 12 inch in m"))
  else trap("x = 1 m")

@test
def a-length-authored-in-inches-stores-exact-meters() =
  // Directly: inches(1) is 1 inch stored as exactly 127/5000 m (the boundary conversion, no rounding).
  if len-m(inches(1)) == Rational.of(127, 5000) then unit else trap("1 inch = 127/5000 m")

export { inches, box-len, plinth, mixed-block }
