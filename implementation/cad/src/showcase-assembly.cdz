/// showcase-assembly.cdz — ASSEMBLY-AS-CODE (operator: multi-part models positioned + combined in
/// construct-style code). A worked L-bracket assembly: several named PART defs, each a `Solid`, mated into a
/// whole by ordinary Cadenza code — origin-relative `Translate`/`Rotate`/`Mirror` chains over the parts'
/// exact known dimensions. This is the design doc's finding made concrete: "an assembly IS just a `Solid`" —
/// no mate-constraint solver, no part-tree type; the call graph of the part defs is the tree, and "mating" is
/// a transform whose offset is dimension arithmetic (exactly how the operator's `printing` parts compose).
///
/// THE ASSEMBLY: a right-angle mounting bracket — a horizontal BASE plate + a vertical ARM standing up at
/// 90° from the base's back edge + a triangular GUSSET bracing the corner, with a bolt HOLE through the base
/// and one through the arm. Every placement is expressed relative to the shared origin using the parts'
/// dimensions, so changing a dimension re-mates everything by construction. Uses the landed Rotate/Mirror.
@!default-fraction Rational

import { Solid, SolidR, Vec3, Aabb, lower, v3, v3-eq, bounding-box, aabbr-size, solidr-is-empty } from "exact"

import { box, cyl, fuse, cut, move-x, move-y, move-z, rotate-x, rotate-z, mirror-y, hole-through } from "helpers"

/// ---- shared dimensions (the single source of truth every part + mate reads) -------------------------
/// A change here re-mates the whole assembly (parts line up by construction, like printing's shared consts).
def plate-len() = 40 / 1

// base plate length (x)
def plate-wid() = 30 / 1

// base plate + arm width (y)
def thick() = 4 / 1

// material thickness
def arm-height() = 25 / 1

// how tall the vertical arm stands
def bolt-r() = 3 / 1

// bolt-hole radius
/// ---- the PARTS (each a named `Solid` def — the "part tree" is this call graph) ----------------------
/// The horizontal base plate: a `plate-len × plate-wid × thick` slab, its bottom face on z=0 (shifted up
/// half a thickness from the origin-centred box), with a bolt hole near the front.
def base-plate() =
  let slab = move-z(thick() / (2 / 1), box(plate-len(), plate-wid(), thick())) in
  // bolt hole: a vertical cylinder through the thickness, placed 3/4 along +x, centred in y.
  let hole = move-x(plate-len() / (4 / 1), cyl(thick() * (2 / 1), bolt-r())) in
  cut(slab, move-z(thick() / (2 / 1), hole))

/// The vertical arm: a `plate-wid × arm-height × thick` slab standing UP. Built flat, then rotated 90° about
/// x so it rises in +z, with a bolt hole through its face. (This is the rotation-mating the model needed.)
def arm-flat() =
  let slab = move-z(thick() / (2 / 1), box(plate-wid(), arm-height(), thick())) in
  let hole = move-y(arm-height() / (3 / 1), cyl(thick() * (2 / 1), bolt-r())) in
  cut(slab, move-z(thick() / (2 / 1), hole))

/// A triangular corner gusset (approximated as a small angled box) bracing the base↔arm joint.
def gusset() = rotate-z(45 / 1, box(arm-height() / (2 / 1), thick(), plate-wid() / (2 / 1)))

/// ---- the ASSEMBLY: mate the parts, origin-relative, via transform chains over the shared dimensions ---
/// Stand the arm up at the base's back edge: rotate the flat arm +90° about x (so its +y becomes +z), then
/// translate it to the base's back edge (y = -plate-wid/2) and up onto the base's top face (z = thick).
def standing-arm() =
  move-y((rzero() - plate-wid()) / (2 / 1), move-z(thick(), rotate-x(90 / 1, arm-flat())))

def rzero() = 0 / 1

/// The full L-bracket: base + standing arm + a gusset each side (bilateral via mirror-y), fused. This is the
/// assembly — a single `Solid` built by unioning transformed parts, exactly the design-doc pattern.
def l-bracket() =
  let core = fuse(base-plate(), standing-arm()) in
  let braced = fuse(core, move-y((rzero() - plate-wid()) / (2 / 1) + thick() / (2 / 1), gusset())) in
  braced

/// ---- @tests: pin the assembly mates ----------------------------------------------------------------
/// 🪤 These tests deliberately DO NOT take `bounding-box` of the full multi-part assembly: `bounding-box` is
/// a recursive heap-walk that is currently NONDETERMINISTIC over a nested-Union tree of more than ~4 nodes
/// (a real miscompile — repro issues/mlrepro-recursive-fuse-*.cdz, routed to v-memory-safety). The MESH is
/// unaffected (the driver never calls bounding-box), so the showcase renders correctly; but a bbox over the
/// whole assembly would be unreliable. So we pin PER-PART envelopes (small, reliable trees) + the assembly's
/// non-emptiness, which is what's soundly checkable until the miscompile is fixed.
@test
def the-assembly-is-non-empty() =
  // The full assembly is real geometry (a top-node test, not a full heap-walk — miscompile-safe).
  if solidr-is-empty(l-bracket()) == false then
    unit
  else
    trap("the L-bracket assembly has geometry")

@test
def the-lowered-render-form-is-non-empty() =
  // THE render-edge pin: main = lower(l-bracket()) is the exact SolidR tree handed to the mesh driver. The
  // model being non-empty (above) is NOT enough — a `lower` regression that dropped/emptied a branch would
  // still leave the MODEL non-empty while the RENDER goes blank (exactly the empty-Solid-mesh class the
  // snowflake hit: "meshes" ≠ "renders"). Pin that the LOWERED output is not SolidR.Empty. (l-bracket's top
  // node is a fuse → the lowered top is a SolidR.Union — a real, meshable render node.)
  match lower(l-bracket()) with
    | SolidR.Empty => trap("the lowered render form (what the driver meshes) must NOT be empty")
    | _ => unit

@test
def the-standing-arm-rises-above-the-base() =
  // The arm PART (a small tree — reliable bbox) stands well above z=0 after its 90° rotate + lift onto the
  // base top: its z-top exceeds the base thickness by a wide margin (the mate raises it).
  match bounding-box(standing-arm()) with
    | Aabb.Box(_, hi) =>
      match hi with
        | Vec3.V3(_, _, hz) =>
          if hz > thick() then unit else trap("the standing arm rises above the base's top face")

@test
def the-base-plate-hole-does-not-grow-the-base() =
  // Sanity on the part itself (a small tree — reliable bbox): drilling the bolt hole (a cut) never grows the
  // base plate's envelope beyond the raw slab.
  let slab = move-z(thick() / (2 / 1), box(plate-len(), plate-wid(), thick())) in
  if v3-eq(aabbr-size(bounding-box(base-plate())), aabbr-size(bounding-box(slab))) then
    unit
  else
    trap("the bolt hole must not grow the base plate")

/// The render entry: lower the assembly for the mesh driver. (A parametric version — dimensions as @params —
/// is a natural follow-up; this pins the assembly-as-code pattern first.)
def main() = lower(l-bracket())

export { base-plate, arm-flat, gusset, standing-arm, l-bracket, main }
