/// solid.cdz — the Cadenza CAD model layer: a recursive `Solid` CSG tree (the port of camshaft/rsolid's
/// operation-tree) built entirely from Cadenza data — a sum over parameter payloads. This is increment G1
/// of DESIGN-cad-solid-modeling.md and needs ZERO compiler/runtime change: a CSG model is *just Cadenza
/// data* (sums + recursion + floats), which is exactly what the language is for. A mesh backend (manifold)
/// and a render surface are per-surface DRIVERS that consume this tree AS DATA — not part of this library.
///
/// FINDING (reported to the vertical, not worked around): the ML surface does NOT parse a named record
/// type (`type Vec3 = { x: Float64, … }`) nor an inline record type in a variant payload
/// (`Cube({ size: Vec3 })`) — both raise `expected a name`/`expected ','` at the `{`. So the nominal
/// product types the design sketches as records (`Vec3`, and each primitive's parameter record) are modeled
/// here as SINGLE-VARIANT SUMS (`type Vec3 = | V3(Float64, Float64, Float64)`), the idiomatic port shape the
/// compiler-ml modules already use (parse.cdz's `Expr`, validate.cdz's `Report`). Structural records
/// (`{ x = … }`) DO parse and run; only their *type declaration* / variant-position annotation is missing.

/// A 3-D vector / point — the nominal product `(x, y, z)` all geometry is built from (positions, sizes,
/// rotations-in-degrees, scale factors). A single-variant sum standing in for a record (see the file
/// finding). All coordinates are `Float64` (meshes are float; matches manifold — DESIGN §6).
type Vec3 =
  | V3(Float64, Float64, Float64)

/// The CSG operation tree — the whole model DSL. Leaves are PRIMITIVES (a shape + its parameters); interior
/// nodes are the boolean OPERATIONS over child solids (recursion) and the affine TRANSFORMS wrapping a
/// child. `Empty` is the identity of `union` / the absorbing element of `intersection` — it lets the n-ary
/// combinators fold over a list with a clean base case (rsolid has no explicit empty; Cadenza's total
/// `match` wants one, and it makes `union-all []` well-defined). This is rsolid's `Object`/`Operator` split.
type Solid =
  // leaves — primitives (parameters carried positionally; a record would read nicer but does not parse)
  | Empty
  | Cube(Vec3)               // an axis-aligned box with the given size (width, depth, height)
  | Sphere(Float64)          // a sphere of the given radius, centered at the origin
  | Cylinder(Float64, Float64) // a cylinder: (height, radius), centered on the origin along +z
  // nodes — boolean operations over child solids (the recursion)
  | Union(Solid, Solid)
  | Difference(Solid, Solid)
  | Intersection(Solid, Solid)
  // nodes — affine transforms wrapping a child solid
  | Translate(Vec3, Solid)   // shift the child by the vector
  | Rotate(Vec3, Solid)      // rotate the child by (x, y, z) degrees
  | Scale(Vec3, Solid)       // scale the child per-axis

/// ---- Vec3 constructors + accessors --------------------------------------------------------------

/// Build a vector from three coordinates — the everyday constructor (`v3 1.0 2.0 3.0`).
def v3(x: Float64, y: Float64, z: Float64) = Vec3.V3(x, y, z)

/// The origin / zero vector — the identity of translation and a sensible default position.
def v3-zero() = Vec3.V3(0.0, 0.0, 0.0)

/// A uniform vector (all three components equal) — handy for a uniform `scale s` or a cube of side `s`.
def v3-splat(s: Float64) = Vec3.V3(s, s, s)

def vx(v: Vec3) = match v with | Vec3.V3(x, _, _) => x
def vy(v: Vec3) = match v with | Vec3.V3(_, y, _) => y
def vz(v: Vec3) = match v with | Vec3.V3(_, _, z) => z

/// Component-wise vector addition — the core of composing translations.
def v3-add(a: Vec3, b: Vec3) = Vec3.V3(vx(a) + vx(b), vy(a) + vy(b), vz(a) + vz(b))

/// Component-wise vector multiplication — the core of composing scales.
def v3-mul(a: Vec3, b: Vec3) = Vec3.V3(vx(a) * vx(b), vy(a) * vy(b), vz(a) * vz(b))

/// Exact structural vector equality — direct value `==` (two Vec3s are equal iff their components are).
/// (Historically this was a verbose single-`match` destructure to work around an unimplemented runtime
/// compound-float-`==`; that landed on trunk — `e6017d04b`, "admit Ty::Float in ty_heap_walkable" — so
/// whole-value `a == b` over a float-leaf compound now works, and this reduces to the obvious one-liner.)
def v3-eq(a: Vec3, b: Vec3) = a == b

/// ---- Primitive constructors ---------------------------------------------------------------------

/// An axis-aligned box of size (w, d, h). `cube 2.0 2.0 2.0` is a 2-unit cube.
def cube(w: Float64, d: Float64, h: Float64) = Solid.Cube(Vec3.V3(w, d, h))

/// A cube with all sides equal to `s`.
def cube-uniform(s: Float64) = Solid.Cube(v3-splat(s))

/// A sphere of radius `r`, centered at the origin.
def sphere(r: Float64) = Solid.Sphere(r)

/// A cylinder of height `h` and radius `r`, centered on the origin along +z.
def cylinder(h: Float64, r: Float64) = Solid.Cylinder(h, r)

/// The empty solid — the identity of `union`, the absorbing element of `intersection`.
def empty() = Solid.Empty

/// ---- Boolean combinators (binary + n-ary) -------------------------------------------------------

/// The three binary boolean ops — the interior nodes of the CSG tree.
def union(a: Solid, b: Solid) = Solid.Union(a, b)
def difference(a: Solid, b: Solid) = Solid.Difference(a, b)
def intersection(a: Solid, b: Solid) = Solid.Intersection(a, b)

/// n-ary union over a LIST of solids — the recursive `fold` shape a real model uses (a bracket = a union
/// over a list of ribs). Empty list folds to `Empty` (union's identity), so `union-all []` = the empty
/// solid and `union-all [s]` = `Union(s, Empty)` ≡ `s`.
def union-all(xs: List(Solid)) = match xs with
  | [] => Solid.Empty
  | [h, .. t] => Solid.Union(h, union-all(t))

/// n-ary intersection over a list — folds to `Empty` on the empty list (a degenerate model with nothing to
/// intersect is empty), else intersects the head with the intersection of the rest.
def intersection-all(xs: List(Solid)) = match xs with
  | [] => Solid.Empty
  | [h, .. t] => (match t with
    | [] => h
    | [_, .. _] => Solid.Intersection(h, intersection-all(t)))

/// Difference of a base with a LIST of tools to subtract — `difference-all base [hole1, hole2, …]` cuts
/// each tool from the base in turn (the plate-with-holes idiom). Empty tool list = the base unchanged.
def difference-all(base: Solid, tools: List(Solid)) = match tools with
  | [] => base
  | [h, .. t] => difference-all(Solid.Difference(base, h), t)

/// ---- Transform combinators ----------------------------------------------------------------------

/// Translate a child solid by a vector.
def translate(by: Vec3, of: Solid) = Solid.Translate(by, of)

/// Rotate a child solid by (x, y, z) degrees.
def rotate(deg: Vec3, of: Solid) = Solid.Rotate(deg, of)

/// Scale a child solid per-axis.
def scale(by: Vec3, of: Solid) = Solid.Scale(by, of)

/// ---- Analyses (folds over the tree — prove recursion runs end-to-end) ---------------------------

/// The number of nodes in the CSG tree — the node itself plus every descendant. The archetypal recursive
/// traversal; a driver walking the tree to mesh it follows exactly this shape.
def count-nodes(s: Solid) = match s with
  | Solid.Empty => 1
  | Solid.Cube(_) => 1
  | Solid.Sphere(_) => 1
  | Solid.Cylinder(_, _) => 1
  | Solid.Union(a, b) => 1 + count-nodes(a) + count-nodes(b)
  | Solid.Difference(a, b) => 1 + count-nodes(a) + count-nodes(b)
  | Solid.Intersection(a, b) => 1 + count-nodes(a) + count-nodes(b)
  | Solid.Translate(_, of) => 1 + count-nodes(of)
  | Solid.Rotate(_, of) => 1 + count-nodes(of)
  | Solid.Scale(_, of) => 1 + count-nodes(of)

/// The number of PRIMITIVE leaves (Cube/Sphere/Cylinder) — the count of actual geometry the mesh backend
/// will emit. `Empty` is not counted (it contributes no geometry); transforms/booleans are structure.
def leaf-count(s: Solid) = match s with
  | Solid.Empty => 0
  | Solid.Cube(_) => 1
  | Solid.Sphere(_) => 1
  | Solid.Cylinder(_, _) => 1
  | Solid.Union(a, b) => leaf-count(a) + leaf-count(b)
  | Solid.Difference(a, b) => leaf-count(a) + leaf-count(b)
  | Solid.Intersection(a, b) => leaf-count(a) + leaf-count(b)
  | Solid.Translate(_, of) => leaf-count(of)
  | Solid.Rotate(_, of) => leaf-count(of)
  | Solid.Scale(_, of) => leaf-count(of)

/// The maximum nesting DEPTH of the tree (a leaf is depth 1). Bounds a driver's recursion/stack.
def depth(s: Solid) = match s with
  | Solid.Empty => 1
  | Solid.Cube(_) => 1
  | Solid.Sphere(_) => 1
  | Solid.Cylinder(_, _) => 1
  | Solid.Union(a, b) => 1 + fmax-int(depth(a), depth(b))
  | Solid.Difference(a, b) => 1 + fmax-int(depth(a), depth(b))
  | Solid.Intersection(a, b) => 1 + fmax-int(depth(a), depth(b))
  | Solid.Translate(_, of) => 1 + depth(of)
  | Solid.Rotate(_, of) => 1 + depth(of)
  | Solid.Scale(_, of) => 1 + depth(of)

/// Whether the tree contains ANY real geometry (a primitive leaf) — `false` for `Empty` and for trees built
/// only from `Empty` (e.g. `union Empty Empty`). A driver can short-circuit an empty model.
def is-empty(s: Solid) = leaf-count(s) == 0

def fmax-int(a: Int64, b: Int64) = if a > b then a else b

/// ---- simplify: an Empty-absorbing normalization (a real driver pass) ----------------------------
/// Rebuild the tree bottom-up, absorbing the `Empty` identity so a mesh backend never evaluates a boolean
/// against nothing. This is the archetypal recursive tree-REWRITE (returns a `Solid`, unlike the folds that
/// return a scalar) — a mesh driver runs exactly this before meshing. The algebraic identities:
///   • `union Empty x` = `union x Empty` = `x`     (Empty is union's identity)
///   • `intersection Empty x` = `intersection x Empty` = `Empty`  (Empty absorbs intersection)
///   • `difference Empty x` = `Empty`;  `difference x Empty` = `x` (subtracting nothing is a no-op)
///   • `translate/rotate/scale _ Empty` = `Empty`  (transforming nothing is nothing)
/// Leaves and a genuinely non-empty node are rebuilt unchanged. `simplify` is idempotent (a second pass is a
/// no-op — pinned in the suite) and never adds geometry (`leaf-count (simplify s) <= leaf-count s`).
def simplify(s: Solid) = match s with
  | Solid.Empty => Solid.Empty
  | Solid.Cube(v) => Solid.Cube(v)
  | Solid.Sphere(r) => Solid.Sphere(r)
  | Solid.Cylinder(h, r) => Solid.Cylinder(h, r)
  | Solid.Union(a, b) =>
    let sa = simplify(a) in
    let sb = simplify(b) in
    (if is-empty(sa) then sb else (if is-empty(sb) then sa else Solid.Union(sa, sb)))
  | Solid.Intersection(a, b) =>
    let sa = simplify(a) in
    let sb = simplify(b) in
    (if is-empty(sa) then Solid.Empty else (if is-empty(sb) then Solid.Empty else Solid.Intersection(sa, sb)))
  | Solid.Difference(a, b) =>
    let sa = simplify(a) in
    let sb = simplify(b) in
    (if is-empty(sa) then Solid.Empty else (if is-empty(sb) then sa else Solid.Difference(sa, sb)))
  | Solid.Translate(by, of) =>
    let so = simplify(of) in
    (if is-empty(so) then Solid.Empty else Solid.Translate(by, so))
  | Solid.Rotate(deg, of) =>
    let so = simplify(of) in
    (if is-empty(so) then Solid.Empty else Solid.Rotate(deg, so))
  | Solid.Scale(by, of) =>
    let so = simplify(of) in
    (if is-empty(so) then Solid.Empty else Solid.Scale(by, so))

/// ============================ @test suite (gate coverage for G1) ============================
/// These pin the model's invariants: constructors build the right shape, the folds count correctly, the
/// n-ary combinators fold with the right identities, and recursion runs end-to-end under wasmtime. A future
/// change that regresses the model flips one of these red (they are wired into `cargo xtask check`).

// NOTE: these vec3 tests compare via `v3-eq` (a single-`match` destructure of each operand) rather than
// `vx(v) == … and vy(v) == …`, because re-projecting the same compound binding twice before a FLOAT compare
// trips a backend bug (see `v3-eq`'s note + the filed reproducer). This is the very stress test the vertical
// is here to run: G1 found a real compiler bug and reports it instead of papering over it.

@test
def vec3-accessors() =
  if v3-eq(v3(1.0, 2.0, 3.0), Vec3.V3(1.0, 2.0, 3.0)) then unit else trap("v3 builds the given components")

@test
def vec3-splat-is-uniform() =
  if v3-eq(v3-splat(5.0), v3(5.0, 5.0, 5.0)) then unit else trap("splat is uniform")

@test
def vec3-add-componentwise() =
  if v3-eq(v3-add(v3(1.0, 2.0, 3.0), v3(10.0, 20.0, 30.0)), v3(11.0, 22.0, 33.0)) then unit
  else trap("v3-add is component-wise")

@test
def vec3-mul-componentwise() =
  if v3-eq(v3-mul(v3(2.0, 3.0, 4.0), v3(5.0, 5.0, 5.0)), v3(10.0, 15.0, 20.0)) then unit
  else trap("v3-mul is component-wise")

@test
def vec3-eq-rejects-a-difference() =
  if v3-eq(v3(1.0, 2.0, 3.0), v3(1.0, 9.0, 3.0)) then trap("differing vectors must not be equal") else unit

@test
def vec3-zero-is-origin() =
  if v3-eq(v3-zero(), v3(0.0, 0.0, 0.0)) then unit else trap("zero is the origin")

@test
def single-primitive-is-one-node() =
  if count-nodes(sphere(2.0)) == 1 then unit else trap("a sphere is one node")

@test
def empty-is-one-node-no-geometry() =
  if count-nodes(empty()) == 1 then
    (if leaf-count(empty()) == 0 then (if is-empty(empty()) then unit else trap("empty is empty")) else trap("empty has no leaves"))
  else trap("empty counts as one node")

@test
def union-of-two-cubes-counts-three() =
  let t = union(cube(1.0, 1.0, 1.0), cube(2.0, 2.0, 2.0)) in
  if count-nodes(t) == 3 then (if leaf-count(t) == 2 then unit else trap("2 leaves")) else trap("3 nodes")

@test
def nested-transform-counts-nodes() =
  // translate (union (cube) (sphere)) — 1 translate + 1 union + 2 leaves = 4 nodes
  let t = translate(v3(0.0, 0.0, 1.0), union(cube-uniform(2.0), sphere(1.0))) in
  if count-nodes(t) == 4 then (if leaf-count(t) == 2 then unit else trap("2 leaves")) else trap("4 nodes")

@test
def union-all-empty-is-empty() =
  if is-empty(union-all([])) then unit else trap("union-all [] is empty")

@test
def union-all-folds-over-list() =
  // three cubes: union-all builds Union(c, Union(c, Union(c, Empty))) → 3 leaves, 7 nodes total
  let t = union-all([cube-uniform(1.0), cube-uniform(2.0), cube-uniform(3.0)]) in
  if leaf-count(t) == 3 then (if count-nodes(t) == 7 then unit else trap("7 nodes")) else trap("3 leaves")

@test
def difference-all-cuts-each-tool() =
  // a plate with two holes: difference-all base [hole1, hole2] → 3 leaves (base + 2 holes)
  let plate = difference-all(cube(10.0, 10.0, 1.0), [cylinder(1.0, 0.5), cylinder(1.0, 0.5)]) in
  if leaf-count(plate) == 3 then unit else trap("plate + 2 holes = 3 leaves")

@test
def intersection-all-single-is-identity() =
  // intersection-all [s] should just be s (no wrapping Intersection node)
  let t = intersection-all([sphere(1.0)]) in
  if count-nodes(t) == 1 then unit else trap("intersection-all [s] is s")

@test
def intersection-all-two-elements() =
  let t = intersection-all([cube-uniform(2.0), sphere(1.5)]) in
  if count-nodes(t) == 3 then (if leaf-count(t) == 2 then unit else trap("2 leaves")) else trap("3 nodes")

@test
def depth-of-a-left-spine() =
  // union-all of 3 → Union(a, Union(b, Union(c, Empty))): depth 4 (3 unions deep + the Empty leaf)
  let t = union-all([cube-uniform(1.0), cube-uniform(1.0), cube-uniform(1.0)]) in
  if depth(t) == 4 then unit else trap("left spine depth 4")

@test
def transforms-preserve-leaf-count() =
  // wrapping in translate/rotate/scale changes node-count but not leaf-count
  let base = union(cube-uniform(1.0), sphere(1.0)) in
  let wrapped = translate(v3(1.0, 0.0, 0.0), rotate(v3(0.0, 0.0, 90.0), scale(v3-splat(2.0), base))) in
  if leaf-count(wrapped) == 2 then (if count-nodes(wrapped) == 6 then unit else trap("3 transforms + union + 2 leaves = 6")) else trap("2 leaves")

@test
def simplify-absorbs-empty-in-union() =
  // union(Empty, cube) simplifies to just the cube — 1 node, no wrapping Union
  let t = union(empty(), cube-uniform(1.0)) in
  let s = simplify(t) in
  if count-nodes(s) == 1 then (if leaf-count(s) == 1 then unit else trap("1 leaf")) else trap("union(Empty, x) simplifies to x")

@test
def simplify-absorbs-empty-in-union-rhs() =
  let s = simplify(union(cube-uniform(1.0), empty())) in
  if count-nodes(s) == 1 then unit else trap("union(x, Empty) simplifies to x")

@test
def simplify-intersection-with-empty-is-empty() =
  // intersecting with nothing yields nothing
  let s = simplify(intersection(cube-uniform(1.0), empty())) in
  if is-empty(s) then unit else trap("intersection(x, Empty) is Empty")

@test
def simplify-difference-subtracting-empty-is-noop() =
  // subtracting nothing leaves the base
  let s = simplify(difference(cube-uniform(1.0), empty())) in
  if count-nodes(s) == 1 then (if leaf-count(s) == 1 then unit else trap("1 leaf")) else trap("difference(x, Empty) is x")

@test
def simplify-transform-of-empty-is-empty() =
  // translating/rotating/scaling nothing is nothing
  let s = simplify(translate(v3(1.0, 2.0, 3.0), empty())) in
  if is-empty(s) then unit else trap("translate(_, Empty) is Empty")

@test
def simplify-prunes-a-nested-empty-branch() =
  // union(cube, translate(_, Empty)) → the translate branch prunes to Empty, absorbed → just the cube
  let t = union(cube-uniform(1.0), translate(v3-zero(), empty())) in
  let s = simplify(t) in
  if count-nodes(s) == 1 then (if leaf-count(s) == 1 then unit else trap("1 leaf")) else trap("nested empty branch pruned")

@test
def simplify-preserves-a-fully-real-tree() =
  // no Empty anywhere: simplify is structure-preserving (same node + leaf count)
  let t = union(cube-uniform(1.0), translate(v3(0.0, 0.0, 1.0), sphere(1.0))) in
  let s = simplify(t) in
  if count-nodes(s) == 4 then (if leaf-count(s) == 2 then unit else trap("2 leaves")) else trap("real tree preserved (4 nodes)")

@test
def simplify-is-idempotent() =
  // simplify (simplify t) == simplify t in node count — a second pass changes nothing
  let t = union(empty(), union(cube-uniform(1.0), translate(v3-zero(), empty()))) in
  let once = simplify(t) in
  let twice = simplify(simplify(t)) in
  if count-nodes(once) == count-nodes(twice) then unit else trap("simplify is idempotent")

@test
def simplify-never-adds-geometry() =
  // leaf-count (simplify s) <= leaf-count s, always
  let t = union(empty(), intersection(cube-uniform(1.0), empty())) in
  let s = simplify(t) in
  if leaf-count(s) == 0 then unit else trap("simplify of an all-empty tree has no geometry")

@test
def simplify-prunes-a-deep-all-empty-tree() =
  // a transform over a union of empties (one built from a difference of empties) fully prunes to Empty —
  // the recursion must collapse every level, not just the top.
  let t = translate(v3(1.0, 2.0, 3.0), union(empty(), difference(empty(), empty()))) in
  if is-empty(simplify(t)) then unit else trap("a deep all-empty tree prunes to empty")

@test
def simplify-difference-with-empty-base-is-empty() =
  // subtracting from nothing is nothing: difference(Empty, x) simplifies to Empty (x is irrelevant).
  if is-empty(simplify(difference(empty(), cube-uniform(1.0)))) then unit
  else trap("difference(Empty, x) simplifies to Empty")

@test
def difference-all-empty-tools-leaves-base() =
  // difference-all base [] cuts nothing → the base unchanged (1 leaf).
  if leaf-count(difference-all(cube-uniform(1.0), [])) == 1 then unit
  else trap("difference-all base [] = base")

@test
def simplify-union-all-single-reduces-to-the-element() =
  // union-all [s] builds Union(s, Empty); simplify absorbs the Empty → just s (a 1-node tree).
  let s = simplify(union-all([sphere(1.0)])) in
  if count-nodes(s) == 1 then unit else trap("union-all [s] simplifies to the element")

export { Solid.*, Vec3.*, v3, v3-zero, v3-splat, vx, vy, vz, v3-add, v3-mul, v3-eq,
         cube, cube-uniform, sphere, cylinder, empty,
         union, difference, intersection, union-all, intersection-all, difference-all,
         translate, rotate, scale,
         count-nodes, leaf-count, depth, is-empty, simplify }
