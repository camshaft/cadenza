/// exact.cdz — the EXACT-arithmetic geometry foundation for Cadenza CAD (R1 of the Rational/Qty redirect,
/// operator-directed 2026-07-16). CAD geometry should be built on `Rational` (exact, no float rounding) —
/// "a big motivator for adding Rationals to the language" — so coordinates, sizes, and the bounding-box math
/// are exact. This module is the proof + foundation: an exact `Vec3(Rational)` (Rational components) with the min/max
/// and a recursive `bounding-box` fold over a CSG tree.
///
/// 🔑 WHY THIS UNBLOCKS `bounding-box`: the fold needs `<`/`>` (min/max) over coordinates. Over `Float64`
/// that DECLINED (runtime scalar float ORDERING is unimplemented, pending the operator's IEEE-totalOrder
/// ruling — see the vertical log). `Rational` has a TOTAL ORDER (exact), so the identical recursive fold
/// COMPILES + RUNS. Exact CAD isn't just nicer — it's what makes the extent analysis expressible today.
///
/// This is R1: a self-contained exact-geometry module + its `Solid(Rational)` CSG sum, gated by @test. R2 folds the
/// main `Solid(Rational)`/`Vec3(Rational)` model (currently Float64) onto this exact basis + `Qty` dimensioned lengths
/// (coordinating with v-quantity on the Qty surface); the native/browser mesh drivers then convert Rational
/// → f64 only at the manifold leaf, keeping the model tree exact.
///
/// NUMERIC MODE (S1-redux, finale): `@!default-fraction Rational` — the exact-geometry BASE is exact-by-
/// default, so a bare `n/d` is an exact Rational (no `Rational.of` noise). This module has no imports (it IS
/// the base everyone imports); the pragma is module-local, so importers keep their own defaults.
@!default-fraction Rational

/// A 3-D vector, GENERIC over its component type `a` (the "parameterize over the unit" shape — operator
/// directive + concierge B-via-generic ruling). Instantiated as `Vec3(Rational)` of `Qty[meter]` for units-carrying
/// geometry (the authored model, where a coordinate IS a length), of `Qty[radian]` for angles, and of bare
/// `Rational` at the render edge (unwrapped meters the mesh driver parses — f64 only at the FFI edge). The
/// bounding-box / min-max helpers below specialize to whatever `a` supports order + arithmetic (Rational
/// and Qty both do). Stage 1 of the Vec3(Rational)→Qty retype: the type is generic; callers still build over Rational
/// until the Qty[meter] model layer (stage 2) + render-edge unwrap land.
type Vec3 =
  | V3(a, a, a)

/// The exact CSG tree — the FULL model: primitives (Empty/Cube/Sphere/Cylinder), the three booleans,
/// and the affine transforms that stay exact over Rational (Translate, per-axis Scale). NOTE: no `Rotate` —
/// a general rotation needs sin/cos, which have no exact Rational form; rotation, if needed, is applied by
/// the mesh driver at the f64 manifold leaf, keeping the model tree exact. (There is no longer a separate
/// Float64 model — the legacy float `solid.cdz` was deleted; exact Rational/Qty is the ONLY surface.)
///
/// The CSG tree, GENERIC over its coordinate type `a` (stage 2 of Vec3→Qty, B-via-generic). Instantiated
/// as `Solid(Qty[meter])` for the authored model (a coordinate IS a length — units end-to-end) and, via a
/// `lower` map that unwraps each coordinate, as `Solid(Rational)` at the render edge the mesh driver parses
/// (f64 only at the FFI edge). This stage is a PURE GENERALIZATION: all usage stays `Solid(Rational)`, so
/// behavior + render grammar are unchanged; it unlocks the `Solid(Qty[meter])` model instantiation (stage 3).
type Solid =
  | Empty                        // the identity of union / absorbing element of intersection
  | Cube(Vec3(a))                // an axis-aligned box of FULL size (w, d, h) centred at origin (like Cube)
  | Sphere(a)                    // a sphere of the given radius, centred at the origin
  | Cylinder(a, a)               // a cylinder (FULL height, radius), centred on the origin along +z
  | Union(Solid(a), Solid(a))
  | Difference(Solid(a), Solid(a))
  | Intersection(Solid(a), Solid(a))
  | Translate(Vec3(a), Solid(a))
  | Scale(Vec3(a), Solid(a))     // per-axis exact scale (Rational factors)

/// An exact axis-aligned bounding box: the min and max corners (both `Vec3(Rational)`).
type Aabb =
  | Box(Vec3(Rational), Vec3(Rational))

/// Exact scalar min/max — total order over `Rational`, the operations the float model could not perform.
def rmin(a: Rational, b: Rational) = if a < b then a else b
def rmax(a: Rational, b: Rational) = if a > b then a else b

/// The Rational zero — a common corner/identity value.
def rzero() = 0 / 1

/// Exact half of a Rational (÷2 is exact). Used to turn a FULL cube/cylinder dimension into a half-extent.
def rhalf(x: Rational) = x / 2

/// Build an exact vector.
def v3r(x: Rational, y: Rational, z: Rational) = Vec3.V3(x, y, z)

def v3r-x(v: Vec3(Rational)) = match v with | Vec3.V3(x, _, _) => x
def v3r-y(v: Vec3(Rational)) = match v with | Vec3.V3(_, y, _) => y
def v3r-z(v: Vec3(Rational)) = match v with | Vec3.V3(_, _, z) => z

/// Component-wise exact vector addition (composing translations).
def v3r-add(a: Vec3(Rational), b: Vec3(Rational)) =
  match a with | Vec3.V3(ax, ay, az) =>
    (match b with | Vec3.V3(bx, by, bz) =>
      Vec3.V3(ax + bx, ay + by, az + bz))

/// Component-wise exact min / max.
def v3r-min(a: Vec3(Rational), b: Vec3(Rational)) =
  match a with | Vec3.V3(ax, ay, az) =>
    (match b with | Vec3.V3(bx, by, bz) =>
      Vec3.V3(rmin(ax, bx), rmin(ay, by), rmin(az, bz)))
def v3r-max(a: Vec3(Rational), b: Vec3(Rational)) =
  match a with | Vec3.V3(ax, ay, az) =>
    (match b with | Vec3.V3(bx, by, bz) =>
      Vec3.V3(rmax(ax, bx), rmax(ay, by), rmax(az, bz)))

/// Exact vector equality — a direct whole-compound `==`. The `ty_heap_walkable` heap-walk now admits
/// `Ty::Rational` (and `Ty::BigInt`) leaves — both are canonical by construction (a Rational is a normalized
/// two-BigInt-handle node), so `champ_eq` walks a `Vec3(Rational)` of Rationals EXACTLY, INCLUDING normalization
/// (`1/2 == 2/4` → true). This replaced the earlier component-wise workaround (which existed only because the
/// walk once covered `Ty::Float` but not `Ty::Rational`); `v3r-eq-is-a-direct-compound-walk` pins the invariant.
def v3r-eq(a: Vec3(Rational), b: Vec3(Rational)) = a == b

/// The union of two exact boxes — the enclosing box (min of the mins, max of the maxes).
def aabbr-union(p: Aabb, q: Aabb) =
  match p with | Aabb.Box(plo, phi) =>
    (match q with | Aabb.Box(qlo, qhi) =>
      Aabb.Box(v3r-min(plo, qlo), v3r-max(phi, qhi)))

/// The box of an INTERSECTION — the overlap of the two boxes (max of the mins, min of the maxes). The
/// result may be "inverted" (lo > hi) if the boxes don't overlap; that denotes an empty intersection, which
/// a mesh driver treats as no geometry. Exact.
def aabbr-intersect(p: Aabb, q: Aabb) =
  match p with | Aabb.Box(plo, phi) =>
    (match q with | Aabb.Box(qlo, qhi) =>
      Aabb.Box(v3r-max(plo, qlo), v3r-min(phi, qhi)))

/// Component-wise exact vector multiply (for per-axis scale).
def v3r-mul(a: Vec3(Rational), b: Vec3(Rational)) =
  match a with | Vec3.V3(ax, ay, az) =>
    (match b with | Vec3.V3(bx, by, bz) =>
      Vec3.V3(ax * bx, ay * by, az * bz))

/// A degenerate zero box at the origin — the bound of an empty solid (no geometry).
def aabbr-empty() = Aabb.Box(v3r(rzero(), rzero(), rzero()), v3r(rzero(), rzero(), rzero()))

/// Build a WELL-FORMED box from two corners, component-wise (lo = min, hi = max). This is the guard against an
/// INVERTED box: a primitive built from `±half-extent` corners, or a scaled/mirrored one, can have its nominal
/// "lo" corner land ABOVE "hi" on an axis when a dimension/factor is NEGATIVE — which would make `aabbr-size`
/// go negative and break the min/max-based union/intersect. Normalizing here keeps the box valid for any sign.
def aabbr-of-corners(p: Vec3(Rational), q: Vec3(Rational)) = Aabb.Box(v3r-min(p, q), v3r-max(p, q))

/// The EXACT axis-aligned bounding box of an exact CSG tree — the recursive fold that was BLOCKED over
/// Float64 (it needs `<`/`>` per node) and is expressible here because Rational has a total order. A cube
/// A `Cube(w,d,h)` is the FULL size (matching `solid.cdz`'s `Cube`), centred at the origin → it spans
/// [-w/2, w/2]×[-d/2, d/2]×[-h/2, h/2]. A `Cylinder(height, radius)` is the FULL height + radius →
/// [-r, r]×[-r, r]×[-height/2, height/2] (radius IS a half-diameter, so it's not halved). A sphere of radius
/// r spans [-r, r]³. A union encloses both children; a translate shifts both corners; a scale multiplies them
/// (re-normalized to stay well-formed under a NEGATIVE/mirror factor — see the `Scale` arm).
def bounding-box(s: Solid(Rational)) = match s with
  | Solid.Empty => aabbr-empty()
  // Each primitive builds its box from ±half-extent corners, normalized via `aabbr-of-corners` so a NEGATIVE
  // dimension/radius yields a well-formed box (absolute extent) rather than an inverted one.
  | Solid.Cube(sz) =>
    (match sz with | Vec3.V3(w, d, h) =>
      aabbr-of-corners(Vec3.V3(rzero() - rhalf(w), rzero() - rhalf(d), rzero() - rhalf(h)),
                       Vec3.V3(rhalf(w), rhalf(d), rhalf(h))))
  | Solid.Sphere(r) =>
    aabbr-of-corners(Vec3.V3(rzero() - r, rzero() - r, rzero() - r), Vec3.V3(r, r, r))
  | Solid.Cylinder(height, r) =>
    aabbr-of-corners(Vec3.V3(rzero() - r, rzero() - r, rzero() - rhalf(height)),
                     Vec3.V3(r, r, rhalf(height)))
  | Solid.Union(a, b) => aabbr-union(bounding-box(a), bounding-box(b))
  // subtracting a tool never grows the base → the base's box bounds the difference.
  | Solid.Difference(a, _) => bounding-box(a)
  | Solid.Intersection(a, b) => aabbr-intersect(bounding-box(a), bounding-box(b))
  | Solid.Translate(by, of) =>
    (match bounding-box(of) with
      | Aabb.Box(lo, hi) => Aabb.Box(v3r-add(lo, by), v3r-add(hi, by)))
  | Solid.Scale(by, of) =>
    (match bounding-box(of) with
      // A NEGATIVE scale factor (a mirror) flips a corner past the other on that axis, so the scaled corners can
      // be inverted — `aabbr-of-corners` re-normalizes them (identity for a positive factor). Same guard the
      // primitives use.
      | Aabb.Box(lo, hi) => aabbr-of-corners(v3r-mul(lo, by), v3r-mul(hi, by)))

/// The exact size (max − min) of a bounding box — the "how big" answer, exact.
def aabbr-size(b: Aabb) =
  match b with | Aabb.Box(lo, hi) =>
    (match lo with | Vec3.V3(lx, ly, lz) =>
      (match hi with | Vec3.V3(hx, hy, hz) =>
        Vec3.V3(hx - lx, hy - ly, hz - lz)))

/// Is this exact solid the empty node? A direct top-node test (NOT a full leaf-count) — `simplify-r` collapses
/// dead branches to `Empty`, so an `Empty` at a node is the signal an algebraic identity fires.
def solidr-is-empty(s: Solid(Rational)) = match s with
  | Solid.Empty => true
  | _ => false

/// Simplify an exact CSG tree by the empty-solid algebraic identities — the exact-model twin of `simplify`
/// (solid.cdz's Float64 version). A mesh driver runs this before meshing to prune dead branches:
///   • `Union Empty x` = `Union x Empty` = `x`          (Empty is union's identity)
///   • `Intersection Empty x` = `Intersection x Empty` = `Empty`  (Empty absorbs intersection)
///   • `Difference Empty x` = `Empty`; `Difference x Empty` = `x`  (subtracting nothing is a no-op)
///   • `Translate/Scale _ Empty` = `Empty`               (transforming nothing is nothing)
/// Leaves and genuinely-non-empty nodes rebuild unchanged. Idempotent (a second pass is a no-op) and never
/// adds geometry. NOTE: no `Rotater` in the exact model (rotation is an f64 mesh-leaf concern), so no rotate arm.
def simplify-r(s: Solid(Rational)) = match s with
  | Solid.Empty => Solid.Empty
  | Solid.Cube(v) => Solid.Cube(v)
  | Solid.Sphere(r) => Solid.Sphere(r)
  | Solid.Cylinder(h, r) => Solid.Cylinder(h, r)
  | Solid.Union(a, b) =>
    let sa = simplify-r(a) in
    let sb = simplify-r(b) in
    (if solidr-is-empty(sa) then sb else (if solidr-is-empty(sb) then sa else Solid.Union(sa, sb)))
  | Solid.Difference(a, b) =>
    let sa = simplify-r(a) in
    let sb = simplify-r(b) in
    (if solidr-is-empty(sa) then Solid.Empty else (if solidr-is-empty(sb) then sa else Solid.Difference(sa, sb)))
  | Solid.Intersection(a, b) =>
    let sa = simplify-r(a) in
    let sb = simplify-r(b) in
    (if solidr-is-empty(sa) then Solid.Empty else (if solidr-is-empty(sb) then Solid.Empty else Solid.Intersection(sa, sb)))
  | Solid.Translate(by, of) =>
    let so = simplify-r(of) in
    (if solidr-is-empty(so) then Solid.Empty else Solid.Translate(by, so))
  | Solid.Scale(by, of) =>
    let so = simplify-r(of) in
    (if solidr-is-empty(so) then Solid.Empty else Solid.Scale(by, so))

/// ============================ @test suite (R1 exact-geometry proof) ============================

@test
def rmin-rmax-exact() =
  let third = 1 / 3 in
  let half = 1 / 2 in
  if rmin(third, half) == third then (if rmax(third, half) == half then unit else trap("rmax")) else trap("rmin")

@test
def v3r-eq-is-a-direct-compound-walk() =
  // PINS the ty_heap_walkable Rational admission that lets v3r-eq be a direct `a == b`: a whole-Vec3(Rational) `==`
  // over Rational leaves must WALK (compile + run), incl. exact normalization — 1/2 and 2/4 are the SAME
  // Rational, so the vectors are equal; a differing component makes them unequal. If a future change drops
  // Rational from the walk, v3r-eq would decline and this case fails — guarding the whole vertical's equality.
  let a = v3r(1 / 2, 1 / 3, 1 / 6) in
  let b = v3r(2 / 4, 1 / 3, 1 / 6) in   // 1/2 == 2/4 normalized
  let c = v3r(1 / 2, 1 / 3, 5 / 6) in   // z differs
  if v3r-eq(a, b) then (if v3r-eq(a, c) then trap("differing z must be unequal") else unit)
  else trap("whole-Vec3(Rational) == over Rational must walk (1/2 == 2/4 normalized)")

@test
def aabb-is-a-direct-compound-walk() =
  // Extend the ty_heap_walkable Rational-admission pin to the DEEPER `Aabb` compound (a nested pair of
  // Vec3(Rational)): a whole-`Aabb` `==` must walk two levels of nesting and normalize Rational leaves at
  // depth — a box with `1/2` and one with `2/4` on the same corner axis are the SAME box; a differing hi
  // corner makes them unequal. Deeper than v3r-eq (Aabb wraps two Vec3s), so it guards the walk at nesting > 1.
  let b1 = Aabb.Box(v3r(1 / 2, rzero(), rzero()), v3r(1 / 1, 1 / 1, 1 / 1)) in
  let b2 = Aabb.Box(v3r(2 / 4, rzero(), rzero()), v3r(1 / 1, 1 / 1, 1 / 1)) in   // 1/2 == 2/4 normalized
  let b3 = Aabb.Box(v3r(1 / 2, rzero(), rzero()), v3r(2 / 1, 1 / 1, 1 / 1)) in   // hi.x differs
  if (b1 == b2) then (if (b1 == b3) then trap("differing hi corner must be unequal") else unit)
  else trap("whole-Aabb == must walk the nested Vec3(Rational) pair, normalizing (1/2 == 2/4)")

@test
def solid-is-a-direct-compound-walk() =
  // The DEEPEST case: a whole `Solid(Rational)` `==` — a recursive sum of Rationals to a data-determined depth.
  // Two structurally-identical trees whose only difference is a NORMALIZED Rational leaf (5/2 vs 10/4) are
  // equal; a differing leaf value or a differing tree SHAPE makes them unequal. This pins that the heap walk
  // handles a recursive-sum-of-Rational at arbitrary depth (not just the flat Vec3/Aabb), the same admission
  // `lower`/render rely on — a future change that dropped Rational (or recursive sums) from the walk fails here.
  let s1 = Solid.Difference(Solid.Cube(v3r(4 / 1, 4 / 1, 4 / 1)), Solid.Sphere(5 / 2)) in
  let s2 = Solid.Difference(Solid.Cube(v3r(4 / 1, 4 / 1, 4 / 1)), Solid.Sphere(10 / 4)) in  // 5/2 == 10/4
  let s-leaf = Solid.Difference(Solid.Cube(v3r(4 / 1, 4 / 1, 4 / 1)), Solid.Sphere(3 / 1)) in  // radius differs
  let s-shape = Solid.Cube(v3r(4 / 1, 4 / 1, 4 / 1)) in  // different constructor/shape
  if (s1 == s2) then
    (if (s1 == s-leaf) then trap("differing sphere radius must be unequal")
     else (if (s1 == s-shape) then trap("differing tree shape must be unequal") else unit))
  else trap("whole-Solid(Rational) == must walk the recursive sum, normalizing (5/2 == 10/4)")

@test
def v3r-eq-and-add() =
  let a = v3r(1 / 2, 1 / 3, 1 / 6) in
  let b = v3r(1 / 2, 2 / 3, 5 / 6) in
  // 1/2+1/2=1, 1/3+2/3=1, 1/6+5/6=1  → (1,1,1) exactly
  let one = 1 / 1 in
  if v3r-eq(v3r-add(a, b), v3r(one, one, one)) then unit else trap("exact componentwise add")

@test
def bounding-box-of-a-cube-is-symmetric() =
  // a FULL-size-2 cube centred at origin spans [-1, 1] on each axis (half-extent 1).
  let two = 2 / 1 in
  let one = 1 / 1 in
  let b = bounding-box(Solid.Cube(v3r(two, two, two))) in
  match b with | Aabb.Box(lo, hi) =>
    (if v3r-eq(lo, v3r(rzero() - one, rzero() - one, rzero() - one)) then
      (if v3r-eq(hi, v3r(one, one, one)) then unit else trap("hi corner")) else trap("lo corner"))

@test
def bounding-box-of-a-union-encloses-both() =
  // a full-size-2 cube at origin (box [-1,1]) ∪ same translated +5 in x (box [4,6]) → x spans [-1, 6].
  let two = 2 / 1 in
  let five = 5 / 1 in
  let model = Solid.Union(
    Solid.Cube(v3r(two, two, two)),
    Solid.Translate(v3r(five, rzero(), rzero()), Solid.Cube(v3r(two, two, two)))) in
  match bounding-box(model) with | Aabb.Box(lo, hi) =>
    (if v3r-x(lo) == (rzero() - 1 / 1) then
      (if v3r-x(hi) == 6 / 1 then unit else trap("hi.x should be 6 exactly")) else trap("lo.x should be -1"))

@test
def bounding-box-size-is-exact() =
  // size of a translated sphere's box = 2r on each axis, exact (no float drift).
  let r = 3 / 2 in // radius 1.5, exact
  let b = bounding-box(Solid.Translate(v3r(10 / 1, rzero(), rzero()), Solid.Sphere(r))) in
  let sz = aabbr-size(b) in
  // 2 * 3/2 = 3 exactly on each axis
  if v3r-eq(sz, v3r(3 / 1, 3 / 1, 3 / 1)) then unit
  else trap("exact size 2r = 3 per axis")

@test
def exact_arithmetic_has_no_rounding() =
  // the showcase: 1/3 + 1/3 + 1/3 == 1 EXACTLY (a float would drift). Pin it as a Vec3(Rational) component.
  let third = 1 / 3 in
  if (third + third + third) == 1 / 1 then unit else trap("1/3+1/3+1/3 = 1 exactly")

@test
def empty-has-a-degenerate-box() =
  // an Empty solid bounds to a zero box at the origin.
  let b = bounding-box(Solid.Empty) in
  match b with | Aabb.Box(lo, hi) =>
    (if v3r-eq(lo, v3r(rzero(), rzero(), rzero())) then
      (if v3r-eq(hi, v3r(rzero(), rzero(), rzero())) then unit else trap("hi zero")) else trap("lo zero"))

@test
def cylinder-box-is-diameter-by-height() =
  // a cylinder (FULL height h, radius r) spans [-r,r]×[-r,r]×[-h/2,h/2] → size (2r, 2r, h), exact.
  let h = 5 / 1 in let r = 3 / 2 in
  let sz = aabbr-size(bounding-box(Solid.Cylinder(h, r))) in
  if v3r-eq(sz, v3r(3 / 1, 3 / 1, 5 / 1)) then unit
  else trap("cylinder box size (2r,2r,h) = (3,3,5) exact")

@test
def difference-is-bounded-by-the-base() =
  // subtracting a tool doesn't grow the base → the difference's box is the base's box.
  let one = 1 / 1 in
  let base = Solid.Cube(v3r(one, one, one)) in
  let d = Solid.Difference(base, Solid.Sphere(1 / 2)) in
  if v3r-eq(aabbr-size(bounding-box(d)), aabbr-size(bounding-box(base))) then unit
  else trap("difference box = base box")

@test
def scale-multiplies-the-box() =
  // scale a FULL-size-2 cube (box [-1,1]³) by (2,3,4) → box [-2,2]×[-3,3]×[-4,4], size (4,6,8), exact.
  let two = 2 / 1 in
  let scaled = Solid.Scale(v3r(2 / 1, 3 / 1, 4 / 1), Solid.Cube(v3r(two, two, two))) in
  let sz = aabbr-size(bounding-box(scaled)) in
  if v3r-eq(sz, v3r(4 / 1, 6 / 1, 8 / 1)) then unit
  else trap("scaled box size (4,6,8) exact")

@test
def nested-transforms-compose-in-order() =
  // NESTED transform composition (backlog: transform-composition invariants) — the bounding-box fold must
  // compose Translate/Scale in the RIGHT ORDER (the outer transform applies to the inner's already-transformed
  // box), and it is NOT commutative. Take a FULL-size-1 cube (box [-1/2, 1/2] on x):
  //   • Scale(2) ∘ Translate(+3): translate → [5/2, 7/2], then scale ×2 → [5, 7]  (x-extent 5..7)
  //   • Translate(+3) ∘ Scale(2): scale → [-1, 1], then translate +3 → [2, 4]     (x-extent 2..4)
  // Same two transforms, different nesting → different box. Pins order-correctness of both arms at depth.
  let one = 1 / 1 in
  let cube = Solid.Cube(v3r(one, one, one)) in
  let scale-of-translate = Solid.Scale(v3r(2 / 1, 2 / 1, 2 / 1), Solid.Translate(v3r(3 / 1, rzero(), rzero()), cube)) in
  let translate-of-scale = Solid.Translate(v3r(3 / 1, rzero(), rzero()), Solid.Scale(v3r(2 / 1, 2 / 1, 2 / 1), cube)) in
  match bounding-box(scale-of-translate) with | Aabb.Box(slo, shi) =>
    (match bounding-box(translate-of-scale) with | Aabb.Box(tlo, thi) =>
      // scale-of-translate: x ∈ [5, 7]; translate-of-scale: x ∈ [2, 4]. Both exact, and DIFFERENT (non-commutative).
      (if v3r-x(slo) == 5 / 1 and v3r-x(shi) == 7 / 1 then
        (if v3r-x(tlo) == 2 / 1 and v3r-x(thi) == 4 / 1 then unit
         else trap("Translate∘Scale should give x ∈ [2,4]"))
       else trap("Scale∘Translate should give x ∈ [5,7]")))

@test
def negative-scale-keeps-a-well-formed-box() =
  // REGRESSION: a NEGATIVE scale factor (a MIRROR) flips corners, so the naive `v3r-mul` of both corners would
  // invert the box (lo.x > hi.x) → a NEGATIVE aabbr-size, which would break a mesh driver / union / intersect.
  // bounding-box re-normalizes (min/max of the scaled corners), so a mirror keeps a well-formed box + correct
  // POSITIVE size. Mirror a size-2 cube (box [-1,1]³) by (-1, 1, -2) → still [-1,1]×[-1,1]×[-2,2], size (2,2,4).
  let one = 1 / 1 in let two = 2 / 1 in
  let mirrored = Solid.Scale(v3r(rzero() - one, one, rzero() - two), Solid.Cube(v3r(two, two, two))) in
  match bounding-box(mirrored) with | Aabb.Box(lo, hi) =>
    // lo ≤ hi on every axis (well-formed), and size is the POSITIVE (2, 2, 4).
    (if v3r-eq(lo, v3r(rzero() - one, rzero() - one, rzero() - two)) then
      (if v3r-eq(hi, v3r(one, one, two)) then
        (if v3r-eq(aabbr-size(bounding-box(mirrored)), v3r(two, two, 4 / 1)) then unit
         else trap("mirrored size must be positive (2,2,4)")) else trap("hi corner"))
     else trap("lo corner — box should be normalized, not inverted"))

@test
def negative-primitive-dimensions-keep-a-well-formed-box() =
  // REGRESSION (sibling of the negative-scale fix): a PRIMITIVE with a NEGATIVE dimension builds its box from
  // ±half-extent corners that would invert (lo > hi) if unnormalized → a negative aabbr-size. aabbr-of-corners
  // normalizes all three primitive arms, so a negative size/radius yields the ABSOLUTE extent, well-formed.
  let two = 2 / 1 in let three = 3 / 1 in
  let neg-cube = Solid.Cube(v3r(rzero() - two, two, rzero() - two)) in       // |−2| on x and z
  let neg-sphere = Solid.Sphere(rzero() - 3 / 2) in              // radius −3/2 → size 3
  let neg-cyl = Solid.Cylinder(rzero() - 5 / 1, rzero() - two) in // −5 height, −2 radius
  if v3r-eq(aabbr-size(bounding-box(neg-cube)), v3r(two, two, two)) then
    (if v3r-eq(aabbr-size(bounding-box(neg-sphere)), v3r(three, three, three)) then
      (if v3r-eq(aabbr-size(bounding-box(neg-cyl)), v3r(4 / 1, 4 / 1, 5 / 1))
       then unit else trap("neg cylinder size (2|r|,2|r|,|h|) = (4,4,5)"))
     else trap("neg sphere size 2|r| = 3")) else trap("neg cube size |w|,|d|,|h| = (2,2,2)")

@test
def intersection-of-two-cubes-is-the-overlap() =
  // two full-size-2 cubes (box [-1,1]), one translated +1 in x (box [0,2]) → intersection box x in [0,1].
  let two = 2 / 1 in
  let one = 1 / 1 in
  let a = Solid.Cube(v3r(two, two, two)) in
  let b = Solid.Translate(v3r(one, rzero(), rzero()), Solid.Cube(v3r(two, two, two))) in
  match bounding-box(Solid.Intersection(a, b)) with | Aabb.Box(lo, hi) =>
    (if v3r-x(lo) == rzero() then (if v3r-x(hi) == one then unit else trap("hi.x = 1")) else trap("lo.x = 0"))

@test
def intersection-of-disjoint-solids-is-an-inverted-empty-box() =
  // PIN the documented aabbr-intersect contract (see its doc-comment): the box of an intersection of two
  // NON-overlapping solids is INVERTED (lo > hi on the separating axis), which a mesh driver reads as "no
  // geometry" — NOT a well-formed degenerate box. This is deliberately NOT normalized by aabbr-of-corners:
  // normalizing an inverted overlap would falsely claim a real (zero- or positive-volume) box where the
  // solids don't touch. Two size-2 cubes ([-1,1]) with one translated +10 in x ([9,11]) are disjoint on x →
  // lo.x = max(-1, 9) = 9, hi.x = min(1, 11) = 1, so lo.x (9) > hi.x (1): inverted. y/z still overlap ([-1,1]).
  let two = 2 / 1 in
  let a = Solid.Cube(v3r(two, two, two)) in
  let b = Solid.Translate(v3r(10 / 1, rzero(), rzero()), Solid.Cube(v3r(two, two, two))) in
  match bounding-box(Solid.Intersection(a, b)) with | Aabb.Box(lo, hi) =>
    // the separating axis is inverted (lo.x > hi.x); the non-separating axes stay well-formed (lo <= hi).
    (if v3r-x(lo) > v3r-x(hi) then
       (if v3r-y(lo) == (rzero() - (1 / 1)) then (if v3r-y(hi) == 1 / 1 then unit else trap("hi.y = 1")) else trap("lo.y = -1"))
     else trap("expected an inverted box on the separating x axis (lo.x > hi.x) for a disjoint intersection"))

// ---- R9: direct coverage for the exported vector/box helpers that were only exercised transitively --------

@test
def v3r-min-max-are-componentwise() =
  let a = v3r(1 / 2, 5 / 1, 3 / 1) in
  let b = v3r(1 / 3, 7 / 1, 2 / 1) in
  // min picks the smaller per axis (1/3, 5, 2), max the larger (1/2, 7, 3) — exact, total order over Rational.
  if v3r-eq(v3r-min(a, b), v3r(1 / 3, 5 / 1, 2 / 1)) then
    (if v3r-eq(v3r-max(a, b), v3r(1 / 2, 7 / 1, 3 / 1)) then unit
     else trap("v3r-max componentwise")) else trap("v3r-min componentwise")

@test
def v3r-mul-is-componentwise-exact() =
  let a = v3r(1 / 2, 2 / 3, 3 / 1) in
  let b = v3r(4 / 1, 3 / 1, 1 / 3) in
  // 1/2*4 = 2, 2/3*3 = 2, 3*1/3 = 1 — exact, no rounding.
  if v3r-eq(v3r-mul(a, b), v3r(2 / 1, 2 / 1, 1 / 1)) then unit
  else trap("v3r-mul componentwise exact")

@test
def v3r-accessors-project-each-axis() =
  // v3r-y / v3r-z had no direct case (only v3r-x did) — pin all three accessors project the right component.
  let v = v3r(7 / 2, 9 / 4, 11 / 8) in
  if v3r-x(v) == 7 / 2 then
    (if v3r-y(v) == 9 / 4 then
      (if v3r-z(v) == 11 / 8 then unit else trap("v3r-z")) else trap("v3r-y")) else trap("v3r-x")

@test
def aabbr-union-and-intersect-of-explicit-boxes() =
  // exercise aabbr-union / aabbr-intersect DIRECTLY on explicit boxes (not only via bounding-box's folds):
  // union of box[(0,0,0),(2,2,2)] and box[(1,1,1),(4,4,4)] = box[(0,0,0),(4,4,4)]; intersect = box[(1,1,1),(2,2,2)].
  let p = Aabb.Box(v3r(rzero(), rzero(), rzero()), v3r(2 / 1, 2 / 1, 2 / 1)) in
  let q = Aabb.Box(v3r(1 / 1, 1 / 1, 1 / 1), v3r(4 / 1, 4 / 1, 4 / 1)) in
  (match aabbr-union(p, q) with | Aabb.Box(ulo, uhi) =>
    (match aabbr-intersect(p, q) with | Aabb.Box(ilo, ihi) =>
      if v3r-eq(ulo, v3r(rzero(), rzero(), rzero())) and v3r-eq(uhi, v3r(4 / 1, 4 / 1, 4 / 1))
         and v3r-eq(ilo, v3r(1 / 1, 1 / 1, 1 / 1)) and v3r-eq(ihi, v3r(2 / 1, 2 / 1, 2 / 1))
      then unit else trap("union/intersect corners")))

// ---- R11: simplify-r — the empty-solid algebraic identities on the EXACT Solid(Rational) model --------------------

@test
def simplify-r-absorbs-empty-in-union() =
  // Union Empty x = x (both sides); check the result is the surviving cube (box unchanged) and non-empty.
  let one = 1 / 1 in
  let cube = Solid.Cube(v3r(one, one, one)) in
  let sl = simplify-r(Solid.Union(Solid.Empty, cube)) in
  let sr = simplify-r(Solid.Union(cube, Solid.Empty)) in
  if v3r-eq(aabbr-size(bounding-box(sl)), aabbr-size(bounding-box(cube)))
     and v3r-eq(aabbr-size(bounding-box(sr)), aabbr-size(bounding-box(cube)))
     and (solidr-is-empty(sl) == false)
  then unit else trap("Union with Empty reduces to the other operand")

@test
def simplify-r-intersection-with-empty-is-empty() =
  // Intersection Empty x = Empty (absorbing).
  let one = 1 / 1 in
  let cube = Solid.Cube(v3r(one, one, one)) in
  if solidr-is-empty(simplify-r(Solid.Intersection(Solid.Empty, cube)))
     and solidr-is-empty(simplify-r(Solid.Intersection(cube, Solid.Empty)))
  then unit else trap("Intersection with Empty is Empty")

@test
def simplify-r-difference-identities() =
  // Difference Empty x = Empty; Difference x Empty = x (subtracting nothing is a no-op).
  let one = 1 / 1 in
  let cube = Solid.Cube(v3r(one, one, one)) in
  let subtract-nothing = simplify-r(Solid.Difference(cube, Solid.Empty)) in
  if solidr-is-empty(simplify-r(Solid.Difference(Solid.Empty, cube)))
     and (solidr-is-empty(subtract-nothing) == false)
     and v3r-eq(aabbr-size(bounding-box(subtract-nothing)), aabbr-size(bounding-box(cube)))
  then unit else trap("Difference empty identities")

@test
def simplify-r-prunes-a-nested-empty-branch-and-transform() =
  // a translate of empty collapses to empty; a union of two dead branches collapses fully to empty.
  let dead = Solid.Translate(v3r(5 / 1, rzero(), rzero()), Solid.Empty) in
  let both-dead = Solid.Union(dead, Solid.Intersection(Solid.Empty, Solid.Sphere(1 / 1))) in
  if solidr-is-empty(simplify-r(dead)) and solidr-is-empty(simplify-r(both-dead)) then unit
  else trap("simplify-r prunes dead transform + all-empty tree to Empty")

@test
def simplify-r-preserves-a-real-tree-and-is-idempotent() =
  // a fully-real model is unchanged in extent, and a second simplify pass is a no-op (idempotent).
  let two = 2 / 1 in
  let model = Solid.Difference(Solid.Cube(v3r(two, two, two)), Solid.Sphere(1 / 1)) in
  let s1 = simplify-r(model) in
  let s2 = simplify-r(s1) in
  if v3r-eq(aabbr-size(bounding-box(s1)), aabbr-size(bounding-box(model)))
     and v3r-eq(aabbr-size(bounding-box(s2)), aabbr-size(bounding-box(s1)))
  then unit else trap("simplify-r preserves a real tree + is idempotent")

@test
def simplify-r-of-a-mixed-tree-drops-dead-branches-but-preserves-the-real-extent() =
  // THE correctness link between simplify-r and bounding-box a mesh driver relies on: pruning DEAD branches
  // from a MIXED tree (real ∪ dead) must not change the surviving geometry's extent. Take a real cube shifted
  // to +10 in x (box centred at x=10) UNIONED with a dead branch (a translated Empty, which raw bounding-box
  // would fold in as a degenerate box at the ORIGIN — wrongly stretching the union's box from x=0 to x=10.5).
  // simplify-r drops the dead branch first, so the simplified tree's box is EXACTLY the real cube's box — the
  // pre-simplify box is larger (contaminated by the origin), proving the prune matters. All exact.
  let one = 1 / 1 in
  let ten = 10 / 1 in
  let real = Solid.Translate(v3r(ten, rzero(), rzero()), Solid.Cube(v3r(one, one, one))) in
  let dead = Solid.Translate(v3r(5 / 1, rzero(), rzero()), Solid.Empty) in
  let mixed = Solid.Union(real, dead) in
  let simplified = simplify-r(mixed) in
  // simplified extent == the real cube's extent (a 1×1×1 box → size (1,1,1)); and NOT empty.
  if v3r-eq(aabbr-size(bounding-box(simplified)), v3r(one, one, one)) and (solidr-is-empty(simplified) == false)
  then
    // and confirm the prune actually mattered: the UN-simplified box is bigger (origin contamination).
    (if v3r-eq(aabbr-size(bounding-box(mixed)), v3r(one, one, one)) then trap("expected the raw union box to be contaminated by the dead branch's origin box")
     else unit)
  else trap("simplify-r must preserve the real cube's extent while dropping the dead branch")

// ---- P5: monomorphic host-render mirror (SolidR / Vec3R + `lower`) --------------------------------------------
// The authored model is GENERIC — `Solid(a)` / `Vec3(a)` — so it can carry either exact `Rational` coords or a
// `Qty[meter]` length (B-via-generic). But the /cad mesh pipeline works by RETURNING the built `Solid` value to
// the host and parsing its canonical s-expr render (the render-grammar-to-driver contract). The compiler cannot
// yet emit a host value-form walker for a GENERIC recursive sum instantiated at a type (`Solid(Rational)`
// declines with "rendering this value as the host result needs a value-form walker that loops to a
// runtime-determined depth"), though a MONOMORPHIC recursive sum of the same shape renders fine. So a program
// that wants to hand a Solid to the mesh driver `lower`s its `Solid(Rational)` into this monomorphic `SolidR`
// mirror and returns THAT — `main = lower(model)`. The render is IDENTICAL in grammar to the generic form the
// driver already parses: constructors `Empty`/`Cube`/`Sphere`/`Cylinder`/`Union`/`Difference`/`Intersection`/
// `Translate`/`Scale`, a `Vec3` as `(: (tuple x y z) …)`, coords as exact Rational `n/d` — the parser discards
// the trailing type-name atom, so `SolidR`/`Vec3R` vs `Solid`/`Vec3` is invisible to it. (When the compiler
// gains generic-recursive-sum host-render, this mirror becomes redundant and a program can return the generic
// `Solid(Rational)` directly.)
type Vec3R =
  | V3(Rational, Rational, Rational)
type SolidR =
  | Empty
  | Cube(Vec3R)
  | Sphere(Rational)
  | Cylinder(Rational, Rational)
  | Union(SolidR, SolidR)
  | Difference(SolidR, SolidR)
  | Intersection(SolidR, SolidR)
  | Translate(Vec3R, SolidR)
  | Scale(Vec3R, SolidR)

/// Lower one exact vector into the monomorphic mirror (identity on the three Rational coordinates).
def lower-vec3(v: Vec3(Rational)) =
  match v with | Vec3.V3(x, y, z) => Vec3R.V3(x, y, z)

/// Lower a generic `Solid(Rational)` into the monomorphic `SolidR` the host can render + the mesh driver parses.
/// A structural 1:1 map — every constructor is preserved, so the rendered s-expr is grammar-identical to the
/// generic form; only the (parser-ignored) type-name atom differs.
def lower(s: Solid(Rational)) = match s with
  | Solid.Empty => SolidR.Empty
  | Solid.Cube(sz) => SolidR.Cube(lower-vec3(sz))
  | Solid.Sphere(r) => SolidR.Sphere(r)
  | Solid.Cylinder(h, r) => SolidR.Cylinder(h, r)
  | Solid.Union(a, b) => SolidR.Union(lower(a), lower(b))
  | Solid.Difference(a, b) => SolidR.Difference(lower(a), lower(b))
  | Solid.Intersection(a, b) => SolidR.Intersection(lower(a), lower(b))
  | Solid.Translate(by, of) => SolidR.Translate(lower-vec3(by), lower(of))
  | Solid.Scale(by, of) => SolidR.Scale(lower-vec3(by), lower(of))

@test
def lower-preserves-every-constructor-and-coordinate() =
  // Pin the render-grammar-to-driver contract at the model layer: `lower` maps each generic Solid constructor
  // to its SolidR twin 1:1, preserving exact Rational coords. Build one tree touching EVERY variant and lowered
  // pattern-match it back, asserting the shape + a representative coordinate survive. (The host-render itself
  // is exercised by v-guide-infra's headless /cad verification; here we pin the pure lowering is total + exact.)
  let tree = Solid.Union(
    Solid.Translate(v3r(1 / 1, rzero(), rzero()), Solid.Cylinder(3 / 1, 1 / 1)),
    Solid.Scale(v3r(2 / 1, 2 / 1, 2 / 1),
      Solid.Difference(Solid.Cube(v3r(4 / 1, 4 / 1, 4 / 1)),
        Solid.Intersection(Solid.Sphere(5 / 2), Solid.Empty)))) in
  // Bind the whole lowered tree, then destructure branch-by-branch (binder names avoid a case-insensitive
  // collision with constructor names like `Cube`). The left branch is `Translate(+1x, Cylinder 3 1)`; the
  // right is `Scale(2, Difference(Cube 4, Intersection(Sphere 5/2, Empty)))`.
  match lower(tree) with
    | SolidR.Union(left, right) =>
      (match left with
        | SolidR.Translate(lv, lc) =>
          (match lv with | Vec3R.V3(lx, _, _) =>
            (match lc with
              | SolidR.Cylinder(ch, cr) =>
                (if lx == 1 / 1 and ch == 3 / 1 and cr == 1 / 1 then
                  (match right with
                    | SolidR.Scale(_, rc) =>
                      (match rc with
                        | SolidR.Difference(box, tools) =>
                          (match box with
                            | SolidR.Cube(bv) =>
                              (match bv with | Vec3R.V3(bx, _, _) =>
                                (if bx == 4 / 1 then
                                  (match tools with
                                    | SolidR.Intersection(ball, hole) =>
                                      (match ball with
                                        | SolidR.Sphere(sr) =>
                                          (match hole with
                                            | SolidR.Empty => (if sr == 5 / 2 then unit else trap("sphere radius lost"))
                                            | _ => trap("Empty leaf lost"))
                                        | _ => trap("Sphere lost"))
                                    | _ => trap("Intersection lost"))
                                 else trap("cube x lost")))
                            | _ => trap("Cube lost"))
                        | _ => trap("Difference lost"))
                    | _ => trap("Scale lost"))
                 else trap("translate/cylinder coords lost"))
              | _ => trap("Cylinder lost")))
        | _ => trap("Translate lost"))
    | _ => trap("Union lost")

export { Vec3.*, Solid.*, Aabb.*, SolidR.*, Vec3R.*, rmin, rmax, rzero, v3r, v3r-x, v3r-y, v3r-z, v3r-add,
         v3r-mul, v3r-min, v3r-max, v3r-eq, aabbr-union, aabbr-intersect, aabbr-empty, aabbr-of-corners,
         bounding-box, aabbr-size, solidr-is-empty, simplify-r, lower-vec3, lower }
