/// examples.cdz — worked parametric models built on the `Solid` library (the start of increment G4). Each
/// is an ordinary Cadenza function producing a `Solid` tree — the "describe a model in code" showcase, and
/// a real stress corpus (recursion, list-folds, float arithmetic) for the compiler. These import the model
/// vocabulary from `solid` (cross-module use), exactly as a user program would, and are pinned by `@test`s
/// that assert the tree's SHAPE (leaf/node counts — Int64, so unaffected by the deferred Float64 bounding-
/// box bug). A mesh driver (G2/G3) consumes these trees as data; the shapes here are the contract.
///
/// NOTE: assertions use `count-nodes`/`leaf-count` (Int64 comparisons only). A geometric assertion over
/// Float64 extents (a `bounding-box`) is DEFERRED until the recursive-Float64-compare backend bug clears
/// (filed: mlrepro-decline-recursive-compound-fold-with-float-compare-helper.cdz).

import { Solid } from "solid"
import { cube, cube-uniform, sphere, cylinder, empty } from "solid"
import { union, difference, difference-all, union-all } from "solid"
import { translate, rotate, scale, v3, v3-splat } from "solid"
import { leaf-count, count-nodes, is-empty } from "solid"

/// The marquee example (DESIGN §0): a rectangular plate `w × d × t` with two bolt holes of radius `r`,
/// drilled at 1/4 and 3/4 of the width, centered in depth. `difference-all` cuts each hole from the plate.
/// Fully parametric — every dimension is an argument, so a caller sweeps sizes with no edit.
def plate(w: Float64, d: Float64, t: Float64, r: Float64) =
  difference-all(cube(w, d, t),
    [ translate(v3(w * 0.25, d * 0.5, 0.0), cylinder(t, r)),
      translate(v3(w * 0.75, d * 0.5, 0.0), cylinder(t, r)) ])

/// A washer / ring: a short cylinder (outer radius `ro`) with a concentric bore (inner radius `ri`) removed.
/// The `difference` idiom for a hole through a solid.
def washer(thickness: Float64, ro: Float64, ri: Float64) =
  difference(cylinder(thickness, ro), cylinder(thickness, ri))

/// A rounded "capsule": a central cylinder capped by a sphere at each end (a union of three primitives).
/// Shows a small hand-built union of transformed leaves.
def capsule(len: Float64, r: Float64) =
  union-all(
    [ cylinder(len, r),
      translate(v3(0.0, 0.0, len * 0.5), sphere(r)),
      translate(v3(0.0, 0.0, 0.0 - len * 0.5), sphere(r)) ])

/// A row of `n` identical unit cubes spaced `step` apart along +x — a RECURSIVE parametric builder (the
/// "fold a feature N times" pattern a gear/rack uses). Returns `empty` for `n <= 0`.
def cube-row(n: Int64, step: Float64) =
  if n <= 0 then empty()
  else union(cube-uniform(1.0), translate(v3(step, 0.0, 0.0), cube-row(n - 1, step)))

/// Int64 → Float64, for computing an angle from a loop index (`Float64.of-int`).
def i2f(i: Int64) = Float64.of-int(i)

/// A radial pattern: `n` copies of `part`, each rotated `i × 360/n` degrees about +z and pushed out to
/// radius `r` along +x. The general "arrange N features in a circle" combinator — the recursion + float
/// angle arithmetic (`i2f(i) × (360/n)`) that a gear, a bolt-circle, or a fan blade-set is built from.
/// `part` is any `Solid`; the caller supplies the feature to repeat. Returns `empty` for `n <= 0` (the
/// `n <= 0` guard is on `radial-pattern` itself — `radial-from` counts UP from 0 to `n`, so a negative `n`
/// would never reach the `i == n` base case AND `360/n` would divide by a non-positive count).
def radial-pattern(n: Int64, r: Float64, part: Solid) =
  if n <= 0 then empty()
  else radial-from(n, 0, r, part)

def radial-from(n: Int64, i: Int64, r: Float64, part: Solid) =
  if i == n then empty()
  else union(
    rotate(v3(0.0, 0.0, i2f(i) * (360.0 / i2f(n))), translate(v3(r, 0.0, 0.0), part)),
    radial-from(n, i + 1, r, part))

/// A spur gear (schematic): a hub cylinder with `n` cubic teeth arranged in a radial pattern at the hub's
/// rim. Not an involute profile — the showcase point is that a parametric, recursive circular pattern is
/// ordinary Cadenza (fold + float angle math), which the mesh backend then evaluates. `n` teeth → `n+1`
/// primitive leaves (the hub + each tooth).
def gear(n: Int64, hub-r: Float64, hub-h: Float64, tooth: Float64) =
  union(cylinder(hub-h, hub-r), radial-pattern(n, hub-r, cube-uniform(tooth)))

/// A hollow tube: an outer cylinder with a concentric bore removed along its whole length (a washer
/// extended — the pipe/ring-stock idiom). `difference` of two coaxial cylinders.
def tube(len: Float64, ro: Float64, ri: Float64) =
  difference(cylinder(len, ro), cylinder(len, ri))

/// A hollow box / open container: an outer cube with a smaller inner cube removed, leaving walls of
/// thickness `wall` on each side (so the cavity is `size - 2·wall` per axis). The `difference` idiom for a
/// shelled solid — a box, a case, an enclosure. 2 primitive leaves (outer − inner).
def hollow-box(w: Float64, d: Float64, h: Float64, wall: Float64) =
  difference(cube(w, d, h), cube(w - wall - wall, d - wall - wall, h - wall - wall))

/// One row of `cols` holes (cylinders) spaced `pitch` apart along +x at height `y` — the inner recursion of
/// `hole-grid`. Guards `cols <= 0` (terminates on any non-positive count; the negative-n lesson from PR#412).
def hole-row(cols: Int64, i: Int64, y: Float64, pitch: Float64, r: Float64, t: Float64) =
  if cols <= 0 then empty()
  else union(
    translate(v3(i2f(i) * pitch, y, 0.0), cylinder(t, r)),
    hole-row(cols - 1, i + 1, y, pitch, r, t))

/// A `rows × cols` GRID of holes (cylinders), pitch-spaced in x and y — a nested double recursion (rows of
/// rows), the "perforated plate / breadboard" pattern. `rows·cols` primitive leaves. A caller `difference`s
/// this against a plate to drill it. Guards `rows <= 0`.
def hole-grid(rows: Int64, j: Int64, cols: Int64, pitch: Float64, r: Float64, t: Float64) =
  if rows <= 0 then empty()
  else union(
    hole-row(cols, 0, i2f(j) * pitch, pitch, r, t),
    hole-grid(rows - 1, j + 1, cols, pitch, r, t))

/// ============================ @test suite (pins the example shapes) ============================

@test
def plate-has-base-plus-two-holes() =
  // a plate is the base cube minus two hole cylinders → 3 primitive leaves
  if leaf-count(plate(10.0, 4.0, 1.0, 0.5)) == 3 then unit else trap("plate = base + 2 holes = 3 leaves")

@test
def plate-node-shape() =
  // difference-all builds Difference(Difference(cube, hole1), hole2); each hole is a translate(cylinder).
  // nodes: 2 Difference + 2 Translate + 3 leaves (cube + 2 cylinders) = 7
  if count-nodes(plate(10.0, 4.0, 1.0, 0.5)) == 7 then unit else trap("plate has 7 nodes")

@test
def washer-is-two-cylinders() =
  if leaf-count(washer(0.5, 2.0, 1.0)) == 2 then unit else trap("washer = outer - bore = 2 leaves")

@test
def capsule-is-three-primitives() =
  // a cylinder + two spheres
  if leaf-count(capsule(4.0, 1.0)) == 3 then unit else trap("capsule = cylinder + 2 caps = 3 leaves")

@test
def cube-row-counts-n-cubes() =
  // a row of 4 cubes → 4 primitive leaves
  if leaf-count(cube-row(4, 2.0)) == 4 then unit else trap("cube-row 4 = 4 leaves")

@test
def cube-row-zero-is-empty() =
  if is-empty(cube-row(0, 2.0)) then unit else trap("an empty row has no geometry")

@test
def cube-row-negative-is-empty() =
  // regression (Copilot PR #412): a negative count must TERMINATE as empty, not recurse forever
  // (the guard is `n <= 0`, not `n == 0`).
  if is-empty(cube-row(0 - 1, 2.0)) then unit else trap("a negative-count row is empty, not infinite")

@test
def cube-row-recursion-depth-matches-count() =
  // each cube adds one Union + one Translate level; a row of 3 → union(cube, translate(row 2)) …
  // leaf-count is the robust invariant; assert it grows with n
  let three = leaf-count(cube-row(3, 1.0)) in
  let five = leaf-count(cube-row(5, 1.0)) in
  if three == 3 then (if five == 5 then unit else trap("row 5 = 5 leaves")) else trap("row 3 = 3 leaves")

@test
def radial-pattern-counts-n-copies() =
  // n copies of a single-leaf part → n primitive leaves
  if leaf-count(radial-pattern(6, 2.0, cube-uniform(1.0))) == 6 then unit else trap("radial 6 = 6 leaves")

@test
def radial-pattern-zero-is-empty() =
  if is-empty(radial-pattern(0, 2.0, cube-uniform(1.0))) then unit else trap("empty radial pattern")

@test
def radial-pattern-negative-is-empty() =
  // regression (Copilot PR #412 sibling): radial-from counts UP to n, so a negative n would never hit the
  // `i == n` base case (and `360/n` would divide by a non-positive count) — the `n <= 0` guard prevents both.
  if is-empty(radial-pattern(0 - 1, 2.0, cube-uniform(1.0))) then unit else trap("a negative radial count is empty")

@test
def radial-pattern-repeats-a-compound-part() =
  // the part can itself be a compound (2-leaf) tree; 4 copies of a 2-leaf part → 8 leaves
  let part = union(cube-uniform(1.0), sphere(0.5)) in
  if leaf-count(radial-pattern(4, 3.0, part)) == 8 then unit else trap("4 × 2-leaf = 8 leaves")

@test
def gear-is-hub-plus-n-teeth() =
  // a gear with 8 teeth → hub + 8 teeth = 9 primitive leaves
  if leaf-count(gear(8, 2.0, 0.5, 0.4)) == 9 then unit else trap("gear 8 = hub + 8 teeth = 9 leaves")

@test
def gear-tooth-count-scales() =
  let g12 = leaf-count(gear(12, 2.0, 0.5, 0.4)) in
  if g12 == 13 then unit else trap("gear 12 = 13 leaves")

@test
def tube-is-two-cylinders() =
  if leaf-count(tube(5.0, 2.0, 1.5)) == 2 then unit else trap("tube = outer - bore = 2 leaves")

@test
def hollow-box-is-outer-minus-inner() =
  if leaf-count(hollow-box(10.0, 10.0, 5.0, 1.0)) == 2 then unit else trap("hollow-box = 2 cubes")

@test
def hole-grid-counts-rows-times-cols() =
  // a 3×4 grid → 12 holes (primitive leaves)
  if leaf-count(hole-grid(3, 0, 4, 2.0, 0.4, 1.0)) == 12 then unit else trap("3×4 grid = 12 holes")

@test
def hole-grid-single-row_and_col() =
  // a 1×1 grid → exactly one hole
  if leaf-count(hole-grid(1, 0, 1, 2.0, 0.4, 1.0)) == 1 then unit else trap("1×1 grid = 1 hole")

@test
def hole-grid-empty-dimensions-are-empty() =
  // any non-positive dimension → no geometry (the <= 0 guards terminate, no infinite recursion)
  if is-empty(hole-grid(0, 0, 4, 2.0, 0.4, 1.0)) then
    (if is-empty(hole-grid(3, 0, 0, 2.0, 0.4, 1.0)) then
      (if is-empty(hole-grid(0 - 2, 0, 4, 2.0, 0.4, 1.0)) then unit else trap("negative rows empty"))
     else trap("zero cols empty"))
  else trap("zero rows empty")

@test
def perforated-plate-drills-the-grid() =
  // the real use: difference a plate by a hole grid → base + rows·cols holes leaves
  let plate-blank = cube(10.0, 8.0, 1.0) in
  let drilled = difference(plate-blank, hole-grid(2, 0, 3, 2.0, 0.4, 1.0)) in
  if leaf-count(drilled) == 7 then unit else trap("plate + 2×3 holes = 7 leaves")

export { plate, washer, capsule, cube-row, radial-pattern, gear, tube, hollow-box, hole-row, hole-grid }
