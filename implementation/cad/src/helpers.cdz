/// helpers.cdz — ergonomic CONSTRUCTOR helpers for the exact CAD model (operator: "a bunch of helper
/// functions that make it easy to use"). These wrap the raw `Solid`/`Vec3` constructors from `exact.cdz`
/// so common modeling reads cleanly — `box(w,d,h)` instead of `Solid.Cube(v3(w,d,h))`, `move-x(dx, s)`
/// instead of `Solid.Translate(v3(dx,0,0), s)`, `hole-through(s, r, len)` for a bolt hole, etc. Pure
/// exact-Rational model (no float, no units — a coordinate is a bare `Rational`; a units-authored model
/// uses `units.cdz`/`units-model.cdz` and lowers to bare meters). Every helper is a thin, total wrapper —
/// no new geometry semantics, just a friendlier surface over the CSG primitives + transforms.
///
/// NUMERIC MODE: `@!default-fraction Rational` so a bare `n/d` dimension is an exact Rational (not Int64
/// division). Imported `exact` is unaffected (module-local pragma).
@!default-fraction Rational

import { Solid, Vec3, Aabb, v3, bounding-box, aabbr-size, v3-eq } from "exact"

/// ---- primitives (friendly names for the centred CSG primitives) ------------------------------------

/// An axis-aligned box of FULL size w×d×h, centred at the origin. `box(50, 30, 5)` — a 50×30×5 plate.
def box(w: Rational, d: Rational, h: Rational) = Solid.Cube(v3(w, d, h))

/// A cube of uniform side `s` (a friendly `box(s,s,s)`).
def cube(s: Rational) = Solid.Cube(v3(s, s, s))

/// A sphere of the given radius, centred at the origin.
def ball(r: Rational) = Solid.Sphere(r)

/// A cylinder of FULL height `h` and radius `r`, centred on the origin along +z.
def cyl(h: Rational, r: Rational) = Solid.Cylinder(h, r)

/// ---- transforms (friendly per-axis moves + scales) -------------------------------------------------

/// Translate a solid by (dx, dy, dz).
def move(dx: Rational, dy: Rational, dz: Rational, s: Solid(Rational)) = Solid.Translate(v3(dx, dy, dz), s)

/// Single-axis translates — the common case (a stack, a shift).
def move-x(dx: Rational, s: Solid(Rational)) = Solid.Translate(v3(dx, rzero-h(), rzero-h()), s)
def move-y(dy: Rational, s: Solid(Rational)) = Solid.Translate(v3(rzero-h(), dy, rzero-h()), s)
def move-z(dz: Rational, s: Solid(Rational)) = Solid.Translate(v3(rzero-h(), rzero-h(), dz), s)

/// A local zero (the pragma grounds `0` to Rational; a named helper keeps the single-axis moves readable).
def rzero-h() = 0 / 1

/// Uniform scale by a single factor (all three axes) — `scale(2, s)` doubles a solid.
def scale(f: Rational, s: Solid(Rational)) = Solid.Scale(v3(f, f, f), s)

/// Per-axis scale.
def scale-xyz(fx: Rational, fy: Rational, fz: Rational, s: Solid(Rational)) = Solid.Scale(v3(fx, fy, fz), s)

/// ---- rotation + mirror (the transforms whose trig/reflection is applied at the f64 mesh leaf) -------
/// `Rotate` carries an exact Rational Euler-degree triple; the mesh driver does the trig. Single-axis
/// helpers are the common case (spin about z for rotational arrays; tilt about x/y for mating).

/// Rotate a solid about the origin by an exact Euler-degree triple (degrees about x, y, z).
def rotate(rx: Rational, ry: Rational, rz: Rational, s: Solid(Rational)) = Solid.Rotate(v3(rx, ry, rz), s)

/// Single-axis rotations (degrees). `rotate-z(60, s)` spins 60° about z — the rotational-array workhorse.
def rotate-x(deg: Rational, s: Solid(Rational)) = Solid.Rotate(v3(deg, rzero-h(), rzero-h()), s)
def rotate-y(deg: Rational, s: Solid(Rational)) = Solid.Rotate(v3(rzero-h(), deg, rzero-h()), s)
def rotate-z(deg: Rational, s: Solid(Rational)) = Solid.Rotate(v3(rzero-h(), rzero-h(), deg), s)

/// Mirror across an axis-aligned plane through the origin (a sign flip, exact). `mirror-x(s)` reflects across
/// the y-z plane (flips x) — the bilateral-symmetry workhorse: `fuse(s, mirror-x(s))`.
def mirror-x(s: Solid(Rational)) = Solid.Mirror(v3(1 / 1, rzero-h(), rzero-h()), s)
def mirror-y(s: Solid(Rational)) = Solid.Mirror(v3(rzero-h(), 1 / 1, rzero-h()), s)
def mirror-z(s: Solid(Rational)) = Solid.Mirror(v3(rzero-h(), rzero-h(), 1 / 1), s)

/// ---- combinators (friendly booleans, incl. the common "hole" idiom) --------------------------------

/// Union two solids (fuse).
def fuse(a: Solid(Rational), b: Solid(Rational)) = Solid.Union(a, b)

/// Subtract `tool` from `base` (cut).
def cut(base: Solid(Rational), tool: Solid(Rational)) = Solid.Difference(base, tool)

/// Intersect two solids (keep the shared volume).
def common(a: Solid(Rational), b: Solid(Rational)) = Solid.Intersection(a, b)

/// A bolt hole: drill a cylinder of radius `r` and length `len` (centred) straight through `base` along z.
/// `hole-through(box(50,30,5), 3, 5)` — a 50×30×5 plate with a Ø6 hole through its 5mm thickness.
def hole-through(base: Solid(Rational), r: Rational, len: Rational) = Solid.Difference(base, cyl(len, r))

/// ---- @test suite: pin that each helper builds the SAME solid as the raw form (thin-wrapper invariant) ----

@test
def box-and-cube-match-the-raw-cube() =
  // box(w,d,h) ≡ Solid.Cube(v3 …); cube(s) ≡ box(s,s,s). Compare by bounding-box size (a full wrapper check).
  if v3-eq(aabbr-size(bounding-box(box(4 / 1, 2 / 1, 6 / 1))), v3(4 / 1, 2 / 1, 6 / 1)) then
    (if v3-eq(aabbr-size(bounding-box(cube(3 / 1))), v3(3 / 1, 3 / 1, 3 / 1)) then unit
     else trap("cube(3) is a 3×3×3 box")) else trap("box(4,2,6) is a 4×2×6 box")

@test
def cyl-and-ball-have-the-right-envelope() =
  // cyl(h, r) → box (2r, 2r, h); ball(r) → box (2r, 2r, 2r).
  if v3-eq(aabbr-size(bounding-box(cyl(6 / 1, 2 / 1))), v3(4 / 1, 4 / 1, 6 / 1)) then
    (if v3-eq(aabbr-size(bounding-box(ball(5 / 2))), v3(5 / 1, 5 / 1, 5 / 1)) then unit
     else trap("ball(5/2) envelope is Ø5 cube")) else trap("cyl(6,2) envelope is Ø4 × 6")

@test
def single-axis-moves-shift-the-box-centre() =
  // move-x(10, cube(2)) shifts the [-1,1] box to [9,11] → centre x = 10; y,z stay centred at 0.
  match bounding-box(move-x(10 / 1, cube(2 / 1))) with | Aabb.Box(lo, hi) =>
    (match lo with | Vec3.V3(lx, ly, _) =>
      (match hi with | Vec3.V3(hx, hy, _) =>
        if (lx + hx) / (2 / 1) == 10 / 1 then
          (if (ly + hy) / (2 / 1) == 0 / 1 then unit else trap("y stays centred")) else trap("x centre = 10")))

@test
def scale-uniform-multiplies-the-box() =
  // scale(2, box(1,1,1)) → a 2×2×2 box.
  if v3-eq(aabbr-size(bounding-box(scale(2 / 1, box(1 / 1, 1 / 1, 1 / 1)))), v3(2 / 1, 2 / 1, 2 / 1)) then unit
  else trap("scale(2, unit box) is a 2×2×2 box")

@test
def hole-through-does-not-grow-the-box() =
  // drilling a hole (a Difference) never grows the base's extent — the plate's box is unchanged.
  let plate = box(50 / 1, 30 / 1, 5 / 1) in
  if v3-eq(aabbr-size(bounding-box(hole-through(plate, 3 / 1, 5 / 1))), aabbr-size(bounding-box(plate)))
  then unit else trap("a hole-through never grows the plate's box")

@test
def cut-fuse-common-are-the-boolean-wrappers() =
  // cut/fuse/common wrap Difference/Union/Intersection — a fused pair encloses both, a cut never grows the base.
  let a = cube(2 / 1) in
  let b = move-x(10 / 1, cube(2 / 1)) in
  // fuse of two disjoint size-2 cubes (10 apart) → box spans x ∈ [-1, 11] → width 12.
  match bounding-box(fuse(a, b)) with | Aabb.Box(lo, hi) =>
    (match lo with | Vec3.V3(lx, _, _) => (match hi with | Vec3.V3(hx, _, _) =>
      if hx - lx == 12 / 1 then
        (if v3-eq(aabbr-size(bounding-box(cut(a, b))), aabbr-size(bounding-box(a))) then unit
         else trap("cut never grows the base")) else trap("fuse encloses both (width 12)")))

@test
def rotate-array-and-mirror-build-symmetric-solids() =
  // rotate-z(90) of a translated cube spins it about the origin; the conservative rotate bbox stays symmetric.
  // And mirror-x of a right-shifted cube reflects it to the left (bilateral pair via fuse).
  let bar = move-x(10 / 1, cube(2 / 1)) in                 // a 2×2×2 cube centred at x=10 → box x∈[9,11], y,z∈[-1,1]
  // rotate-z(45, bar): SOUND conservative box is symmetric [-R,R]^3 with R = the L1 corner-radius
  // (mx + my + mz = 11 + 1 + 1 = 13), so size 26 each axis (soundly encloses any rotation of the shifted bar).
  match bounding-box(rotate-z(45 / 1, bar)) with | Aabb.Box(lo, hi) =>
    (match lo with | Vec3.V3(lx, _, _) => (match hi with | Vec3.V3(hx, _, _) =>
      if (hx - lx) == 26 / 1 then
        // mirror-x(bar) → box x∈[-11,-9]; fuse with bar → x∈[-11,11], width 22 (a bilateral pair).
        (match bounding-box(fuse(bar, mirror-x(bar))) with | Aabb.Box(mlo, mhi) =>
          (match mlo with | Vec3.V3(mlx, _, _) => (match mhi with | Vec3.V3(mhx, _, _) =>
            if (mhx - mlx) == 22 / 1 then unit else trap("bilateral fuse spans [-11,11]"))))
      else trap("rotate-z sound box is symmetric (width 26 via the L1 radius 13)")))

export { box, cube, ball, cyl, move, move-x, move-y, move-z, scale, scale-xyz,
         rotate, rotate-x, rotate-y, rotate-z, mirror-x, mirror-y, mirror-z,
         fuse, cut, common, hole-through }
