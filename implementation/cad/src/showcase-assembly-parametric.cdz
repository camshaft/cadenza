// showcase-assembly-parametric.cdz -- a PARAMETRIC L-bracket assembly: shared dims as @!param sliders.
// Drag a slider and the whole bracket re-mates (origin-relative dimension arithmetic). Assembly-as-code
// meets the parametric @!param slider UX. @tests use per-part bboxes only (whole-assembly bounding-box
// hits the routed v-memory-safety O(2^n) nested-union miscompile); the mesh path is unaffected.
@!default-fraction Rational

import { Solid, SolidR, Vec3, Aabb, lower, v3, v3-eq, bounding-box, aabbr-size, solidr-is-empty } from "exact"

import { box, cyl, fuse, cut, move-x, move-y, move-z, rotate-x } from "helpers";

@!param(widget: slider, range: [20, 80], default: 40) pa-len : Rational;

@!param(widget: slider, range: [15, 50], default: 30) pa-wid : Rational;

@!param(widget: slider, range: [2, 10], default: 4) pa-thick : Rational;

@!param(widget: slider, range: [10, 50], default: 25) pa-rise : Rational;

@!param(widget: slider, range: [1, 8], default: 3) pa-bolt : Rational

def rzero() = 0 / 1

def base-plate(len: Rational, wid: Rational, t: Rational, r: Rational) =
  let slab = move-z(t / (2 / 1), box(len, wid, t)) in
  let hole = move-x(len / (4 / 1), cyl(t * (2 / 1), r)) in
  cut(slab, move-z(t / (2 / 1), hole))

def arm-flat(wid: Rational, rise: Rational, t: Rational, r: Rational) =
  let slab = move-z(t / (2 / 1), box(wid, rise, t)) in
  let hole = move-y(rise / (3 / 1), cyl(t * (2 / 1), r)) in
  cut(slab, move-z(t / (2 / 1), hole))

def standing-arm(wid: Rational, rise: Rational, t: Rational, r: Rational) =
  move-y((rzero() - wid) / (2 / 1), move-z(t, rotate-x(90 / 1, arm-flat(wid, rise, t, r))))

def bracket(len: Rational, wid: Rational, t: Rational, rise: Rational, r: Rational) =
  fuse(base-plate(len, wid, t, r), standing-arm(wid, rise, t, r))

def main() =
  host Param
  in
  let len = Param.pa-len() in
  let wid = Param.pa-wid() in
  let t = Param.pa-thick() in
  let rise = Param.pa-rise() in
  let r = Param.pa-bolt() in
  lower(bracket(len, wid, t, rise, r))

@test
def the-parametric-bracket-is-non-empty() =
  if solidr-is-empty(bracket(40 / 1, 30 / 1, 4 / 1, 25 / 1, 3 / 1)) == false then
    unit
  else
    trap("the parametric L-bracket has geometry")

@test
def the-lowered-parametric-render-form-is-non-empty() =
  // Render-edge pin (twin of the plain-assembly + snowflake ones): main lowers bracket(...) to the SolidR the
  // mesh driver consumes. The model being non-empty (above) does NOT guarantee the RENDER isn't blank — a
  // lower/empty-fold regression could still ship a blank slider preview. Pin the lowered form is not
  // SolidR.Empty (bracket's top node is a fuse → lowered top is a SolidR.Union).
  match lower(bracket(40 / 1, 30 / 1, 4 / 1, 25 / 1, 3 / 1)) with
    | SolidR.Empty =>
      trap("the lowered parametric bracket (what the driver meshes) must NOT be empty")
    | _ => unit

@test
def the-base-plate-part-has-the-right-envelope() =
  // The base-plate PART (a small tree — reliable bbox): a 40×30×4 slab; the bolt hole (a cut) never grows it.
  let slab = move-z(4 / 1 / (2 / 1), box(40 / 1, 30 / 1, 4 / 1)) in
  if v3-eq(
      aabbr-size(bounding-box(base-plate(40 / 1, 30 / 1, 4 / 1, 3 / 1))),
      aabbr-size(bounding-box(slab))
    ) then
    unit
  else
    trap("the bolt hole must not grow the base plate")

@test
def the-standing-arm-part-rises-above-the-base() =
  // The arm PART (small tree — reliable bbox) rises above the base's top face after the 90° rotate + lift.
  match bounding-box(standing-arm(30 / 1, 25 / 1, 4 / 1, 3 / 1)) with
    | Aabb.Box(_, hi) =>
      match hi with
        | Vec3.V3(_, _, hz) => if hz > 4 / 1 then unit else trap("the arm rises above the base top")

export { base-plate, arm-flat, standing-arm, bracket, main }
