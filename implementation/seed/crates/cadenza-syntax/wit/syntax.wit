// The cadenza-syntax REDUCER-FACING export world — cadenza-syntax as a composable, content-addressed
// pure-library WIT dep a reducer (or any wasm component) imports directly (P2, design note
// `p2-reducer-invoke-cadenza-syntax-as-composable-wit-dep`; operator Option-A: a linked in-wasm dep,
// NOT a host effect). v-ah's `compose_dep_into_linker` composes ANY declared WIT dep resolved by
// content-hash, leaves-first; cadenza-syntax is exactly that — a pure-compute leaf that imports
// nothing world-touching (`store_provider = None`). There is NO host side for P2: parse / query /
// doc-extraction are pure functions of their inputs.
//
// ── The boundary carries cdzast BYTES, not structured records ────────────────────────────────────
// Every AST crossing this boundary is the canonical binary sexpr — a `cdzast\x00\x01` artifact
// (`list<u8>`), the SAME wire the reducer world (cadenza:agent-kernel) and the shared
// `cadenza-syntax::codec` bottom crate already use. This is deliberate: keeping ASTs as opaque
// versioned bytes at the boundary makes this world codec-VERSIONED and
// arena-rep-INDEPENDENT — the importer decodes with its own `codec::decode` (byte-identical), so a
// caller in a different arena representation (rcdzc vs cadenza_ast) still interoperates. We do NOT
// mirror the `Struct`/`Leaf` value model into WIT records: that would freeze the arena shape into the
// ABI and duplicate the frozen 2-variant codec. Source text crosses as `string` (UTF-8).
//
// ⚠ CONTRACT STABILITY: additive evolution ONLY (append new funcs / new optional record fields;
// never reorder or remove). The AST-bytes payloads are versioned by the `cdzast\x00\x01` header the
// codec already carries, so the wire under `list<u8>` evolves independently of this world.
// This is a DRAFT for review — no reducer binds it yet, so the interface names + func shapes can still
// be reshaped before the first component imports it. The reducer IMPORTS under the full
// content-addressed name (`cadenza:syntax/...@<version>+<hash>`); this world EXPORTS the BARE
// interface names (`parse`/`query`/`doc`) — `compose_dep_into_linker`'s `bare_iface_name` bridges the
// mismatch, so the `+hash` is the importer's build-metadata, not part of these export names.
package cadenza:syntax;

// ── Shared boundary types ──────────────────────────────────────────────────────────────────────────
interface types {
  // A canonical binary AST artifact: a `cdzast\x00\x01` byte string, as
  // `codec::encode` produces and `codec::decode` consumes. Opaque at this boundary — the importer
  // decodes it. (A type alias for intent; WIT has no newtype, so it is `list<u8>` on the wire.)
  type ast-bytes = list<u8>;

  // One recovered diagnostic from an error-recovering parse. `cadenza-syntax` parsing NEVER fails
  // hard — it always yields an arena plus zero-or-more diagnostics (mirrors `parser::Parsed`), so a
  // caller gets a best-effort AST AND the problems. `byte-offset`/`len` locate the span in the source
  // text (the same span model `spans.rs` carries); `message` is the human-facing text.
  record diagnostic {
    message: string,
    byte-offset: u32,
    len: u32,
  }

  // The result of an error-recovering parse: the (always-present, well-formed) AST bytes plus any
  // diagnostics. `diagnostics` empty ⟺ a clean parse. This mirrors `Parsed { arenas, errors }` — the
  // arena is valid even when diagnostics is non-empty (error recovery yields a repaired tree).
  record parsed {
    ast: ast-bytes,
    diagnostics: list<diagnostic>,
  }
}

// ── parse: source text → canonical AST bytes ────────────────────────────────────────────────────────
// The front-end entry points. Both are error-recovering (return `parsed`, never trap): a reducer that
// ingests Cadenza source (an editor, a doc tool, a macro host) gets a best-effort AST + diagnostics.
interface parse {
  use types.{parsed};

  // Parse the ML surface (`parser::read_ml`) — the human-facing Cadenza syntax.
  read-ml: func(source: string) -> parsed;

  // Parse the s-expression surface (`sexpr::read`, single top-level form). A hard read error (not
  // recoverable like the ML path) surfaces as a single diagnostic with empty `ast` — the caller
  // checks `diagnostics` before using `ast`. (s-expr reading is stricter than ML error-recovery.)
  read-sexpr: func(source: string) -> parsed;
}

// ── query: structural search over an AST ──────────────────────────────────────────────────────────
// The compiler-query machinery (`query.rs`) exposed as a reducer-facing primitive — the same
// `Pattern::compile` + `search` the doc-item projection is built on, so an IDE outline / structural
// codemod / lint runs the same engine. Patterns are the s-expr metavar surface (`(def ,name ,@rest)`).
interface query {
  use types.{ast-bytes};

  // Search `program` for every subtree matching the s-expr `pattern` (metavars `,name`/`,@rest`).
  // Returns each match as its own standalone AST-bytes subtree (the matched node, re-encoded), in
  // source order. An invalid pattern yields an empty list (never a trap). A reducer post-filters /
  // reads bound metavars by decoding each returned subtree.
  search: func(program: ast-bytes, pattern: string) -> list<ast-bytes>;
}

// ── doc: derived doc-module extraction ──────────────────────────────────────────────────────────────
// cadenza-docs (`doc_item::project`) as a first-class P2 export — doc-extraction callable FROM a
// reducer (P1 feature-gate landed, so `doc_item` is reducer-reachable in the lean build). The
// STRUCTURAL half only (I1): name / structured sig / doc-text / kind / visibility, no resolved types
// (types need a full typecheck, which lives in rcdzc, not this pure front-end dep). A caller wanting
// the typed doc-module runs the `cdz doc-module` merge separately; this export is the syntax-only
// projection an in-wasm reducer can compute with no compiler.
interface doc {
  use types.{ast-bytes};

  // Project a program's EXPORTED public surface into a derived `doc-module` AST (structural — I1),
  // named `module-name`. Returns the doc-module as canonical AST bytes.
  project: func(program: ast-bytes, module-name: string) -> ast-bytes;
}

// The reducer-facing world: a component that imports cadenza-syntax gets the front-end (parse), the
// structural query engine (query), and syntax-only doc extraction (doc) — all pure, all bytes-in /
// bytes-out. A reducer `import`s this (under its content-addressed name); the leaves-first compose
// links it with no host mechanism.
world syntax {
  export types;
  export parse;
  export query;
  export doc;
}
