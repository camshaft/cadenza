// The compiler's derivation interface (build-tool-interface.md; bootstrap.md §"The Self-Hosted
// Compiler Is Authored In Cadenza"). The SAME world the Cadenza-authored compiler will export,
// so the one host runs either component interchangeably.
package cadenza:compiler;

interface compile {
  // A machine-readable diagnostic (constitution XI): a stable code plus a human message. No
  // span yet — the seed works on the canonical AST, which carries no source text.
  record diagnostic {
    code: string,
    message: string,
  }

  // Compile a program's canonical binary AST to its complete component bytes on success, or a
  // list of diagnostics on rejection. The result type distinguishes a well-typed program that
  // produced a component from an ill-typed one that was refused (never an opaque empty byte
  // sequence); a not-yet-lowered construct is a diagnostic whose code marks it a decline.
  compile: func(ast: list<u8>) -> result<list<u8>, list<diagnostic>>;
}

world compiler {
  export compile;
}
