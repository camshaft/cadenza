// The compiler's derivation interface (build-tool-interface.md; bootstrap.md §"The Self-Hosted
// Compiler Is Authored In Cadenza"). This is the SAME world the Cadenza-authored compiler
// exports — so the one host runs cdz-rustc's component and, later, the Cadenza compiler's
// component interchangeably.
package cadenza:compiler;

// A machine-readable diagnostic (constitution XI): a stable code plus a human message. A span
// is omitted for now — the seed works on the canonical AST which carries no source text.
record diagnostic {
  code: string,
  message: string,
}

world compiler {
  // Compile a program's canonical binary AST to its complete component bytes on success, or a
  // list of diagnostics on rejection. The result type distinguishes a well-typed program that
  // produced a component from an ill-typed program that was refused (never an opaque empty
  // byte sequence). A construct the compiler does not yet lower is reported as a diagnostic
  // whose code marks it a decline (todo), distinct from a type-error rejection.
  export compile: func(ast: list<u8>) -> result<list<u8>, list<diagnostic>>;
}
