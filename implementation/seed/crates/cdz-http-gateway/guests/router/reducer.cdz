// The ROUTER as a governing program (DESIGN-http-outpost.md §4, P2): routing lifted out of gateway Rust
// code into a shipped wasm reducer, so "which handler serves this request" is a FOLD, not host code — the
// design's "bake in as little as possible" cut (§1: everything above the socket is a governing program).
//
// v0 is a STATELESS fold with the route table BAKED IN at compile time (concierge decision 2026-09-10,
// option B): there is no state/KV capability in any guest yet, and the design already homes a LIVE/updatable
// table in P3 (the control-link ships a route-table frame the router folds into its KV state) — so P2 proves
// only the routing-as-a-fold thesis and P3 adds the first state/KV-importing guest. The table here is
// therefore expressed directly as a nested `match` on (method, path): the route table IS the fold.
//
// On an `http-request` (decoded via the proven forward-path codec, cf. http-echo), the router matches
// `(method, path)` and closes with a routing `Decision`: `Route(handler, contract)` naming the handler
// component the gateway then spawns, or `NotFound` (the gateway synthesizes the 404 floor). The handler
// hashes below are DOCUMENTED PLACEHOLDERS (33-byte markers) — the runtime-composition/wiring slice replaces
// them with the deployment's real handler `ProgramHash`es (or a route-key the gateway maps); this slice
// proves the fold compiles to a valid reducer component.
//
// Self-contained like http-echo / ws-echo: inline `reducer-world` + own types; `Value.decode(_) :
// Option(Request)` decodes the request type-directed, `Value.encode` renders the decision.
world reducer-world =
  | export guest =
    | on-message : (msg : {contract: list(u8),
                           sender: {reducer: list(u8), host: list(u8)},
                           payload: list(u8),
                           token: list(u8)})
                 -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                     outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-response : (resp : {contract: list(u8),
                             token: list(u8),
                             answer: result(list(u8), variant(timeout, missing-handler, schema-violation, faulted))})
                  -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                      outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-notification : (note : {contract: list(u8), payload: list(u8)})
                      -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                          outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}

type Outcome =
  | Continue
  | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

// The request the router folds (mirrors contracts/userspace/http-request.cdz; same shape http-echo decodes).
type Method = | Get | Post | Put | Delete | Patch | Head | Options
type Header  = | Header(Record(name: String, value: String))
type Request =
  | Request(Record(method: Method,
                   path: String,
                   query: String,
                   headers: List(Header),
                   body: Bytes))

// The routing decision the router closes with: the matched handler component + the contract-id it folds.
// A SINGLE-constructor sum (→ a plain record value form): no-match is encoded as an EMPTY `handler` (the
// gateway reads that as "no route" → its 404 floor). This is a deliberate v0 shape: `Value.encode` of a
// MULTI-constructor sum is declined by the guest compiler (CDZ0900 "matching a compound value needs a heap
// walk" — the wasm-target lowering has no runtime variant-tag walk yet), so the router cannot close with a
// `Route(..) | NotFound` sum; the empty-handler sentinel keeps the decision a single-ctor record it CAN
// encode. (A richer decision sum is unblocked when the guest compiler grows multi-ctor `Value.encode`.)
type Decision =
  | Decision(Record(handler: Bytes, contract: Bytes))

// The schema marker the decision closes under (33-byte contract-id marker = Hash::LEN).
def route-decision-schema() = b"cdz-platform.http.route.........."

// The no-match decision: an empty handler → the gateway synthesizes the 404 floor.
def not-found() = Decision.Decision({ handler = b"", contract = b"" })

// The contract-id a matched handler folds its request on — every route serves the http-request contract in
// v0 (33 bytes). (A later slice may route different contracts per handler, e.g. an MCP vs an HTML handler.)
def request-contract() = b"cdz-platform.http.request........"

// Baked handler-component markers (33-byte PLACEHOLDERS; the wiring slice swaps in real ProgramHashes).
def handler-root() = b"cdz-http.handler.root............"
def handler-echo() = b"cdz-http.handler.echo............"

// Close with a routing decision.
def decide(decision) =
  { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
    outcome = Outcome.Close({ schema = route-decision-schema(), reason = Value.encode(decision) }) }

// The route table AS A FOLD: match method (an enum), then compare the path. Path comparison is on BYTES
// (`String.to-bytes(path) == b"..."`), NOT on the String directly: runtime String equality/`match` is
// declined by the wasm-target guest compiler (CDZ0900 heap-walk), but Bytes value-equality lowers fine, so
// bytes-equality is the working idiom for path routing. First arm wins; any unlisted (method, path) →
// not-found (empty handler).
// (`method`/`path` MUST be annotated: an unannotated param makes `match method` see a generic/compound
// value → CDZ0900 "heap walk"; the annotation grounds it to the `Method` enum → a scalar switch.)
def route(method: Method, path: String) =
  (match method with
   | Get =>
     if String.to-bytes(path) == b"/" then Decision.Decision({ handler = handler-root(), contract = request-contract() })
     else if String.to-bytes(path) == b"/echo" then Decision.Decision({ handler = handler-echo(), contract = request-contract() })
     else not-found()
   | Post =>
     if String.to-bytes(path) == b"/echo" then Decision.Decision({ handler = handler-echo(), contract = request-contract() })
     else not-found()
   | _ => not-found())

def on-message(msg) =
  (match (Value.decode(msg.payload) : Option(Request)) with
   | Some(Request.Request(r)) => decide(route(r.method, r.path))
   | None => decide(not-found()))

def on-response(_resp: Record(contract: Bytes, token: Bytes, answer: Result(Bytes, Error))) =
  { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
    outcome = Outcome.Continue }
def on-notification(_note: Record(contract: Bytes, payload: Bytes)) =
  { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
    outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
