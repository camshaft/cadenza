// P3 state-import BUILD-PATH probe (DESIGN-http-outpost.md §3/§4): the FIRST http-outpost guest to hold
// STATE across folds via the platform `state` KV capability — the mechanism the stateful router (P3b) needs.
//
// Unlike the stateless inline guests (http-echo / ws-echo / router), a host-import-calling guest CANNOT
// declare the import inline: it targets the external `reducer-world` witWorld artifact (which carries the
// `import state` declaration) and pulls the shared `reducer-lib` scaffolding (Outcome + the inert handlers)
// — the idiom the platform's `reducer-world` guests use (e.g. reducer-statedispatch-cdz). This one round-
// trips a value THROUGH state: it `state.put`s the message payload under a fixed key, then `state.get`s it
// back and closes with it — proving state persists across the get/put and that the build path (witWorld +
// reducer-lib libs) works in the cdz-http-gateway crate, ahead of the real stateful router.
import { Outcome, on-response, on-notification } from "reducer-lib"

// The `host state in ( … )` grant exposes the `state` capability (get/put/delete over `list(u8)`) the
// external reducer-world imports; `;` sequences the write before the read-back.
def on-message(msg) =
  host state in
    (state.put(b"cell", msg.payload) ;
     (match state.get(b"cell") with
      | Some(v) =>
        { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
          outcome = Outcome.Close({ schema = msg.contract, reason = v }) }
      | None =>
        { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
          outcome = Outcome.Close({ schema = msg.contract, reason = b"missing" }) }))

export { on-message, on-response, on-notification }
