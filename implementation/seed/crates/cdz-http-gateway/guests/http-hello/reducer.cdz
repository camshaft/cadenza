// The inline-PoC HTTP handler (DESIGN-http-outpost.md §7): a content-addressed wasm reducer that folds an
// `http-request` and answers a fixed `200 text/plain "hello from a wasm handler"` PURELY in on-message —
// no effects, closes immediately. The smallest handler that proves the whole spine end-to-end:
// edge -> router -> spawn -> fold -> response -> socket, with a REAL wasm reducer (not a native stub).
//
// Self-contained (no `libs`, no external WIT-world artifact): it declares the `reducer-world` inline (the
// WIT-typed guest boundary the platform host binds — copied verbatim from guests/inline/reducer-echo-cdz)
// and its own `Outcome`/`Response`/`Header` types, so it compiles with a bare
// `cdz compile reducer.cdz --target wasm`. `Value.encode` (the guest value-codec intrinsic, cf.
// checker-lib's `Value.encode(Verdict.Verdict(...))`) renders the Response in the canonical value form the
// gateway's Rust `decode_response` reads — the one codec across the Cadenza<->Rust boundary. The closing
// `schema` is the http-response contract-id; a literal marker suffices here (the edge reads the reason, and
// the PoC needs no descriptor machinery), the real id rides the route table's `contract` field later.
world reducer-world =
  | export guest =
    | on-message : (msg : {contract: list(u8),
                           sender: {reducer: list(u8), host: list(u8)},
                           payload: list(u8),
                           token: list(u8)})
                 -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                     outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-response : (resp : {contract: list(u8),
                             token: list(u8),
                             answer: result(list(u8), variant(timeout, missing-handler, schema-violation, faulted))})
                  -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                      outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-notification : (note : {contract: list(u8), payload: list(u8)})
                      -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                          outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}

type Outcome =
  | Continue
  | Close(Record(schema: Bytes, reason: Bytes))

// The runtime message-fold error sum (a reducer's response `answer` is `Result(payload, Error)`) — declared
// so the inert on-response's parameter can be annotated to its concrete boundary shape (the CDZ0201
// parameter-synthesis remedy; a boundary parameter never fixed by inference must be annotated).
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

// The http-response value the gateway's decode_response reads — same shape as
// cdz-platform/contracts/userspace/http-response.cdz (Header single-ctor; status Int64).
type Header   = | Header(Record(name: String, value: String))
type Response =
  | Response(Record(status: Int64,
                    headers: List(Header),
                    body: Bytes))

def on-message(_msg) =
  let resp = Response.Response({ status = 200,
                                 headers = [Header.Header({ name = "content-type", value = "text/plain" })],
                                 body = b"hello from a wasm handler" }) in
  // The PoC emits no requests. An empty `[]` alone is `List Any` (which cannot cross the host boundary);
  // annotate it to the world's request-record type so the boundary is concrete (the inert handlers then
  // infer the same element type).
  { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
    outcome = Outcome.Close({ schema = b"cdz-platform.http.response", reason = Value.encode(resp) }) }

def on-response(_resp: Record(contract: Bytes, token: Bytes, answer: Result(Bytes, Error))) =
  { requests = [], outcome = Outcome.Continue }
def on-notification(_note: Record(contract: Bytes, payload: Bytes)) =
  { requests = [], outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
