// A WebSocket SESSION guest (DESIGN-http-outpost.md §6): the Cadenza analogue of http-echo, but for a
// per-connection WebSocket session rather than a per-request handler. Unlike an http handler (spawned per
// request, folds one `http-request` -> `http-response`), a ws session is spawned ONCE per connection and
// folds a stream of `ws-event`s: a `Connect`, then a `Frame` per inbound WebSocket frame, then a
// `Disconnect`. It PUSHES frames back by emitting `ws-send` effects (a request on the ws-send contract-id).
//
// This one ECHOES: every inbound `Frame` is pushed straight back as a `ws-send` carrying the same conn+data
// (Continue — the session stays open), `Connect` opens quietly, and `Disconnect` closes the session
// (`Break`). It proves BOTH ws codec directions across the Cadenza<->Rust boundary: `Value.decode`s the
// gateway's encoded `ws-event` (forward path) and `Value.encode`s a `ws-send` the gateway's Rust
// `decode_ws_send` reads (reverse path) — the ws counterpart of what http-echo proves for request/response.
//
// Self-contained like http-hello / http-echo: inline `reducer-world` + own Event/Send/Outcome/Error types;
// `Value.decode(_) : Option(Event)` decodes type-directed, `Value.encode` renders the ws-send push.
world reducer-world =
  | export guest =
    | on-message : (msg : {contract: list(u8),
                           sender: {reducer: list(u8), host: list(u8)},
                           payload: list(u8),
                           token: list(u8)})
                 -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                     outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-response : (resp : {contract: list(u8),
                             token: list(u8),
                             answer: result(list(u8), variant(timeout, missing-handler, schema-violation, faulted))})
                  -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                      outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-notification : (note : {contract: list(u8), payload: list(u8)})
                      -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                          outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}

type Outcome =
  | Continue
  | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

// The inbound ws-event (mirrors contracts/userspace/ws-event.cdz): a multi-constructor sum. `conn` is the
// opaque connection id the edge assigns; `data` is one frame's bytes.
type Event =
  | Connect(Record(conn: Bytes))
  | Frame(Record(conn: Bytes, data: Bytes))
  | Disconnect(Record(conn: Bytes))
// The outbound ws-send effect (mirrors contracts/userspace/ws-send.cdz): push `data` to connection `conn`.
type Send = | Send(Record(conn: Bytes, data: Bytes))

// The ws-send contract-id the edge routes a pushed frame on (a 33-byte contract-id marker = Hash::LEN; the
// gateway's WsSession filters a session's emitted requests to exactly this id). Must match the send_contract
// the edge opens the session with.
def ws-send-contract() = b"cdz-platform.ws.send............."

// Push one frame back to `conn` as a ws-send request, keeping the session open (Continue).
def echo(conn, data) =
  let send = Send.Send({ conn = conn, data = data }) in
  { requests = [{ contract = ws-send-contract(), payload = Value.encode(send), token = b"", deadlineNanos = None }],
    outcome = Outcome.Continue }

// Emit nothing, stay open.
def quiet() =
  { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
    outcome = Outcome.Continue }

def on-message(msg) =
  (match (Value.decode(msg.payload) : Option(Event)) with
   | Some(Event.Frame(f)) => echo(f.conn, f.data)
   | Some(Event.Connect(_)) => quiet()
   | Some(Event.Disconnect(_)) =>
     { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
       outcome = Outcome.Close({ schema = b"cdz-platform.ws.send.............", reason = b"" }) }
   | None => quiet())

def on-response(_resp: Record(contract: Bytes, token: Bytes, answer: Result(Bytes, Error))) =
  { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
    outcome = Outcome.Continue }
def on-notification(_note: Record(contract: Bytes, payload: Bytes)) =
  { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
    outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
