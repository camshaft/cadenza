// The DYNAMIC router governing program (DESIGN-http-outpost.md §3/§4, P3b — the pivot): routing-as-a-fold
// over a LIVE route table, WITHOUT the `state` host capability. The gateway holds the current route-table
// frame (fetched over the control link, control_link.rs) and delivers it to the router IN THE MESSAGE
// alongside the request — a `RouteQuery{ request, table }` envelope — so the router is a PURE FUNCTION
// (request, table) -> Decision. A control-shipped table UPDATE just changes what the gateway passes next;
// no per-router state.
//
// WHY not hold the table in KV state (the router-stateful guest)? The wasm-target compiler currently emits
// INVALID wasm for a guest that BOTH grants a host capability (`host state in …`) AND calls a recursive
// heap-value-op helper (the route-table match) — `cdz compile` succeeds silently but `wasm-tools validate`
// rejects the output (i32/i64 mismatch / stack imbalance), so it will not instantiate. Recursion WITHOUT a
// host capability lowers fine (this guest), so passing the table in the payload sidesteps the compiler bug
// while keeping routing-as-a-fold + a live table. (Compiler bug logged for a platform vertical; revisit the
// KV-state design when it is fixed.) Self-contained INLINE world like the P2 `router` guest — no host imports.
world reducer-world =
  | export guest =
    | on-message : (msg : {contract: list(u8),
                           sender: {reducer: list(u8), host: list(u8)},
                           payload: list(u8),
                           token: list(u8)})
                 -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                     outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-response : (resp : {contract: list(u8),
                             token: list(u8),
                             answer: result(list(u8), variant(timeout, missing-handler, schema-violation, faulted))})
                  -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                      outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-notification : (note : {contract: list(u8), payload: list(u8)})
                      -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                          outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}

type Outcome =
  | Continue
  | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

type Method = | Get | Post | Put | Delete | Patch | Head | Options
type Header  = | Header(Record(name: String, value: String))
type Request =
  | Request(Record(method: Method, path: String, query: String, headers: List(Header), body: Bytes))
// One route-table entry (mirrors http-route-table.cdz `Route`): the (method, path) key + handler + contract.
type Route =
  | Route(Record(method: Method, path: String, handler: Bytes, contract: Bytes))
// The routing decision (as in the P2 router): a single-ctor record; an EMPTY `handler` is the no-match
// sentinel (→ the gateway's 404). Single-ctor because the guest compiler declines multi-ctor Value.encode.
type Decision =
  | Decision(Record(handler: Bytes, contract: Bytes))
// The gateway's per-request envelope: the encoded http-request + the current route-table frame bytes.
type RouteQuery =
  | RouteQuery(Record(request: Bytes, table: Bytes))

def route-decision-schema() = b"cdz-platform.http.route.........."
def not-found() = Decision.Decision({ handler = b"", contract = b"" })

// Method equality via a scalar code (matching a typed Method to an Int64 compiles; Int-eq is scalar).
def method-code(m: Method) =
  (match m with | Get => 1 | Post => 2 | Put => 3 | Delete => 4 | Patch => 5 | Head => 6 | Options => 7)

// The route table AS A FOLD: recurse over the decoded routes (no List.fold), first (method, path) match wins.
// Method compared by code (Int64-eq), path by BYTES equality (runtime String-eq is declined; Bytes-eq lowers).
def find(routes: List(Route), mc: Int64, p: Bytes) =
  (match routes with
   | [] => not-found()
   | [head, .. rest] =>
     (match head with
      | Route.Route(r) =>
        if method-code(r.method) == mc then
          (if String.to-bytes(r.path) == p then Decision.Decision({ handler = r.handler, contract = r.contract })
           else find(rest, mc, p))
        else find(rest, mc, p)))

def decide(decision) =
  { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
    outcome = Outcome.Close({ schema = route-decision-schema(), reason = Value.encode(decision) }) }

// Route one request against the shipped table: decode the request (method, path), decode the table
// (List(Route)), match. A malformed envelope / request / table → not-found (→ the gateway's 404).
def route(request: Bytes, table: Bytes) =
  (match (Value.decode(request) : Option(Request)) with
   | Some(Request.Request(rq)) =>
     (match (Value.decode(table) : Option(List(Route))) with
      | Some(routes) => find(routes, method-code(rq.method), String.to-bytes(rq.path))
      | None => not-found())
   | None => not-found())

def on-message(msg) =
  (match (Value.decode(msg.payload) : Option(RouteQuery)) with
   | Some(RouteQuery.RouteQuery(q)) => decide(route(q.request, q.table))
   | None => decide(not-found()))

def on-response(_resp: Record(contract: Bytes, token: Bytes, answer: Result(Bytes, Error))) =
  { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
    outcome = Outcome.Continue }
def on-notification(_note: Record(contract: Bytes, payload: Bytes)) =
  { requests = ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64)))),
    outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
