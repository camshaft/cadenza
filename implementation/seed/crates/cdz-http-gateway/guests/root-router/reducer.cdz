// The ROOT ROUTER governing program (DESIGN-http-outpost-drive-contract.md, redirect inc-4): the dumb
// gateway holds NO route table — per request it drives THIS program, which routes internally. On a match it
// emits a `dispatch` EFFECT (the drive-contract §2 effect vocabulary): "spawn this subprogram, hand it this
// input" — the gateway fetches the handler from the CAS, drives it, and folds its terminal response back to
// this router as `on-response`, which then closes with it. On no match it closes with a `deny` (404).
//
// This is the LOOPING shape (emit an effect on `on-message` + `Continue`, close on `on-response`) — vs the
// one-shot router-dynamic guest that returned a Decision for the gateway to act on. The routing fold itself
// is identical to router-dynamic (decode (method, path), recurse the shipped table, first match wins); the
// difference is the router DRIVES the dispatch rather than handing a decision out. Stateless (the table
// rides in the message as a `RouteQuery{request, table}`, per the P3b pivot) → self-contained INLINE world,
// no `state` host capability, so it sidesteps the host-state+recursion compiler bug (see router-dynamic).
world reducer-world =
  | export guest =
    | on-message : (msg : {contract: list(u8),
                           sender: {reducer: list(u8), host: list(u8)},
                           payload: list(u8),
                           token: list(u8)})
                 -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                     outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-response : (resp : {contract: list(u8),
                             token: list(u8),
                             answer: result(list(u8), variant(timeout, missing-handler, schema-violation, faulted))})
                  -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                      outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-notification : (note : {contract: list(u8), payload: list(u8)})
                      -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                          outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}

type Outcome =
  | Continue
  | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

type Method = | Get | Post | Put | Delete | Patch | Head | Options
type Header  = | Header(Record(name: String, value: String))
type Request =
  | Request(Record(method: Method, path: String, query: String, headers: List(Header), body: Bytes))
// One route-table entry (mirrors http-route-table.cdz `Route`): the (method, path) key + handler + contract.
// `handler` is the target subprogram's ProgramHash bytes (the control server ships real hashes it knows).
type Route =
  | Route(Record(method: Method, path: String, handler: Bytes, contract: Bytes))
// The gateway's per-request envelope: the encoded http-request + the current route-table frame bytes.
type RouteQuery =
  | RouteQuery(Record(request: Bytes, table: Bytes))
// The dispatch effect payload (DESIGN drive-contract §2, codec::DispatchEffect): the subprogram to spawn +
// the bytes handed to it. Single-ctor record → the gateway's decode_dispatch reads it directly.
type DispatchEffect =
  | DispatchEffect(Record(subprogram: Bytes, input: Bytes))
// The deny terminal (codec::Deny): a status + a plain-text reason; the gateway floors it.
type Deny =
  | Deny(Record(status: Int64, reason: Bytes))

// v0 contract-id markers (exactly Hash::LEN = 33 bytes; a guest cannot compute a tagged id at value level).
// These MUST byte-match the Rust side: effects.rs DISPATCH_MARKER + codec.rs HTTP_RESPONSE_MARKER/DENY_MARKER.
def dispatch-contract() = b"cdz.http.dispatch................"
def http-response-schema() = b"cdz-platform.http.response......."
def deny-schema() = b"cdz-platform.http.deny..........."

// The empty requests list, spelled once (the record type the world's `requests` field expects).
def no-requests() =
  ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64))))

// Method equality via a scalar code (matching a typed Method to an Int64 compiles; Int-eq is scalar).
def method-code(m: Method) =
  (match m with | Get => 1 | Post => 2 | Put => 3 | Delete => 4 | Patch => 5 | Head => 6 | Options => 7)

// Close with a `deny` terminal (no matching route → 404, or a failed dispatch → 502).
def deny(status: Int64, reason: Bytes) =
  { requests = no-requests(),
    outcome = Outcome.Close({ schema = deny-schema(),
                              reason = Value.encode(Deny.Deny({ status = status, reason = reason })) }) }

// Emit ONE `dispatch` effect naming `handler` (a real ProgramHash from the table) with `input` (the encoded
// http-request), and Continue — the gateway drives the handler and folds its response into `on-response`.
def dispatch(handler: Bytes, input: Bytes) =
  { requests = [ { contract = dispatch-contract(),
                   payload = Value.encode(DispatchEffect.DispatchEffect({ subprogram = handler, input = input })),
                   token = b"root-dispatch",
                   deadlineNanos = (None : Option(UInt64)) } ],
    outcome = Outcome.Continue }

// The route table AS A FOLD: recurse the decoded routes, first (method, path) match wins → dispatch its
// handler; exhausted → 404 deny. Method by code (Int64-eq), path by BYTES equality (runtime String-eq is
// declined; Bytes-eq lowers). `input` is the encoded http-request, passed through to the matched handler.
def find(routes: List(Route), mc: Int64, p: Bytes, input: Bytes) =
  (match routes with
   | [] => deny(404, b"not found")
   | [head, .. rest] =>
     (match head with
      | Route.Route(r) =>
        if method-code(r.method) == mc then
          (if String.to-bytes(r.path) == p then dispatch(r.handler, input)
           else find(rest, mc, p, input))
        else find(rest, mc, p, input)))

// Route one request against the shipped table: decode the request (method, path) + the table (List(Route)),
// match. A malformed envelope / request / table → 404 deny.
def route(request: Bytes, table: Bytes) =
  (match (Value.decode(request) : Option(Request)) with
   | Some(Request.Request(rq)) =>
     (match (Value.decode(table) : Option(List(Route))) with
      | Some(routes) => find(routes, method-code(rq.method), String.to-bytes(rq.path), request)
      | None => deny(404, b"not found"))
   | None => deny(404, b"not found"))

def on-message(msg) =
  (match (Value.decode(msg.payload) : Option(RouteQuery)) with
   | Some(RouteQuery.RouteQuery(q)) => route(q.request, q.table)
   | None => deny(404, b"not found"))

// The dispatched handler's terminal response folds back here: close with it as the http-response (its own
// normal + error responses are its business); a runtime dispatch failure (Err) → a 502 deny.
def on-response(resp: Record(contract: Bytes, token: Bytes, answer: Result(Bytes, Error))) =
  (match resp.answer with
   | Ok(response) => { requests = no-requests(),
                       outcome = Outcome.Close({ schema = http-response-schema(), reason = response }) }
   | Err(_) => deny(502, b"bad gateway"))

def on-notification(_note: Record(contract: Bytes, payload: Bytes)) =
  { requests = no-requests(), outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
