// Shared library for the §9 conformance CHECKER guests (design/cadenza-platform.md §9). A checker is a
// reducer-shaped wasm guest delivered the whole run's serialized observation log on the `check` contract; it
// decodes the log, judges it, and emits a `verdict` request the harness reads. Every checker repeated the
// SAME plumbing — the check/verdict/log-schema imports, the verdict-request builder, the pass/fail `Verdict`
// encoders, and the whole decode-the-Envelope-then-decode-the-log body — differing only in its JUDGEMENT
// predicate + fail message. This module factors that out; a checker imports `interpret`/`pass`/`fail`/
// `verdict-req` from here (composed in via its `libs` manifest, same mechanism as reducer-multifile-cdz).
//
// WHY `interpret` returns a `Decision` rather than the reducer's `{ requests, outcome }` directly: the guest's
// three exports (on-message/on-response/on-notification) all return a reducer Outcome, and the world-export
// boundary fixes their (often unused) parameter types only when that Outcome sum is declared IN the guest
// module and shared across all three (a cross-module imported Outcome, or a different Outcome per export,
// leaves the boundary parameter ambiguous — CDZ0201). So the guest keeps its own local Outcome and builds
// `{ requests, outcome }` itself; `interpret` owns everything up to that point and hands back a `Decision` the
// guest maps in three lines. `Decision` is matched INSIDE the guest (never at the export boundary), exactly
// like the log-schema `Entry`/`LogRecord` sums the checkers already import and match, so it composes.
import { Envelope } from "check"
import { Verdict } from "verdict"
import { LogRecord } from "log-schema"
// The reducer-interface scaffolding (Outcome, Error, the two inert handlers) is owned by reducer-lib — the
// shared base every reducer guest uses. checker-lib layers the check/verdict machinery on top and re-exports
// the scaffolding so a checker imports everything it needs from one place.
import { Outcome, on-response, on-notification } from "reducer-lib"

// The outcome of interpreting a delivered message: emit a verdict (on `contract`, carrying `payload`) then
// continue, or close because the message was not a `check` Envelope (a checker only understands `check`).
type Decision =
  | Report(Record(contract: Bytes, payload: Bytes))
  | NotCheck(Record(schema: Bytes, reason: Bytes))

// Verdict payload encoders: a clean pass (no messages), or a fail carrying one diagnostic message.
def pass() = Value.encode(Verdict.Verdict({ pass = true, messages = [] }))
def fail(msg) = Value.encode(Verdict.Verdict({ pass = false, messages = [msg] }))

// A verdict request on the harness-provided verdict contract-id (the §9 protocol: the harness owns the verdict
// contract and passes it in the incoming `check` Envelope, so no hardcoded hash). The token is irrelevant —
// the harness reads the verdict by scanning Emitted on the verdict contract — so b"".
def verdict-req(verdict-contract, payload) =
  { contract = verdict-contract, payload = payload, token = b"", deadlineNanos = None }

// Interpret a delivered message: decode the `check` Envelope, decode the observation log it carries, hand the
// decoded records to the checker's `judge` (records -> verdict-payload Bytes), and Report the verdict on the
// harness-provided verdict contract. A log that doesn't decode Reports a fixed-diagnostic fail; a non-check
// message Closes. The guest maps this Decision onto its own reducer Outcome.
def interpret(msg: Record(contract: Bytes, payload: Bytes, sender: Record(host: Bytes, reducer: Bytes), token: Bytes), judge) =
  match (Value.decode(msg.payload) : Option(Envelope)) with
  | Some(Envelope.Check(c)) =>
      (match (Value.decode(c.log) : Option(List(LogRecord))) with
       | Some(records) => Decision.Report({ contract = c.verdict, payload = judge(records) })
       | None => Decision.Report({ contract = c.verdict, payload = fail("observation log did not decode") }))
  | None =>
      Decision.NotCheck({ schema = msg.contract, reason = msg.payload })

// The FULL reducer step a checker's on-message returns: run `interpret`, then map its Decision onto the reducer
// Outcome (lib-owned). A checker's on-message is now one line: `def on-message(msg) = respond(msg, verdict-payload)`.
def respond(msg: Record(contract: Bytes, payload: Bytes, sender: Record(host: Bytes, reducer: Bytes), token: Bytes), judge) =
  match interpret(msg, judge) with
  | Decision.Report(r) =>
      // Ascribe `r` to the `Decision.Report` record shape: the world-export boundary can leave a local-sum
      // variant payload's field-access inference under-constrained (it collapses `r` to `Bytes` in some
      // checker guests → CDZ0201 "a Bytes value has no field payload"), the same parameter-synthesis
      // fragility reducer-lib's annotated `on-response`/`on-notification` remedy — so pin the type here.
      let rr = (r : Record(contract: Bytes, payload: Bytes)) in
      { requests = [verdict-req(rr.contract, rr.payload)], outcome = Outcome.Continue }
  | Decision.NotCheck(cl) =>
      let cc = (cl : Record(schema: Bytes, reason: Bytes)) in
      { requests = [], outcome = Outcome.Close({ schema = cc.schema, reason = cc.reason }) }


// ── Log-iteration combinators — make a checker DECLARATIVE: it says WHAT to find in the observation log, the
// index-recursion lives here. Every combinator takes ordinary NAMED field-extractor functions (no captured
// state) operating on the UNWRAPPED per-record `rec` (the record inside a LogRecord.LogRecord), the same shape
// checkers already destructure — so they compose into the guest via `libs` with no export-boundary risk.

// Does some record satisfy `pred`? (a single existence scan over the whole log.) `pred: rec -> Bool`.
def any-record-from(records, i, pred) =
  match List.at(records, i) with
  | Option.None(_) => false
  | Option.Some(LogRecord.LogRecord(rec)) =>
      if pred(rec) then true else any-record-from(records, i + 1, pred)
def any-record(records, pred) = any-record-from(records, 0, pred)

// How many records satisfy `pred`? (`pred: rec -> Bool`.) The counting companion to `any-record`, for checks
// that assert an EXACT number of matching events (e.g. "exactly 2 children closed", "5 notifications"), not
// just existence. Self-threaded like any-record; acc annotated Int64 so the recursive param's width is pinned.
def count-from(records, i, pred, acc: Int64) =
  match List.at(records, i) with
  | Option.None(_) => acc
  | Option.Some(LogRecord.LogRecord(rec)) =>
      count-from(records, i + 1, pred, if pred(rec) then acc + 1 else acc)
def count(records, pred) = count-from(records, 0, pred, 0)

// Relational JOIN on a Bytes key: does some record from which `left` yields Some(k) share that key k with some
// record from which `right` yields Some(k')? `left`,`right: rec -> Option(Bytes)`. This is the declarative form
// of the recurring "for each X, is there a matching Y on a shared field" nested scan.
//
// Implementation note: each extractor is consumed by ONE self-recursive `collect` pass into a `List(Bytes)`
// (the same singly-threaded HOF shape as `any-record`, which the compiler specializes) — we do NOT thread an
// extractor through a second data-carrying helper, which would force a first-class closure over the
// non-machine-representable per-record type. The join itself is then pure `Bytes`-list intersection, no HOF.
def collect-from(records, i, extract, acc) =
  match List.at(records, i) with
  | Option.None(_) => acc
  | Option.Some(LogRecord.LogRecord(rec)) =>
      (match extract(rec) with
        | Option.Some(k) => collect-from(records, i + 1, extract, List.push(acc, k))
        | Option.None(_) => collect-from(records, i + 1, extract, acc))
def collect(records, extract) = collect-from(records, 0, extract, ([] : List(Bytes)))

def mem(ys, j, x) =
  match List.at(ys, j) with
  | Option.None(_) => false
  | Option.Some(y) => if y == x then true else mem(ys, j + 1, x)
def any-common(xs, i, ys) =
  match List.at(xs, i) with
  | Option.None(_) => false
  | Option.Some(x) => if mem(ys, 0, x) then true else any-common(xs, i + 1, ys)

def join-exists(records, left, right) =
  any-common(collect(records, left), 0, collect(records, right))

// Relational JOIN on a TWO-field key (e.g. a correlation of contract + token, or contract + payload): same
// collect-then-pure-intersection shape as `join-exists`, but keys are `Pair`s compared on both fields.
// `left`,`right: rec -> Option(Pair)`; build a key with the `pair(a, b)` helper.
type Pair = | Pair(Record(a: Bytes, b: Bytes))
def pair(a, b) = Pair.Pair({ a = a, b = b })
def pair-eq(x, y) =
  match x with | Pair.Pair(p) => (match y with | Pair.Pair(q) => p.a == q.a and p.b == q.b)
// The Pair recursive helpers are annotated to their concrete `Pair`/`List(Pair)` types: a user-sum element
// threaded through a recursive accumulator is not pinned by the body alone, so without the annotation this
// hits the recursive-generic monomorphization tie (the Bytes helpers above escape it only because a Bytes
// ascription flows in). Annotating makes each helper monomorphic.
def collect-pairs-from(records, i: Int64, extract, acc: List(Pair)) =
  match List.at(records, i) with
  | Option.None(_) => acc
  | Option.Some(LogRecord.LogRecord(rec)) =>
      (match extract(rec) with
        | Option.Some(p) => collect-pairs-from(records, i + 1, extract, List.push(acc, p))
        | Option.None(_) => collect-pairs-from(records, i + 1, extract, acc))
def collect-pairs(records, extract) = collect-pairs-from(records, 0, extract, ([] : List(Pair)))
def mem-pair(ys: List(Pair), j: Int64, x: Pair) =
  match List.at(ys, j) with
  | Option.None(_) => false
  | Option.Some(y) => if pair-eq(x, y) then true else mem-pair(ys, j + 1, x)
def any-common-pair(xs: List(Pair), i: Int64, ys: List(Pair)) =
  match List.at(xs, i) with
  | Option.None(_) => false
  | Option.Some(x) => if mem-pair(ys, 0, x) then true else any-common-pair(xs, i + 1, ys)
def join-pair(records, left, right) =
  any-common-pair(collect-pairs(records, left), 0, collect-pairs(records, right))

// Positional ordering: does some record satisfying `first` occur BEFORE some record satisfying `second`?
// `first`,`second: rec -> Bool`. Collects the matching INDICES (self-threaded scan) into two `List(Int64)`s,
// then asks — with pure Int64-list ops — whether some first-index precedes some second-index.
def collect-idx-from(records, i, pred, acc) =
  match List.at(records, i) with
  | Option.None(_) => acc
  | Option.Some(LogRecord.LogRecord(rec)) =>
      if pred(rec) then collect-idx-from(records, i + 1, pred, List.push(acc, i))
      else collect-idx-from(records, i + 1, pred, acc)
def collect-idx(records, pred) = collect-idx-from(records, 0, pred, ([] : List(Int64)))
// `x`/`ys` are annotated Int64: index comparison `>` is width-polymorphic, so nothing in the body pins the
// recursive parameter's width — without the annotation this hits the recursive-generic monomorphization tie.
def any-gt(ys: List(Int64), j: Int64, x: Int64) =
  match List.at(ys, j) with
  | Option.None(_) => false
  | Option.Some(y) => if y > x then true else any-gt(ys, j + 1, x)
def any-precedes(xs: List(Int64), i: Int64, ys: List(Int64)) =
  match List.at(xs, i) with
  | Option.None(_) => false
  | Option.Some(x) => if any-gt(ys, 0, x) then true else any-precedes(xs, i + 1, ys)
def ordered(records, first, second) =
  any-precedes(collect-idx(records, first), 0, collect-idx(records, second))

// `Decision`/`interpret`/`verdict-req` are the pre-`respond` (round-2) surface, kept exported ONLY so the
// in-flight reducer-blobs-check-cdz (#3230, merge-ready in round-2 form) still resolves after it merges; once
// v-platform-itest migrates blobs onto `respond` + `join-exists`, these three come off the export list (no
// on-main checker imports them — they now build against `respond`).
export { respond, on-response, on-notification, pass, fail, any-record, count, join-exists, Pair.*, pair, join-pair, ordered, Decision.*, interpret, verdict-req }
