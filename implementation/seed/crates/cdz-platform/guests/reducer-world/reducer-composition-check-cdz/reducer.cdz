// The WIT-ABI COMPOSITION checker (design/cadenza-platform.md §9) — the assertion half of the migrated
// v-rb "WIT composition" test (closed #3249). The paired guest (reducer-composition-cdz) performs, in one
// fold across TWO host interfaces, graph.neighbors (enum arg Dir.Outgoing in, list result out) and state.get
// (option result out, matched), then emits. This checker asserts the composition happened, LOG-ONLY and
// guest-agnostic.
//
// JUDGEMENT: pass iff the log contains ALL of — a GraphNeighbors with dir == "outgoing" (the enum arg
// marshalled and crossed), a KvGet (state.get, the option-result path was taken), and an Emitted request (the
// guest ran to completion, so the list result lifted and the option matched without trapping). All three are
// load-bearing: a broken enum-arg / list-result / option-result marshalling makes the guest trap or fail to
// instantiate, so one or more would be absent and the check fails. NON-VACUOUS by construction. Imports the
// three standard schemas; settled idioms (List.at-None ends the walk; LogRecord destructured in the Some arm;
// conditions folded into match guards).
import { Envelope } from "check"
import { Verdict } from "verdict"
import { LogRecord, Entry } from "log-schema"

type Outcome = | Continue | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

// Does some GraphNeighbors read carry dir == "out"? (the enum arg Dir.Outgoing marshalled and crossed.) The
// recorded dir string is the crate's canonical form "out"/"in" (log_value.rs dir_str), since the host maps
// the WIT enum Outgoing -> crate::Dir::Out; the checker matches that recorded form, not the WIT case name.
def has-neighbors-outgoing(records: List(LogRecord), i: Int64) =
  match List.at(records, i) with
  | Option.None(_) => false
  | Option.Some(LogRecord.LogRecord(rec)) =>
      (match rec.entry with
        | Entry.GraphNeighbors(n) if (n.dir == "out") => true
        | _ => has-neighbors-outgoing(records, i + 1))

// Does some KvGet appear? (state.get was performed — the option-result path.)
def has-kv-get(records: List(LogRecord), i: Int64) =
  match List.at(records, i) with
  | Option.None(_) => false
  | Option.Some(LogRecord.LogRecord(rec)) =>
      (match rec.entry with
        | Entry.KvGet(_) => true
        | _ => has-kv-get(records, i + 1))

// Does some Emitted request appear? (the guest ran to completion: list result lifted, option matched.)
def has-emitted(records: List(LogRecord), i: Int64) =
  match List.at(records, i) with
  | Option.None(_) => false
  | Option.Some(LogRecord.LogRecord(rec)) =>
      (match rec.entry with
        | Entry.Emitted(_) => true
        | _ => has-emitted(records, i + 1))

def composed(records: List(LogRecord)) =
  has-neighbors-outgoing(records, 0) and has-kv-get(records, 0) and has-emitted(records, 0)

def verdict-payload(records: List(LogRecord)) =
  if composed(records)
  then Value.encode(Verdict.Verdict({ pass = true, messages = [] }))
  else Value.encode(Verdict.Verdict({ pass = false,
                                      messages = ["the composition did not fully execute: expected a GraphNeighbors(dir=outgoing) + a KvGet + an Emitted (enum-arg / list-result / option-result marshalling across two host interfaces)"] }))

def verdict-req(verdict-contract: Bytes, payload: Bytes) =
  { contract = verdict-contract, payload = payload, token = b"", deadlineNanos = None }

def on-message(msg) =
  match (Value.decode(msg.payload) : Option(Envelope)) with
  | Some(Envelope.Check(c)) =>
      (match (Value.decode(c.log) : Option(List(LogRecord))) with
       | Some(records) =>
           { requests = [verdict-req(c.verdict, verdict-payload(records))], outcome = Outcome.Continue }
       | None =>
           { requests = [verdict-req(c.verdict,
                                     Value.encode(Verdict.Verdict({ pass = false,
                                                                    messages = ["observation log did not decode"] })))],
             outcome = Outcome.Continue })
  | None =>
      { requests = [], outcome = Outcome.Close({ schema = msg.contract, reason = msg.payload }) }

def on-response(_resp) = { requests = [], outcome = Outcome.Continue }
def on-notification(_note) = { requests = [], outcome = Outcome.Continue }
export { on-message, on-response, on-notification }
