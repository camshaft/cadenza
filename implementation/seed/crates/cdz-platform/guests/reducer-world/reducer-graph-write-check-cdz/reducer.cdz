// The §7 GRAPH-WRITE checker (design/cadenza-platform.md §7/§9) — the assertion half of the migrated
// set-edges emit test. The paired guest (reducer-graph-write-cdz) performs one graph.set-edges(from, kind,
// targets) with from = its sender's ReducerId and targets = [that same ReducerId]. This checker asserts the
// write was OBSERVED with its list<reducer-id> argument intact, LOG-ONLY and guest-agnostic.
//
// JUDGEMENT: pass iff some GraphSetEdges(from = F, targets = [T, ..]) has its FIRST target T == F. Since the
// guest passes the same ReducerId as both `from` and the sole target, a match proves (a) the set-edges write
// reached the recorder (so its args parsed — a valid ReducerId, not a short token), and (b) the
// list<reducer-id> argument round-tripped the id value through the host boundary. RELATIONAL on the
// run-controlled id, no hardcoded bytes. NON-VACUOUS: a guest that fails to instantiate, or a set-edges whose
// args do not parse (the arg-parse-guard boundary), records no GraphSetEdges → fail. Imports the three standard
// schemas; settled idioms (List.at-None ends the walk; LogRecord destructured in the Some arm; condition in a
// match guard).
import { LogRecord, Entry } from "log-schema"
import { respond, on-response, on-notification, pass, fail, any-record } from "checker-lib"

// A GraphSetEdges whose targets[0] equals `from` — the list<reducer-id> arg round-tripped the id the guest
// passed as both `from` and the sole target (a graph WRITE observed with its list argument intact).
def targets-carry-from(s) =
  match List.at(s.targets, 0) with
  | Option.Some(t) => t == s.from
  | Option.None(_) => false
def set-edges-carries-from(rec) =
  match rec.entry with | Entry.GraphSetEdges(s) if targets-carry-from(s) => true | _ => false

def verdict-payload(records: List(LogRecord)) =
  if any-record(records, set-edges-carries-from)
  then pass()
  else fail("no GraphSetEdges with targets[0] == from: the graph-write set-edges call was not observed with its list<reducer-id> argument intact")

def on-message(msg) = respond(msg, verdict-payload)

export { on-message, on-response, on-notification }
