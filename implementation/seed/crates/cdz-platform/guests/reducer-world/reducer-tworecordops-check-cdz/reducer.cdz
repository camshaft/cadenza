// The TWO-RECORD-OPS SEQUENCING checker (design/cadenza-platform.md §9) — the assertion half of the migrated
// v-rb "two record ops in one interface" test. The paired guest (reducer-tworecordops-cdz) performs, in one
// fold, deliver-message THEN deliver-notification; this checker asserts BOTH were observed and IN ORDER: a
// Routed(eventKind="message") precedes a Routed(eventKind="notification"). That ordering is the Core::Seq proof —
// a dropped or reordered second host call leaves no notification-after-message and the check fails. NON-VACUOUS.
// LOG-ONLY and guest-agnostic.
//
// All reducer plumbing (decode the check Envelope, decode the log, emit the verdict, the reducer Outcome, and
// the inert on-response/on-notification) is shared via checker-lib: this file keeps only its JUDGEMENT
// predicates + verdict-payload and delegates on-message to `respond`. See checker-lib.cdz.
//
// eventKind is the recorded canonical string (log_value.rs event_kind_str): the host maps deliver-message ->
// Routed{kind=Message} -> "message" and deliver-notification -> Routed{kind=Notification} -> "notification"
// (recording.rs), so the checker matches those recorded forms, not the WIT op names. `Entry`/`LogRecord` are
// imported sums (variant count invisible to the matcher), so each match has a catch-all `_ =>` arm.
import { LogRecord, Entry } from "log-schema"
import { respond, on-response, on-notification, pass, fail, ordered } from "checker-lib"

// The two sequenced deliver ops, as per-record predicates: a Routed(message) then a Routed(notification).
// `ordered` asks whether some message-routing precedes some notification-routing (deliver-message then
// deliver-notification, in order — the Core::Seq of two host calls).
def is-routed-message(rec) = match rec.entry with | Entry.Routed(rt) if (rt.eventKind == "message") => true | _ => false
def is-routed-notification(rec) = match rec.entry with | Entry.Routed(rt) if (rt.eventKind == "notification") => true | _ => false

// The verdict payload for a decoded log: pass with no messages, else fail with one diagnostic message.
def verdict-payload(records: List(LogRecord)) =
  if ordered(records, is-routed-message, is-routed-notification)
  then pass()
  else fail("expected a Routed(message) then a Routed(notification): the two sequenced deliver ops did not both execute in order")

def on-message(msg) = respond(msg, verdict-payload)

export { on-message, on-response, on-notification }
