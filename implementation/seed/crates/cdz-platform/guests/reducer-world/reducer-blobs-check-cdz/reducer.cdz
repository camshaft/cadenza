// The BLOBS checker (design/cadenza-platform.md §8/§9). The paired guest (reducer-blobs-cdz) stores the
// delivered payload in the content-addressed blob store and reads it straight back by hash; this checker
// asserts that blob round-trip observably happened — LOG-ONLY, guest-agnostic.
//
// Round-3 checker-lib form: judgement is two field extractors + one combinator; respond() owns the decode +
// verdict emit, and the inert on-response/on-notification are re-exported from checker-lib.
//
// JUDGEMENT: pass iff some successful BlobGet(hash = H, hit) shares its hash with a BlobPut(hash = H) — the
// reducer stored bytes (getting hash H) and read them back by H with a hit. RELATIONAL on the content hash,
// no hardcoded value. The hit gate is load-bearing (get-hit-hash yields None unless hit): it catches a
// store that recorded the get but did not persist the put. NON-VACUOUS: a guest that fails to instantiate
// touches no blob store, so no BlobGet(hit) key exists and the check fails.
import { Entry } from "log-schema"
import { respond, on-response, on-notification, pass, fail, join-exists } from "checker-lib"

// A successful BlobGet's hash (None unless hit) — the read side of the round-trip join.
def get-hit-hash(rec) = match rec.entry with | Entry.BlobGet(g) if g.hit => Some(g.hash) | _ => None
// A BlobPut's hash — the store side.
def put-hash(rec) = match rec.entry with | Entry.BlobPut(p) => Some(p.hash) | _ => None

def verdict-payload(records) =
  if join-exists(records, get-hit-hash, put-hash)
  then pass()
  else fail("no BlobGet(hit) shared a hash with a BlobPut: the blob store/read round-trip did not happen")

def on-message(msg) = respond(msg, verdict-payload)
export { on-message, on-response, on-notification }
