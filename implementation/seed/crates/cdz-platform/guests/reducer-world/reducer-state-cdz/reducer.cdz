// A reducer that exercises its durable key-value STATE store ACROSS messages (design/cadenza-platform.md §7):
// the run delivers TWO messages. On the first (the cell is empty) it SETs — writes the delivered payload at a
// fixed key. On the second (the cell now holds the earlier value) it RETURNs — reads that key and echoes the
// stored value as one request. Because the two folds are separate deliveries, a returned value proves the
// store PERSISTED it across messages, not merely within one on-message. The guest branches on the store's own
// state (get -> None = first/set, Some = second/return), so it needs no message tagging. Delegates only
// `state`; a floor import of the reducer world. on-response/on-notification are inert.
type Outcome = | Continue | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

def on-message(msg) =
  host state in
    (match state.get(b"cell") with
      | None(_) =>
          ( state.put(b"cell", msg.payload) ;
            { requests = [], outcome = Outcome.Continue } )
      | Some(v) =>
          { requests = [{ contract = msg.contract, payload = v, token = b"", deadlineNanos = None }],
            outcome = Outcome.Continue })

def on-response(_resp) =
  { requests = [], outcome = Outcome.Continue }

def on-notification(_note) =
  { requests = [], outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
