// The IDENTITY checker, as a Cadenza reducer guest (design/cadenza-platform.md §3/§9). The paired guest
// (reducer-identity-cdz) reads its OWN reducer id (identity.id) and stamps it as the emitted request's token;
// this checker asserts that host value flowed through the guest and back correctly: LOG-ONLY, no identity
// import needed on the checker side.
//
// The shared plumbing (check/verdict imports, the verdict request, the pass/fail encoders, and the whole
// decode-the-Envelope-then-decode-the-log body) lives in checker-lib. This file keeps only the JUDGEMENT
// (`stamped-own-id` + a one-line verdict-payload), the reducer's own Outcome/Error return types, and the
// three-line map of checker-lib's `Decision` onto the reducer Outcome.
//
// JUDGEMENT: pass iff some Emitted whose `token` equals its record's own `source.reducer` — i.e. the reducer
// stamped its OWN id (from identity.id) as the emitted token. Purely relational within the log (the acting
// reducer's id is the record's `source.reducer`, which the harness assigns; the guest cannot forge it), so no
// hardcoded id and no identity import. NON-VACUOUS: a guest that fails to instantiate emits nothing, so no
// such Emitted exists and the check fails; a guest that stamps the wrong token also fails.
import { Entry, LogRecord } from "log-schema"
import { Decision, interpret, verdict-req, pass, fail } from "checker-lib"

// The reducer return types, kept LOCAL: the world-export boundary synthesizes on-response/on-notification's
// (unused) parameter types from the guest's own sums — the response `answer` field is `Result(Bytes, Error)`,
// so `Error` must be declared here even though the checker never constructs it, and `Outcome` must be the sum
// all three exports return. A cross-module import of either leaves the boundary parameter ambiguous (CDZ0201).
type Outcome = | Continue | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

// Does some Emitted record carry a token equal to its own source reducer id? (the guest stamped identity.id.)
def stamped-own-id(records: List(LogRecord), i: Int64) =
  match List.at(records, i) with
  | Option.None(_) => false
  | Option.Some(LogRecord.LogRecord(rec)) =>
      (match rec.entry with
        | Entry.Emitted(e) if (e.token == rec.source.reducer) => true
        | _ => stamped-own-id(records, i + 1))

// The verdict payload for a decoded log: pass with no messages, else fail with one diagnostic message.
def verdict-payload(records) =
  if stamped-own-id(records, 0)
  then pass()
  else fail("no Emitted stamped its own reducer id as its token: identity.id did not flow through")

// Map checker-lib's Decision onto this reducer's Outcome: a Report emits the verdict request and continues; a
// NotCheck (non-check message) closes with the offending schema/reason.
def on-message(msg) =
  match interpret(msg, verdict-payload) with
  | Decision.Report(r) => { requests = [verdict-req(r.contract, r.payload)], outcome = Outcome.Continue }
  | Decision.NotCheck(cl) => { requests = [], outcome = Outcome.Close({ schema = cl.schema, reason = cl.reason }) }

def on-response(_resp) = { requests = [], outcome = Outcome.Continue }
def on-notification(_note) = { requests = [], outcome = Outcome.Continue }
export { on-message, on-response, on-notification }
