// The provenance.program-of arg-parse-guard observation checker (design/cadenza-platform.md §9) — asserts a
// provenance host call the reducer performed with a MALFORMED argument was OBSERVED, not silently dropped
// (the #3272 deliver/provenance extension of the parse-guard seam). Paired guest calls provenance.program-of with a
// short (non-ReducerId) arg; the host early-returns and emits a HostCallRejected. LOG-ONLY, guest-agnostic.
//
// JUDGEMENT: pass iff some HostCallRejected(iface = "provenance", op = "program-of") is recorded. NON-VACUOUS:
// without the host seam (or a well-formed arg) nothing records; the exact iface+op guards against an
// unrelated rejected call. Settled idioms + String equality on the recorded iface/op.
import { LogRecord, Entry } from "log-schema"
import { respond, on-response, on-notification, pass, fail, any-record } from "checker-lib"

// A HostCallRejected recorded at the provenance/program-of parse-guard boundary.
def program-of-rejected(rec) =
  match rec.entry with | Entry.HostCallRejected(r) if (r.iface == "provenance" and r.op == "program-of") => true | _ => false

def verdict-payload(records: List(LogRecord)) =
  if any-record(records, program-of-rejected)
  then pass()
  else fail("no HostCallRejected(provenance, program-of) recorded: a malformed-arg host call was not observed at the parse-guard boundary")

def on-message(msg) = respond(msg, verdict-payload)

export { on-message, on-response, on-notification }
