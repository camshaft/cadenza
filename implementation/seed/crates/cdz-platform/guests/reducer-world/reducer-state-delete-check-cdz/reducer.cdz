// The STATE-DELETE checker (design/cadenza-platform.md §7/§9) — the delete-run counterpart to
// reducer-state-check-cdz. Both drive the SAME reducer (reducer-state-cdz, which exposes set/get/delete); only
// this checker differs. The delete run delivers two messages: the first SETs a value, the second DELETEs it.
// This checker asserts removal was OBSERVABLE across the two messages — LOG-ONLY, guest-agnostic.
//
// JUDGEMENT: pass iff some KvGet(key = K, hit = 0) — a read that MISSED — is matched by a KvDelete(key = K,
// existed = 1) — a delete that removed a real entry: the entry (written on the first message) existed, the
// delete removed it, and the read saw it gone. RELATIONAL on the key; both the miss and the existed flag are
// load-bearing. NON-VACUOUS: a guest that never persists/deletes yields no such pair. Settled idioms.
import { LogRecord, Entry } from "log-schema"
import { respond, on-response, on-notification, pass, fail, join-exists } from "checker-lib"

// The key a KvGet MISSED (hit==0) after removal, and the key a KvDelete removed (existed==1) — `join-exists`
// looks for a miss whose key was deleted, proving the store observably honoured removal across messages. Both
// gates are load-bearing: a get that hit, or a delete of an absent key, yields no key.
def get-miss-key(rec) = match rec.entry with | Entry.KvGet(g) if not(g.hit) => Some(g.key) | _ => None
def delete-existed-key(rec) = match rec.entry with | Entry.KvDelete(dd) if dd.existed => Some(dd.key) | _ => None

def verdict-payload(records: List(LogRecord)) =
  if join-exists(records, get-miss-key, delete-existed-key)
  then pass()
  else fail("no KvGet(miss) matched a KvDelete(existed) of the same key: the state store did not observably honour removal across messages")

def on-message(msg) = respond(msg, verdict-payload)

export { on-message, on-response, on-notification }
