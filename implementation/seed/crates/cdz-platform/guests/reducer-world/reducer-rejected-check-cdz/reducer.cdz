// The ARG-PARSE-GUARD observation checker (design/cadenza-platform.md §9) — asserts that a host call the
// reducer performed with a MALFORMED argument was still OBSERVED, not silently dropped (log-every-host-call).
// The paired guest (reducer-rejected-cdz) calls graph.neighbors with a short (non-ReducerId) node; the host
// early-returns before the recordable capability and emits a HostCallRejected observation via the rejected
// sink. This checker asserts that observation is present, LOG-ONLY and guest-agnostic.
//
// JUDGEMENT: pass iff some HostCallRejected(iface = "graph", op = "neighbors") is recorded — the malformed
// graph.neighbors call was observed at the host boundary. NON-VACUOUS: without the host seam (or if the guest
// had passed a well-formed node), no HostCallRejected is recorded and the check fails; and it names the exact
// interface+op so an unrelated rejected call does not satisfy it. Imports the three standard schemas; settled
// idioms (List.at-None ends the walk; LogRecord destructured in the Some arm; conditions in a match guard;
// String equality on the recorded iface/op — the recorded form is the crate's op spelling, kebab "neighbors").
import { LogRecord, Entry } from "log-schema"
import { Decision, interpret, verdict-req, pass, fail, any-record } from "checker-lib"

type Outcome = | Continue | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

// A HostCallRejected recorded at the graph/neighbors parse-guard boundary.
def neighbors-rejected(rec) =
  match rec.entry with | Entry.HostCallRejected(r) if (r.iface == "graph" and r.op == "neighbors") => true | _ => false

def verdict-payload(records: List(LogRecord)) =
  if any-record(records, neighbors-rejected)
  then pass()
  else fail("no HostCallRejected(graph, neighbors) recorded: a malformed-arg host call was not observed at the parse-guard boundary")

def on-message(msg) =
  match interpret(msg, verdict-payload) with
  | Decision.Report(r) => { requests = [verdict-req(r.contract, r.payload)], outcome = Outcome.Continue }
  | Decision.NotCheck(cl) => { requests = [], outcome = Outcome.Close({ schema = cl.schema, reason = cl.reason }) }
def on-response(_resp) = { requests = [], outcome = Outcome.Continue }
def on-notification(_note) = { requests = [], outcome = Outcome.Continue }
export { on-message, on-response, on-notification }
