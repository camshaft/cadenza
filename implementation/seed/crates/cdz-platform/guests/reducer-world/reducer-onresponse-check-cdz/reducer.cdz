// The ON-RESPONSE checker, as a Cadenza reducer guest (design/cadenza-platform.md §3/§9). The paired guest
// (reducer-onresponse-cdz) reacts on the on-response path: it reads the delivered response's correlation
// (contract + continuation token) and emits one request echoing the TOKEN back as the payload. This checker
// asserts that the response reached the guest and its token field flowed through — LOG-ONLY, guest-agnostic.
//
// Same three schema imports as the other checkers, from their single source of truth: the check Envelope
// (log-in), the verdict Verdict (pass/fail-out), and the log-schema LogRecord/Entry (the decoded log). The
// `libs` manifest beside this file lists their repo-relative paths.
//
// JUDGEMENT: pass iff some Emitted whose `payload` equals some Delivered's `token` — i.e. the reducer emitted
// a request carrying a delivered event's continuation token as its payload. That is exactly what on-response
// handling of reducer-onresponse-cdz produces (echo the response TOKEN, not its payload — distinguishing the
// response path from a plain message-payload echo). RELATIONAL on the run-observed token, no hardcoded id.
// NON-VACUOUS: a guest that fails to instantiate or never folds on-response emits nothing, so no such Emitted
// exists and the check fails. Idiomatic form: List.at-None ends the index walk, the single-constructor
// LogRecord is destructured in the Some arm, and the equality folds into a match guard.
import { LogRecord, Entry } from "log-schema"
import { respond, on-response, on-notification, pass, fail, join-exists } from "checker-lib"

// The token a Delivered event carried, and the payload an Emitted request echoed — the on-response path carries
// the response token through as the emitted payload. `join-exists` looks for an Emitted whose payload equals
// some Delivered's token.
def delivered-token(rec) = match rec.entry with | Entry.Delivered(d) => Some(d.token) | _ => None
def emitted-payload(rec) = match rec.entry with | Entry.Emitted(e) => Some(e.payload) | _ => None

def verdict-payload(records: List(LogRecord)) =
  if join-exists(records, delivered-token, emitted-payload)
  then pass()
  else fail("no Emitted echoed a delivered event's token: the on-response path did not carry the response token through")

def on-message(msg) = respond(msg, verdict-payload)

export { on-message, on-response, on-notification }
