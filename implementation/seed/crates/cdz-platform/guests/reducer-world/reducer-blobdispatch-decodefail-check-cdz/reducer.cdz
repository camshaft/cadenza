// The §4/§8 DECODE-GUARD checker for the multi-contract blob dispatcher (design/cadenza-platform.md §4/§8/§9).
// The happy-path run (reducer-blobdispatch-cdz-run) proves the dispatcher DECODES a well-formed payload by each
// contract's schema and acts (blobs.put/get). This is the negative complement: a message arrives on a RECOGNIZED
// contract (cdz-platform.blob.put — the id guard passes, so this is NOT the unknown-contract path) but with a
// MALFORMED payload that is not a valid PutRequest encoding. The dispatcher's put arm `Value.decode`s it, gets
// None, and rejects with Close(put-decode-failed) rather than storing garbage or trapping — the decode-by-schema
// half of operate-on-contract-id is a real guard, not an assumption.
//
// JUDGEMENT: pass iff some Closed(reason = b"put-decode-failed"). NON-VACUOUS: a dispatcher that decoded garbage
// into a bogus PutRequest (or ignored the decode failure) would blobs.put + emit rather than Close, so no such
// Closed exists; a guest that fails to instantiate performs no Close either. The reason is guest-controlled and
// distinct from the (malformed) payload, so it cannot be echoed vacuously.
import { LogRecord, Entry } from "log-schema"
import { respond, on-response, on-notification, pass, fail, any-record } from "checker-lib"

def closed-put-decode-failed(rec) =
  match rec.entry with
  | Entry.Closed(c) => c.reason == b"put-decode-failed"
  | _ => false

def verdict-payload(records: List(LogRecord)) =
  if any-record(records, closed-put-decode-failed)
  then pass()
  else fail("no Closed b\"put-decode-failed\": the blob.put arm did not reject the malformed payload (decode-by-schema is not a real guard, or the decode trapped instead of returning None)")

def on-message(msg) = respond(msg, verdict-payload)

export { on-message, on-response, on-notification }
