// A reducer that PERFORMS a host import: on-message reads its own reducer id (identity.id — a compound
// list<u8> host result, #3121) and stamps it as the echoed request's token, proving a host value flows
// through the guest and back. Targets the shared world.wit (external artifact). Only on-message delegates
// `identity` (the effect it performs); on-response/on-notification are inert.
import { Outcome, request, on-response, on-notification } from "reducer-lib"

def on-message(msg) =
  host identity in
    { requests = [request(msg.contract, msg.payload, identity.id())],
      outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
