// The deliver.deliver-message arg-parse-guard observation checker (design/cadenza-platform.md §9) — asserts a
// deliver host call the reducer performed with a MALFORMED argument was OBSERVED, not silently dropped
// (the #3272 deliver/provenance extension of the parse-guard seam). Paired guest calls deliver.deliver-message with a
// short (non-ReducerId) arg; the host early-returns and emits a HostCallRejected. LOG-ONLY, guest-agnostic.
//
// JUDGEMENT: pass iff some HostCallRejected(iface = "deliver", op = "deliver-message") is recorded. NON-VACUOUS:
// without the host seam (or a well-formed arg) nothing records; the exact iface+op guards against an
// unrelated rejected call. Settled idioms + String equality on the recorded iface/op.
import { LogRecord, Entry } from "log-schema"
import { Decision, interpret, verdict-req, pass, fail } from "checker-lib"

type Outcome = | Continue | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

def rejected-observed(records: List(LogRecord), i: Int64) =
  match List.at(records, i) with
  | Option.None(_) => false
  | Option.Some(LogRecord.LogRecord(rec)) =>
      (match rec.entry with
        | Entry.HostCallRejected(r) if (r.iface == "deliver" and r.op == "deliver-message") => true
        | _ => rejected-observed(records, i + 1))

def verdict-payload(records: List(LogRecord)) =
  if rejected-observed(records, 0)
  then pass()
  else fail("no HostCallRejected(deliver, deliver-message) recorded: a malformed-arg host call was not observed at the parse-guard boundary")

def on-message(msg) =
  match interpret(msg, verdict-payload) with
  | Decision.Report(r) => { requests = [verdict-req(r.contract, r.payload)], outcome = Outcome.Continue }
  | Decision.NotCheck(cl) => { requests = [], outcome = Outcome.Close({ schema = cl.schema, reason = cl.reason }) }
def on-response(_resp) = { requests = [], outcome = Outcome.Continue }
def on-notification(_note) = { requests = [], outcome = Outcome.Continue }
export { on-message, on-response, on-notification }
