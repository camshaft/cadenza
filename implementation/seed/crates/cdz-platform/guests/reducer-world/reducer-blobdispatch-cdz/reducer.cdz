// The §8 MULTI-CONTRACT dispatch reducer (design/cadenza-platform.md §1/§4/§8, operator directive 2026-08-26:
// "multiple contracts it responds to — one for put and one for get — dispatched by contract-id, not put-then-get
// on one contract"). It responds to TWO distinct contracts, routing each by its self-reflected descriptor id:
//   - cdz-platform.blob.put -> decode PutRequest, store the bytes (host blobs.put), emit a marker.
//   - cdz-platform.blob.get -> decode GetRequest, read by hash (host blobs.get), emit Found bytes / Missing.
//   - any other contract -> Close(unknown-contract) (the id guard is real).
// Dispatch is on the CONTRACT-ID via the uniform descriptor: each contract module exports `descriptor`, imported
// under a WHOLE-MODULE ALIAS (bput/bget) so the two same-named `descriptor` exports do not collide; the distinct-
// named request types come via named-list imports. This is the well-formed multi-contract shape (operate on the
// contract-id + decode by that contract's schema). on-response/on-notification inert (reducer-lib).
import bput from "blob-put"
import bget from "blob-get"
import { PutRequest } from "blob-put"
import { GetRequest } from "blob-get"
import { Outcome, on-response, on-notification } from "reducer-lib"

def on-message(msg) =
  host blobs in
    (if msg.contract == bput.descriptor().id then
       (match (Value.decode(msg.payload) : Option(PutRequest)) with
        | Some(PutRequest.Put(bytes)) =>
            (let h = blobs.put(bytes) in
              { requests = [{ contract = msg.contract, payload = b"put-dispatched", token = b"", deadlineNanos = None }],
                outcome = Outcome.Continue })
        | None => { requests = [], outcome = Outcome.Close({ schema = msg.contract, reason = b"put-decode-failed" }) })
     else if msg.contract == bget.descriptor().id then
       (match (Value.decode(msg.payload) : Option(GetRequest)) with
        | Some(GetRequest.Get(hash)) =>
            (match blobs.get(hash) with
             | Some(v) => { requests = [{ contract = msg.contract, payload = v, token = b"", deadlineNanos = None }], outcome = Outcome.Continue }
             | None => { requests = [{ contract = msg.contract, payload = b"get-missing", token = b"", deadlineNanos = None }], outcome = Outcome.Continue })
        | None => { requests = [], outcome = Outcome.Close({ schema = msg.contract, reason = b"get-decode-failed" }) })
     else { requests = [], outcome = Outcome.Close({ schema = msg.contract, reason = b"unknown-contract" }) })

export { on-message, on-response, on-notification }
