// An accumulator-loop reducer: reducer-echo-cdz's faithful host-drivable echo, but on-message first runs a
// bounded owned-accumulator loop (grow) before echoing. The loop is an END-TO-END O(n) reclaim TRIPWIRE
// (v-reducer-pooling, follow-on to reducer-fold-census #9163): each iteration builds an owned List, reads its
// length, and recurses — the back-edge/TCO borrow-forced-dup family (v-core-opt). Pre-#9172 (borrow-thread-
// accum-drop) a reused instance leaks ~O(n) shells/fold through the platform; the paired reused-instance
// accum-census asserts net-0 once #9172 lands. The world/types/on-response/on-notification/export are copied
// VERBATIM from reducer-echo-cdz — on-message is the ONLY structural difference (the grow prelude). Inline
// worlds are anonymous-per-member, so the step shape is repeated per member (identical inline records share
// one content-hash).
world reducer-world =
  | export guest =
    | on-message : (msg : {contract: list(u8),
                           sender: {reducer: list(u8), host: list(u8)},
                           payload: list(u8),
                           token: list(u8)})
                 -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                     outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-response : (resp : {contract: list(u8),
                             token: list(u8),
                             answer: result(list(u8), variant(timeout, missing-handler, schema-violation, faulted))})
                  -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                      outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-notification : (note : {contract: list(u8), payload: list(u8)})
                      -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                          outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}

type Outcome =
  | Continue
  | Close(Record(schema: Bytes, reason: Bytes))

type Error =
  | Timeout
  | MissingHandler
  | SchemaViolation
  | Faulted

def grow(acc, i, sum) =
  if i < 1 then sum
  else (let l = List.len(acc) in grow(List.push(acc, i), i - 1, sum + l))

def on-message(msg) =
  let total = grow([], 16, 0) in
  if total < 0 then { requests = [], outcome = Outcome.Continue }
  else { requests = [{ contract = msg.contract, payload = msg.payload, token = msg.token, deadlineNanos = None }],
         outcome = Outcome.Continue }

def on-response(_resp) =
  { requests = [], outcome = Outcome.Continue }

def on-notification(_note) =
  { requests = [], outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
