// A reducer-world FAULT FIXTURE: its on-message TRAPS (the `trap` primitive lowers to an unconditional
// wasm `unreachable`), so a host driving it (WasmReducer / WasmProgramStore) observes a GUEST TRAP —
// exercising the ReducerFault GuestCrashed classification (host records the crash + skips) end-to-end. It
// needs no host imports (it just traps), so it declares its world inline like reducer-echo. on-response /
// on-notification are inert (continue) — the message path is what crashes.
world reducer-world =
  | export guest =
    | on-message : (msg : {contract: list(u8),
                           sender: {reducer: list(u8), host: list(u8)},
                           payload: list(u8),
                           token: list(u8)})
                 -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                     outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-response : (resp : {contract: list(u8),
                             token: list(u8),
                             answer: result(list(u8), variant(timeout, missing-handler, schema-violation, faulted))})
                  -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                      outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-notification : (note : {contract: list(u8), payload: list(u8)})
                      -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                          outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}

type Outcome =
  | Continue
  | Close(Record(schema: Bytes, reason: Bytes))

type Error =
  | Timeout
  | MissingHandler
  | SchemaViolation
  | Faulted

// The trap lives in the `outcome` field so the return keeps the CONCRETE output record type (requests +
// outcome) the multi-export boundary must escape — `trap : ∀a. String → a` unifies with `Outcome` — while
// evaluating the record still fires the unconditional wasm `unreachable` at runtime (a bare `trap` body is
// bottom-typed and the boundary can't escape it). Same record shape as the inert on-response below.
def on-message(_msg) =
  { requests = [], outcome = trap("reducer-trap fixture: intentional guest crash (on-message)") }

def on-response(_resp) =
  { requests = [], outcome = Outcome.Continue }

def on-notification(_note) =
  { requests = [], outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
