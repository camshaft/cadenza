// A reusable USERSPACE JSON byte-scan library for reducer guests (operator 2026-09-13, 759/761: the JSON
// support is PURE userspace Cadenza — the compiler and runtime stay JSON-unaware; a guest scans/builds JSON at
// the Bytes level). The whole point: a guest that speaks a JSON wire protocol (e.g. an MCP/JSON-RPC server over
// the WebSocket handler interface) parses inbound JSON-text bytes and builds responses WITHOUT any JSON
// awareness in the platform — using only the runtime Bytes ops (Bytes.len/at/slice/concat).
//
// This minimal-but-reusable layer offers the two things a guest needs and cannot get elsewhere: SUBSTRING
// SEARCH over bytes (`find`/`contains`) and RAW FIELD-VALUE extraction (`field-token` — the verbatim value
// token of a top-level JSON object field, e.g. the JSON-RPC request `id`, preserving its original JSON type).
// BUILDING JSON is just `Bytes.concat` of byte literals around extracted tokens, so no builder is exported.
//
// Self-contained (imports nothing), so it drags in no schemas — composed into a guest via its `libs` manifest,
// exactly like reducer-lib.

// First index i in [0, hlen-nlen] where hay[i..i+nlen] == nee; None if the needle does not occur.
def find-from(hay: Bytes, nee: Bytes, i: Int64, nlen: Int64, hlen: Int64) -> Option(Int64) =
  if i + nlen > hlen then Option.None
  else (match Bytes.slice(hay, i, nlen) with
        | Option.Some(chunk) => if chunk == nee then Option.Some(i)
                                else find-from(hay, nee, i + 1, nlen, hlen)
        | Option.None => Option.None)

// The index of the first occurrence of `nee` in `hay`, or None.
def find(hay: Bytes, nee: Bytes) -> Option(Int64) =
  find-from(hay, nee, 0, Bytes.len(nee), Bytes.len(hay))

// Whether `nee` occurs anywhere in `hay`.
def contains(hay: Bytes, nee: Bytes) -> Bool =
  (match find(hay, nee) with
   | Option.Some(_) => true
   | Option.None => false)

// The first index at/after `i` holding a ',' (44) or '}' (125) — where a JSON scalar value token ends; else
// `hlen`. (Adequate for the scalar/quoted-scalar values a minimal protocol reads, e.g. a JSON-RPC id.)
def scan-end(hay: Bytes, i: Int64, hlen: Int64) -> Int64 =
  if i >= hlen then i
  else (match Bytes.at(hay, i) with
        | Option.Some(b) => if (b == 44) or (b == 125) then i else scan-end(hay, i + 1, hlen)
        | Option.None => i)

// The raw bytes of top-level JSON object field `key`'s value, VERBATIM (a number like `1`, or a quoted string
// like `"abc"` with its quotes) — so a caller can splice it back into a response and preserve its JSON type.
// `default` when the field is absent. Assumes compact JSON (`"key":value`); reads to the next ',' or '}'.
def field-token(obj: Bytes, key: Bytes, default: Bytes) -> Bytes =
  let needle = Bytes.concat(b"\"", Bytes.concat(key, b"\":")) in
  (match find(obj, needle) with
   | Option.None => default
   | Option.Some(k) =>
       let start = k + Bytes.len(needle) in
       let e = scan-end(obj, start, Bytes.len(obj)) in
       (match Bytes.slice(obj, start, e - start) with
        | Option.Some(v) => v
        | Option.None => default))

export { find, contains, field-token }
