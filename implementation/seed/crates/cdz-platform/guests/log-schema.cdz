// The shared observation-log Cadenza schema (design/cadenza-platform.md §9) — the type a checker
// `Value.decode`s the serialized log into. Derived from and kept in lockstep with the log's Rust encoder
// `cdz-platform/src/testing/log_value.rs` (the source of truth for the exact per-field types and the wire
// field names): every id/hash/payload is `Bytes`; a truly-boolean flag (`hit`, `existed`, `present`,
// `keysOnly`, `added`, `hasDeadline`) is `Bool` (the encoder writes the canonical `Leaf::Bool`, not `0`/`1`);
// a genuine count (`len`, `seq`, `time`) is `UInt64`; `event-kind`/`error`/`during`/`reducer-kind` are
// `String`. Entry and Bound are sums (the constructor kebab-matches the wire tag); the source/from origin is a
// plain record. Kebab wire field names (`event-kind`, `keys-only`, `reducer-kind`) normalize to these
// camelCase fields.
type Bound =
  | Unbounded
  | Included(Bytes)
  | Excluded(Bytes)

type Entry =
  | KvGet(Record(key: Bytes, hit: Bool))
  | KvPut(Record(key: Bytes, value: Bytes))
  | KvDelete(Record(key: Bytes, existed: Bool))
  | KvScan(Record(lower: Bound, upper: Bound, keysOnly: Bool))
  | BlobPut(Record(hash: Bytes, len: UInt64))
  | BlobGet(Record(hash: Bytes, hit: Bool))
  | BlobHas(Record(hash: Bytes, present: Bool))
  | Delivered(Record(eventKind: String, contract: Bytes, from: Option(Record(reducer: Bytes, host: Bytes)), token: Bytes, payload: Bytes, error: Option(String)))
  | Emitted(Record(contract: Bytes, payload: Bytes, token: Bytes, hasDeadline: Bool))
  | Routed(Record(eventKind: String, target: Bytes, contract: Bytes, token: Bytes, payload: Bytes, error: Option(String)))
  | ProgramOf(Record(reducer: Bytes, program: Option(Bytes)))
  | GraphInsert(Record(node: Bytes, added: Bool))
  | GraphContains(Record(node: Bytes, present: Bool))
  | GraphRemove(Record(node: Bytes, existed: Bool))
  | GraphLink(Record(from: Bytes, to: Bytes, kind: Bytes, added: Bool))
  | GraphSetEdges(Record(from: Bytes, kind: Bytes, targets: List(Bytes), prior: List(Bytes)))
  | GraphNeighbors(Record(node: Bytes, kind: Bytes, dir: String, result: List(Bytes)))
  | GraphInKinds(Record(node: Bytes, result: List(Bytes)))
  | GraphReach(Record(node: Bytes, kind: Bytes, dir: String, result: List(Bytes)))
  | Closed(Record(schema: Bytes, reason: Bytes))
  | Failed(Record(during: String, contract: Bytes, reason: String))
  | Spawn(Record(name: String, program: Bytes, parent: Bytes, reducerKind: String))
  | HostCallRejected(Record(iface: String, op: String, rawArgs: List(Bytes)))
  | Run(Record(program: Bytes, contract: Bytes, input: Bytes, output: Option(Bytes), error: Option(String)))
  | ArgProbe(Record(record: Bytes, items: Bytes))

type LogRecord =
  | LogRecord(Record(seq: UInt64, time: UInt64, source: Record(reducer: Bytes, host: Bytes), entry: Entry))

// Export the sum-type constructors (not just the opaque type handles) so a checker guest can `import`
// these types and both CONSTRUCT and MATCH their variants (a bare `export { T }` exposes only the handle).
export { Bound.*, Entry.*, LogRecord.* }
