// A Cadenza reducer exercising the WIT-ABI COMPOSITION across TWO host interfaces in one fold — migrated from
// v-rust-backend's in-crate "WIT composition" behavioral test (closed #3249), so the compiler need not carry
// a wasmtime dev-dep to prove this shape. On-message it performs `graph.neighbors` (an ENUM arg `Dir.Outgoing`
// in, a LIST result out) and `state.get` (an OPTION result out, which it matches), then emits one request
// whose payload is the stored value when present else the delivered payload. This composes: (a) a multi-host-
// interface guest (state + graph — the multi-interface emit of #3232), (b) an enum host-call arg, (c) a list
// host-call result, and (d) an option host-call result and its match. If any of those marshallings were wrong
// the guest would fail to instantiate or trap, so a run that drives it to a recorded GraphNeighbors + KvGet +
// Emitted is the end-to-end ABI proof. Targets the privileged event-reducer-world (the world importing both
// `state` and `graph`); spawned as an event reducer. on-response / on-notification are inert.
type Outcome = | Continue | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted
// Matches the world's `dir` enum { outgoing, incoming } by case-name set (kebab-normalized); the world-import
// synthesis binds this sum to the enum so `Dir.Outgoing` crosses as the enum arg to `graph.neighbors`.
type Dir = | Outgoing | Incoming

def on-message(msg) =
  host state in
  host graph in
    ( graph.neighbors(msg.token, msg.contract, Dir.Outgoing) ;
      { requests = [{ contract = msg.contract,
                      payload = (match state.get(msg.token) with
                                  | Some(v) => v
                                  | None(_) => msg.payload),
                      token = msg.token,
                      deadlineNanos = None }],
        outcome = Outcome.Continue } )

def on-response(_resp) =
  { requests = [], outcome = Outcome.Continue }

def on-notification(_note) =
  { requests = [], outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
