// The HTTP-outpost DISPATCH effect contract (DESIGN-http-outpost-conformance-harness.md §4): the effect a
// root-router program emits (or a oneshot router Breaks with) to hand a matched request off to a target
// subprogram. The dispatch TARGET is a well-typed ENUM (operator 2026-09-15: "it should be either a cas
// target or a name that resolves to a cas target") — NOT a bespoke alias string or a bare subprogram field:
//   * `CasTarget(Bytes)` — a DIRECT content address: the target subprogram's `ProgramHash` bytes (the host
//     fetches it from the CAS + drives it). This is the classic dispatch-by-hash.
//   * `Name(Bytes)` — a NAME that resolves (via the host's name directory) to a cas target (resolve_name ->
//     ProgramHash). The oneshot-router's alias case (e.g. Name(b"echo")).
// `input` = the bytes delivered to the target as its first message (the classic gateway's Continue+fold
// path); a oneshot daemon that replays the ORIGINAL request to a fresh ephemeral session leaves it empty.
// Userspace (this dir): a Cadenza reducer emits it on this contract's COMPUTED id (via `descriptor().id`, no
// baked marker) and the host's effect resolver routes on the same descriptor-derived id — one source of
// truth. The resolver reads the fields GENERICALLY (record_field "target"/"input", read_ctor on the target).
// No Rust binding is generated.
type Target =
  | CasTarget(Bytes)
  | Name(Bytes)

type Dispatch = | Dispatch(Record(target: Target, input: Bytes))

def a-cas-dispatch() -> Dispatch =
  Dispatch.Dispatch({ target = Target.CasTarget(b"a-33-byte-program-hash-goes-here."), input = b"the-request-bytes" })

// A NAME dispatch (the oneshot-router alias case): resolve the name to a cas target; no router-supplied input
// (the daemon replays the original request to the resolved handler's fresh session).
def a-name-dispatch() -> Dispatch =
  Dispatch.Dispatch({ target = Target.Name(b"echo"), input = b"" })

@test
def cas-dispatch-conforms() =
  match a-cas-dispatch() with
  | Dispatch.Dispatch(d) =>
    (match d.target with
     | Target.CasTarget(h) =>
       if (h == b"a-33-byte-program-hash-goes-here.") and (d.input == b"the-request-bytes")
       then unit else trap("cas dispatch field mismatch")
     | Target.Name(_) => trap("expected CasTarget"))

@test
def name-dispatch-conforms() =
  match a-name-dispatch() with
  | Dispatch.Dispatch(d) =>
    (match d.target with
     | Target.Name(n) => if n == b"echo" then unit else trap("name mismatch")
     | Target.CasTarget(_) => trap("expected Name"))

import { contract-descriptor } from "contract-id"
def descriptor() =
  contract-descriptor(Ast.module, "cdz-platform.http.dispatch", "Dispatch", "Dispatch")
export { Dispatch.*, Target.*, descriptor }
