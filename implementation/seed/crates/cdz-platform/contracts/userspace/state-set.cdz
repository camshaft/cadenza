@!contract "cdz-platform.state.set"
@!input SetRequest
@!output SetResult

// The §7 session-state SET contract (design/cadenza-platform.md §7): write a value at a key in the session's
// key-value state, answered with the state root hash after the change (§7: "a root hash after each change").
// A DISTINCT contract so a reducer dispatches set-vs-get-vs-delete by CONTRACT-ID. Small values live inline;
// a large value is held in the shared content-addressed store and carried here as its hash (still Bytes).
// Userspace (this dir): a Cadenza reducer consumes it via self-reflection; no Rust binding is generated.
type SetRequest = | Set(Record(key: Bytes, value: Bytes))
type SetResult = | Root(Bytes)
def a-set() -> SetRequest = SetRequest.Set({ key = b"k", value = b"v" })
@test
def set-conforms() =
  match a-set() with
  | SetRequest.Set(r) => if (r.key == b"k") and (r.value == b"v") then unit else trap("set payload mismatch")
import { contract-descriptor } from "contract-id"
def descriptor() -> Record(id: Bytes, name: String, input: Bytes, output: Bytes, ast: Bytes) =
  contract-descriptor(Ast.module, "cdz-platform.state.set", "SetRequest", "SetResult")
export { SetRequest.*, SetResult.*, descriptor }
