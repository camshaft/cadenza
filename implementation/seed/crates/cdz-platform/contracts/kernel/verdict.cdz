@!contract "cdz-platform.verdict"
@!input Verdict
@!output Ack

// The verdict contract — what the end-of-run CHECKER emits to report the run's pass/fail
// (design/cadenza-platform.md section 9). The checker (a reducer-shaped guest delivered the observation log
// via the `check` contract) emits a `verdict` request; the harness — a driver, not a reducer, so it cannot
// receive an on_response reply — reads the emitted verdict from the observation stream. A separate contract
// the checker emits (rather than a reply to `check`) is therefore the correct mechanism.
//
// This file is real Cadenza and is the source of truth for the schema: `cargo xtask codegen` validates it
// with the `cdz` binary and generates src/contracts/verdict.rs from it. Re-run `cargo xtask codegen` after
// editing; `cargo xtask codegen --check` fails if the committed generated file is stale.

// The verdict (the contract's input, i.e. the value the checker emits): whether the run passed, and human-
// readable messages (empty when it passed clean; the reasons when it failed).
type Verdict =
  | Verdict(Record(pass: Bool, messages: List(String)))

// The output type — a verdict is one-way (the harness reads it; nothing replies), so the unit Ack.
type Ack =
  | Ack

// --- conformance proofs: a fully-literal verdict of each outcome, ascribed against the schema type ---
def a-pass() -> Verdict = Verdict.Verdict({ pass = true, messages = ([] : List(String)) })

def a-fail() -> Verdict =
  Verdict.Verdict({ pass = false, messages = List.push(([] : List(String)), "assertion failed") })

@test
def pass-conforms() =
  match a-pass() with
  | Verdict.Verdict(v) => if v.pass then unit else trap("expected a passing verdict")

@test
def fail-conforms() =
  match a-fail() with
  | Verdict.Verdict(v) => if v.pass then trap("expected a failing verdict") else unit

// Make the schema types importable as a LIBRARY (`import { Verdict, Ack } from "verdict"`): the Cadenza
// checker guest builds a `Verdict` value to emit, so it needs the type AND its constructors in scope. The
// `.*` exports every constructor (a bare `Verdict` would expose only the opaque type handle). This is how a
// guest shares this contract's shape from its single source of truth rather than re-declaring it. Inert for
// the Rust codegen (which reads the schema, not the export clause) and for a single-file compile.
import { contract-descriptor } from "contract-id"
def descriptor() -> Record(id: Bytes, name: String, input: Bytes, output: Bytes, ast: Bytes) =
  contract-descriptor(Ast.module, "cdz-platform.verdict", "Verdict", "Ack")

export { Verdict.*, Ack.*, descriptor }