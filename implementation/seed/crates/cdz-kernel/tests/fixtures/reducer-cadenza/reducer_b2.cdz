// reducer_b2.cdz — B2: a Cadenza agent-harness reducer that EMITS one effect-request (ML surface).
//
// Extends B1 (empty-effects) — proves the effect-request construction path through the B2 value-form
// boundary (design-binary-ast-abi, ruling Q): the reducer builds the FLAT protocol effect-request record
// directly, so rcdzc's value-encode(result) IS the kernel wire (no Mk-strip / EffectKind->String adapter).
// `kind` is the lowercased effect FAMILY string ("http" — register-by-string, seq366, NOT a closed enum);
// `target` is Bytes. Fields sorted-key (correlation, kind, payload, target — the shared protocol descriptor).
// Behavior: on ANY event, request ONE http effect to https://ok.host/x with correlation token "step-1"
// (mirrors the interim Rust reducer-guest). B3 adds the kv counter + content-type conditional.
//
// BUILD: cdz compile reducer_b2.cdz --target wasm --component-name cadenza:agent-kernel/fold → VALID.

// The protocol effect-request is an INLINE flat record (kind a family String, target Bytes, sorted fields)
// — NOT a named-type alias: `type X = Record(..)` in Cadenza is a single-variant SUM (needs match to read),
// but the wire is a bare transparent record, so we spell the record type inline on apply's return.
def apply(
  ct: Record(family: String, version: UInt(32)),
  payload: Option(Bytes),
  resumes: Option(Bytes),
) -> List(Record(correlation: Option(Bytes), kind: String, payload: Option(Bytes), target: Bytes)) = [
  {
    correlation = Some(String.to-bytes("step-1")),
    kind = "http",
    payload = None(),
    target = String.to-bytes("https://ok.host/x"),
  }
]

// Behavioral coverage (runs on the seed compiler via `cdz test`, INDEPENDENT of the kernel host adapter;
// a plain `cdz compile` ignores @test). Guards B2: exactly ONE effect, and it is an Http effect.
@test
def b2_emits_exactly_one_effect() =
  if List.len(apply({ family = "message", version = 1 }, None(), None())) == 1
  then unit
  else trap("B2 must emit exactly one effect-request")

// Pin ALL of the one effect-request's fields — not just the kind. The host marshals target via str-get,
// correlation via sum-payload, payload via sum-disc; a silent change to any (a different URL, a dropped
// token) would break the round-trip with no other test catching it. Each field pinned:
@test
def b2_the_effect_is_http() =
  match List.at(apply({ family = "message", version = 1 }, None(), None()), 0) with
    | Some(r) =>
      if r.kind == "http" then unit
      else trap("B2's effect kind must be the family string \"http\"")
    | None() => trap("B2 must have an effect at index 0")

@test
def b2_effect_target_is_pinned() =
  match List.at(apply({ family = "message", version = 1 }, None(), None()), 0) with
    | Some(r) =>
      if r.target == String.to-bytes("https://ok.host/x") then unit
      else trap("B2's effect target must be https://ok.host/x")
    | None() => trap("B2 must have an effect at index 0")

@test
def b2_effect_correlation_is_pinned() =
  match List.at(apply({ family = "message", version = 1 }, None(), None()), 0) with
    | Some(r) =>
      if r.correlation == Some(String.to-bytes("step-1")) then unit
      else trap("B2's effect correlation token must be Some(\"step-1\")")
    | None() => trap("B2 must have an effect at index 0")

@test
def b2_effect_payload_is_none() =
  match List.at(apply({ family = "message", version = 1 }, None(), None()), 0) with
    | Some(r) =>
      (match r.payload with
        | None() => unit
        | Some(_) => trap("B2's effect payload must be None"))
    | None() => trap("B2 must have an effect at index 0")

export { apply }
