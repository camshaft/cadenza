// reducer_agent_loop.cdz — the AGENT-LOOP reference reducer: the agentic loop expressed as a FOLD over
// KV inbox state (GAP-1 keystone, design/agent-harness-kernel.md §3). This is the smallest honest
// demonstration that our harness hosts a REAL agent loop as a pure reducer over the A1 bytes fold boundary
// — no new kernel mechanism, just a fold over the existing kv + emit effects (v-agent-harness-host's
// standing recommendation, greenlight 2026-08-12).
//
// THE LOOP (agentic loop = fold over KV inbox state):
//   message event        { content-type.family = "message", payload = Some(msg) }
//     → append the message to the INBOX under the "inbox/" prefix (content-addressed key), then enumerate
//       the pending inbox via kv.prefix-scan and, iff any are pending, emit a "model" effect to invoke the
//       LLM with the message as context. This is the "read inbox → call model" half of the loop.
//   model-response event { content-type.family = "model-response", payload = Some(call) }
//     → the model replied with a tool-call request; dispatch it as a "tool" effect (the loop's ACTION
//       step).
//   tool-result event    { content-type.family = "tool-result", payload = Some(result) }
//     → the tool ran; fold its result into the "context/" working set, then re-invoke the model with the
//       context enumerated via kv.prefix-scan — CLOSING the loop (message→model→tool→result→model→…).
//   anything else → [] (no effects).
//
// KV inbox state (this reducer's own §4 schema; opaque to the kernel): messages live under the "inbox/"
// prefix, keyed by content so kv.prefix-scan enumerates all pending. This is exactly the pattern that lets
// a self-hosting agent manage its own context/inbox in durable KV rather than tmux/fleet-tooling state.
//
// Targets the REDUCER world (reducer_world_artifact — export fold.apply(list<u8>)->list<u8> + import
// cadenza:agent-kernel/kv). Host-fused (kv escapes as the world import, no bind), single canonical Event
// param, inline structural EffectRequest return — same A1 value-form contract as reducer_pure/genesis/kv.
//
// BUILD: emit-wit-world full -> reducer-world.bin; then
//   cdz compile reducer_agent_loop.cdz wit-world:reducer-world=reducer-world.bin
//     --component-name cadenza:agent-kernel/fold -o reducer_agent_loop.wasm
//   -> exports fold.apply(list<u8>)->list<u8>, imports cadenza:agent-kernel/kv (put+prefix-scan) + runtime
//      heap; VALID. (The prefix-scan ENUMERATION is runtime-correct once the guest list-lift fix lands;
//      the reducer compiles + validates today.)

// kv host import: put (append to inbox) + prefix-scan (enumerate the pending inbox). No bind — host-fused.
effect Kv =
  | put : `->`(Bytes, Bytes, Unit)
  | prefix-scan : `->`(Bytes, List(Tuple(Bytes, Bytes)))

// The inbox namespace: every stored message key starts with this, so prefix-scan enumerates the inbox.
def inbox-prefix() -> Bytes = String.to-bytes("inbox/")

// The KV key a message is stored under: the "inbox/" prefix ++ the message bytes (content-addressed, so
// distinct messages get distinct keys and prefix-scan lists them all).
def inbox-key(msg: Bytes) -> Bytes = Bytes.concat(inbox-prefix(), msg)

// The accumulated-context namespace: tool results fold in here, enumerated by prefix-scan when the loop
// re-invokes the model. The "context/" prefix is the agent's growing working set across the loop.
def context-prefix() -> Bytes = String.to-bytes("context/")
def context-key(result: Bytes) -> Bytes = Bytes.concat(context-prefix(), result)

// GAP-1 M1 content block — a NAME-headed sum (Text / ToolCall / ToolResult) whose tool-use ids round-trip
// through the conversation. Declared nominally (Cadenza sums need a local declaration; structural records
// do not); its value-form is the b1 model-effect wire the kernel re-encodes and the host decodes.
type ContentBlock =
  | Text(String)
  | ToolCall(Record(id: String, name: String, input: Bytes))
  | ToolResult(Record(id: String, result: Bytes))

// The effect PAYLOAD (b1): a payload-ENCODING sum — opaque `Raw` bytes OR a `Structured` value-form value
// the host decodes per the effect's schema. TWO arms (so it does NOT newtype-erase): this reducer emits
// BOTH — `Raw` for the opaque tool-call dispatch, `Structured` for the model-request. `Structured` is a
// GENERIC codec marker, NOT a model capability (an effect's identity is its schema-hash, never this ctor
// name); the kernel's parse_effect_list unwraps `Raw` to opaque bytes and re-encodes `Structured` to the
// value-form bytes decode_model_request reads. The `Structured` arm carries an M1 ModelRequest (an inline
// structural record — the model id, the conversation, the offered tools, an optional token cap).
type Payload =
  | Raw(Bytes)
  | Structured(Record(
      model: String,
      messages: List(Record(role: String, content: List(ContentBlock))),
      tools: List(Record(name: String, schema: Bytes)),
      max-tokens: Option(UInt(64)),
    ))

// The discriminated effect-result OUTCOME the kernel surfaces on an EffectResult event (err-reply co-land):
// Some(Ok|Err|TimedOut) for an effect result, None for every other event kind. The agent loop resumes on a
// result's `resumes` token today; surfacing the outcome lets a later slice branch success-vs-failure (e.g.
// record a model error rather than a reply). Declared now so the shared strict Event value-form matches.
// The reply payload is DISCRIMINATED so a blob-ref reply (large response settled by hash, not inlined)
// survives the outcome value-form (operator ruling: no-capability-drop): Inline bytes OR a Blob hash.
type ReplyPayload =
  | Inline(Bytes)
  | Blob(Bytes)

type Outcome =
  | Ok(ReplyPayload)
  | Err(Record(message: Bytes, retryable: Bool))
  | TimedOut

// §6 V2 per-child supervision: a ChildCompleted event surfaces the completed child's terminal outcome as a
// first-class typed field. Success|Failure (the CloseOutcome value-form), Success reusing ReplyPayload.
type ChildOutcome =
  | Success(ReplyPayload)
  | Failure(Bytes)

def apply(
  event: Record(
    content-type: Record(family: String, version: UInt(32)),
    payload: Option(Bytes),
    resumes: Option(Bytes),
    outcome: Option(Outcome),
    child-completed: Option(Record(child: Bytes, outcome: ChildOutcome)),
  ),
) -> List(Record(
  kind: String,
  target: Bytes,
  payload: Option(Payload),
  correlation: Option(Bytes),
)) =
  let family = event.content-type.family in
  if family == "message" then
    // Read-inbox → call-model half: append the message, enumerate the pending inbox, invoke the model with
    // a real M1 ModelRequest (the message decoded to a user turn; the shell tool offered).
    (match event.payload with
       | Some(msg) => host Kv in (
           Kv.put(inbox-key(msg), msg);
           (if List.len(Kv.prefix-scan(inbox-prefix())) == 0 then []
            else
              // Decode the message bytes to text for the M1 user turn (total UTF-8 decode; a non-UTF-8
              // message folds to an empty prompt rather than trapping).
              let msg-text = (match String.from-bytes(msg) with | Some(s) => s | None() => "") in
              [{
              kind = "model",
              target = String.to-bytes("llm"),
              payload = Some(Structured({
                model = "claude",
                messages = [{ role = "user", content = [Text(msg-text)] }],
                tools = [{ name = "shell", schema = String.to-bytes("{}") }],
                max-tokens = Some(1024),
              })),
              correlation = None(),
            }]))
       | None() => [])
  else if family == "model-response" then
    // Action half: the model requested a tool call; dispatch it as a tool effect (opaque Raw payload).
    (match event.payload with
       | Some(call) => [{
           kind = "tool",
           target = String.to-bytes("shell"),
           payload = Some(Raw(call)),
           correlation = None(),
         }]
       | None() => [])
  else if family == "tool-result" then
    // Loop-CLOSURE: the tool ran; fold its result into the accumulated context, then re-invoke the model
    // with the result folded in as an M1 tool-result turn — closing the cycle message→model→tool→RESULT→…
    // This is what makes it a LOOP (not a single message→model→tool pass): each tool result grows the
    // agent's working set and drives the next model turn.
    (match event.payload with
       | Some(result) => host Kv in (
           Kv.put(context-key(result), result);
           (if List.len(Kv.prefix-scan(context-prefix())) == 0 then []
            else [{
              kind = "model",
              target = String.to-bytes("llm"),
              payload = Some(Structured({
                model = "claude",
                messages = [{ role = "user", content = [ToolResult({ id = "t1", result = result })] }],
                tools = [{ name = "shell", schema = String.to-bytes("{}") }],
                max-tokens = Some(1024),
              })),
              correlation = None(),
            }]))
       | None() => [])
  else
    // Not part of the loop → no effects.
    []

// No `@test`: host-fused (kv escapes to host imports) → cannot build a standalone test component on the
// seed VM, and prefix-scan enumeration is host-driven. Gated by the WORLD-DRIVEN compile (v-nix precompile
// derivation) + a v-agent-harness-host agent-loop e2e (runs once the prefix-scan lift fix lands). NOT in
// Project.cdz `tests`.

export { apply }
