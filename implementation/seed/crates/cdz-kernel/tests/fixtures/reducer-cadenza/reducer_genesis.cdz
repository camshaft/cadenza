// reducer_genesis.cdz — B4: the agent-harness GENESIS / bootstrap reducer program (ML surface).
//
// design/agent-harness-kernel.md §3 (genesis + context-as-events) + §20b (genesis bootstrap installs
// the authorizer + initial policies as its FIRST events). A session's setup is NOT kernel state — it's
// HISTORY: the reducer folds early "setup" events into its KV, so config is auditable/replayable.
//
// This is the genesis half of the bootstrap programs: it recognizes a few well-known setup content-type
// FAMILIES and folds each event's payload into KV under a well-known key. It requests NO effects (setup
// writes STATE, it doesn't act). Ordinary message events (or anything unrecognized) fold to nothing —
// the real session reducer (reducer_b1/b2/b3) handles those; a deployment composes genesis-then-session
// or a session reducer that also folds these setup families.
//
// 🔑 TRUST-ROOT SEAM (operator ruling seq-129): the root identity arrives as a genesis INPUT (the
// "genesis/root" event's payload), NEVER baked as a constant here. When the operator designs the
// first-hub trust-root ceremony, it becomes the PRODUCER of that event — this reducer consumes it
// unchanged. So the assumed-root boundary is exactly `Kv.put("bootstrap/root-identity", <payload>)`.
//
// §20b Q1=(c) ruling: genesis installs the authorizer BY HASH (a set(name,hash) pointer recorded on the
// log/KV); the interim in-kernel authz is the stand-in until a real Cedar-engine component exists (owned
// by v-agent-harness-host). This reducer records the authorizer-hash POINTER; it does not know or run
// Cedar — the kernel/host resolves whatever authorizer component the pointer names.
//
// A1 BYTES FOLD BOUNDARY: this reducer targets the REDUCER world (reducer_world_artifact — export
// fold.apply(list<u8>)->list<u8> + import cadenza:agent-kernel/kv). apply takes the single canonical Event
// record and returns a list of inline structural EffectRequest records (the locked value-form contract,
// same as reducer_pure); rcdzc bytes-wraps it under the world. There is NO `bind`: the kv.put call is an
// UNHANDLED effect that ESCAPES as the world's `cadenza:agent-kernel/kv` HOST import (host-fused). A `bind`
// would make kv a PEER interface, which the host-fused bytes-roundtrip path declines.
//
// BUILD: emit-wit-world full -> reducer-world.bin; then
//   cdz compile reducer_genesis.cdz wit-world:reducer-world=reducer-world.bin
//     --component-name cadenza:agent-kernel/fold -o reducer_genesis.wasm
//   -> exports fold.apply(list<u8>)->list<u8>, imports cadenza:agent-kernel/kv (+ runtime/heap); VALID.

// The kv host import: genesis only PUTs (it writes setup state; it never reads to decide an action).
effect Kv =
  | put : `->`(Bytes, Bytes, Unit)

// Which well-known KV key a setup content-type family folds into. `None` = not a setup event this
// genesis reducer recognizes (fold to nothing). The families are the genesis-event contract with the
// host that seeds the session (coordinated with v-agent-harness-host); the keys are this reducer's own
// KV schema (opaque to the kernel — §4).
def setup-key(family: String) -> Option(Bytes) =
  if family == "genesis/root" then Some(String.to-bytes("bootstrap/root-identity"))       // the SEAM
  else if family == "genesis/authorizer" then Some(String.to-bytes("bootstrap/authorizer-hash"))
  else if family == "genesis/context" then Some(String.to-bytes("bootstrap/context"))
  else None()

// The discriminated effect-result OUTCOME the kernel surfaces on an EffectResult event (err-reply co-land):
// Some(Ok|Err|TimedOut) for an effect result, None for every other event kind. Genesis folds no results, so
// it never inspects it — but the Event value-form is shared + strict, so the field must be declared.
// The reply payload is DISCRIMINATED so a blob-ref reply (large response settled by hash, not inlined)
// survives the outcome value-form (operator ruling: no-capability-drop): Inline bytes OR a Blob hash.
type ReplyPayload =
  | Inline(Bytes)
  | Blob(Bytes)

type Outcome =
  | Ok(ReplyPayload)
  | Err(Record(message: Bytes, retryable: Bool))
  | TimedOut

def apply(
  event: Record(
    content-type: Record(family: String, version: UInt(32)),
    payload: Option(Bytes),
    resumes: Option(Bytes),
    outcome: Option(Outcome),
  ),
) -> List(Record(
  kind: String,
  target: Bytes,
  payload: Option(Bytes),
  correlation: Option(Bytes),
)) =
  match event.resumes with
    // Genesis has no effects to await; a resume event is not part of setup — ignore.
    | Some(_) => []
    | None() =>
      match setup-key(event.content-type.family) with
        // A recognized setup event WITH a payload: fold it into KV under its well-known key. No effects.
        | Some(key) => (match event.payload with
            | Some(value) => host Kv in ( Kv.put(key, value); [] )
            | None() => [])
        // Not a setup event this genesis reducer folds → nothing.
        | None() => []

// No `@test`: a host-fused reducer (the unhandled kv.put escapes to a host import) cannot build a
// standalone test component on the seed VM (no kv host), so `cdz test` cannot inspect it — same as
// reducer_kv. This fixture is gated by the WORLD-DRIVEN compile (v-nix's reducerCadenzaGenesis
// derivation, witWorld=full) + v-agent-harness-host's genesis e2e, NOT by `cdz test`; it is therefore
// NOT registered in Project.cdz `tests` (that would break reducerCadenzaTests building a test component).

export { apply }
