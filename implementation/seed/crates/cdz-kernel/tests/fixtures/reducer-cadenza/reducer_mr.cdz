// reducer_mr.cdz — ROLE LIBRARY increment #4: the MR / PUBLISH role (pure fold).
//
// Step 4 of the fleet loop (tick -> inbox-drain -> work -> MR/PUBLISH). A pure reducer that folds a
// "unit-complete" event (a gated unit of work is ready to publish, its commit message carried in the
// payload) into the COMPOSED git publish SEQUENCE: stage -> commit -> push. It emits all three built-in
// git/* effects in ONE fold; the kernel dispatches a returned effect-list IN ORDER, and the push refspec
// is known without the commit sha, so no result-chaining is needed for this reference sequence.
//
// This is distinct from reducer_git (which performs ONE git op per event): here the fleet-loop PUBLISH
// STEP is a composed sequence of the three ops an agent runs to publish its work. Returns effects only
// (no host import) -> cdz-test-gated like reducer_tick/reducer_inbox. A payload-less unit-complete (no
// commit message) or a non-publish event drives nothing.
//
// (The fleet's own MR is a `fleet send merge-request`; a later increment can swap the git/push for a
// fleet-send-equivalent emit, or chain the commit's sha result into the MR ref. This slice pins the pure
// composed git publish sequence — the general self-hosting git-publish capability.)

// The discriminated effect-result OUTCOME field (shared strict Event value-form; folded by later
// result-chaining increments, declared here). Reply payload discriminated: Inline OR Blob hash.
type ReplyPayload =
  | Inline(Bytes)
  | Blob(Bytes)

type Outcome =
  | Ok(ReplyPayload)
  | Err(Record(message: Bytes, retryable: Bool))
  | TimedOut

// §6 V2 per-child supervision field (shared Event value-form).
type ChildOutcome =
  | Success(ReplyPayload)
  | Failure(Bytes)

// The worktree the stage/commit ops act on + the remote the push targets — their resolved Cedar resources
// (opaque to the kernel, gated by policy). Defs so each op names the byte-identical resource.
def worktree() -> Bytes = String.to-bytes(".")
def remote() -> Bytes = String.to-bytes("origin")

// The refspec the publish pushes (HEAD to this vertical's fleet branch) — a fixed reference refspec.
def push-refspec() -> Bytes = String.to-bytes("HEAD:fleet/v-agent-harness")

def apply(
  event: Record(
    content-type: Record(family: String, version: UInt(32)),
    payload: Option(Bytes),
    resumes: Option(Bytes),
    outcome: Option(Outcome),
    child-completed: Option(Record(child: Bytes, outcome: ChildOutcome)),
  ),
) -> List(Record(
  kind: String,
  target: Bytes,
  payload: Option(Bytes),
  correlation: Option(Bytes),
)) =
  let family = event.content-type.family in
  if family == "unit-complete" then
    // Publish the completed unit: stage all -> commit with the carried message -> push HEAD to the branch.
    (match event.payload with
       | Some(msg) =>
         [
           {
             kind = "git/add",
             target = worktree(),
             payload = Some(String.to-bytes(".")),
             correlation = None(),
           },
           {
             kind = "git/commit",
             target = worktree(),
             payload = Some(msg),
             correlation = None(),
           },
           {
             kind = "git/push",
             target = remote(),
             payload = Some(push-refspec()),
             correlation = None(),
           },
         ]
       // No commit message -> nothing to publish.
       | None() => [])
  else
    // Not a publish trigger -> drive nothing.
    []

// Standalone behavioral coverage (`cdz test`, INDEPENDENT of any host).
@test
def unit_complete_emits_the_stage_commit_push_sequence() =
  let evt = {
    content-type = { family = "unit-complete", version = 1 },
    payload = Some(String.to-bytes("land the tick reducer")),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  let effs = apply(evt) in
  if List.len(effs) == 3 then
    (match List.at(effs, 0) with
       | Some(a) =>
         (if a.kind == "git/add" then
            (match List.at(effs, 1) with
               | Some(c) =>
                 (if c.kind == "git/commit" then
                    (match c.payload with
                       | Some(m) =>
                         (if m == String.to-bytes("land the tick reducer") then
                            (match List.at(effs, 2) with
                               | Some(p) => (if p.kind == "git/push" and p.target == String.to-bytes("origin") then unit
                                             else trap("third effect must be git/push to the remote"))
                               | None() => trap("publish must push"))
                          else trap("commit must carry the message"))
                       | None() => trap("commit must carry the message payload"))
                  else trap("second effect must be git/commit"))
               | None() => trap("publish must commit"))
          else trap("first effect must be git/add"))
       | None() => trap("unit-complete must emit the publish sequence"))
  else trap("unit-complete must emit exactly three effects (add, commit, push)")

@test
def unit_complete_without_a_message_publishes_nothing() =
  let evt = {
    content-type = { family = "unit-complete", version = 1 },
    payload = None(),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  if List.len(apply(evt)) == 0 then unit
  else trap("a unit-complete with no commit message must publish nothing")

@test
def a_non_publish_event_drives_nothing() =
  let evt = {
    content-type = { family = "message", version = 1 },
    payload = Some(String.to-bytes("ignored")),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  if List.len(apply(evt)) == 0 then unit
  else trap("a non-publish event must drive nothing")

export { apply }
