// reducer_supervisor.cdz — ROLE LIBRARY: the §6 SUPERVISION role (pure fold).
//
// A self-hosting fleet parent SPAWNS children (sub-agents) and must react when one COMPLETES. The kernel
// surfaces a completed child as a first-class typed field on the Event: child-completed = Some(record with
// the child id + its terminal ChildOutcome (Success | Failure)); None on every non-completion event
// (wasm_host event_to_guest_inputs / ast_marshal::child_completed_val). This reducer is the reference
// SUPERVISOR: it folds a ChildCompleted into a reap/notify action — a completed child is acknowledged
// (child-done), a failed child is flagged for restart (child-restart), carrying the child id so the parent
// policy can act. Pure (returns effects only, no host import) -> cdz-test-gated like reducer_tick/inbox/
// vertical. Family-AGNOSTIC: it keys on the child-completed FIELD being present, not on a family string, so
// it reaps a completion however the host tags the delivering event.

// Shared strict Event value-form fields (same across the reducer-cadenza fixtures).
type ReplyPayload =
  | Inline(Bytes)
  | Blob(Bytes)

type Outcome =
  | Ok(ReplyPayload)
  | Err(Record(message: Bytes, retryable: Bool))
  | TimedOut

// §6 V2 per-child supervision: a ChildCompleted surfaces the completed child's terminal outcome.
type ChildOutcome =
  | Success(ReplyPayload)
  | Failure(Bytes)

def apply(
  event: Record(
    content-type: Record(family: String, version: UInt(32)),
    payload: Option(Bytes),
    resumes: Option(Bytes),
    outcome: Option(Outcome),
    child-completed: Option(Record(child: Bytes, outcome: ChildOutcome)),
  ),
) -> List(Record(
  kind: String,
  target: Bytes,
  payload: Option(Bytes),
  correlation: Option(Bytes),
)) =
  // Supervise: react to a completed child (family-agnostic — key on the child-completed field).
  match event.child-completed with
    | Some(cc) =>
      (match cc.outcome with
         // A child that finished OK is acknowledged/reaped.
         | Success(_) =>
           [{
             kind = "emit",
             target = String.to-bytes("child-done"),
             payload = Some(cc.child),
             correlation = None(),
           }]
         // A child that FAILED is flagged for the parent's restart policy (carrying its id).
         | Failure(_) =>
           [{
             kind = "emit",
             target = String.to-bytes("child-restart"),
             payload = Some(cc.child),
             correlation = None(),
           }])
    // No child completed on this event -> nothing to supervise.
    | None() => []

// Standalone behavioral coverage (`cdz test`, INDEPENDENT of any host).
@test
def a_successful_child_is_reaped_as_done() =
  let evt = {
    content-type = { family = "child-completed", version = 1 },
    payload = None(),
    resumes = None(),
    outcome = None(),
    child-completed = Some({
      child = String.to-bytes("child-A"),
      outcome = Success(Inline(String.to-bytes("ok"))),
    }),
  } in
  match List.at(apply(evt), 0) with
    | Some(eff) =>
      (if eff.kind == "emit" and eff.target == String.to-bytes("child-done") then
         (match eff.payload with
            | Some(c) => (if c == String.to-bytes("child-A") then unit else trap("must carry the child id"))
            | None() => trap("reap must carry the child id"))
       else trap("a successful child must be reaped as child-done"))
    | None() => trap("a ChildCompleted must fold to one supervision action")

@test
def a_failed_child_is_flagged_for_restart() =
  let evt = {
    content-type = { family = "child-completed", version = 1 },
    payload = None(),
    resumes = None(),
    outcome = None(),
    child-completed = Some({
      child = String.to-bytes("child-B"),
      outcome = Failure(String.to-bytes("boom")),
    }),
  } in
  match List.at(apply(evt), 0) with
    | Some(eff) =>
      (if eff.kind == "emit" and eff.target == String.to-bytes("child-restart") then
         (match eff.payload with
            | Some(c) => (if c == String.to-bytes("child-B") then unit else trap("must carry the child id"))
            | None() => trap("restart must carry the child id"))
       else trap("a failed child must be flagged child-restart"))
    | None() => trap("a ChildCompleted must fold to one supervision action")

@test
def an_event_without_a_child_completion_supervises_nothing() =
  let evt = {
    content-type = { family = "message", version = 1 },
    payload = Some(String.to-bytes("ordinary")),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  if List.len(apply(evt)) == 0 then unit
  else trap("an event with no child completion must supervise nothing")

export { apply }
