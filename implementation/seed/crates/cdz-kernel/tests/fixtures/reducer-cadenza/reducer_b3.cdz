// reducer_b3.cdz — B3: the FAITHFUL Cadenza port of the Rust reducer-guest (§21c real-reducer bar), ML surface.
//
// Behavior (mirrors ../reducer-guest/src/lib.rs exactly):
//   - resumes = Some(token)  -> a completed effect's result event; emit NOTHING (no cascade).
//   - content-type.family == "message" -> bump a KV "count" counter (kv get+put) + emit ONE Http effect
//     to https://ok.host/x with correlation token "step-1".
//   - any other event -> emit nothing.
// Exercises the FULL reducer surface: content-type field projection (ct.family), String equality (==),
// the kv host import (BOUND peer iface over the shared value-heap runtime — handle ABI, get+put),
// Option matching on resumes, conditional emit. This is the strongest §21c proof: a real behaved
// Cadenza reducer behaving identically to the interim Rust guest, through option-C marshalling.
//
// BUILD: cdz compile reducer_b3.cdz --target wasm --component-name cadenza:agent-kernel/fold
//   -> apply: func(u32,u32,u32)->u32 + imports cadenza:agent-kernel/kv + cadenza:runtime/heap; VALID.

// The protocol effect-request is an INLINE flat record (kind a family String, target Bytes, sorted fields)
// — the B2 value-form wire (ruling Q): the guest returns the flat record directly, value-encode(result) IS
// the wire (no Mk wrapper / EffectKind sum — kind is a lowercased family string, register-by-string seq366).
// `type X = Record(..)` in Cadenza is a single-variant SUM, so we spell the record type inline.

// kv host import — a WIT-typed peer interface (get/put on cadenza:agent-kernel/kv). Keys/values are opaque
// Bytes, lowered to the component-model `list<u8>` (get: func(key: list<u8>) -> option<list<u8>>, put: func(
// key: list<u8>, value: list<u8>)) — the same signatures reducer.wit declares and the kernel host linker
// registers. NOT a shared-value-heap handle ABI: B2 deleted that path, and kv is a fixed host interface over
// opaque bytes, so it stays WIT-typed (unlike apply's byte-AST channel, which carries arbitrary effect schemas).
effect Kv =
  | get : Bytes -> Option(Bytes)
  | put : `->`(Bytes, Bytes, Unit)

bind(Kv, "cadenza:agent-kernel/kv")

// The one http effect a "message" triggers — the flat protocol record.
def http-effect() -> Record(correlation: Option(Bytes), kind: String, payload: Option(Bytes), target: Bytes) =
  {
    correlation = Some(String.to-bytes("step-1")),
    kind = "http",
    payload = None(),
    target = String.to-bytes("https://ok.host/x"),
  }

// Bump the single-byte "count" counter, mirroring the Rust reducer-guest EXACTLY: read the first byte of
// the prior value (or 0 if absent/empty), wrapping_add(1), write it back as a one-byte Bytes.
//   Rust: let prev = kv::get(b"count").and_then(|v| v.first().copied()).unwrap_or(0);
//         kv::put(b"count", &[prev.wrapping_add(1)]);
// Bytes.at : Bytes -> Int64 -> Option(Int64); Bytes.of : List(UInt8) -> Bytes; UInt8.wrap : Int64 -> UInt8.
def bump-count(prev: Option(Bytes)) -> Bytes =
  let prev-byte = match prev with
    | Some(b) => (match Bytes.at(b, 0) with | Some(v) => v | None() => 0)
    | None() => 0
  in
  Bytes.of([UInt8.wrap(prev-byte + 1)])

def apply(
  ct: Record(family: String, version: UInt(32)),
  payload: Option(Bytes),
  resumes: Option(Bytes),
) -> List(Record(correlation: Option(Bytes), kind: String, payload: Option(Bytes), target: Bytes)) = match resumes with
  // A result/timer event — the effect completed; stop (no cascade).
  | Some(_) => []
  | None() =>
    if ct.family == "message" then
      // Inbound message: bump the KV "count" counter (read old byte, wrapping_add 1, write new) + emit
      // one Http effect — byte-for-byte the Rust reducer-guest's behavior.
      host Kv in (
        Kv.put(String.to-bytes("count"), bump-count(Kv.get(String.to-bytes("count"))));
        [http-effect()]
      )
    else
      []

// Behavioral coverage (runs on the seed compiler via `cdz test`, INDEPENDENT of the kernel host adapter;
// a plain `cdz compile` ignores @test). The `message` branch performs the `kv` effect, which needs a
// host handler (v-agent-harness's adapter drives that full E2E); so these @tests cover what's testable
// standalone — the resume-stops + non-message-ignored invariants, AND the pure `bump-count` counter
// semantics (byte-for-byte parity with the Rust reducer-guest). The message->one-Http-effect wiring is
// covered by the kernel-side E2E (behavioral parity vs the Rust reducer-guest).
@test
def b3_resume_event_emits_nothing() =
  if List.len(apply({ family = "message", version = 1 }, None(), Some(String.to-bytes("tok")))) == 0
  then unit
  else trap("B3 must emit nothing on a resume (result) event — no cascade")

@test
def b3_non_message_family_emits_nothing() =
  if List.len(apply({ family = "control", version = 1 }, None(), None())) == 0
  then unit
  else trap("B3 must emit nothing for a non-message content-type family")

// The counter mirrors the Rust guest byte-for-byte: absent/empty -> byte 1; a prior byte N -> N+1;
// wrapping at 255 -> 0 (matches prev.wrapping_add(1)).
@test
def b3_counter_absent_gives_byte_one() =
  if Bytes.at(bump-count(None()), 0) == Some(1) then unit
  else trap("bump-count(None) must be the single byte 1")

@test
def b3_counter_increments_prior_byte() =
  if Bytes.at(bump-count(Some(Bytes.of([5]))), 0) == Some(6) then unit
  else trap("bump-count of byte 5 must be byte 6")

@test
def b3_counter_wraps_at_max() =
  if Bytes.at(bump-count(Some(Bytes.of([UInt8.wrap(255)]))), 0) == Some(0) then unit
  else trap("bump-count of byte 255 must wrap to byte 0")

// Pin the Http effect-request's fields. The message branch performs kv so isn't callable standalone, but
// http-effect is a pure def — pin the kind, target, and correlation (the fields the host marshals via
// sum-disc, str-get, and sum-payload) so a silent target/token change is caught.
@test
def b3_http_effect_kind_is_http() =
  if http-effect().kind == "http" then unit
  else trap("B3's http-effect kind must be the family string \"http\"")

@test
def b3_http_effect_target_is_pinned() =
  if http-effect().target == String.to-bytes("https://ok.host/x") then unit
  else trap("B3's http-effect target must be https://ok.host/x")

@test
def b3_http_effect_correlation_is_pinned() =
  if http-effect().correlation == Some(String.to-bytes("step-1")) then unit
  else trap("B3's http-effect correlation must be Some(\"step-1\")")

@test
def b3_http_effect_payload_is_none() =
  match http-effect().payload with
    | None() => unit
    | Some(_) => trap("B3's http-effect payload must be None")

export { apply }
