// reducer_tick.cdz — ROLE LIBRARY increment #1: the self-scheduling TICK reducer.
//
// The guest/userspace analogue of the host TickLoopRole (GAP-5): a pure reducer that keeps a periodic
// tick alive by ARMING the next timer each time one fires, and emitting a "begin-tick" marker the rest of
// the fleet-loop roles (inbox-drain -> work -> MR, later increments) hang off. Proves the self-tick
// mechanism end-to-end on the seed VM, with NO host import (it only returns effects), so it is cdz-test
// -gated like reducer_pure/reducer_git.
//
// THE SELF-TICK CONVENTION (verified against the kernel + confirmed stable by v-agent-harness-host):
//   ARM  (reducer -> kernel): return a `timer` effect whose TARGET is the absolute deadline-ms as a
//        DECIMAL TEXT string (the kernel parses target_str as u64 -> a TimerArmed obligation).
//   FIRE (kernel -> reducer): at the deadline, the kernel delivers a `timer-fired` event whose PAYLOAD is
//        `fired_ms` as u64 LITTLE-ENDIAN bytes (fired_ms = the deadline, so replay is deterministic).
//   RE-ARM (pure, no clock): decode fired_ms from the LE payload, add the interval, arm the next timer at
//        `fired_ms + interval` — the fired event carries the reference time, so the fold stays pure.
//
// The ASYMMETRY (arm = decimal TEXT in the target; fire = u64 LE bytes in the payload) is bridged by two
// userspace numeric helpers below, since the reducer language has no Int64<->decimal-String prelude prim
// yet (rcdzc rust-emit lane, v-rust-backend, operator-paused; request routed to concierge by v-compiler-ml
// 2026-08-14 — this itoa is a sound library helper, NOT a compiler-defect workaround).
//
// SEEDING (increment #1 scope): the FIRST deadline arrives on a "tick-start" event payload (u64 LE ms); the
// INTERVAL is a fixed def here. A later increment folds v-agent-harness-host's genesis KV-SEED contract
// (KV[tick/interval-ms] + KV[tick/first-deadline-ms]) once the role goes host-fused for inbox/work state.

// The discriminated effect-result OUTCOME the kernel surfaces on an EffectResult event (shared strict Event
// value-form; this reducer folds no results but must declare the field). Reply payload discriminated
// (no-capability-drop): Inline bytes OR a Blob hash.
type ReplyPayload =
  | Inline(Bytes)
  | Blob(Bytes)

type Outcome =
  | Ok(ReplyPayload)
  | Err(Record(message: Bytes, retryable: Bool))
  | TimedOut

// §6 V2 per-child supervision field (shared Event value-form).
type ChildOutcome =
  | Success(ReplyPayload)
  | Failure(Bytes)

// The tick period in ms (15 min, matching the fleet's 15m tick). A fixed def for increment #1; a later
// increment reads KV[tick/interval-ms] from the genesis seed.
def interval-ms() -> Int64 = 900000

// --- numeric helpers (userspace, until an Int64<->decimal-String prelude prim lands) ---

// Read the byte at index i (0 if absent), as an Int64.
def byte-at(b: Bytes, i: Int64) -> Int64 =
  match Bytes.at(b, i) with
    | Some(v) => v
    | None() => 0

// Decode a little-endian u64 from the low 7 bytes (enough for any epoch-ms deadline; byte 7 is 0 for ms
// values and would risk an Int64 overflow at 256^7, so it is intentionally not read).
def le-u64(b: Bytes) -> Int64 =
  byte-at(b, 0)
  + byte-at(b, 1) * 256
  + byte-at(b, 2) * 65536
  + byte-at(b, 3) * 16777216
  + byte-at(b, 4) * 4294967296
  + byte-at(b, 5) * 1099511627776
  + byte-at(b, 6) * 281474976710656

// A single decimal digit (0..9) as its ASCII String. Digit bytes are always valid UTF-8, so the None arm
// is unreachable (String.from-bytes returns Option because arbitrary bytes may not be UTF-8).
def digit-char(d: Int64) -> String =
  match String.from-bytes(Bytes.of([UInt8.wrap(d + 48)])) with
    | Some(s) => s
    | None() => trap("a decimal digit byte is always valid ascii")

// Render an Int64 (>= 0) as its decimal String — the userspace itoa (recurse on n/10, append n%10).
def u64-decimal(n: Int64) -> String =
  if n < 10 then digit-char(n)
  else String.concat(u64-decimal(n / 10), digit-char(n % 10))

def apply(
  event: Record(
    content-type: Record(family: String, version: UInt(32)),
    payload: Option(Bytes),
    resumes: Option(Bytes),
    outcome: Option(Outcome),
    child-completed: Option(Record(child: Bytes, outcome: ChildOutcome)),
  ),
) -> List(Record(
  kind: String,
  target: Bytes,
  payload: Option(Bytes),
  correlation: Option(Bytes),
)) =
  let family = event.content-type.family in
  if family == "timer-fired" then
    // A tick fired: re-arm the next timer at fired_ms + interval + emit the begin-tick marker.
    (match event.payload with
       | Some(p) =>
         [
           {
             kind = "timer",
             target = String.to-bytes(u64-decimal(le-u64(p) + interval-ms())),
             payload = None(),
             correlation = None(),
           },
           {
             kind = "emit",
             target = String.to-bytes("begin-tick"),
             payload = None(),
             correlation = None(),
           },
         ]
       | None() => [])
  else if family == "tick-start" then
    // Seed the loop: arm the FIRST timer at the deadline carried in the payload (u64 LE ms).
    (match event.payload with
       | Some(p) =>
         [{
           kind = "timer",
           target = String.to-bytes(u64-decimal(le-u64(p))),
           payload = None(),
           correlation = None(),
         }]
       | None() => [])
  else
    // Any other event drives no tick.
    []

// Standalone behavioral coverage (`cdz test`, INDEPENDENT of any host; plain `cdz compile` ignores @test).
@test
def u64_decimal_renders_zero_small_and_a_full_ms() =
  if u64-decimal(0) == "0"
     and u64-decimal(7) == "7"
     and u64-decimal(42) == "42"
     and u64-decimal(1699999999000) == "1699999999000"
  then unit
  else trap("u64-decimal must render decimal correctly")

@test
def le_u64_decodes_little_endian() =
  // 1000 = 0x03E8 -> low byte 0xE8 (232), next 0x03 (3); trailing bytes absent (read as 0).
  if le-u64(Bytes.of([232, 3])) == 1000 then unit
  else trap("le-u64 must decode little-endian")

@test
def tick_start_arms_the_first_timer_at_the_seeded_deadline() =
  let evt = {
    content-type = { family = "tick-start", version = 1 },
    payload = Some(Bytes.of([232, 3])),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  match List.at(apply(evt), 0) with
    | Some(eff) =>
      (if eff.kind == "timer" then
         (if eff.target == String.to-bytes("1000") then unit
          else trap("first-arm deadline must be the seeded 1000"))
       else trap("tick-start must arm a timer"))
    | None() => trap("tick-start must fold to one timer arm")

@test
def timer_fired_rearms_at_fired_plus_interval_and_emits_begin_tick() =
  let evt = {
    content-type = { family = "timer-fired", version = 1 },
    payload = Some(Bytes.of([232, 3])),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  let effs = apply(evt) in
  if List.len(effs) == 2 then
    (match List.at(effs, 0) with
       | Some(t) =>
         (if t.kind == "timer" then
            // 1000 + 900000 = 901000
            (if t.target == String.to-bytes("901000") then
               (match List.at(effs, 1) with
                  | Some(e) => (if e.kind == "emit" and e.target == String.to-bytes("begin-tick") then unit
                                else trap("second effect must be the begin-tick emit"))
                  | None() => trap("timer-fired must also emit begin-tick"))
             else trap("re-arm deadline must be fired_ms + interval"))
          else trap("first effect must be the re-armed timer"))
       | None() => trap("timer-fired must re-arm a timer"))
  else trap("timer-fired must fold to exactly two effects (re-arm + begin-tick)")

@test
def a_non_tick_event_drives_no_tick() =
  let evt = {
    content-type = { family = "message", version = 1 },
    payload = Some(String.to-bytes("ignored")),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  if List.len(apply(evt)) == 0 then unit
  else trap("a non-tick event must drive no tick")

export { apply }
