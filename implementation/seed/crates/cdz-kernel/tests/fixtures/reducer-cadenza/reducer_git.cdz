// reducer_git.cdz — the GAP-6 reference reducer performing the built-in git/* effect family.
//
// A self-hosting agent replaces fleet-tooling, which drives git (sync, commit, push). GAP-6 makes those
// FIRST-CLASS typed effects instead of a coarse `shell`-runs-`git` allow-list. This reducer is the
// reference GUEST half of GAP-6 increment #4: it folds a trigger event into ONE built-in git/* effect,
// exercising the fleet-loop subset status -> add -> commit -> rev-parse. Each git op is performed exactly
// like `emit` — by RETURNING an effect record whose `kind` is the git family string (the returned-effect
// -list path, NOT a kv-style host import). The kernel parses each record into an EffectRequest carrying
// the INTRINSIC git/* schema-hash (ast_marshal::family_effect_schema_hash, pinned by
// effect_list_carries_the_intrinsic_git_schema_hash_through_the_reducer_dispatch_wire) and dispatches it
// by schema-hash to the host GitExecutor — git is BUILT-IN (executor-backed), never reified to a
// userspace effect/<name>. Cedar gates each op PER-VERB on the resolved repo/worktree/ref target
// (git_family_grants_are_per_op_and_scope_the_repo_branch_target).
//
// This is the GUEST half — @test-gated on the seed VM (`cdz test`, INDEPENDENT of any host). The FULL e2e
// (routing to the REAL GitExecutor over the bytes boundary) is v-agent-harness-host's, and lands when
// their GitExecutor (increment #2) does. It targets the PURE-FOLD world (fold.apply(list<u8>) ->
// list<u8>, no host import) — like reducer_pure — since it only constructs + returns effects.
//
// SHAPE (the FULL fleet-loop git surface — what a self-hosting agent needs to sync, branch, commit, and
// publish; target = the resolved Cedar RESOURCE the op acts on, payload = the op arg). The worktree ops
// target the worktree; fetch/push target the remote (both are valid Cedar resources — the exact per-op
// target is refined with the host GitExecutor + Cedar policy, this is the reference shape):
//   { family = "git-status" }              -> [ git/status   { target=worktree, payload=None } ]
//   { family = "git-diff" }                -> [ git/diff     { target=worktree, payload=None } ]
//   { family = "git-add", payload=Some(p) }-> [ git/add      { target=worktree, payload=Some(pathspec) } ]
//   { family = "git-commit", payload=Some }-> [ git/commit   { target=worktree, payload=Some(message) } ]
//   { family = "git-rev-parse", payload=S }-> [ git/rev-parse{ target=worktree, payload=Some(ref) } ]
//   { family = "git-checkout", payload=S } -> [ git/checkout { target=worktree, payload=Some(ref) } ]
//   { family = "git-fetch" }               -> [ git/fetch    { target=remote,   payload=None } ]
//   { family = "git-push", payload=Some }  -> [ git/push     { target=remote,   payload=Some(refspec) } ]
//   anything else                          -> [] (no effects)

// The discriminated effect-result OUTCOME the kernel surfaces on an EffectResult event (err-reply co-land):
// Some(Ok|Err|TimedOut) for an effect result, None otherwise. This reducer folds no results (it drives git
// forward, it does not yet read the git result back), but the shared Event value-form is strict, so the
// field must be declared. Reply payload is DISCRIMINATED (no-capability-drop): Inline bytes OR a Blob hash.
type ReplyPayload =
  | Inline(Bytes)
  | Blob(Bytes)

type Outcome =
  | Ok(ReplyPayload)
  | Err(Record(message: Bytes, retryable: Bool))
  | TimedOut

// §6 V2 per-child supervision: a ChildCompleted event surfaces the completed child's terminal outcome as a
// first-class typed field. Success|Failure (the CloseOutcome value-form), Success reusing ReplyPayload.
type ChildOutcome =
  | Success(ReplyPayload)
  | Failure(Bytes)

// The worktree this reducer's git ops act on (their resolved target = the Cedar resource). A def so every
// op names the byte-identical target; opaque to the kernel (Target=Bytes ruling), gated by Cedar policy.
def worktree() -> Bytes = String.to-bytes(".")

// The remote the sync/publish ops (fetch/push) target — their resolved Cedar resource. A def so both name
// the byte-identical remote; opaque to the kernel, gated by Cedar policy (e.g. permit git/push to origin).
def remote() -> Bytes = String.to-bytes("origin")

def apply(
  event: Record(
    content-type: Record(family: String, version: UInt(32)),
    payload: Option(Bytes),
    resumes: Option(Bytes),
    outcome: Option(Outcome),
    child-completed: Option(Record(child: Bytes, outcome: ChildOutcome)),
  ),
) -> List(Record(
  kind: String,
  target: Bytes,
  payload: Option(Bytes),
  correlation: Option(Bytes),
)) =
  let family = event.content-type.family in
  if family == "git-status" then
    // Read the working-tree state (no arg; the host GitExecutor returns the status bytes as the result).
    [{
      kind = "git/status",
      target = worktree(),
      payload = None(),
      correlation = None(),
    }]
  else if family == "git-diff" then
    // Show the working-tree changes (no arg; result = the diff bytes).
    [{
      kind = "git/diff",
      target = worktree(),
      payload = None(),
      correlation = None(),
    }]
  else if family == "git-add" then
    // Stage the pathspec carried by the event payload.
    [{
      kind = "git/add",
      target = worktree(),
      payload = event.payload,
      correlation = None(),
    }]
  else if family == "git-commit" then
    // Record a commit with the message carried by the event payload.
    [{
      kind = "git/commit",
      target = worktree(),
      payload = event.payload,
      correlation = None(),
    }]
  else if family == "git-rev-parse" then
    // Resolve the ref carried by the event payload (e.g. HEAD) to a sha.
    [{
      kind = "git/rev-parse",
      target = worktree(),
      payload = event.payload,
      correlation = None(),
    }]
  else if family == "git-checkout" then
    // Switch to (or create) the branch/ref carried by the event payload.
    [{
      kind = "git/checkout",
      target = worktree(),
      payload = event.payload,
      correlation = None(),
    }]
  else if family == "git-fetch" then
    // Sync remote refs (no arg); targets the remote resource, not the worktree.
    [{
      kind = "git/fetch",
      target = remote(),
      payload = None(),
      correlation = None(),
    }]
  else if family == "git-push" then
    // Publish the refspec carried by the event payload to the remote — the most authz-sensitive op.
    [{
      kind = "git/push",
      target = remote(),
      payload = event.payload,
      correlation = None(),
    }]
  else
    // Any other event drives no git op.
    []

// Standalone behavioral coverage (`cdz test`, INDEPENDENT of the kernel host adapter; plain `cdz compile`
// ignores @test). These pin the reference reducer's git-op contract on the seed VM; the real routing proof
// is v-agent-harness-host's GitExecutor e2e.
@test
def git_status_folds_to_one_target_out_status_effect() =
  let evt = {
    content-type = { family = "git-status", version = 1 },
    payload = None(),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  match List.at(apply(evt), 0) with
    | Some(eff) =>
      (if eff.kind == "git/status" then
         (if eff.target == String.to-bytes(".") then
            (match eff.payload with
               | Some(_) => trap("git/status is target-out — it carries no payload")
               | None() => unit)
          else trap("git/status target must be the worktree"))
       else trap("git-status must fold to a git/status effect"))
    | None() => trap("a git-status event must fold to one git effect")

@test
def git_add_carries_the_pathspec_payload() =
  let evt = {
    content-type = { family = "git-add", version = 1 },
    payload = Some(String.to-bytes("src/lib.rs")),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  match List.at(apply(evt), 0) with
    | Some(eff) =>
      (if eff.kind == "git/add" then
         (match eff.payload with
            | Some(p) => (if p == String.to-bytes("src/lib.rs") then unit else trap("git/add pathspec wrong"))
            | None() => trap("git/add must carry the pathspec payload"))
       else trap("git-add must fold to a git/add effect"))
    | None() => trap("a git-add event must fold to one git effect")

@test
def git_commit_carries_the_message_payload() =
  let evt = {
    content-type = { family = "git-commit", version = 1 },
    payload = Some(String.to-bytes("land it")),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  match List.at(apply(evt), 0) with
    | Some(eff) =>
      (if eff.kind == "git/commit" then
         (match eff.payload with
            | Some(p) => (if p == String.to-bytes("land it") then unit else trap("git/commit message wrong"))
            | None() => trap("git/commit must carry the message payload"))
       else trap("git-commit must fold to a git/commit effect"))
    | None() => trap("a git-commit event must fold to one git effect")

@test
def git_rev_parse_carries_the_ref_payload() =
  let evt = {
    content-type = { family = "git-rev-parse", version = 1 },
    payload = Some(String.to-bytes("HEAD")),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  match List.at(apply(evt), 0) with
    | Some(eff) =>
      (if eff.kind == "git/rev-parse" then
         (match eff.payload with
            | Some(p) => (if p == String.to-bytes("HEAD") then unit else trap("git/rev-parse ref wrong"))
            | None() => trap("git/rev-parse must carry the ref payload"))
       else trap("git-rev-parse must fold to a git/rev-parse effect"))
    | None() => trap("a git-rev-parse event must fold to one git effect")

