            | Some(_) => trap("git/diff is target-out — it carries no payload")
            | None() => unit)
       else trap("git-diff must fold to a git/diff effect"))
    | None() => trap("a git-diff event must fold to one git effect")

@test
def git_checkout_carries_the_ref_payload() =
  let evt = {
    content-type = { family = "git-checkout", version = 1 },
    payload = Some(String.to-bytes("fleet/v-agent-harness")),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  match List.at(apply(evt), 0) with
    | Some(eff) =>
      (if eff.kind == "git/checkout" then
         (match eff.payload with
            | Some(p) => (if p == String.to-bytes("fleet/v-agent-harness") then unit else trap("git/checkout ref wrong"))
            | None() => trap("git/checkout must carry the ref payload"))
       else trap("git-checkout must fold to a git/checkout effect"))
    | None() => trap("a git-checkout event must fold to one git effect")

@test
def git_fetch_targets_the_remote_with_no_payload() =
  let evt = {
    content-type = { family = "git-fetch", version = 1 },
    payload = None(),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  match List.at(apply(evt), 0) with
    | Some(eff) =>
      (if eff.kind == "git/fetch" then
         (if eff.target == String.to-bytes("origin") then
            (match eff.payload with
               | Some(_) => trap("git/fetch is target-out — it carries no payload")
               | None() => unit)
          else trap("git/fetch must target the remote"))
       else trap("git-fetch must fold to a git/fetch effect"))
    | None() => trap("a git-fetch event must fold to one git effect")

@test
def git_push_targets_the_remote_and_carries_the_refspec() =
  let evt = {
    content-type = { family = "git-push", version = 1 },
    payload = Some(String.to-bytes("HEAD:fleet/v-agent-harness")),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  match List.at(apply(evt), 0) with
    | Some(eff) =>
      (if eff.kind == "git/push" then
         (if eff.target == String.to-bytes("origin") then
            (match eff.payload with
               | Some(p) => (if p == String.to-bytes("HEAD:fleet/v-agent-harness") then unit else trap("git/push refspec wrong"))
               | None() => trap("git/push must carry the refspec payload"))
          else trap("git/push must target the remote"))
       else trap("git-push must fold to a git/push effect"))
    | None() => trap("a git-push event must fold to one git effect")

@test
def a_non_git_event_drives_no_git_op() =
  let evt = {
    content-type = { family = "message", version = 1 },
    payload = Some(String.to-bytes("ignored")),
    resumes = None(),
    outcome = None(),
    child-completed = None(),
  } in
  if List.len(apply(evt)) == 0 then unit
  else trap("a non-git event must drive no git op")

export { apply }
