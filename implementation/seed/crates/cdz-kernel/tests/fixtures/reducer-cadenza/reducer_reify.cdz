// reducer_reify.cdz — the schema-hash phase-1a REIFY e2e fixture: the FIRST reducer that PERFORMS a
// world-effect (not hand-builds an EffectRequest record), exercising the full chain non-vacuously —
// rcdzc reify_effect_to_tuple (eb34621ad) → the 3-field no-target reify record → kernel parse_effect_request
// (14b7c9885, target-free-tolerant). Gates v-effects' phase-2 atomic squash window.
//
// THE PERFORM (target-free, single-Bytes-arg — the shape the CURRENT reify covers, no @resource, no R2):
//   effect Probe = | fire : (Bytes) -> Unit    -- NOT a world import → the phase-1a fork reifies it
//   apply performs `host Probe in ([Probe.fire(p)])`: the `host Probe in` block is the entrypoint DELEGATION
//   (the CDZ0401 home); Probe's op is not an import member (only kv is a world import), so the sync/async fork
//   (is_world_import_op, 0a6538c01) takes the ASYNC branch → reify_effect_to_tuple, NOT a sync HostCall.
//
// REIFY OUTPUT (3-field, S2 — v-inference types the perform as this record, 9b12c0684):
//   Record { correlation: Option(Bytes)=None, kind: String="effect/Probe", payload: Option(Bytes)=Some(p) }
//   — capability-blind, target-free (no target column); the single Bytes arg → payload=Some(p). The kind is
//   "effect/<declared-effect-name>" VERBATIM (Probe, capitalized) — NOT lowercased/kebab-normalized (unlike
//   is_world_import_op's world-import match, 44a295288); phase-2 replaces the kind with the schema-hash, so
//   the casing is a cosmetic transitional label, but the reify derives it from the name as-written.
//
// Targets the PURE-FOLD world (fold.apply(list<u8>)->list<u8>, no kv import) — Probe escapes via the returned
// reified list, so no world import is needed for it. This is the smallest reducer that drives the reify path.
//
// BUILD (v-nix precompile, REIFY_PROBE_REDUCER_COMPONENT): emit-wit-world pure -> pure-world.bin; then
//   cdz compile reducer_reify.cdz wit-world:reducer-world=pure-world.bin
//     --component-name cadenza:agent-kernel/fold -o reducer_reify.wasm
//   -> exports fold.apply(list<u8>)->list<u8>; VALID; a `Some`-payload event folds to ONE reified perform.

// The target-free, single-Bytes-arg probe effect. NOT a world import (only kv is), so a host-delegated
// Probe.fire perform reifies (async) rather than lowering to a sync HostCall.
effect Probe = | fire : `->`(Bytes, Unit)

// Shared strict Event value-form types (input envelope unchanged this window — DISPATCHED-only collapse;
// content-type stays family/version-keyed). Declared so the strict Event record matches the other fixtures.
type ReplyPayload =
  | Inline(Bytes)
  | Blob(Bytes)

type Outcome =
  | Ok(ReplyPayload)
  | Err(Record(message: Bytes, retryable: Bool))
  | TimedOut

type ChildOutcome =
  | Success(ReplyPayload)
  | Failure(Bytes)

def apply(
  event: Record(
    content-type: Record(family: String, version: UInt(32)),
    payload: Option(Bytes),
    resumes: Option(Bytes),
    outcome: Option(Outcome),
    child-completed: Option(Record(child: Bytes, outcome: ChildOutcome)),
  ),
  // OUTPUT = the reified 3-field record (S2): correlation<kind<payload, NO target column. A world-effect
  // perform `Probe.fire(p)` in return position TYPES as this record (v-inference reify-typing rule); rcdzc's
  // reify lowers it to (None, "effect/probe", Some(p)).
) -> List(Record(correlation: Option(Bytes), kind: String, payload: Option(Bytes))) =
  // `host Probe in` = the entrypoint delegation giving Probe a home (no CDZ0401); Probe not being an import
  // makes the fork reify the perform.
  host Probe in (
    match event.payload with
      // A payloaded event folds to ONE reified Probe.fire perform echoing the payload.
      | Some(p) => [ Probe.fire(p) ]
      // A payload-free event requests no effects.
      | None() => [])

export { apply }
