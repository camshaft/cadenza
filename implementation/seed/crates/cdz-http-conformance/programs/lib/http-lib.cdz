// Shared HTTP-outpost guest library (DESIGN-http-outpost.md §7; operator: "a reusable library for routers and
// reducers … shouldn't have to keep redefining these types"). Every http-outpost guest — handlers + the root
// router — used to redefine the same HTTP domain types, the request-list boundary literal, the method-code
// map, and the effect/terminal builders. This module owns them so a guest keeps only its own logic. Composed
// via a guest's `libs` manifest (the mkCadenzaGuest multi-file path), alongside `reducer-lib` (whose Outcome
// the effect/terminal builders close with).
//
// The wire types (Header/Response, Deny, Dispatch) + the effect/terminal contract-ids come from the userspace
// CONTRACTS themselves (single source of truth — the same types + the same COMPUTED `descriptor().id` the
// gateway's effect resolver uses; no baked markers, no redefined shapes). Only the types no single wire
// contract owns (Method/Request/Route) are defined here. The `descriptor`s are imported under per-name aliases
// (three `descriptor`s would otherwise collide); the lib-closure pulls the contracts + `contract-id`
// transitively into any guest that composes this lib.
import { Outcome } from "reducer-lib"
import { Header, Response, descriptor as response-descriptor } from "http-response"
import { Deny, descriptor as deny-descriptor } from "http-deny"
import { Dispatch, descriptor as dispatch-descriptor } from "http-dispatch"

// The types no single wire contract owns: the request method (http-request + http-route-table each define
// their own Method/Header, which would collide if imported together, so a compatible copy lives here — the
// binary-AST decode is structural, so it still decodes the gateway's encoded http-request), and the router's
// baked Route entry.
type Method = | Get | Post | Put | Delete | Patch | Head | Options
type Request =
  | Request(Record(method: Method, path: String, query: String, headers: List(Header), body: Bytes))
type Route =
  | Route(Record(method: Method, path: String, handler: Bytes))

// The COMPUTED contract-ids the guests tag their effect/terminal payloads with — each userspace contract's own
// `descriptor().id` (the same id the gateway's effect resolver derives; one source of truth, no baked markers).
def dispatch-contract() = dispatch-descriptor().id
def http-response-schema() = response-descriptor().id
def deny-schema() = deny-descriptor().id

// The empty request list at the world-boundary record shape — annotated so an empty `[]` (which alone is
// `List Any`, uncrossable) is concrete at the host boundary. Every guest that emits no requests uses this.
def no-requests() =
  ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64))))

// Method → its wire code (Int64), for baked-table matching (runtime String-eq on the method is declined).
def method-code(m: Method) =
  (match m with | Get => 1 | Post => 2 | Put => 3 | Delete => 4 | Patch => 5 | Head => 6 | Options => 7)

// Close the fold with an http-response terminal carrying an already-encoded Response payload (used when the
// caller already has the encoded bytes, e.g. a router folding a handler's response through unchanged).
def respond-encoded(response: Bytes) =
  { requests = no-requests(),
    outcome = Outcome.Close({ schema = http-response-schema(), reason = response }) }

// Build a Response + close with it.
def respond(status: Int64, headers: List(Header), body: Bytes) =
  respond-encoded(Value.encode(Response.Response({ status = status, headers = headers, body = body })))

// Close with a deny terminal (a 4xx/5xx the edge renders).
def deny(status: Int64, reason: Bytes) =
  { requests = no-requests(),
    outcome = Outcome.Close({ schema = deny-schema(),
                              reason = Value.encode(Deny.Deny({ status = status, reason = reason })) }) }

// Emit a dispatch effect naming a handler ProgramHash + the request input; continue (awaiting the response).
def dispatch(handler: Bytes, input: Bytes) =
  { requests = [ { contract = dispatch-contract(),
                   payload = Value.encode(Dispatch.Dispatch({ subprogram = handler, input = input })),
                   token = b"root-dispatch",
                   deadlineNanos = (None : Option(UInt64)) } ],
    outcome = Outcome.Continue }

export { Method.*, Request.*, Route.*,
         dispatch-contract, http-response-schema, deny-schema, no-requests, method-code,
         respond-encoded, respond, deny, dispatch }
