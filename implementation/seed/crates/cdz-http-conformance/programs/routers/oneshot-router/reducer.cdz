// The ONESHOT ROOT ROUTER (D11 oneshot-dispatch model, v-hivemind ingress rewrite; operator 2026-09-15:
// "just support the single shot router interface that delegates to an ephemeral session", one interface, no
// backward-compat). The daemon drives this router HEAD-ONLY (drive_router) and it BREAKS (Outcome.Close) —
// never Continues — handing the request off to a handler BY ALIAS. The daemon reads the Break reason record's
// `alias` field, resolves it to a bound handler ProgramHash (drive::bind_name / resolve_name, a name
// directory), and spawns a FRESH ephemeral session for that handler, replaying the ORIGINAL request to it.
//
// THE ONESHOT CONTRACT (v-hivemind daemon-side):
//   * The router sees the http-request HEAD only and must NOT read the body (the daemon replays the ORIGINAL
//     request — head + unread body — to the resolved handler; that is the whole point of head-only).
//   * It must BREAK (terminal), never Continue, and import no effects — a Continue-ing or effectful router is
//     rejected by the daemon's classifier (classify_router_terminal: Continue => 500; any emitted
//     request/effect => 500).
//   * It Breaks UNDER the http.dispatch contract-id (schema) with a reason that is a value-doc RECORD carrying
//     ONE field named `alias` (non-empty bytes) = the handler alias. The daemon decodes the reason GENERICALLY
//     (record_field "alias"), so the reason is a plain alias record — NOT the classic subprogram-hash dispatch
//     shape. This is the ONLY dispatch interface the oneshot router speaks (no subprogram fallback path).
//
// Dispatch-BY-ALIAS needs NO build-time hash injection: the router names a stable alias ("echo") as a literal,
// resolved at dispatch time — so this source ships pristine (no placeholder handler markers, no deploy
// templating), unlike root-router-baked (the conformance gateway's classic dispatch-by-hash router).
//
// TWO REQUEST-DELIVERY SHAPES (mirrors counter): the request arrives either as the whole `http-request`
// `Request` value (the conformance gateway) or the head-first `Head` (method: String — the live hivemind
// daemon, no body). We dual-decode: try `Request` first, then a local structural `Head` copy. Both carry the
// path, so ONE `route` helper serves both. `Head` uses http-response's `Header` (structurally identical to
// http-request-head's own Header) so only ONE `Header` type is in scope (no CDZ0201 collision with `respond`).
import { Request, respond, dispatch-contract, no-requests } from "http-lib"
import { Header } from "http-response"
import { Outcome, on-response, on-notification } from "reducer-lib"

// Local structural copy of cdz-platform.http.request-head's `Head` (the live head-first delivery; `method` is a
// String here, "GET"/"POST"), using http-response's `Header` so only one `Header` type is in scope.
type Head =
  | Head(Record(method: String, path: String, query: String, headers: List(Header)))

// The oneshot route-decision reason: a value-doc record with a single `alias` field. Single-ctor record newtype
// (Value.encode elides the ctor + ascribes the inner record with the type name), so the encoded value is
// `(: #record((= alias b"echo")) RouteTarget)`; the daemon reads `record_field(reason, "alias")` generically.
type RouteTarget =
  | RouteTarget(Record(alias: Bytes))

// The BREAK terminal: hand off to a handler BY ALIAS. Break under the http.dispatch contract-id (schema) with
// the alias record as the reason. No subprogram / no router-supplied input — the daemon replays the ORIGINAL
// request to the resolved handler's fresh ephemeral session.
def dispatch-alias(alias: Bytes) =
  { requests = no-requests(),
    outcome = Outcome.Close({ schema = dispatch-contract(),
                              reason = Value.encode(RouteTarget.RouteTarget({ alias = alias })) }) }

// Route on path (BYTES equality; runtime String-eq is declined): /echo -> Break dispatching alias "echo"; a
// trivial GET / fast-path -> a direct one-shot http.response 200 (the optional smoke, proving a router MAY also
// terminate directly); anything else -> 404 deny (a one-shot http.response the edge renders).
def route(path: Bytes) =
  (if path == b"/echo" then dispatch-alias(b"echo")
   else (if path == b"/" then respond(200, [], b"oneshot router: dispatch by alias")
         else respond(404, [], b"not found")))

// Dual-decode: whole Request (conformance gateway) first, then the head-first Head (live hivemind daemon). We
// read only the path (never the body) — head-only. A malformed request -> 404.
def on-message(msg) =
  (match (Value.decode(msg.payload) : Option(Request)) with
   | Some(Request.Request(rq)) => route(String.to-bytes(rq.path))
   | None(_) =>
     (match (Value.decode(msg.payload) : Option(Head)) with
      | Some(Head.Head(h)) => route(String.to-bytes(h.path))
      | None(_) => respond(404, [], b"not found")))

export { on-message, on-response, on-notification }
