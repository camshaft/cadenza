// The ONESHOT ROOT ROUTER (D11.2 oneshot-dispatch + D16 sibling-contract flip; v-hivemind ingress). The
// daemon drives this router HEAD-ONLY (drive_router) and it BREAKS (Outcome.Close) — never Continues, imports
// no effects — handing the request off to a handler by NAME or by direct CAS target. A Continue-ing or
// effectful router is rejected by the daemon's classifier.
//
// D16 SIBLING CONTRACTS (operator: sibling contracts, not an enum — mirrors http.response / http.response-cas):
// the dispatch-target distinction rides in the CONTRACT-ID the router Breaks UNDER, not a variant:
//   * BREAK http.dispatch-name with DispatchName(Record(name, input)) — the daemon resolve_names `name` (a
//     name-directory key) to a cas target, spawns a FRESH ephemeral session, and replays the ORIGINAL request.
//   * BREAK http.dispatch-cas with DispatchCas(Record(target, input)) — `target` is a handler's 33-byte
//     ProgramHash; the daemon spawns it DIRECTLY (no lookup). (The former http.dispatch Target enum is retired.)
// `input` is empty here — the daemon replays the original request, so a oneshot router supplies none.
//
// TWO REQUEST-DELIVERY SHAPES (mirrors counter): the request arrives either as the whole `http-request`
// `Request` value (the conformance gateway) or the head-first `Head` (method: String — the live hivemind
// daemon, no body). We dual-decode: try `Request` first, then a local structural `Head` copy. Both carry the
// path, so ONE `route` helper serves both. `Head` uses http-response's `Header` (structurally identical to
// http-request-head's own Header) so only ONE `Header` type is in scope (no CDZ0201 collision with `respond`).
import { Request, respond, no-requests } from "http-lib"
import { DispatchName, descriptor as dispatch-name-descriptor } from "http-dispatch-name"
import { DispatchCas, descriptor as dispatch-cas-descriptor } from "http-dispatch-cas"
import { Header } from "http-response"
import { Outcome, on-response, on-notification } from "reducer-lib"

// Local structural copy of cdz-platform.http.request-head's `Head` (the live head-first delivery; `method` is a
// String here, "GET"/"POST"), using http-response's `Header` so only one `Header` type is in scope.
type Head =
  | Head(Record(method: String, path: String, query: String, headers: List(Header)))

// BREAK terminal: hand off to a handler BY NAME (http.dispatch-name). The daemon resolve_names `name` to a cas
// target and drives it with the original request. Empty input (the daemon replays the original request).
def dispatch-name(name: Bytes) =
  { requests = no-requests(),
    outcome = Outcome.Close({ schema = dispatch-name-descriptor().id,
                              reason = Value.encode(DispatchName.DispatchName({ name = name, input = b"" })) }) }

// BREAK terminal: hand off to a handler by DIRECT CAS target (http.dispatch-cas) — `target` is a 33-byte
// ProgramHash the daemon spawns directly, no name lookup. The baked hash below is the http-flex-echo handler's
// ProgramHash (03Mxlm5GLdFnbDTV3No7fR3FEul1D124nwntSAcpl12Pv), so the /direct-echo route dispatches to it
// WITHOUT a name binding — exercising the Cas dispatch sibling.
def dispatch-cas(target: Bytes) =
  { requests = no-requests(),
    outcome = Outcome.Close({ schema = dispatch-cas-descriptor().id,
                              reason = Value.encode(DispatchCas.DispatchCas({ target = target, input = b"" })) }) }

def flex-echo-hash() =
  b"\x03\x71\x37\xed\xf3\xc1\x20\x74\xdd\x32\xef\x76\xf2\xa4\xb6\x64\x16\xea\x4e\x0e\xe2\xc5\xfc\x2b\xbc\x0e\xe9\xad\xe7\x4b\x09\xfe\x57"

// Route on path (BYTES equality; runtime String-eq is declined): /echo -> dispatch by NAME "echo";
// /direct-echo -> dispatch by direct CAS target (the baked flex-echo hash); GET / -> a direct 200 http.response
// smoke (proving a router MAY also terminate directly); anything else -> 404 deny.
def route(path: Bytes) =
  (if path == b"/echo" then dispatch-name(b"echo")
   else (if path == b"/direct-echo" then dispatch-cas(flex-echo-hash())
         else (if path == b"/" then respond(200, [], b"oneshot router: dispatch by name or cas target")
               else respond(404, [], b"not found"))))

// Dual-decode: whole Request (conformance gateway) first, then the head-first Head (live hivemind daemon). We
// read only the path (never the body) — head-only. A malformed request -> 404.
def on-message(msg) =
  (match (Value.decode(msg.payload) : Option(Request)) with
   | Some(Request.Request(rq)) => route(String.to-bytes(rq.path))
   | None(_) =>
     (match (Value.decode(msg.payload) : Option(Head)) with
      | Some(Head.Head(h)) => route(String.to-bytes(h.path))
      | None(_) => respond(404, [], b"not found")))

export { on-message, on-response, on-notification }
