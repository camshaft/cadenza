// The ROOT ROUTER governing program — OPERATOR-MANDATED shape: the routing table (routes + the REAL handler
// ProgramHashes) is BAKED INTO the program + compiled ahead of time, then SHIPPED BY HASH. The dumb gateway
// holds nothing: it fetches this program from the CAS by the control-supplied hash and drives it with a BARE
// http-request. A route change = recompile with the new table + push the new program hash.
//
// Composed from the shared libs (operator 2026-09-10: no inline worlds; reuse the mechanism): the
// `Route`/`Method`/`Request` types + the `dispatch`/`deny`/`respond-encoded`/`method-code` helpers from
// `http-lib`, the reducer-world boundary from the witWorld artifact, `Outcome`/`Error` + the inert
// on-notification from `reducer-lib`. The router keeps its own on-response (it folds the handler's response),
// its baked route table, and the match logic. See the `libs` manifest beside this file.
//
// NOTE (compile gate): the handler hashes baked below are PLACEHOLDER 33-byte markers the deploy tooling
// replaces with the real deployed handler ProgramHashes; and the dispatch/deny/response contract-ids come
// from http-lib's (centralized) markers, to be swapped for the computed userspace-contract ids in one place.
import { Method, Route, Request, dispatch, deny, respond-encoded, method-code } from "http-lib"
import { Error, on-notification } from "reducer-lib"

// THE BAKED ROUTE TABLE. Handler values are the target handlers' real 33-byte ProgramHashes — here PLACEHOLDER
// markers the deploy tooling replaces before compiling.
def routes() =
  ([ Route.Route({ method = Method.Get, path = "/", handler = b"cdz-http.handler.root..........." }),
     Route.Route({ method = Method.Post, path = "/echo", handler = b"cdz-http.handler.echo..........." }) ]
   : List(Route))

// Recurse the BAKED table; first (method, path) match → dispatch its handler; exhausted → 404 deny. Method by
// code (Int64-eq), path by BYTES equality (runtime String-eq is declined; Bytes-eq lowers).
def find(rs: List(Route), mc: Int64, p: Bytes, input: Bytes) =
  (match rs with
   | [] => deny(404, b"not found")
   | [head, .. rest] =>
     (match head with
      | Route.Route(r) =>
        if method-code(r.method) == mc then
          (if String.to-bytes(r.path) == p then dispatch(r.handler, input)
           else find(rest, mc, p, input))
        else find(rest, mc, p, input)))

// The gateway delivers a BARE http-request (no envelope, no table — the table is baked). Decode it, match the
// baked table. A malformed request → 404 deny.
def on-message(msg) =
  (match (Value.decode(msg.payload) : Option(Request)) with
   | Some(Request.Request(rq)) => find(routes(), method-code(rq.method), String.to-bytes(rq.path), msg.payload)
   | None => deny(404, b"not found"))

// The handler's response folds back through on-response: close with it as the http-response terminal; a fold
// error → 502 deny.
def on-response(resp: Record(contract: Bytes, token: Bytes, answer: Result(Bytes, Error))) =
  (match resp.answer with
   | Ok(response) => respond-encoded(response)
   | Err(_) => deny(502, b"bad gateway"))

export { on-message, on-response, on-notification }
