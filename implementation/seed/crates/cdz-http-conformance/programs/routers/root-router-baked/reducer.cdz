// The ROOT ROUTER governing program — OPERATOR-MANDATED shape (2026-09-10 A/B decision): the routing table
// (routes + the REAL handler ProgramHashes) is BAKED INTO the program and COMPILED ahead of time, then
// SHIPPED BY HASH. The dumb gateway holds NOTHING: it fetches this program from the CAS by the control-
// supplied hash and drives it with a BARE http-request. A route change = RECOMPILE this program with the new
// table + push the new program hash (the gateway's live-swap cell swaps the HASH). Operator, verbatim: "I
// want the routing logic to be built into the program … we should just be shipping a program and not
// template it" — i.e. the router source below carries the table as a literal, compiled by the deploy tooling.
//
// This SUPERSEDES the router-dynamic / RouteQuery{request,table} shape (where the gateway carried the table
// and passed it in): the table is no longer on the wire, it is baked here. Everything else is unchanged from
// the request-emitting root router: match (method, path), EMIT a `dispatch` effect naming the matched
// handler's baked ProgramHash + the request as input, fold the handler's response back, Close with it; a
// no-match → a `deny` (404). Stateless, self-contained INLINE world, no host capability → lowers to VALID
// wasm (the request-emitting shape proven in #8642/#8645).
//
// NOTE (compile gate): the handler hashes baked below are PLACEHOLDER 33-byte markers standing in for the
// real deployed handler ProgramHashes the deploy tooling bakes. Building this via mkCadenzaGuest gates that
// the baked-table + bare-request shape stays valid Cadenza + a valid reducer component. The runtime e2e
// (bake a REAL handler hash via the deploy-templating step, drive with a bare request → the real handler)
// is the follow-on slice.
world reducer-world =
  | export guest =
    | on-message : (msg : {contract: list(u8),
                           sender: {reducer: list(u8), host: list(u8)},
                           payload: list(u8),
                           token: list(u8)})
                 -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                     outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-response : (resp : {contract: list(u8),
                             token: list(u8),
                             answer: result(list(u8), variant(timeout, missing-handler, schema-violation, faulted))})
                  -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                      outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}
    | on-notification : (note : {contract: list(u8), payload: list(u8)})
                      -> {requests: list({contract: list(u8), payload: list(u8), token: list(u8), deadline-nanos: option(u64)}),
                          outcome: variant(continue, close({schema: list(u8), reason: list(u8)}))}

type Outcome =
  | Continue
  | Close(Record(schema: Bytes, reason: Bytes))
type Error = | Timeout | MissingHandler | SchemaViolation | Faulted

type Method = | Get | Post | Put | Delete | Patch | Head | Options
type Header  = | Header(Record(name: String, value: String))
type Request =
  | Request(Record(method: Method, path: String, query: String, headers: List(Header), body: Bytes))
// One BAKED route entry: the (method, path) key + the target handler's ProgramHash bytes.
type Route =
  | Route(Record(method: Method, path: String, handler: Bytes))
type DispatchEffect =
  | DispatchEffect(Record(subprogram: Bytes, input: Bytes))
type Deny =
  | Deny(Record(status: Int64, reason: Bytes))

// v0 contract-id markers (exactly Hash::LEN = 33 bytes). MUST byte-match the Rust side: effects.rs
// DISPATCH_MARKER + codec.rs HTTP_RESPONSE_MARKER/DENY_MARKER.
def dispatch-contract() = b"cdz.http.dispatch................"
def http-response-schema() = b"cdz-platform.http.response......."
def deny-schema() = b"cdz-platform.http.deny..........."

// THE BAKED ROUTE TABLE. Handler values are the target handlers' real 33-byte ProgramHashes — here
// PLACEHOLDER markers the deploy tooling replaces with the real deployed hashes before compiling.
def routes() =
  ([ Route.Route({ method = Method.Get, path = "/", handler = b"cdz-http.handler.root..........." }),
     Route.Route({ method = Method.Post, path = "/echo", handler = b"cdz-http.handler.echo..........." }) ]
   : List(Route))

def no-requests() =
  ([] : List(Record(contract: Bytes, payload: Bytes, token: Bytes, deadlineNanos: Option(UInt64))))

def method-code(m: Method) =
  (match m with | Get => 1 | Post => 2 | Put => 3 | Delete => 4 | Patch => 5 | Head => 6 | Options => 7)

def deny(status: Int64, reason: Bytes) =
  { requests = no-requests(),
    outcome = Outcome.Close({ schema = deny-schema(),
                              reason = Value.encode(Deny.Deny({ status = status, reason = reason })) }) }

def dispatch(handler: Bytes, input: Bytes) =
  { requests = [ { contract = dispatch-contract(),
                   payload = Value.encode(DispatchEffect.DispatchEffect({ subprogram = handler, input = input })),
                   token = b"root-dispatch",
                   deadlineNanos = (None : Option(UInt64)) } ],
    outcome = Outcome.Continue }

// Recurse the BAKED table; first (method, path) match → dispatch its handler; exhausted → 404 deny. Method
// by code (Int64-eq), path by BYTES equality (runtime String-eq is declined; Bytes-eq lowers).
def find(rs: List(Route), mc: Int64, p: Bytes, input: Bytes) =
  (match rs with
   | [] => deny(404, b"not found")
   | [head, .. rest] =>
     (match head with
      | Route.Route(r) =>
        if method-code(r.method) == mc then
          (if String.to-bytes(r.path) == p then dispatch(r.handler, input)
           else find(rest, mc, p, input))
        else find(rest, mc, p, input)))

// The gateway delivers a BARE http-request (no envelope, no table — the table is baked). Decode it, match
// the baked table. A malformed request → 404 deny.
def on-message(msg) =
  (match (Value.decode(msg.payload) : Option(Request)) with
   | Some(Request.Request(rq)) => find(routes(), method-code(rq.method), String.to-bytes(rq.path), msg.payload)
   | None => deny(404, b"not found"))

def on-response(resp: Record(contract: Bytes, token: Bytes, answer: Result(Bytes, Error))) =
  (match resp.answer with
   | Ok(response) => { requests = no-requests(),
                       outcome = Outcome.Close({ schema = http-response-schema(), reason = response }) }
   | Err(_) => deny(502, b"bad gateway"))

def on-notification(_note: Record(contract: Bytes, payload: Bytes)) =
  { requests = no-requests(), outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
