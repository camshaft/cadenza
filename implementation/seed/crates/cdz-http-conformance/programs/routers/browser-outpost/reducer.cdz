// The BROWSER-OUTPOST router (DESIGN-browser-outpost.md) — the LIVE INTERACTIVE outpost, serving the AOT
// (build-time jco-transpiled) bundle. In-tab jco-transpile does NOT work in a browser (jco-transpile calls
// Node fs.readFile — unimplemented in browser shims), so the reducer is jco-transpiled AT BUILD TIME (nix
// build .#browser-outpost-bundle) and the router serves those static ES modules + core wasm; the page just
// imports + instantiates them (no in-tab jco). All same-origin over the dumb gateway:
//   GET /                                          -> text/html    the page (mount + click/reset buttons)
//   GET /app.js                                    -> text/javascript  the bootstrap: import the AOT ESM,
//                                                     instantiate runtime + reducer, drive on-message on clicks
//   GET /browserOutpostApp/browserOutpostApp.js    -> text/javascript  } the AOT-transpiled reducer + runtime
//   GET /browserOutpostApp/browserOutpostApp.core*.wasm -> application/wasm } ES modules + core wasm, served
//   GET /heap/heap.js                              -> text/javascript  } same-origin from CAS by baked hash
//   GET /heap/heap.core*.wasm                      -> application/wasm  }
//   non-GET / unknown -> 405 / 404
//
// SERVING (v-hivemind-confirmed): the gateway backs the guest's `blobs` import with the shared CAS, so the
// router reads each bundle file by its baked ProgramHash via blobs.get and `respond`s it with the right
// content-type. Per-request this moves ONE file (<= 275KB) through guest memory — fine at this size — and uses
// ONE Header type (http-lib), avoiding the CDZ0201 collision that all-response-cas would hit (response-cas
// declares its own Header, and decoding the Request pulls http-request's Header -> two Headers). The 7 asset
// ProgramHashes are baked as fixed-width 33-byte placeholder markers the deploy tooling substitutes + it seeds
// the 7 bundle files into the live CAS. HTML + /app.js are inline (small, no marker).
import { Method, Request, respond, deny, method-code } from "http-lib"
import { Header } from "http-response"
import { on-response, on-notification } from "reducer-lib"

// The 7 AOT bundle-file ProgramHashes (33-byte markers the deploy substitutes via cdz-http-programhash --escaped
// after seeding each file into the live CAS; content is `nix build .#browser-outpost-bundle` -> result/<path>).
def h-app-js()    = (b"cdz-http.bo.app.js..............." : Bytes)
def h-app-core()  = (b"cdz-http.bo.app.core............." : Bytes)
def h-app-core2() = (b"cdz-http.bo.app.core2............" : Bytes)
def h-heap-js()   = (b"cdz-http.bo.heap.js.............." : Bytes)
def h-heap-core() = (b"cdz-http.bo.heap.core............" : Bytes)
def h-heap-core2()= (b"cdz-http.bo.heap.core2..........." : Bytes)
def h-heap-core3()= (b"cdz-http.bo.heap.core3..........." : Bytes)

// Serve a bundle file same-origin: read by ProgramHash via the blobs host import, respond with its content-type.
def serve-asset(ct: String, h: Bytes) =
  (match blobs.get(h) with
   | Some(bytes) => respond(200, [Header.Header({ name = "content-type", value = ct })], bytes)
   | None(_) => deny(404, b"not found"))

def html-page() =
  respond(200,
    [Header.Header({ name = "content-type", value = "text/html" })],
    b"<!doctype html><html lang='en'><head><meta charset='utf-8'><title>Cadenza Browser Outpost</title></head><body><h1>Cadenza browser outpost</h1><p>A Cadenza reducer, shipped to this tab as a wasm component and driven as a pure fold. The buttons drive its on-message (DOM-as-effect); the display is the reducer's render patch.</p><div id='app'>loading reducer...</div><button data-cdz-event='cadenza.dom.event.click'>click (drive the reducer)</button><button data-cdz-event='cadenza.agent.reset'>agent reset</button><pre id='log' style='color:#666;font-size:.8rem'></pre><script type='module' src='/app.js'></script></body></html>")

// The AOT bootstrap: import the build-time-transpiled ESM, instantiate the value-heap runtime + the reducer
// (getCore fetches the core wasm from the served same-origin paths), drive on-message on clicks, apply the
// render patch. NO in-tab jco. Single-quoted, no backslash-escapes so the byte-string literal is literal.
def bootstrap-js() =
  respond(200,
    [Header.Header({ name = "content-type", value = "text/javascript" })],
    b"const mount=document.getElementById('app');const logEl=document.getElementById('log');const log=(m)=>{if(logEl)logEl.textContent=logEl.textContent+m+' | ';};const enc=new TextEncoder();const patchText=(payload)=>{const s=new TextDecoder('latin1').decode(payload);const runs=s.match(/[ -~]{3,}/g)||[];const skip=['Patch','Text','Element','cdzast'];const best=runs.filter((r)=>skip.indexOf(r.trim())<0).sort((a,b)=>b.length-a.length)[0];return best?best.trim():'(empty)';};const apply=(step)=>{if(step&&step.requests&&step.requests[0])mount.textContent=patchText(step.requests[0].payload);};(async()=>{try{mount.textContent='loading reducer...';const NFC={nfc:(b)=>enc.encode(new TextDecoder('utf-8').decode(b).normalize('NFC'))};const heapMod=await import('/heap/heap.js');const heapGetCore=async(p)=>WebAssembly.compile(await (await fetch('/heap/'+p)).arrayBuffer());const hroot=await heapMod.instantiate(heapGetCore,{'cadenza:nfc/normalize':NFC});const heapKey=Object.keys(hroot).find((k)=>k.indexOf('heap')>=0);const stateMap=new Map();const kstr=(k)=>new TextDecoder('latin1').decode(k);const stateShim={get:(k)=>stateMap.get(kstr(k)),put:(k,v)=>{stateMap.set(kstr(k),v);},delete:(k)=>{stateMap.delete(kstr(k));}};const stub=new Proxy({},{get:()=>()=>undefined});const imports=new Proxy({},{get:(_t,key)=>{if(typeof key!=='string')return stub;if(key.indexOf('cadenza:runtime/heap')===0)return hroot[heapKey];if(key.indexOf('/state')>=0)return stateShim;return stub;}});const appMod=await import('/browserOutpostApp/browserOutpostApp.js');const appGetCore=async(p)=>WebAssembly.compile(await (await fetch('/browserOutpostApp/'+p)).arrayBuffer());const aroot=await appMod.instantiate(appGetCore,imports);const g=aroot['cadenza:platform/guest']||aroot.guest;const e=new Uint8Array();const msg=(c)=>({contract:c,sender:{reducer:e,host:e},payload:e,token:e});apply(g.onMessage(msg(e)));document.querySelectorAll('[data-cdz-event]').forEach((el)=>el.addEventListener('click',()=>apply(g.onMessage(msg(enc.encode(el.getAttribute('data-cdz-event')))))));log('reducer running - events wired generically from wasm-declared data-cdz-event');}catch(err){mount.textContent='failed to start: '+(err&&err.message?err.message:err);log('ERROR '+(err&&err.stack?err.stack:err));}})();")

// GET-only. Wrap in `host blobs in` so blobs.get is in scope for the asset routes (blobs is already in the
// reducer-world wit-world). / + /app.js are inline; the 7 AOT files are served from CAS by baked hash.
def on-message(msg) =
  host blobs in
    (match (Value.decode(msg.payload) : Option(Request)) with
     | Some(Request.Request(rq)) =>
       (if method-code(rq.method) == method-code(Method.Get) then
          (if String.to-bytes(rq.path) == b"/" then html-page()
           else if String.to-bytes(rq.path) == b"/app.js" then bootstrap-js()
           else if String.to-bytes(rq.path) == b"/browserOutpostApp/browserOutpostApp.js" then serve-asset("text/javascript", h-app-js())
           else if String.to-bytes(rq.path) == b"/browserOutpostApp/browserOutpostApp.core.wasm" then serve-asset("application/wasm", h-app-core())
           else if String.to-bytes(rq.path) == b"/browserOutpostApp/browserOutpostApp.core2.wasm" then serve-asset("application/wasm", h-app-core2())
           else if String.to-bytes(rq.path) == b"/heap/heap.js" then serve-asset("text/javascript", h-heap-js())
           else if String.to-bytes(rq.path) == b"/heap/heap.core.wasm" then serve-asset("application/wasm", h-heap-core())
           else if String.to-bytes(rq.path) == b"/heap/heap.core2.wasm" then serve-asset("application/wasm", h-heap-core2())
           else if String.to-bytes(rq.path) == b"/heap/heap.core3.wasm" then serve-asset("application/wasm", h-heap-core3())
           else deny(404, b"not found"))
        else deny(405, b"method not allowed"))
     | None => deny(404, b"not found"))

export { on-message, on-response, on-notification }
