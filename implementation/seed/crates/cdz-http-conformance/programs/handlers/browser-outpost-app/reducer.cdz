// The BROWSER-OUTPOST APP reducer (DESIGN-browser-outpost.md §3, milestone S2a): a reducer-world guest that,
// on a message, EMITS a `render` EFFECT carrying a vDOM patch as a cadenza-ast VALUE, then continues. This is
// the DOM-as-effect model (operator 2026-09-11: "expose as many browser APIs as effects … cadenza programs
// drive the browser"): the reducer is the app's Elm `update`, the render patch is `view`'s diff. Crucially the
// reducer emits a render REQUEST (a pure-fold effect), NOT an imperative DOM call — so the UI stays a
// deterministic, replayable projection of fold state (design §11), and the browser host applies the patch.
//
// This is the HEADLESS half of S2: the reducer EMITS the render effect, which is asserted by driving its
// on-message via jco (browser-outpost-jco-transpile check) and inspecting the emitted step's requests — no
// browser needed. The real dom WIT interface + the browser host that APPLIES the patch (and delivers DOM
// events back as messages) is the browser-driver follow-on (design §3, the known browser-driver gap).
//
// Composed from reducer-lib only (Outcome + the `request` builder + the inert on-response/on-notification):
// this reducer emits an effect and continues; the render is fire-and-forget for S2a (no child response folded),
// so the inert on-response is correct here.
import { Outcome, request, on-response, on-notification } from "reducer-lib"

// A minimal vDOM patch (design §3.1): a text node for S2a. Elements/attrs/keyed edits are the S2b follow-on.
type Patch = | Text(String)

// The render contract a browser dom host backs (§3.1). A 33-byte marker id for this headless emit-proof; the
// real `dom` WIT interface + capability is a platform follow-on (design §3.3).
def render-contract() = (b"cadenza.dom.render..............." : Bytes)

def on-message(_msg) =
  { requests = [ request(render-contract(),
                         Value.encode(Patch.Text("hello from a cadenza reducer")),
                         b"render") ],
    outcome = Outcome.Continue }

export { on-message, on-response, on-notification }
