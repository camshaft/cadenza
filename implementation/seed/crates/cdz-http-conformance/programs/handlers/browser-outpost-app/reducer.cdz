// The BROWSER-OUTPOST APP reducer (DESIGN-browser-outpost.md §3, milestones S2a/S2b): a reducer-world guest
// that DRIVES THE BROWSER via effects (operator 2026-09-11: "expose as many browser APIs as effects … cadenza
// programs drive the browser"). It implements the full Elm cycle as a pure fold:
//   * OUTBOUND (S2a, §3.1): on a message it EMITS a `render` EFFECT carrying a vDOM patch as a cadenza-ast
//     VALUE — a render REQUEST, not an imperative DOM call, so the UI is a deterministic/replayable projection.
//   * INBOUND (S2b, §3.2): a user interaction arrives as a `message` with a `dom-event` contract (a click,
//     an input); the reducer FOLDS it into a NEW render patch. To the reducer a DOM event and any other
//     message are the same on-message call — they differ only by contract — which is what makes the app both
//     user- and agent-drivable (§7) over one fold.
// This is the HEADLESS half of the DOM loop (emit + fold, asserted by driving on-message via jco). The browser
// host that APPLIES the patch to the real DOM and DELIVERS real DOM events is the browser-driver follow-on.
//
// State ACROSS events (a counter, form state) is the `state` host import (browser = IndexedDB, §5); this S2b
// slice is a pure event→view fold (no persistent state), which is what a headless drive can pin.
import { Outcome, request, on-response, on-notification } from "reducer-lib"

// A minimal vDOM patch (§3.1): a text node for now. Elements/attrs/keyed edits are the S2b+ follow-on.
type Patch = | Text(String)

// The render contract a browser dom host backs (§3.1) — a marker id for the headless emit-proof.
def render-contract() = (b"cadenza.dom.render..............." : Bytes)
// The dom-event contract a click arrives on (§3.2) — the inbound half. A message on this contract is a user
// click; any other contract is the initial/agent message. (A real dom WIT interface pins these; marker for now.)
def click-contract() = (b"cadenza.dom.event.click" : Bytes)

// The state key under which the app persists its click history (design §5: state → IndexedDB in the browser,
// a Map in the headless check — the reducer is host-agnostic).
def clicked-key() = (b"browser-outpost.clicked" : Bytes)

// Emit a render effect carrying the patch value, then continue.
def render(patch: Patch) =
  { requests = [ request(render-contract(), Value.encode(patch), b"render") ],
    outcome = Outcome.Continue }

// Fold a message → a render patch, MAINTAINING STATE ACROSS EVENTS via the `state` host import (§5) — the
// core of a real app. A click reads prior state: the FIRST click renders "clicked once" and records the visit;
// a SUBSEQUENT click sees the recorded state and renders "clicked again". Anything else renders the initial
// view. This is the stateful Elm `update`: state (host) in, render patch (effect) out. Branch on the message
// CONTRACT (Bytes-eq lowers; runtime String-eq is declined).
def on-message(msg) =
  host state in
    (if msg.contract == click-contract() then
       (match state.get(clicked-key()) with
        | Some(_) => render(Patch.Text("clicked again"))
        | None(_) => ( state.put(clicked-key(), b"yes") ; render(Patch.Text("clicked once")) ))
     else render(Patch.Text("hello from a cadenza reducer")))

export { on-message, on-response, on-notification }
