// A minimal STATELESS A2A (Agent-to-Agent protocol) SERVER guest (operator directive 2026-09-13, 764/766:
// "build minimal STATELESS A2A + SSE now; HARD STOP before stateful task persistence"). A Cadenza root-router
// guest that speaks the A2A wire protocol — JSON-RPC 2.0 over HTTP, plus SSE for streaming — entirely in
// userspace over the flexible-handler interface the hivemind daemon exposes. Like the MCP server, the ENTIRE
// request lifecycle (route decision, body intake, JSON-RPC dispatch, one-shot vs streamed response) lives in
// this reducer; the platform is pure plumbing. JSON is handled WITHOUT any platform JSON-awareness (operator
// 759): the real `json` codec (I7) parses the JSON-RPC body into a value AST and reads the top-level `method`
// + `id`; the responses are byte literals spliced around the echoed id via Bytes.concat.
//
// SURFACE (the stateless slice — NO stateful tasks/get, tasks/cancel, or task store; that is the HARD STOP
// boundary the operator paused before):
//   1. Agent Card — GET /.well-known/agent.json → a one-shot application/json descriptor (a static card).
//   2. message/send — POST JSON-RPC → read the whole body, respond with a completed Task result.
//   3. message/stream — POST JSON-RPC → respond as SSE (text/event-stream), TIMER-DRIVEN: open with Head + a
//      working status-update, then emit the artifact-update and the final completed status-update (final:true)
//      ON A ~1s TIMER — one message roughly every second, driven by the node-local ephemeral-timer bridge.
//
// ONE OUTPUT PATH — the response-stream. Every response (the one-shots AND the SSE stream) is emitted as
// http-response-stream Head + Chunk(s) + a terminal End Break. A one-shot is just Head + one Chunk + End; SSE
// is Head + several `data:` Chunks + End. This keeps a SINGLE `Header` type in scope (http-response-stream's,
// aliased OutHeader): http-lib's `respond` would drag in http-response's OWN `Header`, and the two same-named
// types COLLIDE in one guest's module closure (the http-lib doc warns of exactly this). The response-stream
// path needs no prior body-mode (the daemon's driver opens the response on Head), so a GET streams its answer
// straight from the head with no body intake.
//
// TIMER-DRIVEN SSE (operator 765/766/767): message/stream does NOT blast its chunks in one fold. It opens the
// stream + arms a `fire-after` timer on the timer contract; the daemon's node-local ephemeral-timer bridge
// fires it back as a `Fired` RESPONSE, folded by `on-response`, which emits the next SSE chunk + re-arms — so
// the stream advances ~once per second, exercising the timer capability end-to-end. REQUIRES the ephemeral-
// timer bridge in the daemon (a bridge-less daemon would route the arm to the durable timer handler and the
// stream would never advance) — deploy this guest only AFTER the daemon carries that bridge. HARD STOP still
// honored: NO stateful task store / tasks-get / tasks-cancel / S2c.
//
// LIFECYCLE (head-first delivery, like the counter + http-flex guests):
//   on_message(request-head)              → GET: stream the answer directly; POST: choose body-mode Whole.
//   on_message(request-body-stream Chunk) → accumulate the body (in-memory ephemeral scratch KV).
//   on_message(request-body-stream End)   → dispatch the accumulated JSON-RPC body (send | stream | error).
import { BodyMode, descriptor as body-mode-desc } from "http-body-mode"
import { Frame as InFrame, descriptor as body-stream-desc } from "http-request-body-stream"
import { Frame as OutFrame, Header as OutHeader, descriptor as resp-stream-desc } from "http-response-stream"
import { Envelope, descriptor as timer-desc } from "timer"
import { Outcome, Error, on-notification, request } from "reducer-lib"
import { parse, get, as-str-bytes, encode } from "json"

// Local structural copy of the live head (method as a String, e.g. "GET"). Its `headers` field uses a LOCAL
// header-shaped type (name/value): the binary-AST decode is structural (name-independent), so this decodes the
// gateway's encoded head, and a local type keeps http-response's Header out of scope (which would collide with
// http-response-stream's `Header`, since cdz's type-name namespace is global across the module closure). It is
// also distinct from http-response-stream's Header-in-`Frame.Head`, which otherwise confuses the decode.
type ReqHeader = | ReqHeader(Record(name: String, value: String))
type ReqHead =
  | ReqHead(Record(method: String, path: String, query: String, headers: List(ReqHeader)))

// ── Documents ────────────────────────────────────────────────────────────────────────────────────────────────

// The Agent Card (GET /.well-known/agent.json) — the A2A discovery descriptor, a static document.
def agent-card() -> Bytes =
  b"{\"name\":\"cadenza-hivemind-a2a\",\"description\":\"A minimal A2A agent served live from a Cadenza root-router guest over the hivemind gateway.\",\"url\":\"/\",\"version\":\"0.1.0\",\"protocolVersion\":\"0.2.0\",\"capabilities\":{\"streaming\":true,\"pushNotifications\":false,\"stateTransitionHistory\":false},\"defaultInputModes\":[\"text/plain\"],\"defaultOutputModes\":[\"text/plain\"],\"skills\":[{\"id\":\"echo\",\"name\":\"Echo\",\"description\":\"Replies with a fixed greeting.\",\"tags\":[\"echo\"]}]}"

def index-body() -> Bytes =
  b"cadenza a2a agent -- GET /.well-known/agent.json for the Agent Card; POST / with A2A JSON-RPC (message/send, message/stream)\n"

// ── JSON-RPC 2.0 envelopes (the echoed id spliced in via Bytes.concat) ───────────────────────────────────────

def result-envelope(id: Bytes, result: Bytes) -> Bytes =
  Bytes.concat(b"{\"jsonrpc\":\"2.0\",\"id\":",
    Bytes.concat(id,
      Bytes.concat(b",\"result\":",
        Bytes.concat(result, b"}"))))

def method-error(id: Bytes) -> Bytes =
  Bytes.concat(b"{\"jsonrpc\":\"2.0\",\"id\":",
    Bytes.concat(id, b",\"error\":{\"code\":-32601,\"message\":\"method not found\"}}"))

// The synchronous message/send result: a COMPLETED Task with one text artifact.
def completed-task() -> Bytes =
  b"{\"id\":\"task-1\",\"contextId\":\"ctx-1\",\"kind\":\"task\",\"status\":{\"state\":\"completed\"},\"artifacts\":[{\"artifactId\":\"artifact-1\",\"parts\":[{\"kind\":\"text\",\"text\":\"pong from a Cadenza A2A agent, served live over the hivemind gateway\"}]}]}"

// The message/stream update events (each becomes one SSE `data:` frame).
def working-status() -> Bytes =
  b"{\"taskId\":\"task-1\",\"contextId\":\"ctx-1\",\"kind\":\"status-update\",\"status\":{\"state\":\"working\"},\"final\":false}"

def artifact-update() -> Bytes =
  b"{\"taskId\":\"task-1\",\"contextId\":\"ctx-1\",\"kind\":\"artifact-update\",\"artifact\":{\"artifactId\":\"artifact-1\",\"parts\":[{\"kind\":\"text\",\"text\":\"pong from a Cadenza A2A agent (streamed over SSE)\"}]}}"

def completed-status() -> Bytes =
  b"{\"taskId\":\"task-1\",\"contextId\":\"ctx-1\",\"kind\":\"status-update\",\"status\":{\"state\":\"completed\"},\"final\":true}"

// One SSE frame: `data: <jsonrpc-response>\n\n` (the text/event-stream wire framing).
def sse-event(id: Bytes, result: Bytes) -> Bytes =
  Bytes.concat(b"data: ", Bytes.concat(result-envelope(id, result), b"\n\n"))

// ── Response builders (all over the response-stream path) ────────────────────────────────────────────────────

def stream-head(ctype: String) =
  request(resp-stream-desc().id,
          Value.encode(OutFrame.Head({ status = 200,
                                       headers = [OutHeader.Header({ name = "content-type", value = ctype })] })),
          b"")

def stream-chunk(body: Bytes) =
  request(resp-stream-desc().id, Value.encode(OutFrame.Chunk({ body = body })), b"")

def stream-end() =
  Outcome.Close({ schema = resp-stream-desc().id, reason = Value.encode(OutFrame.End) })

// A one-shot response over the stream path: Head + one Chunk, Break with End.
def one-shot(ctype: String, body: Bytes) =
  { requests = [ stream-head(ctype), stream-chunk(body) ], outcome = stream-end() }

// Arm a node-local timer ~1s out (operator 765/766/767): the ephemeral-timer bridge fires it back as a
// `Fired` RESPONSE folded by `on-response`, which emits the NEXT SSE chunk — so the stream is TIMER-DRIVEN
// (one message ~every second), exercising the timer capability, not blasted in one fold.
def timer-arm() =
  request(timer-desc().id, Value.encode(Envelope.FireAfter(1000000000)), b"a2a-tick")

// message/stream, tick 0 → open the SSE response: Head(text/event-stream) + the first update Chunk (working),
// then ARM the timer and Continue (the session stays open; `on-response` drives the rest). The caller stores
// the echoed id + the tick counter in ephemeral state so `on-response` can emit the following chunks.
def sse-begin(id: Bytes) =
  { requests = [ request(resp-stream-desc().id,
                        Value.encode(OutFrame.Head({ status = 200,
                                                     headers = [OutHeader.Header({ name = "content-type", value = "text/event-stream" }),
                                                                OutHeader.Header({ name = "cache-control", value = "no-cache" })] })),
                        b""),
                 stream-chunk(sse-event(id, working-status())),
                 timer-arm() ],
    outcome = Outcome.Continue }

// ── The reducer fold ────────────────────────────────────────────────────────────────────────────────────────

def on-message(msg) =
  host state in
    (if msg.contract == body-stream-desc().id then
       (match (Value.decode(msg.payload) : Option(InFrame)) with
        | Some(InFrame.Chunk(c)) =>
            (let prev = (match state.get(b"body") with | Some(b) => b | None(_) => b"") in
             (state.put(b"body", Bytes.concat(prev, c.body)) ;
              { requests = [], outcome = Outcome.Continue }))
        | _ =>
            // End → dispatch the accumulated JSON-RPC body. The real `json` codec (I7) PARSES it, reads the
            // TOP-LEVEL `method` + `id`, and EXACT-matches the method (so a method name inside a params string
            // can no longer misfire dispatch, and the message/stream-vs-message/send prefix hazard is gone);
            // the echoed `id` round-trips VERBATIM via `encode`. message/stream stores the id + tick counter in
            // ephemeral state and OPENS the timer-driven SSE stream (following chunks emitted by on-response on
            // each timer Fired); message/send stays a synchronous one-shot; malformed JSON / no method → error.
            (let body = (match state.get(b"body") with | Some(b) => b | None(_) => b"") in
             (match parse(body) with
              | Option.None => one-shot("application/json", method-error(b"null"))
              | Option.Some(root) =>
                  (let id = (match get(root, b"id") with | Option.Some(j) => encode(j) | Option.None => b"null") in
                   (match (match get(root, b"method") with | Option.Some(m) => as-str-bytes(m) | Option.None => Option.None) with
                    | Option.Some(method) =>
                        if method == b"message/stream" then
                          (state.put(b"a2a-id", id) ;
                           (state.put(b"a2a-seq", b"1") ;
                            sse-begin(id)))
                        else if method == b"message/send" then one-shot("application/json", result-envelope(id, completed-task()))
                        else one-shot("application/json", method-error(id))
                    | Option.None => one-shot("application/json", method-error(id))))))
     else
       (match (Value.decode(msg.payload) : Option(ReqHead)) with
        | Some(ReqHead.ReqHead(h)) =>
            (if String.to-bytes(h.method) == b"GET" then
               (if String.to-bytes(h.path) == b"/.well-known/agent.json"
                then one-shot("application/json", agent-card())
                else one-shot("text/plain; charset=utf-8", index-body()))
             else
               // POST (or any non-GET) → read the whole body, then dispatch on End.
               { requests = [request(body-mode-desc().id,
                                    Value.encode(BodyMode.Whole({ max_body_size = Option.None })),
                                    msg.token)],
                 outcome = Outcome.Continue })
        | None(_) => one-shot("text/plain; charset=utf-8", b"not found")))

// The timer wake (766/767 ephemeral-timer bridge): each `Fired` advances the message/stream SSE by one chunk.
// seq "1" → emit the artifact-update chunk + re-arm the ~1s timer; seq "2" → emit the final completed-status
// chunk and CLOSE the stream (End). No stored id/seq (not a stream request) → inert Continue.
def on-response(_resp: Record(contract: Bytes, token: Bytes, answer: Result(Bytes, Error))) =
  host state in
    (match state.get(b"a2a-id") with
     | Some(id) =>
         (match state.get(b"a2a-seq") with
          | Some(seq) =>
              (if seq == b"1" then
                 (state.put(b"a2a-seq", b"2") ;
                  { requests = [ stream-chunk(sse-event(id, artifact-update())), timer-arm() ],
                    outcome = Outcome.Continue })
               else
                 { requests = [ stream-chunk(sse-event(id, completed-status())) ],
                   outcome = stream-end() })
          | None(_) => { requests = [], outcome = Outcome.Continue })
     | None(_) => { requests = [], outcome = Outcome.Continue })

export { on-message, on-response, on-notification }
