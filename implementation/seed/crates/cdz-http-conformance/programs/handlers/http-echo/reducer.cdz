// A request-READING PoC handler (DESIGN-http-outpost.md §7): unlike http-hello (which ignores the request),
// this `Value.decode`s the delivered `http-request` and branches on the decoded method — proving the FORWARD
// codec path (the gateway's Rust `encode_request` produces bytes the guest's `Value.decode` accepts). It
// answers 200 with a body naming the decoded method, or 400 if the request does not decode.
//
// Composed from the shared libs (no inline world / redefined types): the `Request`/`Method` types + the
// `respond` terminal builder from `http-lib`, the reducer-world boundary from the witWorld artifact, the inert
// handlers from `reducer-lib`. See the `libs` manifest beside this file.
import { Request, Method, respond } from "http-lib"
import { on-response, on-notification } from "reducer-lib"

def on-message(msg) =
  (match (Value.decode(msg.payload) : Option(Request)) with
   | Some(Request.Request(r)) =>
     (match r.method with
      | Get => respond(200, [], b"method=GET")
      | Post => respond(200, [], b"method=POST")
      | Put => respond(200, [], b"method=PUT")
      | Delete => respond(200, [], b"method=DELETE")
      | Patch => respond(200, [], b"method=PATCH")
      | Head => respond(200, [], b"method=HEAD")
      | Options => respond(200, [], b"method=OPTIONS"))
   | None => respond(400, [], b"undecodable http-request"))

export { on-message, on-response, on-notification }
