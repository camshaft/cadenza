// The inline-PoC HTTP handler (DESIGN-http-outpost.md §7): a content-addressed wasm reducer that folds an
// http-request and answers a fixed `200 text/plain "hello from a wasm handler"` PURELY in on-message. The
// smallest handler that proves the whole spine: edge -> router -> spawn -> fold -> response -> socket.
//
// Composed from the shared libs (operator 2026-09-10: "prefer not to have inline worlds everywhere, reuse
// the existing mechanism"): the reducer-world WIT boundary comes from the `reducer-world` witWorld artifact
// (not a redefined inline world), the HTTP types + the `respond` terminal builder from `http-lib`, and the
// inert on-response / on-notification from `reducer-lib`. See the `libs` manifest beside this file.
import { Header, respond } from "http-lib"
import { on-response, on-notification } from "reducer-lib"

def on-message(_msg) =
  respond(200, [Header.Header({ name = "content-type", value = "text/plain" })], b"hello from a wasm handler")

export { on-message, on-response, on-notification }
