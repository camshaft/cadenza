// The COMPILE HTTP route handler (reducer-targets B10b; operator multi-module design via v-hivemind): POST a
// MULTI-MODULE compile request — a {module-name -> ast-hash} map + an entrypoint — and get back the compiled
// component's ProgramHash. A client first parses each source module via the PARSE route (-> ast published in
// the CAS -> ast-hash), then submits the map here. This handler fetches each AST from the store by hash, feeds
// rcdzc a KIND_AST(name = module-name) artifact per module + a KIND_ENTRY artifact naming the entrypoint, and
// rcdzc resolves imports across the named set + compiles the entry (rcdzc::compile already filters KIND_AST +
// honors KIND_ENTRY — no compiler change). A Cadenza reducer-world guest: CALLS `run` (delegate to rcdzc) +
// `blobs` (fetch the asts, publish the component); NO reducer spawning.
//
// Strong contracts: the request is the canonical CompileRoute value (Value.decode of the http body); the rcdzc
// hop is the canonical rcdzc.compile CompileRequest/CompileResult. On no component answers 422 WITH the compile
// diagnostics (render-compile-diags). The rcdzc ProgramHash is INJECTED via the generated `guest-hashes` lib
// (the handler imports it — no textual placeholder rewrite).
import { Request, respond } from "http-lib"
import { descriptor as rcdzc-desc, CompileRequest, CompileResult, Artifact, CompileDiagnostic } from "rcdzc-compile"
import { Module, CompileRoute } from "compile-req"
import { Error, on-response, on-notification } from "reducer-lib"
import { rcdzc-hash } from "guest-hashes"

// The bytes of the first "component" output artifact, if any (the derived wasm component rcdzc emits).
def component-of(artifacts: List(Artifact)) -> Option(Bytes) =
  match artifacts with
  | [] => Option.None
  | [a, .. rest] =>
    (match a with
     | Artifact.Artifact(x) => if x.kind == "component" then Option.Some(x.bytes) else component-of(rest))

// Render the compile diagnostics (`<code>: <message>` per line) — a 422 tells the caller what was wrong.
def render-compile-diags(ds: List(CompileDiagnostic)) -> String =
  match ds with
  | [] => ""
  | [d, .. rest] =>
    (match d with
     | CompileDiagnostic.CompileDiagnostic(x) =>
       let prefix = (match x.code with | Option.Some(c) => String.concat(c, ": ") | Option.None => "") in
       String.concat(prefix, String.concat(x.message, String.concat("\n", render-compile-diags(rest)))))

// Fetch each module's AST from the CAS (blobs.get by hash) and build the kinded-input bundle: a KIND_AST
// artifact per module (name = module-name) + a KIND_ENTRY artifact naming the entrypoint. `None` if any AST is
// missing from the store. blobs.get is a host effect handled by the enclosing `host blobs in`.
def fetch-inputs(modules: List(Module), entry: String) -> Option(List(Artifact)) =
  match modules with
  | [] =>
    Option.Some([Artifact.Artifact({ kind = "entry", name = "entry", bytes = String.to-bytes(entry) })])
  | [m, .. rest] =>
    (match m with
     | Module.Module(x) =>
       (match blobs.get(x.astHash) with
        | Some(ast) =>
          (match fetch-inputs(rest, entry) with
           | Some(more) =>
             Option.Some(List.push(more, Artifact.Artifact({ kind = "ast", name = x.name, bytes = ast })))
           | None => Option.None)
        | None => Option.None))

def on-message(msg) =
  host run in
    host blobs in
      (match (Value.decode(msg.payload) : Option(Request)) with
       | Some(Request.Request(r)) =>
         (match (Value.decode(r.body) : Option(CompileRoute)) with
          | Some(CompileRoute.Compile(c)) =>
            (match fetch-inputs(c.modules, c.entry) with
             | None => respond(422, [], b"a module AST was not found in the store")
             | Some(inputs) =>
               (match (run.run(rcdzc-hash(), rcdzc-desc().id,
                               Value.encode(CompileRequest.Compile(inputs))) : Result(Bytes, Error)) with
                | Ok(compile-bytes) =>
                  (match (Value.decode(compile-bytes) : Option(CompileResult)) with
                   | Some(CompileResult.Compiled(cr)) =>
                     (match component-of(cr.artifacts) with
                      | Some(component) => (let h = blobs.put(component) in respond(200, [], h))
                      | None => respond(422, [], String.to-bytes(render-compile-diags(cr.diagnostics))))
                   | None => respond(500, [], b"undecodable CompileResult"))
                | Err(_e) => respond(500, [], b"rcdzc run failed")))
          | None => respond(400, [], b"undecodable compile request (expected a Compile(modules, entry) value)"))
       | None => respond(400, [], b"undecodable http-request"))

export { on-message, on-response, on-notification }
