// The COMPILE HTTP route handler (reducer-targets B10c; operator artifact-list design via v-hivemind): POST the
// COMPLETE kinded-artifact list a client assembled — each artifact {kind, name, payload} where payload is
// Inline(bytes) or CasRef(hash) — and get back the compiled component's ProgramHash. The handler is the SOLE CAS
// boundary: it resolves every payload to bytes (CasRef → blobs.get(hash), Inline → bytes as-is), then hands
// rcdzc the SAME bytes-only Artifact(kind, name, bytes) list it already takes. NO per-kind special-casing, NO
// entry synthesis — the client passes the entry as a first-class kind="entry" artifact (Inline, its bytes the
// encode_name form of the entry-file name), so rcdzc's existing KIND_AST-filter + KIND_ENTRY-find drops in. A
// Cadenza reducer-world guest: CALLS `run` (delegate to rcdzc) + `blobs` (deref CasRefs, publish the component).
//
// INVARIANT (operator): rcdzc knows NOTHING about the CAS — Payload/Inline/CasRef live only in the compile-req
// contract (this handler's domain); the rcdzc hop is the plain CAS-agnostic CompileRequest/CompileResult. On no
// component answers 422 WITH the compile diagnostics (render-compile-diags). The rcdzc ProgramHash is INJECTED
// via the generated `guest-hashes` lib (the handler imports it — no textual placeholder rewrite).
import { Request, respond } from "http-lib"
import { descriptor as rcdzc-desc, CompileRequest, CompileResult, Artifact, CompileDiagnostic } from "rcdzc-compile"
import { Payload, RouteArtifact, CompileRoute } from "compile-req"
import { Error, on-response, on-notification } from "reducer-lib"
import { rcdzc-hash } from "guest-hashes"

// The bytes of the first "component" output artifact, if any (the derived wasm component rcdzc emits).
def component-of(artifacts: List(Artifact)) -> Option(Bytes) =
  match artifacts with
  | [] => Option.None
  | [a, .. rest] =>
    (match a with
     | Artifact.Artifact(x) => if x.kind == "component" then Option.Some(x.bytes) else component-of(rest))

// Render the compile diagnostics (`<code>: <message>` per line) — a 422 tells the caller what was wrong.
def render-compile-diags(ds: List(CompileDiagnostic)) -> String =
  match ds with
  | [] => ""
  | [d, .. rest] =>
    (match d with
     | CompileDiagnostic.CompileDiagnostic(x) =>
       let prefix = (match x.code with | Option.Some(c) => String.concat(c, ": ") | Option.None => "") in
       String.concat(prefix, String.concat(x.message, String.concat("\n", render-compile-diags(rest)))))

// Resolve one artifact payload to bytes: Inline carries the bytes; CasRef derefs the store by 33-byte hash
// (`None` if the store lacks it). blobs.get is a host effect handled by the enclosing `host blobs in`.
def resolve-payload(p: Payload) -> Option(Bytes) =
  match p with
  | Payload.Inline(b) => Option.Some(b)
  | Payload.CasRef(h) => blobs.get(h)

// Resolve the whole kinded-artifact list to rcdzc's bytes-only Artifact(kind, name, bytes) inputs — the sole
// CAS step. `None` if any CasRef is missing from the store. rcdzc then filters KIND_AST + finds the client's
// KIND_ENTRY artifact; no synthesis here (the handler stays dumb, rcdzc stays CAS-agnostic).
def resolve-inputs(arts: List(RouteArtifact)) -> Option(List(Artifact)) =
  match arts with
  | [] => Option.Some([])
  | [a, .. rest] =>
    (match a with
     | RouteArtifact.RouteArtifact(x) =>
       (match resolve-payload(x.payload) with
        | Some(bytes) =>
          (match resolve-inputs(rest) with
           | Some(more) =>
             Option.Some(List.push(more, Artifact.Artifact({ kind = x.kind, name = x.name, bytes = bytes })))
           | None => Option.None)
        | None => Option.None))

def on-message(msg) =
  host run in
    host blobs in
      (match (Value.decode(msg.payload) : Option(Request)) with
       | Some(Request.Request(r)) =>
         (match (Value.decode(r.body) : Option(CompileRoute)) with
          | Some(CompileRoute.Compile(c)) =>
            (match resolve-inputs(c.artifacts) with
             | None => respond(422, [], b"a CasRef artifact was not found in the store")
             | Some(inputs) =>
               (match (run.run(rcdzc-hash(), rcdzc-desc().id,
                               Value.encode(CompileRequest.Compile(inputs))) : Result(Bytes, Error)) with
                | Ok(compile-bytes) =>
                  (match (Value.decode(compile-bytes) : Option(CompileResult)) with
                   | Some(CompileResult.Compiled(cr)) =>
                     (match component-of(cr.artifacts) with
                      | Some(component) => (let h = blobs.put(component) in respond(200, [], h))
                      | None => respond(422, [], String.to-bytes(render-compile-diags(cr.diagnostics))))
                   | None => respond(500, [], b"undecodable CompileResult"))
                | Err(_e) => respond(500, [], b"rcdzc run failed")))
          | None => respond(400, [], b"undecodable compile request (expected a Compile(artifacts) value)"))
       | None => respond(400, [], b"undecodable http-request"))

export { on-message, on-response, on-notification }
