// The authorizer world — the LOCKED WIT contract (v-agent-harness, cdz-kernel `bf44d95e6`) that this
// Cedar policy guest exports and the kernel's ComponentAuthorizer instantiates. Vendored here because the
// guest fixture is a SEPARATE crate from cdz-kernel (a cross-crate relative bind to
// `../../../../../cdz-kernel/wit/authorizer.wit` would be fragile), so this copy carries the same
// INTERFACE SHAPE as the canonical `cdz-kernel/wit/authorizer.wit` — the world/interface/record
// definitions match exactly (only comments differ). Keep them in lockstep: if v-agent-harness changes the
// world, update this copy. The cdz-agent-host CI job's `wasm-tools component new` + `validate` step
// catches a guest that no longer produces a valid authorizer component if the shape drifts.
package cadenza:agent-kernel-authz;

interface types {
  record auth-request {
    // Cedar PRINCIPAL — the session/agent identity (the kernel passes the session id, one per authorizer).
    principal: string,
    // Cedar ACTION — the effect kind, lowercase: "http" / "model" / "shell" / "now" / "timer" / "emit".
    action: string,
    // Cedar RESOURCE — the resolved target (URL / model-id / command). Named `target`, not `resource`
    // (a reserved WIT keyword). SEC-F1 gates (kind, target) — the effect payload/body is NOT in the request.
    target: string,
    // The STRUCTURED SUBJECT of a subject-scoped effect — a SECOND resource dimension, NOT opaque body.
    // For a group membership op (`store/add`/`store/remove`) `target` is the GROUP NAME and this is the
    // MEMBER VALUE (a SessionId hex); a policy uses it for the §directory-D5 self-vs-other rule (add/remove
    // SELF where `subject == principal` is allowed by the join grant; add/remove OTHER requires the group's
    // owner authority). `none` for effects with no structured subject. The kernel's ComponentAuthorizer
    // populates it (decoding a member-op payload); SEC-F1 still gates on (principal, action, target).
    // Kept BYTE-IN-SYNC with cdz-kernel/wit/authorizer.wit (the canonical world) + the reducer/dogwood
    // guest copies — a drift breaks the guest bindgen against the kernel's lifted component.
    subject: option<string>,
  }
  record decision {
    // true = permit, false = deny.
    allow: bool,
    // Denial reason for the AuthzDenied audit log (or an allow note); "" = none.
    reason: string,
  }
}

interface authorizer {
  use types.{auth-request, decision};
  authorize: func(request: auth-request) -> decision;
}

world authorizer-world {
  // Exports the authorize function; imports NOTHING — a policy is a pure function of the request plus
  // the policy set embedded in this component.
  export authorizer;
}
