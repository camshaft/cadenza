/// core-ex.cdz — the CANONICAL shared expression type for the compiler-ml port. Today, ~70 passes each
/// re-declare their OWN expression type (constprop's `Ex`, anf's `Ex`, infer's `Ex`, the parser's `Expr`,
/// …), so they cannot compose — a value built by one pass is a DIFFERENT type to another (CDZ0201/0203:
/// "two types with the same name"). This module defines ONE `Ex` that the passes can eventually share, so a
/// real `parse → infer → optimize → codegen` pipeline becomes possible.
///
/// STATUS: this lands as an ADDITIVE ISLAND — nothing imports it yet. Wiring the existing passes to it is
/// the larger reshape (migrating each pass's own `Ex` to this one) and is gated on the operator's
/// direction ruling; until then `core-ex` stands alone as a self-tested canonical type + helpers. It
/// `export`s `Ex.*` so a future consumer can construct/match `Ex.Bin(..)` cross-file (a bare `export { Ex }`
/// withholds the constructors — CDZ0214).
///
/// DESIGN CHOICES (from the migration design doc):
///   - Variables are `Int64` IDS, not strings — cheaper, and infer/anf/strength already key on Int64; a
///     name→id INTERNER pass converts `Ast.Name` at the front (a `(Map String Int64, next)` fold).
///   - Arithmetic is ONE `Bin(op, l, r)` with an op CODE (43 `+`, 45 `-`, 42 `*`, 47 `/`), subsuming the
///     per-pass `Add`/`Sub`/`Mul` variants. The op codes match the parser's token codes.
///   - `Let`/`Lam`/`App` cover the binding + lambda-calculus passes (infer/closure) on the same type.

type Ex =
  | Num(Int64)
  | Var(Int64)
  | Bin(Int64, Ex, Ex)
  | Let(Int64, Ex, Ex)
  | Lam(Int64, Ex)
  | App(Ex, Ex)

/// The canonical op codes (matching the parser's token codes).
def op-add() = 43
def op-sub() = 45
def op-mul() = 42
def op-div() = 47

/// The op code of a `Bin` (-1 if `e` is not a `Bin`).
def op-of(e: Ex) = match e with
  | Ex.Bin(op, _, _) => op
  | _ => 0 - 1

/// Total node count — the node plus every descendant.
def size(e: Ex) = match e with
  | Ex.Num(_) => 1
  | Ex.Var(_) => 1
  | Ex.Bin(_, l, r) => 1 + size(l) + size(r)
  | Ex.Let(_, rhs, body) => 1 + size(rhs) + size(body)
  | Ex.Lam(_, body) => 1 + size(body)
  | Ex.App(f, a) => 1 + size(f) + size(a)

/// Structural depth (longest root-to-leaf path).
def depth(e: Ex) = match e with
  | Ex.Num(_) => 1
  | Ex.Var(_) => 1
  | Ex.Bin(_, l, r) => 1 + imax(depth(l), depth(r))
  | Ex.Let(_, rhs, body) => 1 + imax(depth(rhs), depth(body))
  | Ex.Lam(_, body) => 1 + depth(body)
  | Ex.App(f, a) => 1 + imax(depth(f), depth(a))

def imax(a: Int64, b: Int64) = if a > b then a else b

/// The largest variable id appearing in `e` (-1 if none) — the seed for fresh-var allocation (a pass that
/// mints temporaries starts at `max-id(e) + 1`, matching anf/fresh discipline).
def max-id(e: Ex) = match e with
  | Ex.Num(_) => 0 - 1
  | Ex.Var(v) => v
  | Ex.Bin(_, l, r) => imax(max-id(l), max-id(r))
  | Ex.Let(x, rhs, body) => imax(x, imax(max-id(rhs), max-id(body)))
  | Ex.Lam(p, body) => imax(p, max-id(body))
  | Ex.App(f, a) => imax(max-id(f), max-id(a))

/// Is `e` an ATOM (a value usable directly, no sub-evaluation)? — the ANF operand predicate.
def is-atom(e: Ex) = match e with
  | Ex.Num(_) => true
  | Ex.Var(_) => true
  | _ => false

/// Count the `Bin` (operator) nodes — a cost proxy.
def op-count(e: Ex) = match e with
  | Ex.Bin(_, l, r) => 1 + op-count(l) + op-count(r)
  | Ex.Let(_, rhs, body) => op-count(rhs) + op-count(body)
  | Ex.Lam(_, body) => op-count(body)
  | Ex.App(f, a) => op-count(f) + op-count(a)
  | _ => 0

/// Builders (for consumers + tests).
def num(k: Int64) = Ex.Num(k)
def var(v: Int64) = Ex.Var(v)
def add(l: Ex, r: Ex) = Ex.Bin(op-add(), l, r)
def sub(l: Ex, r: Ex) = Ex.Bin(op-sub(), l, r)
def mul(l: Ex, r: Ex) = Ex.Bin(op-mul(), l, r)
def div(l: Ex, r: Ex) = Ex.Bin(op-div(), l, r)

@test
def cx-atom-size-one() =
  // a leaf is size 1, depth 1, an atom, 0 ops.
  if size(num(5)) == 1 then (if depth(num(5)) == 1 then (if is-atom(num(5)) then (if op-count(num(5)) == 0 then unit else trap("0 ops")) else trap("atom")) else trap("depth 1")) else trap("size 1")

@test
def cx-bin-size-and-op() =
  // 1 + 2 : size 3, one op, op-code 43, NOT an atom.
  let e = add(num(1), num(2)) in
  if size(e) == 3 then (if op-of(e) == 43 then (if op-count(e) == 1 then (if is-atom(e) then trap("Bin is not an atom") else unit) else trap("1 op")) else trap("op 43")) else trap("size 3")

@test
def cx-nested-size-depth() =
  // (1 + 2) * 3 : size 5 (Mul + Add + 1 + 2 + 3), depth 3, 2 ops.
  let e = mul(add(num(1), num(2)), num(3)) in
  if size(e) == 5 then (if depth(e) == 3 then (if op-count(e) == 2 then unit else trap("2 ops")) else trap("depth 3")) else trap("size 5")

@test
def cx-op-codes-distinct() =
  // the four op codes are distinct and match the parser's (+ 43, - 45, * 42, / 47).
  if op-of(add(num(0), num(0))) == 43 then
    (if op-of(sub(num(0), num(0))) == 45 then
      (if op-of(mul(num(0), num(0))) == 42 then
        (if op-of(div(num(0), num(0))) == 47 then unit else trap("div 47")) else trap("mul 42")) else trap("sub 45")) else trap("add 43")

@test
def cx-max-id-seeds-fresh() =
  // Let(5, .., Bin(+, Var 5, Num 2)) → max id 5 (so a fresh pass starts at 6).
  let e = Ex.Let(5, num(1), add(var(5), num(2))) in
  if max-id(e) == 5 then unit else trap("max-id = 5")

@test
def cx-max-id-none() =
  // no variables → max-id -1.
  if max-id(add(num(1), num(2))) == 0 - 1 then unit else trap("no vars → -1")

@test
def cx-lambda-app-covered() =
  // \x. (x 5) : Lam + App + Var + Num — the lambda-calc shapes on the same type. size 4, depth 3.
  let e = Ex.Lam(0, Ex.App(var(0), num(5))) in
  if size(e) == 4 then (if depth(e) == 3 then unit else trap("depth 3")) else trap("size 4")

@test
def cx-let-covered() =
  // let x = (1+2) in x*3 : Let node threads rhs + body. size = Let(1) + Add(3) + Mul(1)+Var+Num(2) = 7.
  let e = Ex.Let(0, add(num(1), num(2)), mul(var(0), num(3))) in
  if size(e) == 7 then (if op-count(e) == 2 then unit else trap("2 ops")) else trap("size 7")

@test
def cx-depth-left-vs-right() =
  // depth takes the MAX branch: ((1+2)+3) + 4 is deeper on the left → depth 4.
  let e = add(add(add(num(1), num(2)), num(3)), num(4)) in
  if depth(e) == 4 then (if size(e) == 7 then unit else trap("size 7")) else trap("depth 4")

@test
def cx-atom-var-and-num-only() =
  // only Num and Var are atoms; Bin/Let/Lam/App are not.
  if is-atom(var(3)) then (if is-atom(Ex.Lam(0, num(1))) then trap("Lam is not an atom") else (if is-atom(Ex.App(num(1), num(2))) then trap("App is not an atom") else unit)) else trap("Var is an atom")

export { Ex.*, op-of, op-add, op-sub, op-mul, op-div, size, depth, max-id, is-atom, op-count, num, var, add, sub, mul, div }
