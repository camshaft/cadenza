/// peephole.cdz — a PEEPHOLE OPTIMIZER over the stack-machine `Instr` stream (imported cross-file from
/// `codegen`). It constant-folds a `Push a, Push b, BinOp op` triple into a single `Push (a op b)` — the
/// simplest real optimization a compiler backend performs (fold two literal pushes and their operator at
/// compile time). Iterating to a FIXPOINT folds a whole constant expression down to one push: a program
/// with no runtime inputs optimizes to its answer.
///
/// It stresses two things the log tracked: (1) MULTI-ELEMENT LIST-WINDOW patterns — the rewrite matches
/// `[Instr.Push(a), Instr.Push(b), Instr.BinOp(o), .. rest]` (three refutable constructor elements plus
/// a rest binder — the shape fixed in iter 16), and (2) a FIXPOINT loop that re-runs the pass until the
/// instruction count stops shrinking (a real optimizer's "iterate to convergence"). Correctness is
/// checked against `codegen.exec`: optimizing a program must NOT change what it computes (`exec(optimize
/// p) == exec(p)`), and a fully-constant program must optimize to exactly ONE instruction.

import { Instr, exec, compile } from "codegen"
import { Tok, parse, run } from "parse"

/// Apply a binary op code to two literal operands — the compile-time fold (same table as the VM).
def fold-op(op: Int64, a: Int64, b: Int64) =
  if op == 43 then a + b else (if op == 45 then a - b else (if op == 42 then a * b else a / b))

/// ONE left-to-right fold pass: rewrite the first `Push a, Push b, BinOp o` window to `Push (a op b)`,
/// copying every other instruction unchanged. Returns the rewritten list (built in order via push).
def fold-pass(xs: List(Instr), i: Int64, acc: List(Instr)) =
  match window3(xs, i) with
    | Option.Some(folded) =>
      // a foldable window at `i`: emit the folded push, SKIP the three consumed instructions
      fold-pass(xs, i + 3, List.push(acc, folded))
    | Option.None(_) =>
      // no window here: copy the single instruction at `i` (or stop at end)
      (if i == List.len(xs) then
        acc
      else
        (match List.at(xs, i) with
          | Option.Some(ins) => fold-pass(xs, i + 1, List.push(acc, ins))
          | Option.None(_) => acc))

/// Is there a foldable `Push, Push, BinOp` window starting at index `i`? If so, the folded `Push`.
/// (Reads three positions by index rather than a list-slice pattern, so the fold works mid-stream.)
def window3(xs: List(Instr), i: Int64) =
  match at3(xs, i) with
    | Option.Some(t) => (match t.0 with
      | Instr.Push(a) => (match t.1 with
        | Instr.Push(b) => (match t.2 with
          | Instr.BinOp(o) => Option.Some(Instr.Push(fold-op(o, a, b)))
          | _ => Option.None(unit))
        | _ => Option.None(unit))
      | _ => Option.None(unit))
    | Option.None(_) => Option.None(unit)

/// The three instructions at i, i+1, i+2 as a tuple — or None if any is past the end.
def at3(xs: List(Instr), i: Int64) =
  match List.at(xs, i) with
    | Option.Some(x) => (match List.at(xs, i + 1) with
      | Option.Some(y) => (match List.at(xs, i + 2) with
        | Option.Some(z) => Option.Some((x, y, z))
        | Option.None(_) => Option.None(unit))
      | Option.None(_) => Option.None(unit))
    | Option.None(_) => Option.None(unit)

/// Run `fold-pass` to a FIXPOINT: repeat until the length stops decreasing (a nested fold — the result
/// of `(a op b) op c` folds on the SECOND pass). `fuel` bounds the iteration defensively.
def optimize-loop(xs: List(Instr), fuel: Int64) =
  if fuel == 0 then
    xs
  else
    let once = fold-pass(xs, 0, []) in
    (if List.len(once) == List.len(xs) then xs else optimize-loop(once, fuel - 1))

/// Optimize an instruction stream to convergence.
def optimize(xs: List(Instr)) = optimize-loop(xs, 100)

/// The op codes, for building test programs readably.
def add() = 43
def sub() = 45
def mul() = 42

@test
def ph-fold-one-add() =
  // Push 1, Push 2, Add → Push 3  (one instruction)
  let p = [Instr.Push(1), Instr.Push(2), Instr.BinOp(add())] in
  let o = optimize(p) in
  if code-len(o) == 1 then (if exec(o) == 3 then unit else trap("folds to 3")) else trap("one instruction")

@test
def ph-preserves-semantics-add() =
  let p = [Instr.Push(10), Instr.Push(4), Instr.BinOp(sub())] in
  if exec(optimize(p)) == exec(p) then unit else trap("optimize preserves value")

@test
def ph-nested-folds-to-one() =
  // 1 + (2*3): Push1, Push2, Push3, Mul, Add. First pass folds (2*3)→6 giving Push1,Push6,Add;
  // second pass folds →Push7. A fully-constant program collapses to ONE push.
  let p = [Instr.Push(1), Instr.Push(2), Instr.Push(3), Instr.BinOp(mul()), Instr.BinOp(add())] in
  let o = optimize(p) in
  if code-len(o) == 1 then (if exec(o) == 7 then unit else trap("nested folds to 7")) else trap("collapses to one push")

@test
def ph-left-assoc-chain() =
  // ((10-3)-2): Push10,Push3,Sub,Push2,Sub → pass1 folds (10-3)=7 → Push7,Push2,Sub → pass2 → Push5
  let p = [Instr.Push(10), Instr.Push(3), Instr.BinOp(sub()), Instr.Push(2), Instr.BinOp(sub())] in
  let o = optimize(p) in
  if code-len(o) == 1 then (if exec(o) == 5 then unit else trap("chain folds to 5")) else trap("one push")

@test
def ph-end-to-end-from-parser() =
  // parse "2*(3+4)-1" then compile then optimize then exec — must equal the original evaluator (13)
  let ts = [Tok.TNum(2), Tok.TOp(42), Tok.TLP, Tok.TNum(3), Tok.TOp(43), Tok.TNum(4), Tok.TRP, Tok.TOp(45), Tok.TNum(1)] in
  let o = optimize(compile(parse(ts))) in
  if exec(o) == run(ts) then unit else trap("optimized pipeline == evaluator")

@test
def ph-fully-constant-collapses() =
  // any fully-constant parsed expression optimizes to a single Push
  let ts = [Tok.TNum(6), Tok.TOp(42), Tok.TNum(7)] in
  if code-len(optimize(compile(parse(ts)))) == 1 then unit else trap("6*7 collapses to one push")

@test
def ph-idempotent() =
  // optimizing an already-optimized program changes nothing
  let p = [Instr.Push(2), Instr.Push(3), Instr.BinOp(add())] in
  let once = optimize(p) in
  if code-len(optimize(once)) == code-len(once) then unit else trap("optimize is idempotent")

@test
def ph-lone-push-unchanged() =
  // a single Push has no foldable window → unchanged (len 1), value preserved.
  let p = [Instr.Push(9)] in
  let o = optimize(p) in
  if code-len(o) == 1 then (if exec(o) == exec(p) then unit else trap("lone push value preserved")) else trap("lone push unchanged")

@test
def ph-fold-after-nonfoldable-prefix() =
  // ((1+2)*3)+4 compiles to Push1,Push2,Add,Push3,Mul,Push4,Add. The window at index 0 (Push1,Push2,Add)
  // folds → Push3; but this exercises a fold that must then re-run over the REST. Fully constant →
  // collapses to one Push; value = ((1+2)*3)+4 = 13. Verifies multi-pass fold over a longer chain.
  let p = [Instr.Push(1), Instr.Push(2), Instr.BinOp(add()), Instr.Push(3), Instr.BinOp(mul()), Instr.Push(4), Instr.BinOp(add())] in
  let o = optimize(p) in
  if code-len(o) == 1 then (if exec(o) == 13 then unit else trap("((1+2)*3)+4 = 13")) else trap("collapses to one push")

@test
def ph-right-heavy-nesting-collapses() =
  // 2*(3*(4*5)): Push2,Push3,Push4,Push5,Mul,Mul,Mul. window at 0 (P,P,P) not foldable; the innermost
  // fold happens deeper. Needs several passes; fully constant → one Push, value 2*3*4*5 = 120.
  let p = [Instr.Push(2), Instr.Push(3), Instr.Push(4), Instr.Push(5), Instr.BinOp(mul()), Instr.BinOp(mul()), Instr.BinOp(mul())] in
  let o = optimize(p) in
  if code-len(o) == 1 then (if exec(o) == 120 then unit else trap("2*3*4*5 = 120")) else trap("right-heavy collapses")

@test
def ph-optimize-preserves-value-longer() =
  // a longer parsed expression: optimize must preserve the evaluator's result (a broad semantics guard).
  let ts = [Tok.TNum(8), Tok.TOp(45), Tok.TNum(2), Tok.TOp(42), Tok.TNum(3)] in   // 8 - 2*3 = 2
  let o = optimize(compile(parse(ts))) in
  if exec(o) == run(ts) then unit else trap("8 - 2*3 optimized == evaluated")

/// A local list-length helper (avoids importing List.len name only for the tests' readability).
def code-len(xs: List(Instr)) = List.len(xs)

export { optimize, fold-pass }
