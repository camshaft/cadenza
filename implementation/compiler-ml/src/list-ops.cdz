/// list-ops.cdz — array-style algorithms over an `Int64` list, exercising RANDOM ACCESS (`List.at`),
/// LENGTH (`List.len`), and GROWTH (`List.push`) — the index-driven traversals a compiler uses over a
/// register file, a constant pool, or a positional argument vector. `get-or` reads with a default,
/// `index-of` linear-scans, `count-of` tallies matches, and `reverse` rebuilds via a descending
/// index walk. (`List` has no `slice`, so `reverse` is index-driven — a lesser prelude gap noted in the
/// log.)

/// The element at `i`, or `dflt` if out of range (a total indexed read).
def get-or(xs: List(Int64), i: Int64, dflt: Int64) = match List.at(xs, i) with
  | Option.Some(v) => v
  | Option.None(_) => dflt

/// The first index of `target` (scanning from `i`), or -1 if absent.
def index-of(xs: List(Int64), target: Int64, i: Int64) =
  if i == List.len(xs) then
    0 - 1
  else
    (if get-or(xs, i, 0) == target then i else index-of(xs, target, i + 1))

/// How many elements equal `target` (from index `i`, accumulating into `acc`).
def count-of(xs: List(Int64), target: Int64, i: Int64, acc: Int64) =
  if i == List.len(xs) then
    acc
  else
    count-of(xs, target, i + 1, if get-or(xs, i, 0) == target then acc + 1 else acc)

def rev-into(src: List(Int64), i: Int64, dst: List(Int64)) =
  if i < 0 then dst else rev-into(src, i - 1, List.push(dst, get-or(src, i, 0)))

/// The list reversed (built by pushing elements in descending index order).
def reverse(xs: List(Int64)) = rev-into(xs, List.len(xs) - 1, [])

/// Whether `target` occurs in `xs`.
def contains(xs: List(Int64), target: Int64) = index-of(xs, target, 0) >= 0

@test
def lo-get-in-range() = if get-or([10, 20, 30], 1, 0 - 1) == 20 then unit else trap("xs[1] = 20")

@test
def lo-get-out-of-range() = if get-or([10, 20], 5, 0 - 1) == 0 - 1 then unit else trap("out of range → dflt")

@test
def lo-index-found() = if index-of([10, 20, 30], 30, 0) == 2 then unit else trap("30 at index 2")

@test
def lo-index-first() =
  // the FIRST match wins for a duplicated element
  if index-of([7, 5, 7], 7, 0) == 0 then unit else trap("first 7 at index 0")

@test
def lo-index-absent() = if index-of([1, 2, 3], 99, 0) == 0 - 1 then unit else trap("absent → -1")

@test
def lo-count() = if count-of([1, 2, 1, 3, 1], 1, 0, 0) == 3 then unit else trap("three 1s")

@test
def lo-count-none() = if count-of([1, 2, 3], 9, 0, 0) == 0 then unit else trap("no 9s")

@test
def lo-contains() =
  if contains([4, 5, 6], 5) then (if contains([4, 5, 6], 9) then trap("9 absent") else unit) else trap("5 present")

@test
def lo-reverse-head() =
  // reverse [1,2,3] → [3,2,1]; head is 3
  if get-or(reverse([1, 2, 3]), 0, 0) == 3 then unit else trap("reversed head 3")

@test
def lo-reverse-full() =
  // every position of the reversed list
  let r = reverse([1, 2, 3]) in
  if get-or(r, 0, 0) == 3 then
    (if get-or(r, 1, 0) == 2 then (if get-or(r, 2, 0) == 1 then unit else trap("r[2]=1")) else trap("r[1]=2"))
  else
    trap("r[0]=3")

@test
def lo-reverse-preserves-length() =
  if List.len(reverse([1, 2, 3, 4])) == 4 then unit else trap("reverse keeps length 4")

@test
def lo-reverse-empty() = if List.len(reverse([])) == 0 then unit else trap("reverse [] is []")

export { get-or, index-of, count-of, reverse, contains }
