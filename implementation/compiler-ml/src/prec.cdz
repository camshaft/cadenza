/// prec.cdz — operator precedence, and the pretty-printer's parenthesization decision. A binary
/// expression tree over string-named operators; a `Map String Int64` gives each operator's binding
/// power, and `needs-parens` decides whether a child must be wrapped when rendered under a parent
/// operator (a child of strictly lower precedence needs parentheses). `paren-count` folds that over the
/// whole tree — the count a printer would emit. This is a real pretty-printer concern and it stresses a
/// `Map String Int64` keyed by a matched sum-payload String (which works as a map key even though a
/// `String.at`-returned char does not compare by content — see the repro), plus scalar/bool returns
/// that stay clear of the borrow-ownership gap.
type Expr =
  | Num(Int64)
  | Bin(String, Expr, Expr)

/// The precedence table: higher binds tighter. `+`/`-` at 1, `*` at 2, `^` at 3.
def prec-table() = Map.insert(Map.insert(Map.insert(Map.insert(#{}, "+", 1), "-", 1), "*", 2), "^", 3)

/// An operator's precedence (0 for an unknown operator — binds loosest, so it is always parenthesized).
def prec-of(op: String) = match Map.lookup(prec-table(), op) with
  | Option.Some(p) => p
  | Option.None(_) => 0

/// The precedence of an expression's top node: a leaf `Num` binds tightest (99, never parenthesized).
def expr-prec(e: Expr) = match e with
  | Expr.Num(_) => 99
  | Expr.Bin(op, _, _) => prec-of(op)

/// Does `child` need parentheses when it appears directly under an operator of precedence `parent-op`?
/// A child whose top precedence is strictly LOWER than the parent's binds looser, so it needs wrapping.
def needs-parens(parent-op: String, child: Expr) = expr-prec(child) < prec-of(parent-op)

/// The total number of parenthesizations a fully-parenthesizing printer would emit for `e`.
def paren-count(e: Expr) = match e with
  | Expr.Num(_) => 0
  | Expr.Bin(op, l, r) =>
    (if needs-parens(op, l) then 1 else 0)
    + (if needs-parens(op, r) then 1 else 0)
    + (paren-count(l) + paren-count(r))

@test
def prec-known-ops() =
  if prec-of("+") == 1 then
    (if prec-of("*") == 2 then (if prec-of("^") == 3 then unit else trap("^")) else trap("*"))
  else
    trap("+")

@test
def prec-unknown-op() = if prec-of("?") == 0 then unit else trap("unknown op is 0")

@test
def prec-num-is-tightest() = if expr-prec(Expr.Num(7)) == 99 then unit else trap("Num prec 99")

@test
def prec-bin-reads-op() =
  if expr-prec(Expr.Bin("*", Expr.Num(1), Expr.Num(2))) == 2 then unit else trap("(* ..) prec 2")

@test
def needs-parens-lower() =
  // (a + b) under * : prec(+)=1 < prec(*)=2 → needs parens
  if needs-parens("*", Expr.Bin("+", Expr.Num(1), Expr.Num(2))) then unit else trap("+ under * parens")

@test
def needs-parens-higher() =
  // (a * b) under + : prec(*)=2 !< prec(+)=1 → no parens
  if needs-parens("+", Expr.Bin("*", Expr.Num(1), Expr.Num(2))) then trap("* under + no parens") else unit

@test
def needs-parens-num() =
  // a Num under any op : 99 !< anything → no parens
  if needs-parens("^", Expr.Num(5)) then trap("num never parens") else unit

@test
def paren-count-flat() =
  // (1 + 2) : no child needs parens → 0
  if paren-count(Expr.Bin("+", Expr.Num(1), Expr.Num(2))) == 0 then unit else trap("flat 0")

@test
def paren-count-lower-child() =
  // (1 + 2) * 3 : the (+) left child of * needs parens → 1
  if paren-count(Expr.Bin("*", Expr.Bin("+", Expr.Num(1), Expr.Num(2)), Expr.Num(3))) == 1 then
    unit
  else
    trap("one paren")

@test
def paren-count-no-parens-needed() =
  // 1 + (2 * 3) : the (*) right child of + is HIGHER prec → no parens → 0
  if paren-count(Expr.Bin("+", Expr.Num(1), Expr.Bin("*", Expr.Num(2), Expr.Num(3)))) == 0 then
    unit
  else
    trap("higher child no parens")

// NOTE: a DEPTH-3+ `paren-count` (e.g. `((1 + 2) * 3) ^ 4`, correct answer 2) currently MISCOMPILES to
// 1 — a SEED bug, not a logic error here: `needs-parens` reads BOTH the parent operator's precedence
// (`prec-of op`) AND the child operator's (`expr-prec child` → `prec-of child-op`), so two matched
// `String` sum-payloads are live at once, and past a 3-deep recursion one read gets a stale value (see
// `repros/miscompile-two-live-string-payloads-across-recursion.sexp` — the identical tree with an Int64
// key counts correctly). The depth-<=2 `paren-count` tests above pass; the deep case is withheld until
// the two-live-string-payloads miscompile is fixed.

export { prec-of, needs-parens, paren-count }
