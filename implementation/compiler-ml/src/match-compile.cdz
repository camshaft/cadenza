/// match-compile.cdz — PATTERN-MATCH analysis: the front-end stage that turns a list of match arms over a
/// sum type into a decision (which arm fires for a given constructor) and checks the two properties a
/// compiler must report — EXHAUSTIVENESS (every constructor is handled, else a runtime match-failure is
/// possible) and REDUNDANCY (an arm that can never fire because earlier arms already subsume it).
///
/// Patterns here are one level deep over a sum whose constructors are tagged `0 .. numcons-1`:
///   - `PCon(c)` — matches a value whose constructor tag is `c`.
///   - `PVar(_)` / `PWild` — matches ANY value (an irrefutable binder / wildcard).
/// Arms are a `List(Pat)` in source order; the FIRST matching arm wins (top-to-bottom, as ML match does).
///
///   - `select arms tag`        — the 0-based arm that fires for a scrutinee with constructor `tag` (-1 if
///     none — a match failure).
///   - `exhaustive arms numcons`— do the arms cover every constructor `0..numcons-1`?
///   - `missing-count`          — how many constructors are UNHANDLED (0 iff exhaustive).
///   - `redundant-at arms i`    — is arm `i` unreachable (every tag it matches is caught earlier)?
///   - `first-redundant`        — the index of the first redundant arm (-1 if none).

type Pat =
  | PWild
  | PCon(Int64)
  | PVar(Int64)

/// Does pattern `p` match a value whose constructor tag is `t`?
def matches(p: Pat, t: Int64) = match p with
  | Pat.PWild => true
  | Pat.PVar(_) => true
  | Pat.PCon(c) => c == t

/// The first arm (0-based) matching tag `t`, scanning from index `i`; -1 if none.
def first-match(arms: List(Pat), t: Int64, i: Int64) = match arms with
  | [] => 0 - 1
  | [p, .. rest] => if matches(p, t) then i else first-match(rest, t, i + 1)

/// The arm that fires for constructor `tag` (first matching arm; -1 = match failure).
def select(arms: List(Pat), tag: Int64) = first-match(arms, tag, 0)

/// The same as `first-match` but only considering the first `limit` arms (a prefix) — used to ask what an
/// EARLIER prefix of the arm list already covers.
def first-match-in-prefix(arms: List(Pat), t: Int64, i: Int64, limit: Int64) = match arms with
  | [] => 0 - 1
  | [p, .. rest] =>
    if i >= limit then 0 - 1
    else (if matches(p, t) then i else first-match-in-prefix(rest, t, i + 1, limit))

/// Do the FIRST `limit` arms cover every constructor `0..numcons-1`?
def prefix-covers-all(arms: List(Pat), limit: Int64, numcons: Int64) = pca(arms, limit, 0, numcons)

def pca(arms: List(Pat), limit: Int64, t: Int64, numcons: Int64) =
  if t >= numcons then true
  else (if first-match-in-prefix(arms, t, 0, limit) == (0 - 1) then false else pca(arms, limit, t + 1, numcons))

/// Do the arms cover every constructor `0..numcons-1` (exhaustive)?
def exhaustive(arms: List(Pat), numcons: Int64) = prefix-covers-all(arms, List.len(arms), numcons)

/// How many constructors `0..numcons-1` are UNHANDLED (0 iff exhaustive).
def missing-count(arms: List(Pat), numcons: Int64) = mc(arms, 0, numcons, 0)

def mc(arms: List(Pat), t: Int64, numcons: Int64, acc: Int64) =
  if t >= numcons then acc
  else mc(arms, t + 1, numcons, (if select(arms, t) == (0 - 1) then acc + 1 else acc))

/// Is arm `i` REDUNDANT — can it never fire because earlier arms already subsume it?
///   - a `PCon(c)` arm is redundant iff some earlier arm matches `c` (then `c` never reaches arm `i`).
///   - a wildcard/var arm is redundant iff the earlier arms already cover ALL constructors (so no value
///     reaches it).
def redundant-at(arms: List(Pat), i: Int64, numcons: Int64) = match List.at(arms, i) with
  | Option.None(_) => false
  | Option.Some(p) => (match p with
    | Pat.PCon(c) => (first-match-in-prefix(arms, c, 0, i) == (0 - 1)) == false
    | Pat.PWild => prefix-covers-all(arms, i, numcons)
    | Pat.PVar(_) => prefix-covers-all(arms, i, numcons))

/// The index of the first redundant arm, or -1 if none.
def first-redundant(arms: List(Pat), numcons: Int64) = fr(arms, 0, numcons)

def fr(arms: List(Pat), i: Int64, numcons: Int64) =
  if i >= List.len(arms) then 0 - 1
  else (if redundant-at(arms, i, numcons) then i else fr(arms, i + 1, numcons))

/// Builders.
def con(c: Int64) = Pat.PCon(c)

@test
def mc-select-by-tag() =
  // arms [PCon 0, PCon 1, PWild]: tag 0→0, tag 1→1, tag 2→2 (wildcard).
  let arms = [con(0), con(1), Pat.PWild] in
  if select(arms, 0) == 0 then (if select(arms, 1) == 1 then (if select(arms, 2) == 2 then unit else trap("tag2→wild arm2")) else trap("tag1")) else trap("tag0")

@test
def mc-select-none-is-failure() =
  // arms [PCon 0] and scrutinee tag 1 → no arm matches → -1.
  if select([con(0)], 1) == 0 - 1 then unit else trap("unmatched tag → -1")

@test
def mc-exhaustive-full() =
  // 2-constructor sum, arms [PCon 0, PCon 1] → exhaustive, 0 missing.
  let arms = [con(0), con(1)] in
  if exhaustive(arms, 2) then (if missing-count(arms, 2) == 0 then unit else trap("0 missing")) else trap("full is exhaustive")

@test
def mc-not-exhaustive-partial() =
  // arms [PCon 0] over 2 constructors → NOT exhaustive, 1 missing (tag 1).
  let arms = [con(0)] in
  if exhaustive(arms, 2) then trap("partial is not exhaustive") else (if missing-count(arms, 2) == 1 then unit else trap("1 missing"))

@test
def mc-wildcard-makes-exhaustive() =
  // arms [PCon 0, PWild] over 3 constructors → the wildcard covers 1 and 2 → exhaustive, 0 missing.
  let arms = [con(0), Pat.PWild] in
  if exhaustive(arms, 3) then (if missing-count(arms, 3) == 0 then unit else trap("0 missing with wildcard")) else trap("wildcard exhausts")

@test
def mc-missing-count-two() =
  // arms [PCon 1] over 3 constructors {0,1,2} → tags 0 and 2 unhandled → 2 missing.
  if missing-count([con(1)], 3) == 2 then unit else trap("2 constructors unhandled")

@test
def mc-redundant-con-after-same() =
  // arms [PCon 0, PCon 0]: the second PCon 0 is redundant (arm 0 already matches tag 0).
  let arms = [con(0), con(0)] in
  if redundant-at(arms, 1, 2) then (if redundant-at(arms, 0, 2) then trap("arm 0 is reachable") else unit) else trap("second PCon 0 is redundant")

@test
def mc-redundant-arm-after-wildcard() =
  // arms [PCon 0, PWild, PCon 1]: the wildcard at arm 1 covers everything, so arm 2 (PCon 1) is redundant.
  let arms = [con(0), Pat.PWild, con(1)] in
  if redundant-at(arms, 2, 2) then (if first-redundant(arms, 2) == 2 then unit else trap("first redundant is arm 2")) else trap("arm after a wildcard is redundant")

@test
def mc-no-redundancy-in-clean-match() =
  // arms [PCon 0, PCon 1] over 2 constructors → no redundant arm.
  let arms = [con(0), con(1)] in
  if first-redundant(arms, 2) == 0 - 1 then unit else trap("a clean match has no redundant arm")

@test
def mc-wildcard-not-redundant-when-needed() =
  // arms [PCon 0, PWild] over 2 constructors: the wildcard is NOT redundant (it catches tag 1, uncovered
  // by arm 0 alone). first-redundant = -1.
  let arms = [con(0), Pat.PWild] in
  if redundant-at(arms, 1, 2) then trap("the wildcard is needed for tag 1") else (if first-redundant(arms, 2) == 0 - 1 then unit else trap("no redundancy"))

export { select, exhaustive, missing-count, redundant-at, first-redundant }
