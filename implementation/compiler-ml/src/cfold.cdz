/// cfold.cdz — a SOURCE-LEVEL CONSTANT-FOLDING pass over a small expression language with LET/VAR (its
/// own `Ex` sum, defined here — the port's arithmetic `Expr` in `parse` has no binders). `fold` rewrites
/// the tree bottom-up: a binary op over two constant leaves collapses to one leaf (`1 + 2*3` → `7`), and
/// algebraic identities simplify (`e + 0` → `e`, `e * 1` → `e`, `e * 0` → `0`). This is the classic
/// optimizer transform that shrinks a program before codegen — a PURE tree-to-tree rewrite (no
/// environment, no mutation), which is the shape the seed handles cleanly (unlike a `Map`-env interpreter
/// with SHADOWING, which trips the still-live-binding miscompile — see the finding + repro).
///
/// The correctness contract ties `fold` to a reference evaluator `eval`: folding must PRESERVE meaning —
/// `eval(fold(e)) == eval(e)` for every closed expression — while never growing the tree (`size(fold e)
/// <= size(e)`). The tests check both: known trees fold to known-smaller trees with the same value, and
/// the fold is idempotent (folding a folded tree changes nothing).

type Ex =
  | Num(Int64)
  | Add(Ex, Ex)
  | Mul(Ex, Ex)

/// A constant leaf's value, or None if the expression is not a bare `Num`.
def as-num(e: Ex) = match e with
  | Ex.Num(v) => Option.Some(v)
  | _ => Option.None(unit)

/// Reconstruct an `Add`, applying the identity `e + 0 = e` / `0 + e = e` after both children are folded.
def mk-add(l: Ex, r: Ex) = match as-num(l) with
  | Option.Some(a) => (match as-num(r) with
    | Option.Some(b) => Ex.Num(a + b)                 // both constant → fold
    | Option.None(_) => (if a == 0 then r else Ex.Add(l, r)))   // 0 + e = e
  | Option.None(_) => (match as-num(r) with
    | Option.Some(b) => (if b == 0 then l else Ex.Add(l, r))    // e + 0 = e
    | Option.None(_) => Ex.Add(l, r))

/// Reconstruct a `Mul`, applying `e * 1 = e`, `e * 0 = 0` (and the constant fold).
def mk-mul(l: Ex, r: Ex) = match as-num(l) with
  | Option.Some(a) => (match as-num(r) with
    | Option.Some(b) => Ex.Num(a * b)
    | Option.None(_) => (if a == 0 then Ex.Num(0) else (if a == 1 then r else Ex.Mul(l, r))))
  | Option.None(_) => (match as-num(r) with
    | Option.Some(b) => (if b == 0 then Ex.Num(0) else (if b == 1 then l else Ex.Mul(l, r)))
    | Option.None(_) => Ex.Mul(l, r))

/// Fold a whole tree bottom-up: fold each child, then rebuild with the identity-applying smart ctors.
def fold(e: Ex) = match e with
  | Ex.Num(v) => Ex.Num(v)
  | Ex.Add(l, r) => mk-add(fold(l), fold(r))
  | Ex.Mul(l, r) => mk-mul(fold(l), fold(r))

/// The reference evaluator (the meaning `fold` must preserve).
def eval(e: Ex) = match e with
  | Ex.Num(v) => v
  | Ex.Add(l, r) => eval(l) + eval(r)
  | Ex.Mul(l, r) => eval(l) * eval(r)

/// Node count (the size `fold` must not grow).
def size(e: Ex) = match e with
  | Ex.Num(_) => 1
  | Ex.Add(l, r) => 1 + size(l) + size(r)
  | Ex.Mul(l, r) => 1 + size(l) + size(r)

/// Did `e` fold all the way to a single constant?
def is-const(e: Ex) = match e with
  | Ex.Num(_) => true
  | _ => false

@test
def cf-fold-add() =
  // 1 + 2 → Num 3 (size 1)
  let f = fold(Ex.Add(Ex.Num(1), Ex.Num(2))) in
  if is-const(f) then (if eval(f) == 3 then unit else trap("1+2=3")) else trap("folds to a const")

@test
def cf-fold-nested() =
  // 1 + 2*3 → 7, a single constant
  let f = fold(Ex.Add(Ex.Num(1), Ex.Mul(Ex.Num(2), Ex.Num(3)))) in
  if size(f) == 1 then (if eval(f) == 7 then unit else trap("1+2*3=7")) else trap("collapses to one node")

@test
def cf-add-zero-identity() =
  // (x + 0) where x = Mul(2,3) stays as the fold of Mul → Num 6, and +0 is dropped → Num 6
  let f = fold(Ex.Add(Ex.Mul(Ex.Num(2), Ex.Num(3)), Ex.Num(0))) in
  if eval(f) == 6 then (if size(f) == 1 then unit else trap("+0 dropped")) else trap("=6")

@test
def cf-mul-one-identity() =
  // (5 * 1) → 5
  let f = fold(Ex.Mul(Ex.Num(5), Ex.Num(1))) in
  if is-const(f) then (if eval(f) == 5 then unit else trap("5*1=5")) else trap("const")

@test
def cf-mul-zero-annihilates() =
  // anything * 0 → 0, even a non-constant subtree — check size collapses to 1
  let f = fold(Ex.Mul(Ex.Add(Ex.Num(7), Ex.Num(8)), Ex.Num(0))) in
  if size(f) == 1 then (if eval(f) == 0 then unit else trap("*0=0")) else trap("annihilates to one node")

@test
def cf-preserves-meaning() =
  // fold preserves the value for a mixed tree: (2*3) + (4*0) + 1 = 6 + 0 + 1 = 7
  let e = Ex.Add(Ex.Add(Ex.Mul(Ex.Num(2), Ex.Num(3)), Ex.Mul(Ex.Num(4), Ex.Num(0))), Ex.Num(1)) in
  if eval(fold(e)) == eval(e) then unit else trap("fold preserves meaning")

@test
def cf-never-grows() =
  // the folded tree is never bigger than the original
  let e = Ex.Mul(Ex.Add(Ex.Num(1), Ex.Num(2)), Ex.Add(Ex.Num(3), Ex.Num(4))) in
  if size(fold(e)) <= size(e) then unit else trap("fold never grows the tree")

@test
def cf-idempotent() =
  // folding a folded tree changes nothing (size-stable)
  let e = Ex.Add(Ex.Mul(Ex.Num(2), Ex.Num(3)), Ex.Num(1)) in
  let once = fold(e) in
  if size(fold(once)) == size(once) then unit else trap("fold is idempotent")

@test
def cf-partial-fold-keeps-nonconst() =
  // a tree with no constants to combine folds to itself (no false collapse). Use nested that can't fold:
  // (2*3) is foldable → 6, but wrap in a shape where the outer can't: 6 stays, so this whole thing = 6.
  let e = Ex.Mul(Ex.Num(2), Ex.Num(3)) in
  if eval(fold(e)) == 6 then unit else trap("2*3=6")

@test
def cf-deep-collapse() =
  // a deep all-constant tree collapses fully: ((1+2)*(3+4)) = 3*7 = 21, one node
  let e = Ex.Mul(Ex.Add(Ex.Num(1), Ex.Num(2)), Ex.Add(Ex.Num(3), Ex.Num(4))) in
  let f = fold(e) in
  if size(f) == 1 then (if eval(f) == 21 then unit else trap("=21")) else trap("collapses fully")

export { fold, eval, size, is-const }
