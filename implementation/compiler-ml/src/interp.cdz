/// interp.cdz — a tree-walking INTERPRETER for a small expression language with LET BINDINGS, evaluated
/// under a `Map String Int64` environment. `Let x rhs body` evaluates `rhs`, extends the environment with
/// `x ↦ value`, and evaluates `body` in the extended env; a `Var` looks its name up (unbound → -1 as a
/// sentinel). This is the eval half of a real compiler/REPL, and it stresses a `Map String Int64`
/// environment EXTENDED (`Map.insert`) and LOOKED UP (`Map.lookup`) while THREADED through recursion —
/// with correct lexical scope (an inner `Let` shadows an outer binding, since `Map.insert` replaces).
type Expr =
  | Num(Int64)
  | Var(String)
  | Add(Expr, Expr)
  | Mul(Expr, Expr)
  | Let(String, Expr, Expr)

/// Evaluate `e` under `env`. An unbound variable yields the sentinel -1.
def ev(e: Expr, env: Map(String, Int64)) = match e with
  | Expr.Num(v) => v
  | Expr.Var(x) => (match Map.lookup(env, x) with
    | Option.Some(v) => v
    | Option.None(_) => 0 - 1)
  | Expr.Add(a, b) => ev(a, env) + ev(b, env)
  | Expr.Mul(a, b) => ev(a, env) * ev(b, env)
  | Expr.Let(x, rhs, body) => ev(body, Map.insert(env, x, ev(rhs, env)))

/// Evaluate `e` in the empty environment.
def run(e: Expr) = ev(e, #{})

@test
def interp-num() = if run(Expr.Num(42)) == 42 then unit else trap("literal 42")

@test
def interp-add() = if run(Expr.Add(Expr.Num(10), Expr.Num(32))) == 42 then unit else trap("10 + 32")

@test
def interp-mul() = if run(Expr.Mul(Expr.Num(6), Expr.Num(7))) == 42 then unit else trap("6 * 7")

@test
def interp-nested-arith() =
  // (2 + 3) * 8 = 40
  if run(Expr.Mul(Expr.Add(Expr.Num(2), Expr.Num(3)), Expr.Num(8))) == 40 then unit else trap("(2+3)*8")

@test
def interp-let-bind() =
  // let x = 42 in x
  if run(Expr.Let("x", Expr.Num(42), Expr.Var("x"))) == 42 then unit else trap("let x = 42 in x")

@test
def interp-let-used-twice() =
  // let x = 21 in (x + x) = 42
  if run(Expr.Let("x", Expr.Num(21), Expr.Add(Expr.Var("x"), Expr.Var("x")))) == 42 then
    unit
  else
    trap("x + x = 42")

@test
def interp-nested-let() =
  // let x = 10 in (x + (let y = 32 in y)) = 42
  let e = Expr.Let("x", Expr.Num(10), Expr.Add(Expr.Var("x"), Expr.Let("y", Expr.Num(32), Expr.Var("y")))) in
  if run(e) == 42 then unit else trap("nested let 42")

@test
def interp-shadowing() =
  // let x = 1 in (let x = 2 in x) → 2 (inner shadows outer)
  if run(Expr.Let("x", Expr.Num(1), Expr.Let("x", Expr.Num(2), Expr.Var("x")))) == 2 then
    unit
  else
    trap("inner let shadows outer")

@test
def interp-shadow-does-not-leak-into-sibling() =
  // REGRESSION: `let x = 1 in ((let x = 2 in x) + x)` is 3 (2 + 1) — the inner `let x = 2` shadows only
  // WITHIN its own body; the trailing `x` still reads the OUTER 1. This once MISCOMPILED to 4 — a
  // `Map.insert(env, …)` in the left operand's recursion mutated the SHARED `env` param, so the right
  // operand's `x` wrongly read 2 (queue: mlrepro-miscompile-map-insert-mutates-shared-recursive-param,
  // now RESOLVED — the seed aliasing bug was fixed, so this is enabled as a live guard). Distinct from
  // `interp-shadowing` above, where the inner binding is the ONLY use of the env after insertion (so the
  // aliasing could not be observed and it passed even while this case failed).
  let inner = Expr.Let("x", Expr.Num(2), Expr.Var("x")) in
  let e = Expr.Let("x", Expr.Num(1), Expr.Add(inner, Expr.Var("x"))) in
  if run(e) == 3 then unit else trap("inner-let shadow must not leak into a sibling operand: 2 + 1 = 3")

@test
def interp-rhs-sees-outer-scope() =
  // let x = 5 in (let y = (x + 1) in y) → 6 (the inner rhs sees the outer x)
  let e = Expr.Let("x", Expr.Num(5), Expr.Let("y", Expr.Add(Expr.Var("x"), Expr.Num(1)), Expr.Var("y"))) in
  if run(e) == 6 then unit else trap("rhs sees outer scope: 6")

@test
def interp-unbound() = if run(Expr.Var("nope")) == 0 - 1 then unit else trap("unbound → -1")

export { ev, run }
