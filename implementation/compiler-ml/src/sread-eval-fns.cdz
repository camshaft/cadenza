/// sread-eval-fns.cdz — COMPOSITIONAL user-function end-to-end tests, SPLIT OUT of sread-eval.cdz. Each test
/// runs a multi-def / user-function program through the full source→value pipeline (`run-src`, imported from
/// sread-eval). SPLIT RATIONALE (same as sread-eval-ann): every `run-src` @test compiles the WHOLE compiler-ml
/// pipeline into its own wasm test-component, so a single file with many such tests exceeds the 360s gate
/// timeout under load (the standing compiler-ml hang). Keeping these compositional-function pins in their own
/// file keeps each file's component-build under the timeout. `run-src` stays in sread-eval.cdz.
///
/// These shapes currently RUN correctly but were UN-WITNESSED (the loop-doc "add a case even if it passes"
/// gate-coverage discipline) — pinned so a future reader/resolve/infer/lower/eval change can't silently break
/// them. Each value is differential-verified vs rcdzc.

import { run-src } from "sread-eval"

@test
def se-let-in-def-body() =
  // a def BODY that is a nested `let`: `(def (f x) (let ((y 10)) (+ x y)))` `(f 5)` → 15. Pins that a call's
  // inlined body can itself introduce a binder (the param `x` and the let's `y` coexist in the body scope).
  (match run-src("(do (def (f x) (let ((y 10)) (+ x y))) (def (main) (f 5)) (export main))") with
    | Option.Some(v) => (if v == 15 then unit else trap("(def (f x) (let y=10 in x+y)) (f 5) → 15"))
    | Option.None(_) => trap("a let-bodied def call runs"))

@test
def se-if-in-def-body() =
  // a def body with CONTROL FLOW: `(def (f x) (if (< x 10) x 0))` `(f 5)` → 5. Pins an `if` inside a called
  // body (the param flows into the condition + a branch).
  (match run-src("(do (def (f x) (if (< x 10) x 0)) (def (main) (f 5)) (export main))") with
    | Option.Some(v) => (if v == 5 then unit else trap("(def (f x) (if x<10 then x else 0)) (f 5) → 5"))
    | Option.None(_) => trap("an if-bodied def call runs"))

@test
def se-param-used-twice-in-body() =
  // the param referenced MORE THAN ONCE: `(def (sq x) (* x x))` `(sq 7)` → 49. Pins that a single CLet binder
  // is read by multiple uses of the param (the arg is bound once, both `x` occurrences resolve to it).
  (match run-src("(do (def (sq x) (* x x)) (def (main) (sq 7)) (export main))") with
    | Option.Some(v) => (if v == 49 then unit else trap("(def (sq x) (* x x)) (sq 7) → 49"))
    | Option.None(_) => trap("a param used twice runs"))

@test
def se-two-distinct-helpers-in-main() =
  // `main` calls TWO DIFFERENT helper defs: `(g 3)` + `(h 4)` where g(x)=x*2, h(x)=x+1 → 6+5 = 11. Pins that
  // multiple distinct def-names resolve at distinct call sites in one expression.
  (match run-src("(do (def (g x) (* x 2)) (def (h x) (+ x 1)) (def (main) (+ (g 3) (h 4))) (export main))") with
    | Option.Some(v) => (if v == 11 then unit else trap("(g 3)+(h 4) = 6+5 = 11"))
    | Option.None(_) => trap("two distinct helpers run"))

@test
def se-call-results-as-arith-operands() =
  // call RESULTS as operands: `(+ (dbl 5) (dbl 3))` where dbl(x)=x*2 → 10+6 = 16. Pins that the SAME def
  // applied at two sites (with different args) composes under an arith op.
  (match run-src("(do (def (dbl x) (* x 2)) (def (main) (+ (dbl 5) (dbl 3))) (export main))") with
    | Option.Some(v) => (if v == 16 then unit else trap("(dbl 5)+(dbl 3) = 10+6 = 16"))
    | Option.None(_) => trap("call results as arith operands run"))

@test
def se-nested-two-arg-calls() =
  // NESTED 2-arg calls: `(add (add 1 2) (add 3 4))` where add(a,b)=a+b → add(3,7) = 10. Pins that a 2-arg
  // call's args can themselves be 2-arg calls (the nested-CLet wiring composes recursively at the call sites).
  (match run-src("(do (def (add a b) (+ a b)) (def (main) (add (add 1 2) (add 3 4))) (export main))") with
    | Option.Some(v) => (if v == 10 then unit else trap("add(add(1,2), add(3,4)) = add(3,7) = 10"))
    | Option.None(_) => trap("nested 2-arg calls run"))

@test
def se-two-param-if-selects-a-param() =
  // A 2-param helper whose body is an `if` COMPARING both params and RETURNING one of them: `max(a,b) =
  // (if (< a b) b a)`. The existing 2-param test (`add`) is pure arith; this pins that BOTH params flow
  // through a conditional AND each branch can be a distinct param reference — max(7,4) takes the else (a=7,
  // since 7<4 is false) → 7. Matches the reference (max 7 4 → 7).
  (match run-src("(do (def (max a b) (if (< a b) b a)) (def (main) (max 7 4)) (export main))") with
    | Option.Some(v) => (if v == 7 then unit else trap("max(7,4) = 7 (else branch, a)"))
    | Option.None(_) => trap("2-param if-selecting-a-param runs"))

@test
def se-two-param-if-selects-other-param() =
  // the THEN direction of the same shape: max(3,9) takes the then-branch (b=9, since 3<9 is true) → 9.
  // Pins both branches of the param-selecting conditional (guards a branch-swap regression).
  (match run-src("(do (def (max a b) (if (< a b) b a)) (def (main) (max 3 9)) (export main))") with
    | Option.Some(v) => (if v == 9 then unit else trap("max(3,9) = 9 (then branch, b)"))
    | Option.None(_) => trap("2-param if then-branch runs"))

@test
def se-narrow-param-plus-literal-runs() =
  // ★ LITERAL ADAPTATION (corpus 09-functions:3580 → 110:Int8) ★ — the complement to the CDZ0304 overflow
  // case: `(def (f (: a Int8)) (+ a 10))` `(f 100)` → 110. The body arith is Int8 (the param drives it), and
  // the bare literal `10` ADAPTS to Int8 (it fits) rather than forcing a spurious mixed-width Int8+Int64
  // decline. The corpus doc: "the check does NOT over-reject." Before this the ML compiler wrongly DECLINED
  // (a declined-when-should-run miscompile). Differential-verified vs rcdzc (110, in Int8 range).
  (match run-src("(do (def (f (: a Int8)) (+ a 10)) (def (main) (f 100)) (export main))") with
    | Option.Some(v) => (if v == 110 then unit else trap("(+ a 10) on Int8 param (f 100) → 110"))
    | Option.None(_) => trap("(+ a 10) must RUN (110 fits Int8) — literal adapts, not spurious mixed-width decline"))

@test
def se-narrow-param-plus-overflowing-literal-declines() =
  // the sharp companion: a literal that pushes the body OVER the narrow width still declines. `(+ a 100)` on
  // an Int8 param `(f 100)` = 200 OVERFLOWS Int8 → declines (CDZ0304). Pins that literal adaptation composes
  // with the overflow trap — the literal adapts to Int8, then the Int8 arith overflows.
  (match run-src("(do (def (f (: a Int8)) (+ a 100)) (def (main) (f 100)) (export main))") with
    | Option.None(_) => unit
    | Option.Some(_) => trap("(+ a 100) on Int8 param = 200 OVERFLOWS Int8 → must decline (CDZ0304)"))

@test
def se-logical-and-of-comparisons() =
  // LOGICAL `and` over two Bool comparisons: `(and (< 1 2) (< 3 4))` → 1 (both true). Pins the logical-op
  // subset end-to-end (and-node → Bool operands → Bool result, encoded 0/1). Differential-verified vs rcdzc.
  (match run-src("(and (< 1 2) (< 3 4))") with
    | Option.Some(v) => (if v == 1 then unit else trap("(and true true) → 1"))
    | Option.None(_) => trap("logical and of comparisons runs"))

@test
def se-logical-and-short-false() =
  // `and` with a false operand → 0: `(and (< 1 2) (< 5 4))` → 0 (second is false). Pins the false path.
  (match run-src("(and (< 1 2) (< 5 4))") with
    | Option.Some(v) => (if v == 0 then unit else trap("(and true false) → 0"))
    | Option.None(_) => trap("logical and with a false operand runs"))

@test
def se-logical-and-on-ints-declines() =
  // `and` REQUIRES Bool operands: `(and 1 2)` (int operands) → DECLINES (ill-typed), matching rcdzc's
  // `declined`. Pins that a logical op rejects non-Bool operands rather than coercing ints — the type
  // discipline complement to the running cases above.
  (match run-src("(and 1 2)") with
    | Option.None(_) => unit
    | Option.Some(_) => trap("(and 1 2) — int operands to a logical op must decline"))
