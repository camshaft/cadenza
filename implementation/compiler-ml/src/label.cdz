/// label.cdz — a NODE-NUMBERING pass driven by a `Fresh` EFFECT: assign a unique id to each node of an
/// `Expr` tree (imported cross-file from `parse`), via `Fresh.next()`. This is the canonical compiler use
/// of an effect — a gensym threading unique ids (node labels, SSA names, type-variable ids) through a
/// pass WITHOUT plumbing a counter parameter by hand. A `handle Fresh(0)` supplies 0, 1, 2, …
///
/// It threads the effect in the SINGLE-RECURSIVE-SPINE shape that the tail-resumptive fold handles
/// correctly: a straight `Fresh.next() + <self-call>` loop over a FLAT node count, NOT a two-sibling
/// tree walk (a self-recursive effectful fn with TWO sibling recursive calls in a match arm miscompiles —
/// the handler state is not threaded between the siblings; see
/// `mlrepro-miscompile-effect-state-not-threaded-across-sibling-recursive-calls` (queue)). So this pass first
/// counts the nodes PURELY (`count-nodes`), then draws that many ids in one linear effectful loop
/// (`draw-sum`) — the standard "flatten, then gensym" structure that keeps the effect on one spine.
///
/// `run-labels e` sums the ids drawn (labels 0..N-1 → N*(N-1)/2, the Gauss closed form the tests check);
/// `label-count e` uses a constant-handback handler to count the draws (must equal `count-nodes`).

import { Tok, Expr, parse } from "parse"

/// The fresh-id supply effect (gensym) — one `next` per node.
effect Fresh =
  | next : -> Int64

/// Count the nodes of an `Expr` (pure — the node count that drives how many ids are drawn).
def count-nodes(e: Expr) = match e with
  | Expr.Lit(_) => 1
  | Expr.Bin(_, l, r) => 1 + count-nodes(l) + count-nodes(r)

/// Draw `n` fresh ids and SUM them — a single self-recursive effectful spine (the shape the fold reduces
/// correctly): each step draws one id (let-bound, so no perform sits inside a constructor) and recurses.
def draw-sum(n: Int64) =
  if n == 0 then
    0
  else
    let id = Fresh.next() in
    id + draw-sum(n - 1)

/// Label every node of `e`: draw one fresh id per node and sum the ids, under a 0-based counter.
def run-labels(e: Expr) =
  handle Fresh(0) with
    | next(s) => resume(s, s + 1)
  in
  draw-sum(count-nodes(e))

/// Count the ids drawn for `e` (constant-handback handler hands back 1 per draw) — must equal `count-nodes`.
def label-count(e: Expr) =
  handle Fresh(0) with
    | next(s) => resume(1, s)
  in
  draw-sum(count-nodes(e))

/// The closed form: labels 0..(N-1) sum to N*(N-1)/2.
def gauss(n: Int64) = n * (n - 1) / 2

/// A small tree builder: `Bin(op, Lit a, Lit b)` — 3 nodes.
def bin2(a: Int64, b: Int64) = Expr.Bin(43, Expr.Lit(a), Expr.Lit(b))

@test
def label-single-node() =
  // one Lit → one draw → id 0 → sum 0
  if run-labels(Expr.Lit(99)) == 0 then unit else trap("one node labelled 0")

@test
def label-count-single() =
  if label-count(Expr.Lit(99)) == 1 then unit else trap("one node drawn")

@test
def label-three-nodes() =
  // Bin(Lit, Lit): 3 nodes → labels 0,1,2 → sum 3
  if run-labels(bin2(5, 6)) == 3 then unit else trap("3 nodes: 0+1+2 = 3")

@test
def label-count-three() =
  if label-count(bin2(5, 6)) == 3 then unit else trap("3 nodes drawn")

@test
def label-agrees-with-node-count() =
  // the effect-drawn count MUST equal the pure node count, for a bigger tree
  let e = Expr.Bin(42, bin2(1, 2), Expr.Bin(45, bin2(3, 4), Expr.Lit(5))) in
  if label-count(e) == count-nodes(e) then unit else trap("drawn count == node count")

@test
def label-sum-is-gauss() =
  // for N nodes, the label sum is N*(N-1)/2 (labels 0..N-1)
  let e = Expr.Bin(42, bin2(1, 2), Expr.Bin(45, bin2(3, 4), Expr.Lit(5))) in
  let n = count-nodes(e) in
  if run-labels(e) == gauss(n) then unit else trap("label sum is the Gauss closed form")

@test
def label-count-matches-parser() =
  // parse "1+2*3" then label — the node count matches count-nodes of the parsed tree
  let ts = [Tok.TNum(1), Tok.TOp(43), Tok.TNum(2), Tok.TOp(42), Tok.TNum(3)] in
  let e = parse(ts) in
  if label-count(e) == count-nodes(e) then unit else trap("parsed tree labels == its node count")

@test
def label-deep-tree() =
  // a left-leaning chain: ((((1+2)+3)+4)+5) → 9 nodes → gauss(9) = 36
  let e = Expr.Bin(43, Expr.Bin(43, Expr.Bin(43, bin2(1, 2), Expr.Lit(3)), Expr.Lit(4)), Expr.Lit(5)) in
  if count-nodes(e) == 9 then (if run-labels(e) == gauss(9) then unit else trap("9-node sum = 36")) else trap("9 nodes")

export { count-nodes, run-labels, label-count }
