/// constprop.cdz — CONSTANT PROPAGATION over an expression language with LET bindings. Distinct from
/// `cfold.cdz` (which folds constant SUBTREES + algebraic identities but has no binder threading): this
/// threads a `Map String Int64` of known-constant bindings down the tree, so a `Var` bound to a constant
/// becomes that `Num`, and a `Let x = <const>` propagates its value into the body and DROPS the binding
/// (`let x = 5 in x + 1` → `6`). A `Let` whose RHS is not constant is kept, its body propagated under the
/// same env. Where both operands of a `+`/`*` become constants, a smart constructor folds them — so
/// propagation and folding compose into a single pass. This is the classic optimizer transform that turns
/// a constant-defined binding into an inlined literal before codegen.
///
/// It uses a `Map String Int64` env threaded through the recursion — the shape that once tripped the
/// still-live-binding shadowing miscompile (an inner rebind corrupting the outer env), now FIXED (the
/// Perceus retain landed), so a shadowing `let x = 1 in (let x = 10 in x) + x` propagates correctly.
///
/// Correctness contract: `cp` PRESERVES meaning — `eval(cp(e)) == eval(e)` for every closed expression —
/// and a fully-constant expression collapses to a single `Num`. The tests check both against a reference
/// `eval`.

type Ex =
  | Num(Int64)
  | Var(String)
  | Add(Ex, Ex)
  | Mul(Ex, Ex)
  | Let(String, Ex, Ex)

/// Smart `+`: fold when both sides are constants, else rebuild.
def add(l: Ex, r: Ex) = match l with
  | Ex.Num(a) => (match r with | Ex.Num(b) => Ex.Num(a + b) | _ => Ex.Add(l, r))
  | _ => Ex.Add(l, r)

/// Smart `*`: fold when both sides are constants (also `0 * e`/`e * 0` were it worth it — kept simple).
def mul(l: Ex, r: Ex) = match l with
  | Ex.Num(a) => (match r with | Ex.Num(b) => Ex.Num(a * b) | _ => Ex.Mul(l, r))
  | _ => Ex.Mul(l, r)

/// Propagate constants under `env` (name → known constant value).
def cp-env(env: Map(String, Int64), e: Ex) = match e with
  | Ex.Num(n) => Ex.Num(n)
  | Ex.Var(x) => (match Map.lookup(env, x) with
    | Option.Some(v) => Ex.Num(v)     // bound to a constant → inline it
    | Option.None(_) => Ex.Var(x))    // free / non-constant → leave the reference
  | Ex.Add(l, r) => add(cp-env(env, l), cp-env(env, r))
  | Ex.Mul(l, r) => mul(cp-env(env, l), cp-env(env, r))
  | Ex.Let(x, rhs, body) =>
    let rhs2 = cp-env(env, rhs) in
    (match rhs2 with
      | Ex.Num(v) => cp-env(Map.insert(env, x, v), body)   // constant binding: propagate + drop the `let`
      // non-constant binding: keep the `let`; the body sees `x` bound to this NON-constant, so REMOVE any
      // outer constant `x` from the env before propagating the body — else a shadowing inner
      // `let x = <non-const>` would wrongly fold the body's `x` to the outer constant
      // (`let x = 5 in let x = w in x + 1` must NOT fold the inner `x` to 5). Map.remove is a no-op when
      // `x` was not bound, so a non-shadowing case is unaffected.
      | _ => Ex.Let(x, rhs2, cp-env(Map.remove(env, x), body)))

/// Constant-propagate a whole (top-level) expression.
def cp(e: Ex) = cp-env(Map.empty, e)

/// Reference evaluator (a closed expression's value; a free var reads as -1).
def eval-env(env: Map(String, Int64), e: Ex) = match e with
  | Ex.Num(n) => n
  | Ex.Var(x) => (match Map.lookup(env, x) with | Option.Some(v) => v | Option.None(_) => 0 - 1)
  | Ex.Add(l, r) => eval-env(env, l) + eval-env(env, r)
  | Ex.Mul(l, r) => eval-env(env, l) * eval-env(env, r)
  | Ex.Let(x, rhs, body) => eval-env(Map.insert(env, x, eval-env(env, rhs)), body)

def eval(e: Ex) = eval-env(Map.empty, e)

/// Is `e` a single `Num` (fully collapsed)?
def is-num(e: Ex) = match e with | Ex.Num(_) => true | _ => false

/// Is `e` a `Let` (a binding was kept)?
def is-let(e: Ex) = match e with | Ex.Let(_, _, _) => true | _ => false

@test
def cp-preserves-simple() =
  // let x = 5 in x + 1 → cp collapses to Num 6; eval agrees.
  let e = Ex.Let("x", Ex.Num(5), Ex.Add(Ex.Var("x"), Ex.Num(1))) in
  if eval(cp(e)) == 6 then (if eval(e) == 6 then unit else trap("eval 6")) else trap("cp preserves 6")

@test
def cp-collapses-constant-let() =
  // A fully-constant let collapses to a single Num.
  if is-num(cp(Ex.Let("x", Ex.Num(5), Ex.Add(Ex.Var("x"), Ex.Num(1))))) then unit else trap("constant let collapses to Num")

@test
def cp-keeps-nonconstant-let() =
  // let x = w in x + 1 (w free) — RHS is not constant, so the let is KEPT (not collapsed to a Num).
  let e = Ex.Let("x", Ex.Var("w"), Ex.Add(Ex.Var("x"), Ex.Num(1))) in
  if is-let(cp(e)) then (if is-num(cp(e)) then trap("not collapsed") else unit) else trap("non-constant let is kept")

@test
def cp-nested-lets() =
  // let x = 2 in let y = x + 3 in y * x → x=2, y=5, 5*2 = 10.
  let e = Ex.Let("x", Ex.Num(2), Ex.Let("y", Ex.Add(Ex.Var("x"), Ex.Num(3)), Ex.Mul(Ex.Var("y"), Ex.Var("x")))) in
  if eval(cp(e)) == 10 then (if is-num(cp(e)) then unit else trap("nested collapses")) else trap("nested = 10")

@test
def cp-shadowing() =
  // let x = 1 in (let x = 10 in x) + x → inner x=10 shadows for its body; outer x=1 for the trailing +x.
  // (10) + 1 = 11. This is the shadowing shape that once tripped the still-live-binding miscompile.
  let inner = Ex.Let("x", Ex.Num(10), Ex.Var("x")) in
  let e = Ex.Let("x", Ex.Num(1), Ex.Add(inner, Ex.Var("x"))) in
  if eval(cp(e)) == 11 then (if eval(e) == 11 then unit else trap("eval 11")) else trap("shadowing = 11")

@test
def cp-shadow-by-nonconstant-not-folded() =
  // REGRESSION (PR #430 Copilot): let x = 5 in let x = w in x + 1. The inner `let x = w` (w free, NOT
  // constant) SHADOWS the outer x=5, so the body's `x` must NOT fold to 5. eval: outer x=5, inner x=w
  // (unbound → -1), so x + 1 = -1 + 1 = 0. The bug propagated the body under the same env (still holding
  // x=5), wrongly folding to 5 + 1 = 6 — a wrong-value fold. cp must agree with eval (0).
  let e = Ex.Let("x", Ex.Num(5), Ex.Let("x", Ex.Var("w"), Ex.Add(Ex.Var("x"), Ex.Num(1)))) in
  if eval(cp(e)) == eval(e) then (if eval(cp(e)) == 0 then unit else trap("value 0")) else trap("shadowing non-constant must not fold the outer constant")

@test
def cp-free-var-untouched() =
  // A free variable with no binding is left as a Var (eval reads -1). cp(w) stays w.
  if is-num(cp(Ex.Var("w"))) then trap("free var is not a constant") else unit

@test
def cp-folds-after-propagation() =
  // let x = 3 in x * x → propagate → 3 * 3 → smart-mul folds → Num 9.
  let e = Ex.Let("x", Ex.Num(3), Ex.Mul(Ex.Var("x"), Ex.Var("x"))) in
  if is-num(cp(e)) then (if eval(cp(e)) == 9 then unit else trap("3*3 = 9")) else trap("x*x folds to 9")

@test
def cp-partial-nonconstant() =
  // let x = 4 in (x + w) — x propagates to 4, but w is free, so → Add(Num 4, Var w): NOT a single Num,
  // and NOT a Let (the constant x-binding was dropped). eval reads w as -1 → 4 + -1 = 3.
  let e = Ex.Let("x", Ex.Num(4), Ex.Add(Ex.Var("x"), Ex.Var("w"))) in
  if is-num(cp(e)) then trap("has a free var, not fully constant")
  else (if is-let(cp(e)) then trap("constant x-binding was dropped") else (if eval(cp(e)) == 3 then unit else trap("4 + (-1) = 3")))

@test
def cp-idempotent() =
  // Const-propagating an already-propagated expression changes nothing observable (eval stable).
  let e = Ex.Let("x", Ex.Num(7), Ex.Add(Ex.Var("x"), Ex.Num(2))) in
  if eval(cp(e)) == eval(cp(cp(e))) then unit else trap("cp is idempotent under eval")

@test
def cp-deep-chain() =
  // A chain of constant lets: let a=1 in let b=a+1 in let c=b+1 in c → 3.
  let e = Ex.Let("a", Ex.Num(1),
            Ex.Let("b", Ex.Add(Ex.Var("a"), Ex.Num(1)),
              Ex.Let("c", Ex.Add(Ex.Var("b"), Ex.Num(1)), Ex.Var("c")))) in
  if eval(cp(e)) == 3 then (if is-num(cp(e)) then unit else trap("chain collapses")) else trap("chain = 3")

export { cp, eval }
