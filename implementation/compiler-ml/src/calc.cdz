/// calc.cdz — the FRONT-END CAPSTONE: a complete `String` → `Result(Int64, CalcError)` calculator that
/// composes three cross-file modules — a string lexer producing `parse`'s canonical `Tok` stream, then
/// `parse-checked`'s fallible parser, then the evaluator. This is the end-to-end "text in, value or a
/// positioned diagnostic out" path a real front end exposes (a REPL, a `--eval`, a config expression).
///
/// It stresses: cross-file composition of MULTIPLE modules (lexer → parser → eval), a string lexer that
/// builds the SHARED `Tok` type (so its output feeds `parse-checked` with no bridge/conversion), and
/// `Result` propagation from the lexer's char classification all the way through the parser's error
/// reporting. The lexer here builds `parse.Tok` directly (unlike `strlex`, which owns its own `Token`),
/// so `lex(s)` : `List Tok` drops straight into `parse-checked(lex(s))`.
///
/// Grammar + errors are `parse-checked`'s: multi-digit ints, `+ - * /`, parens; an ExpectedFactor /
/// ExpectedRParen at a token index. calc adds ONE lexer-level error class — a `Bad` character — surfaced
/// as `Token`-level `Bad`, which the parser then rejects as an ExpectedFactor (an unrecognized char can't
/// start a factor), so a stray `@` in the source becomes a positioned parse error rather than a trap.

import { Tok } from "parse"
import { run, ok } from "parse-checked"

/// ---- the string lexer (produces `parse`'s Tok directly) ----

def is-digit(c: String) =
  c == "0" or c == "1" or c == "2" or c == "3" or c == "4"
  or c == "5" or c == "6" or c == "7" or c == "8" or c == "9"

def is-space(c: String) = c == " "
def is-op(c: String) = c == "+" or c == "-" or c == "*" or c == "/"

def op-code(c: String) = if c == "+" then 43 else (if c == "-" then 45 else (if c == "*" then 42 else 47))

def digit-val(c: String) =
  if c == "0" then 0 else (if c == "1" then 1 else (if c == "2" then 2 else (if c == "3" then 3
  else (if c == "4" then 4 else (if c == "5" then 5 else (if c == "6" then 6 else (if c == "7" then 7
  else (if c == "8" then 8 else 9))))))))

/// Scan a digit run from `i` → `(value, next-index)`. `String.at` matched INLINE (a returned char compared
/// in a loop declines — see `mlrepro-decline-returned-string-at-compared-in-a-loop.cdz` (queue)).
def scan-number(s: String, i: Int64, acc: Int64) =
  if i == String.byte-len(s) then
    (acc, i)
  else
    (match String.at(s, i) with
      | Option.Some(c) => (if is-digit(c) then scan-number(s, i + 1, acc * 10 + digit-val(c)) else (acc, i))
      | Option.None(_) => (acc, i))

/// Lex the source string from `i` into a `List Tok` (source order via `List.push`). Builds `parse.Tok`
/// (`TNum`/`TOp`/`TLP`/`TRP`), so the result feeds `parse-checked` directly. An unrecognized char is
/// skipped as if a factor error will follow — but to surface it we emit a `TOp(0)` marker (op-code 0 is
/// not a real operator, so `parse-checked` rejects it as ExpectedFactor at that token).
def lex-from(s: String, i: Int64, acc: List(Tok)) =
  if i == String.byte-len(s) then
    acc
  else
    (match String.at(s, i) with
      | Option.None(_) => acc
      | Option.Some(c) =>
        (if is-space(c) then
          lex-from(s, i + 1, acc)
        else
          (if is-digit(c) then
            let sc = scan-number(s, i, 0) in
            lex-from(s, sc.1, List.push(acc, Tok.TNum(sc.0)))
          else
            (if is-op(c) then
              lex-from(s, i + 1, List.push(acc, Tok.TOp(op-code(c))))
            else
              (if c == "(" then
                lex-from(s, i + 1, List.push(acc, Tok.TLP))
              else
                (if c == ")" then
                  lex-from(s, i + 1, List.push(acc, Tok.TRP))
                else
                  // an unrecognized char → a bogus op-code 0 token, which the parser rejects as a factor error
                  lex-from(s, i + 1, List.push(acc, Tok.TOp(0)))))))))

/// Lex a whole source string into a `List Tok`.
def lex(s: String) = lex-from(s, 0, [])

/// ---- the capstone: lex then parse-and-evaluate ----

/// Evaluate a source string. Returns `Result(Int64, Int64)` — Ok(value), or Err(the parse-checked error
/// code from `run`, negated back to a positive code). `parse-checked.run` returns the value on success or
/// `-1 - errcode` on failure, so calc reads that: a non-negative-mapped success vs. an error code.
def calc(s: String) = run(lex(s))

/// Whether the source parses + evaluates without error (using parse-checked's own `ok`).
def calc-ok(s: String) = ok(lex(s))

@test
def calc-literal() = if calc("42") == 42 then unit else trap("42")

@test
def calc-add() = if calc("1+2") == 3 then unit else trap("1+2=3")

@test
def calc-precedence() =
  // "1 + 2 * 3" = 7 (spaces skipped, mul binds tighter)
  if calc("1 + 2 * 3") == 7 then unit else trap("1+2*3=7")

@test
def calc-parens() = if calc("(1 + 2) * 3") == 9 then unit else trap("(1+2)*3=9")

@test
def calc-multi-digit() = if calc("100 * 100") == 10000 then unit else trap("100*100=10000")

@test
def calc-left-assoc() = if calc("10 - 3 - 2") == 5 then unit else trap("10-3-2=5")

@test
def calc-deep() = if calc("2 * (3 + 4) - 1") == 13 then unit else trap("2*(3+4)-1=13")

@test
def calc-nested-parens() = if calc("((7))") == 7 then unit else trap("((7))=7")

@test
def calc-empty-is-error() =
  // "" lexes to no tokens → parse-checked ExpectedFactor(0) → not ok
  if calc-ok("") then trap("empty is a parse error") else unit

@test
def calc-bad-char-is-error() =
  // "1 @ 2" — the @ becomes a bogus op token; parse rejects it (not ok)
  if calc-ok("1 @ 2") then trap("stray @ is a parse error") else unit

@test
def calc-unbalanced-paren-is-error() =
  // "(1 + 2" — missing ) → parse error
  if calc-ok("(1 + 2") then trap("unbalanced ( is an error") else unit

@test
def calc-valid-is-ok() =
  // a well-formed expression is ok AND evaluates
  if calc-ok("3 * 4 + 5") then (if calc("3 * 4 + 5") == 17 then unit else trap("3*4+5=17")) else trap("valid → ok")

export { calc, calc-ok, lex }
