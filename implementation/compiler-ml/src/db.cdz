/// db.cdz — the LAZY QUERY-DATABASE substrate for the Cadenza-in-Cadenza compiler (Increment 0 of the
/// operator's re-charter). This mirrors rcdzc's `db.rs` spine — the memoized, demand-driven query engine
/// the whole compiler hangs off of — in Cadenza:
///
///   - ONE `Db` holds a COLUMN per kind of derived fact, each keyed by a node identity (`NodeId = Int64`,
///     the mirror of rcdzc's `StructId`). Here a column is a `Map(NodeId, Int64)` (the fact type widens to
///     a sum as real passes land; Int64 is the Inc-0 stand-in).
///   - A fact is answered by BACKWARD DEMAND that MEMOIZES: a producer reads its column; on a MISS it
///     COMPUTES the answer (reading upstream facts through their producers) and FILLS its column; a HIT is
///     an O(1) read. Asking one node's fact touches only what the answer reaches.
///   - The columns ARE the memo — there is no separate cache to invalidate (rcdzc's "incrementality is
///     re-run, not invalidation").
///   - ABSENCE ≠ VALUE: `get` returns `Option` — a filled slot vs. not-yet-determined. (A negative
///     DECISION — a decline/poison — is itself a filled value once the fact types widen; at Inc 0 the
///     stand-in fact is a plain Int64.)
///
/// STATE SHAPE — design note (re-charter plan): the truest mirror of rcdzc's `&mut Db` is a `Db` STATE
/// EFFECT (get/put over a threaded store). That is currently BLOCKED — a two-op handler (`get`/`put`) whose
/// state is a heap `Map`, where `get` returns a `Map.lookup`, DECLINES "not yet reducible by the tail-
/// resumptive fold" (filed: queue `mlrepro-decline-two-op-map-state-handler-memo-shape`, sent v-effects).
/// So this substrate uses the PURE THREADED-DB (plan design (B)): every producer takes a `Db` and returns
/// `(fact, Db')`, threading the memo store explicitly. Same demand + memo semantics, no effect dependency;
/// it switches to the effect form once that decline is lifted.
///
/// A `Db` is a record of columns. Inc 0 has ONE stand-in column, `facts`, plus the demand/memo combinator
/// `demand` that every real column producer (parse/resolve/infer/lower) will follow.

/// The Db: one column per derived fact, keyed by NodeId. (Inc 0: a single Int64-valued stand-in column.)
type Db =
  | Db(Map(Int64, Int64))

def empty() = Db.Db(Map.empty)

/// Read the `facts` column at `id` — `Some fact` if filled, `None` if not-yet-determined (absence ≠ value).
def get(db: Db, id: Int64) = match db with
  | Db.Db(facts) => Map.lookup(facts, id)

/// Fill the `facts` column at `id`, returning the updated Db (the column IS the memo).
def put(db: Db, id: Int64, fact: Int64) = match db with
  | Db.Db(facts) => Db.Db(Map.insert(facts, id, fact))

/// How many facts are memoized (a probe: the memo's size).
def size(db: Db) = match db with | Db.Db(facts) => Map.len(facts)

/// The DEMAND + MEMO discipline (rcdzc: "a producer reads its column; on a miss it computes and fills").
/// A producer FOLLOWS this shape directly rather than through a passed closure: `match get(db, id) with
/// Some(f) => (f, db) | None => let (v, db') = <compute, calling UPSTREAM producers> in (v, put(db', id, v))`.
/// (An earlier version passed `compute` as a `Db -> (fact, Db)` closure to a generic `demand`; that hit an
/// emit limit — "a round-trip closure program needs a PRODUCER export whose result is a closure" — for a
/// closure that returns the heap `Db`. Inlining the memo-check in each producer is both the fix AND the
/// truer rcdzc mirror: rcdzc producers call `resolve::resolved_of` directly, not a closure.) `demand-pure`
/// captures the common case where the fact needs no further Db threading (compute reads only `id`).
def demand-pure(db: Db, id: Int64, fact: Int64) = match get(db, id) with
  | Option.Some(f) => (f, db)
  | Option.None(_) => (fact, put(db, id, fact))

/// ---- Inc-0 witness column: a memoized `square` fact (stand-in for a real derived fact). ----
/// `square-of(db, id)` memoizes `id * id` in the facts column: first ask computes + fills, second is a HIT.
def square-of(db: Db, id: Int64) = demand-pure(db, id, id * id)

/// A DERIVED producer that reads an UPSTREAM producer (the producer-reads-producer shape rcdzc's contract
/// requires): `plus-one-of(id)` = `square-of(id) + 1`, memoized at key `id + 1000`. It demands `square-of`
/// (filling that column too if needed) and threads the resulting Db — the pattern every real derived pass
/// (infer reads resolve, lower reads infer) follows, without a closure.
def plus-one-of(db: Db, id: Int64) =
  let key = id + 1000 in
  (match get(db, key) with
    | Option.Some(f) => (f, db)
    | Option.None(_) => (match square-of(db, id) with | (sq, db1) => (let v = sq + 1 in (v, put(db1, key, v)))))

@test
def db-empty-is-absent() =
  // a fresh Db has no facts; get is None (absence, not a default value).
  (match get(empty(), 7) with | Option.None(_) => (if size(empty()) == 0 then unit else trap("size 0")) | Option.Some(_) => trap("empty Db has no fact for 7"))

@test
def db-put-then-get() =
  // fill id 3 → 99; get returns Some 99; size 1.
  let db = put(empty(), 3, 99) in
  (match get(db, 3) with | Option.Some(v) => (if v == 99 then (if size(db) == 1 then unit else trap("size 1")) else trap("=99")) | Option.None(_) => trap("3 is filled"))

@test
def db-demand-computes-on-miss() =
  // square-of(5) on an empty Db: MISS → computes 25, fills the column.
  (match square-of(empty(), 5) with | (v, db1) => (if v == 25 then (if size(db1) == 1 then unit else trap("filled one")) else trap("5*5=25")))

@test
def db-demand-hit-does-not-recompute() =
  // the memo property: after square-of(5) fills, a SECOND square-of(5) is a HIT — same value, size still 1
  // (compute not re-run, the fill from the first ask is reused). This is compute-once-on-2nd-ask.
  (match square-of(empty(), 5) with | (_, db1) =>
    (match square-of(db1, 5) with | (v2, db2) =>
      (if v2 == 25 then (if size(db2) == 1 then unit else trap("still one fact — 2nd ask was a HIT")) else trap("hit value 25"))))

@test
def db-distinct-nodes-distinct-facts() =
  // demanding two different nodes fills two columns entries; each memoized independently.
  (match square-of(empty(), 4) with | (_, db1) =>
    (match square-of(db1, 6) with | (v6, db2) =>
      (if v6 == 36 then (if size(db2) == 2 then unit else trap("two distinct facts")) else trap("6*6=36"))))

@test
def db-derived-reads-upstream() =
  // the producer-reads-producer shape: plus-one-of(5) demands square-of(5), fills BOTH columns (the
  // square at 5 and the derived fact at 1005). Result 25+1 = 26; two facts memoized.
  (match plus-one-of(empty(), 5) with | (v, dbf) =>
    (if v == 26 then (if size(dbf) == 2 then unit else trap("square + derived = 2 facts")) else trap("25+1=26")))

@test
def db-derived-hit() =
  // the derived fact is itself memoized: asking plus-one-of(5) twice computes the chain once (still 2 facts,
  // the 2nd ask is a HIT on the derived column).
  (match plus-one-of(empty(), 5) with | (_, db1) =>
    (match plus-one-of(db1, 5) with | (v2, db2) =>
      (if v2 == 26 then (if size(db2) == 2 then unit else trap("2nd ask of derived is a HIT")) else trap("hit 26"))))

export { Db.*, empty, get, put, size, demand-pure, square-of, plus-one-of }
