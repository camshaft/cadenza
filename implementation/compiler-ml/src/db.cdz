/// db.cdz — THE QUERY DB (Tier-2 of the rcdzc port). A faithful port of rcdzc's `db.rs`: the compiler is a
/// query engine over ONE `Db` that is PURE DATA — the source `Tree` (the ast column) plus a COLUMN per kind
/// of derived fact (resolved / types / core). Every phase is a producer that fills exactly ONE column, reads
/// upstream only through the upstream producer, and MEMOIZES: a fact computed once is stored in its column
/// and never recomputed. This replaces the whim-built pipeline's hand-threaded maps + recompute-resolve-
/// per-demand (infer-db re-ran resolve on every call) with rcdzc's memoized-column model.
///
/// COLUMN SEMANTICS (rcdzc `arena.rs` Slot/Column, ported over the builtin `Map`): a column is a
/// `Map(NodeId, Fact)`. rcdzc's `Slot<T> = Absent | Filled(T)` IS Cadenza's builtin `Option` — `None` =
/// Absent (no answer determined yet), `Some(v)` = Filled. The disciplines:
///   - FILL-ONCE: a producer `fill`s the fact it determined; the column grows monotonically.
///   - REQUIRE-DECLINES-ON-ABSENT: `require` returns `Option` and a reader that NEEDS a value declines on
///     `None` rather than substituting a default — an unfilled slot is "not yet determined", never a value.
///   - POISON-AS-FILLED-VALUE: a NEGATIVE decision (a decline / ill-typed) is carried as a FILLED value of
///     the fact type (resolve's RPoison, infer's TErr), so a decline is DISTINGUISHED from "unanswered".
/// (Option-c per the concierge: model rcdzc's Column SEMANTICS over the builtin Map — no user-generic
/// container type, which the ML surface doesn't offer; we mirror what a Column DOES, not Rust's struct.)
///
/// This slice (P1a) is the pure-data Db RECORD + its column accessors, standalone + tested. The STATE-EFFECT
/// carrier (the operator's "put the whole Db record inside a state effect so producers get/put it without
/// manual threading") is the next slice (P1b) — it wraps THIS record; the memoization semantics are here.
import { Tree } from "parse-db"

import { Resolved } from "resolve-db"

import { Typed } from "infer-db"

import { Core } from "lower-db"

/// The query DB: the source `Tree` (ast column) + one memoized column per derived fact. A single-variant
  /// sum carrying the columns (the ML-surface analog of rcdzc's `Db` struct, mirroring parse-db's
  /// `Tree.Arena(Map, next)` compound-carrier idiom). Columns are `Map(NodeId, Fact)`; an absent key = a
  /// `Slot::Absent` (fact not yet determined).
  type Db =
  | Db(Tree, Map(Int64, Resolved), Map(Int64, Typed), Map(Int64, Core))

/// A fresh Db over a source `Tree`: every derived column empty (all slots Absent). The load step — rcdzc's
/// `Db::load` (here the tree is already parsed; the columns fill lazily as producers demand facts).
def db-of(tree: Tree) =
  Db.Db(
    tree,
    Map.empty : Map(Int64, Resolved),
    Map.empty : Map(Int64, Typed),
    Map.empty : Map(Int64, Core)
  )

/// The source `Tree` (the ast column) — read-only.
def db-tree(db: Db) =
  let Db.Db(t, _, _, _) = db in
  t

// ---- the RESOLVED column (filled by resolve) --------------------------------------------------------
/// FILL the resolved fact for `id` (a producer records what it determined). NOTE: this is a plain
/// `Map.insert` — it OVERWRITES an already-filled slot. The FILL-ONCE / monotone discipline is enforced by
/// the PRODUCER (the `demand-*` layer, e.g. db-demand's `demand-typed`), which checks `require-*` and fills
/// ONLY on a MISS — so a determined fact is never clobbered. `fill-*` itself is the low-level column write;
/// callers must go through a demand producer (not call `fill-*` on a slot they haven't required Absent).
def fill-resolved(db: Db, id: Int64, r: Resolved) =
  let Db.Db(t, rc, tc, cc) = db in
  Db.Db(t, Map.insert(rc, id, r), tc, cc)

/// REQUIRE the resolved fact at `id`: `Some(fact)` if filled (incl. a filled RPoison decline), `None` if the
/// slot is Absent (not yet determined) — a caller that needs it declines on `None`, never defaults.
def require-resolved(db: Db, id: Int64) =
  let Db.Db(_, rc, _, _) = db in
  Map.lookup(rc, id)

// ---- the TYPES column (filled by infer) -------------------------------------------------------------
/// FILL the type fact for `id`.
def fill-typed(db: Db, id: Int64, ty: Typed) =
  let Db.Db(t, rc, tc, cc) = db in
  Db.Db(t, rc, Map.insert(tc, id, ty), cc)

/// REQUIRE the type fact at `id` (`Some` filled — incl. a filled TErr decline — else `None`).
def require-typed(db: Db, id: Int64) =
  let Db.Db(_, _, tc, _) = db in
  Map.lookup(tc, id)

// ---- the CORE column (filled by lower) --------------------------------------------------------------
/// FILL the core fact for `id`.
def fill-core(db: Db, id: Int64, c: Core) =
  let Db.Db(t, rc, tc, cc) = db in
  Db.Db(t, rc, tc, Map.insert(cc, id, c))

/// REQUIRE the core fact at `id` (`Some` filled else `None`).
def require-core(db: Db, id: Int64) =
  let Db.Db(_, _, _, cc) = db in
  Map.lookup(cc, id)

// ---- column sizes (how many facts memoized — a memo-progress probe) ---------------------------------
def resolved-filled(db: Db) =
  let Db.Db(_, rc, _, _) = db in
  Map.len(rc)

def typed-filled(db: Db) =
  let Db.Db(_, _, tc, _) = db in
  Map.len(tc)

def core-filled(db: Db) =
  let Db.Db(_, _, _, cc) = db in
  Map.len(cc)

// ---- TESTS: the Slot semantics (fill-once, require-declines-on-absent, poison-as-filled) ------------
import { Tok, parse-tokens } from "parse-db"

/// A tiny parsed tree to key columns against (the literal `5` → root id 0).
def sample-db() = match parse-tokens([Tok.TNum(5)]) with
  | (_, tree) => db-of(tree)

@test
def db-empty-columns-absent() =
  // a fresh Db has every derived column Absent: require → None (absent ≠ a value).
  let db = sample-db() in
  match require-resolved(db, 0) with
    | Option.None(_) => (match require-typed(db, 0) with
      | Option.None(_) => (match require-core(db, 0) with
        | Option.None(_) => unit
        | Option.Some(_) => trap("core absent")
      )
      | Option.Some(_) => trap("types absent")
    )
    | Option.Some(_) => trap("resolved absent on a fresh Db")

@test
def db-fill-then-require-typed() =
  // fill the types column at id 0 with Int64, require it back → Some(TIntW(true,64)).
  let db = fill-typed(sample-db(), 0, Typed.TIntW(true, 64)) in
  match require-typed(db, 0) with
    | Option.Some(Typed.TIntW(s, w)) => (if s and w == 64 then unit else trap("Int64 fact"))
    | _ => trap("filled type fact requires Some(TIntW)")

@test
def db-require-absent-id-is-none() =
  // filling id 0 leaves id 99 Absent — require declines on the unfilled slot (never a default).
  let db = fill-typed(sample-db(), 0, Typed.TBool) in
  match require-typed(db, 99) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("unfilled id 99 is Absent → None")

@test
def db-poison-is-a-filled-value() =
  // a DECLINE is carried as a FILLED fact (TErr), DISTINCT from Absent: require → Some(TErr), not None.
  // This is the poison-as-filled-value discipline — a decline is a determined answer, not "unanswered".
  let db = fill-typed(sample-db(), 0, Typed.TErr) in
  match require-typed(db, 0) with
    | Option.Some(Typed.TErr) => unit
    | Option.None(_) => trap("a filled poison is NOT Absent — it's a determined decline")
    | Option.Some(_) => trap("poison fact is TErr")

@test
def db-fill-once-monotone-columns-independent() =
  // filling resolved doesn't touch types/core; each column is independent. Fill resolved@0 + core@0, check
  // both present and types still Absent (columns are separate memo stores).
  let db1 = fill-resolved(sample-db(), 0, Resolved.RPoison) in
  let db2 = fill-core(db1, 0, Core.CNum(5, true, 64)) in
  match require-resolved(db2, 0) with
    | Option.Some(_) => (match require-core(db2, 0) with
      | Option.Some(_) => (match require-typed(db2, 0) with
        | Option.None(_) => unit
        | Option.Some(_) => trap("types still Absent")
      )
      | Option.None(_) => trap("core filled")
    )
    | Option.None(_) => trap("resolved filled")

@test
def db-fill-count-tracks-memo() =
  // the filled-count grows as facts memoize: 0 → fill two type facts → 2.
  let db = fill-typed(fill-typed(sample-db(), 0, Typed.TBool), 1, Typed.TBool) in
  if typed-filled(db) == 2 then
    if resolved-filled(db) == 0 then unit else trap("resolved still 0")
  else
    trap("2 type facts memoized")

@test
def db-fill-is-a-raw-overwrite-not-fill-once() =
  // TRUTHFUL-BEHAVIOR pin (the doc claimed "fill-once, monotone" — corrected): the low-level `fill-typed` is
  // a plain Map.insert that OVERWRITES a filled slot (fill @0 = TBool, then fill @0 = Int64 → the slot is now
  // Int64, count stays 1). The FILL-ONCE discipline is NOT here — it lives in the demand producer, which
  // guards on require-* (see db-demand's dd-hit-does-not-recompute-poison). Pins the real contract: callers
  // MUST route through a demand-* producer, never call fill-* on a slot they haven't required Absent.
  let db1 = fill-typed(sample-db(), 0, Typed.TBool) in
  let db2 = fill-typed(db1, 0, Typed.TIntW(true, 64)) in
  match require-typed(db2, 0) with
    | Option.Some(Typed.TIntW(s, w)) => (if s and w == 64 then
      if typed-filled(db2) == 1 then unit else trap("overwrite keeps count 1, not 2")
    else
      trap("overwritten to Int64"))
    | _ => trap("fill-typed OVERWROTE @0 to Int64 (raw insert, not fill-once)")

export {
  Db.*,
  db-of,
  db-tree,
  fill-resolved,
  require-resolved,
  fill-typed,
  require-typed,
  fill-core,
  require-core,
  resolved-filled,
  typed-filled,
  core-filled
}
