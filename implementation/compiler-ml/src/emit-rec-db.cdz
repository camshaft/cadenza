/// emit-rec-db.cdz — Slice B' part 4b-ii: the RECURSIVE-MODULE ASSEMBLER, split out of emit-db.cdz. emit-db
/// emits a single-function (`main`) wasm module; THIS file assembles a MULTI-FUNCTION module — a wasm function
/// per self-recursive def (fac) plus `main` calling them — so a recursive program runs as EMITTED wasm
/// (`cdz-run` fac → 120), not just via the eval interpreter.
///
/// SPLIT RATIONALE: emit-db reached ~112 defs, at which point adding this assembly (~16 more defs) tipped its
/// `cdz test` component build over a HOST codegen size threshold (invalid component / wasm function[58]; see
/// queue/mlrepro-emit-db-size-threshold-invalid-component-function58.md — filed to corpus-bugfix). Same idiom
/// as the sread-eval split: keep each file under the per-module ceiling. This file IMPORTS
/// emit-db's byte primitives (functype-bytes, *-section-multi, emit-def-body-d, defenv-funcidx-map,
/// export-section-idx, preamble) and holds only the recursion-specific assembly + `emit-rec-src` entry.
///
/// funcidx layout: the self-recursive defs take funcidxs 0..k-1 (defenv-funcidx-map, by def-env order); `main`
/// is LAST (idx k); the export names main = k. Each func uses its own type (typeidx = funcidx). A CCall in any
/// body resolves its callee via the funcidx map → a real `call <idx>`. eval-core-d stays the differential oracle.
import { Core, lower-tree, lower-def-env } from "lower-db"

import { read-source } from "sread"

import { Value, eval-core-d } from "eval-db"

import { Tree } from "parse-db"

import {
  functype-bytes,
  type-section-multi,
  func-section-multi,
  code-section-multi,
  emit-def-body-d,
  defenv-funcidx-map,
  export-section-idx,
  preamble,
  emit-src-bytes,
  bytes-to-list,
  is-arith-op,
  is-cmp-op,
  has-ctor,
  has-fnref,
  section,
  b1,
  uleb,
  uleb-each,
  memory-section,
  global-section
} from "emit-db"

/// Is `c` in the emit subset GIVEN a def-index map? Like emit-db's `can-emit` but a `CCall` is ALLOWED when its
/// callee is in `defidx` (an emitted recursive def) — so a recursive program (fac) can emit; a CCall to a name
/// NOT in the map (an unknown/undefined callee) declines. NOTE: mutually-recursive defs (ev/od) are now IN the
/// def-env (build-def-env includes them), so they get funcidxs (defenv-funcidx-map maps ALL entries before any
/// body emits, so cross-calls resolve) and a mutual module emits — no longer a decline. Scalar Bool.
def can-emit-d(c: Core, defidx: Map(Int64, Int64)) = match c with
  | Core.CNum(_, _, _) => true
  | Core.CVar(_) => true
  | Core.CBin(op, _, _, l, r) =>
    (is-arith-op(op) or is-cmp-op(op)) and can-emit-d(l, defidx) and can-emit-d(r, defidx)
  | Core.CLet(_, v, body) => can-emit-d(v, defidx) and can-emit-d(body, defidx)
  | Core.CIf(cond, thn, els) =>
    can-emit-d(cond, defidx) and can-emit-d(thn, defidx) and can-emit-d(els, defidx)
  | Core.CCall(name, args) =>
    (match Map.lookup(defidx, name) with
      | Option.Some(_) => can-call-args(args, 0, defidx)
      | Option.None(_) => false
    )
  // W-enum: an ENUM-DISC bare-tag match emits (emit-db's emit-instrs-d handles CMatchEnum as a tag-equality
  // if/else). Emittable iff scrutinee + both branches are (nested N-arm enum match = nested CMatchEnum in els).
  | Core.CMatchEnum(scrut, _, thn, els) =>
    can-emit-d(scrut, defidx) and (can-emit-d(thn, defidx) and can-emit-d(els, defidx))
  // W-compound: a tuple/record CCtor (bump-alloc heap block) + CProj (heap load) emit in the recursive path too
  // (emit-db's emit-instrs-d handles both; emit-recursive-module adds the memory + bump-ptr global; each body
  // gets its i32 scratch via body-of-scratch). CCtor args must be FLAT + emittable (nested clobbers the scratch).
  | Core.CCtor(_, args) => ctor-args-emittable-d(args, 0, defidx)
  | Core.CProj(operand, _) => can-emit-d(operand, defidx)
  // W-compound: a payload-sum deconstruct emits (emit-instrs-d handles CMatchSum: load tag + bind payloads off
  // the heap). Emittable iff scrutinee + both branches are (nested N-arm match = nested CMatchSum in else).
  | Core.CMatchSum(scrut, _, _, thn, els) =>
    can-emit-d(scrut, defidx) and (can-emit-d(thn, defidx) and can-emit-d(els, defidx))
  // W-HO: a def-name-as-fn-value `CFnRef(name)` emits `i64.const funcidx` (funcidx from defidx) — emittable iff
  // the name is a known recursive def (it MUST be in the table for call_indirect). A `CFnRefVar(fBinder, args)`
  // apply emits `<args> ; local.get fBinder ; i32.wrap_i64 ; call_indirect <typeidx> 0` — emittable iff the args
  // are (fBinder is a local holding a funcidx, always fine). emit-recursive-module adds the table+elem sections
  // + the HO-arity functypes when any body carries a CFnRef/CFnRefVar.
  | Core.CFnRef(name) =>
    (match Map.lookup(defidx, name) with
      | Option.Some(_) => true
      | Option.None(_) => false
    )
  | Core.CFnRefVar(_, args) => can-call-args(args, 0, defidx)

/// W-compound (recursive path): are a CCtor's payload args each EMITTABLE (can-emit-d) and FLAT (no nested
/// CCtor — a single i32 scratch holds the alloc base, so a nested ctor arg would clobber it mid-store)? The
/// def-index-aware twin of emit-db's `ctor-args-emittable`. Index recursion; part of can-emit-d's SCC.
def ctor-args-emittable-d(args: List(Core), i: Int64, defidx: Map(Int64, Int64)) =
  if i == List.len(args) then
    true
  else
    match List.at(args, i) with
      // NESTED compounds now emit (depth-distinct scratch in emit-instrs-d) — a CCtor arg no longer clobbers.
      | Option.Some(a) =>
        if can-emit-d(a, defidx) then ctor-args-emittable-d(args, i + 1, defidx) else false
      | Option.None(_) => false

/// Are all a CCall's arg terms in the emit subset (under `defidx`)? Index recursion.
def can-call-args(args: List(Core), i: Int64, defidx: Map(Int64, Int64)) =
  if i == List.len(args) then
    true
  else
    match List.at(args, i) with
      | Option.Some(a) =>
        if can-emit-d(a, defidx) then can-call-args(args, i + 1, defidx) else false
      | Option.None(_) => false

// in-bounds i so unreachable; but for an emit-subset predicate a missing arg = NOT emittable (decline), never an optimistic pass
/// Is EVERY def-env entry's BODY in the emit subset (under `fmap`)? `emit-recursive-module` must gate on this,
/// not just main: `recursive-bodies` emits each def body via `emit-def-body-d` unconditionally, so a def whose
/// body holds an out-of-subset form (e.g. a CMatchSum/CCtor, eval-only) would otherwise emit a malformed body
/// instead of the module cleanly declining to `None`. Index recursion over the entries; `true` iff all bodies
/// pass `can-emit-d`. (main is checked separately at the call site.)
def all-defs-emittable(entries: List(Tuple(Int64, Tuple(List(Int64), Core))), i: Int64, fmap: Map(
  Int64,
  Int64
)) =
  if i == List.len(entries) then
    true
  else
    match List.at(entries, i) with
      | Option.Some(e) =>
        let (_, pb) = e in
        let (_, body) = pb in
        if can-emit-d(body, fmap) then all-defs-emittable(entries, i + 1, fmap) else false
      | Option.None(_) => false

// in-bounds i so unreachable; but this GATES emit-vs-decline — a missing entry = NOT emittable (safe default), never an optimistic pass
/// The TYPE-SECTION functypes for a recursive module — `functype-bytes(len params)` per def-env entry (in
/// order), then `functype-bytes(0)` for the nullary main. Position = typeidx.
def recursive-types(entries: List(Tuple(Int64, Tuple(List(Int64), Core)))) =
  List.push(recursive-types-go(entries, 0, [] : List(Bytes)), functype-bytes(0))

def recursive-types-go(entries: List(Tuple(Int64, Tuple(List(Int64), Core))), i: Int64, acc: List(
  Bytes
)) =
  if i == List.len(entries) then
    acc
  else
    match List.at(entries, i) with
      | Option.Some(e) =>
        let (_, pb) = e in
        let (params, _) = pb in
        recursive-types-go(entries, i + 1, List.push(acc, functype-bytes(List.len(params))))
      | Option.None(_) => acc

/// The CODE bodies for a recursive module — `emit-def-body-d(params, body, fmap)` per def-env entry (in order),
/// then the main body `emit-def-body-d([], mainCore, fmap)`. `fmap` = name→funcidx so a body's CCall emits a call.
def recursive-bodies(entries: List(Tuple(Int64, Tuple(List(Int64), Core))), mainCore: Core, fmap: Map(
  Int64,
  Int64
)) =
  List.push(
    recursive-bodies-go(entries, 0, fmap, [] : List(Bytes)),
    emit-def-body-d([] : List(Int64), mainCore, fmap)
  )

def recursive-bodies-go(entries: List(Tuple(Int64, Tuple(List(Int64), Core))), i: Int64, fmap: Map(
  Int64,
  Int64
), acc: List(Bytes)) =
  if i == List.len(entries) then
    acc
  else
    match List.at(entries, i) with
      | Option.Some(e) =>
        let (_, pb) = e in
        let (params, body) = pb in
        recursive-bodies-go(
          entries,
          i + 1,
          fmap,
          List.push(acc, emit-def-body-d(params, body, fmap))
        )
      | Option.None(_) => acc

/// The integer list [0,1,…,n] — the typeidx-per-func vector for func-section-multi (func i uses type i; k+1
/// funcs for k defs + main).
def range-list(n: Int64) = range-list-go(0, n, [] : List(Int64))

def range-list-go(i: Int64, n: Int64, acc: List(Int64)) =
  if i > n then acc else range-list-go(i + 1, n, List.push(acc, i))

/// Rebuild the eval def-env Map(name→(params,body)) from the entry list — the inverse of Map.to-list, for
/// eval-core-d's lookup (the differential oracle).
def entries-to-defs(entries: List(Tuple(Int64, Tuple(List(Int64), Core)))) =
  entries-to-defs-go(entries, 0, Map.empty : Map(Int64, Tuple(List(Int64), Core)))

def entries-to-defs-go(entries: List(Tuple(Int64, Tuple(List(Int64), Core))), i: Int64, acc: Map(
  Int64,
  Tuple(List(Int64), Core)
)) =
  if i == List.len(entries) then
    acc
  else
    match List.at(entries, i) with
      | Option.Some(e) =>
        let (name, pb) = e in
        entries-to-defs-go(entries, i + 1, Map.insert(acc, name, pb))
      | Option.None(_) => acc

/// Does the recursive program interpret to a value? Runs main via eval-core-d under the eval def-env — the SAME
/// oracle as run-of-db, so emit declines exactly what eval declines.
def has-value-d(mainCore: Core, entries: List(Tuple(Int64, Tuple(List(Int64), Core)))) = match eval-core-d(
    mainCore,
    Map.empty : Map(Int64, Value),
    entries-to-defs(entries)
  ) with
  | Option.Some(_) => true
  | Option.None(_) => false

/// ASSEMBLE a recursive wasm module from `mainCore` + the tree's self-recursive def-env. funcidx layout: defs
/// 0..k-1, main = k; export names main. `Some(bytes)` if main + every def body is in the emit subset (can-emit-d
/// under the funcidx map) AND main interprets to a value; else `None`.
def emit-recursive-module(mainCore: Core, tree: Tree) =
  let entries = Map.to-list(lower-def-env(tree)) in
  let k = List.len(entries) in
  let fmap = defenv-funcidx-map(entries) in
  if can-emit-d(mainCore, fmap) and all-defs-emittable(entries, 0, fmap)
      and has-value-d(mainCore, entries) then
    let hasho = any-body-has-fnref(entries, mainCore) in
    let mem = if any-body-has-ctor(entries, mainCore) then
        Bytes.concat(memory-section(), global-section())
      else
        Bytes.of([]) in
    let table = if hasho then table-section(k) else Bytes.of([]) in
    let elem = if hasho then elem-section(k) else Bytes.of([]) in
    let types = if hasho then
        List.concat(recursive-types(entries), ho-functypes())
      else
        recursive-types(entries) in
    // W-compound: memory + bump-ptr global when any body builds/reads a compound. W-HO: funcref table +
    // identity elem + HO-arity functypes when any body carries a fn-value. Section order (ascending id,
    // elem before code): type(1) func(3) TABLE(4) MEM(5) GLOBAL(6) export(7) ELEM(9) code(10).
    Option.Some(
      Bytes.concat(
        preamble(),
        Bytes.concat(
          type-section-multi(types),
          Bytes.concat(
            func-section-multi(range-list(k)),
            Bytes.concat(
              table,
              Bytes.concat(
                mem,
                Bytes.concat(
                  export-section-idx(k),
                  Bytes.concat(elem, code-section-multi(recursive-bodies(entries, mainCore, fmap)))
                )
              )
            )
          )
        )
      )
    )
  else
    Option.None(unit)

/// W-compound: does the recursive module need the linear-memory heap (does main OR any def body construct/read
/// a compound)? Gates the module-wide memory + bump-ptr global. Index recursion over the def-env entry bodies.
def any-body-has-ctor(entries: List(Tuple(Int64, Tuple(List(Int64), Core))), mainCore: Core) =
  if has-ctor(mainCore) then true else any-body-has-ctor-go(entries, 0)

def any-body-has-ctor-go(entries: List(Tuple(Int64, Tuple(List(Int64), Core))), i: Int64) =
  if i == List.len(entries) then
    false
  else
    match List.at(entries, i) with
      | Option.Some(e) =>
        let (_, pb) = e in
        let (_, body) = pb in
        if has-ctor(body) then true else any-body-has-ctor-go(entries, i + 1)
      | Option.None(_) => false

/// W-HO: does main OR any def body carry a fn-value (CFnRef/CFnRefVar)? Gates the funcref TABLE + ELEM sections
/// + the appended HO-arity functypes (call_indirect needs a table + a matching functype). Mirrors any-body-has-ctor.
def any-body-has-fnref(entries: List(Tuple(Int64, Tuple(List(Int64), Core))), mainCore: Core) =
  if has-fnref(mainCore) then true else any-body-has-fnref-go(entries, 0)

def any-body-has-fnref-go(entries: List(Tuple(Int64, Tuple(List(Int64), Core))), i: Int64) =
  if i == List.len(entries) then
    false
  else
    match List.at(entries, i) with
      | Option.Some(e) =>
        let (_, pb) = e in
        let (_, body) = pb in
        if has-fnref(body) then true else any-body-has-fnref-go(entries, i + 1)
      | Option.None(_) => false

/// W-HO: the funcref TABLE section (id 4) sized to hold every def funcidx (0..k-1): 1 table, elemtype funcref
/// (0x70), limits flag 0x00 + min k. call_indirect dispatches through table 0.
def table-section(k: Int64) =
  section(4, Bytes.concat(b1(1), Bytes.concat(b1(112), Bytes.concat(b1(0), uleb(k)))))

/// W-HO: the ELEM section (id 9) — one ACTIVE segment into table 0 at offset 0, an IDENTITY map table[i]=funcidx i
/// for i in 0..k-1 (so a CFnRef's i64 funcidx doubles as the call_indirect table index). flag 0x00, offset expr
/// `i32.const 0` (0x41 0x00) end (0x0b), count k, then funcidxs 0..k-1.
def elem-section(k: Int64) =
  section(
    9,
    Bytes.concat(
      b1(1),
      Bytes.concat(
        b1(0),
        Bytes.concat(
          b1(65),
          Bytes.concat(
            b1(0),
            Bytes.concat(b1(11), Bytes.concat(uleb(k), uleb-each(range-list-excl(k))))
          )
        )
      )
    )
  )

/// [0,1,…,k-1] — the funcidx vector for the elem identity map (range-list is [0..n] inclusive → pass k-1).
def range-list-excl(k: Int64) = range-list-go(0, k - 1, [] : List(Int64))

/// W-HO: functype-bytes(1..4) appended AFTER main (typeidx k) so call_indirect's typeidx = Map.len(defidx)+arity
/// (arity 1..4) resolves to a matching (arity i64 → i64) functype. Emitted only when the module has a fn-value.
def ho-functypes() =
  List.push(
    List.push(
      List.push(List.push([] : List(Bytes), functype-bytes(1)), functype-bytes(2)),
      functype-bytes(3)
    ),
    functype-bytes(4)
  )

/// SOURCE → recursive wasm module. read → lower main Core → assemble the multi-function module. `Some(bytes)` =
/// a runnable module exporting `main` (which calls the emitted recursive defs); `None` = ill-typed / out-of-subset
/// / declines. The recursive companion to emit-db's `emit-src` (which is single-main only).
def emit-rec-src(s: String) =
  let (root, tree) = read-source(s) in
  match lower-tree(tree, root) with
    | Option.Some(core) => emit-recursive-module(core, tree)
    | Option.None(_) => Option.None(unit)

/// slice-B'(Bp5): the UNIFIED source→byte-list entry the W4 `cdz run-emitted` harness calls (v-cdz-tooling
/// flips its driver import from emit-db to emit-rec-db, one line; the driver names `emit-any-src-bytes`).
/// AUTO-ROUTES: a program whose tree has a self-recursive def-env → the RECURSIVE assembler
/// (`emit-recursive-module`, a wasm fn per def + main); an ordinary single-main program → emit-db's single-main
/// `emit-src-bytes` UNCHANGED (byte-identical, so existing single-main differentials do not shift). Returns
/// `Option(List(UInt8))` — `None` = declined (ill-typed / out-of-subset), NEVER a trap, so run-emitted's
/// declined-vs-error contract holds. Verdict semantics match emit-db's emit-src-bytes exactly.
def emit-any-src-bytes(s: String) =
  let (root, tree) = read-source(s) in
  match lower-tree(tree, root) with
    | Option.Some(core) =>
      (if is-def-env-empty(lower-def-env(tree)) then
        emit-src-bytes(s) // no recursive defs → emit-db single-main (imported), byte-identical
      else
        match emit-recursive-module(core, tree) with
          // recursive → the multi-fn assembler
          | Option.Some(b) => Option.Some(bytes-to-list(b))
          | Option.None(_) => Option.None(unit))
    | Option.None(_) => Option.None(unit)

// ill-typed → declined
/// Is a def-env Map empty (no self-recursive defs → single-main routing)?
def is-def-env-empty(m: Map(Int64, Tuple(List(Int64), Core))) = List.len(Map.to-list(m)) == 0

// NOTE: a gate test that calls `emit-rec-src` on a real program builds the WHOLE emit pipeline (read→lower→
// emit) into ONE wasm test-component, which exceeds the host component-build size threshold (invalid component
// / wasm function[N]; see queue/mlrepro-emit-db-size-threshold-...). So the fac→module end-to-end check is
// done via a HAND-BUILT Core + tree (below, dodging the whole-pipeline closure), and the runnable-artifact
// fac→120 is the W4 host-run differential (Bp5, run OUTSIDE cdz test). These @tests stay on the PURE helpers.
@test
def er-recursive-module-assembles-from-hand-core() =
  // emit-recursive-module over a HAND-BUILT single-def-env-shaped input is not directly callable (it reads the
  // tree's def-env), so pin the ASSEMBLY PARTS instead: recursive-types + range-list for a 1-def module.
  // 1 def (fac, 1 param) + main: types = [functype(1), functype(0)] (2 entries); range-list(1) = [0,1].
  let entries = List.push(
      [] : List(Tuple(Int64, Tuple(List(Int64), Core))),
      (900, (List.push([], 7), Core.CNum(1, true, 64)))
    ) in
  let types = recursive-types(entries) in
  if List.len(types) == 2 then
    // fac-type + main-type
    if List.len(range-list(1)) == 2 then unit else trap("range-list(1) = [0,1]")
  else
    trap("2 functypes for 1 def + main")

@test
def er-can-emit-d-allows-known-ccall() =
  // a CCall whose callee IS in the def-index map is emittable; an unknown callee declines.
  let de = Map.insert(Map.empty : Map(Int64, Int64), 900, 0) in
  if can-emit-d(Core.CCall(900, [] : List(Core)), de) then
    if can-emit-d(Core.CCall(901, [] : List(Core)), de) then
      trap("unknown callee should decline")
    else
      unit
  else
    trap("known callee should be emittable")

@test
def er-can-emit-d-allows-compound-construct-project() =
  // W-compound (recursive/do-def path): a FLAT tuple CCtor + CProj is emittable via can-emit-d. A NESTED ctor
  // arg is NOW emittable too (depth-distinct scratch + bump-early). Direct-Core: CProj(CCtor(0,[10,20]), 1)
  // emits; CCtor(0,[CCtor(0,[1]),3]) (nested) also emits.
  let de = Map.empty : Map(Int64, Int64) in
  if can-emit-d(
      Core.CProj(
        Core.CCtor(
          0,
          List.concat(
            List.push([], Core.CNum(10, true, 64)),
            List.push([], Core.CNum(20, true, 64))
          )
        ),
        1
      ),
      de
    ) then
    if can-emit-d(
        Core.CCtor(
          0,
          List.concat(
            List.push([], Core.CCtor(0, List.push([], Core.CNum(1, true, 64)))),
            List.push([], Core.CNum(3, true, 64))
          )
        ),
        de
      ) then
      unit
    else
      trap("a nested compound ctor arg must now be emittable (depth-scratch + bump-early)")
  else
    trap("a flat tuple construct+project must be emittable in the recursive path")

@test
def er-nonrecursive-not-in-defenv-declines-ccall() =
  // sanity: can-emit-d on a plain arith is fine (no CCall).
  if can-emit-d(
      Core.CBin(43, true, 64, Core.CNum(1, true, 64), Core.CNum(2, true, 64)),
      Map.empty : Map(Int64, Int64)
    ) then
    unit
  else
    trap("arith emits under empty def-env")

@test
def er-recursive-types-puts-main-last() =
  // The TYPEIDX ORDERING invariant — a property of THIS assembler's encoding, not a general wasm rule. wasm
  // sets a function's type via the FUNCTION SECTION's declared type index; here we emit
  // func-section-multi(range-list(k)) = function i declares typeidx i, so `recursive-types` MUST list functypes
  // in that same order (defs 0..k-1, main = k) for each function's declared type to be the right one.
  // recursive-types satisfies it by appending main's functype (nullary, functype-bytes(0)) LAST, matching
  // main's funcidx k. A peer reordering this type list (e.g. main first) would make function i declare the
  // WRONG typeidx (a validation / signature mismatch), NOT a wrong export (the export names a FUNCTION index,
  // independent of type order). This pins main-is-last structurally. For a 1-def entry (fac, 1 param): types =
  // [functype-bytes(1), functype-bytes(0)] — index 0 is the 1-param def (5 bytes: 60 01 7e 01 7e), the LAST is
  // nullary main (4 bytes: 60 00 01 7e). Discriminate by Bytes.len.
  let entries = List.push(
      [] : List(Tuple(Int64, Tuple(List(Int64), Core))),
      (900, (List.push([], 7), Core.CNum(1, true, 64)))
    ) in
  let types = recursive-types(entries) in
  match List.at(types, List.len(types) - 1) with
    // the LAST functype must be main's (nullary, 4 bytes)
    | Option.Some(lastT) =>
      if Bytes.len(lastT) == 4 then
        match List.at(types, 0) with
          // index 0 must be the 1-param def's (5 bytes), NOT main's
          | Option.Some(firstT) =>
            if Bytes.len(firstT) == 5 then
              unit
            else
              trap("typeidx 0 is the 1-param def functype (5 bytes), not main")
          | Option.None(_) => trap("recursive-types has a first entry")
      else
        trap("LAST functype is nullary main (functype-bytes(0), 4 bytes)")
    | Option.None(_) => trap("recursive-types is non-empty")

@test
def er-recursive-bodies-puts-main-last() =
  // Main's code body is emitted LAST, so main = funcidx k and export-section-idx(k) names it (the FUNCTION-list
  // order — this is the order that actually governs the export).
  let entries = List.push(
      [] : List(Tuple(Int64, Tuple(List(Int64), Core))),
      (
        900,
        ([] : List(Int64), Core.CBin(43, true, 64, Core.CNum(1, true, 64), Core.CNum(2, true, 64)))
      )
    ) in
  let bodies = recursive-bodies(entries, Core.CNum(7, true, 64), Map.empty : Map(Int64, Int64)) in
  if List.len(bodies) == 2 then
    // 1 def body + main body
    match List.at(bodies, List.len(bodies) - 1) with
      // LAST body must be main's (nullary CNum 7 → 4 bytes: 00 42 07 0b)
      | Option.Some(lastB) =>
        if Bytes.len(lastB) == 4 then
          match List.at(bodies, 0) with
            // index 0 is the def's arith body (7 bytes), NOT main's
            | Option.Some(firstB) =>
              if Bytes.len(firstB) == 7 then
                unit
              else
                trap("funcidx 0 is the def's arith body (7 bytes), not main")
            | Option.None(_) => trap("recursive-bodies has a first entry")
        else
          trap("LAST body is nullary main (CNum 7 body, 4 bytes)")
      | Option.None(_) => trap("recursive-bodies is non-empty")
  else
    trap("recursive-bodies = 1 def + main = 2 bodies")

@test
def er-all-defs-emittable-gates-out-of-subset-body() =
  // The def-body emit gate: all-defs-emittable is TRUE iff EVERY entry's body is in the emit subset. A def
  // whose body is an out-of-subset form must make it FALSE so emit-recursive-module declines rather than
  // emitting a malformed body. Pins the gap emit-recursive-module's main-only gate previously missed. Uses
  // CFnRef (a higher-order fn-VALUE — still eval-only, NOT emit-subset) as the out-of-subset example. (Was
  // CMatchSum, which is now emittable — the W-compound arc; a CMatchSum def body EMITS + runs correctly, so it
  // no longer gates OUT.) Two entries: one arith body (emittable), one CFnRef body (not).
  let fmap = Map.empty : Map(Int64, Int64) in
  let arithBody = Core.CBin(43, true, 64, Core.CNum(1, true, 64), Core.CNum(2, true, 64)) in
  let hoBody = Core.CFnRef(900) in
  let okEntries = List.push(
      [] : List(Tuple(Int64, Tuple(List(Int64), Core))),
      (900, ([] : List(Int64), arithBody))
    ) in
  let badEntries = List.push(okEntries, (901, ([] : List(Int64), hoBody))) in
  if all-defs-emittable(okEntries, 0, fmap) then
    if all-defs-emittable(badEntries, 0, fmap) then
      trap("a CFnRef (higher-order) def body is NOT emit-subset → all-defs-emittable must be false")
    else
      unit
  else
    trap("an arith def body IS emit-subset → all-defs-emittable true")

@test
def er-def-env-empty-detects-single-main() =
  // is-def-env-empty: an empty def-env (non-recursive program) → true (routes to single-main); non-empty → false.
  if is-def-env-empty(Map.empty : Map(Int64, Tuple(List(Int64), Core))) then
    if is-def-env-empty(
          Map.insert(
            Map.empty : Map(Int64, Tuple(List(Int64), Core)),
            900,
            ([], Core.CNum(0, true, 64))
          )
        ) == false then
      unit
    else
      trap("non-empty def-env → false")
  else
    trap("empty def-env → true")

export {
  emit-recursive-module,
  emit-rec-src,
  emit-any-src-bytes,
  is-def-env-empty,
  can-emit-d,
  recursive-types,
  recursive-bodies,
  range-list,
  entries-to-defs,
  has-value-d
}

@test
def er-can-emit-d-allows-fnref-and-fnrefvar() =
  // W-HO: a CFnRef to a KNOWN def is emittable (→ i64.const funcidx); to an unknown name it declines. A
  // CFnRefVar apply is emittable iff its args are (the fBinder is a local holding a funcidx).
  let de = Map.insert(Map.empty : Map(Int64, Int64), 900, 0) in
  if can-emit-d(Core.CFnRef(900), de) then
    if can-emit-d(Core.CFnRef(901), de) then
      trap("CFnRef to an unknown def must decline")
    else if can-emit-d(Core.CFnRefVar(5, List.push([], Core.CNum(41, true, 64))), de) then
      unit
    else
      trap("CFnRefVar with an emittable arg must be emittable")
  else
    trap("CFnRef to a known def must be emittable")

@test
def er-has-fnref-detects-ho() =
  // has-fnref finds a fn-value nested in a CLet; a plain arith has none.
  if has-fnref(Core.CLet(0, Core.CFnRef(900), Core.CNum(1, true, 64))) then
    if has-fnref(Core.CBin(43, true, 64, Core.CNum(1, true, 64), Core.CNum(2, true, 64))) then
      trap("plain arith has no fn-value")
    else
      unit
  else
    trap("has-fnref must find a CFnRef in a CLet value")

@test
def er-table-and-elem-section-bytes() =
  // W-HO section shapes for k=2 defs: TABLE(4) = `04 04 01 70 00 02` (6 bytes: id, len, 1 table, funcref 0x70,
  // limits flag 0 min 2); ELEM(9) = `09 08 01 00 41 00 0b 02 00 01` (10 bytes: id, len, 1 seg, flag 0, i32.const
  // 0, end, count 2, funcidx 0 1). Pin the lengths (encode the exact section framing).
  if Bytes.len(table-section(2)) == 6 then
    if Bytes.len(elem-section(2)) == 10 then unit else trap("elem-section(2) = 10 bytes")
  else
    trap("table-section(2) = 6 bytes")
