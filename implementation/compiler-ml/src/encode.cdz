/// encode.cdz — the INVERSE of `decode`: serialize a recursive `Ast` to a flat byte buffer at RUN TIME
/// (`Ast → Bytes`), then decode it back to prove the round-trip. Builds bytes with `Bytes.of` +
/// `Bytes.concat` over recursively-assembled fragments — a stage the port had not exercised (runtime
/// byte CONSTRUCTION, as opposed to `decode`'s byte READING).
///
/// Wire format (the same compact self-describing form `decode.cdz` reads): a node is a tag byte then its
/// payload — tag 0 Int (+ value byte), tag 1 Bool (+ 0/1), tag 2 Name (+ byte-count, then that many UTF-8
/// bytes), tag 4 Str (+ byte-count, then the bytes), tag 3 List (+ child count, then the children
/// back-to-back). Name/Str CONTENT now round-trips (`String.to-bytes` serializes it, `String.from-bytes`
/// reads it back — both runtime-string ops are now realized; the old content-less placeholder is gone).
/// `encode` then `build` is the identity on the whole tree — structure, every Int/Bool value, AND every
/// Name/Str string.
import { Ast } from "ast"

/// A one-byte Bytes holding the low 8 bits of `x` (`UInt8.wrap` truncates to a byte).
def b1(x: Int64) = Bytes.of([UInt8.wrap(x)])

/// A length-prefixed string payload: `[byte-count, ...utf8 bytes]`. The count is ONE byte, so the payload
/// is capped at 255 bytes — ample for a compiler symbol. That cap is now ENFORCED: a longer string TRAPS
/// rather than silently truncating its length via `UInt8.wrap` (which would corrupt the decode — the
/// decoder would read the wrong byte-count). Copilot PR #433.
def str-payload(s: String) =
  let len = String.byte-len(s) in
  if len > 255 then trap("codec: string payload exceeds the 255-byte length prefix")
  else Bytes.concat(b1(len), String.to-bytes(s))

/// Serialize `node` to its wire bytes.
def encode(node: Ast) = match node with
  | Ast.Int(v) => Bytes.concat(b1(0), b1(v))
  | Ast.Bool(bit) => Bytes.concat(b1(1), b1(if bit then 1 else 0))
  | Ast.Name(nm) => Bytes.concat(b1(2), str-payload(nm))
  | Ast.Str(s) => Bytes.concat(b1(4), str-payload(s))
  | Ast.List(kids) => Bytes.concat(Bytes.concat(b1(3), b1(List.len(kids))), encode-list(kids))

def encode-list(xs: List(Ast)) = match xs with
  | [] => Bytes.of([])
  | [h, .. t] => Bytes.concat(encode(h), encode-list(t))

// ---- decoder (mirrors decode.cdz; threads the cursor separately) ----

/// Read the string of a length-prefixed payload at `pos` (byte `pos` is the count, then that many bytes).
def read-str(b: Bytes, pos: Int64) -> String =
  let count = Option.expect(Bytes.at(b, pos), "strlen") in
  match Bytes.slice(b, pos + 1, count) with
    | Option.Some(sub) => Option.expect(String.from-bytes(sub), "utf8")
    // An out-of-bounds slice means the buffer is malformed/truncated — TRAP rather than silently
    // returning "" (which would turn a partial buffer into a valid-looking empty Name/Str). Copilot PR #433.
    | Option.None(_) => trap("codec: string payload slice out of bounds (malformed buffer)")

def nsize(b: Bytes, pos: Int64) -> Int64 =
  let tag = Option.expect(Bytes.at(b, pos), "tag") in
  if tag == 3 then
    csize(b, pos + 2, Option.expect(Bytes.at(b, pos + 1), "count"), 2)
  else
    // Name (2) and Str (4) are length-prefixed: 1 tag + 1 count + count bytes. Int/Bool are 2 bytes.
    (if tag == 2 then 2 + Option.expect(Bytes.at(b, pos + 1), "strlen")
     else (if tag == 4 then 2 + Option.expect(Bytes.at(b, pos + 1), "strlen") else 2))

def csize(b: Bytes, pos: Int64, n: Int64, acc: Int64) -> Int64 =
  if n == 0 then acc else (let s = nsize(b, pos) in csize(b, pos + s, n - 1, acc + s))

def build(b: Bytes, pos: Int64) -> Ast =
  let tag = Option.expect(Bytes.at(b, pos), "tag") in
  if tag == 0 then
    Ast.Int(Option.expect(Bytes.at(b, pos + 1), "int"))
  else
    (if tag == 1 then
      Ast.Bool(Option.expect(Bytes.at(b, pos + 1), "bool") == 1)
    else
      (if tag == 2 then Ast.Name(read-str(b, pos + 1))
       else (if tag == 4 then Ast.Str(read-str(b, pos + 1))
       else Ast.List(buildc(b, pos + 2, Option.expect(Bytes.at(b, pos + 1), "count"))))))

def buildc(b: Bytes, pos: Int64, n: Int64) -> List(Ast) =
  if n == 0 then [] else List.concat([build(b, pos)], buildc(b, pos + nsize(b, pos), n - 1))

/// Round-trip: encode `a`, then decode the bytes back to an `Ast`.
def round-trip(a: Ast) -> Ast = build(encode(a), 0)

// ---- structural probes over the round-tripped tree ----

def node-count(a: Ast) -> Int64 = match a with
  | Ast.List(es) => 1 + node-count-list(es)
  | _ => 1

def node-count-list(xs: List(Ast)) -> Int64 = match xs with
  | [] => 0
  | [h, .. t] => node-count(h) + node-count-list(t)

def int-sum(a: Ast) -> Int64 = match a with
  | Ast.Int(v) => v
  | Ast.List(es) => int-sum-list(es)
  | _ => 0

def int-sum-list(xs: List(Ast)) -> Int64 = match xs with
  | [] => 0
  | [h, .. t] => int-sum(h) + int-sum-list(t)

def top-is-int(a: Ast, v: Int64) -> Bool = match a with
  | Ast.Int(x) => x == v
  | _ => false

def top-is-bool(a: Ast, v: Bool) -> Bool = match a with
  | Ast.Bool(x) => x == v
  | _ => false

def top-len(a: Ast) -> Int64 = match a with
  | Ast.List(es) => List.len(es)
  | _ => 0 - 1

def top-name(a: Ast) -> String = match a with | Ast.Name(nm) => nm | _ => ""
def top-str(a: Ast) -> String = match a with | Ast.Str(s) => s | _ => ""

@test
def encode-len-int() =
  // Int → [tag 0, value] = 2 bytes
  if Bytes.len(encode(Ast.Int(42))) == 2 then unit else trap("int encodes to 2 bytes")

@test
def encode-len-flat-list() =
  // (Int Int) → [3, 2, 0,5, 0,7] = 6 bytes
  if Bytes.len(encode(Ast.List([Ast.Int(5), Ast.Int(7)]))) == 6 then unit else trap("flat list 6 bytes")

@test
def roundtrip-int-value() =
  if top-is-int(round-trip(Ast.Int(99)), 99) then unit else trap("Int 99 survives")

@test
def roundtrip-bool() =
  if top-is-bool(round-trip(Ast.Bool(true)), true) then unit else trap("Bool true survives")

@test
def roundtrip-flat-list-len() =
  if top-len(round-trip(Ast.List([Ast.Int(1), Ast.Bool(false), Ast.Name("x")]))) == 3 then
    unit
  else
    trap("flat list len 3 survives")

@test
def roundtrip-node-count() =
  let tree = Ast.List([Ast.Int(5), Ast.List([Ast.Int(7), Ast.Name("f")]), Ast.Int(9)]) in
  if node-count(round-trip(tree)) == node-count(tree) then unit else trap("node count preserved")

@test
def roundtrip-int-sum() =
  let tree = Ast.List([Ast.Int(5), Ast.List([Ast.Int(7), Ast.Bool(true)]), Ast.Int(30)]) in
  if int-sum(round-trip(tree)) == 42 then unit else trap("int sum 42 preserved")

@test
def roundtrip-deep-nesting() =
  // ((( Int 9 ))) — 3 list levels
  let tree = Ast.List([Ast.List([Ast.List([Ast.Int(9)])])]) in
  if node-count(round-trip(tree)) == 4 then
    (if int-sum(round-trip(tree)) == 9 then unit else trap("deep sum 9"))
  else
    trap("deep count 4")

@test
def roundtrip-empty-list() =
  if top-len(round-trip(Ast.List([]))) == 0 then unit else trap("empty list survives")

@test
def encode-empty-list-len() =
  // empty List → [3, 0] = 2 bytes
  if Bytes.len(encode(Ast.List([]))) == 2 then unit else trap("empty list encodes to 2 bytes")

@test
def encode-name-len() =
  // Name "hi" → [tag 2, count 2, 'h', 'i'] = 4 bytes.
  if Bytes.len(encode(Ast.Name("hi"))) == 4 then unit else trap("Name hi is 4 bytes")

@test
def roundtrip-name-content() =
  // The Name STRING now survives encode→decode (was a content-less placeholder).
  if top-name(round-trip(Ast.Name("foo"))) == "foo" then unit else trap("Name content foo round-trips")

@test
def roundtrip-str-content() =
  if top-str(round-trip(Ast.Str("hello world"))) == "hello world" then unit else trap("Str content round-trips")

@test
def roundtrip-empty-name() =
  // An empty Name → [2, 0] = 2 bytes, decodes back to "".
  if top-name(round-trip(Ast.Name(""))) == "" then unit else trap("empty Name round-trips")

@test
def roundtrip-names-in-list() =
  // Names nested in a list keep content AND structure: (Name "a", (Name "bb"), Int 7).
  let tree = Ast.List([Ast.Name("a"), Ast.List([Ast.Name("bb")]), Ast.Int(7)]) in
  let rt = round-trip(tree) in
  if node-count(rt) == node-count(tree) then
    (if int-sum(rt) == 7 then
      (match rt with
        | Ast.List(es) => (match List.at(es, 0) with
          | Option.Some(first) => (if top-name(first) == "a" then unit else trap("first Name is a"))
          | Option.None(_) => trap("has a first element"))
        | _ => trap("round-trips to a list"))
    else trap("int 7 survives"))
  else
    trap("structure preserved with named leaves")

@test
def roundtrip-multibyte-name() =
  // A longer identifier round-trips — exercises the length prefix + slice at size.
  if top-name(round-trip(Ast.Name("identifier_x"))) == "identifier_x" then unit else trap("long name round-trips")

@test
def roundtrip-long-string-under-cap() =
  // A well-under-cap multi-byte payload round-trips exactly, exercising the GUARDED str-payload
  // (byte-len <= 255) on the valid side. The >255 trap and the OOB-slice trap (Copilot PR #433) harden
  // the failure paths; this pins that hardening did not disturb an ordinary long string.
  let s = String.concat(String.concat("the quick brown fox ", "jumps over the lazy dog "), "0123456789") in
  if top-str(round-trip(Ast.Str(s))) == s then unit else trap("a long (under-cap) string round-trips exactly")

export { encode, round-trip }
