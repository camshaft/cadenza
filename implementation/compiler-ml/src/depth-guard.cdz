/// depth-guard.cdz — a well-formedness pass that rejects an `Ast` nested deeper than a limit, returning
/// `Result Int64 String`: `Ok(max-depth)` when the whole tree is within `limit`, or `Err(msg)` the moment
/// a node exceeds it. This is the recursion-limit / stack-safety guard a real compiler runs before a
/// deep pass. It stresses a `Result` THREADED through recursion with EARLY-RETURN on `Err` (a child's
/// failure short-circuits the sibling walk) — the fallible-fold shape.
type Ast =
  | Leaf(Int64)
  | Node(List(Ast))

/// `Ok(deepest reached)` if the subtree at depth `cur` stays within `limit`, else `Err`.
def check(node: Ast, cur: Int64, limit: Int64) =
  if cur > limit then
    Result.Err("too deep")
  else
    (match node with
      | Ast.Leaf(_) => Result.Ok(cur)
      | Ast.Node(kids) => check-list(kids, cur + 1, limit, cur))

/// Check each child; short-circuit on the first `Err`; else `Ok` of the deepest depth seen.
def check-list(xs: List(Ast), cur: Int64, limit: Int64, acc: Int64) = match xs with
  | [] => Result.Ok(acc)
  | [h, .. t] => (match check(h, cur, limit) with
    | Result.Ok(d) => check-list(t, cur, limit, if d > acc then d else acc)
    | Result.Err(m) => Result.Err(m))

/// Top-level: is `node` within `limit` (starting depth 0)?
def within(node: Ast, limit: Int64) = match check(node, 0, limit) with
  | Result.Ok(_) => true
  | Result.Err(_) => false

/// The tree's max depth, or -1 if it exceeds `limit` (a large limit gives the true depth).
def max-depth(node: Ast, limit: Int64) = match check(node, 0, limit) with
  | Result.Ok(d) => d
  | Result.Err(_) => 0 - 1

@test
def guard-leaf-within() = if within(Ast.Leaf(5), 3) then unit else trap("a leaf is depth 0")

@test
def guard-leaf-depth() = if max-depth(Ast.Leaf(5), 9) == 0 then unit else trap("leaf depth 0")

@test
def guard-flat-node() =
  // Node[Leaf, Leaf] → depth 1
  if max-depth(Ast.Node([Ast.Leaf(1), Ast.Leaf(2)]), 9) == 1 then unit else trap("flat node depth 1")

@test
def guard-nested-depth() =
  // Node[Node[Node[Leaf]]] → depth 3
  let t = Ast.Node([Ast.Node([Ast.Node([Ast.Leaf(5)])])]) in
  if max-depth(t, 9) == 3 then unit else trap("depth 3")

@test
def guard-within-limit() =
  let t = Ast.Node([Ast.Node([Ast.Node([Ast.Leaf(5)])])]) in
  if within(t, 3) then unit else trap("depth 3 within limit 3")

@test
def guard-exceeds-limit() =
  // depth 3 with limit 2 → rejected
  let t = Ast.Node([Ast.Node([Ast.Node([Ast.Leaf(5)])])]) in
  if within(t, 2) then trap("depth 3 exceeds limit 2") else unit

@test
def guard-widest-branch-decides() =
  // Node[ Leaf, Node[Node[Leaf]] ] → the deep branch (depth 3) decides, not the shallow leaf
  let t = Ast.Node([Ast.Leaf(1), Ast.Node([Ast.Node([Ast.Leaf(2)])])]) in
  if max-depth(t, 9) == 3 then unit else trap("widest branch depth 3")

@test
def guard-short-circuits-on-deep-first-child() =
  // a too-deep FIRST child rejects the whole tree regardless of later siblings
  let deep = Ast.Node([Ast.Node([Ast.Node([Ast.Leaf(0)])])]) in
  let t = Ast.Node([deep, Ast.Leaf(9)]) in
  if within(t, 2) then trap("deep first child → reject") else unit

@test
def guard-empty-node() =
  // Node[] → depth 0: the walk seeds the accumulator at the node's own depth (0) and has no children to
  // deepen it, so an empty node reports the same depth as a leaf (no nested content).
  if max-depth(Ast.Node([]), 9) == 0 then unit else trap("empty node depth 0")

export { check, within, max-depth }
