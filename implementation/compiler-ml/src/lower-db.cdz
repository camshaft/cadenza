/// lower-db.cdz — Increment 4 of the Cadenza-in-Cadenza compiler: the LOWER (Core-IR) COLUMN. The third
/// derived query column, extending the demand chain to lower → infer → resolve → parse: it lowers the typed
/// parse arena into a small integer Core IR. Mirrors rcdzc's `Lower.core_of` reading `Infer.type_of`.
///
/// THE CORE IR is a pointer tree (not an arena) — small and directly walkable by the Inc-5 evaluator. Its
/// key move is CANONICALIZATION: a source `NVar(nameId)` lowers to `CVar(binderId)` where `binderId` is the
/// NodeId of the `NLet` that binds it (from the resolve column). So Core carries canonical UNIQUE names
/// (the binder's identity), not source name-ids — shadowing is already resolved, and the Inc-5 evaluator can
/// key its environment by binderId with no scope logic. A `NLet(nameId, …)` lowers to `CLet(letNodeId, …)`
/// keyed by ITS OWN NodeId, matching the `CVar(binderId)` its bound uses carry.
///
/// LOWERING IS GATED ON TYPING: `lower-tree` returns `Option(Core)` — `Some` for a well-typed tree, `None`
/// if any node is `TErr` (unbound name / ill-typed). Absence≠value once more: a type-erroneous program has
/// NO core form (a filled `None`), not a bogus tree. Lowering reads the infer column to make this decision,
/// and reads the resolve column to canonicalize vars — producer-reads-two-producers.

import { Tok, Node, Tree, node-at, parse-tokens, empty-tree, add-node, record-def, record-param, def-body-of, call-is-recursive, call-is-self-recursive, param-of, param2-of, param3-of, param4-of, arg2-of, arg3-of, arg4-of } from "parse-db"
import { Resolved, resolve-tree, resolve-node, param-scope } from "resolve-db"
import { Typed, infer-tree, infer-node } from "infer-db"

/// The integer Core IR. `CVar` carries the BINDER node-id (canonical unique name); `CLet` is keyed by its
/// own let-node-id. Op codes match the parser/token codes (43 +, 45 -, 42 *).
type Core =
  | CNum(Int64, Bool, Int64)       // CNum(value, signed, width) — a fixed-width int constant; (true,64)=Int64
  | CVar(Int64)                    // CVar(binderId) — canonical, resolved
  | CBin(Int64, Bool, Int64, Core, Core)  // CBin(op, signed, width, left, right) — width = the RESULT's
                                   // fixed-width int type; eval wraps a narrow result at 2^width, emit masks.
                                   // (true,64) = Int64 arith (no wrap). A comparison CBin is (true,64) too
                                   // (its result is a 0/1 Bool-as-i64, not a narrow int).
  | CLet(Int64, Core, Core)        // CLet(binderId, value, body)
  | CIf(Core, Core, Core)          // CIf(cond, then, else)
  | CCall(Int64, List(Core))       // CCall(calleeName, args) — a NON-INLINING call to a def BY NAME, args
                                   // already-lowered. Emitted ONLY for a RECURSIVE call (call-is-recursive is
                                   // true): inlining a cycle would loop forever, so a true cycle gets a real
                                   // call node instead. A self-CCall is a LEAF w.r.t. lowering (it does NOT
                                   // descend the callee body — that is lower-def-env's job, Slice B1b), which
                                   // is exactly what breaks the infinite inline. eval runs it via a name→body
                                   // def-env (B1b); NON-recursive calls still INLINE (no def-env needed).
                                   // Mirrors rcdzc's `Core::Call { callee, args }` (core.rs:1061) — recursion
                                   // as a STATIC code reference by name, never a heap cycle.
  | CFnRef(Int64)                  // HIGHER-ORDER (fn-value slice): a def-NAME used as a FIRST-CLASS VALUE (a
                                   // bare def-name in argument/value position, e.g. `inc` in `(apply inc 41)`).
                                   // Since top-level defs are closed (no free-var capture), a function value IS
                                   // just its name — eval returns Some(name); the CCallVar site dispatches it
                                   // through the same name→body def-env as CCall. Out of the emit subset (eval-
                                   // only slice; emit(B'') = a funcidx const + call_indirect, deferred).
  | CFnRefVar(Int64, List(Core))   // HIGHER-ORDER apply: call the fn-VALUE held in a binder (a fn-typed PARAM),
                                   // args already-lowered. `CFnRefVar(fBinderId, args)` = apply `env[fBinderId]`
                                   // (a def-name from a CFnRef) to args — `(f x)` where `f` is a parameter, not
                                   // a known def. eval looks up the binder's name value then does the SAME
                                   // defs-dispatch as CCall (shared apply-def). Out of emit subset (eval-only).
  | CCtor(Int64, List(Core))       // M2-b-2b USER SUM PAYLOAD ctor: `CCtor(tag, args)` = construct a sum value
                                   // with discriminant `tag` and already-lowered payload `args`. eval store-ALLOCs
                                   // (tag, arg-values) into the SumStore and returns the Int64 HANDLE (the sum
                                   // value). A NULLARY ctor still lowers to CNum(tag) (M2-a, the bare tag needs no
                                   // heap cell); CCtor is only for ctors WITH payloads. Out of emit subset (eval-
                                   // only; emit(B) = rcdzc's SumNew{disc,payloads}, deferred).
  | CMatchSum(Core, Int64, List(Int64), Core, Core)  // M2-b-2b sum DECONSTRUCT: `CMatchSum(scrut, tag, binders,
                                   // then, else)`. eval `scrut` to a handle, read its store-tag: if it EQUALS
                                   // `tag`, bind each payload element `store-payload(h, i)` to `binders[i]` in the
                                   // env and eval `then`; else eval `else` (the fall-through to the next arm).
                                   // A nested chain of CMatchSum = an N-arm sum match (like NMatch→CIf for ints).
                                   // Binders are canonical binder-ids (CVar keys), positional to the payload.

/// The canonical Int64 constant — the width the monomorphic-i64 pipeline lowers every literal to today (a
/// narrow-width annotation lowers to a NARROW CNum; emit reads the width). A single name so construct sites
/// don't repeat the `(true, 64)`.
def cnum64(v: Int64) = Core.CNum(v, true, 64)

/// Build a CBin, stamping its RESULT width from the node's type fact `t`: a `TIntW(s, w)` result → that
/// (s, w) (so a narrow-typed arith node carries its width for eval-wrap/emit-mask); anything else (TBool
/// comparison result, or absent) → the canonical (true, 64). Today arith is gated to Int64 in infer
/// (2b-ii-c), so this stamps (true,64) until the infer-relax slice types same-width narrow arith TIntW.
def cbin-of(op: Int64, t: Typed, l: Core, r: Core) = match t with
  // item-3 HM: a still-DEFERRED result type (the sentinel TIntW(_,0) — an all-literal arith that never met a
  // narrow constraint) GROUNDS to Int64 here, so no width-0 reaches Core (emit picks i32/i64 by width; a 0
  // would be invalid). A concrete narrow/64 width passes through. This is the deferred→ground boundary for a
  // top-level all-literal arith; a deferred operand that MET a narrow sibling already grounded in infer.
  | Typed.TIntW(s, w) => (if w == 0 then Core.CBin(op, true, 64, l, r) else Core.CBin(op, s, w, l, r))
  | _ => Core.CBin(op, true, 64, l, r)

/// Lower the subtree at `id`, reading the pre-built resolve column `rcol` (for var canonicalization) and
/// type column `tcol` (the well-typed gate). Returns `Option(Core)` — `None` if this node or any descendant
/// is ill-typed / unbound. Reading the two upstream columns (not recomputing) is the producer-reads-producer
/// contract.
def lower-node(tree: Tree, id: Int64, rcol: Map(Int64, Resolved), tcol: Map(Int64, Typed)) =
  // a node with any GROUND type (TInt or TBool) lowers; TErr (or a missing fact) has no core form. Bool is
  // represented in Core as an Int (0/1) — comparison `CBin`s evaluate to 0/1 — so the Core stays minimal and
  // uniform; the type column already proved the shape well-typed.
  (match Map.lookup(tcol, id) with
    | Option.Some(Typed.TIntW(_, _)) => lower-ok(tree, id, rcol, tcol)
    | Option.Some(Typed.TBool) => lower-ok(tree, id, rcol, tcol)
    // HIGHER-ORDER (HO-3): a node typed as a FUNCTION (TFn) also lowers — a def-name-as-value (→ CFnRef) or a
    // fn-param call `(f x)` (→ CFnRefVar). Without this the gate rejected fn-typed nodes → the CFnRef/CFnRefVar
    // wiring never fired (the `inc` arg / `(f x)` body declined). eval runs them via the def-env name dispatch.
    | Option.Some(Typed.TFn(_, _)) => lower-ok(tree, id, rcol, tcol)
    | _ => Option.None(unit))

/// The typed-node case: build the Core node, canonicalizing a var to its binder id via `rcol`.
def lower-ok(tree: Tree, id: Int64, rcol: Map(Int64, Resolved), tcol: Map(Int64, Typed)) =
  match node-at(tree, id) with
    | Option.Some(Node.NLit(v)) => Option.Some(cnum64(v))
    | Option.Some(Node.NBoolLit(b)) => Option.Some(cnum64(b))   // Bool is Int 0/1 in Core (i64)
    | Option.Some(Node.NAnnLit(v, sflag, w)) =>
        // a width-annotated literal lowers to a NARROW CNum carrying its (signed, width) — emit reads the
        // width to pick i32-vs-i64 codegen. signed rides as 1|0.
        Option.Some(Core.CNum(v, (if sflag == 1 then true else false), w))
    | Option.Some(Node.NVar(_)) =>
        // canonicalize: replace the source name with the binder's node-id (resolve already proved RBound
        // since the type fact was TInt). Defensive: a non-RBound fact yields no core form.
        (match Map.lookup(rcol, id) with
          | Option.Some(Resolved.RBound(binder)) => Option.Some(Core.CVar(binder))
          // HIGHER-ORDER (HO-3): a bare def-name used as a VALUE (RDef) lowers to CFnRef(defName) — a fn-value
          // (top-level defs are closed, so the value IS the name). eval returns Some(name); a CFnRefVar site
          // dispatches it. This is the `inc` argument in `(apply inc 41)`.
          | Option.Some(Resolved.RDef(name)) => Option.Some(Core.CFnRef(name))
          | _ => Option.None(unit))
    | Option.Some(Node.NBin(op, l, r)) =>
        (match lower-node(tree, l, rcol, tcol) with
          | Option.Some(cl) =>
            (match lower-node(tree, r, rcol, tcol) with
              // stamp the CBin's result width from THIS node's type fact (narrow arith carries its width;
              // arithmetic-over-Int64 and comparisons stamp (true,64)).
              | Option.Some(cr) => Option.Some(cbin-of(op, (match Map.lookup(tcol, id) with | Option.Some(t) => t | Option.None(_) => Typed.TIntW(true, 64)), cl, cr))
              | Option.None(_) => Option.None(unit))
          | Option.None(_) => Option.None(unit))
    | Option.Some(Node.NLet(_, valId, bodyId)) =>
        // the let is keyed by its OWN node-id, matching the CVar(binderId) of its bound uses.
        (match lower-node(tree, valId, rcol, tcol) with
          | Option.Some(cv) =>
            (match lower-node(tree, bodyId, rcol, tcol) with
              | Option.Some(cb) => Option.Some(Core.CLet(id, cv, cb))
              | Option.None(_) => Option.None(unit))
          | Option.None(_) => Option.None(unit))
    | Option.Some(Node.NIf(condId, thenId, elseId)) =>
        // lower all three children; the if lowers iff all three lower (infer already proved cond Bool and the
        // branches same-typed, so a Some here is a well-typed CIf).
        (match lower-node(tree, condId, rcol, tcol) with
          | Option.Some(cc) =>
            (match lower-node(tree, thenId, rcol, tcol) with
              | Option.Some(ct) =>
                (match lower-node(tree, elseId, rcol, tcol) with
                  | Option.Some(ce) => Option.Some(Core.CIf(cc, ct, ce))
                  | Option.None(_) => Option.None(unit))
              | Option.None(_) => Option.None(unit))
          | Option.None(_) => Option.None(unit))
    | Option.Some(Node.NMatch(scrutId, litId, thenId, elseId)) =>
        // M1-a integer match → CIf(CBin(61 ==, scrut, lit), then, else): the match IS "if scrut == lit then <arm>
        // else <wildcard-arm>". Reuses CIf/CBin so eval/emit need NO new handling. All four children must lower.
        (match lower-node(tree, scrutId, rcol, tcol) with
          | Option.Some(cs) =>
            (match lower-node(tree, litId, rcol, tcol) with
              | Option.Some(cl) =>
                (match lower-node(tree, thenId, rcol, tcol) with
                  | Option.Some(ct) =>
                    (match lower-node(tree, elseId, rcol, tcol) with
                      | Option.Some(ce) => Option.Some(Core.CIf(Core.CBin(61, true, 64, cs, cl), ct, ce))  // 61 = ==
                      | Option.None(_) => Option.None(unit))
                  | Option.None(_) => Option.None(unit))
              | Option.None(_) => Option.None(unit))
          | Option.None(_) => Option.None(unit))
    | Option.Some(Node.NApp(calleeId, argId)) =>
        // NULLARY call `(mk)` = NApp(calleeBodyId, -1) INLINES the callee body's Core (β-reduction over zero
        // args — the call IS the body). slice-3c SINGLE-PARAM call `(f arg)` = NApp(calleeBodyId, argId) lowers
        // to `CLet(paramId, argCore, bodyCore)` — a call binds its param exactly like a `let`: eval the arg,
        // bind it to the param's canonical node-id, eval the body under that binding. The paramId is found by
        // BODYID (`param-of(tree, calleeId)` — sread keyed the param-table by bodyId for exactly this). A call
        // WITH an arg but NO param (an over-applied nullary def) → param-of None → declines (no Core).
        // forward-ref: calleeId is the callee NAME → map to its def-body via def-body-of. A RECURSIVE call
        // (body transitively calls back) would inline-loop lower → DECLINE (None). An unknown name → None.
        // param-* lookups use the NAME (keyed both ways); only the body INLINE uses calleeBody.
        // slice-B1a RECURSION: a recursive call (body transitively calls back) can NOT inline (a cycle would
        // loop lower forever). Instead it lowers to a NON-inlining `CCall(calleeName, args)` — a LEAF w.r.t.
        // lowering (we do NOT descend the callee body here; the def-env build in B1b lowers each body once).
        // Args are the SAME arg slots the inline path reads (argId + arg2/3/4-of), lowered into a List(Core);
        // any ill-typed arg → the call declines (None). Unknown name can't be recursive (call-is-recursive
        // returns false when def-body-of misses), so this branch always has a known callee.
        (if (call-is-recursive(tree, calleeId)) then lower-recursive-call(tree, id, calleeId, argId, rcol, tcol)
         else (match def-body-of(tree, calleeId) with
           // HIGHER-ORDER (HO-3): def-body-of MISS = callee is NOT a global def — may be a fn-typed PARAM.
           // resolve-db (HO-2b-ii-B) stored a callee-fact at THIS NApp id: RBound(binder) → lower to
           // CFnRefVar(binder, loweredArgs) (eval looks up env[binder]=def-name, dispatches). Else decline.
           | Option.None(_) => (match Map.lookup(rcol, id) with
               | Option.Some(Resolved.RBound(binder)) => (match lower-rec-args(tree, id, argId, rcol, tcol) with
                   | Option.Some(args) => Option.Some(Core.CFnRefVar(binder, args))
                   | Option.None(_) => Option.None(unit))
               | _ => Option.None(unit))
           | Option.Some(calleeBody) =>
             (if (argId == (0 - 1)) then lower-node(tree, calleeBody, rcol, tcol)
              else (match param-of(tree, calleeId) with
                | Option.Some(paramId) =>
                    (match lower-node(tree, argId, rcol, tcol) with
                      | Option.Some(argCore) =>
                          (match lower-node(tree, calleeBody, rcol, tcol) with
                            | Option.Some(bodyCore) =>
                                // slice-3d 2-ARG call `(add a b)`: if this NApp node (id) has a 2nd arg recorded
                                // (arg2-of) AND the callee a 2nd param (param2-of), NEST a second CLet INSIDE the
                                // first — CLet(p1, arg1, CLet(p2, arg2, body)). A 1-arg call has arg2-of None →
                                // the single CLet (slice-3c). The inner binds LAST so the body sees both params.
                                (match arg2-of(tree, id) with
                                  | Option.Some(arg2Id) =>
                                      (match param2-of(tree, calleeId) with
                                        | Option.Some(param2Id) =>
                                            (match lower-node(tree, arg2Id, rcol, tcol) with
                                              // slice-3e 3-ARG call `(f a b c)`: if this NApp has a 3rd arg (arg3-of)
                                              // AND the callee a 3rd param (param3-of), nest a THIRD CLet innermost
                                              // → CLet(p1,a1,CLet(p2,a2,CLet(p3,a3,body))). Else the 2-arg CLet.
                                              | Option.Some(arg2Core) =>
                                                  (match inner-body-with-param3(tree, id, calleeId, bodyCore, rcol, tcol) with
                                                    | Option.Some(inner) => Option.Some(Core.CLet(paramId, argCore, Core.CLet(param2Id, arg2Core, inner)))
                                                    | Option.None(_) => Option.None(unit))       // arg3 but no param3 → over-applied → decline
                                              | Option.None(_) => Option.None(unit))
                                        | Option.None(_) => Option.None(unit))       // arg2 but no param2 → over-applied → decline
                                  | Option.None(_) => Option.Some(Core.CLet(paramId, argCore, bodyCore)))  // 1-arg
                            | Option.None(_) => Option.None(unit))
                      | Option.None(_) => Option.None(unit))
                | Option.None(_) => Option.None(unit)))))
    | Option.None(_) => Option.None(unit)

/// slice-3e: the innermost body of a call's nested-CLet chain, optionally wrapping a THIRD `CLet(param3, arg3,
/// body)`. If this NApp node `id` has a 3rd arg (arg3-of) AND the callee a 3rd param (param3-of), lower arg3
/// and wrap → `CLet(param3, arg3Core, <param4-wrapped body>)`; a 2-arg call (arg3-of None) returns `bodyCore`
/// unchanged. An arg3 with NO param3 (over-applied) → `None` (declines). slice-3f: the body wrapped BEFORE
/// param3 is `inner-body-with-param4` (a 4th CLet innermost) so the full chain is
/// `CLet(p3,a3, CLet(p4,a4, body))`. Keeps the lower-node NApp arm flat.
def inner-body-with-param3(tree: Tree, id: Int64, calleeId: Int64, bodyCore: Core, rcol: Map(Int64, Resolved), tcol: Map(Int64, Typed)) =
  (match arg3-of(tree, id) with
    | Option.None(_) => Option.Some(bodyCore)                        // 2-arg call — no 3rd CLet
    | Option.Some(arg3Id) =>
        (match param3-of(tree, calleeId) with
          | Option.None(_) => Option.None(unit)                       // arg3 but no param3 → over-applied → decline
          | Option.Some(param3Id) =>
              (match inner-body-with-param4(tree, id, calleeId, bodyCore, rcol, tcol) with
                | Option.Some(inner) =>
                    (match lower-node(tree, arg3Id, rcol, tcol) with
                      | Option.Some(arg3Core) => Option.Some(Core.CLet(param3Id, arg3Core, inner))
                      | Option.None(_) => Option.None(unit))
                | Option.None(_) => Option.None(unit))))              // arg4 but no param4 → over-applied → decline

/// slice-3f: the innermost body of a call's nested-CLet chain, optionally wrapping a FOURTH `CLet(param4, arg4,
/// body)`. If this NApp node `id` has a 4th arg (arg4-of) AND the callee a 4th param (param4-of), lower arg4
/// and wrap → `CLet(param4, arg4Core, bodyCore)`; a ≤3-arg call (arg4-of None) returns `bodyCore` unchanged.
/// An arg4 with NO param4 (over-applied) → `None` (declines). The mirror of inner-body-with-param3.
def inner-body-with-param4(tree: Tree, id: Int64, calleeId: Int64, bodyCore: Core, rcol: Map(Int64, Resolved), tcol: Map(Int64, Typed)) =
  (match arg4-of(tree, id) with
    | Option.None(_) => Option.Some(bodyCore)                        // ≤3-arg call — no 4th CLet
    | Option.Some(arg4Id) =>
        (match param4-of(tree, calleeId) with
          | Option.None(_) => Option.None(unit)                       // arg4 but no param4 → over-applied → decline
          | Option.Some(param4Id) =>
              (match lower-node(tree, arg4Id, rcol, tcol) with
                | Option.Some(arg4Core) => Option.Some(Core.CLet(param4Id, arg4Core, bodyCore))
                | Option.None(_) => Option.None(unit))))

/// slice-B1a: lower a RECURSIVE call `(f a1 a2 ..)` to a NON-inlining `CCall(calleeName, args)`. Extracted
/// from lower-ok's NApp arm to keep that arm small. Lowers the arg slots into a List(Core); any ill-typed arg
/// declines the whole call (None). A LEAF w.r.t. lowering — does NOT descend the callee body.
def lower-recursive-call(tree: Tree, id: Int64, calleeId: Int64, argId: Int64, rcol: Map(Int64, Resolved), tcol: Map(Int64, Typed)) =
  (match lower-rec-args(tree, id, argId, rcol, tcol) with
    | Option.Some(args) => Option.Some(Core.CCall(calleeId, args))
    | Option.None(_) => Option.None(unit))

/// slice-B1a: lower a RECURSIVE call's argument nodes into a `List(Core)` for `CCall(calleeName, args)`. The
/// args are the SAME slots the inline path reads — `argId` (the first arg, or -1 for a nullary call) plus
/// `arg2-of`/`arg3-of`/`arg4-of` keyed by this NApp node-id `id`. A nullary call → `[]`. Each present arg is
/// lowered by `lower-node`; if ANY arg is ill-typed / does not lower, the whole call declines (`None`). This
/// does NOT descend the callee body (that is the def-env's job in B1b) — CCall is a lowering LEAF.
def lower-rec-args(tree: Tree, id: Int64, argId: Int64, rcol: Map(Int64, Resolved), tcol: Map(Int64, Typed)) =
  (if (argId == (0 - 1)) then Option.Some(([] : List(Core)))            // nullary recursive call → no args
   else (match lower-node(tree, argId, rcol, tcol) with
     | Option.None(_) => Option.None(unit)
     | Option.Some(a1) =>
         // splice arg1 then each present higher arg (each a []-or-[core] list) in order via List.concat.
         (match lower-rec-arg-opt(tree, arg2-of(tree, id), rcol, tcol) with
           | Option.None(_) => Option.None(unit)
           | Option.Some(rest2) =>
               (match lower-rec-arg-opt(tree, arg3-of(tree, id), rcol, tcol) with
                 | Option.None(_) => Option.None(unit)
                 | Option.Some(rest3) =>
                     (match lower-rec-arg-opt(tree, arg4-of(tree, id), rcol, tcol) with
                       | Option.None(_) => Option.None(unit)
                       | Option.Some(rest4) =>
                           Option.Some(List.concat(List.push([], a1), List.concat(rest2, List.concat(rest3, rest4)))))))))

/// Helper: lower an OPTIONAL arg-slot node (from arg2/3/4-of). `None` slot → `Some []` (absent arg, no
/// contribution); a present slot that lowers → `Some [core]`; a present slot that fails to lower → `None`
/// (the call declines). Returns `Option(List(Core))` — the singleton-or-empty list is spliced by the caller.
def lower-rec-arg-opt(tree: Tree, slot: Option(Int64), rcol: Map(Int64, Resolved), tcol: Map(Int64, Typed)) =
  (match slot with
    | Option.None(_) => Option.Some(([] : List(Core)))
    | Option.Some(argN) =>
        (match lower-node(tree, argN, rcol, tcol) with
          | Option.Some(argCore) => Option.Some(List.push([], argCore))
          | Option.None(_) => Option.None(unit)))

/// The lower COLUMN builder: build resolve + infer columns (demanding parse under them), then lower over
/// them. The whole demand chain in one call — lower reaches infer reaches resolve reaches parse.
def lower-tree(tree: Tree, root: Int64) =
  lower-node(tree, root, resolve-tree(tree, root), infer-tree(tree, root))

/// slice-B1b: the param BINDER node-ids a def-name declares, in order (`[]` for a nullary def). The def-env
/// keys the body's CVar binders by these ids; eval binds args positionally to them in a fresh env.
def def-param-ids(tree: Tree, nameId: Int64) =
  (match param-of(tree, nameId) with
    | Option.None(_) => ([] : List(Int64))
    | Option.Some(p1) =>
        (let l1 = List.push([], p1) in
         (let l2 = (match param2-of(tree, nameId) with | Option.Some(p2) => List.push(l1, p2) | Option.None(_) => l1) in
          (let l3 = (match param3-of(tree, nameId) with | Option.Some(p3) => List.push(l2, p3) | Option.None(_) => l2) in
           (match param4-of(tree, nameId) with | Option.Some(p4) => List.push(l3, p4) | Option.None(_) => l3)))))

/// slice-B1b: the param SCOPE (resolve env, nameId→binderNode) for a def body — mirrors the resolve NApp
/// arm's body scope. Reused to resolve the body standalone.
def def-param-scope(tree: Tree, nameId: Int64) =
  (match param-of(tree, nameId) with
    | Option.None(_) => (Map.empty : Map(Int64, Int64))
    | Option.Some(p1) =>
        (let s1 = param-scope(tree, p1, (Map.empty : Map(Int64, Int64))) in
         (let s2 = (match param2-of(tree, nameId) with | Option.Some(p2) => param-scope(tree, p2, s1) | Option.None(_) => s1) in
          (let s3 = (match param3-of(tree, nameId) with | Option.Some(p3) => param-scope(tree, p3, s2) | Option.None(_) => s2) in
           (match param4-of(tree, nameId) with | Option.Some(p4) => param-scope(tree, p4, s3) | Option.None(_) => s3)))))

/// slice-B1b: seed a type column with each param binder-id → Int64, so `infer-node` types a def body
/// standalone (var-type reads a param's type from tcol by binder-id). Monomorphic-i64: every param is Int64.
def seed-param-types(params: List(Int64), tcol: Map(Int64, Typed)) =
  (match params with
    | [] => tcol
    | [p, .. rest] => seed-param-types(rest, Map.insert(tcol, p, Typed.TIntW(true, 64))))

/// slice-B1b: lower ONE def body STANDALONE — resolve it in its param scope, infer it under params→Int64,
/// then lower. `Option((paramBinderIds, bodyCore))` — `None` if the body is ill-typed / doesn't lower (that
/// def just won't be callable; a call to it declines at eval). The body's recursive self-calls lower to
/// `CCall` LEAVES (lower-recursive-call does not descend), so this terminates.
def lower-one-def(tree: Tree, nameId: Int64, bodyId: Int64) =
  (let params = def-param-ids(tree, nameId) in
   (let scope = def-param-scope(tree, nameId) in
    (let rcol = resolve-node(tree, bodyId, scope, (Map.empty : Map(Int64, Resolved))) in
     (let tcol = infer-node(tree, bodyId, rcol, seed-param-types(params, (Map.empty : Map(Int64, Typed)))) in
      (match lower-node(tree, bodyId, rcol, tcol) with
        | Option.Some(bodyCore) => Option.Some((params, bodyCore))
        | Option.None(_) => Option.None(unit))))))

/// slice-B1b: fold the def-table entries into the def-env `Map(name, (paramBinderIds, bodyCore))`. Only a
/// RECURSIVE def (call-is-recursive) is added — a CCall is emitted ONLY for a recursive callee, so the def-env
/// only needs recursive-def bodies; a NON-recursive def stays INLINED at its call site by the main lower and
/// must NOT be lowered standalone here (its body's non-recursive call would hit the inline path without the
/// caller's column wiring → a malformed Core that traps at eval — the tick-30 bug). A recursive def whose body
/// doesn't lower is skipped (a call to it declines at eval — total). Terminates: each recursive body is lowered
/// ONCE and its self-calls are CCall leaves (no re-entry into this fold).
def build-def-env(tree: Tree, entries: List(Tuple(Int64, Int64)), acc: Map(Int64, Tuple(List(Int64), Core))) =
  (match entries with
    | [] => acc
    | [e, .. rest] =>
        (match e with
          | (nameId, bodyId) =>
              // p3: include ONLY a DIRECTLY self-recursive def (fac). A merely MUTUALLY-recursive def (ev/od)
              // is call-is-recursive (transitive) but NOT call-is-self-recursive → stays OUT of the def-env, so
              // its cross-call CCall leaf hits a def-env miss and eval DECLINES cleanly (mutual runtime recursion
              // is out of Slice-B scope — it must decline, not trap). Non-recursive defs stay inlined as before.
              // Self-recursive defs (fac) for CCall dispatch (Slice-B). HIGHER-ORDER (HO-3): ALSO add NON-recursive
              // defs so a def used as a fn-VALUE (`inc` in `(apply inc 41)`) is reachable via the CFnRefVar/CFnRef
              // name dispatch. Normal calls are UNAFFECTED — they still INLINE via the main lower; the def-env is
              // consulted ONLY by CCall + the HO fn-value dispatch, never by the inline path. A def whose standalone
              // body fails to lower (lower-one-def None) is skipped (a fn-value call to it declines). NOTE: the
              // tick-30 concern (a non-rec def whose body has an inline call malforms when lowered standalone) is
              // real; guarded here by lower-one-def's own decline + the HO milestone shapes (apply/inc/twice) having
              // clean bodies. ⚠ EXCLUDE a MUTUALLY-recursive def (call-is-recursive TRUE but call-is-self-recursive
              // FALSE — e.g. ev/od): mutual runtime recursion is OUT of Slice-B scope and MUST DECLINE cleanly (the
              // se-mutual-recursion-declines-not-hangs invariant, PR#785). Adding it to the def-env would let its
              // cross-call CCall/name-dispatch actually RUN (ev 4 → 1) — a behavior change that breaks the pinned
              // decline. So include a def iff it is SELF-recursive (fac, for CCall) OR NON-recursive (for the HO
              // fn-value name dispatch); a merely-mutually-recursive def stays OUT → its cross-call misses the
              // def-env and eval declines, exactly as before HO-3.
              (if (call-is-recursive(tree, nameId) and (if call-is-self-recursive(tree, nameId) then false else true))
               then build-def-env(tree, rest, acc)                       // mutually-recursive → OUT (must decline)
               else (match lower-one-def(tree, nameId, bodyId) with
                 | Option.Some(entry) => build-def-env(tree, rest, Map.insert(acc, nameId, entry))
                 | Option.None(_) => build-def-env(tree, rest, acc)))))

/// slice-B1b: the DEF-ENV for a whole tree — every def-table name → (paramBinderIds, bodyCore), each body
/// lowered once and standalone. `eval-core-d` reads this to run a `CCall(name, args)`. Reaches the def-table
/// via the `Tree.Arena` def-table field (`dt`, 3rd), enumerated in canonical order by `Map.to-list`.
def lower-def-env(tree: Tree) =
  (match tree with
    | Tree.Arena(_, _, dt, _, _, _, _, _, _, _, _, _) =>
        build-def-env(tree, Map.to-list(dt), (Map.empty : Map(Int64, Tuple(List(Int64), Core)))))

/// Probe: is this Core a `CNum v`?
def is-cnum(c: Core, v: Int64) = match c with | Core.CNum(x, _, _) => x == v | _ => false

/// Probe: is this Core a `CVar` with binder id `b`?
def is-cvar(c: Core, b: Int64) = match c with | Core.CVar(x) => x == b | _ => false

/// Probe: is this Core a `CNum` carrying value `v`, signedness `signed`, and width `w` — the NARROW-width
/// shape a `NAnnLit` lowers to (checks the width/sign flow, not just the value `is-cnum` checks).
def is-cnum-w(c: Core, v: Int64, signed: Bool, w: Int64) = match c with
  | Core.CNum(x, s, cw) => (x == v) and (((if s then true else false) == signed) and (cw == w))
  | _ => false

/// Test-token builders (parse-db doesn't export its private builders).
def n(v: Int64) = Tok.TNum(v)
def var(nm: Int64) = Tok.TName(nm)
def plus() = Tok.TOp(43)
def times() = Tok.TOp(42)
def letkw() = Tok.TLet
def inkw() = Tok.TIn
def eq() = Tok.TEq
def parse-of(ts: List(Tok)) = parse-tokens(ts)

@test
def lw-literal() =
  // "5" → Some(CNum 5).
  (match parse-of([n(5)]) with | (root, tree) =>
    (match lower-tree(tree, root) with | Option.Some(c) => (if is-cnum(c, 5) then unit else trap("CNum 5")) | Option.None(_) => trap("a literal lowers")))

@test
def lw-add() =
  // "1 + 2" → Some(CBin(+, CNum 1, CNum 2)).
  (match parse-of([n(1), plus(), n(2)]) with | (root, tree) =>
    (match lower-tree(tree, root) with
      | Option.Some(Core.CBin(op, _, _, l, r)) =>
        (if op == 43 then (if is-cnum(l, 1) then (if is-cnum(r, 2) then unit else trap("right CNum 2")) else trap("left CNum 1")) else trap("+ op"))
      | _ => trap("1 + 2 lowers to a CBin")))

@test
def lw-var-canonicalizes-to-binder() =
  // "let x = 2 in x" → CLet(binderId, CNum 2, CVar binderId): the body var's CVar carries the LET's node-id.
  (match parse-of([letkw(), var(1), eq(), n(2), inkw(), var(1)]) with | (root, tree) =>
    (match lower-tree(tree, root) with
      | Option.Some(Core.CLet(binderId, cv, cb)) =>
        (if binderId == root then
           (if is-cnum(cv, 2) then (if is-cvar(cb, root) then unit else trap("body is CVar(letId)")) else trap("value CNum 2"))
         else trap("CLet keyed by the let node-id"))
      | _ => trap("let lowers to CLet")))

@test
def lw-ill-typed-has-no-core() =
  // an unbound "x" is TErr → NO core form (None). absence≠value: the ill-typed program has no lowering.
  (match parse-of([var(1)]) with | (root, tree) =>
    (match lower-tree(tree, root) with | Option.None(_) => unit | Option.Some(_) => trap("ill-typed program has no core form")))

@test
def lw-err-in-subtree-blocks-lowering() =
  // "x + 1" (x unbound) → the whole thing is TErr → None (the error blocks lowering of the parent too).
  (match parse-of([var(1), plus(), n(1)]) with | (root, tree) =>
    (match lower-tree(tree, root) with | Option.None(_) => unit | Option.Some(_) => trap("a + with an unbound operand does not lower")))

@test
def lw-shadowing-canonical-names-distinct() =
  // "let x = 1 in let x = 2 in x" → the inner x's CVar binds to the INNER let's node-id, not the outer's.
  // Proves canonicalization disambiguates shadowed names by binder identity.
  (match parse-of([letkw(), var(1), eq(), n(1), inkw(), letkw(), var(1), eq(), n(2), inkw(), var(1)]) with | (root, tree) =>
    (match node-at(tree, root) with
      | Option.Some(Node.NLet(_, _, innerLetId)) =>
        (match lower-tree(tree, root) with
          | Option.Some(Core.CLet(outerId, _, body)) =>
            (match body with
              | Core.CLet(innerId, _, innerBody) =>
                (if is-cvar(innerBody, innerId) then
                   (if (innerId == innerLetId) then (if (outerId == root) then unit else trap("outer CLet keyed by root")) else trap("inner CLet keyed by inner let id"))
                 else trap("inner body is CVar(innerLetId) — shadow resolved"))
              | _ => trap("outer body is the inner CLet"))
          | _ => trap("root lowers to CLet"))
      | _ => trap("root is a let")))

@test
def lw-milestone-lowers() =
  // THE MILESTONE `let x = 2 in x * 3 + 1` lowers to CLet(root, CNum 2, CBin(+, CBin(*, CVar root, CNum 3),
  // CNum 1)) — the exact Core the Inc-5 evaluator will run to 7 (env{root->2}: 2*3+1 = 7).
  (match parse-of([letkw(), var(1), eq(), n(2), inkw(), var(1), times(), n(3), plus(), n(1)]) with | (root, tree) =>
    (match lower-tree(tree, root) with
      | Option.Some(Core.CLet(binderId, cv, body)) =>
        (if binderId == root then
           (if is-cnum(cv, 2) then
              (match body with
                | Core.CBin(addop, _, _, mul, one) =>
                  (if addop == 43 then
                     (match mul with
                       | Core.CBin(mulop, _, _, xv, three) =>
                         (if mulop == 42 then
                            (if is-cvar(xv, root) then (if is-cnum(three, 3) then (if is-cnum(one, 1) then unit else trap("+ right CNum 1")) else trap("* right CNum 3")) else trap("* left CVar(root)"))
                          else trap("inner is *"))
                       | _ => trap("+ left is a *"))
                   else trap("body is +"))
                | _ => trap("body is a CBin"))
            else trap("value CNum 2"))
         else trap("CLet keyed by root"))
      | _ => trap("milestone lowers to CLet")))

@test
def lw-annlit-lowers-to-narrow-cnum() =
  // THE WIDTH-FLOW path (lower-ok's NAnnLit arm): a width-annotated literal lowers to a NARROW CNum carrying
  // its (signed, width) — every other Core node is pinned, this one was not. `NAnnLit` has no producing Tok
  // (it comes from the sread annotation path), so build the arena DIRECTLY: a single-node tree holding
  // `NAnnLit(200, 0, 8)` = UInt8 200 must lower to `CNum(200, unsigned, 8)` — NOT the canonical (true,64).
  (match add-node(empty-tree(), Node.NAnnLit(200, 0, 8)) with | (root, tree) =>
    (match lower-tree(tree, root) with
      | Option.Some(c) => (if is-cnum-w(c, 200, false, 8) then unit else trap("UInt8 200 lowers to CNum(200, unsigned, 8)"))
      | Option.None(_) => trap("an annotated literal lowers")))

@test
def lw-annlit-signed-narrow() =
  // the signed twin: `NAnnLit(-5, 1, 8)` = Int8 -5 lowers to `CNum(-5, signed, 8)` (signed flag rides across,
  // width 8 preserved — the flow emit reads to pick i32-vs-i64 codegen).
  (match add-node(empty-tree(), Node.NAnnLit(0 - 5, 1, 8)) with | (root, tree) =>
    (match lower-tree(tree, root) with
      | Option.Some(c) => (if is-cnum-w(c, 0 - 5, true, 8) then unit else trap("Int8 -5 lowers to CNum(-5, signed, 8)"))
      | Option.None(_) => trap("a signed annotated literal lowers")))

@test
def lw-narrow-arith-cbin-preserves-width() =
  // narrow ARITH lowers to a CBin carrying the NARROW RESULT width — `Int8 + Int8` → CBin(op, signed, 8, …),
  // NOT the canonical width 64. This is the lowering-level twin of infer's id-same-narrow-arith-preserves-width
  // + the literal-level lw-annlit-lowers-to-narrow-cnum: the width flows literal→infer→lower so eval's CBin
  // overflow-check fires at width 8 (Int8 100+20=120 fits; 100+100=200 traps — pinned in eval-db). Completes
  // the narrow-width flow across all three columns (infer TIntW → lower CBin width → eval overflow-check).
  (match add-node(empty-tree(), Node.NAnnLit(100, 1, 8)) with | (lId, t1) =>
    (match add-node(t1, Node.NAnnLit(20, 1, 8)) with | (rId, t2) =>
      (match add-node(t2, Node.NBin(43, lId, rId)) with | (root, tree) =>
        (match lower-tree(tree, root) with
          | Option.Some(Core.CBin(_, _, w, _, _)) => (if w == 8 then unit else trap("Int8 + Int8 lowers to a CBin of width 8, not widened to 64"))
          | _ => trap("Int8 + Int8 lowers to a CBin")))))

@test
def lw-napp-nullary-inlines-body-slice2() =
  // SLICE-2 NULLARY-CALL SEMANTICS: a nullary call NApp(calleeName, -1) lowers by INLINING the callee body's
  // Core (β-reduction over zero args — no new Core node). Body = NLit(42), registered under name 900 via
  // record-def; the call NApp(900, -1) resolves name→body via def-body-of and lowers to CNum 42.
  (match add-node(empty-tree(), Node.NLit(42)) with | (bodyId, t1) =>
    (let t1d = record-def(t1, 900, bodyId) in
     (match add-node(t1d, Node.NApp(900, 0 - 1)) with | (root, tree) =>
      (match lower-tree(tree, root) with
        | Option.Some(c) => (if is-cnum(c, 42) then unit else trap("nullary NApp inlines the body → CNum 42"))
        | Option.None(_) => trap("a nullary NApp lowers to its inlined body Core")))))

@test
def lw-napp-with-arg-still-no-core() =
  // a call WITH an arg (argId != -1) is the param slice (not yet) → no core form. Pins the nullary/param boundary.
  (match add-node(empty-tree(), Node.NLit(7)) with | (bodyId, t1) =>
    (match add-node(t1, Node.NLit(5)) with | (argId, t2) =>
      (match add-node(t2, Node.NApp(bodyId, argId)) with | (root, tree) =>
        (match lower-tree(tree, root) with | Option.None(_) => unit | Option.Some(_) => trap("a call WITH an arg has no core until the param slice")))))

@test
def lw-recursive-nullary-call-lowers-to-ccall-slice-b1a() =
  // SLICE-B1a RECURSION: a self-recursive nullary call `def f() = f()` lowers to a NON-inlining `CCall(f, [])`
  // — NOT a decline (the pre-B1a behavior) and NOT an inline (a cycle can't inline). The body node IS the call
  // NApp(fName=900, -1); record-def keys name 900 → that node, so call-is-recursive(900) sees the body call
  // back to 900 → recursive. Real infer marks a recursive NApp TErr (until B2), so lower-tree would filter it
  // at the tcol gate; we call `lower-node` DIRECTLY with a synthetic tcol typing the call node TIntW(true,64)
  // — the only way to reach (and thus pin) the new CCall lowering path in B1a.
  (match add-node(empty-tree(), Node.NApp(900, 0 - 1)) with | (callId, t1) =>
    (let tree = record-def(t1, 900, callId) in
     (let tcol = Map.insert((Map.empty : Map(Int64, Typed)), callId, Typed.TIntW(true, 64)) in
      (match lower-node(tree, callId, (Map.empty : Map(Int64, Resolved)), tcol) with
        | Option.Some(Core.CCall(name, args)) =>
            (if (name == 900) and (List.len(args) == 0) then unit else trap("nullary self-call → CCall(900, [])"))
        | Option.Some(_) => trap("recursive call lowered to a NON-CCall Core (should be CCall)")
        | Option.None(_) => trap("recursive nullary call DECLINED (lower-node None) — CCall path not reached")))))

@test
def lw-recursive-call-splices-arg-into-ccall-slice-b1a() =
  // SLICE-B1a arg-splice: a self-recursive call WITH a (literal) arg `def f(n) = f(42)` lowers to
  // `CCall(f, [CNum 42])` — lower-rec-args lowers the single arg node into the args List. Body = NApp(900,
  // litId) with litId = NLit(42); record-def keys 900 → that call node so call-is-recursive fires. Synthetic
  // tcol types BOTH the call node and the literal TIntW(true,64) (real infer declines recursion until B2).
  (match add-node(empty-tree(), Node.NLit(42)) with | (litId, t1) =>
    (match add-node(t1, Node.NApp(900, litId)) with | (callId, t2) =>
      (let tree = record-def(t2, 900, callId) in
       (let tcol = Map.insert(Map.insert((Map.empty : Map(Int64, Typed)), callId, Typed.TIntW(true, 64)), litId, Typed.TIntW(true, 64)) in
        (match lower-node(tree, callId, (Map.empty : Map(Int64, Resolved)), tcol) with
          | Option.Some(Core.CCall(name, args)) =>
              (if (name == 900) and (List.len(args) == 1)
               then (match args with | [a1, .. _] => (if is-cnum(a1, 42) then unit else trap("arg1 is CNum 42")) | [] => trap("args has one element"))
               else trap("1-arg self-call → CCall(900, [CNum 42])"))
          | _ => trap("a recursive call with an arg lowers to CCall with the arg spliced"))))))

/// Test helper (slice-B1b): build a hand-arena `fac` def — body `if (n < 1) then 1 else (n * (fac (n-1)))`,
/// param n = NVar(1), self-call NApp(900, sub); record-def 900 → body + record-param 900 → n. Kept as a
/// SEPARATE def (not inlined in the @test) so neither function grows large enough to hit the self-host codegen
/// size-trap (the class v-inference owns). Returns the tree.
def b1b-fac-tree() =
  (match add-node(empty-tree(), Node.NVar(1)) with | (paramId, t1) =>
    (match add-node(t1, Node.NVar(1)) with | (nCond, t2) =>
      (match add-node(t2, Node.NLit(1)) with | (oneCond, t3) =>
        (match add-node(t3, Node.NBin(60, nCond, oneCond)) with | (condId, t4) =>
          (match add-node(t4, Node.NLit(1)) with | (thenId, t5) =>
            (match add-node(t5, Node.NVar(1)) with | (nMul, t6) =>
              (match add-node(t6, Node.NVar(1)) with | (nArg, t7) =>
                (match add-node(t7, Node.NLit(1)) with | (oneArg, t8) =>
                  (match add-node(t8, Node.NBin(45, nArg, oneArg)) with | (subId, t9) =>
                    (match add-node(t9, Node.NApp(900, subId)) with | (callId, t10) =>
                      (match add-node(t10, Node.NBin(42, nMul, callId)) with | (elseId, t11) =>
                        (match add-node(t11, Node.NIf(condId, thenId, elseId)) with | (bodyId, t12) =>
                          (let treeD = record-def(t12, 900, bodyId) in
                           record-param(treeD, 900, paramId))))))))))))))

@test
def lw-def-env-lowers-recursive-fac-body-slice-b1b() =
  // SLICE-B1b: lower-def-env builds a def-env whose `fac` (name 900) entry has ONE param + a CIf body Core
  // (the self-call inside lowered to a CCall leaf). The tree-build lives in b1b-fac-tree (a separate small
  // def) so this @test body stays tiny. Proves lower-def-env resolves+infers+lowers a recursive body STANDALONE
  // (needs the resolve-node/param-scope export + the if-type deferred-branch fix, both in this slice's stack).
  (match Map.lookup(lower-def-env(b1b-fac-tree()), 900) with
    | Option.None(_) => trap("def-env should contain fac (name 900)")
    | Option.Some(entry) =>
        (match entry with
          | (params, bodyCore) =>
              (if List.len(params) == 1 then
                 (match bodyCore with | Core.CIf(_, _, _) => unit | _ => trap("fac body should lower to a CIf"))
               else trap("fac has ONE param binder"))))

export { Core.*, lower-tree, lower-node, lower-def-env, cnum64, is-cnum, is-cnum-w, is-cvar }
