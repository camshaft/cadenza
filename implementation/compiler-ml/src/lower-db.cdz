/// lower-db.cdz — Increment 4 of the Cadenza-in-Cadenza compiler: the LOWER (Core-IR) COLUMN. The third
/// derived query column, extending the demand chain to lower → infer → resolve → parse: it lowers the typed
/// parse arena into a small integer Core IR. Mirrors rcdzc's `Lower.core_of` reading `Infer.type_of`.
///
/// THE CORE IR is a pointer tree (not an arena) — small and directly walkable by the Inc-5 evaluator. Its
/// key move is CANONICALIZATION: a source `NVar(nameId)` lowers to `CVar(binderId)` where `binderId` is the
/// NodeId of the `NLet` that binds it (from the resolve column). So Core carries canonical UNIQUE names
/// (the binder's identity), not source name-ids — shadowing is already resolved, and the Inc-5 evaluator can
/// key its environment by binderId with no scope logic. A `NLet(nameId, …)` lowers to `CLet(letNodeId, …)`
/// keyed by ITS OWN NodeId, matching the `CVar(binderId)` its bound uses carry.
///
/// LOWERING IS GATED ON TYPING: `lower-tree` returns `Option(Core)` — `Some` for a well-typed tree, `None`
/// if any node is `TErr` (unbound name / ill-typed). Absence≠value once more: a type-erroneous program has
/// NO core form (a filled `None`), not a bogus tree. Lowering reads the infer column to make this decision,
/// and reads the resolve column to canonicalize vars — producer-reads-two-producers.

import { Tok, Node, Tree, node-at, parse-tokens, empty-tree, add-node } from "parse-db"
import { Resolved, resolve-tree } from "resolve-db"
import { Typed, infer-tree } from "infer-db"

/// The integer Core IR. `CVar` carries the BINDER node-id (canonical unique name); `CLet` is keyed by its
/// own let-node-id. Op codes match the parser/token codes (43 +, 45 -, 42 *).
type Core =
  | CNum(Int64, Bool, Int64)       // CNum(value, signed, width) — a fixed-width int constant; (true,64)=Int64
  | CVar(Int64)                    // CVar(binderId) — canonical, resolved
  | CBin(Int64, Bool, Int64, Core, Core)  // CBin(op, signed, width, left, right) — width = the RESULT's
                                   // fixed-width int type; eval wraps a narrow result at 2^width, emit masks.
                                   // (true,64) = Int64 arith (no wrap). A comparison CBin is (true,64) too
                                   // (its result is a 0/1 Bool-as-i64, not a narrow int).
  | CLet(Int64, Core, Core)        // CLet(binderId, value, body)
  | CIf(Core, Core, Core)          // CIf(cond, then, else)

/// The canonical Int64 constant — the width the monomorphic-i64 pipeline lowers every literal to today (a
/// narrow-width annotation lowers to a NARROW CNum; emit reads the width). A single name so construct sites
/// don't repeat the `(true, 64)`.
def cnum64(v: Int64) = Core.CNum(v, true, 64)

/// Build a CBin, stamping its RESULT width from the node's type fact `t`: a `TIntW(s, w)` result → that
/// (s, w) (so a narrow-typed arith node carries its width for eval-wrap/emit-mask); anything else (TBool
/// comparison result, or absent) → the canonical (true, 64). Today arith is gated to Int64 in infer
/// (2b-ii-c), so this stamps (true,64) until the infer-relax slice types same-width narrow arith TIntW.
def cbin-of(op: Int64, t: Typed, l: Core, r: Core) = match t with
  | Typed.TIntW(s, w) => Core.CBin(op, s, w, l, r)
  | _ => Core.CBin(op, true, 64, l, r)

/// Lower the subtree at `id`, reading the pre-built resolve column `rcol` (for var canonicalization) and
/// type column `tcol` (the well-typed gate). Returns `Option(Core)` — `None` if this node or any descendant
/// is ill-typed / unbound. Reading the two upstream columns (not recomputing) is the producer-reads-producer
/// contract.
def lower-node(tree: Tree, id: Int64, rcol: Map(Int64, Resolved), tcol: Map(Int64, Typed)) =
  // a node with any GROUND type (TInt or TBool) lowers; TErr (or a missing fact) has no core form. Bool is
  // represented in Core as an Int (0/1) — comparison `CBin`s evaluate to 0/1 — so the Core stays minimal and
  // uniform; the type column already proved the shape well-typed.
  (match Map.lookup(tcol, id) with
    | Option.Some(Typed.TIntW(_, _)) => lower-ok(tree, id, rcol, tcol)
    | Option.Some(Typed.TBool) => lower-ok(tree, id, rcol, tcol)
    | _ => Option.None(unit))

/// The typed-node case: build the Core node, canonicalizing a var to its binder id via `rcol`.
def lower-ok(tree: Tree, id: Int64, rcol: Map(Int64, Resolved), tcol: Map(Int64, Typed)) =
  match node-at(tree, id) with
    | Option.Some(Node.NLit(v)) => Option.Some(cnum64(v))
    | Option.Some(Node.NBoolLit(b)) => Option.Some(cnum64(b))   // Bool is Int 0/1 in Core (i64)
    | Option.Some(Node.NAnnLit(v, sflag, w)) =>
        // a width-annotated literal lowers to a NARROW CNum carrying its (signed, width) — emit reads the
        // width to pick i32-vs-i64 codegen. signed rides as 1|0.
        Option.Some(Core.CNum(v, (if sflag == 1 then true else false), w))
    | Option.Some(Node.NVar(_)) =>
        // canonicalize: replace the source name with the binder's node-id (resolve already proved RBound
        // since the type fact was TInt). Defensive: a non-RBound fact yields no core form.
        (match Map.lookup(rcol, id) with
          | Option.Some(Resolved.RBound(binder)) => Option.Some(Core.CVar(binder))
          | _ => Option.None(unit))
    | Option.Some(Node.NBin(op, l, r)) =>
        (match lower-node(tree, l, rcol, tcol) with
          | Option.Some(cl) =>
            (match lower-node(tree, r, rcol, tcol) with
              // stamp the CBin's result width from THIS node's type fact (narrow arith carries its width;
              // arithmetic-over-Int64 and comparisons stamp (true,64)).
              | Option.Some(cr) => Option.Some(cbin-of(op, (match Map.lookup(tcol, id) with | Option.Some(t) => t | Option.None(_) => Typed.TIntW(true, 64)), cl, cr))
              | Option.None(_) => Option.None(unit))
          | Option.None(_) => Option.None(unit))
    | Option.Some(Node.NLet(_, valId, bodyId)) =>
        // the let is keyed by its OWN node-id, matching the CVar(binderId) of its bound uses.
        (match lower-node(tree, valId, rcol, tcol) with
          | Option.Some(cv) =>
            (match lower-node(tree, bodyId, rcol, tcol) with
              | Option.Some(cb) => Option.Some(Core.CLet(id, cv, cb))
              | Option.None(_) => Option.None(unit))
          | Option.None(_) => Option.None(unit))
    | Option.Some(Node.NIf(condId, thenId, elseId)) =>
        // lower all three children; the if lowers iff all three lower (infer already proved cond Bool and the
        // branches same-typed, so a Some here is a well-typed CIf).
        (match lower-node(tree, condId, rcol, tcol) with
          | Option.Some(cc) =>
            (match lower-node(tree, thenId, rcol, tcol) with
              | Option.Some(ct) =>
                (match lower-node(tree, elseId, rcol, tcol) with
                  | Option.Some(ce) => Option.Some(Core.CIf(cc, ct, ce))
                  | Option.None(_) => Option.None(unit))
              | Option.None(_) => Option.None(unit))
          | Option.None(_) => Option.None(unit))
    | Option.Some(Node.NApp(calleeId, argId)) =>
        // slice-2 NULLARY call semantics: a nullary call `(mk)` = NApp(calleeBodyId, -1) INLINES the callee
        // body's Core (β-reduction over zero args — no params to bind, so the call IS the body). Lower the
        // callee body at calleeId; that Core is the call's Core. A call WITH an arg (argId != -1) is the param
        // slice (lowers to CLet(param, argCore, bodyCore)) — not yet, declines None. No new Core node.
        (if (argId == (0 - 1)) then lower-node(tree, calleeId, rcol, tcol)
         else Option.None(unit))
    | Option.None(_) => Option.None(unit)

/// The lower COLUMN builder: build resolve + infer columns (demanding parse under them), then lower over
/// them. The whole demand chain in one call — lower reaches infer reaches resolve reaches parse.
def lower-tree(tree: Tree, root: Int64) =
  lower-node(tree, root, resolve-tree(tree, root), infer-tree(tree, root))

/// Probe: is this Core a `CNum v`?
def is-cnum(c: Core, v: Int64) = match c with | Core.CNum(x, _, _) => x == v | _ => false

/// Probe: is this Core a `CVar` with binder id `b`?
def is-cvar(c: Core, b: Int64) = match c with | Core.CVar(x) => x == b | _ => false

/// Probe: is this Core a `CNum` carrying value `v`, signedness `signed`, and width `w` — the NARROW-width
/// shape a `NAnnLit` lowers to (checks the width/sign flow, not just the value `is-cnum` checks).
def is-cnum-w(c: Core, v: Int64, signed: Bool, w: Int64) = match c with
  | Core.CNum(x, s, cw) => (x == v) and (((if s then true else false) == signed) and (cw == w))
  | _ => false

/// Test-token builders (parse-db doesn't export its private builders).
def n(v: Int64) = Tok.TNum(v)
def var(nm: Int64) = Tok.TName(nm)
def plus() = Tok.TOp(43)
def times() = Tok.TOp(42)
def letkw() = Tok.TLet
def inkw() = Tok.TIn
def eq() = Tok.TEq
def parse-of(ts: List(Tok)) = parse-tokens(ts)

@test
def lw-literal() =
  // "5" → Some(CNum 5).
  (match parse-of([n(5)]) with | (root, tree) =>
    (match lower-tree(tree, root) with | Option.Some(c) => (if is-cnum(c, 5) then unit else trap("CNum 5")) | Option.None(_) => trap("a literal lowers")))

@test
def lw-add() =
  // "1 + 2" → Some(CBin(+, CNum 1, CNum 2)).
  (match parse-of([n(1), plus(), n(2)]) with | (root, tree) =>
    (match lower-tree(tree, root) with
      | Option.Some(Core.CBin(op, _, _, l, r)) =>
        (if op == 43 then (if is-cnum(l, 1) then (if is-cnum(r, 2) then unit else trap("right CNum 2")) else trap("left CNum 1")) else trap("+ op"))
      | _ => trap("1 + 2 lowers to a CBin")))

@test
def lw-var-canonicalizes-to-binder() =
  // "let x = 2 in x" → CLet(binderId, CNum 2, CVar binderId): the body var's CVar carries the LET's node-id.
  (match parse-of([letkw(), var(1), eq(), n(2), inkw(), var(1)]) with | (root, tree) =>
    (match lower-tree(tree, root) with
      | Option.Some(Core.CLet(binderId, cv, cb)) =>
        (if binderId == root then
           (if is-cnum(cv, 2) then (if is-cvar(cb, root) then unit else trap("body is CVar(letId)")) else trap("value CNum 2"))
         else trap("CLet keyed by the let node-id"))
      | _ => trap("let lowers to CLet")))

@test
def lw-ill-typed-has-no-core() =
  // an unbound "x" is TErr → NO core form (None). absence≠value: the ill-typed program has no lowering.
  (match parse-of([var(1)]) with | (root, tree) =>
    (match lower-tree(tree, root) with | Option.None(_) => unit | Option.Some(_) => trap("ill-typed program has no core form")))

@test
def lw-err-in-subtree-blocks-lowering() =
  // "x + 1" (x unbound) → the whole thing is TErr → None (the error blocks lowering of the parent too).
  (match parse-of([var(1), plus(), n(1)]) with | (root, tree) =>
    (match lower-tree(tree, root) with | Option.None(_) => unit | Option.Some(_) => trap("a + with an unbound operand does not lower")))

@test
def lw-shadowing-canonical-names-distinct() =
  // "let x = 1 in let x = 2 in x" → the inner x's CVar binds to the INNER let's node-id, not the outer's.
  // Proves canonicalization disambiguates shadowed names by binder identity.
  (match parse-of([letkw(), var(1), eq(), n(1), inkw(), letkw(), var(1), eq(), n(2), inkw(), var(1)]) with | (root, tree) =>
    (match node-at(tree, root) with
      | Option.Some(Node.NLet(_, _, innerLetId)) =>
        (match lower-tree(tree, root) with
          | Option.Some(Core.CLet(outerId, _, body)) =>
            (match body with
              | Core.CLet(innerId, _, innerBody) =>
                (if is-cvar(innerBody, innerId) then
                   (if (innerId == innerLetId) then (if (outerId == root) then unit else trap("outer CLet keyed by root")) else trap("inner CLet keyed by inner let id"))
                 else trap("inner body is CVar(innerLetId) — shadow resolved"))
              | _ => trap("outer body is the inner CLet"))
          | _ => trap("root lowers to CLet"))
      | _ => trap("root is a let")))

@test
def lw-milestone-lowers() =
  // THE MILESTONE `let x = 2 in x * 3 + 1` lowers to CLet(root, CNum 2, CBin(+, CBin(*, CVar root, CNum 3),
  // CNum 1)) — the exact Core the Inc-5 evaluator will run to 7 (env{root->2}: 2*3+1 = 7).
  (match parse-of([letkw(), var(1), eq(), n(2), inkw(), var(1), times(), n(3), plus(), n(1)]) with | (root, tree) =>
    (match lower-tree(tree, root) with
      | Option.Some(Core.CLet(binderId, cv, body)) =>
        (if binderId == root then
           (if is-cnum(cv, 2) then
              (match body with
                | Core.CBin(addop, _, _, mul, one) =>
                  (if addop == 43 then
                     (match mul with
                       | Core.CBin(mulop, _, _, xv, three) =>
                         (if mulop == 42 then
                            (if is-cvar(xv, root) then (if is-cnum(three, 3) then (if is-cnum(one, 1) then unit else trap("+ right CNum 1")) else trap("* right CNum 3")) else trap("* left CVar(root)"))
                          else trap("inner is *"))
                       | _ => trap("+ left is a *"))
                   else trap("body is +"))
                | _ => trap("body is a CBin"))
            else trap("value CNum 2"))
         else trap("CLet keyed by root"))
      | _ => trap("milestone lowers to CLet")))

@test
def lw-annlit-lowers-to-narrow-cnum() =
  // THE WIDTH-FLOW path (lower-ok's NAnnLit arm): a width-annotated literal lowers to a NARROW CNum carrying
  // its (signed, width) — every other Core node is pinned, this one was not. `NAnnLit` has no producing Tok
  // (it comes from the sread annotation path), so build the arena DIRECTLY: a single-node tree holding
  // `NAnnLit(200, 0, 8)` = UInt8 200 must lower to `CNum(200, unsigned, 8)` — NOT the canonical (true,64).
  (match add-node(empty-tree(), Node.NAnnLit(200, 0, 8)) with | (root, tree) =>
    (match lower-tree(tree, root) with
      | Option.Some(c) => (if is-cnum-w(c, 200, false, 8) then unit else trap("UInt8 200 lowers to CNum(200, unsigned, 8)"))
      | Option.None(_) => trap("an annotated literal lowers")))

@test
def lw-annlit-signed-narrow() =
  // the signed twin: `NAnnLit(-5, 1, 8)` = Int8 -5 lowers to `CNum(-5, signed, 8)` (signed flag rides across,
  // width 8 preserved — the flow emit reads to pick i32-vs-i64 codegen).
  (match add-node(empty-tree(), Node.NAnnLit(0 - 5, 1, 8)) with | (root, tree) =>
    (match lower-tree(tree, root) with
      | Option.Some(c) => (if is-cnum-w(c, 0 - 5, true, 8) then unit else trap("Int8 -5 lowers to CNum(-5, signed, 8)"))
      | Option.None(_) => trap("a signed annotated literal lowers")))

@test
def lw-narrow-arith-cbin-preserves-width() =
  // narrow ARITH lowers to a CBin carrying the NARROW RESULT width — `Int8 + Int8` → CBin(op, signed, 8, …),
  // NOT the canonical width 64. This is the lowering-level twin of infer's id-same-narrow-arith-preserves-width
  // + the literal-level lw-annlit-lowers-to-narrow-cnum: the width flows literal→infer→lower so eval's CBin
  // overflow-check fires at width 8 (Int8 100+20=120 fits; 100+100=200 traps — pinned in eval-db). Completes
  // the narrow-width flow across all three columns (infer TIntW → lower CBin width → eval overflow-check).
  (match add-node(empty-tree(), Node.NAnnLit(100, 1, 8)) with | (lId, t1) =>
    (match add-node(t1, Node.NAnnLit(20, 1, 8)) with | (rId, t2) =>
      (match add-node(t2, Node.NBin(43, lId, rId)) with | (root, tree) =>
        (match lower-tree(tree, root) with
          | Option.Some(Core.CBin(_, _, w, _, _)) => (if w == 8 then unit else trap("Int8 + Int8 lowers to a CBin of width 8, not widened to 64"))
          | _ => trap("Int8 + Int8 lowers to a CBin")))))

@test
def lw-napp-nullary-inlines-body-slice2() =
  // SLICE-2 NULLARY-CALL SEMANTICS: a nullary call NApp(calleeBodyId, -1) lowers by INLINING the callee body's
  // Core (β-reduction over zero args — no new Core node). Body = NLit(42) → the call lowers to CNum 42.
  (match add-node(empty-tree(), Node.NLit(42)) with | (bodyId, t1) =>
    (match add-node(t1, Node.NApp(bodyId, 0 - 1)) with | (root, tree) =>
      (match lower-tree(tree, root) with
        | Option.Some(c) => (if is-cnum(c, 42) then unit else trap("nullary NApp inlines the body → CNum 42"))
        | Option.None(_) => trap("a nullary NApp lowers to its inlined body Core"))))

@test
def lw-napp-with-arg-still-no-core() =
  // a call WITH an arg (argId != -1) is the param slice (not yet) → no core form. Pins the nullary/param boundary.
  (match add-node(empty-tree(), Node.NLit(7)) with | (bodyId, t1) =>
    (match add-node(t1, Node.NLit(5)) with | (argId, t2) =>
      (match add-node(t2, Node.NApp(bodyId, argId)) with | (root, tree) =>
        (match lower-tree(tree, root) with | Option.None(_) => unit | Option.Some(_) => trap("a call WITH an arg has no core until the param slice")))))

export { Core.*, lower-tree, lower-node, cnum64, is-cnum, is-cnum-w, is-cvar }
