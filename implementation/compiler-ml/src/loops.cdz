/// loops.cdz — NATURAL-LOOP detection over a control-flow graph, the analysis LICM and loop unrolling
/// build on. Loops are found from BACK EDGES: an edge `s → t` is a back edge iff its target `t` DOMINATES
/// its source `s` (every path to `s` already passed through `t`, so `s → t` closes a loop with header `t`).
/// The NATURAL LOOP of a back edge `s → t` is `{t} ∪ {every block that can reach s without going through
/// t}` — the header plus the body that flows back to it.
///
/// Dominance is computed the way `dominators.cdz` does — `d` dominates `n` iff removing `d` makes `n`
/// unreachable from the entry (`reach-avoiding`). The loop body is collected by a BACKWARD worklist from
/// the tail `s` over PREDECESSORS, stopping at the header `t` (so it never escapes above the loop).
///
///   - `is-back-edge entry s t`   — does edge `s → t` close a loop (t dominates s)?
///   - `back-edge-count entry`    — how many back edges the graph has (≈ number of loops).
///   - `is-loop-header entry h`   — is `h` the target of some back edge (a loop entry)?
///   - `natural-loop entry s t`   — the set of block ids in the loop of back edge `s → t`.
///   - `loop-body-size`           — its cardinality.

type Term =
  | Return
  | Jump(Int64)
  | CondJump(Int64, Int64)

type Block =
  | Blk(Int64, Term)

def succs(t: Term) = match t with
  | Term.Return => []
  | Term.Jump(a) => [a]
  | Term.CondJump(a, b) => [a, b]

def find-block(bs: List(Block), id: Int64) = match bs with
  | [] => Option.None(unit)
  | [b, .. r] => (match b with | Block.Blk(i, t) => if i == id then Option.Some(t) else find-block(r, id))

def list-has(xs: List(Int64), y: Int64) = match xs with
  | [] => false
  | [h, .. t] => if h == y then true else list-has(t, y)

/// Reachability from the entry treating `avoid` as removed (`avoid = -1` removes nothing).
def reach-avoiding(bs: List(Block), avoid: Int64, work: List(Int64), seen: Set(Int64)) = match work with
  | [] => seen
  | [id, .. rest] =>
    if id == avoid then reach-avoiding(bs, avoid, rest, seen)
    else (if Set.contains(seen, id) then reach-avoiding(bs, avoid, rest, seen)
      else (match find-block(bs, id) with
        | Option.None(_) => reach-avoiding(bs, avoid, rest, Set.insert(seen, id))
        | Option.Some(t) => reach-avoiding(bs, avoid, List.concat(succs(t), rest), Set.insert(seen, id))))

/// `d` dominates `n`: every block dominates itself; else removing `d` makes `n` unreachable.
def dominates(bs: List(Block), entry: Int64, d: Int64, n: Int64) =
  if d == n then true
  else Set.contains(reach-avoiding(bs, d, [entry], Set.of([])), n) == false

/// Is edge `s → t` a back edge — i.e. does the target `t` dominate the source `s`?
def is-back-edge(bs: List(Block), entry: Int64, s: Int64, t: Int64) = dominates(bs, entry, t, s)

/// Predecessors of `n` — blocks whose terminator lists `n` as a successor.
def preds-of(rest: List(Block), n: Int64, acc: List(Int64)) = match rest with
  | [] => acc
  | [b, .. more] => (match b with | Block.Blk(id, t) =>
    preds-of(more, n, (if list-has(succs(t), n) then List.concat([id], acc) else acc)))

/// Collect the natural loop backward from the current worklist, stopping at `header` (never crossing it).
def collect-loop(bs: List(Block), header: Int64, work: List(Int64), seen: Set(Int64)) = match work with
  | [] => seen
  | [n, .. rest] =>
    if Set.contains(seen, n) then collect-loop(bs, header, rest, seen)
    else (let seen2 = Set.insert(seen, n) in
      if n == header then collect-loop(bs, header, rest, seen2)
      else collect-loop(bs, header, List.concat(preds-of(bs, n, []), rest), seen2))

/// The set of block ids in the natural loop of back edge `s → t` (`{t}` + blocks reaching `s` without
/// crossing `t`). Seeds `seen` with the header so the backward walk stops there.
def natural-loop(bs: List(Block), entry: Int64, s: Int64, t: Int64) =
  collect-loop(bs, t, [s], Set.insert(Set.of([]), t))

def loop-body-size(bs: List(Block), entry: Int64, s: Int64, t: Int64) =
  Set.len(natural-loop(bs, entry, s, t))

/// Count the back edges in the graph (scan every edge `s → t` for the dominance property).
def back-edge-count(bs: List(Block), entry: Int64) = bec(bs, bs, entry, 0)

def bec(all: List(Block), rest: List(Block), entry: Int64, acc: Int64) = match rest with
  | [] => acc
  | [b, .. more] => (match b with | Block.Blk(s, t) => bec(all, more, entry, acc + bec-succs(all, entry, s, succs(t), 0)))

def bec-succs(all: List(Block), entry: Int64, s: Int64, ss: List(Int64), acc: Int64) = match ss with
  | [] => acc
  | [t, .. rest] => bec-succs(all, entry, s, rest, (if is-back-edge(all, entry, s, t) then acc + 1 else acc))

/// Is `h` a loop header — the target of some back edge?
def is-loop-header(bs: List(Block), entry: Int64, h: Int64) = ilh(bs, bs, entry, h)

def ilh(all: List(Block), rest: List(Block), entry: Int64, h: Int64) = match rest with
  | [] => false
  | [b, .. more] => (match b with | Block.Blk(s, t) =>
    if list-has(succs(t), h) and is-back-edge(all, entry, s, h) then true else ilh(all, more, entry, h))

/// Builders.
def blk(id: Int64, t: Term) = Block.Blk(id, t)

@test
def loop-self-back-edge() =
  // 0→1; 1→cond(1,2); 2→ret. Edge 1→1: 1 dominates 1 → back edge. count 1.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.CondJump(1, 2)), blk(2, Term.Return)] in
  if is-back-edge(bs, 0, 1, 1) then (if back-edge-count(bs, 0) == 1 then unit else trap("one back edge")) else trap("1→1 is a back edge")

@test
def loop-no-back-edge-in-dag() =
  // a DAG (diamond) has NO back edges.
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Jump(3)), blk(2, Term.Jump(3)), blk(3, Term.Return)] in
  if back-edge-count(bs, 0) == 0 then unit else trap("a DAG has no back edges")

@test
def loop-forward-edge-not-back() =
  // 0→1→2: edge 1→2 is FORWARD (2 does not dominate 1) → not a back edge.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.Jump(2)), blk(2, Term.Return)] in
  if is-back-edge(bs, 0, 1, 2) then trap("1→2 is forward, not a back edge") else unit

@test
def loop-body-two-blocks() =
  // 0→1; 1→cond(2,3); 2→jump 1 (back edge 2→1); 3→ret. Natural loop of 2→1 = {1, 2}.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.CondJump(2, 3)), blk(2, Term.Jump(1)), blk(3, Term.Return)] in
  if is-back-edge(bs, 0, 2, 1) then
    (let body = natural-loop(bs, 0, 2, 1) in
     if Set.len(body) == 2 then (if Set.contains(body, 1) then (if Set.contains(body, 2) then unit else trap("2 in loop")) else trap("header 1 in loop")) else trap("body size 2"))
  else trap("2→1 is a back edge")

@test
def loop-body-excludes-exit() =
  // in the above, block 3 (the loop EXIT) is NOT in the loop body.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.CondJump(2, 3)), blk(2, Term.Jump(1)), blk(3, Term.Return)] in
  let body = natural-loop(bs, 0, 2, 1) in
  if Set.contains(body, 3) then trap("the exit block 3 is not in the loop") else unit

@test
def loop-header-detected() =
  // block 1 is a loop header (target of back edge 2→1); block 0 is not.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.CondJump(2, 3)), blk(2, Term.Jump(1)), blk(3, Term.Return)] in
  if is-loop-header(bs, 0, 1) then (if is-loop-header(bs, 0, 0) then trap("entry is not a loop header") else unit) else trap("block 1 is a loop header")

@test
def loop-nested-body() =
  // 0→1; 1→cond(2,4); 2→cond(3, back? no) ... build a body with 3 blocks in the loop:
  // 0→1(header); 1→cond(2,4); 2→jump 3; 3→jump 1 (back edge 3→1); 4→ret. loop {1,2,3}.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.CondJump(2, 4)), blk(2, Term.Jump(3)), blk(3, Term.Jump(1)), blk(4, Term.Return)] in
  if is-back-edge(bs, 0, 3, 1) then
    (let body = natural-loop(bs, 0, 3, 1) in
     if Set.len(body) == 3 then (if Set.contains(body, 2) then unit else trap("2 in body")) else trap("body {1,2,3} size 3"))
  else trap("3→1 back edge")

@test
def loop-two-loops-counted() =
  // two separate self-loops: 0→1; 1→cond(1, 2); 2→cond(2, 3); 3→ret. back edges 1→1 and 2→2 → 2.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.CondJump(1, 2)), blk(2, Term.CondJump(2, 3)), blk(3, Term.Return)] in
  if back-edge-count(bs, 0) == 2 then unit else trap("two back edges")

@test
def loop-header-dominates-body() =
  // sanity linking to dominance: the header dominates every block in its loop body. Loop {1,2} of 2→1;
  // header 1 dominates 2.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.CondJump(2, 3)), blk(2, Term.Jump(1)), blk(3, Term.Return)] in
  if dominates(bs, 0, 1, 2) then unit else trap("the loop header dominates its body")

export { is-back-edge, back-edge-count, natural-loop, loop-body-size, is-loop-header }
