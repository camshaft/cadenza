/// apply-ty.cdz — the function-application step of a type checker: given a function type `TFun(a, b)`
/// and an argument type, does the argument match the domain (structurally), and if so what is the result
/// type? `apply-fun` returns `Option Ty` — `Some b` when `arg` structurally equals `a`, else `None`.
/// `chain2` applies a curried function to two arguments, threading the `Option` (a `None` at any step
/// short-circuits). This exercises RECURSIVE STRUCTURAL type equality (`ty-eq` descends both `TFun`
/// arms) and Option-chained fallible application — the plumbing a real type checker's application rule
/// uses.
type Ty =
  | TInt
  | TBool
  | TFun(Ty, Ty)

/// A scalar tag per type constructor. A top-level match maps each variant to an Int64 — used so `ty-eq`
/// compares nullary types by TAG rather than a NESTED nullary match, which the ML reader currently
/// mis-parses (`repros/reject-ml-nullary-variant-pattern-in-nested-match.cdz`).
def tag(t: Ty) = match t with
  | Ty.TInt => 0
  | Ty.TBool => 1
  | Ty.TFun(_, _) => 2

/// Structural equality of two types (recursively over `TFun`). Nullary variants compare by `tag`; only
/// the payload-carrying `TFun` needs a nested match — which is fine because its pattern is non-nullary.
def ty-eq(x: Ty, y: Ty) = match x with
  | Ty.TFun(a, b) => (match y with
    | Ty.TFun(c, d) => (if ty-eq(a, c) then ty-eq(b, d) else false)
    | _ => false)
  | _ => tag(x) == tag(y)

/// Apply a function type to an argument type: `Some result` if the argument matches the domain, else `None`.
def apply-fun(f: Ty, arg: Ty) = match f with
  | Ty.TFun(a, b) => (if ty-eq(a, arg) then Option.Some(b) else Option.None(unit))
  | _ => Option.None(unit)

/// Apply a curried `f` to two arguments, threading the `Option` (short-circuit on the first `None`).
def chain2(f: Ty, a1: Ty, a2: Ty) = match apply-fun(f, a1) with
  | Option.Some(g) => apply-fun(g, a2)
  | Option.None(_) => Option.None(unit)

def is-some(o: Option(Ty)) = match o with
  | Option.Some(_) => true
  | Option.None(_) => false

/// The result of `apply-fun` as a concrete tag: -1 = None, else the applied type's `tag` (0/1/2).
def result-tag(o: Option(Ty)) = match o with
  | Option.None(_) => 0 - 1
  | Option.Some(t) => tag(t)

@test
def ty-eq-int() = if ty-eq(Ty.TInt, Ty.TInt) then unit else trap("Int == Int")

@test
def ty-eq-int-bool() = if ty-eq(Ty.TInt, Ty.TBool) then trap("Int != Bool") else unit

@test
def ty-eq-fun-same() =
  // (Int -> Bool) == (Int -> Bool)
  let f = Ty.TFun(Ty.TInt, Ty.TBool) in
  if ty-eq(f, f) then unit else trap("fun equals itself")

@test
def ty-eq-fun-differ-domain() =
  // (Int -> Bool) != (Bool -> Bool)
  if ty-eq(Ty.TFun(Ty.TInt, Ty.TBool), Ty.TFun(Ty.TBool, Ty.TBool)) then trap("domains differ") else unit

@test
def ty-eq-nested-fun() =
  // (Int -> (Int -> Bool)) == itself, but != (Int -> (Bool -> Bool))
  let f = Ty.TFun(Ty.TInt, Ty.TFun(Ty.TInt, Ty.TBool)) in
  let g = Ty.TFun(Ty.TInt, Ty.TFun(Ty.TBool, Ty.TBool)) in
  if ty-eq(f, f) then (if ty-eq(f, g) then trap("nested differ") else unit) else trap("nested equal")

@test
def apply-match() =
  // (Int -> Bool) applied to Int → Some Bool (tag 1)
  if result-tag(apply-fun(Ty.TFun(Ty.TInt, Ty.TBool), Ty.TInt)) == 1 then unit else trap("apply Int → Bool")

@test
def apply-mismatch() =
  // (Int -> Bool) applied to Bool → None (tag -1)
  if result-tag(apply-fun(Ty.TFun(Ty.TInt, Ty.TBool), Ty.TBool)) == 0 - 1 then unit else trap("wrong arg → None")

@test
def apply-non-function() =
  // applying a non-function → None
  if is-some(apply-fun(Ty.TInt, Ty.TInt)) then trap("Int is not applicable") else unit

@test
def chain2-both-match() =
  // f : Int -> (Int -> Bool); apply Int then Int → Some Bool
  let f = Ty.TFun(Ty.TInt, Ty.TFun(Ty.TInt, Ty.TBool)) in
  if result-tag(chain2(f, Ty.TInt, Ty.TInt)) == 1 then unit else trap("chain both Int → Bool")

@test
def chain2-first-fails() =
  // first arg wrong → None (short-circuits before the second application)
  let f = Ty.TFun(Ty.TInt, Ty.TFun(Ty.TInt, Ty.TBool)) in
  if is-some(chain2(f, Ty.TBool, Ty.TInt)) then trap("first arg wrong → None") else unit

@test
def chain2-second-fails() =
  // first ok, second wrong → None
  let f = Ty.TFun(Ty.TInt, Ty.TFun(Ty.TInt, Ty.TBool)) in
  if is-some(chain2(f, Ty.TInt, Ty.TBool)) then trap("second arg wrong → None") else unit

export { ty-eq, apply-fun, chain2 }
