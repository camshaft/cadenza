type Ast =
  | Int(Int64)
  | Str(String)
  | Bool(Bool)
  | Name(String)
  | List(List(Ast))

def violations(tbl: Map(String, Int64), node: Ast) = match node with
  | Ast.List(es) => form-violation(tbl, es) + violations-list(tbl, es)
  | _ => 0

def violations-list(tbl: Map(String, Int64), es: List(Ast)) = match es with
  | [] => 0
  | [h, .. r] => violations(tbl, h) + violations-list(tbl, r)

def form-violation(tbl: Map(String, Int64), es: List(Ast)) = match es with
  | [] => 0
  | [h, .. args] => match h with
    | Ast.Name(op) => (match Map.lookup(tbl, op) with
      | Option.Some(declared) => (if list-len(args) == declared then 0 else 1)
      | Option.None(_) => 0
    )
    | _ => 0

def list-len(xs: List(Ast)) = match xs with
  | [] => 0
  | [_, .. r] => 1 + list-len(r)

def tbl() = Map.insert(Map.insert(#{}, "+", 2), "neg", 1)

@test
def ok-binary-plus() =
  if violations(tbl(), Ast.List([Ast.Name("+"), Ast.Int(1), Ast.Int(2)])) == 0 then
    unit
  else
    trap("+ 1 2 ok")

@test
def bad-plus-arity() =
  if violations(tbl(), Ast.List([Ast.Name("+"), Ast.Int(1)])) == 1 then
    unit
  else
    trap("+ 1 is 1 violation")

@test
def unknown-op-ok() =
  if violations(tbl(), Ast.List([Ast.Name("foo"), Ast.Int(1), Ast.Int(2), Ast.Int(3)])) == 0 then
    unit
  else
    trap("unknown op no violation")

@test
def unary-neg-ok() =
  if violations(tbl(), Ast.List([Ast.Name("neg"), Ast.Int(5)])) == 0 then unit else trap("neg 5 ok")

@test
def unary-neg-bad() =
  if violations(tbl(), Ast.List([Ast.Name("neg"), Ast.Int(5), Ast.Int(6)])) == 1 then
    unit
  else
    trap("neg 5 6 is 1 violation")

@test
def nested-violations() =
  if violations(tbl(), Ast.List([Ast.Name("+"), Ast.List([Ast.Name("neg")]), Ast.Int(2)])) == 1 then
    unit
  else
    trap("inner (neg) with 0 args = 1 violation")

@test
def leaf-no-violation() = if violations(tbl(), Ast.Int(42)) == 0 then unit else trap("leaf ok")

@test
def two-violations() =
  if violations(tbl(), Ast.List([Ast.Name("+"), Ast.List([Ast.Name("+"), Ast.Int(1)])])) == 2 then
    unit
  else
    trap("(+ (+ 1)) = outer arity 1 + inner arity 1 = 2")

export { violations }
