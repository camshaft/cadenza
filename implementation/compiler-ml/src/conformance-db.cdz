/// conformance-db.cdz — Increment 6 (gate-integration) of the Cadenza-in-Cadenza compiler: the CONFORMANCE
/// SCOREBOARD, in Cadenza. This is the Cadenza-side substrate the operator's gate addition needs: a CORPUS
/// of integer programs paired with their EXPECTED outcomes, plus a RUNNER that drives each through the whole
/// lazy-query-DB pipeline (`eval-db.run`) and reports conformance as a count — `X / N` passing.
///
/// The point (rcdzc's bootstrap strategy): start LOW and CLIMB. Each case is `(tokens, Expect)`; widening the
/// language = ADDING cases (and, when a case fails, fixing the column that made it fail). The scoreboard is
/// the driver — `conformance()` returns `(passed, total)`, and a case's expectation is one of:
///   - `Runs(v)`   — the program is well-typed and evaluates to `v`.
///   - `Declines`  — the program is ill-typed (unbound name / etc.) so it has NO core form and does not run.
/// A case PASSES when the pipeline's actual `Option(Int64)` matches its `Expect` (Some v == Runs v; None ==
/// Declines). This mirrors the real corpus's pass/decline/miscompile grading, scoped to the integer subset.
///
/// The Rust-side wiring — a `cadenza-ml` `cargo xtask gate` TARGET that invokes this and prints `X/N` — is
/// COORDINATED WITH v-fleet-tooling (they own `xtask`/gate plumbing). This module is the conformance ENGINE
/// that target calls; keeping it in Cadenza means the scoreboard itself is dogfooded and grows with the tests.

import { Tok } from "parse-db"
import { run } from "eval-db"

/// The expected outcome of a corpus case.
type Expect =
  | Runs(Int64)     // well-typed, evaluates to this value
  | Declines        // ill-typed (no core form) — does not run

/// A conformance case: a token program and its expected outcome.
type Case =
  | Case(List(Tok), Expect)

/// Does the pipeline's actual result for `ts` match `exp`? `Some v` matches `Runs v`; `None` matches
/// `Declines`. Any other pairing (ran-but-wrong-value, ran-when-should-decline, declined-when-should-run) is
/// a FAIL — the miscompile/mismatch the real gate catches, scoped here to the integer subset.
def case-passes(ts: List(Tok), exp: Expect) = match run(ts) with
  | Option.Some(v) => (match exp with | Expect.Runs(w) => v == w | Expect.Declines => false)
  | Option.None(_) => (match exp with | Expect.Declines => true | Expect.Runs(_) => false)

/// Does a `Case` pass?
def check-case(c: Case) = match c with | Case.Case(ts, exp) => case-passes(ts, exp)

/// Count how many of `cases` pass (from index `i`, accumulating into `acc`) — the scoreboard's core fold.
def count-passing(cases: List(Case), i: Int64, acc: Int64) =
  (if i == List.len(cases) then acc
   else (match List.at(cases, i) with
     | Option.Some(c) => count-passing(cases, i + 1, (if check-case(c) then acc + 1 else acc))
     | Option.None(_) => acc))

// ---- The corpus (integer subset). Op codes: 43 +, 45 -, 42 *. name-id 1 = x, 2 = y. ----

/// `5` → Runs 5.
def c-literal() = Case.Case([Tok.TNum(5)], Expect.Runs(5))
/// `1 + 2` → Runs 3.
def c-add() = Case.Case([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2)], Expect.Runs(3))
/// `10 - 3` → Runs 7.
def c-sub() = Case.Case([Tok.TNum(10), Tok.TOp(45), Tok.TNum(3)], Expect.Runs(7))
/// `4 * 6` → Runs 24.
def c-mul() = Case.Case([Tok.TNum(4), Tok.TOp(42), Tok.TNum(6)], Expect.Runs(24))
/// `1 + 2 * 3` → Runs 7 (precedence).
def c-precedence() = Case.Case([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2), Tok.TOp(42), Tok.TNum(3)], Expect.Runs(7))
/// `let x = 2 in x` → Runs 2.
def c-let-trivial() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(2), Tok.TIn, Tok.TName(1)], Expect.Runs(2))
/// THE MILESTONE `let x = 2 in x * 3 + 1` → Runs 7.
def c-milestone() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(2), Tok.TIn, Tok.TName(1), Tok.TOp(42), Tok.TNum(3), Tok.TOp(43), Tok.TNum(1)], Expect.Runs(7))
/// `let x = 1 in let y = 2 in x + y` → Runs 3 (nested lets).
def c-nested-lets() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(1), Tok.TIn, Tok.TLet, Tok.TName(2), Tok.TEq, Tok.TNum(2), Tok.TIn, Tok.TName(1), Tok.TOp(43), Tok.TName(2)], Expect.Runs(3))
/// `let x = 1 in let x = 2 in x` → Runs 2 (shadowing).
def c-shadowing() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(1), Tok.TIn, Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(2), Tok.TIn, Tok.TName(1)], Expect.Runs(2))
/// `x` (unbound) → Declines.
def c-unbound-declines() = Case.Case([Tok.TName(1)], Expect.Declines)
/// `x + 1` (unbound x) → Declines.
def c-unbound-in-arith-declines() = Case.Case([Tok.TName(1), Tok.TOp(43), Tok.TNum(1)], Expect.Declines)
/// `1 < 2` → Runs 1 (comparison true = 1).
def c-lt-true() = Case.Case([Tok.TNum(1), Tok.TOp(60), Tok.TNum(2)], Expect.Runs(1))
/// `5 < 2` → Runs 0 (comparison false).
def c-lt-false() = Case.Case([Tok.TNum(5), Tok.TOp(60), Tok.TNum(2)], Expect.Runs(0))
/// `3 == 3` → Runs 1.
def c-eq-true() = Case.Case([Tok.TNum(3), Tok.TOp(61), Tok.TNum(3)], Expect.Runs(1))
/// `3 == 4` → Runs 0.
def c-eq-false() = Case.Case([Tok.TNum(3), Tok.TOp(61), Tok.TNum(4)], Expect.Runs(0))
/// `1 + 2 < 4` → Runs 1 (comparison looser than additive).
def c-cmp-of-arith() = Case.Case([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2), Tok.TOp(60), Tok.TNum(4)], Expect.Runs(1))
/// `let b = 2 < 3 in b` → Runs 1 (a Bool-valued binding).
def c-let-bool() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(2), Tok.TOp(60), Tok.TNum(3), Tok.TIn, Tok.TName(1)], Expect.Runs(1))
/// `if 1 < 2 then 10 else 20` → Runs 10 (cond true).
def c-if-then() = Case.Case([Tok.TIf, Tok.TNum(1), Tok.TOp(60), Tok.TNum(2), Tok.TThen, Tok.TNum(10), Tok.TElse, Tok.TNum(20)], Expect.Runs(10))
/// `if 5 < 2 then 10 else 20` → Runs 20 (cond false).
def c-if-else() = Case.Case([Tok.TIf, Tok.TNum(5), Tok.TOp(60), Tok.TNum(2), Tok.TThen, Tok.TNum(10), Tok.TElse, Tok.TNum(20)], Expect.Runs(20))
/// `let x = 3 in if x == 3 then x * 2 else 0` → Runs 6 (var in cond + taken branch).
def c-if-with-let() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(3), Tok.TIn, Tok.TIf, Tok.TName(1), Tok.TOp(61), Tok.TNum(3), Tok.TThen, Tok.TName(1), Tok.TOp(42), Tok.TNum(2), Tok.TElse, Tok.TNum(0)], Expect.Runs(6))
/// `if 5 < 1 then 100 else if 5 < 10 then 200 else 300` → Runs 200 (else-if chain).
def c-if-nested-else() = Case.Case([Tok.TIf, Tok.TNum(5), Tok.TOp(60), Tok.TNum(1), Tok.TThen, Tok.TNum(100), Tok.TElse, Tok.TIf, Tok.TNum(5), Tok.TOp(60), Tok.TNum(10), Tok.TThen, Tok.TNum(200), Tok.TElse, Tok.TNum(300)], Expect.Runs(200))
/// `if 1 then 10 else 20` → Declines (non-Bool condition is ill-typed).
def c-if-nonbool-cond-declines() = Case.Case([Tok.TIf, Tok.TNum(1), Tok.TThen, Tok.TNum(10), Tok.TElse, Tok.TNum(20)], Expect.Declines)
/// `if 1 < 2 then 10 else 3 < 4` → Declines (branch types mismatch: Int vs Bool).
def c-if-branch-mismatch-declines() = Case.Case([Tok.TIf, Tok.TNum(1), Tok.TOp(60), Tok.TNum(2), Tok.TThen, Tok.TNum(10), Tok.TElse, Tok.TNum(3), Tok.TOp(60), Tok.TNum(4)], Expect.Declines)
/// `if true then 42 else 0` → Runs 42 (bool literal condition).
def c-if-true-literal() = Case.Case([Tok.TIf, Tok.TBoolTok(1), Tok.TThen, Tok.TNum(42), Tok.TElse, Tok.TNum(0)], Expect.Runs(42))
/// `if false then 42 else 7` → Runs 7.
def c-if-false-literal() = Case.Case([Tok.TIf, Tok.TBoolTok(0), Tok.TThen, Tok.TNum(42), Tok.TElse, Tok.TNum(7)], Expect.Runs(7))
/// `let b = true in if b then 5 else 6` → Runs 5 (bool literal bound + read as condition).
def c-let-bool-literal() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TBoolTok(1), Tok.TIn, Tok.TIf, Tok.TName(1), Tok.TThen, Tok.TNum(5), Tok.TElse, Tok.TNum(6)], Expect.Runs(5))
/// `true + 1` → Declines (bool operand to arithmetic is ill-typed).
def c-bool-in-arith-declines() = Case.Case([Tok.TBoolTok(1), Tok.TOp(43), Tok.TNum(1)], Expect.Declines)
/// `-5` → Runs -5 (unary minus desugars to 0 - 5).
def c-unary-minus() = Case.Case([Tok.TNeg, Tok.TNum(5)], Expect.Runs(0 - 5))
/// `10 + -3` → Runs 7 (unary minus as an operand).
def c-unary-minus-in-arith() = Case.Case([Tok.TNum(10), Tok.TOp(43), Tok.TNeg, Tok.TNum(3)], Expect.Runs(7))
/// `- -5` → Runs 5 (double negation).
def c-double-negation() = Case.Case([Tok.TNeg, Tok.TNeg, Tok.TNum(5)], Expect.Runs(5))
/// `3 > 2` → Runs 1.
def c-gt() = Case.Case([Tok.TNum(3), Tok.TOp(62), Tok.TNum(2)], Expect.Runs(1))
/// `2 <= 2` → Runs 1.
def c-le() = Case.Case([Tok.TNum(2), Tok.TOp(63), Tok.TNum(2)], Expect.Runs(1))
/// `2 >= 3` → Runs 0.
def c-ge() = Case.Case([Tok.TNum(2), Tok.TOp(64), Tok.TNum(3)], Expect.Runs(0))
/// `3 != 4` → Runs 1.
def c-ne() = Case.Case([Tok.TNum(3), Tok.TOp(65), Tok.TNum(4)], Expect.Runs(1))
/// `if 5 >= 5 then 1 else 0` → Runs 1 (a new relational op as an if condition).
def c-rel-in-if() = Case.Case([Tok.TIf, Tok.TNum(5), Tok.TOp(64), Tok.TNum(5), Tok.TThen, Tok.TNum(1), Tok.TElse, Tok.TNum(0)], Expect.Runs(1))
/// `true > 2` → Declines (a relational op needs Int operands).
def c-bool-rel-declines() = Case.Case([Tok.TBoolTok(1), Tok.TOp(62), Tok.TNum(2)], Expect.Declines)
/// `8 / 2` → Runs 4.
def c-div() = Case.Case([Tok.TNum(8), Tok.TOp(47), Tok.TNum(2)], Expect.Runs(4))
/// `5 / 0` → Declines (divide-by-zero: run yields None, matching the Declines expectation).
def c-div-by-zero() = Case.Case([Tok.TNum(5), Tok.TOp(47), Tok.TNum(0)], Expect.Declines)
/// `7 % 3` → Runs 1.
def c-mod() = Case.Case([Tok.TNum(7), Tok.TOp(37), Tok.TNum(3)], Expect.Runs(1))
/// `1 + 8 / 2` → Runs 5 (division tighter than addition).
def c-div-precedence() = Case.Case([Tok.TNum(1), Tok.TOp(43), Tok.TNum(8), Tok.TOp(47), Tok.TNum(2)], Expect.Runs(5))
/// `true / 2` → Declines (division needs Int operands).
def c-bool-div-declines() = Case.Case([Tok.TBoolTok(1), Tok.TOp(47), Tok.TNum(2)], Expect.Declines)

// ---- COMPOUND programs: cross-feature interactions the per-feature cases don't cover. Pure corpus
// additions (no grammar change) — exercise precedence across tiers, nested let/if, division-in-conditions. ----
/// `let x = 10 in let y = 3 in x - y * 2` → 10 - (3*2) = 4 (nested let + precedence in the body).
def c-cx-nested-let-precedence() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(10), Tok.TIn, Tok.TLet, Tok.TName(2), Tok.TEq, Tok.TNum(3), Tok.TIn, Tok.TName(1), Tok.TOp(45), Tok.TName(2), Tok.TOp(42), Tok.TNum(2)], Expect.Runs(4))
/// `if 2 + 3 < 10 then 100 else 200` → (5 < 10) → 100 (arithmetic under a comparison under an if-cond).
def c-cx-arith-in-cond() = Case.Case([Tok.TIf, Tok.TNum(2), Tok.TOp(43), Tok.TNum(3), Tok.TOp(60), Tok.TNum(10), Tok.TThen, Tok.TNum(100), Tok.TElse, Tok.TNum(200)], Expect.Runs(100))
/// `let n = 7 in if n % 2 == 0 then 0 else 1` → 7%2=1, 1==0 false → 1 (modulo + equality + let-var in cond).
def c-cx-mod-parity() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(7), Tok.TIn, Tok.TIf, Tok.TName(1), Tok.TOp(37), Tok.TNum(2), Tok.TOp(61), Tok.TNum(0), Tok.TThen, Tok.TNum(0), Tok.TElse, Tok.TNum(1)], Expect.Runs(1))
/// `let a = 4 in let b = a * a in b + a` → b=16, 16+4=20 (a var used in a later binding's value).
def c-cx-var-in-later-binding() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(4), Tok.TIn, Tok.TLet, Tok.TName(2), Tok.TEq, Tok.TName(1), Tok.TOp(42), Tok.TName(1), Tok.TIn, Tok.TName(2), Tok.TOp(43), Tok.TName(1)], Expect.Runs(20))
/// `let x = 20 in x / (2 + 3)` → 20 / 5 = 4. This compound-depth-3 shape (let → div → PAREN-add) was the
/// bug#4 witness — a parenthesised sub-expression under a let (an NBin whose RIGHT operand is itself an
/// NBin) drove infer-node's NBin arm into a non-terminating recompute (a match/pattern binder `t2` bound
/// from a RECURSIVE call, used twice, re-emitted the call per use → 2^depth). FIXED by rcdzc 26e3471ac
/// (materialize a recursive-call match scrutinee once). UN-QUARANTINED: it now computes 4 at full-module
/// scale (verified full conformance-db suite 60/0). See [[paren-if-in-then-wrong-value-likely-seed-miscompile-not-parse-db]].
def c-cx-div-paren-divisor() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(20), Tok.TIn, Tok.TName(1), Tok.TOp(47), Tok.TLParen, Tok.TNum(2), Tok.TOp(43), Tok.TNum(3), Tok.TRParen], Expect.Runs(4))
/// `let flag = 5 > 3 in if flag then 1 else 0` → flag=true → 1 (a Bool-valued let read as an if-condition).
def c-cx-bool-let-as-cond() = Case.Case([Tok.TLet, Tok.TName(1), Tok.TEq, Tok.TNum(5), Tok.TOp(62), Tok.TNum(3), Tok.TIn, Tok.TIf, Tok.TName(1), Tok.TThen, Tok.TNum(1), Tok.TElse, Tok.TNum(0)], Expect.Runs(1))
/// `(1 + 2) * 3` → 9 (parens OVERRIDE precedence: without them `1 + 2 * 3` = 7). The end-to-end pin that
/// a parenthesised sub-expression regroups the tree — the eval-side companion of `pd-parens-override`.
def c-cx-paren-overrides-precedence() = Case.Case([Tok.TLParen, Tok.TNum(1), Tok.TOp(43), Tok.TNum(2), Tok.TRParen, Tok.TOp(42), Tok.TNum(3)], Expect.Runs(9))
/// `2 * (3 + 4)` → 14 (parens on the RIGHT operand of a higher-precedence op).
def c-cx-paren-right-operand() = Case.Case([Tok.TNum(2), Tok.TOp(42), Tok.TLParen, Tok.TNum(3), Tok.TOp(43), Tok.TNum(4), Tok.TRParen], Expect.Runs(14))
/// `10 - 3 - 2` → 5 (subtraction is LEFT-associative: `(10-3)-2`=5, not `10-(3-2)`=9). Pins associativity
/// of a same-precedence chain, which the single-op `c-sub` doesn't exercise.
def c-cx-sub-left-assoc() = Case.Case([Tok.TNum(10), Tok.TOp(45), Tok.TNum(3), Tok.TOp(45), Tok.TNum(2)], Expect.Runs(5))
/// `1 + 7 % 2` → 2 (modulo binds TIGHTER than addition: `1 + (7%2)` = 1+1 = 2). The `%`-precedence companion
/// of `c-div-precedence` (the corpus pinned `/` vs `+` but not `%` vs `+`).
def c-cx-mod-precedence() = Case.Case([Tok.TNum(1), Tok.TOp(43), Tok.TNum(7), Tok.TOp(37), Tok.TNum(2)], Expect.Runs(2))
/// `4 + 6 % 3` → 4 (mod tighter: `4 + (6%3)` = 4+0 = 4 — NOT `(4+6)%3`=1). A second `%`-precedence pin whose
/// operands make the two parses differ in value, so it genuinely distinguishes the precedence.
def c-cx-mod-precedence-distinguishes() = Case.Case([Tok.TNum(4), Tok.TOp(43), Tok.TNum(6), Tok.TOp(37), Tok.TNum(3)], Expect.Runs(4))
/// `-12 / 4` → -3 (unary minus on the dividend: `(0-12)/4` = -3). Division with a negated operand.
def c-cx-neg-dividend() = Case.Case([Tok.TNeg, Tok.TNum(12), Tok.TOp(47), Tok.TNum(4)], Expect.Runs(0 - 3))
/// `7 % 0` → Declines (modulo-by-zero yields None, like div-by-zero — the trap-free absent outcome). The
/// `c-div-by-zero` companion for `%`, which the corpus didn't pin.
def c-cx-mod-by-zero-declines() = Case.Case([Tok.TNum(7), Tok.TOp(37), Tok.TNum(0)], Expect.Declines)
/// `((5))` → 5 (redundant NESTED parens collapse to the inner literal — the paren-nests-full-grammar recursion).
/// QUARANTINED-from-corpus repro (see the comment block below): kept as the root-cause reproducer for the
/// open nested-paren hang (bug #4, v-inference). NOT dead — intentionally retained. Leading `_` marks it
/// as deliberately-not-in-`corpus()`.
def _c-cx-nested-redundant-parens() = Case.Case([Tok.TLParen, Tok.TLParen, Tok.TNum(5), Tok.TRParen, Tok.TRParen], Expect.Runs(5))

/// THE CORPUS: every conformance case. Widening the language = appending here (start-low-and-climb).
def corpus() = [
  c-literal(), c-add(), c-sub(), c-mul(), c-precedence(),
  c-let-trivial(), c-milestone(), c-nested-lets(), c-shadowing(),
  c-unbound-declines(), c-unbound-in-arith-declines(),
  c-lt-true(), c-lt-false(), c-eq-true(), c-eq-false(), c-cmp-of-arith(), c-let-bool(),
  c-if-then(), c-if-else(), c-if-with-let(), c-if-nested-else(),
  c-if-nonbool-cond-declines(), c-if-branch-mismatch-declines(),
  c-if-true-literal(), c-if-false-literal(), c-let-bool-literal(), c-bool-in-arith-declines(),
  c-unary-minus(), c-unary-minus-in-arith(), c-double-negation(),
  c-gt(), c-le(), c-ge(), c-ne(), c-rel-in-if(), c-bool-rel-declines(),
  c-div(), c-div-by-zero(), c-mod(), c-div-precedence(), c-bool-div-declines(),
  c-cx-nested-let-precedence(), c-cx-arith-in-cond(), c-cx-mod-parity(), c-cx-var-in-later-binding(),
  c-cx-bool-let-as-cond(), c-cx-div-paren-divisor(),
  c-cx-paren-overrides-precedence(), c-cx-paren-right-operand(),
  c-cx-sub-left-assoc(), c-cx-mod-precedence(), c-cx-mod-precedence-distinguishes(),
  c-cx-neg-dividend(), c-cx-mod-by-zero-declines()
]

/// THE SCOREBOARD: `(passed, total)` over the corpus — what the `cadenza-ml` gate target prints as `X/N`.
def conformance() = (count-passing(corpus(), 0, 0), List.len(corpus()))

/// Are all corpus cases passing? (100% conformance for the current integer subset.)
def all-pass() = match conformance() with | (passed, total) => passed == total

@test
def cf-milestone-case-passes() =
  // the milestone case itself passes the pipeline.
  (if check-case(c-milestone()) then unit else trap("milestone case runs to 7"))

@test
def cf-runs-mismatch-is-fail() =
  // a case whose expected value is WRONG must FAIL (the scoreboard catches a wrong-value miscompile).
  (if case-passes([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2)], Expect.Runs(999)) == false then unit else trap("1+2 != 999 must fail"))

@test
def cf-declines-case-passes() =
  // an unbound program is EXPECTED to decline; matching None == Declines passes.
  (if check-case(c-unbound-declines()) then unit else trap("unbound x declines as expected"))

@test
def cf-declines-mismatch-is-fail() =
  // expecting a decline but the program RUNS is a fail (would catch a should-be-rejected program running).
  (if case-passes([Tok.TNum(5)], Expect.Declines) == false then unit else trap("5 runs, so expecting Declines fails"))

@test
def cf-corpus-size-floor() =
  // The corpus SIZE floor: exactly 54 cases, so a case can't be silently dropped from `corpus()`.
  // This does NOT re-run the compiles — each case's pass/decline is already proven by its own
  // `conformance-<case>` @test below, and the `count-passing` fold logic by
  // `cf-count-passing-partial`. The old `cf-corpus-all-pass` re-ran the entire corpus
  // compile+eval pipeline INLINE as one silent @test (~minutes, zero intermediate output), which
  // duplicated the per-case tests AND read as a silent hang/kill to the gate (localized by
  // v-fleet-tooling as the compiler-ml gate-throughput + false-hang source). The conformance FLOOR
  // is now: per-case @tests (each case correct) + this size check (no case dropped), with none of
  // the redundant full-corpus re-run.
  (if List.len(corpus()) == 54 then unit else trap("corpus has 54 cases"))

@test
def cf-count-passing-partial() =
  // a mixed list: one right, one wrong → exactly one passes (the fold counts correctly).
  (let mixed = [Case.Case([Tok.TNum(1)], Expect.Runs(1)), Case.Case([Tok.TNum(1)], Expect.Runs(2))] in
   (if count-passing(mixed, 0, 0) == 1 then unit else trap("one of two passes")))

// ---- PER-CASE conformance @tests (v-fleet-tooling's gate seam) ----
// Each corpus case is ALSO its own @test, so the existing `cdz test implementation/compiler-ml` gate step
// (already run by `check`) reports conformance X/N FOR FREE — N conformance @tests, X passing — AND names
// the exact failing case on a widening regression, rather than burying it in an aggregate count. The
// aggregate `conformance()`/`all-pass()` API stays for the Cadenza-side scoreboard; the GATE drives off
// these. Naming convention: `conformance-<case>` so they group in the test output. Widening the language =
// add a `c-<case>()` to the corpus AND a `conformance-<case>` @test here.

@test
def conformance-literal() = (if check-case(c-literal()) then unit else trap("5 → 5"))
@test
def conformance-add() = (if check-case(c-add()) then unit else trap("1 + 2 → 3"))
@test
def conformance-sub() = (if check-case(c-sub()) then unit else trap("10 - 3 → 7"))
@test
def conformance-mul() = (if check-case(c-mul()) then unit else trap("4 * 6 → 24"))
@test
def conformance-precedence() = (if check-case(c-precedence()) then unit else trap("1 + 2 * 3 → 7"))
@test
def conformance-let-trivial() = (if check-case(c-let-trivial()) then unit else trap("let x = 2 in x → 2"))
@test
def conformance-milestone() = (if check-case(c-milestone()) then unit else trap("let x = 2 in x * 3 + 1 → 7"))
@test
def conformance-nested-lets() = (if check-case(c-nested-lets()) then unit else trap("let x = 1 in let y = 2 in x + y → 3"))
@test
def conformance-shadowing() = (if check-case(c-shadowing()) then unit else trap("let x = 1 in let x = 2 in x → 2"))
@test
def conformance-unbound-declines() = (if check-case(c-unbound-declines()) then unit else trap("unbound x declines"))
@test
