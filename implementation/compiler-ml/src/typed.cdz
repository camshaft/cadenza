/// typed.cdz — the pipeline's `Typed` universe as a dependency-free LEAF module. Extracted from infer-db.cdz
/// so that `ty-bridge.cdz` (the Typed↔Ty bridge) can import `Typed` WITHOUT depending on the whole infer-db,
/// and — the point — so `infer-db.cdz` can in turn import the bridge's `typed-to-ty` rather than carrying a
/// DUPLICATE local copy (it used to: importing ty-bridge from infer-db was a cycle while `Typed` lived in
/// infer-db). Moving just the type to a leaf breaks that cycle; the conversion logic now has ONE home.
///
/// `Typed` is the MONOMORPHIC type fact the infer column assigns each node — the pipeline counterpart of
/// ty.cdz's solved `Ty` (bridged in ty-bridge). Fully self-contained (only Bool/Int64/List/Typed).

type Typed =
  | TIntW(Bool, Int64)             // a fixed-width int type — (signed, width); (true,64)=Int64, width 0=deferred
  | TBool
  | TErr
  | TFn(List(Typed), Typed)        // HIGHER-ORDER (HO-2b): a FUNCTION type — the concrete counterpart of
                                   // ty.cdz's Ty.TyFn (N-ary param types + result), bridged in ty-bridge. A
                                   // fn-typed PARAM and a bare def-name-as-value (RDef) infer to a TFn; `(f x)`
                                   // infers to the TFn's result.
  | TSum(Int64)                    // M2-b-2b-ii-c2 USER SUM: the pipeline counterpart of Ty.TySum(declNameId) —
                                   // a user sum type by DECL name-id. A ctor USE + a match over a sum scrutinee
                                   // infer to TSum; decl-identity unify (bridged to Ty.TySum).

export { Typed.* }
