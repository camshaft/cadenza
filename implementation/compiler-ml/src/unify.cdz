/// ⚠ BANKED FUTURE-HM SPIKE — NOT wired into the pipeline. This module (and its siblings infer/tycheck/
/// type-scheme/type-env/ty-eq/infer-let) prototypes PARAMETRIC-POLYMORPHIC Hindley-Milner (type variables,
/// let-generalization, instantiation). The LIVE pipeline (infer-db.cdz) uses a MONOMORPHIC HM — deferred-int
/// unification via ty.cdz/unify-ty.cdz's Sign+Width lattice + TFn arrows — because the compiler-ml source
/// language is monomorphic (no TVar consumer). These spikes are kept + tested + banked as the head-start for
/// when the source language gains generic defs; they gate green on their own @tests but are imported by
/// nothing. Do NOT treat as live inference code.
///
/// unify.cdz — the core of Hindley-Milner inference: unification with a substitution.
///
/// A `Ty` is a recursive sum: a unification VARIABLE (an Int64 id), a nullary CONstructor
/// (`Int`/`Bool`/…), or an ARROW (a two-payload variant — function type). A substitution is a
/// `Map Int64 Ty` (Int64-keyed, compound-VALUED). `unify` returns `Result (Map Int64 Ty) String`
/// — an Ok carrying the UPDATED substitution (a compound Ok payload threaded through the recursion)
/// or an Err message. This maximizes feature use: recursive sum, occurs-check recursion, transitive
/// var-chain resolution, an Int64-keyed compound-valued Map, and a Result with a Map Ok payload.
type Ty =
  | Var(Int64)
  | Con(String)
  | Arrow(Ty, Ty)
  | IntW(Int64, Int64)             // IntW(sign, width) — an integer type. SIGN and WIDTH are ORTHOGONAL
                                   // axes (rcdzc ty.rs: Sign and Width each a 3-state {Fixed|Deferred|Var},
                                   // unified INDEPENDENTLY). sign: 1=signed, 0=unsigned, 2=DEFERRED (a bare
                                   // literal's sign, grounds to signed). width: >0=fixed, 0=DEFERRED (a bare
                                   // literal's width, grounds to the default). A bare literal = IntW(2,0)
                                   // (both deferred). (rcdzc's Sign/Width Var state — for intrinsic generics
                                   // like `+:(Int w)->(Int w)` — is a later slice; Fixed+Deferred cover the
                                   // literal-polymorphism the subset needs.)
                                   // Mirrors rcdzc's `IntTy { sign, width }` with `Fixed|Deferred` (ty.rs).

/// Follow variable bindings to a representative type (path to the end of the chain).
def resolve(s: Map(Int64, Ty), t: Ty) -> Ty = match t with
  | Ty.Var(v) => (match Map.lookup(s, v) with
    | Option.Some(u) => resolve(s, u)
    | Option.None(_) => t)
  | _ => t

/// Does variable `v` occur in `t` (after resolving)? The occurs check prevents infinite types.
def occurs(v: Int64, t: Ty, s: Map(Int64, Ty)) -> Bool = match resolve(s, t) with
  | Ty.Var(w) => v == w
  | Ty.Con(_) => false
  | Ty.IntW(_, _) => false          // a fixed-width int is a leaf — no nested type var to capture
  | Ty.Arrow(a, b) => occurs(v, a, s) or occurs(v, b, s)

/// Bind variable `v` to type `t` in the substitution, guarding against a trivial or cyclic binding.
def bind-var(s: Map(Int64, Ty), v: Int64, t: Ty) -> Result(Map(Int64, Ty), String) = match t with
  | Ty.Var(w) => (if v == w then Result.Ok(s) else Result.Ok(Map.insert(s, v, t)))
  | _ => (if occurs(v, t, s) then Result.Err("occurs check: infinite type") else Result.Ok(Map.insert(s, v, t)))

/// SIGN agreement (rcdzc `unify_sign`): a DEFERRED sign (2) takes the other; two FIXED signs (1 signed /
/// 0 unsigned) agree iff EQUAL — a mismatch is CDZ0301 (no silent promotion), checked independent of width.
def sign-agrees(sa: Int64, sb: Int64) =
  (if (sa == 2) then true else (if (sb == 2) then true else sa == sb))

/// WIDTH agreement (rcdzc `unify_width`): a DEFERRED width (0) takes the other; two FIXED widths agree iff
/// EQUAL — a mismatch rejects, independent of sign.
def width-agrees(wa: Int64, wb: Int64) =
  (if (wa == 0) then true else (if (wb == 0) then true else wa == wb))

/// Unify two non-variable (structural) types.
def unify-struct(s: Map(Int64, Ty), a: Ty, b: Ty) -> Result(Map(Int64, Ty), String) = match a with
  | Ty.Con(n) => (match b with
    | Ty.Con(m) => (if n == m then Result.Ok(s) else Result.Err("cannot unify distinct constructors"))
    | _ => Result.Err("cannot unify a constructor with a non-constructor"))
  | Ty.IntW(sa, wa) => (match b with
    // INTEGER-WIDTH unification (the corrected-2b lattice, mirroring rcdzc's IntTy Fixed|Deferred):
    //  - a DEFERRED width (0) grounds to the OTHER side (a bare literal takes its context's width);
    //  - two CONCRETE ints must agree in BOTH sign and width, else a mismatch (the CDZ0301 analog);
    //  - deferred meets deferred stays deferred (unconstrained; grounds to the default at the root).
    // This is a value-level combine (widths are Int64s, not type-vars), so no substitution changes —
    // grounding a deferred literal is the CALLER's job (it holds the node→type map); unify only DECIDES
    // whether the two int types are COMPATIBLE and, if so, leaves the substitution unchanged.
    | Ty.IntW(sb, wb) =>
        // SIGN and WIDTH unify INDEPENDENTLY (rcdzc unify_sign THEN unify_width) — BOTH must agree. A
        // deferred WIDTH does NOT bypass the SIGN check: a Fixed sign mismatch (signed vs unsigned) rejects
        // even when a width is deferred. (This closes the prior gap where `wa==0`/`wb==0` short-circuited Ok
        // before comparing signs, wrongly letting a signed deferred unify with an unsigned concrete.)
        (if sign-agrees(sa, sb) then (if width-agrees(wa, wb) then Result.Ok(s) else Result.Err("cannot unify integers of different width")) else Result.Err("cannot unify integers of different sign"))
    | _ => Result.Err("cannot unify an integer with a non-integer"))
  | Ty.Arrow(a1, a2) => (match b with
    | Ty.Arrow(b1, b2) => (match unify(s, a1, b1) with
      | Result.Ok(s1) => unify(s1, a2, b2)
      | Result.Err(e) => Result.Err(e))
    | _ => Result.Err("cannot unify an arrow with a non-arrow"))
  | Ty.Var(_) => Result.Err("unreachable: unify-struct on a variable")

/// Unify two types, extending the substitution. Returns the new substitution or an error.
def unify(s: Map(Int64, Ty), a: Ty, b: Ty) -> Result(Map(Int64, Ty), String) =
  let ra = resolve(s, a) in
  let rb = resolve(s, b) in
  match ra with
  | Ty.Var(v) => bind-var(s, v, rb)
  | _ => (match rb with
    | Ty.Var(w) => bind-var(s, w, ra)
    | _ => unify-struct(s, ra, rb))

/// An empty substitution.
def empty() -> Map(Int64, Ty) = #{}

/// Did unification succeed?
def is-ok(r: Result(Map(Int64, Ty), String)) -> Bool = match r with
  | Result.Ok(_) => true
  | Result.Err(_) => false

/// After unifying, does variable `v` resolve to the constructor named `name`?
def solved-con(r: Result(Map(Int64, Ty), String), v: Int64, name: String) -> Bool = match r with
  | Result.Ok(s) => (match resolve(s, Ty.Var(v)) with
    | Ty.Con(nm) => nm == name
    | _ => false)
  | Result.Err(_) => false

@test
def unify-same-con() = if is-ok(unify(empty(), Ty.Con("Int"), Ty.Con("Int"))) then unit else trap("Int ~ Int")

@test
def unify-con-mismatch() =
  if is-ok(unify(empty(), Ty.Con("Int"), Ty.Con("Bool"))) then trap("Int ~ Bool must fail") else unit

@test
def unify-var-left() =
  if solved-con(unify(empty(), Ty.Var(0), Ty.Con("Int")), 0, "Int") then unit else trap("?0 ~ Int")

@test
def unify-var-right() =
  if solved-con(unify(empty(), Ty.Con("Bool"), Ty.Var(0)), 0, "Bool") then unit else trap("Bool ~ ?0")

@test
def unify-var-var() =
  if is-ok(unify(empty(), Ty.Var(0), Ty.Var(1))) then unit else trap("?0 ~ ?1")

@test
def unify-arrow() =
  let r = unify(empty(), Ty.Arrow(Ty.Var(0), Ty.Con("Int")), Ty.Arrow(Ty.Con("Bool"), Ty.Var(1))) in
  if solved-con(r, 0, "Bool") then
    (if solved-con(r, 1, "Int") then unit else trap("?1 -> Int"))
  else
    trap("?0 -> Bool")

@test
def unify-occurs() =
  if is-ok(unify(empty(), Ty.Var(0), Ty.Arrow(Ty.Var(0), Ty.Con("Int")))) then
    trap("occurs check must fail")
  else
    unit

@test
def unify-arrow-vs-con() =
  if is-ok(unify(empty(), Ty.Arrow(Ty.Con("Int"), Ty.Con("Int")), Ty.Con("Int"))) then
    trap("arrow ~ con must fail")
  else
    unit

@test
def unify-transitive() =
  let r0 = unify(empty(), Ty.Var(0), Ty.Var(1)) in
  match r0 with
  | Result.Ok(s0) => (if solved-con(unify(s0, Ty.Var(1), Ty.Con("Int")), 0, "Int") then
    unit
  else
    trap("?0 resolves through ?1 to Int"))
  | Result.Err(_) => trap("?0 ~ ?1 ok")

// ---- integer-WIDTH unification (the corrected-2b lattice: Deferred grounds to Fixed) ----

@test
def unify-intw-same-concrete() =
  // Int8 ~ Int8 (signed, width 8) unifies; UInt8 ~ UInt8 too.
  if is-ok(unify(empty(), Ty.IntW(1, 8), Ty.IntW(1, 8))) then
    (if is-ok(unify(empty(), Ty.IntW(0, 8), Ty.IntW(0, 8))) then unit else trap("UInt8 ~ UInt8")) else trap("Int8 ~ Int8")

@test
def unify-intw-width-mismatch() =
  // Int8 ~ Int16 must FAIL (different width — the CDZ0301 analog, no implicit conversion).
  if is-ok(unify(empty(), Ty.IntW(1, 8), Ty.IntW(1, 16))) then trap("Int8 ~ Int16 must fail") else unit

@test
def unify-intw-sign-mismatch() =
  // Int8 ~ UInt8 must FAIL (same width, different sign — distinct types).
  if is-ok(unify(empty(), Ty.IntW(1, 8), Ty.IntW(0, 8))) then trap("Int8 ~ UInt8 must fail") else unit

@test
def unify-intw-deferred-grounds-left() =
  // a BARE LITERAL (sign 2 = deferred, width 0 = deferred) ~ Int8 unifies (takes its context's sign+width).
  if is-ok(unify(empty(), Ty.IntW(2, 0), Ty.IntW(1, 8))) then unit else trap("deferred literal ~ Int8 ok")

@test
def unify-intw-deferred-grounds-right() =
  // Int8 ~ deferred-literal also unifies (symmetry).
  if is-ok(unify(empty(), Ty.IntW(1, 8), Ty.IntW(2, 0))) then unit else trap("Int8 ~ deferred literal ok")

@test
def unify-intw-deferred-meets-deferred() =
  // two unconstrained deferred literals unify (stay deferred; ground to the default at the root).
  if is-ok(unify(empty(), Ty.IntW(2, 0), Ty.IntW(2, 0))) then unit else trap("deferred ~ deferred ok")

// ---- SIGN and WIDTH are ORTHOGONAL (rcdzc: a deferred WIDTH does NOT bypass the SIGN check) ----

@test
def unify-intw-sign-checked-under-deferred-width() =
  // THE FIX (v-inference finding): a SIGNED value with a deferred WIDTH must NOT unify with an UNSIGNED
  // concrete — sign is checked independent of width. IntW(1,0) [signed, width-deferred] ~ IntW(0,8) [UInt8]
  // → sign mismatch (1≠0) → FAIL, even though width 0 is deferred. (Prior code returned Ok here — the bug.)
  if is-ok(unify(empty(), Ty.IntW(1, 0), Ty.IntW(0, 8))) then trap("signed-deferred-width ~ UInt8 must FAIL on sign") else unit

@test
def unify-intw-deferred-sign-takes-unsigned() =
  // a genuinely DEFERRED sign (2) takes the other side's sign: IntW(2,0) [bare literal] ~ IntW(0,8) [UInt8]
  // unifies (the literal grounds to unsigned) — distinguishing a deferred sign from a Fixed signed (1).
  if is-ok(unify(empty(), Ty.IntW(2, 0), Ty.IntW(0, 8))) then unit else trap("deferred-sign literal grounds to UInt8")

@test
def unify-intw-fixed-width-deferred-sign-ok() =
  // deferred SIGN (2) with a FIXED width (8) ~ Int8: sign grounds to signed, widths agree → ok.
  if is-ok(unify(empty(), Ty.IntW(2, 8), Ty.IntW(1, 8))) then unit else trap("deferred-sign fixed-width ~ Int8 ok")

@test
def unify-intw-signed-deferred-width-meets-signed-concrete() =
  // a signed deferred-width ~ Int16: signs agree (both signed), width grounds → ok (the correct positive
  // case that the sign-check must NOT over-reject).
  if is-ok(unify(empty(), Ty.IntW(1, 0), Ty.IntW(1, 16))) then unit else trap("signed-deferred-width ~ Int16 ok")

@test
def unify-intw-not-a-con() =
  // an integer does NOT unify with a nullary constructor (Int8 ~ Bool fails) nor an arrow.
  if is-ok(unify(empty(), Ty.IntW(1, 8), Ty.Con("Bool"))) then trap("Int8 ~ Bool must fail")
  else (if is-ok(unify(empty(), Ty.IntW(1, 8), Ty.Arrow(Ty.Con("Int"), Ty.Con("Int")))) then trap("Int8 ~ arrow must fail") else unit)

@test
def unify-intw-var-binds() =
  // a type var unifies with Int8 and resolves to it (deferred-width literals thread through vars).
  (match unify(empty(), Ty.Var(0), Ty.IntW(1, 8)) with
    | Result.Ok(s) => (match resolve(s, Ty.Var(0)) with | Ty.IntW(sg, w) => (if (sg == 1) and (w == 8) then unit else trap("?0 → Int8")) | _ => trap("?0 resolves to IntW"))
    | Result.Err(_) => trap("?0 ~ Int8 ok"))

export { unify }
