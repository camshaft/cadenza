/// quote-build.cdz — METAPROGRAMMING with the built-in `Ast`: `quote(expr)` reifies a program fragment
/// into an `Ast` value (the `Int`/`Name`/`List` prelude sum), and `quasiquote` with an Int-valued
/// `unquote` splices a computed number into the template. This module walks the reified tree (count
/// nodes, sum Int leaves) and compares quoted forms by structural equality — the shape a macro / a
/// staged-compilation layer manipulates. (The built-in `Ast` has exactly three variants — `Int Int64`,
/// `Name String`, `List (List Ast)` — so a quoted `(+ 1 2)` is `List[Name "+", Int 1, Int 2]`.)
///
/// `unquote` lifts an Int64-valued operand (`wrap` below) AND splices an already-`Ast` value (`wrap-ast`)
/// — the latter is the sub-expression splicing at the heart of a macro. Ast-valued unquote once declined
/// (`mlrepro-reject-unquote-of-an-ast-value`, queue) but is now RESOLVED, so `wrap-ast` takes an `Ast`
/// operand and grafts the whole spliced tree into the template.

/// Count every node in a reified `Ast`.
def nc(a: Ast) = match a with
  | Ast.Int(_) => 1
  | Ast.Str(_) => 1
  | Ast.Bool(_) => 1
  | Ast.Float(_) => 1
  | Ast.Name(_) => 1
  | Ast.List(es) => 1 + ncl(es)

def ncl(xs: List(Ast)) = match xs with
  | [] => 0
  | [h, .. t] => nc(h) + ncl(t)

/// Sum every Int leaf of a reified `Ast`.
def isum(a: Ast) = match a with
  | Ast.Int(v) => v
  | Ast.Str(_) => 0
  | Ast.Bool(_) => 0
  | Ast.Float(_) => 0
  | Ast.Name(_) => 0
  | Ast.List(es) => isuml(es)

def isuml(xs: List(Ast)) = match xs with
  | [] => 0
  | [h, .. t] => isum(h) + isuml(t)

/// Is `a` a `List`-headed form (a compound), vs a bare leaf?
def is-compound(a: Ast) = match a with
  | Ast.List(_) => true
  | _ => false

/// Build `(+ n 1)` as an `Ast` by splicing the number `n` into a quasiquote template.
def wrap(n: Int64) = quasiquote(unquote(n) + 1)

/// Build `(+ a 1)` by splicing an already-`Ast` operand `a` into the template — sub-expression splicing,
/// the macro primitive. `a` can itself be a compound (`quote(2 * 3)`), grafted whole into the tree.
def wrap-ast(a: Ast) = quasiquote(unquote(a) + 1)

@test
def quote-flat-count() =
  // (+ 1 2) → List[Name "+", Int 1, Int 2] → 4 nodes
  if nc(quote(1 + 2)) == 4 then unit else trap("(+ 1 2) has 4 nodes")

@test
def quote-nested-count() =
  // (+ (* 2 3) 4) → outer List[Name+, List[Name*, Int2, Int3], Int4] → 1 + 1 + (1+1+1+1) + 1 = 7
  if nc(quote(1 + (2 * 3))) == 7 then unit else trap("nested has 7 nodes")

@test
def quote-int-sum() =
  // sum the Int leaves of (+ (* 10 3) 12) → 10 + 3 + 12 = 25
  if isum(quote((10 * 3) + 12)) == 25 then unit else trap("int-sum 25")

@test
def quote-leaf-int() =
  // a bare literal quotes to an Ast.Int (a leaf, count 1)
  if nc(quote(42)) == 1 then unit else trap("42 is a leaf")

@test
def quote-leaf-int-value() =
  if isum(quote(42)) == 42 then unit else trap("42's value survives")

@test
def quote-is-compound() =
  // (+ 1 2) is a compound; 42 is not
  if is-compound(quote(1 + 2)) then
    (if is-compound(quote(42)) then trap("42 is a leaf") else unit)
  else
    trap("(+ 1 2) is compound")

@test
def quote-structural-eq() =
  // two identical quoted forms are structurally equal
  if quote(1 + 2) == quote(1 + 2) then unit else trap("equal quotes are equal")

@test
def quote-structural-neq() =
  if quote(1 + 2) == quote(1 + 3) then trap("(+ 1 2) != (+ 1 3)") else unit

@test
def quasiquote-splice-int() =
  // wrap(5) = (+ 5 1) → List[Name+, Int5, Int1] → 4 nodes, int-sum 6
  if nc(wrap(5)) == 4 then (if isum(wrap(5)) == 6 then unit else trap("5 + 1 sum 6")) else trap("wrap 4 nodes")

@test
def quasiquote-splice-varies() =
  // the spliced value flows through: wrap(10) has int-sum 11
  if isum(wrap(10)) == 11 then unit else trap("10 + 1 sum 11")

@test
def quasiquote-splice-ast-leaf() =
  // REGRESSION (mlrepro-reject-unquote-of-an-ast-value, RESOLVED): splice an Ast LEAF. wrap-ast(quote(5))
  // = (+ 5 1) → List[Name+, Int5, Int1] → 4 nodes, int-sum 6 (same as wrap(5), but the operand is an Ast).
  if nc(wrap-ast(quote(5))) == 4 then (if isum(wrap-ast(quote(5))) == 6 then unit else trap("5 + 1 sum 6")) else trap("4 nodes")

@test
def quasiquote-splice-ast-compound() =
  // Splice a COMPOUND Ast sub-tree: wrap-ast(quote(2 * 3)) = (+ (* 2 3) 1). The whole (* 2 3) is grafted
  // in → List[Name+, List[Name*, Int2, Int3], Int1] → 1 + 1 + (1+1+1+1) + 1 = 7 nodes, int-sum 2+3+1 = 6.
  let w = wrap-ast(quote(2 * 3)) in
  if nc(w) == 7 then
    (if isum(w) == 6 then (if is-compound(w) then unit else trap("result is compound")) else trap("sum 6"))
  else
    trap("spliced compound has 7 nodes")

export { nc, isum, wrap, wrap-ast }
