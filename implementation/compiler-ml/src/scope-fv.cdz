/// scope-fv.cdz — the BINDING-AWARE free-variable analysis of the untyped lambda calculus. Unlike
/// `free-vars.cdz` (which just collects every `Name` in a flat Ast), this respects SCOPE: a `Lam x`
/// binds `x`, so `x` is removed from its body's free set. `free-vars` returns a `Set String` computed
/// bottom-up — a leaf `Var` is the singleton `#(x)`, an `App` UNIONS its parts' free sets, and a `Lam`
/// REMOVES its bound variable. This is the classic FV(e) function every scope-checker / capture-avoiding
/// substitution needs, and it stresses `Set String` union + remove threaded through recursion (the
/// binding-aware complement to the flat collector).
type Term =
  | Var(String)
  | Lam(String, Term)
  | App(Term, Term)

/// The free variables of `e` (respecting `Lam` binding).
def free-vars(e: Term) = match e with
  | Term.Var(x) => #(x)
  | Term.Lam(x, body) => Set.remove(free-vars(body), x)
  | Term.App(f, a) => Set.union(free-vars(f), free-vars(a))

/// How many distinct free variables `e` has.
def free-count(e: Term) = Set.len(free-vars(e))

/// Is `x` free in `e` (not bound by an enclosing `Lam`)?
def is-free(e: Term, x: String) = Set.contains(free-vars(e), x)

/// A closed term has no free variables.
def is-closed(e: Term) = Set.len(free-vars(e)) == 0

@test
def fv-var() = if free-count(Term.Var("x")) == 1 then unit else trap("a bare var is free")

@test
def fv-var-name() = if is-free(Term.Var("x"), "x") then unit else trap("x is free in x")

@test
def fv-identity-closed() =
  // λx. x → closed
  if is-closed(Term.Lam("x", Term.Var("x"))) then unit else trap("λx.x is closed")

@test
def fv-lam-binds() =
  // λx. x → x is NOT free (bound)
  if is-free(Term.Lam("x", Term.Var("x")), "x") then trap("x is bound in λx.x") else unit

@test
def fv-app-unions() =
  // (x y) → 2 free
  if free-count(Term.App(Term.Var("x"), Term.Var("y"))) == 2 then unit else trap("x,y both free")

@test
def fv-partial-bind() =
  // λx. (x y) → only y free
  let e = Term.Lam("x", Term.App(Term.Var("x"), Term.Var("y"))) in
  if free-count(e) == 1 then
    (if is-free(e, "y") then (if is-free(e, "x") then trap("x bound") else unit) else trap("y free"))
  else
    trap("one free var")

@test
def fv-nested-lam() =
  // λx. λy. (x (y z)) → only z free
  let e = Term.Lam("x", Term.Lam("y", Term.App(Term.Var("x"), Term.App(Term.Var("y"), Term.Var("z"))))) in
  if free-count(e) == 1 then (if is-free(e, "z") then unit else trap("z free")) else trap("one free")

@test
def fv-shadowing-inner-binds() =
  // λx. λx. x → the inner λx binds; x is NOT free
  if is-closed(Term.Lam("x", Term.Lam("x", Term.Var("x")))) then unit else trap("shadowed x bound")

@test
def fv-dedup-repeated-var() =
  // (x x) → the SAME var twice is ONE free variable (Set dedup)
  if free-count(Term.App(Term.Var("x"), Term.Var("x"))) == 1 then unit else trap("x counted once")

@test
def fv-free-and-bound-same-name() =
  // (x (λx. x)) → the OUTER x is free even though an inner λx binds its own x → x IS free overall
  let e = Term.App(Term.Var("x"), Term.Lam("x", Term.Var("x"))) in
  if is-free(e, "x") then unit else trap("outer x is free")

export { free-vars, free-count, is-free, is-closed }
