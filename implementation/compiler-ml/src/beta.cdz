/// beta.cdz — capture-free BETA-REDUCTION over NAMELESS (de Bruijn) terms of the canonical `Ast`
/// (imported cross-file from `ast`). Works on the output of `debruijn.cdz`: a `(fn () <body>)` binder
/// (empty param clause) whose bound variables are `Int` de Bruijn indices. Reducing an application
/// `(app (fn () body) arg)` substitutes `arg` for index 0 in `body`. Because the term is nameless, there
/// is NO capture problem — substitution is a pure index rewrite, the whole reason the de Bruijn form is
/// worth computing. This is the evaluator core of a λ-calculus normalizer / an inliner's substitution step.
///
/// The classic index-calculus operators:
///   • `shift(d, c, t)` — add `d` to every FREE index (one at/above cutoff `c`) in `t`; the cutoff rises
///     by one under each binder. Used to move a term across binders without capturing.
///   • `subst(j, s, t)` — replace the free index `j` in `t` with `s`, shifting `s` up by one under each
///     binder (so its own free indices stay free) and raising `j` in step.
///   • `beta1(node)` — reduce a top-level redex `(app (fn () body) arg)` to
///     `shift(-1, 0, subst(0, shift(1, 0, arg), body))` (substitute the shifted arg for index 0, then
///     drop the consumed binder by shifting the result down). A non-redex is returned unchanged.
///
/// Every walk uses the mutual `_/​_-list` recursion over child lists — the still-live-binding shape the
/// backend fixes unblocked. Pairs with `debruijn.cdz` (produces the nameless form) and `alpha.cdz`
/// (nameless β-normal forms compare by structural equality).

import { Ast } from "ast"

/// The `Name` at position `i` of `elems`, or None (a borrowing indexed read).
def name-at(elems: List(Ast), i: Int64) = match List.at(elems, i) with
  | Option.Some(Ast.Name(n)) => Some(n)
  | _ => None(unit)

/// The child `Ast` at position `i`, or a Unit-Int sentinel.
def child-at(elems: List(Ast), i: Int64) = match List.at(elems, i) with
  | Option.Some(c) => c
  | Option.None(_) => Ast.Int(0)

/// Prepend `x` to `xs` (the prelude has no `cons`; `List.concat` of a singleton is the idiom).
def cons(x: Ast, xs: List(Ast)) = List.concat([x], xs)

/// Is this list a nameless binder `(fn () <body>)` — head Name "fn" with an empty param clause at index 1?
def is-fn(elems: List(Ast)) = match name-at(elems, 0) with
  | Some(h) => h == "fn"
  | None(_) => false

/// Shift every FREE index (>= cutoff `c`) in `t` up by `d`. The cutoff rises by one under each binder.
def shift(d: Int64, c: Int64, t: Ast) = match t with
  | Ast.Int(k) => (if k >= c then Ast.Int(k + d) else Ast.Int(k))
  | Ast.Str(s) => Ast.Str(s)
  | Ast.Bool(b) => Ast.Bool(b)
  | Ast.Name(n) => Ast.Name(n)
  | Ast.List(e) => (if is-fn(e)
      then Ast.List([Ast.Name("fn"), Ast.List([]), shift(d, c + 1, child-at(e, 2))])
      else Ast.List(shift-list(d, c, e)))

def shift-list(d: Int64, c: Int64, e: List(Ast)) = match e with
  | [] => []
  | [h, .. r] => cons(shift(d, c, h), shift-list(d, c, r))

/// Replace the free index `j` in `t` with `s`. Under each binder, `j` rises by one and `s` is shifted up
/// by one (so `s`'s own free indices are not captured).
def subst(j: Int64, s: Ast, t: Ast) = match t with
  | Ast.Int(k) => (if k == j then s else Ast.Int(k))
  | Ast.Str(x) => Ast.Str(x)
  | Ast.Bool(b) => Ast.Bool(b)
  | Ast.Name(n) => Ast.Name(n)
  | Ast.List(e) => (if is-fn(e)
      then Ast.List([Ast.Name("fn"), Ast.List([]), subst(j + 1, shift(1, 0, s), child-at(e, 2))])
      else Ast.List(subst-list(j, s, e)))

def subst-list(j: Int64, s: Ast, e: List(Ast)) = match e with
  | [] => []
  | [h, .. r] => cons(subst(j, s, h), subst-list(j, s, r))

/// Reduce a top-level redex `(app (fn () body) arg)` once. A non-redex (or an `app` whose function is not
/// a binder) is returned unchanged. The substituted arg is shifted up by 1 (to survive crossing the
/// binder), replaces index 0, and the result is shifted down by 1 (the binder is consumed).
def beta1(node: Ast) = match node with
  | Ast.List(e) => (match name-at(e, 0) with
    | Some(h) => (if h == "app" then
        (match child-at(e, 1) with
          | Ast.List(fe) => (if is-fn(fe)
              then shift(0 - 1, 0, subst(0, shift(1, 0, child-at(e, 2)), child-at(fe, 2)))
              else node)
          | _ => node)
      else node)
    | None(_) => node)
  | _ => node

/// Builders for readable tests (nameless: a binder is `(fn () body)`, a bound var is `Int index`).
def nm(s: String) = Ast.Name(s)
def lst(xs: List(Ast)) = Ast.List(xs)
def nfn(body: Ast) = lst([nm("fn"), lst([]), body])          // nameless binder
def app(f: Ast, x: Ast) = lst([nm("app"), f, x])
def idx(i: Int64) = Ast.Int(i)

@test
def beta-identity() =
  // (app (fn () 0) 42) → 42 : the identity applied to 42.
  match beta1(app(nfn(idx(0)), Ast.Int(42))) with
    | Ast.Int(n) => (if n == 42 then unit else trap("identity yields its arg"))
    | _ => trap("identity redex reduces to the arg")

@test
def beta-body-free-index-dropped-not-substituted() =
  // In a NAMELESS λ-term every `Int` is a de Bruijn INDEX (there are no integer literals). `(app (fn ()
  // 7) 5)`: the body index 7 is FREE (not 0), so it is NOT replaced by the arg; consuming the binder
  // shifts it DOWN by one → 6. (This is the "const"-shaped redex, but the body's `Int 7` denotes the free
  // variable 7, not the number seven.)
  match beta1(app(nfn(Ast.Int(7)), Ast.Int(5))) with
    | Ast.Int(n) => (if n == 6 then unit else trap("free body index 7 drops to 6 when the binder is consumed"))
    | _ => trap("free-index body reduces to an index")

@test
def beta-free-index-lowered() =
  // (app (fn () 1) 42) → 0 : index 1 is FREE in the body (refers past the reduced binder); after the
  // binder is consumed it shifts DOWN to 0. (Not replaced by the arg — only index 0 is.)
  match beta1(app(nfn(idx(1)), Ast.Int(42))) with
    | Ast.Int(k) => (if k == 0 then unit else trap("a free index shifts down by one when the binder is dropped"))
    | _ => trap("free index stays an index")

@test
def beta-under-binder-shifts-arg() =
  // (app (fn () (fn () 1)) 5) → (fn () 6): body is (fn () 1); index 1 there refers to the OUTER binder
  // (the one being reduced), so it is replaced by the arg — the arg's index 5 is SHIFTED up by one to
  // survive crossing the inner binder → 6. Result: (fn () 6). (Every `Int` is an index; the arg's free
  // index shifts under the binder.)
  match beta1(app(nfn(nfn(idx(1))), Ast.Int(5))) with
    | Ast.List(e) => (if is-fn(e)
        then (match child-at(e, 2) with | Ast.Int(n) => (if n == 6 then unit else trap("arg index 5 shifts to 6 under the inner binder")) | _ => trap("inner body is the shifted arg"))
        else trap("result is a binder"))
    | _ => trap("result is (fn () 6)")

@test
def beta-inner-bound-untouched() =
  // (app (fn () (fn () 0)) 42) → (fn () 0): index 0 in the inner body is bound by the INNER binder, not
  // the reduced outer one, so it is left alone. Result: (fn () 0) — the constant-0 function.
  match beta1(app(nfn(nfn(idx(0))), Ast.Int(42))) with
    | Ast.List(e) => (if is-fn(e)
        then (match child-at(e, 2) with | Ast.Int(n) => (if n == 0 then unit else trap("inner-bound index is untouched")) | _ => trap("inner body stays index 0"))
        else trap("result is a binder"))
    | _ => trap("result is (fn () 0)")

@test
def beta-substitutes-into-application() =
  // (app (fn () (app 0 0)) 5) → (app 5 5): index 0 appears twice in the body, both replaced by 5.
  match beta1(app(nfn(app(idx(0), idx(0))), Ast.Int(5))) with
    | Ast.List(e) => (match name-at(e, 0) with
      | Some(h) => (if h == "app"
          then (match child-at(e, 1) with | Ast.Int(a) => (match child-at(e, 2) with | Ast.Int(b) => (if a == 5 then (if b == 5 then unit else trap("2nd 5")) else trap("1st 5")) | _ => trap("2nd is 5")) | _ => trap("1st is 5"))
          else trap("result is an app"))
      | None(_) => trap("result head is app"))
    | _ => trap("result is (app 5 5)")

@test
def beta-non-redex-unchanged() =
  // (app 0 1) is not a redex (function is index 0, not a binder) → unchanged.
  match beta1(app(idx(0), idx(1))) with
    | Ast.List(e) => (match name-at(e, 0) with | Some(h) => (if h == "app" then unit else trap("still an app")) | None(_) => trap("head app"))
    | _ => trap("non-redex is returned unchanged")

@test
def beta-shift-raises-free-only() =
  // shift(2, 0, (fn () (app 0 1))): index 0 is bound (untouched), index 1 is free → 1+2 = 3.
  match shift(2, 0, nfn(app(idx(0), idx(1)))) with
    | Ast.List(e) => (match child-at(e, 2) with
      | Ast.List(be) => (match child-at(be, 1) with
        | Ast.Int(bound) => (match child-at(be, 2) with
          | Ast.Int(free) => (if bound == 0 then (if free == 3 then unit else trap("free 1→3")) else trap("bound 0 untouched"))
          | _ => trap("2nd is int"))
        | _ => trap("1st is int"))
      | _ => trap("body is app"))
    | _ => trap("shift keeps the binder")

@test
def beta-literal-unchanged() =
  // A bare literal has no redex.
  match beta1(Ast.Int(9)) with | Ast.Int(n) => (if n == 9 then unit else trap("9")) | _ => trap("Int stays Int")

@test
def beta-nested-arg-substituted() =
  // (app (fn () 0) (app 3 4)) → (app 3 4): a COMPOUND arg replaces index 0 (shifted, but 3/4 are closed).
  match beta1(app(nfn(idx(0)), app(Ast.Int(3), Ast.Int(4)))) with
    | Ast.List(e) => (match name-at(e, 0) with
      | Some(h) => (if h == "app"
          then (match child-at(e, 1) with | Ast.Int(a) => (if a == 3 then unit else trap("3")) | _ => trap("compound arg lands"))
          else trap("result is the app arg"))
      | None(_) => trap("head app"))
    | _ => trap("result is (app 3 4)")

export { beta1, shift, subst }
