/// symtab.cdz — a SYMBOL TABLE with DETERMINISTIC enumeration, exercising the newly-exposed
/// `Map.to-list` / `Set.to-list` front-end ops (canonical-order enumeration — the long-missing Map/Set
/// iteration surface, now wired through to the ML surface). A real compiler collects name→info bindings
/// into a table, then must WALK them in a stable order to emit declarations / diagnostics / a sorted
/// symbol dump — an order that is REPRODUCIBLE (not hash order). `Map.to-list` yields `List (Tuple k v)`
/// in canonical KEY order; `Set.to-list` yields `List a` in canonical element order. This module builds a
/// `Map String Int64` symbol table (name → an arity / id / count) and answers the enumeration queries a
/// back end needs: the ordered name list, the value sum, a lookup, and a canonical set of names.
///
/// Before these ops existed, a pass could INSERT into a Map/Set but never OBSERVE its contents as a list
/// (only membership / a single lookup) — so a symbol-table dump / a free-var-set render was impossible in
/// the port (tracked as the `missing-map-set-enumeration` gap). This module is the first to consume the
/// enumeration surface end to end.

/// The names in a symbol table, in canonical (sorted) order.
def names(tab: Map(String, Int64)) = keys-of(Map.to-list(tab), [])

/// Project the keys out of an entry list (preserving the canonical order `Map.to-list` produced).
def keys-of(entries: List(Tuple(String, Int64)), acc: List(String)) = match entries with
  | [] => acc
  | [e, .. rest] => (match e with | (k, _) => keys-of(rest, List.push(acc, k)))

/// The number of distinct symbols.
def size(tab: Map(String, Int64)) = List.len(Map.to-list(tab))

/// Sum every value in the table (walking entries in canonical order).
def value-sum(tab: Map(String, Int64)) = sum-entries(Map.to-list(tab), 0)

def sum-entries(entries: List(Tuple(String, Int64)), acc: Int64) = match entries with
  | [] => acc
  | [e, .. rest] => (match e with | (_, v) => sum-entries(rest, acc + v))

/// The value at position `i` of the CANONICAL-ORDER entry list (a stable index into the table), or -1.
def value-at(tab: Map(String, Int64), i: Int64) = match List.at(Map.to-list(tab), i) with
  | Option.Some(e) => (match e with | (_, v) => v)
  | Option.None(_) => 0 - 1

/// The byte length of the name at canonical position `i` (a probe that the ORDER is by key), or -1.
def name-len-at(tab: Map(String, Int64), i: Int64) = match List.at(Map.to-list(tab), i) with
  | Option.Some(e) => (match e with | (k, _) => String.byte-len(k))
  | Option.None(_) => 0 - 1

/// The canonical-order element list of a name SET (via Set.to-list) — the shape a free-var-set render takes.
def set-elems(s: Set(Int64)) = Set.to-list(s)

/// Sum a set's elements in canonical order.
def set-sum(s: Set(Int64)) = sum-ints(Set.to-list(s), 0)

def sum-ints(xs: List(Int64), acc: Int64) = match xs with
  | [] => acc
  | [x, .. rest] => sum-ints(rest, acc + x)

/// Builders for readable tests.
def tab3() = Map.insert(Map.insert(Map.insert(Map.empty, "zebra", 30), "apple", 10), "mango", 20)

@test
def st-size() = if size(tab3()) == 3 then unit else trap("three distinct symbols")

@test
def st-value-sum() = if value-sum(tab3()) == 60 then unit else trap("10+20+30 = 60")

@test
def st-canonical-first-is-apple() =
  // Map.to-list is in canonical KEY order: apple < mango < zebra. First entry is apple (len 5), value 10.
  if name-len-at(tab3(), 0) == 5 then (if value-at(tab3(), 0) == 10 then unit else trap("apple's value 10")) else trap("apple is first (len 5)")

@test
def st-canonical-last-is-zebra() =
  // Last entry is zebra (value 30) — canonical order, not insertion order (zebra was inserted first).
  if value-at(tab3(), 2) == 30 then unit else trap("zebra is last in canonical order")

@test
def st-canonical-middle-is-mango() =
  if value-at(tab3(), 1) == 20 then unit else trap("mango is the middle entry")

@test
def st-names-in-order() =
  // The name list is [apple, mango, zebra]; byte-lengths [5, 5, 5] — check the first and via lookup order.
  match names(tab3()) with
    | [] => trap("names non-empty")
    | [first, .. _] => (if String.byte-len(first) == 5 then unit else trap("first name is apple"))

@test
def st-empty-table() =
  if size(Map.empty) == 0 then (if value-sum(Map.empty) == 0 then unit else trap("empty sum 0")) else trap("empty size 0")

@test
def st-out-of-range() =
  // A position past the end yields the -1 sentinel.
  if value-at(tab3(), 9) == 0 - 1 then unit else trap("out-of-range is -1")

@test
def st-set-sum-canonical() =
  // Set.to-list enumerates in canonical order; the sum is order-independent → 1+2+3 = 6.
  if set-sum(Set.of([3, 1, 2])) == 6 then unit else trap("set element sum 6")

@test
def st-set-dedups-then-enumerates() =
  // A Set drops duplicates; to-list of {5,5,7} has 2 elements summing to 12.
  let s = Set.of([5, 5, 7]) in
  if List.len(set-elems(s)) == 2 then (if set-sum(s) == 12 then unit else trap("5+7 = 12")) else trap("deduped to 2 elements")

@test
def st-insert-then-enumerate-is-canonical() =
  // Insertion order does NOT affect enumeration order: insert z, a, m → still enumerates a, m, z.
  let t = Map.insert(Map.insert(Map.insert(Map.empty, "z", 1), "a", 2), "m", 3) in
  // value at canonical position 0 is a's value (2), position 2 is z's (1).
  if value-at(t, 0) == 2 then (if value-at(t, 2) == 1 then unit else trap("z last")) else trap("a first regardless of insertion order")

export { names, size, value-sum, value-at, set-elems, set-sum }
