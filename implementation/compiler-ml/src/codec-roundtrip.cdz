/// codec-roundtrip.cdz — the codec IDENTITY witness: `decode(encode(a))` is STRUCTURALLY EQUAL to `a`
/// for every `Ast`, now that Name/Str content round-trips. This composes three port modules —
/// `encode.round-trip` (= decode ∘ encode over the wire format) and `ast-eq` (full structural equality
/// including Name/Str content) — into the strongest statement the codec can make: it is the identity on
/// the whole tree, not merely on structure + Int/Bool values (the earlier length/count probes in
/// encode.cdz). This is the self-hosting invariant a serializer must meet: what you write, you read back.
///
/// A cross-file integration (imports `encode`, `ast-eq`, `ast`), so it also witnesses that the port's
/// modules compose. Every case asserts `ast-eq(round-trip(a), a)` for a distinct tree shape.
///
/// SCOPE: the codec's Int leaf is ONE value byte (encode.cdz `b1`), so it round-trips small NON-NEGATIVE
/// Ints (0..255) exactly — a negative or >255 Int wraps to its low 8 bits (`Int(-7)` → 249), a documented
/// limitation of the compact wire format, not a codec identity. Widening to a full 8-byte little-endian
/// Int64 leaf is the natural fix (`byte0 | byte1<<8 | … | byte7<<56` on decode), but it is currently
/// BLOCKED: reconstructing the high bits needs `byte7 << 56`, and `<<` traps CDZ0304 the moment a shift
/// reaches bit 63 — even for the valid value `1 << 63` (= Int64.min), and inconsistently with `&`/`|`/`^`
/// which set the sign bit freely. Filed as a language issue (queue: left-shift-traps-into-sign-bit); once
/// `<<` shifts like the other bit ops the leaf can widen. The cases here stay within the 0..255 leaf range
/// the format guarantees. The Name/Str CONTENT round-trip — the point of this witness — is exact UP TO the
/// 255-byte length-prefix cap (a longer string now TRAPS in `str-payload` rather than truncating its
/// length; Copilot PR #433/#434), which is ample for any compiler symbol.

import { round-trip } from "encode"
import { ast-eq } from "ast-eq"
import { Ast } from "ast"

/// The codec is a structural identity on `a` iff decode(encode(a)) equals `a`.
def rt-eq(a: Ast) = ast-eq(round-trip(a), a)

/// Builders.
def lst(xs: List(Ast)) = Ast.List(xs)

@test
def rt-int() = if rt-eq(Ast.Int(42)) then unit else trap("Int 42 is a codec identity")

@test
def rt-int-byte-max() = if rt-eq(Ast.Int(255)) then unit else trap("Int 255 (byte max) round-trips equal")

@test
def rt-bool() = if rt-eq(Ast.Bool(true)) then (if rt-eq(Ast.Bool(false)) then unit else trap("false")) else trap("true")

@test
def rt-name-content() =
  // The KEY new case: a Name's CONTENT survives structurally (was a placeholder "" before).
  if rt-eq(Ast.Name("identifier")) then unit else trap("Name content is a codec identity")

@test
def rt-str-content() =
  if rt-eq(Ast.Str("a string value")) then unit else trap("Str content is a codec identity")

@test
def rt-empty-name() = if rt-eq(Ast.Name("")) then unit else trap("empty Name round-trips equal")

@test
def rt-empty-list() = if rt-eq(lst([])) then unit else trap("empty list is a codec identity")

@test
def rt-flat-mixed() =
  // A flat list of every leaf kind: Int, Bool, Name, Str.
  if rt-eq(lst([Ast.Int(1), Ast.Bool(false), Ast.Name("x"), Ast.Str("s")])) then unit else trap("flat mixed leaves round-trip equal")

@test
def rt-nested-with-names() =
  // The compiler-relevant case: a nested tree with named leaves (an s-expr-shaped Ast).
  let tree = lst([Ast.Name("f"), Ast.Int(42), lst([Ast.Bool(true), Ast.Name("x")])]) in
  if rt-eq(tree) then unit else trap("nested tree with names is a codec identity")

@test
def rt-deep() =
  // Deep nesting with names at each level.
  let tree = lst([Ast.Name("a"), lst([Ast.Name("b"), lst([Ast.Name("c"), Ast.Int(9)])])]) in
  if rt-eq(tree) then unit else trap("deep nesting with names round-trips equal")

@test
def rt-distinguishes-different-names() =
  // Sanity that the witness is not vacuous: round-trip of Name "a" must NOT equal Name "b".
  if ast-eq(round-trip(Ast.Name("a")), Ast.Name("b")) then trap("codec must preserve the distinct name, not collapse a==b") else unit

@test
def rt-repeated-names() =
  // The same name appearing twice round-trips both occurrences.
  let tree = lst([Ast.Name("dup"), Ast.Name("dup")]) in
  if rt-eq(tree) then unit else trap("repeated names round-trip equal")

export { rt-eq }
