/// cfg.cdz — a CONTROL-FLOW GRAPH and REACHABILITY analysis. The CFG is the middle-end IR that control
/// optimizations run on: basic blocks (each ending in a terminator) connected by control edges. This
/// module builds the graph as a list of blocks and answers the first question every backend asks — which
/// blocks are REACHABLE from the entry, so the UNREACHABLE (dead) ones can be dropped before codegen.
///
/// A block is `Blk(id, terminator)`; a terminator names its successors:
///   - `Return`            — no successors (function exit).
///   - `Jump(t)`           — one successor `t` (unconditional branch).
///   - `CondJump(a, b)`    — two successors (a conditional branch's then/else targets).
///
/// `reach` is a WORKLIST traversal from the entry: pop an id, if unseen mark it and push its successors,
/// until the worklist drains — the standard graph reachability over a `Set(Int64)` of seen ids. From it:
///   - `reachable-count` / `is-reachable` — the reachable set's size / membership.
///   - `dead-blocks` — blocks NOT reachable from the entry (a dead-block-elimination pass would delete
///     these). `edge-count` totals the control edges (a structural size measure).
///
/// A terminator target with no matching block (an external/return-like id) still counts as reached but
/// contributes no further successors — so a malformed graph terminates rather than looping.

type Term =
  | Return
  | Jump(Int64)
  | CondJump(Int64, Int64)

type Block =
  | Blk(Int64, Term)

/// The successor ids of a terminator.
def succs(t: Term) = match t with
  | Term.Return => []
  | Term.Jump(a) => [a]
  | Term.CondJump(a, b) => [a, b]

/// The terminator of the block with `id`, or `None` if no such block (an external target).
def find-block(blocks: List(Block), id: Int64) = match blocks with
  | [] => Option.None(unit)
  | [b, .. rest] => (match b with | Block.Blk(bid, t) => if bid == id then Option.Some(t) else find-block(rest, id))

/// Worklist reachability: process the `work` ids left to right; an unseen id is marked and its successors
/// pushed. Terminates because each id enters `seen` at most once (an already-seen id is skipped).
def reach(blocks: List(Block), work: List(Int64), seen: Set(Int64)) = match work with
  | [] => seen
  | [id, .. rest] =>
    if Set.contains(seen, id) then reach(blocks, rest, seen)
    else (match find-block(blocks, id) with
      | Option.None(_) => reach(blocks, rest, Set.insert(seen, id))
      | Option.Some(t) => reach(blocks, List.concat(succs(t), rest), Set.insert(seen, id)))

/// The set of block ids reachable from `entry`.
def reachable(blocks: List(Block), entry: Int64) = reach(blocks, [entry], Set.of([]))

/// How many ids are reachable from `entry`.
def reachable-count(blocks: List(Block), entry: Int64) = Set.len(reachable(blocks, entry))

/// Is `id` reachable from `entry`?
def is-reachable(blocks: List(Block), entry: Int64, id: Int64) = Set.contains(reachable(blocks, entry), id)

/// The block ids present in the graph but NOT reachable from `entry` — the dead blocks.
def dead-blocks(blocks: List(Block), entry: Int64) =
  let live = reachable(blocks, entry) in
  dead-from(blocks, live)

def dead-from(blocks: List(Block), live: Set(Int64)) = match blocks with
  | [] => []
  | [b, .. rest] => (match b with | Block.Blk(bid, _) =>
    if Set.contains(live, bid) then dead-from(rest, live) else List.concat([bid], dead-from(rest, live)))

/// Total number of control edges in the graph (sum of each block's successor count).
def edge-count(blocks: List(Block)) = match blocks with
  | [] => 0
  | [b, .. rest] => (match b with | Block.Blk(_, t) => List.len(succs(t)) + edge-count(rest))

/// Builders.
def blk(id: Int64, t: Term) = Block.Blk(id, t)

@test
def cfg-succs-by-terminator() =
  // Return → 0 succs, Jump → 1, CondJump → 2.
  if List.len(succs(Term.Return)) == 0 then
    (if List.len(succs(Term.Jump(1))) == 1 then (if List.len(succs(Term.CondJump(1, 2))) == 2 then unit else trap("condjump 2")) else trap("jump 1"))
  else trap("return 0")

@test
def cfg-linear-all-reachable() =
  // 0 → 1 → 2 → return : all three reachable from 0.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.Jump(2)), blk(2, Term.Return)] in
  if reachable-count(bs, 0) == 3 then unit else trap("linear chain: 3 reachable")

@test
def cfg-detects-dead-block() =
  // 0 → 1(return); 2 → 1 (2 unreachable from 0). reachable {0,1}=2; dead = [2].
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.Return), blk(2, Term.Jump(1))] in
  if reachable-count(bs, 0) == 2 then
    (match dead-blocks(bs, 0) with | [d] => (if d == 2 then unit else trap("block 2 is dead")) | _ => trap("exactly one dead block"))
  else trap("2 reachable")

@test
def cfg-branch-both-targets-reachable() =
  // 0 → cond(1, 2); 1 → return; 2 → return. all of {0,1,2} reachable.
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Return), blk(2, Term.Return)] in
  if reachable-count(bs, 0) == 3 then (match dead-blocks(bs, 0) with | [] => unit | _ => trap("no dead blocks")) else trap("both branches reachable")

@test
def cfg-diamond-merge() =
  // diamond: 0 → cond(1,2); 1 → jump 3; 2 → jump 3; 3 → return. all 4 reachable, merge at 3.
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Jump(3)), blk(2, Term.Jump(3)), blk(3, Term.Return)] in
  if reachable-count(bs, 0) == 4 then unit else trap("diamond: 4 reachable")

@test
def cfg-cycle-terminates() =
  // a loop: 0 → 1; 1 → cond(1, 2) (self-edge back to 1); 2 → return. Reachability must TERMINATE despite
  // the cycle → {0,1,2} = 3.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.CondJump(1, 2)), blk(2, Term.Return)] in
  if reachable-count(bs, 0) == 3 then unit else trap("cyclic CFG: 3 reachable, terminates")

@test
def cfg-is-reachable-membership() =
  // 0 → 1(return); 2 dead. is-reachable 0→1 true, 0→2 false.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.Return), blk(2, Term.Return)] in
  if is-reachable(bs, 0, 1) then (if is-reachable(bs, 0, 2) then trap("block 2 unreachable") else unit) else trap("block 1 reachable")

@test
def cfg-multiple-dead-blocks() =
  // 0 → return; 1,2 both dead (islands). dead-blocks = [1, 2] (in list order).
  let bs = [blk(0, Term.Return), blk(1, Term.Jump(2)), blk(2, Term.Return)] in
  if reachable-count(bs, 0) == 1 then
    (match dead-blocks(bs, 0) with | [a, b] => (if a == 1 then (if b == 2 then unit else trap("2 dead")) else trap("1 dead")) | _ => trap("two dead blocks"))
  else trap("only entry reachable")

@test
def cfg-edge-count() =
  // 0 → cond(1,2)=2 edges; 1 → jump 3 =1; 2 → return =0; 3 → return =0. total 3.
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Jump(3)), blk(2, Term.Return), blk(3, Term.Return)] in
  if edge-count(bs) == 3 then unit else trap("3 control edges")

@test
def cfg-external-target-terminates() =
  // 0 → jump 99, but there's no block 99. Reachability counts {0, 99} = 2 and terminates (99 has no succs).
  let bs = [blk(0, Term.Jump(99))] in
  if reachable-count(bs, 0) == 2 then unit else trap("external target reached but adds no successors")

export { succs, reachable, reachable-count, is-reachable, dead-blocks, edge-count }
