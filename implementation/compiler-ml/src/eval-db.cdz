  match run([n(3), ne(), n(4)]) with
    | Option.Some(v) => if v == 1 then
      match run([n(3), ne(), n(3)]) with
        | Option.Some(w) => if w == 0 then unit else trap("3!=3=0")
        | Option.None(_) => trap("runs")
    else
      trap("3!=4=1")
    | Option.None(_) => trap("runs")

@test
def ev-rel-in-if() =
  // if 5 >= 5 then 1 else 0 → 1 (a new relational op as an if condition).
  match run([ifkw(), n(5), ge(), n(5), thenkw(), n(1), elsekw(), n(0)]) with
    | Option.Some(v) => if v == 1 then unit else trap("5>=5 → then=1")
    | Option.None(_) => trap("runs")

@test
def ev-div() =
  // 8 / 2 → 4.
  match run([n(8), divop(), n(2)]) with
    | Option.Some(v) => if v == 4 then unit else trap("8/2=4")
    | Option.None(_) => trap("div runs")

@test
def ev-div-by-zero-is-none() =
  // 5 / 0 → None (trap-free: divide-by-zero yields absence, not a crash).
  match run([n(5), divop(), n(0)]) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("5/0 must be None")

@test
def ev-mod() =
  // 7 % 3 → 1.
  match run([n(7), modop(), n(3)]) with
    | Option.Some(v) => if v == 1 then unit else trap("7%3=1")
    | Option.None(_) => trap("mod runs")

@test
def ev-mod-by-zero-is-none() =
  // 7 % 0 → None.
  match run([n(7), modop(), n(0)]) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("7%0 must be None")

@test
def ev-mod-by-neg-one-is-zero() =
  // x % -1 = 0 for ALL x (the divisor -1 divides everything evenly). The load-bearing case is Int64.min % -1:
  // mathematically 0 (no overflow), but the HOST `%` FAULTS on it (the same INT_MIN/-1 hardware trap as
  // division) — so eval-bin special-cases b == -1 to 0, matching rcdzc (lower.rs: "MIN % -1 is 0 … Rust's %
  // panics there — special-case it to 0"). Was wrongly declining (host trap). Test via eval-bin directly:
  // Int64.min % -1 and a plain 7 % -1 both = 0.
  match eval-bin(37, 0 - 9223372036854775807 - 1, -1) with
    | Option.Some(v) => if v == 0 then
      match eval-bin(37, 7, -1) with
        | Option.Some(w) => if w == 0 then unit else trap("7 % -1 = 0")
        | Option.None(_) => trap("7 % -1 runs")
    else
      trap("Int64.min % -1 = 0")
    | Option.None(_) => trap("Int64.min % -1 must be 0 (special-cased), not a decline")

@test
def ev-div-precedence() =
  // 1 + 8 / 2 → 5 (division tighter than addition).
  match run([n(1), plus(), n(8), divop(), n(2)]) with
    | Option.Some(v) => if v == 5 then unit else trap("1+8/2=5")
    | Option.None(_) => trap("runs")

// ---- user-functions slice-2: a NULLARY CALL evaluates END-TO-END (infer→lower→eval) ----
// infer-db/lower-db pin the nullary-call type + lowering; this pins it EVALUATES to the right value through
// the whole eval-tree pipeline (the slice-2 payoff). NApp has no producing Tok — build the arena directly.
@test
def ev-nullary-call-evaluates-to-body() =
  // a nullary call NApp(calleeName, -1) over a body `NLit(42)` runs through eval-tree (lower resolves name→body
  // via def-body-of, inlines the body → CNum 42 → eval) to 42. End-to-end proof of slice-2's β-reduction-over-
  // zero-args. Body registered under name 900 via record-def.
  let (bodyId, t1) = add-node(empty-tree(), Node.NLit(42)) in
  let t1d = record-def(t1, 900, bodyId) in
  let (root, tree) = add-node(t1d, Node.NApp(900, -1)) in
  match eval-tree(tree, root) with
    | Option.Some(v) => if v == 42 then
      unit
    else
      trap("nullary call evaluates to its body value (42)")
    | Option.None(_) => trap("a nullary call runs end-to-end")

@test
def ev-nullary-call-over-arith-body() =
  // the body can be COMPOUND: a nullary call over `(+ 40 2)` (NBin) evaluates to 42 — lower inlines the whole
  // body Core, eval runs it. Pins that the inlined body is evaluated (not just a literal passthrough). Body
  // registered under name 900.
  let (aId, t1) = add-node(empty-tree(), Node.NLit(40)) in
  let (bId, t2) = add-node(t1, Node.NLit(2)) in
  let (bodyId, t3) = add-node(t2, Node.NBin(43, aId, bId)) in
  let t3d = record-def(t3, 900, bodyId) in
  let (root, tree) = add-node(t3d, Node.NApp(900, -1)) in
  match eval-tree(tree, root) with
    | Option.Some(v) => if v == 42 then unit else trap("nullary call over (+ 40 2) = 42")
    | Option.None(_) => trap("a nullary call over an arith body runs")

@test
def ev-nullary-call-nested-in-arith() =
  // a nullary call as a SUB-EXPRESSION (not the root): `(+ (mk) 1)` where mk's body = 41 → 42. Pins that
  // NApp composes inside a CBin — the inlined body Core sits as a CBin operand and evaluates. (slice-2 pinned
  // NApp-as-root; this pins NApp-nested, the shape a real program uses: a call feeding an operator.)
  let (mkBody, t1) = add-node(empty-tree(), Node.NLit(41)) in
  let t1d = record-def(t1, 900, mkBody) in // register mk (name 900) → body 41
  let (callId, t2) = add-node(t1d, Node.NApp(900, -1)) in
  let (oneId, t3) = add-node(t2, Node.NLit(1)) in
  let (root, tree) = add-node(t3, Node.NBin(43, callId, oneId)) in
  match eval-tree(tree, root) with
    | Option.Some(v) => if v == 42 then unit else trap("(+ (mk) 1) = 42 (call nested in arith)")
    | Option.None(_) => trap("a nullary call nested in arith evals")

@test
def ev-nullary-call-chain-inlines-transitively() =
  // a CHAIN of nullary calls: `g`'s body IS a call to `f` (f body = 42), and the root calls `g`. So the root
  // NApp inlines g's body — which is ITSELF an NApp — which in turn inlines f's body 42. Pins that lowering
  // inlines a callee body TRANSITIVELY (NApp over NApp), the shape `(def (f) 42) (def (g) (f)) (g)` produces.
  let (fBody, t1) = add-node(empty-tree(), Node.NLit(42)) in
  let t1d = record-def(t1, 900, fBody) in // f (name 900) → body 42
  let (gBody, t2) = add-node(t1d, Node.NApp(900, -1)) in // g's body: a call to f
  let t2d = record-def(t2, 901, gBody) in // g (name 901) → body `(f)`
  let (root, tree) = add-node(t2d, Node.NApp(901, -1)) in // root: `(g)`
  match eval-tree(tree, root) with
    | Option.Some(v) => if v == 42 then
      unit
    else
      trap("(g) where g=(f), f=42 → 42 (transitive inline)")
    | Option.None(_) => trap("a chain of nullary calls inlines transitively")

@test
def ev-napp-with-arg-but-no-param-declines() =
  // a call WITH an arg but NO recorded param (an OVER-APPLIED nullary def `(mk 5)`) declines: lower's NApp arm
  // finds param-of(calleeId) = None → no Core → eval None. This is DISTINCT from a genuine param call (which
  // records a param — see ev-param-call-clet below). slice-3c is LANDED; the decline here is correct because
  // no param was recorded, NOT because param-calls are unimplemented. (No record-param on this tree.)
  let (bodyId, t1) = add-node(empty-tree(), Node.NLit(7)) in
  let (argId, t2) = add-node(t1, Node.NLit(5)) in
  let (root, tree) = add-node(t2, Node.NApp(bodyId, argId)) in
  match eval-tree(tree, root) with
    | Option.None(_) => unit
    | Option.Some(_) => trap(
      "a call WITH an arg but NO recorded param declines (over-applied nullary)"
    )

@test
def ev-param-call-clet() =
  // slice-3c at the eval-core UNIT level: a SINGLE-PARAM call `f(41)` where `f(n) = n + 1` → 42. Hand-arena:
  // param NVar node `n`, body `NBin(+, n, 1)`, register f (name 900) → its body (record-def) AND its param
  // (record-param, keyed by name), then NApp(900, argId) with argId a real arg node. eval-tree resolves name→
  // body/param, lowers to CLet(paramNode, argCore, bodyCore) → binds 41 to the param, evals the body → 42. The
  // direct-Core complement to sread-eval's se-single-param-call (full source pipeline); exercises CLet without
  // the reader.
  let (paramId, t1) = add-node(empty-tree(), Node.NVar(7)) in
  let (oneId, t2) = add-node(t1, Node.NLit(1)) in
  let (bodyId, t3) = add-node(t2, Node.NBin(43, paramId, oneId)) in
  let (argId, t4) = add-node(t3, Node.NLit(41)) in
  let (root, t5) = add-node(t4, Node.NApp(900, argId)) in
  let tree = record-param(record-def(t5, 900, bodyId), 900, paramId) in
  match eval-tree(tree, root) with
    | Option.Some(v) => if v == 42 then unit else trap("f(41) where f(n)=n+1 → 42")
    | Option.None(_) => trap("a single-param call lowers to CLet + evals")

@test
def ev-nested-clet-two-params() =
  // multi-param eval SHAPE pre-validation (slice-3d): the NESTED CLet a 2-arg call `(add a b)` = `(+ a b)`
  // will lower to — CLet(p1, arg1, CLet(p2, arg2, CBin(+, CVar p1, CVar p2))). Binds arg1→p1, arg2→p2, evals
  // the body → 40+2 = 42. Direct-Core (no reader): pins that eval-core handles the two-binder nesting the
  // multi-param wiring emits, BEFORE that wiring lands — so the eval semantics are proven independently.
  match eval-core(
      Core.CLet(
        100,
        Core.CNum(40, true, 64),
        Core.CLet(
          101,
          Core.CNum(2, true, 64),
          Core.CBin(43, true, 64, Core.CVar(100), Core.CVar(101))
        )
      ),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 42 then unit else trap("nested CLet (two params) → 40+2 = 42")
    | Option.None(_) => trap("a two-param nested CLet evaluates")

/// slice-B3 def-env eval tests (direct-Core, hand-built def-env — proves the recursion MECHANISM before
/// `lower-def-env`/B2 wire the source pipeline). fac's param binder-id is 7, name-id 100:
///   fac(n) = if (n < 1) then 1 else n * fac(n - 1)   as Core:
///   CIf(CBin(60, CVar 7, CNum 1), CNum 1, CBin(42, CVar 7, CCall(100, [CBin(45, CVar 7, CNum 1)])))
def b3-fac-body() =
  Core.CIf(
    Core.CBin(60, true, 64, Core.CVar(7), Core.CNum(1, true, 64)),
    Core.CNum(1, true, 64),
    Core.CBin(
      42,
      true,
      64,
      Core.CVar(7),
      Core.CCall(100, List.push([], Core.CBin(45, true, 64, Core.CVar(7), Core.CNum(1, true, 64))))
    )
  )

def b3-fac-defs() =
  Map.insert(Map.empty : Map(Int64, (List(Int64), Core)), 100, (List.push([], 7), b3-fac-body()))

@test
def ev-recursive-fac-runs-via-def-env-slice-b3() =
  // (fac 5) => 120 — the whole point of Slice B: recursion RUNS, terminating on the program's own base case.
  match eval-core-d(
      Core.CCall(100, List.push([], Core.CNum(5, true, 64))),
      Map.empty : Map(Int64, Value),
      b3-fac-defs()
    ) with
    | Option.Some(v) => if v == 120 then unit else trap("(fac 5) via def-env → 120")
    | Option.None(_) => trap("recursive fac should RUN to a value via the def-env")

@test
def ev-recursive-fac-base-case-slice-b3() =
  // (fac 0) => 1 — the base arm of the recursion (n < 1) short-circuits with no self-call.
  match eval-core-d(
      Core.CCall(100, List.push([], Core.CNum(0, true, 64))),
      Map.empty : Map(Int64, Value),
      b3-fac-defs()
    ) with
    | Option.Some(v) => if v == 1 then unit else trap("(fac 0) → 1 (base case)")
    | Option.None(_) => trap("recursive fac base case should run")

@test
def ev-recursive-countdown-runs-slice-b3() =
  // countdown(n) = if (n < 1) then 0 else countdown(n - 1) ; (countdown 7) => 0 — proves a nullary-result
  // tail-style recursion drains to the base case (distinct from fac's multiplying spine).
  let cd-body = Core.CIf(
      Core.CBin(60, true, 64, Core.CVar(7), Core.CNum(1, true, 64)),
      Core.CNum(0, true, 64),
      Core.CCall(200, List.push([], Core.CBin(45, true, 64, Core.CVar(7), Core.CNum(1, true, 64))))
    ) in
  let cd-defs = Map.insert(
      Map.empty : Map(Int64, (List(Int64), Core)),
      200,
      (List.push([], 7), cd-body)
    ) in
  match eval-core-d(
      Core.CCall(200, List.push([], Core.CNum(7, true, 64))),
      Map.empty : Map(Int64, Value),
      cd-defs
    ) with
    | Option.Some(v) => if v == 0 then unit else trap("(countdown 7) → 0")
    | Option.None(_) => trap("countdown should drain to its base case")

@test
def ev-ccall-empty-def-env-declines-slice-b3() =
  // REGRESSION GUARD (B1a behavior preserved): a CCall with NO def-env (the 2-arg `eval-core` path every
  // existing caller uses) still DECLINES — recursion only runs when a real def-env is supplied.
  match eval-core(
      Core.CCall(100, List.push([], Core.CNum(5, true, 64))),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(_) => trap("a CCall with no def-env must DECLINE (B1a behavior)")
    | Option.None(_) => unit

@test
def ev-mutual-recursion-ev-od-slice-b3() =
  // MUTUAL recursion (the design doc's open ev/od question): two defs each CALL the other, both in ONE
  // def-env. ev(n) = if (n == 0) then 1 else od(n - 1); od(n) = if (n == 0) then 0 else ev(n - 1).
  // name-ids: ev=300, od=301; both take param binder 7. (ev 4) => 1, (od 4) => 0 (4 is even). Proves the
  // def-env dispatch handles a cross-referencing SCC — a self-call is a NAME lookup, so ev→od→ev just walks
  // `defs` with no special mutual-recursion machinery.
  let ev-body = Core.CIf(
      Core.CBin(61, true, 64, Core.CVar(7), Core.CNum(0, true, 64)),
      Core.CNum(1, true, 64),
      Core.CCall(301, List.push([], Core.CBin(45, true, 64, Core.CVar(7), Core.CNum(1, true, 64))))
    ) in
  let od-body = Core.CIf(
      Core.CBin(61, true, 64, Core.CVar(7), Core.CNum(0, true, 64)),
      Core.CNum(0, true, 64),
      Core.CCall(300, List.push([], Core.CBin(45, true, 64, Core.CVar(7), Core.CNum(1, true, 64))))
    ) in
  let evod-defs = Map.insert(
      Map.insert(Map.empty : Map(Int64, (List(Int64), Core)), 300, (List.push([], 7), ev-body)),
      301,
      (List.push([], 7), od-body)
    ) in
  match eval-core-d(
      Core.CCall(300, List.push([], Core.CNum(4, true, 64))),
      Map.empty : Map(Int64, Value),
      evod-defs
    ) with
    | Option.None(_) => trap("(ev 4) should run via mutual dispatch")
    | Option.Some(evv) => match eval-core-d(
        Core.CCall(301, List.push([], Core.CNum(4, true, 64))),
        Map.empty : Map(Int64, Value),
        evod-defs
      ) with
      | Option.None(_) => trap("(od 4) should run via mutual dispatch")
      | Option.Some(odv) => if evv == 1 and odv == 0 then
        unit
      else
        trap("(ev 4)=1 and (od 4)=0 via mutual recursion")

/// M2-b-2b USER SUM PAYLOAD ctor eval tests (direct-Core, hand-built — proves the CCtor/CMatchSum + SumStore
/// MECHANISM before the reader/infer/lower wiring, exactly like the slice-B3 def-env tests proved recursion
/// before lower-def-env). A payload ctor `Some 5` = CCtor(1, [CNum 5]); deconstruct via CMatchSum on the tag.
@test
def ev-cctor-constructs-and-matches-payload() =
  // `match (Some 5) with Some x => x | _ => 0` → 5. CCtor(1,[5]) allocs a handle; CMatchSum(scrut, tag 1,
  // binders [100], then=CVar 100, else=CNum 0) reads store-tag==1 → binds payload[0]=5 to binder 100 → CVar 100 = 5.
  match eval-core(
      Core.CMatchSum(
        Core.CCtor(1, List.push([], Core.CNum(5, true, 64))),
        1,
        List.push([], 100),
        Core.CVar(100),
        Core.CNum(0, true, 64)
      ),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 5 then unit else trap("match (Some 5) Some x => x → 5")
    | Option.None(_) => trap("a payload ctor constructs + its payload binds in a matching arm")

@test
def ev-cmatchenum-bare-tag-matches() =
  // ii-c2b-2 Z1: a match arm over an ENUM-DISC (all-nullary) sum. The scrutinee is a BARE TAG — here CNum 1
  // (e.g. (Green) of Color, which lowers to its ordinal tag, no heap cell). CMatchEnum(scrut, tag 1, then=CNum
  // 200, else=CNum 300) compares the scrutinee VALUE directly (== 1) → the then-arm → 200. This is the path
  // plain CMatchSum can't take (store-tag None on a bare tag → always-else); CMatchEnum bare-tag-compares.
  match eval-core(
      Core.CMatchEnum(Core.CNum(1, true, 64), 1, Core.CNum(200, true, 64), Core.CNum(300, true, 64)),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 200 then unit else trap("CMatchEnum bare-tag == 1 → then arm → 200")
    | Option.None(_) => trap("an enum-disc bare-tag match hits its arm")

@test
def ev-cmatchenum-bare-tag-mismatch-takes-else() =
  // the complement: a bare-tag scrutinee CNum 2 vs a tag-1 CMatchEnum → the else, 300. Pins the direct-compare
  // fall-through (a different enum-disc variant takes the next arm).
  match eval-core(
      Core.CMatchEnum(Core.CNum(2, true, 64), 1, Core.CNum(200, true, 64), Core.CNum(300, true, 64)),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 300 then
      unit
    else
      trap("CMatchEnum bare-tag 2 != 1 → else arm → 300")
    | Option.None(_) => trap("an enum-disc bare-tag mismatch takes the else arm")

@test
def ev-cmatchsum-tag-mismatch-takes-else() =
  // `match (Some 5) with None => 111 | _ => 222` (tag 1 value vs tag-0 pattern) → the else, 222. Proves the
  // tag test selects the fall-through arm when the discriminant differs.
  match eval-core(
      Core.CMatchSum(
        Core.CCtor(1, List.push([], Core.CNum(5, true, 64))),
        0,
        [] : List(Int64),
        Core.CNum(111, true, 64),
        Core.CNum(222, true, 64)
      ),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 222 then unit else trap("tag mismatch → else arm → 222")
    | Option.None(_) => trap("a tag-mismatched sum match takes the else arm")

@test
def ev-cctor-two-field-payload-binds-both() =
  // a two-field ctor `Pair 3 4` = CCtor(0,[3,4]); `match (Pair 3 4) with Pair a b => a + b` → 7. Binds
  // payload[0]→a(100), payload[1]→b(101), then = CBin(+, CVar 100, CVar 101).
  match eval-core(
      Core.CMatchSum(
        Core.CCtor(
          0,
          List.concat(List.push([], Core.CNum(3, true, 64)), List.push([], Core.CNum(4, true, 64)))
        ),
        0,
        List.concat(List.push([], 100), List.push([], 101)),
        Core.CBin(43, true, 64, Core.CVar(100), Core.CVar(101)),
        Core.CNum(0, true, 64)
      ),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 7 then unit else trap("Pair 3 4 → a+b = 7")
    | Option.None(_) => trap("a two-field payload ctor binds both fields")

@test
def ev-cmatchsum-nested-arms-second-matches() =
  // an N-arm sum match = nested CMatchSum. `match (Some 9) with None => 0 | Some x => x` written as
  // CMatchSum(scrut, tag0, [], CNum 0, CMatchSum(scrut, tag1, [100], CVar 100, CNum -1)) → 9. Pins that the
  // else-chain re-tests the SAME scrutinee handle against the next arm's tag (mirrors NMatch→CIf chaining).
  let scrut = Core.CCtor(1, List.push([], Core.CNum(9, true, 64))) in
  match eval-core(
      Core.CMatchSum(
        scrut,
        0,
        [] : List(Int64),
        Core.CNum(0, true, 64),
        Core.CMatchSum(scrut, 1, List.push([], 100), Core.CVar(100), Core.CNum(-1, true, 64))
      ),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 9 then
      unit
    else
      trap("nested sum arms: (Some 9) → the Some arm → 9")
    | Option.None(_) => trap("a nested-arm sum match runs")

@test
def ev-cctor-nested-sum-payload() =
  // NESTED sum `Some (Some 7)` = CCtor(1,[CCtor(1,[CNum 7])]); match the outer Some x => (match x with Some y => y).
  // Proves a sum handle rides as a payload element (handle IS an Int64) — inner match reads the inner handle's payload.
  match eval-core(
      Core.CMatchSum(
        Core.CCtor(1, List.push([], Core.CCtor(1, List.push([], Core.CNum(7, true, 64))))),
        1,
        List.push([], 100),
        Core.CMatchSum(
          Core.CVar(100),
          1,
          List.push([], 101),
          Core.CVar(101),
          Core.CNum(0, true, 64)
        ),
        Core.CNum(0, true, 64)
      ),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 7 then unit else trap("Some (Some 7) → inner payload 7")
    | Option.None(_) => trap("a nested sum payload deconstructs")

export {
  Value.*,
  value-int,
  eval-core,
  eval-core-d,
  eval-bin,
  eval-tree,
  run,
  milestone-tokens,
  run-milestone
}
