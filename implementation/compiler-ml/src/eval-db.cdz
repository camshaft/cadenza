def ev-unary-minus-in-arith() =
  // 10 + -3  →  7 (unary minus as an operand: 10 + (0 - 3)).
  match run([n(10), plus(), neg(), n(3)]) with
    | Option.Some(v) => if v == 7 then unit else trap("10 + -3 = 7")
    | Option.None(_) => trap("runs")

