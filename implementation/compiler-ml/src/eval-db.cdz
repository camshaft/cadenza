/// eval-db.cdz — Increment 5 of the Cadenza-in-Cadenza compiler: EMIT + RUN, the END-TO-END MILESTONE. This
/// evaluates the lowered integer Core IR (`lower-db`) to a value, and — via the `run` driver — takes a token
/// program all the way source → parse → resolve → infer → lower → RUN, through the lazy query DB.
///
/// THE MILESTONE (re-charter): `let x = 2 in x * 3 + 1` runs to **7**. `run-milestone()` demonstrates it.
///
/// The evaluator is trivial precisely because the earlier columns did their jobs: lowering CANONICALIZED
/// every variable to its binder node-id (`CVar(binderId)`) and keyed every `CLet` by that same id, so eval
/// carries an `env: Map(binderId, Int64)` and needs ZERO scope logic — `CLet(b, v, body)` evaluates `body`
/// under `env{b → eval v}`, and `CVar(b)` is just `env` lookup. This is the pay-off of resolution-as-a-column.
///
/// `eval-core` returns `Option(Int64)`: `None` only on a malformed Core (an unbound `CVar` — impossible for a
/// tree that came through `lower-tree`, which canonicalizes only RBound vars, but handled totally). `run`
/// composes lowering (itself gated on typing) with eval, so an ill-typed source program yields `None`
/// (no core form → nothing to run) — absence≠value carried all the way to the result.
import { Tok, Tree, Node, parse-tokens, empty-tree, add-node, record-def, record-param } from "parse-db"

import { Core, lower-tree } from "lower-db"

import { overflows } from "int-width"

import { SumStore, empty-store, store-alloc, store-tag, store-payload } from "sum-store"

/// VERDICT-WIDENING S-w0 (foundation): the eval VALUE is now a `Value` sum, not a bare `Int64`. Today the sole
/// variant is `VInt(Int64)` — so this is BEHAVIOR-IDENTICAL to the old Int64-valued interpreter (every VInt
/// wraps the same Int64 the old code carried), but it is the seam a String/Char verdict rides later (S-w1 adds
/// VStr/VChar producers; S-w2 widens run-src's Option(Int64) return + render). Confined to eval-db.cdz: the
/// PUBLIC boundary (eval-core/eval-core-d/eval-tree/run) still returns `Option(Int64)` — eval-core-d UNWRAPS the
/// final VInt (a non-VInt result — impossible today — would decline to None, exactly the old "no Int value"
/// behavior), so db-eval / sread-eval / every @test are untouched. `SumStore` stays Int64-keyed (handles/tags/
/// payloads are addresses+ordinals, never user strings): Value↔Int64 converts at the store boundary only
/// (CCtor unwraps args to store; bind-payload/CProj wrap reads back). A fn-value is VInt(name-ordinal).
type Value =
  | VInt(Int64)

/// Unwrap a Value to its Int64 (the store/eval-bin boundary). Total: VInt → Some; a non-VInt (none today —
/// VStr/VChar arrive in S-w1) → None, so a store-alloc/arith/handle site DECLINES on it (sound partial).
def value-int(v: Value) = match v with
  | Value.VInt(x) => Option.Some(x)

/// Unwrap a `List(Value)` to `List(Int64)` for a store-alloc payload — total, index recursion (the compiler-ml
/// idiom). Any non-VInt element (none today) sinks the whole list to None → the CCtor site declines (a String
/// in a sum payload is deferred to S-w1+: widen the store or intern to a handle).
def values-ints(vs: List(Value), i: Int64, acc: List(Int64)) =
  if i == List.len(vs) then
    Option.Some(acc)
  else
    match List.at(vs, i) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(v) => match value-int(v) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(x) => values-ints(vs, i + 1, List.concat(acc, List.push([], x)))

/// Evaluate a Core term under `env` (binderId → value). Total: an unbound var or divide-by-zero → `None`.
/// The DEF-ENV (slice-B1b/B3): `name → (paramBinderIds, bodyCore)`. Recursion is a STATIC name reference
/// (never a heap cycle — memory-and-resource-model.md §The Value Heap Is Acyclic), so a self-call is a lookup
/// in `defs`, not a value pointer. Built by `lower-def-env` (lower-db) for the source pipeline; hand-built in
/// the direct-Core @tests here. `eval-core` keeps its 2-arg shape (empty def-env → a CCall still DECLINES,
/// exactly the B1a behavior — every existing caller is unchanged); the recursion path threads a real `defs`
/// through the workhorse `eval-core-d`.
def eval-core(c: Core, env: Map(Int64, Value)) =
  eval-core-d(c, env, Map.empty : Map(Int64, (List(Int64), Core)))

/// eval-args (slice-B3, M2-b-2a store-threaded): eval each arg-term in the CURRENT (caller) env, left-to-right,
/// collecting values AND threading the growing `SumStore` (an arg may CONSTRUCT a sum → allocates into the
/// store, whose store' must flow to the next arg's eval). Returns `Option((List(Int64), SumStore))`. Index
/// recursion (List.at/List.len) — the compiler-ml idiom; a List is never cons-destructured here. Any arg that
/// declines sinks the whole call to `None` (total).
def eval-args(args: List(Core), i: Int64, env: Map(Int64, Value), defs: Map(
  Int64,
  Tuple(List(Int64), Core)
), store: SumStore) =
  if i == List.len(args) then
    Option.Some(([] : List(Value), store))
  else
    match List.at(args, i) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(a) => match eval-core-s(a, env, defs, store) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(vs1) => let (v, store1) = vs1 in
          match eval-args(args, i + 1, env, defs, store1) with
            | Option.None(_) => Option.None(unit)
            | Option.Some(rs) => let (rest, store2) = rs in
              Option.Some((List.concat(List.push([], v), rest), store2))

/// bind-params (slice-B3): bind param binder-ids positionally to arg values in a FRESH env (lexical — the
/// callee body sees ONLY its params + defs, never the caller's locals). Index recursion. Ragged arity (a
/// shorter vals/params list) stops early — the arity guard lives in infer (B2); eval is total.
def bind-params(params: List(Int64), vals: List(Value), i: Int64, acc: Map(Int64, Value)) =
  if i == List.len(params) then
    acc
  else
    match List.at(params, i) with
      | Option.None(_) => acc
      | Option.Some(p) => match List.at(vals, i) with
        | Option.None(_) => acc
        | Option.Some(v) => bind-params(params, vals, i + 1, Map.insert(acc, p, v))

/// bind-payload (M2-b-2b): bind a sum value's payload elements to a CMatchSum arm's binder-ids in `env`. For
/// each binder `binders[i]`, read `store-payload(store, h, i)` and insert `binder → value` (env is the CVar
/// key space, exactly like bind-params). Index recursion. A missing payload element (ragged — impossible for a
/// well-typed match, arity comes from the ctor decl) stops early; eval is total.
def bind-payload(store: SumStore, h: Int64, binders: List(Int64), i: Int64, env: Map(Int64, Value)) =
  if i == List.len(binders) then
    env
  else
    match List.at(binders, i) with
      | Option.None(_) => env
      | Option.Some(b) => // WILDCARD `_`: a -1 sentinel binder means IGNORE this field — CONSUME the store slot (index i still
      // tracks the FIELD position, so a `_` in field 0 must NOT shift field 1's store-payload(h,1) read) but
      // insert NOTHING (no name-id(_) key → N wildcards never collide). Continue to i+1 either way.
      if b == -1 then
        bind-payload(store, h, binders, i + 1, env) // skip-insert, advance slot
      else
        match store-payload(store, h, i) with
          | Option.None(_) => env
          // the store holds Int64 payload elements; wrap as VInt entering the Value-keyed env (S-w0).
          | Option.Some(v) => bind-payload(
            store,
            h,
            binders,
            i + 1,
            Map.insert(env, b, Value.VInt(v))
          )

/// apply-def-by-name (slice-B3 / HO-3, DRY): dispatch a def by NAME — the shared body of CCall and CFnRefVar.
/// Look the name up in the def-env; eval the args in the CURRENT (caller) env; bind them positionally into a
/// FRESH env (lexical); eval the body under it. An unknown name (empty def-env — the B1a/existing 2-arg path)
/// or a declining arg → None (total). This was INLINED at BOTH call sites during HO-3 because factoring it
/// created a new member of eval-core-d's mutual-recursion SCC, which tripped a compiler-ml/rcdzc
/// monomorphization bug (spurious CDZ0101 unbound param; queue/mlrepro-new-fn-in-eval-core-mutual-recursion-
/// cycle-spurious-unbound-param.md). v-inference fixed that host bug (`5cdc957da`, type_specialize scope-skip),
/// so the two arms now SHARE this helper.
def apply-def-by-name(name: Int64, args: List(Core), env: Map(Int64, Value), defs: Map(
  Int64,
  Tuple(List(Int64), Core)
), store: SumStore) = match Map.lookup(defs, name) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(pb) => let (params, body) = pb in
    match eval-args(args, 0, env, defs, store) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(vs) => let (vals, store1) = vs in
        eval-core-s(body, bind-params(params, vals, 0, Map.empty : Map(Int64, Value)), defs, store1)

/// eval-core-d (slice-B3): the 3-arg PUBLIC workhorse — evaluate a Core term under `env` + `defs`, returning
/// `Option(Int64)` (the value, store discarded). A thin wrapper over the store-threaded `eval-core-s`: seed an
/// empty SumStore, run, project out the value. Keeps eval-core-d's signature EXACTLY (every external caller +
/// @test is unchanged — the M2-b-2a store threading is confined behind this wrapper).
def eval-core-d(c: Core, env: Map(Int64, Value), defs: Map(Int64, Tuple(List(Int64), Core))) = match eval-core-s(
    c,
    env,
    defs,
    empty-store()
  ) with
  | Option.None(_) => Option.None(unit)
  // S-w0 boundary: unwrap the final Value to Option(Int64) so every external caller/@test is unchanged. A
  // non-VInt result (impossible today; VStr/VChar arrive in S-w1) declines to None — exactly the old
  // "no Int value" behavior. run-src's Option(Int64) return widens later (S-w2) to render the wider verdict.
  | Option.Some(vs) => let (v, _) = vs in
    value-int(v)

/// The store-threaded workhorse (M2-b-2a): `eval-core-d` + a `SumStore` threaded IN and OUT of every arm, so a
/// sum-value CONSTRUCTION (CCtor, added M2-b-2b) can ALLOCATE into the store and the grown store' flows onward.
/// Returns `Option((Int64, SumStore))` — the value + the (possibly-grown) store. Today (M2-b-2a) NO arm allocs
/// — the store passes through UNCHANGED, so this is byte-for-byte behavior-identical to the old eval-core-d
/// (every existing @test stays green); the threading is the plumbing M2-b-2b's CCtor/CMatch arms need. `defs`
/// is read-only (a def-env, per slice-B3); the SumStore GROWS (v-inference's note: unlike defs, thread store'
/// forward from each sub-eval). CNum/CVar/CFnRef don't touch the store; CBin/CLet/CIf/CCall/CFnRefVar thread it
/// through their sub-evals. Recursion terminates by the PROGRAM's base case (a CIf guard), never by fuel.
def eval-core-s(c: Core, env: Map(Int64, Value), defs: Map(Int64, Tuple(List(Int64), Core)), store: SumStore) = match c with
  | Core.CNum(v, _, _) => Option.Some((Value.VInt(v), store)) // a scalar literal is VInt; width is an emit concern
  | Core.CVar(b) => (match Map.lookup(env, b) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(v) => Option.Some((v, store))
  ) // env already holds a Value — pass it through
  | Core.CBin(op, signed, width, l, r) => // corrected-2b: a NARROW (width<64) ARITH result TRAPS on overflow (→ None) — matching spec §Overflow
  // + the reference's CDZ0304 (the unqualified +/-/* traps; wrapping is the opt-in .wrapping-* form, not
  // here). Int64 (width 64) + comparisons (0/1, width 64) never overflow-check. So `(: 100 Int8) +
  // (: 100 Int8)` = 200, overflows Int8 → None (declines); `(: 100 Int8) + (: 20 Int8)` = 120 fits → Some.
  // Thread the store L→R (a sub-expr may construct a sum): store → store1 (after l) → store2 (after r).
  // S-w0: unwrap both operand Values to Int64 for eval-bin (a non-VInt operand — none today — declines);
  // rewrap the arith result as VInt.
  (match eval-core-s(l, env, defs, store) with
    | Option.Some(as1) => (let (av, store1) = as1 in
      match eval-core-s(r, env, defs, store1) with
        | Option.Some(bs2) => (let (bv, store2) = bs2 in
          match value-int(av) with
            | Option.None(_) => Option.None(unit)
            | Option.Some(a) => match value-int(bv) with
              | Option.None(_) => Option.None(unit)
              | Option.Some(b) => match eval-bin(op, a, b) with
                | Option.Some(v) => if width < 64 then
                  if overflows(v, signed, width) then
                    Option.None(unit)
                  else
                    Option.Some((Value.VInt(v), store2))
                else
                  Option.Some((Value.VInt(v), store2))
                | Option.None(_) => Option.None(unit))
        | Option.None(_) => Option.None(unit))
    | Option.None(_) => Option.None(unit)
  )
  | Core.CLet(binder, valExpr, body) => // non-recursive let: eval the value in the CURRENT env (threading store → store1), bind the Value to the
  // let's canonical id, eval body under store1.
  (match eval-core-s(valExpr, env, defs, store) with
    | Option.Some(vs1) => let (v, store1) = vs1 in
      eval-core-s(body, Map.insert(env, binder, v), defs, store1)
    | Option.None(_) => Option.None(unit)
  )
  | Core.CIf(cond, thn, els) => // Bool is 0/1 in Core: a non-zero condition takes the then-branch, zero takes the else. Only the taken
  // branch is evaluated (lazy). Thread store: cond → store1, then the taken branch under store1. S-w0:
  // unwrap the cond Value to test its Int (a non-VInt cond — none today — declines).
  (match eval-core-s(cond, env, defs, store) with
    | Option.Some(cs1) => (let (cv, store1) = cs1 in
      match value-int(cv) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(c) => if c == 0 then
          eval-core-s(els, env, defs, store1)
        else
          eval-core-s(thn, env, defs, store1))
    | Option.None(_) => Option.None(unit)
  )
  | Core.CCall(name, args) => // slice-B3: a recursive call is a NON-inlining name reference — dispatched by name via the shared
  // apply-def-by-name (unknown name / declining arg → None). Recursion terminates on the program's own
  // base case (a CIf guard), never by fuel. Threads the store through the args + body.
  apply-def-by-name(name, args, env, defs, store)
  | Core.CFnRef(name) => // HIGHER-ORDER: a def-name as a first-class fn VALUE. A function value IS its name (top-level defs are
  // closed — no capture), carried as VInt(name-ordinal); the CFnRefVar site unwraps + dispatches it.
  Option.Some((Value.VInt(name), store))
  | Core.CFnRefVar(fBinder, args) => // HIGHER-ORDER apply: call the fn-value held in binder `fBinder` (a fn-typed param). Look up the binder's
  // Value = the callee def-NAME (a VInt put there by a CFnRef arg), unwrap it, then dispatch by name via the
  // SHARED apply-def-by-name — the same helper CCall uses. An unbound binder / non-VInt / unknown name → None.
  (match Map.lookup(env, fBinder) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(nameV) => match value-int(nameV) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(name) => apply-def-by-name(name, args, env, defs, store)
  )
  | Core.CCtor(tag, args) => // M2-b-2b USER SUM PAYLOAD ctor: eval the payload args (threading the store L→R — an arg may itself
  // construct a sum), then store-ALLOC (tag, arg-values) → the Int64 HANDLE, carried as VInt. eval-args
  // collects Values; values-ints unwraps them to the Int64 payload the store holds (a non-VInt payload
  // element — none today — declines; storing a String payload is a later S-w1+ decision).
  (match eval-args(args, 0, env, defs, store) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(vs) => let (vals, store1) = vs in
      match values-ints(vals, 0, [] : List(Int64)) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(ints) => let (h, store2) = store-alloc(store1, tag, ints) in
          Option.Some((Value.VInt(h), store2))
  )
  | Core.CMatchSum(scrut, tag, binders, thn, els) => // M2-b-2b sum DECONSTRUCT: eval scrut to a handle, read its store-tag. If it EQUALS `tag`, bind each
  // payload element to its binder (store-payload h i → binders[i]) and eval `then` under that env; else
  // eval `else` (fall-through to the next arm). 🔑 a scrutinee that is NOT an allocated handle — e.g. a
  // NULLARY ctor value (a bare tag Int, M2-a) or any non-sum scalar — has store-tag None: it simply does
  // NOT match this PAYLOAD-ctor pattern, so take the ELSE arm (NOT a decline). Threads the store. S-w0:
  // unwrap the scrut Value to the Int64 handle (a non-VInt scrut — none today — declines).
  (match eval-core-s(scrut, env, defs, store) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(hs) => let (hv, store1) = hs in
      match value-int(hv) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(h) => match store-tag(store1, h) with
          | Option.None(_) => eval-core-s(els, env, defs, store1) // not a payload sum → pattern doesn't match → else
          | Option.Some(scrutTag) => if scrutTag == tag then
            eval-core-s(thn, bind-payload(store1, h, binders, 0, env), defs, store1)
          else
            eval-core-s(els, env, defs, store1)
  )
  | Core.CMatchEnum(scrut, tag, thn, els) => // ii-c2b-2 ENUM-DISC deconstruct (Z1): an all-nullary sum value is a BARE TAG (a CNum, no heap cell) — so
  // eval the scrutinee to its value and compare it DIRECTLY against `tag` (NOT store-tag, which returns None
  // for a bare tag). Equal → `then` (no binders — a nullary ctor has no payload), else → `else`. Sound
  // without a runtime marker: infer gated the scrutinee to TSum-of-the-decl, so the Int IS a ctor tag. S-w0:
  // unwrap the scrut Value to its Int tag.
  (match eval-core-s(scrut, env, defs, store) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(vs) => let (vv, store1) = vs in
      match value-int(vv) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(v) => if v == tag then
          eval-core-s(thn, env, defs, store1)
        else
          eval-core-s(els, env, defs, store1)
  )
  | Core.CProj(operand, index) => // TUPLE PROJECTION `(. t i)`: eval the operand to its SumStore handle (a tuple is CCtor(0, elems)), then
  // read `store-payload(h, index)` — the i-th element value. infer proved the operand is a tuple and the
  // index is in-bounds, so the read succeeds; a None (non-handle scalar / out-of-bounds) declines totally.
  // S-w0: unwrap the operand Value to the Int64 handle; wrap the Int64 payload read back as VInt.
  match eval-core-s(operand, env, defs, store) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(hs) => let (hv, store1) = hs in
      match value-int(hv) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(h) => match store-payload(store1, h, index) with
          | Option.Some(v) => Option.Some((Value.VInt(v), store1))
          | Option.None(_) => Option.None(unit)

/// Apply a binary op: 43 +, 45 -, 42 *, 47 /, and the relational ops 60 `<`, 61 `==`, 62 `>`, 63 `<=`,
/// 64 `>=`, 65 `!=`. Relational ops yield a Bool encoded as 0/1 (Core represents Bool as an Int); each of
/// the four new ones is defined in terms of the primitives `<` and `==`:
///   a > b  ≡ b < a ;  a <= b ≡ not (b < a) ;  a >= b ≡ not (a < b) ;  a != b ≡ not (a == b).
/// Division by zero → `None` (a total, trap-free evaluator).
def eval-bin(op: Int64, a: Int64, b: Int64) =
  // MATCH on the op-code (idiomatic dispatch on the literal, not an `if op == N` ladder — the operator's
  // match-everywhere bar). Same semantics: 43 + / 45 - / 42 * ; 47 / and 37 % guard divide/mod-by-zero to
  // None (trap-free); 60..65 relationals encode a Bool as 0/1, each defined via `<`/`==`.
  match op with
    | 43 => Option.Some(a + b)
    | 45 => Option.Some(a - b)
    | 42 => Option.Some(a * b)
    | 47 => if b == 0 then Option.None(unit) else Option.Some(a / b)
    | 37 => // modulo; %0 → None (trap). `Int64.min % -1` is mathematically 0 (no overflow), but the host `%`
    // FAULTS on it (the same INT_MIN/-1 hardware trap as division) → special-case b == -1 to 0, matching
    // rcdzc's rule (lower.rs: "MIN % -1 is 0 … but Rust's % panics there — special-case it to 0"). Without
    // this, `(% (: Int64.min Int64) (: -1 Int64))` wrongly DECLINED where rcdzc returns 0.
    if b == 0 then Option.None(unit) else if b == -1 then Option.Some(0) else Option.Some(a % b)
    | 60 => Option.Some(if a < b then 1 else 0)
    | 61 => Option.Some(if a == b then 1 else 0)
    | 62 => Option.Some(if b < a then 1 else 0) // a > b  ≡ b < a
    | 63 => Option.Some(if b < a then 0 else 1) // a <= b ≡ not (b < a)
    | 64 => Option.Some(if a < b then 0 else 1) // a >= b ≡ not (a < b)
    | 65 => Option.Some(if a == b then 0 else 1) // a != b ≡ not (a == b)
    | _ => Option.None(unit)

/// Evaluate a lowered tree from `root` with an empty env — `Some value` for a well-typed program, `None` if
/// it had no core form (ill-typed) or hit a malformed Core.
def eval-tree(tree: Tree, root: Int64) = match lower-tree(tree, root) with
  | Option.Some(c) => eval-core(c, Map.empty : Map(Int64, Value))
  | Option.None(_) => Option.None(unit)

/// THE DRIVER: a token program → its integer result, source → parse → resolve → infer → lower → run, all via
/// the lazy query DB. `Some v` = ran to `v`; `None` = ill-typed (no core form) or malformed.
def run(ts: List(Tok)) =
  let (root, tree) = parse-tokens(ts) in
  eval-tree(tree, root)

/// Builders + the milestone program, so the end-to-end result is demonstrable without hand-tokenizing.
def n(v: Int64) = Tok.TNum(v)

def var(nm: Int64) = Tok.TName(nm)

def plus() = Tok.TOp(43)

def minus() = Tok.TOp(45)

def times() = Tok.TOp(42)

def divop() = Tok.TOp(47)

def modop() = Tok.TOp(37)

def letkw() = Tok.TLet

def inkw() = Tok.TIn

def eq() = Tok.TEq

def lt() = Tok.TOp(60)

def eqop() = Tok.TOp(61)

def gt() = Tok.TOp(62)

def le() = Tok.TOp(63)

def ge() = Tok.TOp(64)

def ne() = Tok.TOp(65)

def ifkw() = Tok.TIf

def thenkw() = Tok.TThen

def elsekw() = Tok.TElse

def truelit() = Tok.TBoolTok(1)

def falselit() = Tok.TBoolTok(0)

def neg() = Tok.TNeg

/// `let x = 2 in x * 3 + 1` as tokens — THE MILESTONE program.
def milestone-tokens() = [letkw(), var(1), eq(), n(2), inkw(), var(1), times(), n(3), plus(), n(1)]

/// Run the milestone program end-to-end; `Some 7` when the whole DB pipeline works.
def run-milestone() = run(milestone-tokens())

@test
def ev-literal() = match run([n(42)]) with
  | Option.Some(v) => if v == 42 then unit else trap("42")
  | Option.None(_) => trap("a literal runs")

@test
def ev-add() =
  // 1 + 2 = 3
  match run([n(1), plus(), n(2)]) with
    | Option.Some(v) => if v == 3 then unit else trap("1+2=3")
    | Option.None(_) => trap("add runs")

@test
def ev-precedence() =
  // 1 + 2 * 3 = 7 (mul binds tighter) — arithmetic honoring the parse-column precedence.
  match run([n(1), plus(), n(2), times(), n(3)]) with
    | Option.Some(v) => if v == 7 then unit else trap("1+2*3=7")
    | Option.None(_) => trap("runs")

@test
def ev-let-substitutes() =
  // let x = 2 in x  →  2 (the bound value flows through the env keyed by the let's canonical id).
  match run([letkw(), var(1), eq(), n(2), inkw(), var(1)]) with
    | Option.Some(v) => if v == 2 then unit else trap("x=2")
    | Option.None(_) => trap("let runs")

@test
def ev-let-used-in-arith() =
  // let x = 5 in x - 2  →  3
  match run([letkw(), var(1), eq(), n(5), inkw(), var(1), minus(), n(2)]) with
    | Option.Some(v) => if v == 3 then unit else trap("5-2=3")
    | Option.None(_) => trap("runs")

@test
def ev-shadowing-inner-value() =
  // let x = 1 in let x = 2 in x  →  2 (inner binding shadows; env keyed by distinct binder ids picks inner).
  match run([letkw(), var(1), eq(), n(1), inkw(), letkw(), var(1), eq(), n(2), inkw(), var(1)]) with
    | Option.Some(v) => if v == 2 then unit else trap("shadow → 2")
    | Option.None(_) => trap("runs")

@test
def ev-nested-lets-arith() =
  // let a = 1 in let b = 2 in a + b  →  3 (two distinct bindings, both read).
  match run(
      [
        letkw(),
        var(1),
        eq(),
        n(1),
        inkw(),
        letkw(),
        var(2),
        eq(),
        n(2),
        inkw(),
        var(1),
        plus(),
        var(2)
      ]
    ) with
    | Option.Some(v) => if v == 3 then unit else trap("a+b=3")
    | Option.None(_) => trap("runs")

@test
def ev-ill-typed-does-not-run() =
  // an unbound "x" is ill-typed → no core form → run yields None (absence carried to the result).
  match run([var(1)]) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("ill-typed program does not run")

@test
def ev-milestone-runs-to-seven() =
  // ★ THE RE-CHARTER MILESTONE ★ — `let x = 2 in x * 3 + 1` goes source → parse → resolve → infer → lower →
  // run, all through the lazy query DB, and produces 7 (x=2, 2*3=6, 6+1=7).
  match run-milestone() with
    | Option.Some(v) => if v == 7 then unit else trap("MILESTONE: let x=2 in x*3+1 = 7")
    | Option.None(_) => trap("MILESTONE must run to a value")

@test
def ev-less-than-true() =
  // 1 < 2  →  1 (Bool true encoded as 1).
  match run([n(1), lt(), n(2)]) with
    | Option.Some(v) => if v == 1 then unit else trap("1<2 = 1")
    | Option.None(_) => trap("comparison runs")

@test
def ev-less-than-false() =
  // 5 < 2  →  0 (Bool false).
  match run([n(5), lt(), n(2)]) with
    | Option.Some(v) => if v == 0 then unit else trap("5<2 = 0")
    | Option.None(_) => trap("runs")

@test
def ev-equality-true() =
  // 3 == 3  →  1.
  match run([n(3), eqop(), n(3)]) with
    | Option.Some(v) => if v == 1 then unit else trap("3==3 = 1")
    | Option.None(_) => trap("runs")

@test
def ev-equality-false() =
  // 3 == 4  →  0.
  match run([n(3), eqop(), n(4)]) with
    | Option.Some(v) => if v == 0 then unit else trap("3==4 = 0")
    | Option.None(_) => trap("runs")

@test
def ev-comparison-of-arith() =
  // 1 + 2 < 4  →  (3 < 4) = 1 (comparison looser than additive; the whole thing runs to a Bool).
  match run([n(1), plus(), n(2), lt(), n(4)]) with
    | Option.Some(v) => if v == 1 then unit else trap("1+2<4 = 1")
    | Option.None(_) => trap("runs")

@test
def ev-let-bound-bool() =
  // let b = 2 < 3 in b  →  1 (a Bool-valued binding flows through the env).
  match run([letkw(), var(1), eq(), n(2), lt(), n(3), inkw(), var(1)]) with
    | Option.Some(v) => if v == 1 then unit else trap("let b = 2<3 in b = 1")
    | Option.None(_) => trap("runs")

@test
def ev-if-takes-then() =
  // if 1 < 2 then 10 else 20  →  10 (cond true).
  match run([ifkw(), n(1), lt(), n(2), thenkw(), n(10), elsekw(), n(20)]) with
    | Option.Some(v) => if v == 10 then unit else trap("true → then=10")
    | Option.None(_) => trap("if runs")

@test
def ev-if-takes-else() =
  // if 5 < 2 then 10 else 20  →  20 (cond false).
  match run([ifkw(), n(5), lt(), n(2), thenkw(), n(10), elsekw(), n(20)]) with
    | Option.Some(v) => if v == 20 then unit else trap("false → else=20")
    | Option.None(_) => trap("runs")

@test
def ev-if-with-let-and-arith() =
  // let x = 3 in if x == 3 then x * 2 else 0  →  6 (a let bound var read in cond AND the taken branch).
  match run(
      [
        letkw(),
        var(1),
        eq(),
        n(3),
        inkw(),
        ifkw(),
        var(1),
        eqop(),
        n(3),
        thenkw(),
        var(1),
        times(),
        n(2),
        elsekw(),
        n(0)
      ]
    ) with
    | Option.Some(v) => if v == 6 then unit else trap("x=3; x==3 → x*2 = 6")
    | Option.None(_) => trap("runs")

@test
def ev-if-untaken-branch-not-evaluated() =
  // The evaluator's `if` is LAZY: only the taken branch is evaluated. Build the Core DIRECTLY —
  // `CIf(CNum 1, CNum 7, CBin(47, CNum 1, CNum 0))` — i.e. `if 1 then 7 else (1 / 0)`, using division
  // (op 47), which `eval-bin` supports but the SURFACE parser does not yet. (An earlier version wrote the
  // else as source tokens `1 / 0`; since parse-db has no op-47 node, those tokens were dropped and the test
  // passed for the wrong reason — Copilot on PR #519 caught this. Constructing the Core directly pins the
  // evaluator's laziness without depending on an unsupported surface operator.) A non-zero cond takes the
  // then-branch; the else `1 / 0` would eval to `None` if evaluated, so getting `Some 7` proves it is NOT.
  match eval-core(
      Core.CIf(
        Core.CNum(1, true, 64),
        Core.CNum(7, true, 64),
        Core.CBin(47, true, 64, Core.CNum(1, true, 64), Core.CNum(0, true, 64))
      ),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 7 then unit else trap("taken branch only → 7")
    | Option.None(_) => trap("lazy if: the untaken 1/0 else must NOT be evaluated")

@test
def ev-if-taken-branch-divide-by-zero-does-sink() =
  // The complement, to prove the above isn't vacuous: if the DIVIDE-BY-ZERO is in the TAKEN branch, eval
  // DOES reach it and yields None. `if 1 then (1 / 0) else 7` → None. Together these pin that laziness is
  // branch-selective, not a blanket skip.
  match eval-core(
      Core.CIf(
        Core.CNum(1, true, 64),
        Core.CBin(47, true, 64, Core.CNum(1, true, 64), Core.CNum(0, true, 64)),
        Core.CNum(7, true, 64)
      ),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("a divide-by-zero in the TAKEN branch must sink to None")

@test
def ev-narrow-cbin-in-range-is-some() =
  // corrected-2b at the eval-core UNIT level (the sread path pins it end-to-end; this builds the narrow CBin
  // DIRECTLY, like the lazy-if tests, so the trap arm is exercised without the reader/infer/lower chain).
  // `CBin(+, Int8, CNum 100, CNum 20)` = 120 fits Int8 → Some 120 (the width<64 arm checks overflow, passes).
  match eval-core(
      Core.CBin(43, true, 8, Core.CNum(100, true, 8), Core.CNum(20, true, 8)),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 120 then unit else trap("Int8 100+20 = 120 (in range)")
    | Option.None(_) => trap("an in-range narrow CBin evaluates to Some")

@test
def ev-narrow-cbin-overflow-is-none() =
  // the trap arm: `CBin(+, Int8, CNum 100, CNum 100)` = 200 OVERFLOWS Int8 (max 127) → None (width<64 +
  // overflows → the CDZ0304 trap, NOT a wrapped -56, NOT an unchecked 200). The direct-Core complement to
  // sread-eval's se-ann-narrow-arith-overflow-declines.
  match eval-core(
      Core.CBin(43, true, 8, Core.CNum(100, true, 8), Core.CNum(100, true, 8)),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("Int8 100+100 = 200 overflows → None (traps, not wraps)")

@test
def ev-narrow-cbin-unsigned-overflow-is-none() =
  // unsigned twin: `CBin(+, UInt8, CNum 200, CNum 100)` = 300 overflows UInt8 (max 255) → None.
  match eval-core(
      Core.CBin(43, false, 8, Core.CNum(200, false, 8), Core.CNum(100, false, 8)),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("UInt8 200+100 = 300 overflows → None")

@test
def ev-narrow-cbin-unsigned-underflow-is-none() =
  // unsigned SUBTRACTION underflow, at the eval-core UNIT level: `CBin(-, UInt8, CNum 0, CNum 1)` = -1
  // UNDERFLOWS UInt8 (min 0, can't hold -1) → None (the width<64 overflows-check catches -1 as out-of-range
  // for unsigned; NOT a wrapped 255). This is the direct-Core complement to sread-eval's
  // se-ann-unsigned-narrow-underflow-declines (which runs end-to-end but can't validate until the value-heap
  // box emit fix lands); this hand-built CBin exercises the trap arm WITHOUT the reader/infer/lower/emit
  // chain, so it compiles + guards the underflow decline today. rcdzc rejects the same at compile time (CDZ0304).
  match eval-core(
      Core.CBin(45, false, 8, Core.CNum(0, false, 8), Core.CNum(1, false, 8)),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("UInt8 0-1 = -1 underflows → None (not wrapped 255)")

@test
def ev-narrow-cbin-mul-in-range-is-some() =
  // narrow MULTIPLICATION at eval-core: `CBin(*, Int8, CNum 10, CNum 12)` = 120 fits Int8 (max 127) → Some 120.
  // The eval-core narrow tests covered + (43) and - (45); this + the twin below add * (42), the third arith op
  // the width<64 overflow-check arm handles uniformly. Direct-Core complement to sread-eval's narrow-mul tests.
  match eval-core(
      Core.CBin(42, true, 8, Core.CNum(10, true, 8), Core.CNum(12, true, 8)),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 120 then unit else trap("Int8 10*12 = 120 (in range)")
    | Option.None(_) => trap("an in-range narrow MUL evaluates to Some")

@test
def ev-narrow-cbin-mul-overflow-is-none() =
  // narrow MUL that OVERFLOWS: `CBin(*, Int8, CNum 20, CNum 20)` = 400 OVERFLOWS Int8 (max 127) → None (the
  // width<64 + overflows check traps, per CDZ0304 — NOT a wrapped value). Completes the eval-core arith-op
  // coverage (+, -, * all trap narrow overflow); direct-Core complement to se-ann-narrow-mul-overflow-declines.
  match eval-core(
      Core.CBin(42, true, 8, Core.CNum(20, true, 8), Core.CNum(20, true, 8)),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("Int8 20*20 = 400 overflows → None (traps, not wraps)")

@test
def ev-width64-cbin-never-overflow-checks() =
  // the complement proving the guard is width-SELECTIVE, not a blanket check: a width-64 CBin does NOT
  // overflow-check (the `width < 64` arm is false → straight Some). A large-but-Int64-valued sum evaluates to
  // its exact value: `CBin(+, Int64, CNum 100, CNum 100)` = 200 → Some 200 (same operands as the Int8 case
  // above, but at width 64 it is NOT a trap — the width is what distinguishes them).
  match eval-core(
      Core.CBin(43, true, 64, Core.CNum(100, true, 64), Core.CNum(100, true, 64)),
      Map.empty : Map(Int64, Value)
    ) with
    | Option.Some(v) => if v == 200 then
      unit
    else
      trap("Int64 100+100 = 200 (no overflow-check at width 64)")
    | Option.None(_) => trap("a width-64 CBin never overflow-traps")

@test
def ev-nested-else-if() =
  // if 5 < 1 then 100 else if 5 < 10 then 200 else 300  →  200 (else-if chain, middle branch).
  match run(
      [
        ifkw(),
        n(5),
        lt(),
        n(1),
        thenkw(),
        n(100),
        elsekw(),
        ifkw(),
        n(5),
        lt(),
        n(10),
        thenkw(),
        n(200),
        elsekw(),
        n(300)
      ]
    ) with
    | Option.Some(v) => if v == 200 then unit else trap("else-if chain → 200")
    | Option.None(_) => trap("runs")

