    | Option.Some(v) => if v == 7 then unit else trap("if false → 7")
    | Option.None(_) => trap("runs")

@test
def ev-let-bound-bool-literal() =
  // let b = true in if b then 5 else 6  →  5 (a bool literal flows through a let binding into a cond).
  match run(
      [letkw(), var(1), eq(), truelit(), inkw(), ifkw(), var(1), thenkw(), n(5), elsekw(), n(6)]
