/// eval-db.cdz — Increment 5 of the Cadenza-in-Cadenza compiler: EMIT + RUN, the END-TO-END MILESTONE. This
/// evaluates the lowered integer Core IR (`lower-db`) to a value, and — via the `run` driver — takes a token
/// program all the way source → parse → resolve → infer → lower → RUN, through the lazy query DB.
///
/// THE MILESTONE (re-charter): `let x = 2 in x * 3 + 1` runs to **7**. `run-milestone()` demonstrates it.
///
/// The evaluator is trivial precisely because the earlier columns did their jobs: lowering CANONICALIZED
/// every variable to its binder node-id (`CVar(binderId)`) and keyed every `CLet` by that same id, so eval
/// carries an `env: Map(binderId, Int64)` and needs ZERO scope logic — `CLet(b, v, body)` evaluates `body`
/// under `env{b → eval v}`, and `CVar(b)` is just `env` lookup. This is the pay-off of resolution-as-a-column.
///
/// `eval-core` returns `Option(Int64)`: `None` only on a malformed Core (an unbound `CVar` — impossible for a
/// tree that came through `lower-tree`, which canonicalizes only RBound vars, but handled totally). `run`
/// composes lowering (itself gated on typing) with eval, so an ill-typed source program yields `None`
/// (no core form → nothing to run) — absence≠value carried all the way to the result.

import { Tok, Tree, Node, parse-tokens, empty-tree, add-node, record-def, record-param } from "parse-db"
import { Core, lower-tree } from "lower-db"
import { overflows } from "int-width"

/// Evaluate a Core term under `env` (binderId → value). Total: an unbound var or divide-by-zero → `None`.
def eval-core(c: Core, env: Map(Int64, Int64)) = match c with
  | Core.CNum(v, _, _) => Option.Some(v)   // the interpreter oracle reads the VALUE; width is an emit concern
  | Core.CVar(b) => Map.lookup(env, b)
  | Core.CBin(op, signed, width, l, r) =>
      // corrected-2b: a NARROW (width<64) ARITH result TRAPS on overflow (→ None) — matching spec §Overflow
      // + the reference's CDZ0304 (the unqualified +/-/* traps; wrapping is the opt-in .wrapping-* form, not
      // here). Int64 (width 64) + comparisons (0/1, width 64) never overflow-check. So `(: 100 Int8) +
      // (: 100 Int8)` = 200, overflows Int8 → None (declines); `(: 100 Int8) + (: 20 Int8)` = 120 fits → Some.
      (match eval-core(l, env) with
        | Option.Some(a) =>
          (match eval-core(r, env) with
            | Option.Some(b) => (match eval-bin(op, a, b) with
                | Option.Some(v) => (if (width < 64) then (if overflows(v, signed, width) then Option.None(unit) else Option.Some(v)) else Option.Some(v))
                | Option.None(_) => Option.None(unit))
            | Option.None(_) => Option.None(unit))
        | Option.None(_) => Option.None(unit))
  | Core.CLet(binder, valExpr, body) =>
      // non-recursive let: eval the value in the CURRENT env, bind it to the let's canonical id, eval body.
      (match eval-core(valExpr, env) with
        | Option.Some(v) => eval-core(body, Map.insert(env, binder, v))
        | Option.None(_) => Option.None(unit))
  | Core.CIf(cond, thn, els) =>
      // Bool is 0/1 in Core: a non-zero condition takes the then-branch, zero takes the else. Only the taken
      // branch is evaluated (lazy — a divide-by-zero in the untaken branch does NOT sink the result).
      (match eval-core(cond, env) with
        | Option.Some(c) => (if (c == 0) then eval-core(els, env) else eval-core(thn, env))
        | Option.None(_) => Option.None(unit))

/// Apply a binary op: 43 +, 45 -, 42 *, 47 /, and the relational ops 60 `<`, 61 `==`, 62 `>`, 63 `<=`,
/// 64 `>=`, 65 `!=`. Relational ops yield a Bool encoded as 0/1 (Core represents Bool as an Int); each of
/// the four new ones is defined in terms of the primitives `<` and `==`:
///   a > b  ≡ b < a ;  a <= b ≡ not (b < a) ;  a >= b ≡ not (a < b) ;  a != b ≡ not (a == b).
/// Division by zero → `None` (a total, trap-free evaluator).
def eval-bin(op: Int64, a: Int64, b: Int64) =
  // MATCH on the op-code (idiomatic dispatch on the literal, not an `if op == N` ladder — the operator's
  // match-everywhere bar). Same semantics: 43 + / 45 - / 42 * ; 47 / and 37 % guard divide/mod-by-zero to
  // None (trap-free); 60..65 relationals encode a Bool as 0/1, each defined via `<`/`==`.
  match op with
    | 43 => Option.Some(a + b)
    | 45 => Option.Some(a - b)
    | 42 => Option.Some(a * b)
    | 47 => (if b == 0 then Option.None(unit) else Option.Some(a / b))
    | 37 =>
        // modulo; %0 → None (trap). `Int64.min % -1` is mathematically 0 (no overflow), but the host `%`
        // FAULTS on it (the same INT_MIN/-1 hardware trap as division) → special-case b == -1 to 0, matching
        // rcdzc's rule (lower.rs: "MIN % -1 is 0 … but Rust's % panics there — special-case it to 0"). Without
        // this, `(% (: Int64.min Int64) (: -1 Int64))` wrongly DECLINED where rcdzc returns 0.
        (if b == 0 then Option.None(unit) else (if b == (0 - 1) then Option.Some(0) else Option.Some(a % b)))
    | 60 => Option.Some(if a < b then 1 else 0)
    | 61 => Option.Some(if a == b then 1 else 0)
    | 62 => Option.Some(if b < a then 1 else 0)                  // a > b  ≡ b < a
    | 63 => Option.Some(if b < a then 0 else 1)                  // a <= b ≡ not (b < a)
    | 64 => Option.Some(if a < b then 0 else 1)                  // a >= b ≡ not (a < b)
    | 65 => Option.Some(if a == b then 0 else 1)                 // a != b ≡ not (a == b)
    | _ => Option.None(unit)

/// Evaluate a lowered tree from `root` with an empty env — `Some value` for a well-typed program, `None` if
/// it had no core form (ill-typed) or hit a malformed Core.
def eval-tree(tree: Tree, root: Int64) = match lower-tree(tree, root) with
  | Option.Some(c) => eval-core(c, (Map.empty : Map(Int64, Int64)))
  | Option.None(_) => Option.None(unit)

/// THE DRIVER: a token program → its integer result, source → parse → resolve → infer → lower → run, all via
/// the lazy query DB. `Some v` = ran to `v`; `None` = ill-typed (no core form) or malformed.
def run(ts: List(Tok)) = let (root, tree) = parse-tokens(ts) in eval-tree(tree, root)


/// Builders + the milestone program, so the end-to-end result is demonstrable without hand-tokenizing.
def n(v: Int64) = Tok.TNum(v)
def var(nm: Int64) = Tok.TName(nm)
def plus() = Tok.TOp(43)
def minus() = Tok.TOp(45)
def times() = Tok.TOp(42)
def divop() = Tok.TOp(47)
def modop() = Tok.TOp(37)
def letkw() = Tok.TLet
def inkw() = Tok.TIn
def eq() = Tok.TEq
def lt() = Tok.TOp(60)
def eqop() = Tok.TOp(61)
def gt() = Tok.TOp(62)
def le() = Tok.TOp(63)
def ge() = Tok.TOp(64)
def ne() = Tok.TOp(65)
def ifkw() = Tok.TIf
def thenkw() = Tok.TThen
def elsekw() = Tok.TElse
def truelit() = Tok.TBoolTok(1)
def falselit() = Tok.TBoolTok(0)
def neg() = Tok.TNeg

/// `let x = 2 in x * 3 + 1` as tokens — THE MILESTONE program.
def milestone-tokens() = [letkw(), var(1), eq(), n(2), inkw(), var(1), times(), n(3), plus(), n(1)]

/// Run the milestone program end-to-end; `Some 7` when the whole DB pipeline works.
def run-milestone() = run(milestone-tokens())

@test
def ev-literal() =
  (match run([n(42)]) with | Option.Some(v) => (if v == 42 then unit else trap("42")) | Option.None(_) => trap("a literal runs"))

@test
def ev-add() =
  // 1 + 2 = 3
  (match run([n(1), plus(), n(2)]) with | Option.Some(v) => (if v == 3 then unit else trap("1+2=3")) | Option.None(_) => trap("add runs"))

@test
def ev-precedence() =
  // 1 + 2 * 3 = 7 (mul binds tighter) — arithmetic honoring the parse-column precedence.
  (match run([n(1), plus(), n(2), times(), n(3)]) with | Option.Some(v) => (if v == 7 then unit else trap("1+2*3=7")) | Option.None(_) => trap("runs"))

@test
def ev-let-substitutes() =
  // let x = 2 in x  →  2 (the bound value flows through the env keyed by the let's canonical id).
  (match run([letkw(), var(1), eq(), n(2), inkw(), var(1)]) with | Option.Some(v) => (if v == 2 then unit else trap("x=2")) | Option.None(_) => trap("let runs"))

@test
def ev-let-used-in-arith() =
  // let x = 5 in x - 2  →  3
  (match run([letkw(), var(1), eq(), n(5), inkw(), var(1), minus(), n(2)]) with | Option.Some(v) => (if v == 3 then unit else trap("5-2=3")) | Option.None(_) => trap("runs"))

@test
def ev-shadowing-inner-value() =
  // let x = 1 in let x = 2 in x  →  2 (inner binding shadows; env keyed by distinct binder ids picks inner).
  (match run([letkw(), var(1), eq(), n(1), inkw(), letkw(), var(1), eq(), n(2), inkw(), var(1)]) with | Option.Some(v) => (if v == 2 then unit else trap("shadow → 2")) | Option.None(_) => trap("runs"))

@test
def ev-nested-lets-arith() =
  // let a = 1 in let b = 2 in a + b  →  3 (two distinct bindings, both read).
  (match run([letkw(), var(1), eq(), n(1), inkw(), letkw(), var(2), eq(), n(2), inkw(), var(1), plus(), var(2)]) with | Option.Some(v) => (if v == 3 then unit else trap("a+b=3")) | Option.None(_) => trap("runs"))

@test
def ev-ill-typed-does-not-run() =
  // an unbound "x" is ill-typed → no core form → run yields None (absence carried to the result).
  (match run([var(1)]) with | Option.None(_) => unit | Option.Some(_) => trap("ill-typed program does not run"))

@test
def ev-milestone-runs-to-seven() =
  // ★ THE RE-CHARTER MILESTONE ★ — `let x = 2 in x * 3 + 1` goes source → parse → resolve → infer → lower →
  // run, all through the lazy query DB, and produces 7 (x=2, 2*3=6, 6+1=7).
  (match run-milestone() with | Option.Some(v) => (if v == 7 then unit else trap("MILESTONE: let x=2 in x*3+1 = 7")) | Option.None(_) => trap("MILESTONE must run to a value"))

@test
def ev-less-than-true() =
  // 1 < 2  →  1 (Bool true encoded as 1).
  (match run([n(1), lt(), n(2)]) with | Option.Some(v) => (if v == 1 then unit else trap("1<2 = 1")) | Option.None(_) => trap("comparison runs"))

@test
def ev-less-than-false() =
  // 5 < 2  →  0 (Bool false).
  (match run([n(5), lt(), n(2)]) with | Option.Some(v) => (if v == 0 then unit else trap("5<2 = 0")) | Option.None(_) => trap("runs"))

@test
def ev-equality-true() =
  // 3 == 3  →  1.
  (match run([n(3), eqop(), n(3)]) with | Option.Some(v) => (if v == 1 then unit else trap("3==3 = 1")) | Option.None(_) => trap("runs"))

@test
def ev-equality-false() =
  // 3 == 4  →  0.
  (match run([n(3), eqop(), n(4)]) with | Option.Some(v) => (if v == 0 then unit else trap("3==4 = 0")) | Option.None(_) => trap("runs"))

@test
def ev-comparison-of-arith() =
  // 1 + 2 < 4  →  (3 < 4) = 1 (comparison looser than additive; the whole thing runs to a Bool).
  (match run([n(1), plus(), n(2), lt(), n(4)]) with | Option.Some(v) => (if v == 1 then unit else trap("1+2<4 = 1")) | Option.None(_) => trap("runs"))

@test
def ev-let-bound-bool() =
  // let b = 2 < 3 in b  →  1 (a Bool-valued binding flows through the env).
  (match run([letkw(), var(1), eq(), n(2), lt(), n(3), inkw(), var(1)]) with | Option.Some(v) => (if v == 1 then unit else trap("let b = 2<3 in b = 1")) | Option.None(_) => trap("runs"))

@test
def ev-if-takes-then() =
  // if 1 < 2 then 10 else 20  →  10 (cond true).
  (match run([ifkw(), n(1), lt(), n(2), thenkw(), n(10), elsekw(), n(20)]) with | Option.Some(v) => (if v == 10 then unit else trap("true → then=10")) | Option.None(_) => trap("if runs"))

@test
def ev-if-takes-else() =
  // if 5 < 2 then 10 else 20  →  20 (cond false).
  (match run([ifkw(), n(5), lt(), n(2), thenkw(), n(10), elsekw(), n(20)]) with | Option.Some(v) => (if v == 20 then unit else trap("false → else=20")) | Option.None(_) => trap("runs"))

@test
def ev-if-with-let-and-arith() =
  // let x = 3 in if x == 3 then x * 2 else 0  →  6 (a let bound var read in cond AND the taken branch).
  (match run([letkw(), var(1), eq(), n(3), inkw(), ifkw(), var(1), eqop(), n(3), thenkw(), var(1), times(), n(2), elsekw(), n(0)]) with | Option.Some(v) => (if v == 6 then unit else trap("x=3; x==3 → x*2 = 6")) | Option.None(_) => trap("runs"))

@test
def ev-if-untaken-branch-not-evaluated() =
  // The evaluator's `if` is LAZY: only the taken branch is evaluated. Build the Core DIRECTLY —
  // `CIf(CNum 1, CNum 7, CBin(47, CNum 1, CNum 0))` — i.e. `if 1 then 7 else (1 / 0)`, using division
  // (op 47), which `eval-bin` supports but the SURFACE parser does not yet. (An earlier version wrote the
  // else as source tokens `1 / 0`; since parse-db has no op-47 node, those tokens were dropped and the test
  // passed for the wrong reason — Copilot on PR #519 caught this. Constructing the Core directly pins the
  // evaluator's laziness without depending on an unsupported surface operator.) A non-zero cond takes the
  // then-branch; the else `1 / 0` would eval to `None` if evaluated, so getting `Some 7` proves it is NOT.
  (match eval-core(Core.CIf(Core.CNum(1, true, 64), Core.CNum(7, true, 64), Core.CBin(47, true, 64, Core.CNum(1, true, 64), Core.CNum(0, true, 64))), (Map.empty : Map(Int64, Int64))) with
    | Option.Some(v) => (if v == 7 then unit else trap("taken branch only → 7"))
    | Option.None(_) => trap("lazy if: the untaken 1/0 else must NOT be evaluated"))

@test
def ev-if-taken-branch-divide-by-zero-does-sink() =
  // The complement, to prove the above isn't vacuous: if the DIVIDE-BY-ZERO is in the TAKEN branch, eval
  // DOES reach it and yields None. `if 1 then (1 / 0) else 7` → None. Together these pin that laziness is
  // branch-selective, not a blanket skip.
  (match eval-core(Core.CIf(Core.CNum(1, true, 64), Core.CBin(47, true, 64, Core.CNum(1, true, 64), Core.CNum(0, true, 64)), Core.CNum(7, true, 64)), (Map.empty : Map(Int64, Int64))) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("a divide-by-zero in the TAKEN branch must sink to None"))

@test
def ev-narrow-cbin-in-range-is-some() =
  // corrected-2b at the eval-core UNIT level (the sread path pins it end-to-end; this builds the narrow CBin
  // DIRECTLY, like the lazy-if tests, so the trap arm is exercised without the reader/infer/lower chain).
  // `CBin(+, Int8, CNum 100, CNum 20)` = 120 fits Int8 → Some 120 (the width<64 arm checks overflow, passes).
  (match eval-core(Core.CBin(43, true, 8, Core.CNum(100, true, 8), Core.CNum(20, true, 8)), (Map.empty : Map(Int64, Int64))) with
    | Option.Some(v) => (if v == 120 then unit else trap("Int8 100+20 = 120 (in range)"))
    | Option.None(_) => trap("an in-range narrow CBin evaluates to Some"))

@test
def ev-narrow-cbin-overflow-is-none() =
  // the trap arm: `CBin(+, Int8, CNum 100, CNum 100)` = 200 OVERFLOWS Int8 (max 127) → None (width<64 +
  // overflows → the CDZ0304 trap, NOT a wrapped -56, NOT an unchecked 200). The direct-Core complement to
  // sread-eval's se-ann-narrow-arith-overflow-declines.
  (match eval-core(Core.CBin(43, true, 8, Core.CNum(100, true, 8), Core.CNum(100, true, 8)), (Map.empty : Map(Int64, Int64))) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("Int8 100+100 = 200 overflows → None (traps, not wraps)"))

@test
def ev-narrow-cbin-unsigned-overflow-is-none() =
  // unsigned twin: `CBin(+, UInt8, CNum 200, CNum 100)` = 300 overflows UInt8 (max 255) → None.
  (match eval-core(Core.CBin(43, false, 8, Core.CNum(200, false, 8), Core.CNum(100, false, 8)), (Map.empty : Map(Int64, Int64))) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("UInt8 200+100 = 300 overflows → None"))

@test
def ev-narrow-cbin-unsigned-underflow-is-none() =
  // unsigned SUBTRACTION underflow, at the eval-core UNIT level: `CBin(-, UInt8, CNum 0, CNum 1)` = -1
  // UNDERFLOWS UInt8 (min 0, can't hold -1) → None (the width<64 overflows-check catches -1 as out-of-range
  // for unsigned; NOT a wrapped 255). This is the direct-Core complement to sread-eval's
  // se-ann-unsigned-narrow-underflow-declines (which runs end-to-end but can't validate until the value-heap
  // box emit fix lands); this hand-built CBin exercises the trap arm WITHOUT the reader/infer/lower/emit
  // chain, so it compiles + guards the underflow decline today. rcdzc rejects the same at compile time (CDZ0304).
  (match eval-core(Core.CBin(45, false, 8, Core.CNum(0, false, 8), Core.CNum(1, false, 8)), (Map.empty : Map(Int64, Int64))) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("UInt8 0-1 = -1 underflows → None (not wrapped 255)"))

@test
def ev-narrow-cbin-mul-in-range-is-some() =
  // narrow MULTIPLICATION at eval-core: `CBin(*, Int8, CNum 10, CNum 12)` = 120 fits Int8 (max 127) → Some 120.
  // The eval-core narrow tests covered + (43) and - (45); this + the twin below add * (42), the third arith op
  // the width<64 overflow-check arm handles uniformly. Direct-Core complement to sread-eval's narrow-mul tests.
  (match eval-core(Core.CBin(42, true, 8, Core.CNum(10, true, 8), Core.CNum(12, true, 8)), (Map.empty : Map(Int64, Int64))) with
    | Option.Some(v) => (if v == 120 then unit else trap("Int8 10*12 = 120 (in range)"))
    | Option.None(_) => trap("an in-range narrow MUL evaluates to Some"))

@test
def ev-narrow-cbin-mul-overflow-is-none() =
  // narrow MUL that OVERFLOWS: `CBin(*, Int8, CNum 20, CNum 20)` = 400 OVERFLOWS Int8 (max 127) → None (the
  // width<64 + overflows check traps, per CDZ0304 — NOT a wrapped value). Completes the eval-core arith-op
  // coverage (+, -, * all trap narrow overflow); direct-Core complement to se-ann-narrow-mul-overflow-declines.
  (match eval-core(Core.CBin(42, true, 8, Core.CNum(20, true, 8), Core.CNum(20, true, 8)), (Map.empty : Map(Int64, Int64))) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("Int8 20*20 = 400 overflows → None (traps, not wraps)"))

@test
def ev-width64-cbin-never-overflow-checks() =
  // the complement proving the guard is width-SELECTIVE, not a blanket check: a width-64 CBin does NOT
  // overflow-check (the `width < 64` arm is false → straight Some). A large-but-Int64-valued sum evaluates to
  // its exact value: `CBin(+, Int64, CNum 100, CNum 100)` = 200 → Some 200 (same operands as the Int8 case
  // above, but at width 64 it is NOT a trap — the width is what distinguishes them).
  (match eval-core(Core.CBin(43, true, 64, Core.CNum(100, true, 64), Core.CNum(100, true, 64)), (Map.empty : Map(Int64, Int64))) with
    | Option.Some(v) => (if v == 200 then unit else trap("Int64 100+100 = 200 (no overflow-check at width 64)"))
    | Option.None(_) => trap("a width-64 CBin never overflow-traps"))

@test
def ev-nested-else-if() =
  // if 5 < 1 then 100 else if 5 < 10 then 200 else 300  →  200 (else-if chain, middle branch).
  (match run([ifkw(), n(5), lt(), n(1), thenkw(), n(100), elsekw(), ifkw(), n(5), lt(), n(10), thenkw(), n(200), elsekw(), n(300)]) with | Option.Some(v) => (if v == 200 then unit else trap("else-if chain → 200")) | Option.None(_) => trap("runs"))

@test
def ev-bool-literal-true() =
  // true  →  1 (Bool literal encodes as 1).
  (match run([truelit()]) with | Option.Some(v) => (if v == 1 then unit else trap("true = 1")) | Option.None(_) => trap("bool literal runs"))

@test
def ev-if-true-literal-cond() =
  // if true then 42 else 0  →  42 (a bool literal directly as the condition).
  (match run([ifkw(), truelit(), thenkw(), n(42), elsekw(), n(0)]) with | Option.Some(v) => (if v == 42 then unit else trap("if true → 42")) | Option.None(_) => trap("runs"))

@test
def ev-if-false-literal-cond() =
  // if false then 42 else 7  →  7.
  (match run([ifkw(), falselit(), thenkw(), n(42), elsekw(), n(7)]) with | Option.Some(v) => (if v == 7 then unit else trap("if false → 7")) | Option.None(_) => trap("runs"))

@test
def ev-let-bound-bool-literal() =
  // let b = true in if b then 5 else 6  →  5 (a bool literal flows through a let binding into a cond).
  (match run([letkw(), var(1), eq(), truelit(), inkw(), ifkw(), var(1), thenkw(), n(5), elsekw(), n(6)]) with | Option.Some(v) => (if v == 5 then unit else trap("let b = true → 5")) | Option.None(_) => trap("runs"))

@test
def ev-unary-minus() =
  // -5  →  -5 (desugars to 0 - 5).
  (match run([neg(), n(5)]) with | Option.Some(v) => (if v == (0 - 5) then unit else trap("-5 = -5")) | Option.None(_) => trap("unary minus runs"))

@test
def ev-unary-minus-in-arith() =
  // 10 + -3  →  7 (unary minus as an operand: 10 + (0 - 3)).
  (match run([n(10), plus(), neg(), n(3)]) with | Option.Some(v) => (if v == 7 then unit else trap("10 + -3 = 7")) | Option.None(_) => trap("runs"))

@test
def ev-unary-minus-of-let-var() =
  // let x = 4 in -x  →  -4.
  (match run([letkw(), var(1), eq(), n(4), inkw(), neg(), var(1)]) with | Option.Some(v) => (if v == (0 - 4) then unit else trap("-x where x=4 is -4")) | Option.None(_) => trap("runs"))

@test
def ev-double-negation() =
  // - -5  →  5 (0 - (0 - 5)).
  (match run([neg(), neg(), n(5)]) with | Option.Some(v) => (if v == 5 then unit else trap("- -5 = 5")) | Option.None(_) => trap("runs"))

@test
def ev-gt() =
  // 3 > 2 → 1 ; 2 > 3 → 0.
  (match run([n(3), gt(), n(2)]) with | Option.Some(v) => (if v == 1 then (match run([n(2), gt(), n(3)]) with | Option.Some(w) => (if w == 0 then unit else trap("2>3=0")) | Option.None(_) => trap("runs")) else trap("3>2=1")) | Option.None(_) => trap("runs"))

@test
def ev-le() =
  // 2 <= 2 → 1 ; 3 <= 2 → 0.
  (match run([n(2), le(), n(2)]) with | Option.Some(v) => (if v == 1 then (match run([n(3), le(), n(2)]) with | Option.Some(w) => (if w == 0 then unit else trap("3<=2=0")) | Option.None(_) => trap("runs")) else trap("2<=2=1")) | Option.None(_) => trap("runs"))

@test
def ev-ge() =
  // 2 >= 3 → 0 ; 3 >= 3 → 1.
  (match run([n(2), ge(), n(3)]) with | Option.Some(v) => (if v == 0 then (match run([n(3), ge(), n(3)]) with | Option.Some(w) => (if w == 1 then unit else trap("3>=3=1")) | Option.None(_) => trap("runs")) else trap("2>=3=0")) | Option.None(_) => trap("runs"))

@test
def ev-ne() =
  // 3 != 4 → 1 ; 3 != 3 → 0.
  (match run([n(3), ne(), n(4)]) with | Option.Some(v) => (if v == 1 then (match run([n(3), ne(), n(3)]) with | Option.Some(w) => (if w == 0 then unit else trap("3!=3=0")) | Option.None(_) => trap("runs")) else trap("3!=4=1")) | Option.None(_) => trap("runs"))

@test
def ev-rel-in-if() =
  // if 5 >= 5 then 1 else 0 → 1 (a new relational op as an if condition).
  (match run([ifkw(), n(5), ge(), n(5), thenkw(), n(1), elsekw(), n(0)]) with | Option.Some(v) => (if v == 1 then unit else trap("5>=5 → then=1")) | Option.None(_) => trap("runs"))

@test
def ev-div() =
  // 8 / 2 → 4.
  (match run([n(8), divop(), n(2)]) with | Option.Some(v) => (if v == 4 then unit else trap("8/2=4")) | Option.None(_) => trap("div runs"))

@test
def ev-div-by-zero-is-none() =
  // 5 / 0 → None (trap-free: divide-by-zero yields absence, not a crash).
  (match run([n(5), divop(), n(0)]) with | Option.None(_) => unit | Option.Some(_) => trap("5/0 must be None"))

@test
def ev-mod() =
  // 7 % 3 → 1.
  (match run([n(7), modop(), n(3)]) with | Option.Some(v) => (if v == 1 then unit else trap("7%3=1")) | Option.None(_) => trap("mod runs"))

@test
def ev-mod-by-zero-is-none() =
  // 7 % 0 → None.
  (match run([n(7), modop(), n(0)]) with | Option.None(_) => unit | Option.Some(_) => trap("7%0 must be None"))

@test
def ev-mod-by-neg-one-is-zero() =
  // x % -1 = 0 for ALL x (the divisor -1 divides everything evenly). The load-bearing case is Int64.min % -1:
  // mathematically 0 (no overflow), but the HOST `%` FAULTS on it (the same INT_MIN/-1 hardware trap as
  // division) — so eval-bin special-cases b == -1 to 0, matching rcdzc (lower.rs: "MIN % -1 is 0 … Rust's %
  // panics there — special-case it to 0"). Was wrongly declining (host trap). Test via eval-bin directly:
  // Int64.min % -1 and a plain 7 % -1 both = 0.
  (match eval-bin(37, (0 - 9223372036854775807) - 1, 0 - 1) with
    | Option.Some(v) => (if v == 0 then (match eval-bin(37, 7, 0 - 1) with | Option.Some(w) => (if w == 0 then unit else trap("7 % -1 = 0")) | Option.None(_) => trap("7 % -1 runs")) else trap("Int64.min % -1 = 0"))
    | Option.None(_) => trap("Int64.min % -1 must be 0 (special-cased), not a decline"))

@test
def ev-div-precedence() =
  // 1 + 8 / 2 → 5 (division tighter than addition).
  (match run([n(1), plus(), n(8), divop(), n(2)]) with | Option.Some(v) => (if v == 5 then unit else trap("1+8/2=5")) | Option.None(_) => trap("runs"))

// ---- user-functions slice-2: a NULLARY CALL evaluates END-TO-END (infer→lower→eval) ----
// infer-db/lower-db pin the nullary-call type + lowering; this pins it EVALUATES to the right value through
// the whole eval-tree pipeline (the slice-2 payoff). NApp has no producing Tok — build the arena directly.

@test
def ev-nullary-call-evaluates-to-body() =
  // a nullary call NApp(calleeName, -1) over a body `NLit(42)` runs through eval-tree (lower resolves name→body
  // via def-body-of, inlines the body → CNum 42 → eval) to 42. End-to-end proof of slice-2's β-reduction-over-
  // zero-args. Body registered under name 900 via record-def.
  (match add-node(empty-tree(), Node.NLit(42)) with | (bodyId, t1) =>
    (let t1d = record-def(t1, 900, bodyId) in
     (match add-node(t1d, Node.NApp(900, 0 - 1)) with | (root, tree) =>
      (match eval-tree(tree, root) with
        | Option.Some(v) => (if v == 42 then unit else trap("nullary call evaluates to its body value (42)"))
        | Option.None(_) => trap("a nullary call runs end-to-end")))))

@test
def ev-nullary-call-over-arith-body() =
  // the body can be COMPOUND: a nullary call over `(+ 40 2)` (NBin) evaluates to 42 — lower inlines the whole
  // body Core, eval runs it. Pins that the inlined body is evaluated (not just a literal passthrough). Body
  // registered under name 900.
  (match add-node(empty-tree(), Node.NLit(40)) with | (aId, t1) =>
    (match add-node(t1, Node.NLit(2)) with | (bId, t2) =>
      (match add-node(t2, Node.NBin(43, aId, bId)) with | (bodyId, t3) =>
        (let t3d = record-def(t3, 900, bodyId) in
         (match add-node(t3d, Node.NApp(900, 0 - 1)) with | (root, tree) =>
          (match eval-tree(tree, root) with
            | Option.Some(v) => (if v == 42 then unit else trap("nullary call over (+ 40 2) = 42"))
            | Option.None(_) => trap("a nullary call over an arith body runs")))))))

@test
def ev-nullary-call-nested-in-arith() =
  // a nullary call as a SUB-EXPRESSION (not the root): `(+ (mk) 1)` where mk's body = 41 → 42. Pins that
  // NApp composes inside a CBin — the inlined body Core sits as a CBin operand and evaluates. (slice-2 pinned
  // NApp-as-root; this pins NApp-nested, the shape a real program uses: a call feeding an operator.)
  (match add-node(empty-tree(), Node.NLit(41)) with | (mkBody, t1) =>
    (let t1d = record-def(t1, 900, mkBody) in                        // register mk (name 900) → body 41
     (match add-node(t1d, Node.NApp(900, 0 - 1)) with | (callId, t2) =>
      (match add-node(t2, Node.NLit(1)) with | (oneId, t3) =>
        (match add-node(t3, Node.NBin(43, callId, oneId)) with | (root, tree) =>
          (match eval-tree(tree, root) with
            | Option.Some(v) => (if v == 42 then unit else trap("(+ (mk) 1) = 42 (call nested in arith)"))
            | Option.None(_) => trap("a nullary call nested in arith evals")))))))

@test
def ev-nullary-call-chain-inlines-transitively() =
  // a CHAIN of nullary calls: `g`'s body IS a call to `f` (f body = 42), and the root calls `g`. So the root
  // NApp inlines g's body — which is ITSELF an NApp — which in turn inlines f's body 42. Pins that lowering
  // inlines a callee body TRANSITIVELY (NApp over NApp), the shape `(def (f) 42) (def (g) (f)) (g)` produces.
  (match add-node(empty-tree(), Node.NLit(42)) with | (fBody, t1) =>
    (let t1d = record-def(t1, 900, fBody) in                         // f (name 900) → body 42
     (match add-node(t1d, Node.NApp(900, 0 - 1)) with | (gBody, t2) => // g's body: a call to f
      (let t2d = record-def(t2, 901, gBody) in                       // g (name 901) → body `(f)`
       (match add-node(t2d, Node.NApp(901, 0 - 1)) with | (root, tree) => // root: `(g)`
        (match eval-tree(tree, root) with
          | Option.Some(v) => (if v == 42 then unit else trap("(g) where g=(f), f=42 → 42 (transitive inline)"))
          | Option.None(_) => trap("a chain of nullary calls inlines transitively")))))))

@test
def ev-napp-with-arg-but-no-param-declines() =
  // a call WITH an arg but NO recorded param (an OVER-APPLIED nullary def `(mk 5)`) declines: lower's NApp arm
  // finds param-of(calleeId) = None → no Core → eval None. This is DISTINCT from a genuine param call (which
  // records a param — see ev-param-call-clet below). slice-3c is LANDED; the decline here is correct because
  // no param was recorded, NOT because param-calls are unimplemented. (No record-param on this tree.)
  (match add-node(empty-tree(), Node.NLit(7)) with | (bodyId, t1) =>
    (match add-node(t1, Node.NLit(5)) with | (argId, t2) =>
      (match add-node(t2, Node.NApp(bodyId, argId)) with | (root, tree) =>
        (match eval-tree(tree, root) with
          | Option.None(_) => unit
          | Option.Some(_) => trap("a call WITH an arg but NO recorded param declines (over-applied nullary)")))))

@test
def ev-param-call-clet() =
  // slice-3c at the eval-core UNIT level: a SINGLE-PARAM call `f(41)` where `f(n) = n + 1` → 42. Hand-arena:
  // param NVar node `n`, body `NBin(+, n, 1)`, register f (name 900) → its body (record-def) AND its param
  // (record-param, keyed by name), then NApp(900, argId) with argId a real arg node. eval-tree resolves name→
  // body/param, lowers to CLet(paramNode, argCore, bodyCore) → binds 41 to the param, evals the body → 42. The
  // direct-Core complement to sread-eval's se-single-param-call (full source pipeline); exercises CLet without
  // the reader.
  (match add-node(empty-tree(), Node.NVar(7)) with | (paramId, t1) =>
    (match add-node(t1, Node.NLit(1)) with | (oneId, t2) =>
      (match add-node(t2, Node.NBin(43, paramId, oneId)) with | (bodyId, t3) =>
        (match add-node(t3, Node.NLit(41)) with | (argId, t4) =>
          (match add-node(t4, Node.NApp(900, argId)) with | (root, t5) =>
            (let tree = record-param(record-def(t5, 900, bodyId), 900, paramId) in
             (match eval-tree(tree, root) with
               | Option.Some(v) => (if v == 42 then unit else trap("f(41) where f(n)=n+1 → 42"))
               | Option.None(_) => trap("a single-param call lowers to CLet + evals"))))))))

@test
def ev-nested-clet-two-params() =
  // multi-param eval SHAPE pre-validation (slice-3d): the NESTED CLet a 2-arg call `(add a b)` = `(+ a b)`
  // will lower to — CLet(p1, arg1, CLet(p2, arg2, CBin(+, CVar p1, CVar p2))). Binds arg1→p1, arg2→p2, evals
  // the body → 40+2 = 42. Direct-Core (no reader): pins that eval-core handles the two-binder nesting the
  // multi-param wiring emits, BEFORE that wiring lands — so the eval semantics are proven independently.
  (match eval-core(
     Core.CLet(100, Core.CNum(40, true, 64),
       Core.CLet(101, Core.CNum(2, true, 64),
         Core.CBin(43, true, 64, Core.CVar(100), Core.CVar(101)))),
     (Map.empty : Map(Int64, Int64))) with
    | Option.Some(v) => (if v == 42 then unit else trap("nested CLet (two params) → 40+2 = 42"))
    | Option.None(_) => trap("a two-param nested CLet evaluates"))

export { eval-core, eval-bin, eval-tree, run, milestone-tokens, run-milestone }
