def ev-unary-minus-of-let-var() =
  // let x = 4 in -x  →  -4.
  match run([letkw(), var(1), eq(), n(4), inkw(), neg(), var(1)]) with
    | Option.Some(v) => if v == 0 - 4 then unit else trap("-x where x=4 is -4")
    | Option.None(_) => trap("runs")

@test
def ev-double-negation() =
  // - -5  →  5 (0 - (0 - 5)).
  match run([neg(), neg(), n(5)]) with
    | Option.Some(v) => if v == 5 then unit else trap("- -5 = 5")
    | Option.None(_) => trap("runs")

@test
def ev-gt() =
  // 3 > 2 → 1 ; 2 > 3 → 0.
  match run([n(3), gt(), n(2)]) with
    | Option.Some(v) => if v == 1 then
      match run([n(2), gt(), n(3)]) with
        | Option.Some(w) => if w == 0 then unit else trap("2>3=0")
        | Option.None(_) => trap("runs")
    else
      trap("3>2=1")
    | Option.None(_) => trap("runs")

@test
def ev-le() =
  // 2 <= 2 → 1 ; 3 <= 2 → 0.
  match run([n(2), le(), n(2)]) with
    | Option.Some(v) => if v == 1 then
      match run([n(3), le(), n(2)]) with
        | Option.Some(w) => if w == 0 then unit else trap("3<=2=0")
        | Option.None(_) => trap("runs")
    else
      trap("2<=2=1")
    | Option.None(_) => trap("runs")

