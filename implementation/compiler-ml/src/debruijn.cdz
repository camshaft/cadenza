/// debruijn.cdz — NAMELESS (de Bruijn) conversion over the canonical homoiconic `Ast` (imported
/// cross-file from `ast`): rewrite a named lambda term so each BOUND variable is replaced by its de
/// Bruijn INDEX — the number of binders between the use and its binder — and each binder loses its
/// parameter name. This is the classic front-end transform that makes alpha-equivalence syntactic
/// (two alpha-equal terms convert to IDENTICAL nameless terms) and underlies capture-free substitution.
///
/// It recognizes the binder form `(fn (p) <body>)`: a `Name x` bound at depth `d` becomes `Int(depth - d
/// - 1)` (0 = the nearest enclosing binder), and `(fn (x) …)` converts to `(fn () …)` — the param name
/// dropped. A FREE `Name` (not in the environment) is left as a `Name` verbatim. Every other `List` is a
/// generic form whose children are converted element-wise.
///
/// The conversion threads a `Map String Int64` mapping each bound name to the DEPTH at which it was bound,
/// plus the current `depth`, through the mutual `conv` ↔ `conv-list` recursion — the two-scrutinee /
/// Map-threaded / child-list-consuming-across-the-mutual-edge shape the still-live-binding fixes
/// unblocked. Pairs with `alpha.cdz` (equivalence up to renaming) and `scopecheck.cdz` (free-var counting).

import { Ast } from "ast"

/// The `Name` at position `i` of `elems`, or None (a borrowing indexed read).
def name-at(elems: List(Ast), i: Int64) = match List.at(elems, i) with
  | Option.Some(Ast.Name(n)) => Some(n)
  | _ => None(unit)

/// The child `Ast` at position `i`, or a Unit-Int sentinel.
def child-at(elems: List(Ast), i: Int64) = match List.at(elems, i) with
  | Option.Some(c) => c
  | Option.None(_) => Ast.Int(0)

/// The child at `i` interpreted as a list of `Ast` (a `fn`'s param clause), or empty.
def child-at-list(elems: List(Ast), i: Int64) = match child-at(elems, i) with
  | Ast.List(ps) => ps
  | _ => []

/// Prepend `x` to `xs` (the prelude has no `cons`; `List.concat` of a singleton is the idiom).
def cons(x: Ast, xs: List(Ast)) = List.concat([x], xs)

/// Convert `node` to nameless form. `env` maps each in-scope bound name to the depth at which it was
/// bound; `depth` is the number of binders currently enclosing `node`.
def conv(env: Map(String, Int64), depth: Int64, node: Ast) = match node with
  | Ast.Int(n) => Ast.Int(n)
  | Ast.Str(s) => Ast.Str(s)
  | Ast.Bool(b) => Ast.Bool(b)
  | Ast.Name(x) => (match Map.lookup(env, x) with
    | Option.Some(d) => Ast.Int(depth - d - 1)   // bound: de Bruijn index (0 = nearest binder)
    | Option.None(_) => Ast.Name(x))             // free: left as a name
  | Ast.List(elems) => (match name-at(elems, 0) with
    | Some(h) => (if h == "fn" then conv-fn(env, depth, elems) else Ast.List(conv-list(env, depth, elems)))
    | None(_) => Ast.List(conv-list(env, depth, elems)))

/// `(fn (x) <body>)` → `(fn () <body'>)`: bind `x` at the current depth, convert the body one level
/// deeper, and drop the parameter name (the empty param list marks a nameless binder).
def conv-fn(env: Map(String, Int64), depth: Int64, elems: List(Ast)) =
  match name-at(child-at-list(elems, 1), 0) with
    | Some(p) =>
      let body2 = conv(Map.insert(env, p, depth), depth + 1, child-at(elems, 2)) in
      Ast.List([Ast.Name("fn"), Ast.List([]), body2])
    | None(_) => Ast.List(conv-list(env, depth, elems))

/// Convert each element of a child list (the mutual partner of `conv`), preserving order.
def conv-list(env: Map(String, Int64), depth: Int64, elems: List(Ast)) = match elems with
  | [] => []
  | [h, .. r] => cons(conv(env, depth, h), conv-list(env, depth, r))

/// Convert a whole term under the empty environment.
def to-nameless(node: Ast) = conv(#{}, 0, node)

/// Builders for readable tests.
def nm(s: String) = Ast.Name(s)
def lst(xs: List(Ast)) = Ast.List(xs)
def fn1(p: String, body: Ast) = lst([nm("fn"), lst([nm(p)]), body])
def app(f: Ast, x: Ast) = lst([nm("app"), f, x])

/// The `Ast` at path `is` (a list of child indices) under `node`, or a sentinel if the path leaves the tree.
def at-path(node: Ast, is: List(Int64), k: Int64) =
  if k == List.len(is) then
    node
  else
    (match node with
      | Ast.List(e) => (match List.at(is, k) with
        | Option.Some(i) => at-path(child-at(e, i), is, k + 1)
        | Option.None(_) => Ast.Int(0 - 1))
      | _ => Ast.Int(0 - 1))

/// The Int at `path`, or a distinctive sentinel if it is not an Int there.
def int-at(node: Ast, path: List(Int64)) = match at-path(node, path, 0) with
  | Ast.Int(i) => i
  | _ => 0 - 99

@test
def db-identity-index() =
  // (fn (x) x) → (fn () 0): the bound x becomes index 0 (body at path [2]).
  if int-at(to-nameless(fn1("x", nm("x"))), [2]) == 0 then unit else trap("(fn x x) body is index 0")

@test
def db-outer-binder-index() =
  // (fn (x) (fn (y) x)) → (fn () (fn () 1)): x is one binder out from its use → index 1 (path [2,2]).
  if int-at(to-nameless(fn1("x", fn1("y", nm("x")))), [2, 2]) == 1 then unit else trap("outer x is index 1")

@test
def db-inner-binder-index() =
  // (fn (x) (fn (y) y)) → (fn () (fn () 0)): y is the nearest binder → index 0 (path [2,2]).
  if int-at(to-nameless(fn1("x", fn1("y", nm("y")))), [2, 2]) == 0 then unit else trap("inner y is index 0")

@test
def db-free-var-stays-a-name() =
  // (fn (x) z) → (fn () z): the free z is not in scope, so it stays a Name (not an Int).
  match at-path(to-nameless(fn1("x", nm("z"))), [2], 0) with
    | Ast.Name(n) => (if n == "z" then unit else trap("free var keeps its name"))
    | _ => trap("a free var must stay a Name, not become an index")

@test
def db-drops-param-name() =
  // (fn (x) x) → (fn () 0): the param clause (path [1]) is now the EMPTY list (nameless binder).
  match at-path(to-nameless(fn1("x", nm("x"))), [1], 0) with
    | Ast.List(ps) => (if List.len(ps) == 0 then unit else trap("binder param list is emptied"))
    | _ => trap("param clause is a list")

@test
def db-application-body() =
  // (fn (x) (app x x)) → (fn () (app 0 0)): both uses of x are index 0 (paths [2,1] and [2,2]).
  let c = to-nameless(fn1("x", app(nm("x"), nm("x")))) in
  if int-at(c, [2, 1]) == 0 then (if int-at(c, [2, 2]) == 0 then unit else trap("2nd x index 0")) else trap("1st x index 0")

@test
def db-mixed-free-and-bound() =
  // (fn (x) (app x z)) → (fn () (app 0 z)): x bound → index 0 (path [2,1]); z free → stays Name.
  let c = to-nameless(fn1("x", app(nm("x"), nm("z")))) in
  if int-at(c, [2, 1]) == 0 then
    (match at-path(c, [2, 2], 0) with | Ast.Name(n) => (if n == "z" then unit else trap("z")) | _ => trap("z stays a name"))
  else
    trap("bound x is index 0")

@test
def db-alpha-equal-terms-convert-identically() =
  // (fn (x) x) and (fn (y) y) are alpha-equal, so their nameless forms are the SAME index-0 body.
  let a = to-nameless(fn1("x", nm("x"))) in
  let b = to-nameless(fn1("y", nm("y"))) in
  if int-at(a, [2]) == int-at(b, [2]) then unit else trap("alpha-equal terms convert to the same index")

@test
def db-leaf-unchanged() =
  // A bare literal is unchanged.
  match to-nameless(Ast.Int(7)) with | Ast.Int(n) => (if n == 7 then unit else trap("7")) | _ => trap("Int stays Int")

@test
def db-generic-form-recurses() =
  // (app (fn (x) x) w) → (app (fn () 0) w): the binder inside a generic app still converts (path [1,2]),
  // and the free w stays a name (path [2]).
  let c = to-nameless(app(fn1("x", nm("x")), nm("w"))) in
  if int-at(c, [1, 2]) == 0 then
    (match at-path(c, [2], 0) with | Ast.Name(n) => (if n == "w" then unit else trap("w")) | _ => trap("w stays a name"))
  else
    trap("nested binder inside app converts")

export { to-nameless }
