/// conformance-db-rel.cdz — the RELATIONAL/COMPARISON/IF half of the conformance scoreboard, split from
/// conformance-db.cdz (throughput slice, same pattern as conformance-db-cx). conformance-db.cdz holds the engine
/// (Expect/Case/case-passes/check-case/count-passing/corpus/conformance) + the case-BUILDERS; THIS file holds the
/// 25 relational/comparison/if/unary-minus `conformance-*` @tests (lt/eq/gt/le/ge/ne, if-then/else/nested/with-let,
/// bool-in-arith/rel declines, unary-minus). The case-builders (c-lt-true, c-if-then, …) STAY in conformance-db
/// (corpus() references them) + are imported here; each @test is just check-case(c-X()). Behavior IDENTICAL —
/// same cases, same expectations, redistributed across files. corpus()/conformance() (the aggregate) UNCHANGED in
/// conformance-db and still cover ALL cases incl. these. Shrinks conformance-db (the heaviest file) further below
/// the per-file gate cap (the xtask throughput-drag in-lane fix); the gate runs files concurrently.
import { check-case, c-bool-in-arith-declines, c-bool-rel-declines, c-cmp-of-arith, c-double-negation, c-eq-false, c-eq-true, c-ge, c-gt, c-if-branch-mismatch-declines, c-if-else, c-if-false-literal, c-if-nested-else, c-if-nonbool-cond-declines, c-if-then, c-if-true-literal, c-if-with-let, c-le, c-let-bool, c-let-bool-literal, c-lt-false, c-lt-true, c-ne, c-rel-in-if, c-unary-minus, c-unary-minus-in-arith } from "conformance-db"

@test
def conformance-lt-true() = if check-case(c-lt-true()) then unit else trap("1 < 2 → 1")

@test
def conformance-lt-false() = if check-case(c-lt-false()) then unit else trap("5 < 2 → 0")

@test
def conformance-eq-true() = if check-case(c-eq-true()) then unit else trap("3 == 3 → 1")

@test
def conformance-eq-false() = if check-case(c-eq-false()) then unit else trap("3 == 4 → 0")

@test
def conformance-cmp-of-arith() =
  if check-case(c-cmp-of-arith()) then unit else trap("1 + 2 < 4 → 1")

@test
def conformance-let-bool() =
  if check-case(c-let-bool()) then unit else trap("let b = 2 < 3 in b → 1")

@test
def conformance-if-then() =
  if check-case(c-if-then()) then unit else trap("if 1<2 then 10 else 20 → 10")

@test
def conformance-if-else() =
  if check-case(c-if-else()) then unit else trap("if 5<2 then 10 else 20 → 20")

@test
def conformance-if-with-let() =
  if check-case(c-if-with-let()) then unit else trap("let x=3 in if x==3 then x*2 else 0 → 6")

@test
def conformance-if-nested-else() =
  if check-case(c-if-nested-else()) then unit else trap("else-if chain → 200")

@test
def conformance-if-nonbool-cond-declines() =
  if check-case(c-if-nonbool-cond-declines()) then unit else trap("non-Bool cond declines")

@test
def conformance-if-branch-mismatch-declines() =
  if check-case(c-if-branch-mismatch-declines()) then
    unit
  else
    trap("branch type mismatch declines")

@test
def conformance-if-true-literal() =
  if check-case(c-if-true-literal()) then unit else trap("if true then 42 else 0 → 42")

@test
def conformance-if-false-literal() =
  if check-case(c-if-false-literal()) then unit else trap("if false then 42 else 7 → 7")

@test
def conformance-let-bool-literal() =
  if check-case(c-let-bool-literal()) then unit else trap("let b = true in if b then 5 else 6 → 5")

@test
def conformance-bool-in-arith-declines() =
  if check-case(c-bool-in-arith-declines()) then unit else trap("true + 1 declines")

@test
def conformance-unary-minus() = if check-case(c-unary-minus()) then unit else trap("-5 → -5")

@test
def conformance-unary-minus-in-arith() =
  if check-case(c-unary-minus-in-arith()) then unit else trap("10 + -3 → 7")

@test
def conformance-double-negation() =
  if check-case(c-double-negation()) then unit else trap("- -5 → 5")

@test
def conformance-gt() = if check-case(c-gt()) then unit else trap("3 > 2 → 1")

@test
def conformance-le() = if check-case(c-le()) then unit else trap("2 <= 2 → 1")

@test
def conformance-ge() = if check-case(c-ge()) then unit else trap("2 >= 3 → 0")

@test
def conformance-ne() = if check-case(c-ne()) then unit else trap("3 != 4 → 1")

@test
def conformance-rel-in-if() =
  if check-case(c-rel-in-if()) then unit else trap("if 5 >= 5 then 1 else 0 → 1")

@test
def conformance-bool-rel-declines() =
  if check-case(c-bool-rel-declines()) then unit else trap("true > 2 declines")

