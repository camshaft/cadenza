/// ssa-phi.cdz — SSA φ-FUNCTION PLACEMENT, the construction step that turns a CFG into SSA form. A
/// variable assigned in multiple blocks needs a φ-node wherever its definitions MERGE — and the precise
/// merge set is the ITERATED DOMINANCE FRONTIER of its definition blocks (Cytron et al.): `φ-blocks(v) =
/// DF+(def-blocks(v))`. This module computes that placement, the decision a real SSA builder makes before
/// renaming.
///
/// A block here is `Blk(id, terminator, defs)` — its control-flow successors plus the set of variables it
/// ASSIGNS. For a variable `v`, `def-blocks v` is every block whose `defs` contains `v`; `phi-blocks v` is
/// `DF+` of those (the blocks that get a `φ v = …`). A variable defined in only ONE block (or in a single
/// straight-line region) needs no φ; one defined on multiple converging paths needs φ at each merge.
///
/// Dominance / dominance frontier are re-derived as in dominators.cdz / domfront.cdz (`reach-avoiding`),
/// so this module gates standalone.
///
///   - `def-blocks v`      — the block ids that assign `v`.
///   - `phi-blocks v`      — the set of blocks needing a `φ v` (= DF+ of the def-blocks).
///   - `needs-phi v b`     — does block `b` get a `φ v`?
///   - `phi-count`         — total φ-nodes across all variables in the graph.

type Term =
  | Return
  | Jump(Int64)
  | CondJump(Int64, Int64)

type Block =
  | Blk(Int64, Term, List(Int64))     // id, terminator, variables this block assigns

def term-of(b: Block) = match b with | Block.Blk(_, t, _) => t
def id-of(b: Block) = match b with | Block.Blk(i, _, _) => i
def defs-of(b: Block) = match b with | Block.Blk(_, _, d) => d

def succs(t: Term) = match t with
  | Term.Return => []
  | Term.Jump(a) => [a]
  | Term.CondJump(a, b) => [a, b]

def find-term(bs: List(Block), id: Int64) = match bs with
  | [] => Option.None(unit)
  | [b, .. r] => if id-of(b) == id then Option.Some(term-of(b)) else find-term(r, id)

def list-has(xs: List(Int64), y: Int64) = match xs with
  | [] => false
  | [h, .. t] => if h == y then true else list-has(t, y)

def reach-avoiding(bs: List(Block), avoid: Int64, work: List(Int64), seen: Set(Int64)) = match work with
  | [] => seen
  | [id, .. rest] =>
    if id == avoid then reach-avoiding(bs, avoid, rest, seen)
    else (if Set.contains(seen, id) then reach-avoiding(bs, avoid, rest, seen)
      else (match find-term(bs, id) with
        | Option.None(_) => reach-avoiding(bs, avoid, rest, Set.insert(seen, id))
        | Option.Some(t) => reach-avoiding(bs, avoid, List.concat(succs(t), rest), Set.insert(seen, id))))

def reachable(bs: List(Block), entry: Int64) = reach-avoiding(bs, 0 - 1, [entry], Set.of([]))

def dominates(bs: List(Block), entry: Int64, d: Int64, n: Int64) =
  if d == n then true
  else (if Set.contains(reachable(bs, entry), n) == false then false
    else Set.contains(reach-avoiding(bs, d, [entry], Set.of([])), n) == false)

def strictly-dom(bs: List(Block), entry: Int64, d: Int64, n: Int64) =
  ((d == n) == false) and dominates(bs, entry, d, n)

def preds-of(rest: List(Block), b: Int64, acc: List(Int64)) = match rest with
  | [] => acc
  | [x, .. more] => preds-of(more, b, (if list-has(succs(term-of(x)), b) then List.concat([id-of(x)], acc) else acc))

def dominates-any(bs: List(Block), entry: Int64, n: Int64, ps: List(Int64)) = match ps with
  | [] => false
  | [p, .. rest] => if dominates(bs, entry, n, p) then true else dominates-any(bs, entry, n, rest)

def in-df(bs: List(Block), entry: Int64, n: Int64, b: Int64) =
  dominates-any(bs, entry, n, preds-of(bs, b, [])) and (strictly-dom(bs, entry, n, b) == false)

def dom-frontier(bs: List(Block), entry: Int64, n: Int64) = df-scan(bs, bs, entry, n, Set.of([]))

def df-scan(all: List(Block), rest: List(Block), entry: Int64, n: Int64, acc: Set(Int64)) = match rest with
  | [] => acc
  | [b, .. more] => df-scan(all, more, entry, n, (if in-df(all, entry, n, id-of(b)) then Set.insert(acc, id-of(b)) else acc))

def fresh-of(ids: List(Int64), acc: Set(Int64)) = match ids with
  | [] => []
  | [h, .. t] => if Set.contains(acc, h) then fresh-of(t, acc) else List.concat([h], fresh-of(t, acc))

def union-list(ids: List(Int64), acc: Set(Int64)) = match ids with
  | [] => acc
  | [h, .. t] => union-list(t, Set.insert(acc, h))

/// The iterated dominance frontier of `defs` — the φ-placement set.
def iterated-df(bs: List(Block), entry: Int64, defs: List(Int64)) = idf(bs, entry, defs, Set.of([]), List.len(bs))

def idf(bs: List(Block), entry: Int64, work: List(Int64), acc: Set(Int64), fuel: Int64) = match work with
  | [] => acc
  | [n, .. rest] =>
    let nids = Set.to-list(dom-frontier(bs, entry, n)) in
    let acc2 = union-list(nids, acc) in
    (if fuel <= 0 then acc2 else idf(bs, entry, List.concat(fresh-of(nids, acc), rest), acc2, fuel - 1))

/// The block ids that ASSIGN variable `v`.
def def-blocks(bs: List(Block), v: Int64) = db-scan(bs, v, [])

def db-scan(rest: List(Block), v: Int64, acc: List(Int64)) = match rest with
  | [] => acc
  | [b, .. more] => db-scan(more, v, (if list-has(defs-of(b), v) then List.concat([id-of(b)], acc) else acc))

/// The set of blocks needing a `φ v` — the iterated dominance frontier of `v`'s def-blocks.
def phi-blocks(bs: List(Block), entry: Int64, v: Int64) = iterated-df(bs, entry, def-blocks(bs, v))

/// Does block `b` need a `φ v`?
def needs-phi(bs: List(Block), entry: Int64, v: Int64, b: Int64) = Set.contains(phi-blocks(bs, entry, v), b)

/// Total φ-nodes across `vars` (one φ per (variable, φ-block) pair).
def phi-count(bs: List(Block), entry: Int64, vars: List(Int64)) = pc(bs, entry, vars, 0)

def pc(bs: List(Block), entry: Int64, vars: List(Int64), acc: Int64) = match vars with
  | [] => acc
  | [v, .. rest] => pc(bs, entry, rest, acc + Set.len(phi-blocks(bs, entry, v)))

/// Builders.
def blk(id: Int64, t: Term, defs: List(Int64)) = Block.Blk(id, t, defs)

@test
def phi-diamond-both-arms() =
  // var 100 assigned in both arms (1, 2) of a diamond → φ at the merge 3. one φ-block.
  let bs = [blk(0, Term.CondJump(1, 2), []), blk(1, Term.Jump(3), [100]), blk(2, Term.Jump(3), [100]), blk(3, Term.Return, [])] in
  if Set.len(phi-blocks(bs, 0, 100)) == 1 then (if needs-phi(bs, 0, 100, 3) then unit else trap("φ at merge 3")) else trap("one φ-block")

@test
def phi-single-arm-def-still-merges() =
  // var 100 assigned in ONE arm (block 1) of a diamond. It STILL needs a φ at the merge 3 — standard SSA:
  // block 3 has predecessors {1, 2}, and 100 is defined on the 1-path but not the 2-path, so 3 must
  // reconcile them with `φ 100 = [1: 100₁, 2: undef]`. DF+({1}) = {3}. This is why single-arm defs are
  // NOT special-cased. (A single def in a block that DOMINATES all its uses — see phi-linear-no-merge —
  // is the case that needs no φ.)
  let bs = [blk(0, Term.CondJump(1, 2), []), blk(1, Term.Jump(3), [100]), blk(2, Term.Jump(3), []), blk(3, Term.Return, [])] in
  if Set.len(phi-blocks(bs, 0, 100)) == 1 then (if needs-phi(bs, 0, 100, 3) then unit else trap("φ at merge 3")) else trap("one φ-block")

@test
def phi-entry-def-plus-one-arm() =
  // var 100 defined at entry 0 AND arm 1; DF+({0,1}) — DF(0)={}, DF(1)={3} → φ at 3.
  let bs = [blk(0, Term.CondJump(1, 2), [100]), blk(1, Term.Jump(3), [100]), blk(2, Term.Jump(3), []), blk(3, Term.Return, [])] in
  if needs-phi(bs, 0, 100, 3) then (if Set.len(phi-blocks(bs, 0, 100)) == 1 then unit else trap("one φ-block")) else trap("φ at 3")

@test
def phi-def-blocks-found() =
  // def-blocks(100) = {1, 2}; def-blocks(200) = {} (never assigned).
  let bs = [blk(0, Term.CondJump(1, 2), []), blk(1, Term.Jump(3), [100]), blk(2, Term.Jump(3), [100]), blk(3, Term.Return, [])] in
  if List.len(def-blocks(bs, 100)) == 2 then (if List.len(def-blocks(bs, 200)) == 0 then unit else trap("200 unassigned")) else trap("100 in {1,2}")

@test
def phi-linear-no-merge() =
  // straight line: var 100 defined in 0 and 1 (sequential, no merge) → no φ (1 dominates 2, no frontier).
  let bs = [blk(0, Term.Jump(1), [100]), blk(1, Term.Jump(2), [100]), blk(2, Term.Return, [])] in
  if Set.len(phi-blocks(bs, 0, 100)) == 0 then unit else trap("sequential defs need no φ")

@test
def phi-loop-header() =
  // loop 0→1; 1→cond(1,2); 2→ret. var 100 defined in the header 1 (which has a self back edge). def-blocks
  // {1}; DF(1) contains 1 (self-frontier) → φ v at the header. This is the loop-carried φ.
  let bs = [blk(0, Term.Jump(1), []), blk(1, Term.CondJump(1, 2), [100]), blk(2, Term.Return, [])] in
  if needs-phi(bs, 0, 100, 1) then unit else trap("a loop-defined var gets a φ at the header")

@test
def phi-two-vars-count() =
  // var 100 in both arms (φ at 3); var 200 only in arm 1 — but DF+({1}) = {3}, so 200 ALSO gets a φ at 3
  // (the 2-path leaves 200 undefined). Each variable contributes one φ at 3 → total φ-count = 2.
  let bs = [blk(0, Term.CondJump(1, 2), []), blk(1, Term.Jump(3), [100, 200]), blk(2, Term.Jump(3), [100]), blk(3, Term.Return, [])] in
  if phi-count(bs, 0, [100, 200]) == 2 then unit else trap("both vars need a φ at 3 → 2 φ total")

@test
def phi-var-fully-dominating-def-no-phi() =
  // var 300 defined ONLY at the entry 0, which dominates every block → no merge introduces an alternate
  // def → DF+({0}) = {} → NO φ. (This is the genuine "single def, no φ" case: the def dominates all uses.)
  let bs = [blk(0, Term.CondJump(1, 2), [300]), blk(1, Term.Jump(3), []), blk(2, Term.Jump(3), []), blk(3, Term.Return, [])] in
  if Set.len(phi-blocks(bs, 0, 300)) == 0 then unit else trap("an entry-dominating def needs no φ")

@test
def phi-both-vars-merge() =
  // both vars assigned in both arms → each gets a φ at the merge → φ-count 2.
  let bs = [blk(0, Term.CondJump(1, 2), []), blk(1, Term.Jump(3), [100, 200]), blk(2, Term.Jump(3), [100, 200]), blk(3, Term.Return, [])] in
  if phi-count(bs, 0, [100, 200]) == 2 then unit else trap("both vars merge → 2 φ")

@test
def phi-nested-diamond-single-merge() =
  // stacked diamonds; var 100 in the first two arms {1,2} only → φ at the first merge 3, and since 3
  // strictly dominates the second merge 6, NO extra φ there. one φ-block.
  let bs = [blk(0, Term.CondJump(1, 2), []), blk(1, Term.Jump(3), [100]), blk(2, Term.Jump(3), [100]),
            blk(3, Term.CondJump(4, 5), []), blk(4, Term.Jump(6), []), blk(5, Term.Jump(6), []), blk(6, Term.Return, [])] in
  if Set.len(phi-blocks(bs, 0, 100)) == 1 then (if needs-phi(bs, 0, 100, 3) then unit else trap("φ at 3")) else trap("one φ-block, not the dominated 6")

export { def-blocks, phi-blocks, needs-phi, phi-count, iterated-df }
