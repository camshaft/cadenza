/// db-eval.cdz — P1g of the rcdzc port: the RUN driver over the Db — source → value through the MEMOIZED
/// query pipeline. Caps the Db producer chain (P1d resolve → P1e infer → P1f lower): `run-of-db` demands the
/// lowered Core off the Db (which fills resolve+types+the Core once, no recompute), then evaluates it. This
/// is the whim `eval-db.run`/`eval-tree` equivalent, but every column is MEMOIZED in the Db rather than
/// recomputed per demand — the caching pipeline running end-to-end (a token program → its value).
///
/// Returns `(db', Option(Int64))`: `Some v` = ran to `v`; `None` = ill-typed (no core form) or a malformed/
/// div-by-zero Core (eval is total). The Db comes back carrying the memoized resolve+types columns, so a
/// caller can inspect the memo or run further queries off the same Db.
import { Tok, Tree, parse-tokens } from "parse-db"

import { Value, eval-core, eval-core-d, run } from "eval-db"

import { Db, db-of, db-tree } from "db"

import { lower-of-db } from "db-lower"

import { lower-def-env } from "lower-db"

/// RUN a lowered Db program from `root`: demand the Core off the Db (P1f lower-of-db — chains the memoized
/// resolve→infer→lower), then eval it under an empty env. `(db', Some v)` = ran to v; `(db', None)` =
/// ill-typed (no core) or a malformed/div-by-zero Core. The Db carries the memoized columns out.
def run-of-db(db: Db, root: Int64) = match lower-of-db(db, root) with
  // slice-B1b-p3: eval under a DEF-ENV (name → (params, bodyCore)) built from the tree's recursive defs, so
  // a CCall to a recursive callee runs via eval-core-d's def-env dispatch (was declining at eval). A
  // non-recursive program has an empty def-env and behaves exactly as the old eval-core(core, empty).
  | (db1, Option.Some(core)) =>
    (db1, eval-core-d(core, Map.empty : Map(Int64, Value), lower-def-env(db-tree(db1))))
  | (db1, Option.None(_)) => (db1, Option.None(unit))

/// The Db RUN driver from a token program: parse → Db → run over the memoized pipeline → value. The
/// eval-db.run equivalent, Db-threaded. `Some v` | `None` (ill-typed / malformed).
def run-tokens-db(ts: List(Tok)) =
  let (root, tree) = parse-tokens(ts) in
  let (_, v) = run-of-db(db-of(tree), root) in
  v

// ---- TESTS: source → value over the memoized Db pipeline --------------------------------------------
/// THE MILESTONE program `let x = 2 in x * 3 + 1` as tokens — runs to 7 (over the Db this time).
def milestone-tokens() = [
  Tok.TLet,
  Tok.TName(1),
  Tok.TEq,
  Tok.TNum(2),
  Tok.TIn,
  Tok.TName(1),
  Tok.TOp(42),
  Tok.TNum(3),
  Tok.TOp(43),
  Tok.TNum(1)
]

@test
def de-milestone-runs-to-seven() =
  // ★ the milestone through the MEMOIZED Db pipeline: source → parse → (resolve→infer→lower, each fill-once
  // in the Db) → eval → 7. The whim run recomputed resolve+infer per demand; this threads one memoized Db.
  match run-tokens-db(milestone-tokens()) with
    | Option.Some(v) => if v == 7 then unit else trap("milestone = 7")
    | Option.None(_) => trap("milestone runs over the Db")

@test
def de-literal-runs() = match run-tokens-db([Tok.TNum(42)]) with
  | Option.Some(v) => if v == 42 then unit else trap("42")
  | Option.None(_) => trap("literal runs")

@test
def de-add-runs() =
  // 1 + 2 = 3.
  match run-tokens-db([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2)]) with
    | Option.Some(v) => if v == 3 then unit else trap("1+2=3")
    | Option.None(_) => trap("add runs")

@test
def de-let-runs() =
  // let x = 5 in x - 2 = 3.
  match run-tokens-db(
      [
        Tok.TLet,
        Tok.TName(1),
        Tok.TEq,
        Tok.TNum(5),
        Tok.TIn,
        Tok.TName(1),
        Tok.TOp(45),
        Tok.TNum(2)
      ]
    ) with
    | Option.Some(v) => if v == 3 then unit else trap("5-2=3")
    | Option.None(_) => trap("let runs")

@test
def de-ill-typed-is-none() =
  // an unbound var → no core form → None (absence carried through the Db chain to the result).
  match run-tokens-db([Tok.TName(9)]) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("ill-typed does not run")

@test
def de-div-by-zero-is-none() =
  // 5 / 0 → None (total eval; the Db pipeline lowers it but eval declines the divide).
  match run-tokens-db([Tok.TNum(5), Tok.TOp(47), Tok.TNum(0)]) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("5/0 is None")

@test
def de-comparison-runs() =
  // 1 < 2 → 1 (Bool-as-0/1 over the Db).
  match run-tokens-db([Tok.TNum(1), Tok.TOp(60), Tok.TNum(2)]) with
    | Option.Some(v) => if v == 1 then unit else trap("1<2=1")
    | Option.None(_) => trap("comparison runs")

/// Do the two run paths AGREE on `ts`? — the memoized Db pipeline (`run-tokens-db`) vs the whim
/// (`eval-db.run`, resolve+infer recomputed per demand). Both return `Option(Int64)`; agreement = same
/// Some/None and same value. This is the SAFETY INVARIANT for the run-of-db-primary migration: the Db path
/// (now the source-differential primary) computes IDENTICALLY to the whim it replaces. When eval-tree/run are
/// finally nuked, this witnesses they matched first (nuke-as-you-replace, proven-equivalent).
def paths-agree(ts: List(Tok)) = match run-tokens-db(ts) with
  | Option.Some(dv) => (
    match run(ts) with
    | Option.Some(wv) => dv == wv
    | Option.None(_) => false
  )
  | Option.None(_) =>
    match run(ts) with
    | Option.None(_) => true
    | Option.Some(_) => false

@test
def de-db-and-whim-agree() =
  // the Db pipeline ≡ the whim run across a representative spread: literal, arith+precedence, let, nested
  // let, shadowing, comparison, if-both-branches, div-by-zero (both None), unbound (both None). If any pair
  // disagreed, the run-of-db-primary switch would have changed a value — this pins they don't.
  if paths-agree([Tok.TNum(42)]) then
    if paths-agree([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2), Tok.TOp(42), Tok.TNum(3)]) then
      // 1+2*3=7
      if paths-agree(milestone-tokens()) then
        // let x=2 in x*3+1
        if paths-agree(
            [
              Tok.TLet,
              Tok.TName(1),
              Tok.TEq,
              Tok.TNum(1),
              Tok.TIn,
              Tok.TLet,
              Tok.TName(1),
              Tok.TEq,
              Tok.TNum(2),
              Tok.TIn,
              Tok.TName(1)
            ]
          ) then
          // shadowing
          if paths-agree([Tok.TNum(5), Tok.TOp(60), Tok.TNum(2)]) then
            // 5<2=0
            if paths-agree(
                [
                  Tok.TIf,
                  Tok.TNum(1),
                  Tok.TOp(60),
                  Tok.TNum(2),
                  Tok.TThen,
                  Tok.TNum(10),
                  Tok.TElse,
                  Tok.TNum(20)
                ]
              ) then
              // if 1<2 then 10 else 20
              if paths-agree([Tok.TNum(5), Tok.TOp(47), Tok.TNum(0)]) then
                // 5/0 → both None
                if paths-agree([Tok.TName(9)]) then
                  unit // unbound → both None
                else
                  trap("unbound: Db≡whim")
              else
                trap("div0: Db≡whim")
            else
              trap("if: Db≡whim")
          else
            trap("cmp: Db≡whim")
        else
          trap("shadow: Db≡whim")
      else
        trap("milestone: Db≡whim")
    else
      trap("precedence: Db≡whim")
  else
    trap("literal: Db≡whim")

export { run-of-db, run-tokens-db, paths-agree }
