/// parse.cdz — a recursive-descent PRECEDENCE PARSER: a `List Token` → an arithmetic `Ast`, the front-end
/// stage after the lexer. It is the port's heaviest stress of MUTUAL RECURSION threading a CURSOR TUPLE:
/// each `parse-*` returns `(Ast, next-index)` and the three levels call one another
/// (`parse-expr → parse-term → parse-factor → parse-expr` for a parenthesized sub-expression), so a
/// `(compound-Ast, Int64)` tuple crosses every mutual-call edge — exactly the tuple-through-recursion
/// shape the log tracked (fixed iter 14; here at mutual scale). The grammar is the classic
///   expr   = term   (('+' | '-') term)*      -- left-assoc, lowest precedence
///   term   = factor (('*' | '/') factor)*    -- left-assoc, higher precedence
///   factor = NUMBER | '(' expr ')'
/// Left-associative folding is done by an accumulator: `parse-expr` parses one term then loops, each
/// iteration combining the accumulated `Ast` with the next term under the pending operator. To PROVE the
/// tree is shaped by precedence (not just that it parses), the module EVALUATES the parsed `Ast` and
/// checks `1 + 2 * 3 == 7` (not 9) and `(1 + 2) * 3 == 9` — precedence and parens both observable in the
/// result. Tokens are the small `Int64`-coded set the lexer emits (44 unused; codes match `lex.cdz`).

/// A token: an operator/paren carries its ASCII code; a number carries its value. `End` marks past-the-end
/// (returned by `tok-at` for an out-of-range index, so the parser needs no separate length check).
type Tok =
  | TNum(Int64)
  | TOp(Int64)
  | TLP
  | TRP
  | End

/// The parsed arithmetic tree (a minimal expression AST — a literal or a binary node tagging its op code).
type Expr =
  | Lit(Int64)
  | Bin(Int64, Expr, Expr)

/// The token at `i`, or `End` past the end (a total indexed read — the parser dispatches on `End`).
def tok-at(ts: List(Tok), i: Int64) = match List.at(ts, i) with
  | Option.Some(t) => t
  | Option.None(_) => Tok.End

/// A parse result: the `Expr` built and the index of the next unconsumed token. A plain tuple threaded
/// through the mutual recursion (the stress shape).
def parse-factor(ts: List(Tok), i: Int64) = match tok-at(ts, i) with
  | Tok.TNum(v) => (Expr.Lit(v), i + 1)
  | Tok.TLP =>
    // '(' expr ')' — parse the inner expr, then consume the matching ')'.
    let inner = parse-expr(ts, i + 1) in
    (inner.0, inner.1 + 1)
  | _ => (Expr.Lit(0), i + 1)

/// term = factor (('*' | '/') factor)* — fold left-associatively over `*`/`/` (codes 42, 47).
def parse-term(ts: List(Tok), i: Int64) =
  let first = parse-factor(ts, i) in
  term-loop(ts, first.0, first.1)

def term-loop(ts: List(Tok), acc: Expr, i: Int64) = match tok-at(ts, i) with
  | Tok.TOp(c) =>
    (if c == 42 or c == 47 then
      let rhs = parse-factor(ts, i + 1) in
      term-loop(ts, Expr.Bin(c, acc, rhs.0), rhs.1)
    else
      (acc, i))
  | _ => (acc, i)

/// expr = term (('+' | '-') term)* — fold left-associatively over `+`/`-` (codes 43, 45).
def parse-expr(ts: List(Tok), i: Int64) =
  let first = parse-term(ts, i) in
  expr-loop(ts, first.0, first.1)

def expr-loop(ts: List(Tok), acc: Expr, i: Int64) = match tok-at(ts, i) with
  | Tok.TOp(c) =>
    (if c == 43 or c == 45 then
      let rhs = parse-term(ts, i + 1) in
      expr-loop(ts, Expr.Bin(c, acc, rhs.0), rhs.1)
    else
      (acc, i))
  | _ => (acc, i)

/// Parse a whole token list into an `Expr` (discarding the final cursor).
def parse(ts: List(Tok)) = (parse-expr(ts, 0)).0

/// Evaluate a parsed `Expr` — proves the tree is shaped by precedence (an evaluator observes structure).
def eval-expr(e: Expr) = match e with
  | Expr.Lit(v) => v
  | Expr.Bin(op, l, r) =>
    let a = eval-expr(l) in
    let b = eval-expr(r) in
    (if op == 43 then a + b else (if op == 45 then a - b else (if op == 42 then a * b else a / b)))

/// Parse then evaluate — the end-to-end check.
def run(ts: List(Tok)) = eval-expr(parse(ts))

/// The tree's depth (structural — a second observation of the parsed shape, independent of eval).
def depth(e: Expr) = match e with
  | Expr.Lit(_) => 1
  | Expr.Bin(_, l, r) =>
    let dl = depth(l) in
    let dr = depth(r) in
    (if dl >= dr then dl + 1 else dr + 1)

@test
def parse-literal() = if run([Tok.TNum(42)]) == 42 then unit else trap("42")

@test
def parse-add() =
  // 1 + 2 = 3
  if run([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2)]) == 3 then unit else trap("1+2=3")

@test
def parse-precedence-mul-first() =
  // 1 + 2 * 3 must be 7 (mul binds tighter), NOT 9 — the whole point
  if run([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2), Tok.TOp(42), Tok.TNum(3)]) == 7 then
    unit
  else
    trap("1+2*3=7 (precedence)")

@test
def parse-precedence-mul-second() =
  // 2 * 3 + 1 = 7 (mul on the left binds first)
  if run([Tok.TNum(2), Tok.TOp(42), Tok.TNum(3), Tok.TOp(43), Tok.TNum(1)]) == 7 then
    unit
  else
    trap("2*3+1=7")

@test
def parse-parens-override() =
  // (1 + 2) * 3 = 9 — parens beat precedence
  if run([Tok.TLP, Tok.TNum(1), Tok.TOp(43), Tok.TNum(2), Tok.TRP, Tok.TOp(42), Tok.TNum(3)]) == 9 then
    unit
  else
    trap("(1+2)*3=9")

@test
def parse-left-assoc-sub() =
  // 10 - 3 - 2 = 5 (left-assoc: (10-3)-2), NOT 9 (10-(3-2))
  if run([Tok.TNum(10), Tok.TOp(45), Tok.TNum(3), Tok.TOp(45), Tok.TNum(2)]) == 5 then
    unit
  else
    trap("10-3-2=5 (left-assoc)")

@test
def parse-left-assoc-div() =
  // 100 / 5 / 2 = 10 (left-assoc: (100/5)/2), NOT 40
  if run([Tok.TNum(100), Tok.TOp(47), Tok.TNum(5), Tok.TOp(47), Tok.TNum(2)]) == 10 then
    unit
  else
    trap("100/5/2=10 (left-assoc)")

@test
def parse-nested-parens() =
  // ((7)) = 7 — nested parens through the mutual recursion
  if run([Tok.TLP, Tok.TLP, Tok.TNum(7), Tok.TRP, Tok.TRP]) == 7 then unit else trap("((7))=7")

@test
def parse-deep-mix() =
  // 2 * (3 + 4) - 1 = 13
  let ts = [Tok.TNum(2), Tok.TOp(42), Tok.TLP, Tok.TNum(3), Tok.TOp(43), Tok.TNum(4), Tok.TRP, Tok.TOp(45), Tok.TNum(1)] in
  if run(ts) == 13 then unit else trap("2*(3+4)-1=13")

@test
def parse-depth-flat-vs-nested() =
  // 1+2 has depth 2 (one Bin over two Lits); a bare literal has depth 1
  if depth(parse([Tok.TNum(5)])) == 1 then
    (if depth(parse([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2)])) == 2 then unit else trap("1+2 depth 2"))
  else
    trap("literal depth 1")

@test
def parse-precedence-shapes-depth() =
  // 1+2*3 parses as (1 + (2*3)): the right child is itself a Bin, so depth is 3
  if depth(parse([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2), Tok.TOp(42), Tok.TNum(3)])) == 3 then
    unit
  else
    trap("1+2*3 depth 3")

export { parse, eval-expr, run, depth }
