/// strlex.cdz — a STRING LEXER: tokenize a real `String` of source text into a `List Token`. This is the
/// text version of `lex.cdz` (which lexes a `List Int64` of char-codes to sidestep a bug that is now
/// FIXED): as of the runtime-`String.at`-content-equality fix (2026-07-14), scanning a runtime string
/// char-by-char with `String.at(s, i) == "<c>"` inside a loop WORKS, so a hand-written tokenizer over
/// actual text is finally expressible — the front end a compiler really needs. It recognizes multi-digit
/// non-negative integers, the `+ - * /` operators, and `( )` parens; whitespace is skipped; anything else
/// is `Token.Bad`.
///
/// It exercises exactly the shape that regressed for so long — `String.at` in a self-recursive loop, its
/// one-char result compared to string literals, and the string operand `s` threaded through the recursion
/// (re-read every iteration). That this now lexes correctly is the end-to-end proof of the fix.

type Token =
  | Num(Int64)
  | Op(String)
  | LParen
  | RParen
  | Bad(String)

/// ⚠ NOTE: the per-char scan INLINES `String.at`'s match into each loop arm rather than factoring a
/// `char-at` helper that RETURNS the char. A `String`-returning helper whose result is `==`-compared
/// INSIDE a self-recursive loop declines ("borrowing op operand has an ownership this backend cannot yet
/// prove" — see `repros/decline-returned-string-at-compared-in-a-loop.cdz`); inlining the `String.at`
/// match sidesteps it (the direct-producer form the recent String.at fix supports).

def is-digit(c: String) =
  c == "0" or c == "1" or c == "2" or c == "3" or c == "4"
  or c == "5" or c == "6" or c == "7" or c == "8" or c == "9"

def is-space(c: String) = c == " "
def is-op(c: String) = c == "+" or c == "-" or c == "*" or c == "/"

/// The integer value of a single digit char (assumes `is-digit c`).
def digit-val(c: String) =
  if c == "0" then 0 else (if c == "1" then 1 else (if c == "2" then 2 else (if c == "3" then 3
  else (if c == "4" then 4 else (if c == "5" then 5 else (if c == "6" then 6 else (if c == "7" then 7
  else (if c == "8" then 8 else 9))))))))

/// Scan a run of digits from `i`, accumulating the decimal value into `acc`. Returns `(value, next-index)`.
/// `String.at` is matched INLINE (see the note above).
def scan-number(s: String, i: Int64, acc: Int64) =
  if i == String.byte-len(s) then
    (acc, i)
  else
    (match String.at(s, i) with
      | Option.Some(c) => (if is-digit(c) then scan-number(s, i + 1, acc * 10 + digit-val(c)) else (acc, i))
      | Option.None(_) => (acc, i))

/// The core loop: from index `i`, append each lexed token onto `acc` (in source order; `List.push`
/// appends). A tail-recursive self-call threading `s` (re-read each step), `i`, and the growing `acc`.
/// `String.at` is matched INLINE, and the char `c` classified within that arm.
def lex-from(s: String, i: Int64, acc: List(Token)) =
  if i == String.byte-len(s) then
    acc
  else
    (match String.at(s, i) with
      | Option.None(_) => acc
      | Option.Some(c) =>
        (if is-space(c) then
          lex-from(s, i + 1, acc)
        else
          (if is-digit(c) then
            let scanned = scan-number(s, i, 0) in
            lex-from(s, scanned.1, List.push(acc, Token.Num(scanned.0)))
          else
            (if is-op(c) then
              lex-from(s, i + 1, List.push(acc, Token.Op(c)))
            else
              (if c == "(" then
                lex-from(s, i + 1, List.push(acc, Token.LParen))
              else
                (if c == ")" then
                  lex-from(s, i + 1, List.push(acc, Token.RParen))
                else
                  lex-from(s, i + 1, List.push(acc, Token.Bad(c)))))))))

/// Lex a whole source string into a `List Token` in source order.
def lex(s: String) = lex-from(s, 0, [])

/// How many tokens `s` lexes to.
def token-count(s: String) = List.len(lex(s))

/// The numeric value of the token at position `i`, or -1 if it is not a `Num`.
def num-at(s: String, i: Int64) = match List.at(lex(s), i) with
  | Option.Some(t) => (match t with
    | Token.Num(n) => n
    | _ => 0 - 1)
  | Option.None(_) => 0 - 1

/// Whether the token at `i` is the operator `op` (a one-char string).
def op-at-is(s: String, i: Int64, op: String) = match List.at(lex(s), i) with
  | Option.Some(t) => (match t with
    | Token.Op(c) => c == op
    | _ => false)
  | Option.None(_) => false

@test
def strlex-empty() = if token-count("") == 0 then unit else trap("empty source, no tokens")

@test
def strlex-single-digit() =
  if token-count("7") == 1 then (if num-at("7", 0) == 7 then unit else trap("7")) else trap("one token")

@test
def strlex-multi-digit() =
  // "123" → [Num 123] (scan-number over a runtime string — the once-broken loop shape)
  if token-count("123") == 1 then (if num-at("123", 0) == 123 then unit else trap("123")) else trap("one token")

@test
def strlex-two-numbers() =
  // "12 34" → [Num 12, Num 34]
  if token-count("12 34") == 2 then
    (if num-at("12 34", 0) == 12 then (if num-at("12 34", 1) == 34 then unit else trap("34")) else trap("12"))
  else
    trap("two numbers")

@test
def strlex-simple-expr() =
  // "1+2" → [Num 1, Op +, Num 2]
  if token-count("1+2") == 3 then
    (if num-at("1+2", 0) == 1 then
      (if op-at-is("1+2", 1, "+") then (if num-at("1+2", 2) == 2 then unit else trap("2")) else trap("+"))
    else trap("1"))
  else trap("three tokens")

@test
def strlex-full-expr() =
  // "(12+345)*6" → LParen Num12 Op+ Num345 RParen Op* Num6 = 7 tokens
  let src = "(12+345)*6" in
  if token-count(src) == 7 then
    (if num-at(src, 1) == 12 then
      (if num-at(src, 3) == 345 then (if num-at(src, 6) == 6 then unit else trap("6")) else trap("345"))
    else trap("12"))
  else trap("seven tokens")

@test
def strlex-skips-spaces() =
  if token-count("  5  ") == 1 then (if num-at("  5  ", 0) == 5 then unit else trap("5")) else trap("spaces skipped")

@test
def strlex-order-preserved() =
  // "9-1" → Num9 Op- Num1 (source order restored — no reversal)
  let src = "9-1" in
  if num-at(src, 0) == 9 then
    (if op-at-is(src, 1, "-") then (if num-at(src, 2) == 1 then unit else trap("1 last")) else trap("- middle"))
  else trap("9 first")

@test
def strlex-large-number() =
  // "1000000" → Num 1000000 (deep scan-number accumulation over a runtime string)
  if num-at("1000000", 0) == 1000000 then unit else trap("1000000")

@test
def strlex-bad-char() =
  // "@" → [Bad "@"] — one unrecognized token, not a Num
  if token-count("@") == 1 then (if num-at("@", 0) == 0 - 1 then unit else trap("bad char is not a Num")) else trap("one bad token")

export { lex, token-count, num-at, op-at-is }
