/// compare.cdz — a TOTAL ORDER over `Ast` (a three-way comparison returning -1 / 0 / 1), the canonical
/// ordering a compiler uses to sort, dedup, or key nodes (e.g. hash-cons a term table, canonicalize a
/// commutative operator's operands). It orders first by node TAG (Num before Node), then within a tag by
/// payload — `Num`s by value, `Node`s lexicographically by their children (a shorter list precedes a
/// longer one that extends it). Fully recursive: a `Node` comparison descends element-by-element.
type Ast =
  | Num(Int64)
  | Node(List(Ast))

/// The tag rank: `Num` < `Node`.
def tag(e: Ast) = match e with
  | Ast.Num(_) => 0
  | Ast.Node(_) => 1

/// Three-way compare of two Int64s: -1 / 0 / 1.
def icmp(a: Int64, b: Int64) = if a < b then 0 - 1 else (if a > b then 1 else 0)

/// Three-way compare of two `Ast`s: by tag, then by payload (recursively for `Node`).
def cmp(x: Ast, y: Ast) =
  let tc = icmp(tag(x), tag(y)) in
  if tc == 0 then
    (match x with
      | Ast.Num(a) => (match y with | Ast.Num(b) => icmp(a, b) | _ => 0)
      | Ast.Node(xs) => (match y with | Ast.Node(ys) => cmp-list(xs, ys) | _ => 0))
  else
    tc

/// Lexicographic compare of two child lists: element-wise, then by length (a proper prefix is smaller).
def cmp-list(xs: List(Ast), ys: List(Ast)) = match xs with
  | [] => (match ys with | [] => 0 | _ => 0 - 1)
  | [xh, .. xt] => (match ys with
    | [] => 1
    | [yh, .. yt] => (let c = cmp(xh, yh) in if c == 0 then cmp-list(xt, yt) else c))

/// Structural equality via the total order (a cross-check: `cmp` returns 0 exactly when equal).
def eq(x: Ast, y: Ast) = cmp(x, y) == 0

@test
def cmp-num-lt() = if cmp(Ast.Num(3), Ast.Num(5)) == 0 - 1 then unit else trap("3 < 5")

@test
def cmp-num-gt() = if cmp(Ast.Num(5), Ast.Num(3)) == 1 then unit else trap("5 > 3")

@test
def cmp-num-eq() = if cmp(Ast.Num(5), Ast.Num(5)) == 0 then unit else trap("5 == 5")

@test
def cmp-tag-num-before-node() =
  // a Num precedes ANY Node, regardless of contents
  if cmp(Ast.Num(999), Ast.Node([])) == 0 - 1 then unit else trap("Num < Node")

@test
def cmp-tag-node-after-num() =
  if cmp(Ast.Node([Ast.Num(0)]), Ast.Num(0)) == 1 then unit else trap("Node > Num")

@test
def cmp-list-prefix-smaller() =
  // [1] < [1, 2] — a proper prefix is smaller
  if cmp(Ast.Node([Ast.Num(1)]), Ast.Node([Ast.Num(1), Ast.Num(2)])) == 0 - 1 then unit else trap("[1] < [1,2]")

@test
def cmp-list-elementwise() =
  // [1, 5] > [1, 2] — decided at the second element
  if cmp(Ast.Node([Ast.Num(1), Ast.Num(5)]), Ast.Node([Ast.Num(1), Ast.Num(2)])) == 1 then unit else trap("[1,5] > [1,2]")

@test
def cmp-list-equal() =
  if cmp(Ast.Node([Ast.Num(7)]), Ast.Node([Ast.Num(7)])) == 0 then unit else trap("[7] == [7]")

@test
def cmp-nested-equal() =
  let t = Ast.Node([Ast.Num(1), Ast.Node([Ast.Num(2), Ast.Num(3)])]) in
  if eq(t, t) then unit else trap("a tree equals itself")

@test
def cmp-nested-differs-deep() =
  // differ only at a deeply-nested leaf
  let a = Ast.Node([Ast.Num(1), Ast.Node([Ast.Num(2), Ast.Num(3)])]) in
  let b = Ast.Node([Ast.Num(1), Ast.Node([Ast.Num(2), Ast.Num(4)])]) in
  if cmp(a, b) == 0 - 1 then unit else trap("differ at deep leaf 3 < 4")

@test
def cmp-antisymmetry() =
  // cmp(a,b) == -cmp(b,a) for a != b (a total-order invariant)
  let a = Ast.Node([Ast.Num(1)]) in
  let b = Ast.Node([Ast.Num(2)]) in
  if cmp(a, b) == 0 - cmp(b, a) then unit else trap("antisymmetric")

@test
def cmp-empty-nodes-equal() =
  if cmp(Ast.Node([]), Ast.Node([])) == 0 then unit else trap("() == ()")

export { cmp, eq }
