/// hash.cdz — a STRUCTURAL HASH over an `Ast` (a rolling polynomial hash mixing each node's tag,
/// payload, and child hashes). This is the core of hash-consing / common-subexpression elimination: a
/// compiler keys distinct subterms by a hash so it can share or dedup them. The key property is
/// CONGRUENCE — two structurally-equal `Ast`s hash to the SAME value, and distinct shapes (almost
/// always) differ. All-scalar (`Int64`) recursion, so it never crosses a heap value through a call.
type Ast =
  | Num(Int64)
  | Node(List(Ast))

/// The rolling-hash mix step: `acc * 31 + v` (kept within Int64; the corpus trees are small).
def mix(acc: Int64, v: Int64) = acc * 31 + v

/// The structural hash: a `Num` mixes its value under tag 1; a `Node` mixes its children's hashes under
/// tag 2, left to right (so element ORDER matters — `[a, b]` and `[b, a]` differ).
def hash(e: Ast) = match e with
  | Ast.Num(v) => mix(1, v)
  | Ast.Node(kids) => hash-list(kids, mix(2, 0))

def hash-list(xs: List(Ast), acc: Int64) = match xs with
  | [] => acc
  | [h, .. t] => hash-list(t, mix(acc, hash(h)))

@test
def hash-leaf-deterministic() =
  // the same leaf hashes the same each time
  if hash(Ast.Num(5)) == hash(Ast.Num(5)) then unit else trap("Num 5 deterministic")

@test
def hash-different-leaves() =
  if hash(Ast.Num(5)) == hash(Ast.Num(6)) then trap("5 and 6 differ") else unit

@test
def hash-congruence-flat() =
  // two structurally-equal flat nodes hash equal
  let a = Ast.Node([Ast.Num(1), Ast.Num(2)]) in
  let b = Ast.Node([Ast.Num(1), Ast.Num(2)]) in
  if hash(a) == hash(b) then unit else trap("equal flat nodes hash equal")

@test
def hash-congruence-nested() =
  // deep structural equality → equal hash
  let a = Ast.Node([Ast.Num(1), Ast.Node([Ast.Num(2), Ast.Num(3)])]) in
  let b = Ast.Node([Ast.Num(1), Ast.Node([Ast.Num(2), Ast.Num(3)])]) in
  if hash(a) == hash(b) then unit else trap("equal nested trees hash equal")

@test
def hash-order-sensitive() =
  // [1, 2] and [2, 1] are DIFFERENT structures → different hashes
  if hash(Ast.Node([Ast.Num(1), Ast.Num(2)])) == hash(Ast.Node([Ast.Num(2), Ast.Num(1)])) then
    trap("order matters")
  else
    unit

@test
def hash-shape-sensitive() =
  // Num 5 and Node[Num 5] differ (a leaf vs a one-element node)
  if hash(Ast.Num(5)) == hash(Ast.Node([Ast.Num(5)])) then trap("leaf vs node differ") else unit

@test
def hash-arity-sensitive() =
  // [1] and [1, 1] differ (different arity)
  if hash(Ast.Node([Ast.Num(1)])) == hash(Ast.Node([Ast.Num(1), Ast.Num(1)])) then
    trap("arity matters")
  else
    unit

@test
def hash-empty-node() =
  // an empty node has a stable hash, distinct from a leaf
  if hash(Ast.Node([])) == hash(Ast.Node([])) then
    (if hash(Ast.Node([])) == hash(Ast.Num(0)) then trap("empty node vs leaf differ") else unit)
  else
    trap("empty node deterministic")

@test
def hash-deep-congruence() =
  // (((5))) equals itself structurally
  let t = Ast.Node([Ast.Node([Ast.Node([Ast.Num(5)])])]) in
  if hash(t) == hash(t) then unit else trap("deep tree hashes to itself")

export { hash, mix }
