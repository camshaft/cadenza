/// sread-eval.cdz — END-TO-END integration test of the SOURCE-IN pipeline: a program's canonical s-expr
/// SOURCE TEXT → `sread.read-source` → `Node` arena → `eval-db.eval-tree` (which drives resolve→infer→lower
/// →eval) → a value. This is the whole Cadenza-in-Cadenza compiler run FROM SOURCE (not hand-built `Tok`
/// lists) — the shape `cdz run-ml` will invoke to differentially conform against rcdzc on the shared corpus.
///
/// `run-src(s)` returns `Option(Int64)`: `Some v` = the program ran to `v`; `None` = the ML compiler declines
/// (ill-typed / out-of-subset). These pins are the executable proof that the reader + pipeline agree on the
/// integer/bool subset, and they guard it as the reader/pipeline evolve.
import { read-source, has-illwidth-marker, has-unboundtype-marker } from "sread"

import { is-bool-at, is-tuple-at, all-defs-well-scoped } from "infer-db"

import { db-of } from "db"

import { run-of-db } from "db-eval"

/// Read + run a program from its s-expr SOURCE, through the MEMOIZED Db pipeline (P1g `run-of-db`): source →
/// `read-source` arena → `db-of` → run-of-db (resolve→infer→lower each fill-once in the Db, then eval). `Some
/// value` | `None` (declined). This is the run-of-db-PRIMARY finale (operator's "make the Db pipeline primary,
/// nuke the whim eval-tree"): the differential run path is now the CACHING pipeline, not the recompute-per-
/// demand `eval-tree`. Unblocked by the bug#4 fix (rcdzc 26e3471ac) — the let-program-at-scale divergence that
/// forced eval-tree here is gone (se-milestone-from-source passes over the Db now).
def run-src(s: String) =
  let (root, tree) = read-source(s) in
    // WHOLE-PROGRAM SCOPE check FIRST: an unbound name in an UNCALLED sibling def is still a hard reject (rcdzc
    // CDZ0101), but the demand-driven run only resolves main's reachable set — so require EVERY def body to be
    // WELL-SCOPED (no unbound name) before running, else DECLINE (matches the oracle's whole-program reject).
    // Plus the two reader-time type-decl markers: an invalid int/float payload width (has-illwidth-marker,
    // CDZ0302) and an unbound TYPE name in a top-level payload (has-unboundtype-marker, gap-B-C, CDZ0101).
    (if all-defs-well-scoped(tree) and (if has-illwidth-marker(tree) then false else true)
        and (if has-unboundtype-marker(tree) then false else true)
        // BOUNDARY: a raw COMPOUND program result (a tuple) is not a scalar boundary value — the oracle
        // (rcdzc) declines emitting a tuple-returning export, so the ML interp DECLINES a TyTuple main-result
        // to match (else the differential disagrees). A tuple used internally (projected to a scalar) is fine.
        and (if is-tuple-at(tree, root, root) then false else true) then
      (let (_, v) = run-of-db(db-of(tree), root) in v)
     else Option.None(unit))

/// Read + run, TAGGING the result with its ground type so the caller can render `true`/`false` for a
/// Bool-typed program (Core encodes Bool as the Int 0/1, but rcdzc renders it as `true`/`false` — the
/// differential compares value STRINGS, so the ML side must render the same). `Some (value, isBool)` where
/// `isBool` is `1` when the program's ROOT is `TBool`, else `0`; `None` when the program declines. One
/// export (a single tuple-in-Option heap value) → one compile, so the driver stays a single invocation.
def run-src-typed(s: String) =
  let (root, tree) = read-source(s) in
    // Same whole-program scope check as run-src (this is the entry `cdz run-ml` calls, so the differential's
    // gap1 fix lives HERE): an unbound name in an uncalled sibling def declines, matching the oracle. Plus the
    // two reader-time type-decl markers (invalid payload width CDZ0302, unbound payload TYPE gap-B-C CDZ0101).
    (if all-defs-well-scoped(tree) and (if has-illwidth-marker(tree) then false else true)
        and (if has-unboundtype-marker(tree) then false else true)
        // BOUNDARY: a raw COMPOUND program result (a tuple) is not a scalar boundary value — the oracle
        // (rcdzc) declines emitting a tuple-returning export, so the ML interp DECLINES a TyTuple main-result
        // to match (else the differential disagrees). A tuple used internally (projected to a scalar) is fine.
        and (if is-tuple-at(tree, root, root) then false else true) then
      (match run-of-db(db-of(tree), root) with
        | (_, Option.Some(v)) => Option.Some((v, if is-bool-at(tree, root, root) then 1 else 0))
        | (_, Option.None(_)) => Option.None(unit) : Option(Tuple(Int64, Int64)))
     else Option.None(unit) : Option(Tuple(Int64, Int64)))

@test
def se-int-literal() = match run-src("42") with
  | Option.Some(v) => (if v == 42 then unit else trap("42"))
  | Option.None(_) => trap("literal runs")

@test
def se-prefix-arith() =
  // (+ 1 (* 2 3)) → 7 (prefix, nested, precedence-free — the parens ARE the grouping).
  match run-src("(+ 1 (* 2 3))") with
    | Option.Some(v) => (if v == 7 then unit else trap("1+2*3=7"))
    | Option.None(_) => trap("runs")

@test
def se-negative-literal-arith() =
  // (+ -5 3) → -2: a negative literal reads as an arithmetic operand and evaluates (the reference runs this
  // to -2; compiler-ml previously DECLINED it — the read-form negative-literal arm closes that gap).
  match run-src("(+ -5 3)") with
    | Option.Some(v) => (if v == 0 - 2 then unit else trap("(+ -5 3) = -2"))
    | Option.None(_) => trap("negative literal operand runs")

@test
def se-negative-literal-in-let-and-cmp() =
  // a negative literal flows through a let binding and a comparison: (let ((x -5)) x) → -5, (< -5 0) → 1.
  match run-src("(let ((x -5)) x)") with
    | Option.Some(v) => (if v == 0 - 5 then
      match run-src("(< -5 0)") with
        | Option.Some(w) => (if w == 1 then unit else trap("(< -5 0) = 1"))
        | Option.None(_) => trap("negative in comparison runs")
    else
      trap("let x=-5 → -5"))
    | Option.None(_) => trap("negative literal in let runs")

@test
def se-tuple-projection-runs-to-element() =
  // TUPLE PROJECTION `(. t i)` runs to the i-th element (a SCALAR verdict, differential-safe): a tuple lowers
  // to CCtor(0, elems) and CProj reads store-payload(handle, i). `(. p 1)` of `(tuple 10 20)` → 20; element 0
  // of `(tuple 10 20 30)` → 10. The rcdzc-wasm oracle runs these to the same scalars (differentially expressible).
  match run-src("(let ((p (tuple 10 20))) (. p 1))") with
    | Option.Some(v) => (if v == 20 then
        match run-src("(. (tuple 10 20 30) 0)") with
          | Option.Some(w) => (if w == 10 then unit else trap("(. (tuple 10 20 30) 0) = 10"))
          | Option.None(_) => trap("element-0 projection runs")
      else trap("(. p 1) of (tuple 10 20) = 20"))
    | Option.None(_) => trap("tuple projection runs to a scalar")

@test
def se-tuple-projection-rejects-decline() =
  // The static-arity range-check + operand/index gating: an OUT-OF-BOUNDS index (List.at → None), a NON-TUPLE
  // operand, and a NON-INT index all DECLINE (run-src None) — coverage-not-yet, matching the oracle's CDZ0201
  // reject (never a value/trap, so never a differential disagreement).
  match run-src("(. (tuple 10 20 30) 3)") with
    | Option.Some(_) => trap("out-of-bounds projection must decline, not run")
    | Option.None(_) =>
      (match run-src("(. 5 0)") with
        | Option.Some(_) => trap("projection of a non-tuple operand must decline")
        | Option.None(_) => unit)

@test
def se-string-literal-reads-and-declines() =
  // STRINGS S1 stage 1b: a bare string literal `"hi"` READS (reader → NStr, not the old unsupported NVar-0
  // path) and infer types it TyString, but lower does not admit TyString yet (no scalar Core string rep until
  // the String-op stage), so run-src DECLINES (None) — NEVER a fabricated value. This pins the reader→infer→
  // lower NStr path end-to-end at the decline boundary (soundness: decline≠value, the differential's core rule).
  match run-src("\"hi\"") with
    | Option.Some(_) => trap("a bare string literal must DECLINE (no scalar verdict), not run to a value")
    | Option.None(_) => unit

@test
def se-string-byte-len-runs-to-length() =
  // STRINGS S1c: (String.byte-len "hi") CONST-FOLDS the literal's byte length to 2 (an Int64 scalar verdict) —
  // the reader folds it to NLit(2), so infer/lower/eval run it exactly like a bare int literal. A 5-char
  // literal folds to 5. Matches the rcdzc oracle's String.byte-len. The FIRST runnable string program.
  match run-src("(String.byte-len \"hi\")") with
    | Option.Some(v) => (if v == 2 then
        (match run-src("(String.byte-len \"hello\")") with
          | Option.Some(w) => (if w == 5 then unit else trap("byte-len hello = 5"))
          | Option.None(_) => trap("byte-len hello runs"))
      else trap("byte-len hi = 2"))
    | Option.None(_) => trap("(String.byte-len hi) runs to 2")

@test
def se-string-scalar-len-runs-to-length() =
  // STRINGS S1d: (String.scalar-len "hi") CONST-FOLDS the unicode-scalar count to 2, same reader-fold path as
  // byte-len but selecting scalar length. For an ASCII literal scalar-len == byte-len; the point is the second
  // Int-returning string op runs. Matches the rcdzc oracle's String.scalar-len.
  match run-src("(String.scalar-len \"hi\")") with
    | Option.Some(v) => (if v == 2 then unit else trap("scalar-len hi = 2"))
    | Option.None(_) => trap("(String.scalar-len hi) runs to 2")

@test
def se-record-field-access-runs-to-value() =
  // RECORD field access `(. r fieldname)` runs to the named field's value (a SCALAR verdict, differential-safe):
  // a record lowers to CCtor(0, field values in field order) and CProj reads the field's slot found by name.
  // `(. r b)` → 20, `(. r a)` → 10. The rcdzc-wasm oracle runs these to the same scalars.
  match run-src("(let ((r (record (a 10) (b 20)))) (. r b))") with
    | Option.Some(v) => (if v == 20 then
        match run-src("(let ((r (record (a 10) (b 20)))) (. r a))") with
          | Option.Some(w) => (if w == 10 then unit else trap("(. r a) = 10"))
          | Option.None(_) => trap("field a access runs")
      else trap("(. r b) of (record (a 10) (b 20)) = 20"))
    | Option.None(_) => trap("record field access runs to a scalar")

@test
def se-record-rejects-decline() =
  // A MISSING field and a raw-record PROGRAM RESULT both DECLINE (coverage-not-yet, matching the oracle — a
  // missing field is ill-typed; a raw compound is not a scalar boundary value). Never a value/trap → no disagree.
  match run-src("(let ((r (record (a 10) (b 20)))) (. r c))") with
    | Option.Some(_) => trap("access of a missing field must decline")
    | Option.None(_) => unit

@test
def se-nested-compound-projection() =
  // NESTED compounds (record/tuple containing a record/tuple) construct + project THROUGH to a scalar — the
  // compound machinery composes: a field/element that is itself a compound stores a nested handle, and an
  // OUTER projection reads it then an INNER projection reads a scalar out. Pins the nesting invariant (currently
  // unwitnessed): a tuple-valued record field `(. (. r a) 1)` → 20; a record-valued tuple element `(. (. t 0) x)`
  // → 5; a record nested in a record `(. (. r inner) v)` → 7. All match the rcdzc-wasm oracle.
  match run-src("(let ((r (record (a (tuple 10 20)) (b 30)))) (. (. r a) 1))") with
    | Option.Some(v) => (if v == 20 then
        match run-src("(let ((t (tuple (record (x 5) (y 6)) 9))) (. (. t 0) x))") with
          | Option.Some(w) => (if w == 5 then
              match run-src("(let ((r (record (inner (record (v 7))) (n 1)))) (. (. r inner) v))") with
                | Option.Some(u) => (if u == 7 then unit else trap("nested record-in-record (. (. r inner) v) = 7"))
                | Option.None(_) => trap("nested record-in-record runs")
            else trap("record-valued tuple element (. (. t 0) x) = 5"))
          | Option.None(_) => trap("record-in-tuple projection runs")
      else trap("tuple-valued record field (. (. r a) 1) = 20"))
    | Option.None(_) => trap("nested compound projection runs to a scalar")

@test
def se-unary-minus() =
  // (- 5) → -5: unary minus (a `-` head with one operand) desugars to `0 - 5` and evaluates. The reference
  // runs this to -5; the s-expr reader previously DECLINED it (read-bin-form required two operands).
  match run-src("(- 5)") with
    | Option.Some(v) => (if v == 0 - 5 then unit else trap("(- 5) = -5"))
    | Option.None(_) => trap("unary minus runs")

@test
def se-double-negation-and-unary-of-expr() =
  // (- (- 5)) → 5 (double negation) and (- (+ 2 3)) → -5 (unary minus of a sub-expression) — both match
  // the reference, both compose through the desugar.
  match run-src("(- (- 5))") with
    | Option.Some(v) => (if v == 5 then unit else trap("(- (- 5)) = 5"))
    | Option.None(_) => trap("double negation runs")

@test
def se-comparison() =
  // (< 1 2) → 1 (Bool true encoded 0/1).
  match run-src("(< 1 2)") with
    | Option.Some(v) => (if v == 1 then unit else trap("1<2=1"))
    | Option.None(_) => trap("runs")

@test
def se-if() =
  // (if (< 5 2) 10 20) → 20 (false → else).
  match run-src("(if (< 5 2) 10 20)") with
    | Option.Some(v) => (if v == 20 then unit else trap("if false → 20"))
    | Option.None(_) => trap("runs")

@test
def se-if-too-many-operands-declines() =
  // `if` is exactly ternary (cond then else). A FOURTH operand `(if (< 1 2) 1 2 3)` is MALFORMED (too many
  // operands) → must DECLINE (rcdzc CDZ0201), NOT silently drop the extra + run the NIf to 1. Reject-path gap
  // caught by the conf-db-vs-rcdzc enforcing differential; fixed in read-if-form (extra operand → TErr poison).
  match run-src("(do (def (main) (if (< 1 2) 1 2 3)) (export main))") with
    | Option.Some(_) => trap("a too-many-operands `if` must DECLINE (CDZ0201), not run")
    | Option.None(_) => unit

@test
def se-unbound-in-uncalled-sibling-declines() =
  // WHOLE-PROGRAM scope check: an UNBOUND name in an UNCALLED sibling def is still ill-typed (rcdzc CDZ0101).
  // `bad`'s body is a bare unbound `nonexistent`; main returns 42 without touching bad, but the demand-driven
  // run used to skip bad (only main's reachable set checked) → ran to 42. all-defs-well-scoped now scans EVERY
  // def body standalone for an RPoison (unbound name) → declines. Reject-path gap from the conf-db differential.
  match run-src("(do (def (bad) nonexistent) (def (main) 42) (export main))") with
    | Option.Some(_) => trap("an unbound name in an uncalled sibling def must DECLINE (CDZ0101), not run to 42")
    | Option.None(_) => unit

@test
def se-valid-uncalled-sibling-still-runs() =
  // the complement (guard against over-rejection): a VALID uncalled sibling (parameterized) does NOT block the
  // run — its param uses resolve RBound (no RPoison), so all-defs-well-scoped passes it. main → 42.
  match run-src("(do (def (helper x) (+ x 1)) (def (main) 42) (export main))") with
    | Option.Some(v) => (if v == 42 then unit else trap("valid uncalled sibling → main runs 42"))
    | Option.None(_) => trap("a valid uncalled sibling must NOT block the run")

@test
def se-unbound-callee-head-in-uncalled-sibling-declines() =
  // PR#997: an unbound name in CALL-HEAD position `(foo 1)` (not just value position) in an uncalled sibling
  // must also DECLINE (CDZ0101). resolve-db's NApp arm used to leave an unknown callee head's fact ABSENT
  // (no RPoison), so the whole-program scope scan missed it; now an unknown head (that is NOT a sum ctor) is
  // RPoison'd. A sum-ctor head `(Some 5)` stays a construction (se-payload-ctor tests guard that complement).
  match run-src("(do (def (bad) (foo 1)) (def (main) 42) (export main))") with
    | Option.Some(_) => trap("an unbound callee head in an uncalled sibling must DECLINE (CDZ0101)")
    | Option.None(_) => unit

@test
def se-let() =
  // (let ((x 10)) x) → 10 (binder + use share the name-id).
  match run-src("(let ((x 10)) x)") with
    | Option.Some(v) => (if v == 10 then unit else trap("let x=10 → 10"))
    | Option.None(_) => trap("runs")

@test
def se-let-refutable-literal-binder-declines() =
  // a let BINDER must be an IDENTIFIER; a numeric literal `0` in binder position `(let ((0 5)) 42)` is a
  // REFUTABLE pattern → rcdzc rejects CDZ0210. The reader used to bind `name-id("0")` + run to 42; now a
  // digit-led binder emits the `unsupported` poison → DECLINE. Reject-path gap from the conf-db differential.
  match run-src("(do (def (main) (let ((0 5)) 42)) (export main))") with
    | Option.Some(_) => trap("a refutable literal let-binder must DECLINE (CDZ0210), not run to 42")
    | Option.None(_) => unit

@test
def se-let-negative-literal-binder-declines() =
  // the NEGATIVE-literal twin (PR#998): `-1` in binder position is also a refutable literal → CDZ0210. The
  // digit-led guard misses `-1` (leads with `-`, not a digit), so the guard also rejects a `-`-led binder.
  // (A negative VALUE `(let ((x -5)) x)` still runs — the guard is on the BINDER name, not the value.)
  match run-src("(do (def (main) (let ((-1 5)) 42)) (export main))") with
    | Option.Some(_) => trap("a negative-literal let-binder must DECLINE (CDZ0210), not run to 42")
    | Option.None(_) => unit

@test
def se-type-decl-bad-int-width-declines() =
  // reject-path gaps 3/4: an INVALID int/float width in a type-decl payload is ill-formed (rcdzc CDZ0302),
  // regardless of whether the ctor is used. `(Int -8)` width ∉ 1..=64. The reader records an `__illwidth__`
  // marker → run-src declines (codegen-light: a single def lookup, vs a ctor-table fold that broke the guest).
  match run-src("(do (type T (Mk (Int -8))) (def (main) 0) (export main))") with
    | Option.Some(_) => trap("an ill-formed int width in a type-decl payload must DECLINE (CDZ0302)")
    | Option.None(_) => unit

@test
def se-type-decl-bad-float-width-declines() =
  // gap 3: a non-admitted FLOAT width `(Float 8)` (∉ {32,64}) in a type-decl payload → CDZ0302.
  match run-src("(do (type T (Mk (Float 8))) (def (main) 0) (export main))") with
    | Option.Some(_) => trap("a non-admitted float width in a type-decl payload must DECLINE (CDZ0302)")
    | Option.None(_) => unit

@test
def se-user-def-cannot-clobber-illwidth-marker() =
  // PR#1005 Copilot robustness: the invalid-width marker is keyed under the reserved def-table key 0 (which
  // `name-id` can never yield — it folds from 7 and only grows), NOT under name-id("__illwidth__"). So a user
  // `def __illwidth__` can NEITHER clobber the marker NOR false-trip has-illwidth-marker: a program with a
  // user `__illwidth__` def and NO bad width must still RUN (would have false-declined under the name key).
  match run-src("(do (def (__illwidth__) 7) (def (main) 5) (export main))") with
    | Option.Some(v) => (if v == 5 then unit else trap("a user __illwidth__ def with no bad width → main runs 5"))
    | Option.None(_) => trap("a user __illwidth__ def must NOT false-trip the invalid-width marker")

@test
def se-type-decl-valid-width-still-runs() =
  // complement (guard against over-rejection): a VALID int width `(Int 8)` in a type-decl payload is accepted
  // by the oracle (main runs to 0) — the width check must NOT decline it. (Float 32 is the valid float twin.)
  match run-src("(do (type T (Mk (Int 8))) (def (main) 0) (export main))") with
    | Option.Some(v) => (if v == 0 then unit else trap("valid (Int 8) type-decl payload → main runs 0"))
    | Option.None(_) => trap("a valid-width type-decl payload must NOT block the run")

@test
def se-type-decl-unbound-payload-type-declines() =
  // gap-B-C (breaker's last reject-path gap): an UPPERCASE, non-builtin, UNDECLARED type name in a top-level
  // type-decl payload position is ill-formed (rcdzc CDZ0101 "unknown type `Bogus`"). `(Mk Bogus)` — Bogus is
  // never declared. The reader's whole-program scan records the unbound-type marker → run-src declines.
  match run-src("(do (type T (Mk Bogus)) (def (main) 42) (export main))") with
    | Option.Some(_) => trap("an unbound payload type name must DECLINE (CDZ0101)")
    | Option.None(_) => unit

@test
def se-type-decl-declared-payload-type-still-runs() =
  // complement: an uppercase payload atom that IS a declared type runs. `(Wrap Id)` with `Id` declared — the
  // corpus's 02-binding:3814 shape. Whole-program registry accepts it → main runs 42. (Guards over-rejection.)
  match run-src("(do (type Id (Mk Int64)) (type W (Wrap Id)) (def (main) 42) (export main))") with
    | Option.Some(v) => (if v == 42 then unit else trap("declared payload type → main runs 42"))
    | Option.None(_) => trap("a declared payload type must NOT decline")

@test
def se-type-decl-forward-ref-payload-type-still-runs() =
  // FORWARD-REF (the decisive whole-program case): `(Mk A)` references `A` which is declared AFTER `B`. The
  // oracle accepts this (forward refs are valid); the scan runs at read-source completion (registry complete),
  // so `A` is registered before validation → accept. An at-read-time check would false-reject this.
  match run-src("(do (type B (Mk A)) (type A (Av)) (def (main) 42) (export main))") with
    | Option.Some(v) => (if v == 42 then unit else trap("forward-ref payload type → main runs 42"))
    | Option.None(_) => trap("a forward-referenced payload type must NOT decline")

@test
def se-type-decl-typevar-payload-still-runs() =
  // a LOWERCASE payload atom is a TYPE VARIABLE, not a concrete type — `(Box a)` — always accepted (never
  // validated). Guards against flagging generic type parameters. main runs 42.
  match run-src("(do (type Box (Box a)) (def (main) 42) (export main))") with
    | Option.Some(v) => (if v == 42 then unit else trap("type-variable payload → main runs 42"))
    | Option.None(_) => trap("a lowercase type-variable payload must NOT decline")

@test
def se-type-decl-self-ref-payload-type-still-runs() =
  // self-reference: `(type Expr (Lit Int64) (Neg Expr))` — `Neg`'s payload is the type itself. The corpus's
  // recursive-type shape. Registry includes the type being declared → accept. main runs 42.
  match run-src("(do (type Expr (Lit Int64) (Neg Expr)) (def (main) 42) (export main))") with
    | Option.Some(v) => (if v == 42 then unit else trap("self-referential payload type → main runs 42"))
    | Option.None(_) => trap("a self-referential payload type must NOT decline")

@test
def se-type-decl-nested-payload-not-flagged-runs() =
  // NESTED applied-types are OUT of the Option-C narrow slice (left to the generics-unpause). `(Holder (Box
  // Int64))` — the payload is a nested `(…)` group, which the top-level scan SKIPS. Even though a deeper name
  // could be unbound, C deliberately does not recurse — it must NOT flag this. main runs 42. (Documents the
  // C boundary: nested validation is A-scope, intentionally not done here.)
  match run-src("(do (type Box (Box a)) (type Holder (Holder (Box Int64))) (def (main) 42) (export main))") with
    | Option.Some(v) => (if v == 42 then unit else trap("nested applied-type payload → main runs 42 (C skips nested)"))
    | Option.None(_) => trap("a nested applied-type payload must NOT be flagged by the narrow C slice")

@test
def se-record-decl-unbound-field-type-declines() =
  // adv-48 (breaker's record-field face): a `record` decl's FIELD with an unbound TYPE is ill-formed (rcdzc
  // CDZ0101 "unknown type `NoSuchField`"). `(type R (record (: field NoSuchField)))` — the reader misparses
  // `record` as a ctor whose payload is the field group `(: field NoSuchField)`; the adv-48 one-level descent
  // reads the field group and checks its field-TYPE atom → declines. (Ruled WITHIN Option-C's bar: one bounded
  // level into the known flat record shape, distinct from arbitrary nested applied-type recursion.)
  match run-src("(do (type R (record (: field NoSuchField))) (def (main) 42) (export main))") with
    | Option.Some(_) => trap("a record field with an unbound type must DECLINE (CDZ0101)")
    | Option.None(_) => unit

@test
def se-record-decl-unbound-field-type-no-annotation-declines() =
  // the no-annotation spelling `(record (field NoSuchField))` (no `:`): the field group's LAST atom is still the
  // type `NoSuchField` → declines too. (Oracle rejects both spellings CDZ0101; breaker banked both.)
  match run-src("(do (type R (record (field NoSuchField))) (def (main) 42) (export main))") with
    | Option.Some(_) => trap("a no-annotation record field with an unbound type must DECLINE (CDZ0101)")
    | Option.None(_) => unit

@test
def se-record-decl-valid-field-type-still-runs() =
  // complement (guard against over-rejection): a record decl whose field type is a BUILTIN runs. `(record
  // (: field Int64))` → Int64 is a builtin, not flagged → main runs 42. (The descent must NOT flag the field
  // NAME `field` (lowercase, not the last atom) nor the `:` token — only the field-TYPE atom.)
  match run-src("(do (type R (record (: field Int64))) (def (main) 42) (export main))") with
    | Option.Some(v) => (if v == 42 then unit else trap("valid record field type → main runs 42"))
    | Option.None(_) => trap("a record field with a valid (builtin) type must NOT decline")

@test
def se-record-decl-declared-field-type-still-runs() =
  // complement: a record field whose type is a DECLARED type (whole-program registry) runs. `Id` is declared,
  // `(record (: field Id))` accepts. Guards the one-level descent against over-rejecting a legitimate type ref.
  match run-src("(do (type Id (Mk Int64)) (type R (record (: field Id))) (def (main) 42) (export main))") with
    | Option.Some(v) => (if v == 42 then unit else trap("declared record field type → main runs 42"))
    | Option.None(_) => trap("a record field with a declared type must NOT decline")

@test
def se-record-decl-applied-field-type-unbound-head-declines() =
  // adv-48 head-check (PR#1026 latent gap): a record field whose type is an APPLIED type with an UNBOUND HEAD
  // `(: field (NoSuchCtor Int64))` is ill-formed (rcdzc CDZ0101 "unknown type `NoSuchCtor`"). The one-level
  // descent reads the applied HEAD atom `NoSuchCtor` and checks it → declines. (Earlier code kept `last`=the
  // field name and skipped the whole group, so this ran 42 — a real reject-gap the misleading doc masked.)
  match run-src("(do (type R (record (: field (NoSuchCtor Int64)))) (def (main) 42) (export main))") with
    | Option.Some(_) => trap("a record field with an unbound applied-type HEAD must DECLINE (CDZ0101)")
    | Option.None(_) => unit

@test
def se-record-decl-applied-field-type-declared-head-still-runs() =
  // complement: an applied field type with a DECLARED head runs, AND its nested arg is NOT recursed into
  // (STAY ONE LEVEL). `(: field (Box NoSuchInner))` with `Box` declared → head `Box` is fine, `NoSuchInner`
  // (nested) is out of scope (oracle-CLEAN) → main runs 42. Guards both the head-accept and the no-recurse rule.
  match run-src("(do (type Box (Box a)) (type R (record (: field (Box NoSuchInner)))) (def (main) 42) (export main))") with
    | Option.Some(v) => (if v == 42 then unit else trap("declared applied-head + nested arg → main runs 42 (one level)"))
    | Option.None(_) => trap("a record field with a declared applied-type head must NOT decline (nested arg out of scope)")

@test
def se-export-unbound-name-declines() =
  // an `(export NAME)` where NAME names NO definition is ill-formed (rcdzc CDZ0101 "export names no
  // definition"). The reader used to ignore the export name (a non-def head just ended the sequence), so
  // `(export foo)` ran main→42; now read-do-form checks the export target is a declared def. Breaker probe.
  match run-src("(do (def (main) 42) (export foo))") with
    | Option.Some(_) => trap("an export of an unbound name must DECLINE (CDZ0101)")
    | Option.None(_) => unit

@test
def se-export-real-def-still-runs() =
  // complement: exporting a REAL def (main, or a forward-declared helper) still runs.
  match run-src("(do (def (helper) 7) (def (main) 42) (export helper))") with
    | Option.Some(v) => (if v == 42 then unit else trap("export of a real def → main runs 42"))
    | Option.None(_) => trap("exporting a declared def must NOT decline")

@test
def se-later-unbound-export-declines() =
  // gap-A RESIDUAL (breaker re-probe): a VALID export FOLLOWED by an unbound one must ALSO decline. The first
  // fix stopped reading at the FIRST valid export, so `(export main) (export no-such-def)` slipped through
  // and ran 42; rcdzc rejects ALL these CDZ0101. read-do-form now KEEPS READING after a valid export
  // (read-do-next) so a LATER unbound export re-enters the check + poisons the root.
  match run-src("(do (def (main) 42) (export main) (export no-such-def))") with
    | Option.Some(_) => trap("a later unbound export must DECLINE (CDZ0101), not run to 42")
    | Option.None(_) => unit

@test
def se-later-unbound-export-after-helper-declines() =
  // breaker's second residual shape: `(export helper) (export no-such-def)` — a valid helper export followed
  // by an unbound one. Also must decline (rcdzc CDZ0101), same multi-export walk.
  match run-src("(do (def (helper) 7) (def (main) 42) (export helper) (export no-such-def))") with
    | Option.Some(_) => trap("a later unbound export after a valid one must DECLINE (CDZ0101)")
    | Option.None(_) => unit

@test
def se-multiple-valid-exports-still-run() =
  // complement (guard against over-rejection): MULTIPLE all-valid exports thread the root through to the
  // do's terminal `)` — `(export main) (export helper)` both name real defs → main runs 42.
  match run-src("(do (def (helper) 7) (def (main) 42) (export main) (export helper))") with
    | Option.Some(v) => (if v == 42 then unit else trap("multiple valid exports → main runs 42"))
    | Option.None(_) => trap("multiple valid exports must NOT decline")

@test
def se-duplicate-param-name-declines() =
  // PARAM LINEARITY (breaker adv-47): a def binding two params with the SAME name `(def (f (: x …) (: x …)) x)`
  // is non-linear → rcdzc CDZ0102. ML silently shadowed the first `x`, so `(f 1 2)` computed 2 (a DIFFERENT
  // value than the oracle allows — worse than a missing reject). all-defs-well-scoped now also rejects a def
  // whose param names aren't distinct.
  match run-src("(do (def (f (: x Int64) (: x Int64)) x) (def (main) (f 1 2)) (export main))") with
    | Option.Some(_) => trap("a def with two same-named params must DECLINE (CDZ0102), not shadow + run to 2")
    | Option.None(_) => unit

@test
def se-distinct-param-names-still-run() =
  // complement: a def with DISTINCT param names is fine — `(f (: x …) (: y …)) = (+ x y)`, `(f 1 2)` → 3.
  match run-src("(do (def (f (: x Int64) (: y Int64)) (+ x y)) (def (main) (f 1 2)) (export main))") with
    | Option.Some(v) => (if v == 3 then unit else trap("distinct-param fn (f 1 2) → 3"))
    | Option.None(_) => trap("a def with distinct param names must NOT decline")

@test
def se-let-multi-binding() =
  // MULTI-binding let `(let ((x 5) (y 10)) (+ x y))` → 15. Desugars to nested single-lets
  // `(let ((x 5)) (let ((y 10)) (+ x y)))`, which resolve/lower/eval already handle. Matches the reference
  // (which runs an N-binding let); a single-binding let was the only form before. Also a 3-binding form → 6.
  match run-src("(let ((x 5) (y 10)) (+ x y))") with
    | Option.Some(v) => (if v == 15 then
      match run-src("(let ((x 1) (y 2) (z 3)) (+ x (+ y z)))") with
        | Option.Some(w) => (if w == 6 then unit else trap("3-binding let → 6"))
        | Option.None(_) => trap("3-binding let runs")
    else
      trap("2-binding let → 15"))
    | Option.None(_) => trap("2-binding let runs")

@test
def se-let-multi-binding-is-sequential() =
  // multi-binding let is SEQUENTIAL (let*): an inner binding SEES an outer one. `(let ((x 5) (y (+ x 1))) y)`
  // → 6 (y's value uses x). The right-nested desugar preserves this. Matches the reference. (The other
  // direction — an OUTER binding canNOT see an inner — is enforced by resolve: `(let ((x (+ y 1)) (y 5)) x)`
  // declines CDZ0101, y unbound in x's value; covered by the reference-parity probe, not asserted here.)
  match run-src("(let ((x 5) (y (+ x 1))) y)") with
    | Option.Some(v) => (if v == 6 then unit else trap("sequential let: y = x+1 = 6"))
    | Option.None(_) => trap("sequential multi-binding let runs")

@test
def se-underscore-led-identifier-runs() =
  // reader-completeness: a `_`-led identifier (`_x`) is a valid name — `(let ((_x 5)) _x)` → 5. Before the
  // is-alpha `_` fix, compiler-ml DECLINED it (the read-form dispatch didn't treat `_` as an atom lead), a
  // conformance gap vs rcdzc (which accepts `let _x = 5 in _x` → 5, differential-verified). The corpus uses
  // `_1`/`_000`-style names (e.g. `(def (f _1) …)`), so this unblocks those cases too.
  match run-src("(let ((_x 5)) _x)") with
    | Option.Some(v) => (if v == 5 then unit else trap("_x binds 5"))
    | Option.None(_) => trap("a _-led identifier reads + runs")

@test
def se-milestone-from-source() =
  // ★ THE MILESTONE, FROM SOURCE TEXT ★ — (let ((x 2)) (+ (* x 3) 1)) → 7. The re-charter's headline program
  // now runs source → sread → arena → resolve/infer/lower/eval → 7, with the source READ by the ML compiler
  // (not a hand-built Tok list). This is `let x = 2 in x*3+1` in canonical prefix s-expr.
  match run-src("(let ((x 2)) (+ (* x 3) 1))") with
    | Option.Some(v) => (if v == 7 then unit else trap("MILESTONE from source = 7"))
    | Option.None(_) => trap("milestone runs")

@test
def se-nested-let() =
  // (let ((a 1)) (let ((b 2)) (+ a b))) → 3.
  match run-src("(let ((a 1)) (let ((b 2)) (+ a b)))") with
    | Option.Some(v) => (if v == 3 then unit else trap("nested let → 3"))
    | Option.None(_) => trap("runs")

export { run-src, run-src-typed }
