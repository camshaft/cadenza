/// sread-eval.cdz — END-TO-END integration test of the SOURCE-IN pipeline: a program's canonical s-expr
/// SOURCE TEXT → `sread.read-source` → `Node` arena → `eval-db.eval-tree` (which drives resolve→infer→lower
/// →eval) → a value. This is the whole Cadenza-in-Cadenza compiler run FROM SOURCE (not hand-built `Tok`
/// lists) — the shape `cdz run-ml` will invoke to differentially conform against rcdzc on the shared corpus.
///
/// `run-src(s)` returns `Option(Int64)`: `Some v` = the program ran to `v`; `None` = the ML compiler declines
/// (ill-typed / out-of-subset). These pins are the executable proof that the reader + pipeline agree on the
/// integer/bool subset, and they guard it as the reader/pipeline evolve.

import { read-source } from "sread"
import { eval-tree } from "eval-db"
import { is-bool-at } from "infer-db"

/// Read + run a program from its s-expr SOURCE. `Some value` | `None` (declined).
def run-src(s: String) = match read-source(s) with | (root, tree) => eval-tree(tree, root)

/// Read + run, TAGGING the result with its ground type so the caller can render `true`/`false` for a
/// Bool-typed program (Core encodes Bool as the Int 0/1, but rcdzc renders it as `true`/`false` — the
/// differential compares value STRINGS, so the ML side must render the same). `Some (value, isBool)` where
/// `isBool` is `1` when the program's ROOT is `TBool`, else `0`; `None` when the program declines. One
/// export (a single tuple-in-Option heap value) → one compile, so the driver stays a single invocation.
def run-src-typed(s: String) =
  (match read-source(s) with
   | (root, tree) =>
     (match eval-tree(tree, root) with
      | Option.Some(v) => Option.Some((v, (if is-bool-at(tree, root, root) then 1 else 0)))
      | Option.None(_) => (Option.None(unit) : Option(Tuple(Int64, Int64)))))

@test
def se-int-literal() =
  (match run-src("42") with | Option.Some(v) => (if v == 42 then unit else trap("42")) | Option.None(_) => trap("literal runs"))

@test
def se-prefix-arith() =
  // (+ 1 (* 2 3)) → 7 (prefix, nested, precedence-free — the parens ARE the grouping).
  (match run-src("(+ 1 (* 2 3))") with | Option.Some(v) => (if v == 7 then unit else trap("1+2*3=7")) | Option.None(_) => trap("runs"))

@test
def se-comparison() =
  // (< 1 2) → 1 (Bool true encoded 0/1).
  (match run-src("(< 1 2)") with | Option.Some(v) => (if v == 1 then unit else trap("1<2=1")) | Option.None(_) => trap("runs"))

@test
def se-if() =
  // (if (< 5 2) 10 20) → 20 (false → else).
  (match run-src("(if (< 5 2) 10 20)") with | Option.Some(v) => (if v == 20 then unit else trap("if false → 20")) | Option.None(_) => trap("runs"))

@test
def se-let() =
  // (let ((x 10)) x) → 10 (binder + use share the name-id).
  (match run-src("(let ((x 10)) x)") with | Option.Some(v) => (if v == 10 then unit else trap("let x=10 → 10")) | Option.None(_) => trap("runs"))

@test
def se-milestone-from-source() =
  // ★ THE MILESTONE, FROM SOURCE TEXT ★ — (let ((x 2)) (+ (* x 3) 1)) → 7. The re-charter's headline program
  // now runs source → sread → arena → resolve/infer/lower/eval → 7, with the source READ by the ML compiler
  // (not a hand-built Tok list). This is `let x = 2 in x*3+1` in canonical prefix s-expr.
  (match run-src("(let ((x 2)) (+ (* x 3) 1))") with | Option.Some(v) => (if v == 7 then unit else trap("MILESTONE from source = 7")) | Option.None(_) => trap("milestone runs"))

@test
def se-nested-let() =
  // (let ((a 1)) (let ((b 2)) (+ a b))) → 3.
  (match run-src("(let ((a 1)) (let ((b 2)) (+ a b)))") with | Option.Some(v) => (if v == 3 then unit else trap("nested let → 3")) | Option.None(_) => trap("runs"))

@test
def se-unbound-declines() =
  // a bare unbound var → None (declined), NOT a value: the differential must see decline, not a bogus value.
  (match run-src("y") with | Option.None(_) => unit | Option.Some(_) => trap("unbound y declines"))

@test
def se-unsupported-declines() =
  // an OUT-OF-SUBSET lead (a string literal) → None (declined). Reader recovery = unbound NVar → TErr → None,
  // NOT an NLit-0 that would fabricate a value and falsely disagree with rcdzc.
  (match run-src("\"hello\"") with | Option.None(_) => unit | Option.Some(_) => trap("string literal declines"))

@test
def se-digit-separator-declines() =
  // `1_000_000` is a DIGIT-SEPARATOR literal this subset doesn't support — it must DECLINE, NOT read the
  // prefix `1` (which would falsely differ from rcdzc's 1000000). The token-boundary guard catches it.
  (match run-src("1_000_000") with | Option.None(_) => unit | Option.Some(_) => trap("1_000_000 declines, not value 1"))

@test
def se-trailing-junk-declines() =
  // `123abc` is malformed (rcdzc rejects it) — must DECLINE, not read `123` and ignore the trailing letters.
  (match run-src("123abc") with | Option.None(_) => unit | Option.Some(_) => trap("123abc declines, not value 123"))

@test
def se-plain-int-still-runs() =
  // regression guard: a CLEAN int literal still runs (the boundary guard only rejects non-clean endings).
  (match run-src("42") with | Option.Some(v) => (if v == 42 then unit else trap("42")) | Option.None(_) => trap("clean int still runs"))

@test
def se-typed-int-flag() =
  // an INT-valued program tags isBool=0 (renders as a bare scalar).
  (match run-src-typed("42") with
   | Option.Some((v, b)) => (if (v == 42 and b == 0) then unit else trap("42 int flag=0"))
   | Option.None(_) => trap("typed int runs"))

@test
def se-typed-bool-flag() =
  // a COMPARISON program is Bool-typed → isBool=1, value 1 (so the caller renders `true`, not `1`).
  (match run-src-typed("(< 1 2)") with
   | Option.Some((v, b)) => (if (v == 1 and b == 1) then unit else trap("1<2 bool flag=1"))
   | Option.None(_) => trap("typed bool runs"))

@test
def se-typed-bool-false-flag() =
  // a false comparison → isBool=1, value 0 (caller renders `false`).
  (match run-src-typed("(< 5 2)") with
   | Option.Some((v, b)) => (if (v == 0 and b == 1) then unit else trap("5<2 bool flag=1 val=0"))
   | Option.None(_) => trap("typed bool false runs"))

@test
def se-typed-declines() =
  // an out-of-subset / unbound program declines under the typed query too (None, not a fabricated tuple).
  (match run-src-typed("y") with | Option.None(_) => unit | Option.Some(_) => trap("typed unbound declines"))

// ---- width-annotated literals flow end-to-end (slice 2b-ii: NAnnLit → narrow TIntW → narrow CNum → eval) ----

@test
def se-ann-in-range-runs-to-value() =
  // `(: 200 UInt8)` threads through sread(NAnnLit)→infer(TIntW(false,8))→lower(CNum(200,false,8))→eval → 200.
  // (eval reads the value; the narrow type flowed but the value is unchanged in range.)
  (match run-src("(: 200 UInt8)") with | Option.Some(v) => (if v == 200 then unit else trap("(: 200 UInt8) → 200")) | Option.None(_) => trap("in-range annotation runs"))

@test
def se-ann-negative-runs-to-value() =
  // `(: -5 Int8)` → -5 (signed narrow, in range).
  (match run-src("(: -5 Int8)") with | Option.Some(v) => (if v == (0 - 5) then unit else trap("(: -5 Int8) → -5")) | Option.None(_) => trap("in-range signed annotation runs"))

@test
def se-ann-out-of-range-declines() =
  // `(: 300 UInt8)` → out of range → sread emits unsupported → resolve poison → eval None (declines).
  (match run-src("(: 300 UInt8)") with | Option.None(_) => unit | Option.Some(_) => trap("(: 300 UInt8) must decline"))

@test
def se-ann-used-in-arith-runs() =
  // an annotated literal is an ordinary operand: `(+ (: 100 Int8) 20)` → 120 (the annotation types the
  // operand; arithmetic over it evaluates normally — narrow-arith wrapping is a later slice).
  (match run-src("(+ (: 100 Int8) 20)") with | Option.Some(v) => (if v == 120 then unit else trap("(+ (: 100 Int8) 20) → 120")) | Option.None(_) => trap("annotated operand in arith runs"))

export { run-src, run-src-typed }
