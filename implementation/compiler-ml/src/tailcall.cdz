/// tailcall.cdz — TAIL-POSITION analysis: which calls in a function body are in TAIL position (the last
/// thing evaluated before returning), so a backend can turn them into jumps instead of stack-growing calls
/// (tail-call optimization; a self-tail-call becomes a loop). A call is in tail position iff its value IS
/// the value of the enclosing expression — nothing happens to the result afterward.
///
/// The classic rules over an expression language (`callee` is a function id; `Call(f, args)` is an
/// application whose ARGUMENTS are evaluated first, then the call):
///   - `Call` in tail position   → a tail call.
///   - `If(c, t, f)`             → `t` and `f` inherit tail position; the condition `c` does NOT (its value
///                                 is consumed by the branch, not returned).
///   - `Let(rhs, body)`          → `body` inherits tail position; `rhs` does NOT (it is bound, then `body`
///                                 runs).
///   - `Prim(op, l, r)`          → NEITHER operand is in tail position (the primitive consumes both, and
///                                 ITS result is what's returned — so a call under a `+` is never tail).
///   - a call inside a `Call`'s ARGUMENTS is never tail (the outer call consumes it).
///
/// Every call is counted by `all-calls`; the tail ones by `tail-calls`; `non-tail-calls` is the difference.
/// `is-self-tail-recursive f e` asks whether `f`'s own body has a tail call to `f` — the exact condition
/// for compiling `f` as a loop. Counting is a single bottom-up traversal (no per-node re-walk).

type Expr =
  | Lit(Int64)
  | Var(Int64)
  | Call(Int64, List(Expr))     // apply function id `callee` to argument expressions
  | Prim(Int64, Expr, Expr)     // a primitive op (e.g. +) over two operands — result is NOT a tail call
  | If(Expr, Expr, Expr)
  | Let(Expr, Expr)             // bind rhs, evaluate body (body is the tail position)

/// Total number of call sites anywhere in `e` (tail or not).
def all-calls(e: Expr) = match e with
  | Expr.Lit(_) => 0
  | Expr.Var(_) => 0
  | Expr.Call(_, args) => 1 + all-calls-list(args)
  | Expr.Prim(_, l, r) => all-calls(l) + all-calls(r)
  | Expr.If(c, t, f) => all-calls(c) + all-calls(t) + all-calls(f)
  | Expr.Let(rhs, body) => all-calls(rhs) + all-calls(body)

def all-calls-list(xs: List(Expr)) = match xs with
  | [] => 0
  | [h, .. t] => all-calls(h) + all-calls-list(t)

/// Number of calls in TAIL position within `e`, treating `e` itself as being in tail position (as a
/// function body is). A call's ARGUMENTS are never in tail position, so we count tail calls in the tail
/// sub-positions only; anything evaluated in a non-tail spot contributes 0 here.
def tail-calls(e: Expr) = match e with
  | Expr.Lit(_) => 0
  | Expr.Var(_) => 0
  | Expr.Call(_, _) => 1                          // this call is in tail position; its args are not (0)
  | Expr.Prim(_, _, _) => 0                        // the prim's result is returned, so neither operand is tail
  | Expr.If(_, t, f) => tail-calls(t) + tail-calls(f)   // both branches tail; condition is not
  | Expr.Let(_, body) => tail-calls(body)          // body is tail; rhs is not

/// Calls NOT in tail position (need a real stack frame).
def non-tail-calls(e: Expr) = all-calls(e) - tail-calls(e)

/// Does `e` (a function body) contain a tail call to function id `f`? — the condition for compiling that
/// function as a loop. Walks only the tail sub-positions, like `tail-calls`, matching on the callee id.
def has-tail-call-to(f: Int64, e: Expr) = match e with
  | Expr.Lit(_) => false
  | Expr.Var(_) => false
  | Expr.Call(callee, _) => callee == f
  | Expr.Prim(_, _, _) => false
  | Expr.If(_, t, f2) => has-tail-call-to(f, t) or has-tail-call-to(f, f2)
  | Expr.Let(_, body) => has-tail-call-to(f, body)

/// Is function id `self` self-tail-recursive in body `e`? (has a tail call to itself.)
def is-self-tail-recursive(self: Int64, e: Expr) = has-tail-call-to(self, e)

/// Builders.
def call0(f: Int64) = Expr.Call(f, [])
def n(k: Int64) = Expr.Lit(k)

@test
def tc-leaf-no-calls() =
  if all-calls(n(5)) == 0 then (if tail-calls(n(5)) == 0 then unit else trap("no tail calls")) else trap("no calls")

@test
def tc-bare-call-is-tail() =
  // f() alone is in tail position.
  if tail-calls(call0(1)) == 1 then (if all-calls(call0(1)) == 1 then unit else trap("one call")) else trap("bare call is tail")

@test
def tc-call-under-prim-not-tail() =
  // f() + 1 : the call is an operand of +, so NOT tail. 1 call total, 0 tail, 1 non-tail.
  let e = Expr.Prim(0, call0(1), n(1)) in
  if all-calls(e) == 1 then (if tail-calls(e) == 0 then (if non-tail-calls(e) == 1 then unit else trap("1 non-tail")) else trap("0 tail")) else trap("1 call")

@test
def tc-both-if-branches-are-tail() =
  // if c then f() else g() : both branches tail → 2 tail calls; condition has none. total 2.
  let e = Expr.If(n(0), call0(1), call0(2)) in
  if tail-calls(e) == 2 then (if all-calls(e) == 2 then unit else trap("2 calls")) else trap("2 tail")

@test
def tc-if-condition-call-not-tail() =
  // if h() then 1 else 2 : the call is the CONDITION → not tail. 1 call, 0 tail.
  let e = Expr.If(call0(9), n(1), n(2)) in
  if all-calls(e) == 1 then (if tail-calls(e) == 0 then unit else trap("condition call not tail")) else trap("1 call")

@test
def tc-let-body-tail-rhs-not() =
  // let x = f() in g() : rhs f() NOT tail, body g() IS tail. 2 calls, 1 tail, 1 non-tail.
  let e = Expr.Let(call0(1), call0(2)) in
  if all-calls(e) == 2 then (if tail-calls(e) == 1 then (if non-tail-calls(e) == 1 then unit else trap("1 non-tail")) else trap("1 tail")) else trap("2 calls")

@test
def tc-argument-calls-not-tail() =
  // f(g(), h()) : the OUTER f(...) is tail; the argument calls g(),h() are not. 3 calls total, 1 tail.
  let e = Expr.Call(1, [call0(2), call0(3)]) in
  if all-calls(e) == 3 then (if tail-calls(e) == 1 then (if non-tail-calls(e) == 2 then unit else trap("2 non-tail")) else trap("1 tail")) else trap("3 calls")

@test
def tc-self-tail-recursive-detected() =
  // body: if c then self() else base()  — self() (id 7) is a tail call to id 7 → self-tail-recursive.
  let body = Expr.If(n(0), call0(7), call0(8)) in
  if is-self-tail-recursive(7, body) then unit else trap("self() in a tail branch is self-tail-recursive")

@test
def tc-self-call-in-arg-not-tail-recursive() =
  // body: other(self()) — self() (id 7) is an ARGUMENT, not tail → NOT self-tail-recursive (even though
  // there is a call to 7 somewhere). has-tail-call-to walks only tail positions.
  let body = Expr.Call(8, [call0(7)]) in
  if is-self-tail-recursive(7, body) then trap("self in an argument is not a TAIL self-call") else unit

@test
def tc-self-call-under-prim-not-tail-recursive() =
  // body: self() + 1 — the classic NON-tail recursion (accumulate after the call) → not self-tail. This is
  // the case that does NOT become a loop without a rewrite.
  let body = Expr.Prim(0, call0(7), n(1)) in
  if is-self-tail-recursive(7, body) then trap("self() + 1 is not a tail call") else unit

export { all-calls, tail-calls, non-tail-calls, has-tail-call-to, is-self-tail-recursive }
