/// ty-bridge.cdz — the `Typed` ↔ `Ty` bridge (step (i) of the infer/unify → Ty convergence, divergence #3).
/// The pipeline type (`typed.cdz`) is `Typed = TIntW(Bool, Int64) | TBool | TErr | TFn(List(Typed), Typed) |
/// TSum(Int64)`; ty.cdz's canonical universe is `Ty = TyInt(IntType) | TyBool | TyErr | TyFn | TySum` where
/// `IntType = IntType(Sign, Width)` carries the 3-state orthogonal axes. This module converts between them, so
/// infer-db can decide type sameness/combining via ty.cdz's `ty-eq`/`unify-ty` (the shared unification)
/// WITHOUT a big-bang rewrite of `Typed` across the pipeline (lower-db/db.cdz/db-infer all key on `Typed`).
/// Keep `Typed` as the pipeline's internal/wire form + `Ty` as the semantic form the shared logic operates on,
/// bridging at the call site — the small, non-rippling convergence step.
///
/// DEFERRED-WIDTH note (item-3 HM): a `TIntW(_, 0)` is the DEFERRED-int sentinel (an unconstrained literal
/// width), which the live pipeline DOES produce. `typed-to-ty` here maps a `TIntW(s, w)` to a FIXED `Ty` int
/// (`ty-fixed-int`) — it is used on already-GROUNDED types (infer-db's `typed-to-ty-defer` handles the
/// deferred sentinel separately, mapping width 0 → a deferred `Ty`). `ty-to-typed` grounds any deferred `Ty`
/// int back to a concrete `Typed.TIntW` via `ground-default` (a shared-unify round-trip that may leave a
/// deferred comes back concrete). Bool/poison/fn/sum map straight across.

import { Typed } from "typed"
import { Ty, IntType, Sign, Width, ty-fixed-int, ground-default } from "ty"

/// `Typed` → `Ty`: a concrete `TIntW(signed, width)` → the fixed `Ty` int; TBool → TyBool; TErr → TyErr;
/// TFn → the shared Ty.TyFn (HO-2b, recursive over params + result).
def typed-to-ty(t: Typed) = match t with
  | Typed.TIntW(s, w) => ty-fixed-int(s, w)
  | Typed.TBool => Ty.TyBool
  | Typed.TErr => Ty.TyErr
  | Typed.TFn(ps, r) => Ty.TyFn(typed-list-to-ty(ps, 0), typed-to-ty(r))
  | Typed.TSum(nm) => Ty.TySum(nm)   // M2-b-2b-ii-c2: pipeline sum → shared sum (decl name-id carried across)

/// `Typed` param-list → `Ty` list, element-wise (index recursion) for typed-to-ty's TyFn arm.
def typed-list-to-ty(ps: List(Typed), i: Int64) =
  (if i == List.len(ps) then ([] : List(Ty))
   else (match List.at(ps, i) with
     | Option.Some(p) => List.concat(List.push([], typed-to-ty(p)), typed-list-to-ty(ps, i + 1))
     | Option.None(_) => typed-list-to-ty(ps, i + 1)))

/// `Ty` → `Typed`: a `TyInt` GROUNDED to concrete (deferred sign→signed, width→64 via ground-default) → its
/// `TIntW(signed, width)`; TyBool → TBool; TyErr → TErr; TyFn → Typed.TFn (HO-2b, recursive). Grounding first
/// means a `Ty` left partly-deferred by unification comes back as a concrete pipeline `Typed`.
def ty-to-typed(t: Ty) = match ground-default(t) with
  | Ty.TyInt(it) => (match it with | IntType.IntType(s, w) =>
      (let signed = (match s with | Sign.Signed => true | Sign.Unsigned => false | Sign.SignDef => true | Sign.SVar(_) => true) in  // ARC-A1: ground-default already maps a var→Signed, so this arm is post-grounding-unreachable; kept for totality
       (let width = (match w with | Width.WFixed(n) => n | Width.WidthDef => 64 | Width.WVar(_) => 64) in  // ARC-A1: ditto — ground-default maps var→WFixed(64)
        Typed.TIntW(signed, width))))
  | Ty.TyBool => Typed.TBool
  | Ty.TyErr => Typed.TErr
  // HIGHER-ORDER (HO-2b): the REAL bridge — a shared Ty.TyFn → the pipeline's Typed.TFn (recursive over params
  // + result), replacing HO-1's TErr stopgap so a fn value survives the Ty→Typed round-trip.
  | Ty.TyFn(ps, r) => Typed.TFn(ty-list-to-typed(ps, 0), ty-to-typed(r))
  | Ty.TySum(nm) => Typed.TSum(nm)   // M2-b-2b-ii-c2: shared sum → pipeline sum (decl-identity, no grounding)

/// `Ty` param-list → `Typed` list, element-wise (index recursion) for ty-to-typed's TFn arm.
def ty-list-to-typed(ps: List(Ty), i: Int64) =
  (if i == List.len(ps) then ([] : List(Typed))
   else (match List.at(ps, i) with
     | Option.Some(p) => List.concat(List.push([], ty-to-typed(p)), ty-list-to-typed(ps, i + 1))
     | Option.None(_) => ty-list-to-typed(ps, i + 1)))

// ---- TESTS: round-trip + cross-mapping -------------------------------------------------------------

import { ty-eq, ty-int64 } from "ty"

@test
def tb-typed-int-to-ty() =
  // TIntW(true,64) → Ty Int64 (ty-eq confirms the shape).
  (if ty-eq(typed-to-ty(Typed.TIntW(true, 64)), ty-int64()) then
     (if ty-eq(typed-to-ty(Typed.TIntW(false, 8)), ty-fixed-int(false, 8)) then unit else trap("UInt8 maps"))
   else trap("Int64 maps"))

@test
def tb-bool-and-err-across() =
  // TBool ↔ TyBool, TErr ↔ TyErr.
  (match typed-to-ty(Typed.TBool) with
    | Ty.TyBool => (match typed-to-ty(Typed.TErr) with | Ty.TyErr => unit | _ => trap("TErr→TyErr"))
    | _ => trap("TBool→TyBool"))

@test
def tb-ty-to-typed-int() =
  // Ty Int64 → TIntW(true,64); UInt8 → TIntW(false,8).
  (match ty-to-typed(ty-int64()) with
    | Typed.TIntW(s, w) => (if s then (if w == 64 then
        (match ty-to-typed(ty-fixed-int(false, 8)) with | Typed.TIntW(s2, w2) => (if (if s2 then false else true) and (w2 == 8) then unit else trap("UInt8 back")) | _ => trap("UInt8 is TIntW"))
      else trap("width 64")) else trap("signed"))
    | _ => trap("Int64 back to TIntW"))

@test
def tb-round-trip-concrete() =
  // Typed → Ty → Typed is identity for concrete ints/bool/err (the pipeline's types survive the bridge).
  (match ty-to-typed(typed-to-ty(Typed.TIntW(false, 16))) with
    | Typed.TIntW(s, w) => (if (if s then false else true) and (w == 16) then unit else trap("UInt16 round-trips"))
    | _ => trap("round-trip is TIntW"))

@test
def tb-deferred-ty-grounds-back() =
  // a DEFERRED Ty int (from unify leaving it unconstrained) → ty-to-typed GROUNDS it to Int64 (signed,64) —
  // so the pipeline never sees a deferred type (it has no such state).
  (match ty-to-typed(Ty.TyInt(IntType.IntType(Sign.SignDef, Width.WidthDef))) with
    | Typed.TIntW(s, w) => (if s then (if w == 64 then unit else trap("grounds to width 64")) else trap("grounds to signed"))
    | _ => trap("deferred grounds to TIntW"))

@test
def tb-partial-deferred-ty-grounds-per-axis() =
  // a PARTLY-deferred Ty int — the shape unify-ty leaves when only ONE axis grounds (e.g. a fixed-sign
  // deferred-width, or a fixed-width deferred-sign) — grounds PER-AXIS through the bridge: the fixed axis is
  // kept, the deferred one takes its default (sign→Signed, width→64). This is the exact `Ty` corrected-2b's
  // arith round-trip can hand `ty-to-typed`; the FULLY-deferred and FULLY-concrete cases were pinned, this
  // mixed case (the realistic post-unify residue) was not.
  (match ty-to-typed(Ty.TyInt(IntType.IntType(Sign.Unsigned, Width.WidthDef))) with   // UInt with deferred width
    | Typed.TIntW(s, w) => (if (if s then false else true) and (w == 64) then     // sign KEPT unsigned, width→64
        (match ty-to-typed(Ty.TyInt(IntType.IntType(Sign.SignDef, Width.WFixed(8)))) with  // deferred sign, width 8
          | Typed.TIntW(s2, w2) => (if s2 and (w2 == 8) then unit else trap("deferred-sign→Signed, width 8 kept"))
          | _ => trap("deferred-sign fixed-width is TIntW"))
      else trap("fixed-sign→Unsigned kept, deferred-width→64"))
    | _ => trap("partly-deferred grounds to TIntW"))

@test
def tb-fn-round-trips() =
  // HIGHER-ORDER (HO-2b): a function Typed survives Typed → Ty → Typed. Build (Int64) -> Bool as a TFn, cross
  // to Ty.TyFn, cross back, confirm the shape (1 param Int64, result Bool). Proves the real TyFn↔TFn bridge
  // (not HO-1's TErr stopgap).
  (let f = Typed.TFn(List.push([], Typed.TIntW(true, 64)), Typed.TBool) in
   (match ty-to-typed(typed-to-ty(f)) with
     | Typed.TFn(ps, r) => (match r with
         | Typed.TBool => (match List.at(ps, 0) with
             | Option.Some(Typed.TIntW(s, w)) => (if s and (w == 64) and (List.len(ps) == 1) then unit else trap("param Int64, arity 1"))
             | _ => trap("param 0 is TIntW"))
         | _ => trap("result Bool survives"))
     | _ => trap("fn round-trips to TFn (not TErr — real bridge)")))

@test
def tb-fn-to-ty-is-tyfn() =
  // typed-to-ty on a TFn produces a Ty.TyFn (not TErr) — the HO-1 stopgap is gone.
  (match typed-to-ty(Typed.TFn(List.push([], Typed.TIntW(true, 64)), Typed.TIntW(true, 64))) with
    | Ty.TyFn(_, _) => unit
    | _ => trap("TFn → Ty.TyFn (real bridge, not TErr stopgap)"))

@test
def tb-sum-round-trips() =
  // M2-b-2b-ii-c2: a sum type survives the Typed<->Ty bridge WITHOUT grounding or dropping — TSum(1) → TySum(1)
  // (forward), TySum(1) → TSum(1) (back), and the full round-trip preserves the decl name-id.
  (match typed-to-ty(Typed.TSum(1)) with
    | Ty.TySum(nm) => (if nm == 1 then
        (match ty-to-typed(Ty.TySum(1)) with
          | Typed.TSum(nb) => (if nb == 1 then
              (match ty-to-typed(typed-to-ty(Typed.TSum(1))) with
                | Typed.TSum(nc) => (if nc == 1 then unit else trap("round-trip keeps decl id"))
                | _ => trap("round-trip stays TSum"))
            else trap("TySum(1) → TSum(1) keeps id"))
          | _ => trap("TySum → TSum (back)"))
      else trap("TSum(1) → TySum(1) keeps id"))
    | _ => trap("TSum → TySum (forward, no grounding/drop)"))

export { typed-to-ty, ty-to-typed }
