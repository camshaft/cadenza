/// db-query-diff.cdz — the DIFFERENTIAL GUARD for the demand type_of spine: on the same parsed program, the
/// lazy demand spine (run-type-of, over the DbState group handler) must agree with the eager reference walk
/// (type-at, over infer-tree's whole-column build). This is the precondition for the eventual live-pipeline
/// flip (routing ty-of-db through the demand spine) — it pins that the spine computes the SAME type the
/// established walk does, node-shape by node-shape, so a flip cannot silently change a verdict.
///
/// The checks are INLINED per @test rather than factored into a shared agree-int/agree-bool helper: a helper
/// that composes run-type-of (the DbState group) with type-at (the eager walk), when called from TWO OR MORE
/// tests, trips a monomorphizer bug (CDZ0102 "parameter id bound more than once" — the source is linear, cdz
/// check is clean; filed to the compiler owner with a minimal two-helper repro). Inlined per test, the spine
/// and the walk compose in one component cleanly. Each test computes both types over the same parsed tree and
/// asserts they agree.
import { run-type-of } from "db-query-perfield"
import { type-at } from "infer-db"
import { Tok, parse-tokens } from "parse-db"
import { db-of } from "db"
import { Ty } from "ty"
import { is-int-ty } from "ty"
import { resolve-into-db } from "db-resolve"

@test
def diff-arith-agrees-int() =
  // `1 + 2`: spine and eager walk must BOTH type the root as an int.
  match parse-tokens([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2)]) with
    | (root, tree) => (let db = resolve-into-db(db-of(tree), root) in
        (let s = is-int-ty(run-type-of(db, root)) in (match type-at(tree, root, root) with
          | Option.Some(t) => (if s and is-int-ty(t) then unit else trap("spine and walk disagree on arith int-ness"))
          | Option.None(_) => trap("eager walk gave no type at the arith root"))))

@test
def diff-nested-arith-agrees-int() =
  // `1 + 2 * 3`: a deeper tree still agrees (both int).
  match parse-tokens([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2), Tok.TOp(42), Tok.TNum(3)]) with
    | (root, tree) => (let db = resolve-into-db(db-of(tree), root) in
        (let s = is-int-ty(run-type-of(db, root)) in (match type-at(tree, root, root) with
          | Option.Some(t) => (if s and is-int-ty(t) then unit else trap("spine and walk disagree on nested-arith int-ness"))
          | Option.None(_) => trap("eager walk gave no type at the nested-arith root"))))

@test
def diff-single-literal-agrees-int() =
  // a bare literal `7`: both int.
  match parse-tokens([Tok.TNum(7)]) with
    | (root, tree) => (let db = resolve-into-db(db-of(tree), root) in
        (let s = is-int-ty(run-type-of(db, root)) in (match type-at(tree, root, root) with
          | Option.Some(t) => (if s and is-int-ty(t) then unit else trap("spine and walk disagree on literal int-ness"))
          | Option.None(_) => trap("eager walk gave no type at the literal root"))))

@test
def diff-comparison-agrees-bool() =
  // `1 < 2`: BOTH must type the root as Bool (the spine's combine-bin returns TyBool for a relational op; the
  // eager walk's bin-type does too). This is the one non-int shape — it guards that the spine agrees on Bool,
  // not just int.
  match parse-tokens([Tok.TNum(1), Tok.TOp(60), Tok.TNum(2)]) with
    | (root, tree) => (let db = resolve-into-db(db-of(tree), root) in
        (let sBool = (match run-type-of(db, root) with | Ty.TyBool => true | _ => false) in
         (match type-at(tree, root, root) with
           | Option.Some(Ty.TyBool) => (if sBool then unit else trap("eager walk says Bool but the spine does not"))
           | _ => trap("eager walk says the comparison root is not Bool"))))
