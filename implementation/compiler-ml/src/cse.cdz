/// cse.cdz — COMMON-SUBEXPRESSION detection over an arithmetic expression language, the analysis half of
/// common-subexpression elimination (CSE) / hash-consing. A compiler that shares equal subterms first has
/// to KNOW which subterms are equal; this module answers that by structural hashing (the congruence
/// `hash.cdz` provides — equal shapes hash equal) and counting DISTINCT subterms.
///
/// The key numbers a CSE pass reads:
///   - `node-count e` — total subexpressions if NOTHING is shared (the naive tree size).
///   - `distinct-count e` — subexpressions AFTER hash-consing (each structurally-distinct subterm counted
///     once). This is the size of the shared DAG a CSE pass would build.
///   - `savings e` = node-count − distinct-count — how many nodes CSE eliminates by sharing.
///   - `has-sharing e` — whether ANY subterm repeats (distinct < total), i.e. CSE would help.
///
/// A subterm is keyed by its structural HASH (the same rolling polynomial `hash.cdz` uses: congruent, so
/// `(1+2)` appearing twice hashes once). Distinct hashes are accumulated in a `Set(Int64)` threaded through
/// the recursion — so `distinct-count` is `Set.len` of every subterm's hash. (Hash collisions between
/// distinct shapes would under-count; the polynomial mix makes that vanishingly unlikely for the small
/// trees a corpus test builds, and a real pass confirms a hash match with a structural `==`.)

type Ex =
  | Num(Int64)
  | Var(Int64)          // a variable, keyed by an Int64 id (so distinct vars are distinct subterms)
  | Add(Ex, Ex)
  | Mul(Ex, Ex)

/// The rolling-hash mix step (`hash.cdz`'s `mix`): `acc * 31 + v`, kept within Int64.
def mix(acc: Int64, v: Int64) = acc * 31 + v

/// The structural hash: a distinct tag per constructor, then the payload / children mixed left to right.
/// Congruent — two structurally-equal `Ex` hash equal, and element ORDER matters (`a+b` ≠ `b+a`).
def hash(e: Ex) = match e with
  | Ex.Num(n) => mix(1, n)
  | Ex.Var(id) => mix(2, id)
  | Ex.Add(l, r) => mix(mix(3, hash(l)), hash(r))
  | Ex.Mul(l, r) => mix(mix(5, hash(l)), hash(r))

/// Total subexpression count — the tree size if no sharing happened (every node counted every time).
def node-count(e: Ex) = match e with
  | Ex.Num(_) => 1
  | Ex.Var(_) => 1
  | Ex.Add(l, r) => 1 + node-count(l) + node-count(r)
  | Ex.Mul(l, r) => 1 + node-count(l) + node-count(r)

/// Accumulate the hash of every subterm (this node and all descendants) into `seen`.
/// Bottom-up in ONE traversal: returns `(hash of e, seen ∪ {every subterm hash})`. Each node's hash is
/// computed once from its CHILDREN's already-computed hashes (`mix(tag, hl, hr)`), never by re-traversing
/// the subtree — so the whole analysis is O(n), not O(n²). (A prior version called `hash(e)` at every
/// node, and `hash` re-walks the subtree → quadratic; Copilot PR #441.)
def collect(e: Ex, seen: Set(Int64)) = match e with
  | Ex.Num(m) => (let h = mix(1, m) in (h, Set.insert(seen, h)))
  | Ex.Var(id) => (let h = mix(2, id) in (h, Set.insert(seen, h)))
  | Ex.Add(l, r) => (match collect(l, seen) with | (hl, s1) =>
    (match collect(r, s1) with | (hr, s2) => (let h = mix(mix(3, hl), hr) in (h, Set.insert(s2, h)))))
  | Ex.Mul(l, r) => (match collect(l, seen) with | (hl, s1) =>
    (match collect(r, s1) with | (hr, s2) => (let h = mix(mix(5, hl), hr) in (h, Set.insert(s2, h)))))

/// The number of structurally-DISTINCT subterms — the size of the hash-consed DAG.
def distinct-count(e: Ex) = match collect(e, Set.of([])) with | (_, seen) => Set.len(seen)

/// How many nodes CSE eliminates by sharing equal subterms (total − distinct).
def savings(e: Ex) = node-count(e) - distinct-count(e)

/// Does any subterm repeat? (CSE would help iff distinct < total.)
def has-sharing(e: Ex) = distinct-count(e) < node-count(e)

/// Builders (test ergonomics).
def n(k: Int64) = Ex.Num(k)
def v(id: Int64) = Ex.Var(id)

@test
def cse-leaf-distinct-one() =
  // a single leaf: 1 node, 1 distinct, no sharing.
  if distinct-count(n(5)) == 1 then
    (if node-count(n(5)) == 1 then (if has-sharing(n(5)) then trap("a leaf shares nothing") else unit) else trap("1 node"))
  else trap("1 distinct")

@test
def cse-no-sharing-flat() =
  // 1 + 2 : {1, 2, Add} — 3 nodes, 3 distinct, no sharing.
  let e = Ex.Add(n(1), n(2)) in
  if node-count(e) == 3 then (if distinct-count(e) == 3 then (if has-sharing(e) then trap("distinct leaves") else unit) else trap("3 distinct")) else trap("3 nodes")

@test
def cse-detects-repeated-subterm() =
  // (1+2) * (1+2) : total nodes = 1(Mul) + 3(left Add) + 3(right Add) = 7, but the two (1+2) are equal,
  // so distinct = {1, 2, Add(1,2), Mul} = 4. savings = 3. This is the canonical CSE win.
  let a = Ex.Add(n(1), n(2)) in
  let e = Ex.Mul(a, a) in
  if node-count(e) == 7 then
    (if distinct-count(e) == 4 then
      (if savings(e) == 3 then (if has-sharing(e) then unit else trap("has sharing")) else trap("savings 3"))
    else trap("4 distinct"))
  else trap("7 nodes")

@test
def cse-repeated-variable() =
  // x + x (x = Var 0) : {Var0, Add} = 2 distinct, 3 total, savings 1.
  let e = Ex.Add(v(0), v(0)) in
  if distinct-count(e) == 2 then (if node-count(e) == 3 then (if savings(e) == 1 then unit else trap("savings 1")) else trap("3 nodes")) else trap("2 distinct")

@test
def cse-distinct-variables-not-shared() =
  // x + y (Var 0, Var 1) : distinct vars are distinct subterms → {Var0, Var1, Add} = 3, no sharing.
  let e = Ex.Add(v(0), v(1)) in
  if distinct-count(e) == 3 then (if has-sharing(e) then trap("distinct vars don't share") else unit) else trap("3 distinct")

@test
def cse-order-sensitive() =
  // (1+2) and (2+1) are DIFFERENT subterms (order matters): Add(Add(1,2), Add(2,1)). The two Add subtrees
  // do NOT share (distinct hashes) — the tell is distinct-count 5, not 4 (which is what it would be if
  // `a+b` collapsed to `b+a`). The leaves 1,2 DO recur across both sub-Adds, so distinct = {1, 2,
  // Add(1,2), Add(2,1), outer Add} = 5 while total nodes = 7 (the leaf sharing is real; only the Adds are
  // order-distinct).
  let e = Ex.Add(Ex.Add(n(1), n(2)), Ex.Add(n(2), n(1))) in
  if distinct-count(e) == 5 then unit else trap("a+b and b+a are order-distinct → 5 distinct, not 4")

@test
def cse-nested-sharing() =
  // let a = (1+2); ((a*a) + (a*a)) — a*a repeats, and a repeats within it. Distinct subterms:
  // {1, 2, Add(1,2)=a, Mul(a,a), Add(Mul,Mul)=outer} = 5. Total nodes: outer Add(1) + two (a*a) subtrees
  // each = Mul(1)+a(3)+a(3)=7 → 1 + 7 + 7 = 15. savings = 10.
  let a = Ex.Add(n(1), n(2)) in
  let aa = Ex.Mul(a, a) in
  let e = Ex.Add(aa, aa) in
  if distinct-count(e) == 5 then
    (if node-count(e) == 15 then (if savings(e) == 10 then unit else trap("savings 10")) else trap("15 nodes"))
  else trap("5 distinct")

@test
def cse-partial-sharing() =
  // (1+2) * (1+3) : the two Adds differ, but both contain Num 1. distinct: {1, 2, 3, Add(1,2), Add(1,3),
  // Mul} = 6; total = 1 + 3 + 3 = 7; savings = 1 (the shared Num 1).
  let e = Ex.Mul(Ex.Add(n(1), n(2)), Ex.Add(n(1), n(3))) in
  if distinct-count(e) == 6 then (if savings(e) == 1 then unit else trap("savings 1")) else trap("6 distinct")

@test
def cse-congruence-across-positions() =
  // The SAME shape in two different structural positions still hashes equal (congruence): (1+2) as a
  // left operand and as a right operand share. ((1+2) * 9) + (1+2): distinct {1,2,Add(1,2),9,Mul,outer}
  // = 6; total = outer(1) + Mul(1)+Add(3)+9(1)=5 + Add(3) = 1+5+3 = 9; savings = 3.
  let a = Ex.Add(n(1), n(2)) in
  let e = Ex.Add(Ex.Mul(a, n(9)), a) in
  if distinct-count(e) == 6 then (if node-count(e) == 9 then (if savings(e) == 3 then unit else trap("savings 3")) else trap("9 nodes")) else trap("6 distinct")

export { hash, node-count, distinct-count, savings, has-sharing }
