/// sread-eval-params.cdz — split from sread-eval.cdz (throughput: shrink the heavy >300s run-src file below
/// the per-file gate cap; xtask suite_timeout_for names the v-compiler-ml file-split as the in-lane fix). Holds
/// the PARAMETER / CALL / narrow-width / over-application / decline / typed-flag cohort of the end-to-end
/// source-in run-src pins; the core literals/arith/if/let cohort + the run-src engine stay in sread-eval.cdz.
/// Same run-src/run-src-typed engine (imported), so every @test here is behavior-identical to before the split.
import { run-src, run-src-typed } from "sread-eval"

@test
def se-single-param-call() =
  // ★ slice-3c PAYOFF, FROM SOURCE ★ — a SINGLE-PARAM function call: `(def (f n) (+ n 1))` called `(f 41)` → 42.
  // Full pipeline: sread reads the param def + the call NApp(bodyId, argId) → resolve binds the body's `n` to
  // the param node → infer types the param as the arg's type → lower builds CLet(param, argCore, bodyCore) →
  // eval binds arg to param + evals the body. Differential-verified vs rcdzc (`def f(n)=n+1; f(41)` → 42).
  match run-src("(do (def (f n) (+ n 1)) (def (main) (f 41)) (export main))") with
    | Option.Some(v) => if v == 42 then unit else trap("(f 41) where f(n)=n+1 → 42")
    | Option.None(_) => trap("a single-param call runs end-to-end")

@test
def se-single-param-call-uses-arg() =
  // the arg FLOWS: `(def (double n) (+ n n))` called `(double 21)` → 42 (proves the arg binds the param, not a
  // constant). A different arg → a different result: pins the param is genuinely substituted, not ignored.
  match run-src("(do (def (double n) (+ n n)) (def (main) (double 21)) (export main))") with
    | Option.Some(v) => if v == 42 then unit else trap("(double 21) → 42 (arg flows to param)")
    | Option.None(_) => trap("a param call substitutes its arg")

@test
def se-typed-param-call() =
  // slice-3c TYPED param: `(def (f (: n Int64)) (+ n 1))` called `(f 41)` → 42. sread reads the typed-param
  // signature `(: n Int64)` (param name `n` as the binder, the Type skipped — the arg's type flows via infer),
  // then the SAME param-call wiring as the untyped case. This is the canonical corpus param shape
  // `(def (main (: x Int64)) x)`. Differential: rcdzc `def f(n: Int64) = n+1; f(41)` → 42.
  match run-src("(do (def (f (: n Int64)) (+ n 1)) (def (main) (f 41)) (export main))") with
    | Option.Some(v) => if v == 42 then unit else trap("typed param (f 41) → 42")
    | Option.None(_) => trap("a typed-param call runs end-to-end")

@test
def se-narrow-param-out-of-range-declines() =
  // ★ NARROW-INT ENFORCEMENT, FROM SOURCE ★ (corpus 09-functions CDZ0302): `(def (f (: a Int8)) a)` called
  // `(f 200)` → DECLINES. 200 is out of Int8 (-128..127), so the param annotation constrains the constant arg
  // exactly as a direct `(: 200 Int8)` does — the arg does NOT get β-reduced into the body and laundered to a
  // wide 200. Before this slice the ML compiler DISCARDED the param type and ran to 200 (a wrong VALUE
  // disagreeing with rcdzc). Now infer's param-fit-ok fails → TErr → None. Differential-verified vs rcdzc CDZ0302.
  match run-src("(do (def (f (: a Int8)) a) (def (main) (f 200)) (export main))") with
    | Option.None(_) => unit
    | Option.Some(_) =>
      trap("(f 200) to an Int8 param MUST decline (200 out of Int8 range — CDZ0302)")

@test
def se-narrow-param-in-range-runs() =
  // the BOUNDARY is sharp: an IN-range constant to the SAME narrow param runs. `(f 100)` with an Int8 param →
  // 100 (100 fits Int8). Pins that the enforcement rejects ONLY the out-of-range constant, not every narrow
  // param — the companion to the decline case (differential: rcdzc `f(100)` → 100).
  match run-src("(do (def (f (: a Int8)) a) (def (main) (f 100)) (export main))") with
    | Option.Some(v) => if v == 100 then unit else trap("(f 100) Int8 → 100")
    | Option.None(_) => trap("an in-range constant to a narrow param runs")

@test
def se-narrow-body-arith-overflow-declines() =
  // ★ NARROW-INT ENFORCEMENT CDZ0304, FROM SOURCE ★ (corpus 09-functions): `(def (f (: a Int8)) (+ a a))`
  // called `(f 100)` → DECLINES. The ARG 100 fits Int8 (in-range), but the BODY `(+ a a)` = 200 OVERFLOWS
  // Int8 (max 127). The param's declared Int8 type now DRIVES the body: `a` is Int8, so `(+ a a)` is Int8
  // arith → lower stamps a narrow CBin → eval's overflow-trap fires → None. Before this the param took the
  // arg's default Int64 type, so `(+ a a)` was Int64 arith that never overflow-checked and laundered 200 (a
  // wrong VALUE). Differential-verified vs rcdzc CDZ0304 (a compile-provable narrow overflow = ConstTrap).
  match run-src("(do (def (f (: a Int8)) (+ a a)) (def (main) (f 100)) (export main))") with
    | Option.None(_) => unit
    | Option.Some(_) =>
      trap("(+ a a) on an Int8 param fed 100 = 200 OVERFLOWS Int8 → must decline (CDZ0304)")

@test
def se-narrow-body-arith-in-range-runs() =
  // the sharp companion: an in-range body result RUNS. `(f 50)` → `(+ a a)` = 100, which FITS Int8 → 100.
  // Pins the overflow trap fires ONLY on the actual overflow, not on every narrow-body arith.
  match run-src("(do (def (f (: a Int8)) (+ a a)) (def (main) (f 50)) (export main))") with
    | Option.Some(v) => if v == 100 then unit else trap("(f 50) → (+ a a) = 100 fits Int8 → 100")
    | Option.None(_) => trap("an in-range narrow-body arith runs")

@test
def se-wide-body-arith-no-false-overflow() =
  // REGRESSION GUARD: an Int64 param's body arith must NOT false-trap. `(def (f (: n Int64)) (+ n n))` `(f
  // 100)` → 200 (width 64 never overflow-checks — the CDZ0304 trap is narrow-only). Pins the enforcement
  // doesn't leak into the wide default (the param-bind-type width-64 path stays plain Int64 arith).
  match run-src("(do (def (f (: n Int64)) (+ n n)) (def (main) (f 100)) (export main))") with
    | Option.Some(v) =>
      if v == 200 then unit else trap("(f 100) Int64 → (+ n n) = 200 (no overflow at width 64)")
    | Option.None(_) => trap("a wide (Int64) body arith must not false-decline")

@test
def se-over-application-typed-declines() =
  // ARITY (corpus 09-functions:1988 → CDZ0203): over-applying a unary function by an EXTRA arg is a type
  // error. `(def (f (: x Int64)) (+ x 1))` called `(f 5 9)` applies the 1-param `f` to TWO args → DECLINES.
  // The 2nd arg has no param2 (infer-param2 → None → the call is TErr; lower declines) — already correct, now
  // WITNESSED so a future multi-param change can't silently accept an over-application. Differential vs rcdzc.
  match run-src("(do (def (f (: x Int64)) (+ x 1)) (def (main) (f 5 9)) (export main))") with
    | Option.None(_) => unit
    | Option.Some(_) => trap("(f 5 9) over-applies a 1-param f → must decline (CDZ0203 arity)")

@test
def se-over-application-untyped-declines() =
  // the untyped companion (corpus's `(def (f x) (+ x 1))` form): `(f 5 9)` to an untyped unary `f` also
  // declines — arity is checked regardless of whether the param is annotated. Pins both spellings.
  match run-src("(do (def (f x) (+ x 1)) (def (main) (f 5 9)) (export main))") with
    | Option.None(_) => unit
    | Option.Some(_) => trap("(f 5 9) over-applies an untyped 1-param f → must decline")

@test
def se-param-passed-as-arg() =
  // slice-3c COMPOSITION fix: a param used as the ARG to another call — `(def (f n) (g n))`, `g(m) = m*2`,
  // `(f 21)` → 42. The call's ARGUMENT resolves in the CALLER's scope (where `n` = f's param is bound), while
  // the callee body resolves lexically. Before the resolve-arg fix, the NApp arm resolved only the callee body,
  // NOT the arg, so the arg's `n` was left unresolved → infer TErr → decline. Differential-verified vs rcdzc.
  match run-src("(do (def (g m) (* m 2)) (def (f n) (g n)) (def (main) (f 21)) (export main))") with
    | Option.Some(v) => if v == 42 then unit else trap("(def (f n) (g n)) (f 21) → 42")
    | Option.None(_) => trap("a param passed as an arg to another call runs")

@test
def se-nested-call-as-arg() =
  // a CALL whose arg is itself a CALL — `(f (g 20))`, `g(m)=m+1`, `f(n)=n*2` → 42. The inner call `(g 20)`
  // resolves as the outer call's arg (in the caller's scope). Same resolve-arg fix. Differential-verified.
  match run-src(
      "(do (def (g m) (+ m 1)) (def (f n) (* n 2)) (def (main) (f (g 20))) (export main))"
    ) with
    | Option.Some(v) => if v == 42 then unit else trap("(f (g 20)) → 42 (nested call as arg)")
    | Option.None(_) => trap("a call whose arg is a call runs")

@test
def se-corpus-underscore-param-call() =
  // THE EXACT CORPUS PROGRAM (spec/semantics/01-literals.sexp): `(do (def (f _1) (+ _1 1)) (def (main) (f 41))
  // (export main))` → 42. Combines the `_`-led param name `_1` (is-alpha `_` fix) with the single untyped-param
  // call wiring — the two compose for the real corpus shape. Differential-verified vs rcdzc. This is the
  // headline conformance case for user functions with an argument, byte-for-byte from the corpus.
  match run-src("(do (def (f _1) (+ _1 1)) (def (main) (f 41)) (export main))") with
    | Option.Some(v) =>
      if v == 42 then unit else trap("corpus (def (f _1) (+ _1 1)) called (f 41) → 42")
    | Option.None(_) => trap("the corpus _1-param function call runs end-to-end")

@test
def se-two-param-call() =
  // ★ slice-3d PAYOFF ★ — a TWO-argument function call: `(def (add a b) (+ a b))` called `(add 40 2)` → 42.
  // Full pipeline: sread reads both args (NApp(bodyId, arg1) + arg2-table entry) → resolve binds BOTH params
  // in the body scope + resolves both args in the caller scope → infer types both params from the args → lower
  // builds the NESTED CLet(param1, arg1, CLet(param2, arg2, body)) → eval binds both, evals. Differential vs rcdzc.
  match run-src("(do (def (add a b) (+ a b)) (def (main) (add 40 2)) (export main))") with
    | Option.Some(v) => if v == 42 then unit else trap("(add 40 2) where add(a,b)=a+b → 42")
    | Option.None(_) => trap("a two-argument call runs end-to-end")

@test
def se-two-param-call-both-used() =
  // both args FLOW to distinct params: `(def (sub a b) (- a b))` called `(sub 50 8)` → 42 (order matters —
  // proves arg1→param1, arg2→param2, not swapped/duplicated). Differential-verified vs rcdzc.
  match run-src("(do (def (sub a b) (- a b)) (def (main) (sub 50 8)) (export main))") with
    | Option.Some(v) => if v == 42 then unit else trap("(sub 50 8) → 42 (arg order preserved)")
    | Option.None(_) => trap("a two-arg call binds args to params in order")

@test
def se-bool-param-call() =
  // a single param used in a BOOLEAN position: `(def (f b) (if b 1 0))` called `(f true)` → 1. Pins that a
  // param flows through the whole pipeline with a Bool type (infer types the param as the arg's type = Bool,
  // resolve binds it, lower/eval the if). Differential-verified vs rcdzc. Complements the arithmetic param tests.
  match run-src("(do (def (f b) (if b 1 0)) (def (main) (f true)) (export main))") with
    | Option.Some(v) => if v == 1 then unit else trap("(f true) where f(b)=if b 1 0 → 1")
    | Option.None(_) => trap("a bool-typed param call runs end-to-end")

@test
def se-param-in-comparison-call() =
  // a param feeding a COMPARISON (a Bool-RESULT body): `(def (f n) (< n 10))` called `(f 5)` → true (1). The
  // call's result type is Bool (the body's comparison type), not the param's Int — pins the body-type flow.
  match run-src("(do (def (f n) (< n 10)) (def (main) (f 5)) (export main))") with
    | Option.Some(v) => if v == 1 then unit else trap("(f 5) where f(n)=(< n 10) → true")
    | Option.None(_) => trap("a param-in-comparison call runs end-to-end")

@test
def se-unbound-declines() =
  // a bare unbound var → None (declined), NOT a value: the differential must see decline, not a bogus value.
  match run-src("y") with
    | Option.None(_) => unit
    | Option.Some(_) => trap("unbound y declines")

@test
def se-unsupported-declines() =
  // an OUT-OF-SUBSET lead (a string literal) → None (declined). Reader recovery = unbound NVar → TErr → None,
  // NOT an NLit-0 that would fabricate a value and falsely disagree with rcdzc.
  match run-src("\"hello\"") with
    | Option.None(_) => unit
    | Option.Some(_) => trap("string literal declines")

@test
def se-digit-separator-declines() =
  // `1_000_000` is a DIGIT-SEPARATOR literal this subset doesn't support — it must DECLINE, NOT read the
  // prefix `1` (which would falsely differ from rcdzc's 1000000). The token-boundary guard catches it.
  match run-src("1_000_000") with
    | Option.None(_) => unit
    | Option.Some(_) => trap("1_000_000 declines, not value 1")

@test
def se-trailing-junk-declines() =
  // `123abc` is malformed (rcdzc rejects it) — must DECLINE, not read `123` and ignore the trailing letters.
  match run-src("123abc") with
    | Option.None(_) => unit
    | Option.Some(_) => trap("123abc declines, not value 123")

// NOTE: the "a CLEAN int literal still runs" boundary-guard regression (the guard rejects only non-clean
// endings) is covered by `se-int-literal` in sread-eval.cdz (this file's engine file, post-split — same
// `run-src("42")` → 42); the former `se-plain-int-still-runs` was a byte-identical duplicate compile, removed
// to cut the suite's run-src compile cost (each run-src @test re-runs the full in-guest compile pipeline —
// read-source→resolve→infer→lower→eval — at test time; the test FILE is compiled to a component once, so the
// repeated cost is the in-guest pipeline, not a separate per-@test wasm build. Was head-of-line-blocking the gate).
@test
def se-typed-int-flag() =
  // an INT-valued program tags isBool=0 (renders as a bare scalar).
  match run-src-typed("42") with
    | Option.Some((v, b)) => if v == 42 and b == 0 then unit else trap("42 int flag=0")
    | Option.None(_) => trap("typed int runs")

@test
def se-typed-bool-flag() =
  // a COMPARISON program is Bool-typed → isBool=1, value 1 (so the caller renders `true`, not `1`).
  match run-src-typed("(< 1 2)") with
    | Option.Some((v, b)) => if v == 1 and b == 1 then unit else trap("1<2 bool flag=1")
    | Option.None(_) => trap("typed bool runs")

@test
def se-typed-bool-false-flag() =
  // a false comparison → isBool=1, value 0 (caller renders `false`).
  match run-src-typed("(< 5 2)") with
    | Option.Some((v, b)) => if v == 0 and b == 1 then unit else trap("5<2 bool flag=1 val=0")
    | Option.None(_) => trap("typed bool false runs")

@test
def se-typed-declines() =
  // an out-of-subset / unbound program declines under the typed query too (None, not a fabricated tuple).
  match run-src-typed("y") with
    | Option.None(_) => unit
    | Option.Some(_) => trap("typed unbound declines")
