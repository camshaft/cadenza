/// licm.cdz — LOOP-INVARIANT CODE MOTION: hoist a computation OUT of a loop body into its preheader when
/// the computation produces the same value on every iteration. This is the payoff of the control-flow
/// analyses (loops.cdz finds the body; this decides what may leave it). A loop body is modeled as an
/// ordered list of assignments `x := e`; the transform partitions them into the statements that hoist and
/// those that stay.
///
/// A statement `x := e` is LOOP-INVARIANT (safe to hoist) when BOTH hold:
///   1. every variable `e` READS is defined OUTSIDE the loop — i.e. none of its reads is assigned by any
///      statement in the loop body (a read of a loop-defined var can change per iteration), AND
///   2. `e` is PURE — trap-free and effect-free (hoisting a `Div` that traps would move WHERE the trap
///      happens, or run it when the loop body might not have; hoisting a `Read`/`Call` would reorder an
///      effect). This is the purity condition purity.cdz formalizes.
///
/// Note the CONSERVATISM: a first pass only hoists statements invariant w.r.t. the loop's def set. A
/// statement reading a var defined by an ALREADY-hoisted statement is also invariant, but catching it
/// needs iteration to a fixpoint — modeled here by `hoist-fixpoint` (repeat until nothing new hoists).
///
///   - `is-invariant defs s`  — statement `s` is invariant given the loop's def set (reads-outside + pure).
///   - `loop-defs body`       — the set of variables the loop body assigns.
///   - `hoist body`           — one pass: `(hoisted, remaining)` split of the body.
///   - `hoist-fixpoint body`  — iterate `hoist` until no more statements move.

type Expr =
  | Lit(Int64)
  | Ref(Int64)
  | Bin(Expr, Expr)     // a pure binary op over two sub-expressions
  | Div(Expr, Expr)     // may trap → NOT pure, never hoistable
  | Load(Int64)         // a memory/effectful read → NOT pure, never hoistable

type Stmt =
  | Assign(Int64, Expr)

/// The variables `e` reads.
def reads(e: Expr, acc: Set(Int64)) = match e with
  | Expr.Lit(_) => acc
  | Expr.Ref(x) => Set.insert(acc, x)
  | Expr.Bin(l, r) => reads(r, reads(l, acc))
  | Expr.Div(l, r) => reads(r, reads(l, acc))
  | Expr.Load(_) => acc

/// Is `e` pure — trap-free and effect-free (so hoisting cannot change observable behavior)?
def is-pure(e: Expr) = match e with
  | Expr.Lit(_) => true
  | Expr.Ref(_) => true
  | Expr.Bin(l, r) => is-pure(l) and is-pure(r)
  | Expr.Div(_, _) => false
  | Expr.Load(_) => false

/// The set of variables assigned anywhere in the loop body.
def loop-defs(body: List(Stmt), acc: Set(Int64)) = match body with
  | [] => acc
  | [s, .. rest] => (match s with | Stmt.Assign(d, _) => loop-defs(rest, Set.insert(acc, d)))

def all-outside(rs: List(Int64), defset: Set(Int64)) = match rs with
  | [] => true
  | [h, .. t] => if Set.contains(defset, h) then false else all-outside(t, defset)

/// Is statement `s` loop-invariant given the loop's `defset` — reads only outside-defined vars AND pure?
def is-invariant(defset: Set(Int64), s: Stmt) = match s with
  | Stmt.Assign(_, e) => is-pure(e) and all-outside(Set.to-list(reads(e, Set.of([]))), defset)

/// One hoisting pass: split `body` into (hoisted, remaining) w.r.t. the loop's def set. A statement whose
/// RHS is invariant against the WHOLE loop's defs moves out; the rest stay.
def hoist(body: List(Stmt)) =
  let defset = loop-defs(body, Set.of([])) in
  partition(body, defset, [], [])

def partition(body: List(Stmt), defset: Set(Int64), hoisted: List(Stmt), kept: List(Stmt)) = match body with
  | [] => (hoisted, kept)
  | [s, .. rest] =>
    if is-invariant(defset, s)
    then partition(rest, defset, List.push(hoisted, s), kept)
    else partition(rest, defset, hoisted, List.push(kept, s))

/// Iterate `hoist` to a fixpoint: after moving the first round of invariants out, the REMAINING body has a
/// smaller def set, so statements that read a now-hoisted var become invariant. Repeat until a pass hoists
/// nothing. Returns `(all-hoisted, final-remaining)`. `fuel` bounds the iteration (≤ body length).
def hoist-fixpoint(body: List(Stmt)) = hf(body, [], List.len(body))

def hf(body: List(Stmt), acc-hoisted: List(Stmt), fuel: Int64) =
  if fuel <= 0 then (acc-hoisted, body)
  else (match hoist(body) with | (h, kept) =>
    (match h with
      | [] => (acc-hoisted, body)                              // nothing moved → fixpoint
      | _ => hf(kept, List.concat(acc-hoisted, h), fuel - 1)))

def stmt-count(xs: List(Stmt)) = List.len(xs)

/// Builders.
def r(x: Int64) = Expr.Ref(x)
def lit(k: Int64) = Expr.Lit(k)
def asg(d: Int64, e: Expr) = Stmt.Assign(d, e)

@test
def licm-hoists-outside-read() =
  // x := a + b, reads {a,b} outside the loop (loop only defs x) → invariant → hoisted.
  let body = [asg(0, Expr.Bin(r(10), r(11)))] in
  (match hoist(body) with | (h, kept) => (if stmt-count(h) == 1 then (if stmt-count(kept) == 0 then unit else trap("nothing kept")) else trap("one hoisted")))

@test
def licm-keeps-loop-dependent() =
  // i := i + 1 : reads i, which the loop defines → NOT invariant → kept.
  let body = [asg(0, Expr.Bin(r(0), lit(1)))] in
  (match hoist(body) with | (h, kept) => (if stmt-count(h) == 0 then (if stmt-count(kept) == 1 then unit else trap("one kept")) else trap("nothing hoisted")))

@test
def licm-keeps-impure-div() =
  // x := a / b : reads {a,b} outside, BUT Div may trap → not pure → NOT hoisted (moving the trap is unsafe).
  let body = [asg(0, Expr.Div(r(10), r(11)))] in
  (match hoist(body) with | (h, _) => (if stmt-count(h) == 0 then unit else trap("a trapping Div is not hoisted")))

@test
def licm-keeps-impure-load() =
  // x := load(addr) : an effectful read → not hoisted even though addr is a literal.
  let body = [asg(0, Expr.Load(99))] in
  (match hoist(body) with | (h, _) => (if stmt-count(h) == 0 then unit else trap("a Load is not hoisted")))

@test
def licm-mixed-body() =
  // t := a + b (invariant, hoist) ; i := i + 1 (loop-carried, keep). one out, one in.
  let body = [asg(0, Expr.Bin(r(10), r(11))), asg(1, Expr.Bin(r(1), lit(1)))] in
  (match hoist(body) with | (h, kept) => (if stmt-count(h) == 1 then (if stmt-count(kept) == 1 then unit else trap("one kept")) else trap("one hoisted")))

@test
def licm-transitive-needs-fixpoint() =
  // t := a + b (invariant) ; u := t + c (reads t, which the loop defs → NOT invariant in ONE pass).
  // After hoisting t, u reads only outside vars → invariant. hoist-fixpoint hoists BOTH.
  let body = [asg(0, Expr.Bin(r(10), r(11))), asg(1, Expr.Bin(r(0), r(12)))] in
  let one = (match hoist(body) with | (h, _) => stmt-count(h)) in
  let fix = (match hoist-fixpoint(body) with | (h, _) => stmt-count(h)) in
  if one == 1 then (if fix == 2 then unit else trap("fixpoint hoists both")) else trap("one pass hoists only the first")

@test
def licm-fixpoint-keeps-loop-carried() =
  // t := a + b (hoist) ; i := i + 1 (loop-carried) ; u := t + i (reads i → stays). fixpoint hoists {t}
  // only; i and u stay (u depends on the loop-carried i).
  let body = [asg(0, Expr.Bin(r(10), r(11))), asg(1, Expr.Bin(r(1), lit(1))), asg(2, Expr.Bin(r(0), r(1)))] in
  (match hoist-fixpoint(body) with | (h, kept) => (if stmt-count(h) == 1 then (if stmt-count(kept) == 2 then unit else trap("two kept")) else trap("only t hoists")))

@test
def licm-all-invariant() =
  // both statements read only outside vars and neither's def is read by the other → both hoist in one pass.
  let body = [asg(0, Expr.Bin(r(10), r(11))), asg(1, Expr.Bin(r(12), r(13)))] in
  (match hoist(body) with | (h, kept) => (if stmt-count(h) == 2 then (if stmt-count(kept) == 0 then unit else trap("none kept")) else trap("both hoist")))

@test
def licm-nothing-invariant() =
  // every statement reads a loop-defined var → nothing hoists (fixpoint returns the whole body).
  let body = [asg(0, Expr.Bin(r(0), lit(1))), asg(1, Expr.Bin(r(1), r(0)))] in
  (match hoist-fixpoint(body) with | (h, kept) => (if stmt-count(h) == 0 then (if stmt-count(kept) == 2 then unit else trap("all kept")) else trap("nothing hoists")))

export { is-invariant, loop-defs, hoist, hoist-fixpoint, is-pure }
