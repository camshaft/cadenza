/// decode.cdz — reconstruct a recursive `Ast` from a flat byte buffer at RUN TIME. This is the stage
/// that was blocked from iteration 1 by the loop-transform slot-aliasing bug; it is now viable because
/// (a) a sibling fixed that bug's invalid-wasm face, and (b) this decoder threads its cursor SEPARATELY
/// — a node's byte size is recomputed by `nsize` so `buildc` advances via `pos + nsize(…)`, never by
/// projecting a `(tuple ast pos)` through a self-tail loop (the shape that still miscompiles to a wrong
/// value: `mlrepro-miscompile-tail-loop-projected-sum-wrong-value.sexp` (queue)).
///
/// FORMAT (a compact self-describing wire form for the STRUCTURE + scalar leaves — this is the port's
/// own decode target, not yet the full `rcdzc/src/codec.rs` container). A node is a tag byte then its
/// payload:
///   tag 0 → Int,  next byte is the value            (2 bytes)
///   tag 1 → Bool, next byte is 0/1                   (2 bytes)
///   tag 2 → Name, no payload (placeholder "")        (1 byte)   — String CONTENT is still blocked by
///           the runtime `String.from-bytes` decline, so a Name/Str leaf decodes to "" for now; the
///           STRUCTURE + every Int/Bool value is exact.
///   tag 3 → List, next byte is the child count, then that many child nodes back-to-back  (2 + Σ kids)
///
/// So `build` reconstructs the full tree and `nsize` is its length oracle. Both recurse over the buffer;
/// the value is returned BARE and the position is recomputed, so no tuple-projected sum is threaded
/// through a loop — the decode design the slot-alias bug forces, and which now runs correctly.
import { Ast } from "ast"

/// The number of bytes the node encoded at `pos` occupies (so a caller advances the cursor without
/// projecting it out of a tuple). A List is 2 header bytes plus the total size of its children.
def nsize(b: Bytes, pos: Int64) -> Int64 =
  let tag = Option.expect(Bytes.at(b, pos), "tag") in
  if tag == 3 then
    csize(b, pos + 2, Option.expect(Bytes.at(b, pos + 1), "count"), 2)
  else
    (if tag == 2 then 1 else 2)

/// The total byte size of `n` sibling nodes starting at `pos`, accumulated left to right.
def csize(b: Bytes, pos: Int64, n: Int64, acc: Int64) -> Int64 =
  if n == 0 then
    acc
  else
    let s = nsize(b, pos) in
    csize(b, pos + s, n - 1, acc + s)

/// Reconstruct the `Ast` encoded at `pos`.
def build(b: Bytes, pos: Int64) -> Ast =
  let tag = Option.expect(Bytes.at(b, pos), "tag") in
  if tag == 0 then
    Ast.Int(Option.expect(Bytes.at(b, pos + 1), "int"))
  else
    (if tag == 1 then
      Ast.Bool(Option.expect(Bytes.at(b, pos + 1), "bool") == 1)
    else
      (if tag == 2 then
        Ast.Name("")
      else
        Ast.List(buildc(b, pos + 2, Option.expect(Bytes.at(b, pos + 1), "count")))))

/// Reconstruct `n` sibling nodes starting at `pos` into a list, advancing the cursor by each node's size.
def buildc(b: Bytes, pos: Int64, n: Int64) -> List(Ast) =
  if n == 0 then
    []
  else
    List.concat([build(b, pos)], buildc(b, pos + nsize(b, pos), n - 1))

/// The top-level decode: reconstruct the tree rooted at byte 0.
def decode(b: Bytes) -> Ast = build(b, 0)

/// Count every node in the decoded tree (structural probe).
def node-count(a: Ast) -> Int64 = match a with
  | Ast.Int(_) => 1
  | Ast.Str(_) => 1
  | Ast.Bool(_) => 1
  | Ast.Name(_) => 1
  | Ast.List(es) => 1 + node-count-list(es)

def node-count-list(xs: List(Ast)) -> Int64 = match xs with
  | [] => 0
  | [h, .. t] => node-count(h) + node-count-list(t)

/// Sum every Int leaf's value (proves Int values round-trip, not just structure).
def int-sum(a: Ast) -> Int64 = match a with
  | Ast.Int(v) => v
  | Ast.Str(_) => 0
  | Ast.Bool(_) => 0
  | Ast.Name(_) => 0
  | Ast.List(es) => int-sum-list(es)

def int-sum-list(xs: List(Ast)) -> Int64 = match xs with
  | [] => 0
  | [h, .. t] => int-sum(h) + int-sum-list(t)

/// Is the top node an Int with the given value?
def is-int(a: Ast, v: Int64) -> Bool = match a with
  | Ast.Int(x) => x == v
  | _ => false

def is-bool(a: Ast, v: Bool) -> Bool = match a with
  | Ast.Bool(x) => x == v
  | _ => false

def top-len(a: Ast) -> Int64 = match a with
  | Ast.List(es) => List.len(es)
  | _ => 0 - 1

@test
def decode-int-leaf() = if is-int(decode(b"\x00\x2a"), 42) then unit else trap("Int 42")

@test
def decode-bool-true() = if is-bool(decode(b"\x01\x01"), true) then unit else trap("Bool true")

@test
def decode-bool-false() = if is-bool(decode(b"\x01\x00"), false) then unit else trap("Bool false")

@test
def decode-name-placeholder() = match decode(b"\x02") with
  | Ast.Name(_) => unit
  | _ => trap("Name")

@test
def decode-flat-list-len() =
  // List{ Int 5, Bool 1, Name } = 03 03 00 05 01 01 02
  if top-len(decode(b"\x03\x03\x00\x05\x01\x01\x02")) == 3 then unit else trap("len 3")

@test
def decode-flat-list-count() =
  if node-count(decode(b"\x03\x03\x00\x05\x01\x01\x02")) == 4 then unit else trap("count 4")

@test
def decode-int-values-roundtrip() =
  // List{ Int 5, Int 7, List{ Int 30 } } = 03 03 00 05 00 07 03 01 00 1e
  if int-sum(decode(b"\x03\x03\x00\x05\x00\x07\x03\x01\x00\x1e")) == 42 then unit else trap("sum 42")

@test
def decode-nested-count() =
  // List{ Int 5, List{ Int 7 } } = 03 02 00 05 03 01 00 07  → 4 nodes
  if node-count(decode(b"\x03\x02\x00\x05\x03\x01\x00\x07")) == 4 then unit else trap("nested count 4")

@test
def decode-empty-list() =
  // List{} = 03 00
  if top-len(decode(b"\x03\x00")) == 0 then unit else trap("empty list len 0")

@test
def decode-deep-nesting() =
  // List{ List{ List{ Int 9 } } } = 03 01 03 01 03 01 00 09  → 4 nodes, int-sum 9
  let a = decode(b"\x03\x01\x03\x01\x03\x01\x00\x09") in
  if node-count(a) == 4 then
    (if int-sum(a) == 9 then unit else trap("deep sum 9"))
  else
    trap("deep count 4")

export { decode }
