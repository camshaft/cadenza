/// unify-subst.cdz — ARC-B3 of the rcdzc HM port: UNIFICATION THAT BINDS VARS (rcdzc unify.rs `unify` threading
/// a `Subst`). This is the PAYOFF slice — the first place a unification variable actually DOES something: instead
/// of A1's inert "a var takes the other side and is forgotten," B3 RECORDS the binding in the Subst, so a var
/// solved on one constraint stays solved for the next (`SVar 0 ~ Signed` then `SVar 0 ~ Unsigned` now CONFLICTS,
/// because 0 is bound to Signed — the essence of a real solve).
///
/// SHAPE vs the existing `unify-ty` (unify-ty.cdz): that one is the STATELESS value-combiner infer's arith/if-join
/// use today (`Ty × Ty → Option(Ty)`, a var inertly takes the other side). THIS is the Subst-THREADING solver
/// (`Subst × Ty × Ty → Option(Subst)`): it returns the EXTENDED substitution (or None on conflict), binding vars
/// with an occurs-check. Kept as a SEPARATE module (not an edit to unify-ty.cdz) so (a) it doesn't touch a file
/// with a pending merge-request, and (b) the stateless combiner stays available until the infer pipeline migrates
/// onto the Subst form (a later slice wires infer to thread a Subst; B3 delivers the solver it will call). Mirrors
/// rcdzc's `unify(subst, a, b) -> Result<(), Reject>` (there: mutates subst in place + returns ok/reject; here:
/// returns the new Subst or None — same information, pure-functional).
///
/// ALGORITHM (rcdzc unify.rs, orthogonal-int case): to unify two ints, unify SIGN and WIDTH independently,
/// THREADING the Subst through both (the width unify sees the sign unify's bindings). Each axis:
///   - resolve BOTH sides through the current Subst first (apply-sign/apply-width — a var already bound is its
///     binding);
///   - var ~ var (same id): already equal, no new binding;
///   - var ~ anything (after resolve, one side is still an unbound var): OCCURS-CHECK, then BIND var := other;
///   - concrete ~ concrete: must be EQUAL (sign-eq/width-eq) else conflict (the CDZ0301 no-silent-promotion rule);
///   - deferred behaves as before (a SignDef/WidthDef takes the other — deferred is not a solvable var, it's a
///     literal's not-yet-constrained axis that grounds by defaulting; only SVar/WVar record bindings).
import { Sign, Width, IntType, Ty, sign-eq, width-eq, int-list-eq } from "ty"

import { Subst, apply-sign, apply-width, apply, subst-bind-sign, subst-bind-width, subst-bind-ty } from "subst"

import { sign-occurs, width-occurs, ty-occurs } from "hm-vars"

/// Unify two SIGNS under a Subst, returning the extended Subst (or None on conflict). Resolves both sides first,
/// then: same-var → unchanged; either side an unbound var → occurs-check + bind; two concretes → must be equal;
/// a deferred takes the other (deferred is not a var — no binding, just picks the more-defined side).
def unify-sign-su(su: Subst, a: Sign, b: Sign) =
  bind-or-check-sign(su, apply-sign(su, a), apply-sign(su, b))

/// Core sign step over ALREADY-RESOLVED signs `ra`,`rb` (each = its Subst binding if bound).
def bind-or-check-sign(su: Subst, ra: Sign, rb: Sign) = match ra with
  | Sign.SVar(ia) => (
    match rb with
    | Sign.SVar(ib) =>
      if ia == ib then
        Option.Some(su) // same var → already equal
      else
        Option.Some(subst-bind-sign(su, ia, Sign.SVar(ib))) // var~var → bind one to the other (ids differ so no self-cycle)
    | _ =>
      if sign-occurs(su, ia, rb) then
        Option.None(unit) // occurs → infinite type → reject
      else
        Option.Some(subst-bind-sign(su, ia, rb))
  ) // bind var := the concrete/deferred other
  | Sign.SignDef => Option.Some(su) // deferred ~ anything (incl a var) → other; no binding
  | Sign.Signed => (
    match rb with
    | Sign.SVar(ib) =>
      if sign-occurs(su, ib, ra) then
        Option.None(unit)
      else
        Option.Some(subst-bind-sign(su, ib, ra)) // bind the var to Signed
    | Sign.SignDef => Option.Some(su)
    | Sign.Signed => Option.Some(su)
    | Sign.Unsigned => Option.None(unit)
  ) // Signed ~ Unsigned → conflict
  | Sign.Unsigned =>
    match rb with
    | Sign.SVar(ib) =>
      if sign-occurs(su, ib, ra) then
        Option.None(unit)
      else
        Option.Some(subst-bind-sign(su, ib, ra))
    | Sign.SignDef => Option.Some(su)
    | Sign.Unsigned => Option.Some(su)
    | Sign.Signed => Option.None(unit)

/// Unify two WIDTHS under a Subst (the orthogonal twin of unify-sign-su).
def unify-width-su(su: Subst, a: Width, b: Width) =
  bind-or-check-width(su, apply-width(su, a), apply-width(su, b))

def bind-or-check-width(su: Subst, ra: Width, rb: Width) = match ra with
  | Width.WVar(ia) => (
    match rb with
    | Width.WVar(ib) =>
      if ia == ib then Option.Some(su) else Option.Some(subst-bind-width(su, ia, Width.WVar(ib)))
    | _ =>
      if width-occurs(su, ia, rb) then
        Option.None(unit)
      else
        Option.Some(subst-bind-width(su, ia, rb))
  )
  | Width.WidthDef => Option.Some(su)
  | Width.WFixed(n) =>
    match rb with
    | Width.WVar(ib) =>
      if width-occurs(su, ib, ra) then
        Option.None(unit)
      else
        Option.Some(subst-bind-width(su, ib, ra))
    | Width.WidthDef => Option.Some(su)
    | Width.WFixed(m) => if n == m then Option.Some(su) else Option.None(unit)

/// Unify two INTEGER types under a Subst: thread the Subst through the sign axis, THEN the width axis on the
/// resulting Subst (so width unify sees sign's bindings — orthogonal but sequenced through one growing Subst).
def unify-int-su(su: Subst, a: IntType, b: IntType) =
  let IntType.IntType(sa, wa) = a in
  let IntType.IntType(sb, wb) = b in
  match unify-sign-su(su, sa, sb) with
  | Option.Some(su1) => unify-width-su(su1, wa, wb)
  | Option.None(_) => Option.None(unit)

/// Unify two `Ty` under a Subst → `Some(extended Subst)` or `None` (conflict). Mirrors rcdzc `unify` (unify.rs:236):
/// FIRST resolve both sides through the current Subst (apply — so a bound var becomes its solution), THEN dispatch.
/// A TyVar (after resolve, still unbound) is BOUND to the other side after an occurs-check (B3 — rcdzc unify.rs:244
/// `(Ty::Var(v), t)|(t, Ty::Var(v)) => occurs-check then subst.tys.insert(v,t)`); two same-id vars are already
/// equal. Concrete pairs dispatch structurally (unify-ty-concrete). This is the inline-unify primitive the demand
/// type_of calls per node.
def unify-ty-su(su: Subst, a: Ty, b: Ty) = bind-or-unify-ty(su, apply(su, a), apply(su, b))

/// The resolved-both-sides step (ra/rb already `apply`d): handle the type-variable cases (rcdzc unify.rs:243-256),
/// else dispatch to the concrete structural unify. A var on EITHER side binds to the other (occurs-checked).
def bind-or-unify-ty(su: Subst, ra: Ty, rb: Ty) = match ra with
  | Ty.TyVar(va) => (
    match rb with
    | Ty.TyVar(vb) =>
      if va == vb then
        Option.Some(su) // same var → already equal
      else if ty-occurs(su, va, rb) then
        Option.None(unit) // occurs (a in b) → infinite → reject
      else
        Option.Some(subst-bind-ty(su, va, rb)) // bind va := the other var
    | _ =>
      if ty-occurs(su, va, rb) then
        Option.None(unit) // occurs → infinite type → reject
      else
        Option.Some(subst-bind-ty(su, va, rb))
  ) // bind va := the concrete/compound rb
  | _ =>
    match rb with
    | Ty.TyVar(vb) =>
      if ty-occurs(su, vb, ra) then
        Option.None(unit) // symmetric: var on the RIGHT
      else
        Option.Some(subst-bind-ty(su, vb, ra))
    | _ => unify-ty-concrete(su, ra, rb) // neither is a var → structural

/// Structural unify of two NON-var (resolved) types (the concrete dispatch — was unify-ty-su's body pre-B3).
def unify-ty-concrete(su: Subst, a: Ty, b: Ty) = match a with
  | Ty.TyInt(ita) => (
    match b with
    | Ty.TyInt(itb) => unify-int-su(su, ita, itb)
    | _ => Option.None(unit)
  )
  | Ty.TyBool => (
    match b with
    | Ty.TyBool => Option.Some(su)
    | _ => Option.None(unit)
  )
  | Ty.TyString => (
    match b with
    | Ty.TyString => Option.Some(su)
    | _ => Option.None(unit)
  )
  | Ty.TyChar => (
    match b with
    | Ty.TyChar => Option.Some(su)
    | _ => Option.None(unit)
  )
  | Ty.TyErr => Option.None(unit)
  | Ty.TyFn(psa, ra) => (
    match b with
    | Ty.TyFn(psb, rb) =>
      if List.len(psa) == List.len(psb) then
        match unify-ty-list-su(su, psa, psb, 0) with
        | Option.Some(su1) => unify-ty-su(su1, ra, rb)
        | Option.None(_) => Option.None(unit)
      else
        Option.None(unit)
    | _ => Option.None(unit)
  )
  | Ty.TySum(na) => (
    match b with
    | Ty.TySum(nb) => if na == nb then Option.Some(su) else Option.None(unit)
    | _ => Option.None(unit)
  )
  // COMPOUND TUPLE: same arity + elements unify PAIRWISE, threading the Subst (mirrors the TyFn param arm,
  // no result). The list unify returns the threaded Subst directly.
  | Ty.TyTuple(esa) => (
    match b with
    | Ty.TyTuple(esb) =>
      if List.len(esa) == List.len(esb) then
        unify-ty-list-su(su, esa, esb, 0)
      else
        Option.None(unit)
    | _ => Option.None(unit)
  )
  // COMPOUND RECORD: same field names + paired types unify pairwise, threading the Subst (mirrors TyTuple + names).
  | Ty.TyRecord(na, ta) => (
    match b with
    | Ty.TyRecord(nb, tb) =>
      if List.len(na) == List.len(nb) and int-list-eq(na, nb, 0) then
        unify-ty-list-su(su, ta, tb, 0)
      else
        Option.None(unit)
    | _ => Option.None(unit)
  )
  // unreachable: bind-or-unify-ty handles both TyVar cases before dispatching here; a TyVar never reaches
  // unify-ty-concrete. Arm present for exhaustiveness only.
  | Ty.TyVar(_) => Option.None(unit)

/// Unify two same-length param lists PAIRWISE, threading the Subst left-to-right (each pair sees prior bindings).
def unify-ty-list-su(su: Subst, a: List(Ty), b: List(Ty), i: Int64) =
  if i == List.len(a) then
    Option.Some(su)
  else
    match List.at(a, i) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(ta) =>
      match List.at(b, i) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(tb) =>
        match unify-ty-su(su, ta, tb) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(su1) => unify-ty-list-su(su1, a, b, i + 1)

// NOTE: the remaining B3 pins (concrete-conflict, occurs-no-false-reject, bool, fn-param-bind) were DEFERRED
// while the cross-module "parameter reference has no local slot" emit bug capped this unit at ~5 heavy test
// closures. That bug is FIXED + landed (v-compiler-perf #2753, trunk f2064c31 — eval-once no longer treats a
// PURE recursive callee as performing), and v-wasm-opt verified a 6th heavy @test here now compiles+runs green.
// The deferred pins are added below (unblocked 2026-08-08). The first 5 cover the B3 ESSENTIAL (var→concrete
// bind, bound-var-STAYS-solved = the payoff vs A1's inert unify, var→var chain, width binding, both-axes); the
// added pins nail the conflict/occurs/bool/fn-threading edges (some overlap unify-ty.cdz / hm-vars.cdz, but as
// SUBST-THREADING witnesses they pin exactly this solver's paths + serve as permanent emit-slot regression pins).
// ---- TESTS: unify BINDS vars into the Subst; a bound var stays solved (real solve, not inert) --------
import { ty-int64, ty-fixed-int } from "ty"

import { subst-empty } from "subst"

@test
def us-binds-sign-var-to-concrete() =
  // unify SVar(0) ~ Signed → the Subst binds 0 := Signed; applying it to SVar(0) now yields Signed.
  match unify-sign-su(subst-empty(), Sign.SVar(0), Sign.Signed) with
    | Option.Some(su) => (
      match apply-sign(su, Sign.SVar(0)) with
      | Sign.Signed => unit
      | _ => trap("after unify, SVar(0) resolves to Signed")
    )
    | Option.None(_) => trap("SVar(0) ~ Signed must unify (bind)")

@test
def us-bound-var-stays-solved-conflict() =
  // THE real-solve pin: bind SVar(0):=Signed via one unify, then unify SVar(0) ~ Unsigned on that Subst → CONFLICT
  // (0 is already Signed). Under A1's inert unify this WRONGLY succeeded (var just took the other); B3 makes it a
  // genuine conflict — a var solved once stays solved.
  match unify-sign-su(subst-empty(), Sign.SVar(0), Sign.Signed) with
    | Option.Some(su) => (
      match unify-sign-su(su, Sign.SVar(0), Sign.Unsigned) with
      | Option.None(_) => unit
      | Option.Some(_) => trap("a var already bound to Signed must CONFLICT with Unsigned")
    )
    | Option.None(_) => trap("first unify binds")

@test
def us-var-to-var-then-concrete-propagates() =
  // SVar(0) ~ SVar(1) binds 0:=1; then SVar(1) ~ Signed binds 1:=Signed; now SVar(0) resolves THROUGH the chain
  // to Signed. Pins that binding var~var then solving the target propagates to the first (transitivity).
  match unify-sign-su(subst-empty(), Sign.SVar(0), Sign.SVar(1)) with
    | Option.Some(su1) => (
      match unify-sign-su(su1, Sign.SVar(1), Sign.Signed) with
      | Option.Some(su2) => (
        match apply-sign(su2, Sign.SVar(0)) with
        | Sign.Signed => unit
        | _ => trap("SVar(0) resolves through 0→1→Signed")
      )
      | Option.None(_) => trap("bind 1 := Signed")
    )
    | Option.None(_) => trap("bind 0 := 1")

@test
def us-width-var-binds() =
  // width axis: WVar(3) ~ WFixed(8) binds 3:=8.
  match unify-width-su(subst-empty(), Width.WVar(3), Width.WFixed(8)) with
    | Option.Some(su) => (
      match apply-width(su, Width.WVar(3)) with
      | Width.WFixed(w) => if w == 8 then unit else trap("WVar(3) := 8")
      | _ => trap("WVar(3) resolves to WFixed(8)")
    )
    | Option.None(_) => trap("WVar(3) ~ WFixed(8) must bind")

@test
def us-int-both-axes-bind-independently() =
  // unify (SVar0, WVar1) ~ (Unsigned, WFixed 16): sign binds 0:=Unsigned, width binds 1:=16; applying to the
  // fresh int yields UInt16. Orthogonal axes both solved through one threaded Subst.
  match unify-int-su(
      subst-empty(),
      IntType.IntType(Sign.SVar(0), Width.WVar(1)),
      IntType.IntType(Sign.Unsigned, Width.WFixed(16))
    ) with
    | Option.Some(su) => (
      match apply(su, Ty.TyInt(IntType.IntType(Sign.SVar(0), Width.WVar(1)))) with
      | Ty.TyInt(IntType.IntType(Sign.Unsigned, Width.WFixed(w))) =>
        if w == 16 then unit else trap("width bound to 16")
      | _ => trap("both axes bind → UInt16")
    )
    | Option.None(_) => trap("(SVar0,WVar1) ~ (Unsigned,W16) unifies")

@test
def us-concrete-conflict-no-bind() =
  // two CONCRETE ints that disagree on width → conflict (None), no binding invented. Int64 ~ Int32 (both signed,
  // widths 64 vs 32) → None. The no-silent-promotion rule (CDZ0301) threaded through the Subst solver: unify
  // never coerces one fixed width to another. (Overlaps unify-ty.cdz's stateless combiner, but pins it for the
  // SUBST path — a conflict must abort the whole int unify, not just one axis.)
  match unify-ty-su(subst-empty(), ty-int64(), ty-fixed-int(true, 32)) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("Int64 ~ Int32 must CONFLICT (no width promotion)")

@test
def us-occurs-no-false-reject-on-distinct-vars() =
  // occurs-check must NOT false-reject when the var does NOT occur in the other side: SVar(0) ~ SVar(1) (distinct
  // ids, neither occurs in the other) binds cleanly. Guards that the occurs guard is precise (same-id only), not
  // an over-eager reject that would break var~var chaining. (The occurs REJECT case lives in hm-vars.cdz; this
  // pins the complementary no-false-positive through the solver.)
  match unify-sign-su(subst-empty(), Sign.SVar(0), Sign.SVar(1)) with
    | Option.Some(su) => (
      match apply-sign(su, Sign.SVar(0)) with
      | Sign.SVar(w) => if w == 1 then unit else trap("0 binds to var 1 (chain), not itself")
      | Sign.Signed => trap("no concrete bound yet — 0 resolves to var 1")
      | _ => trap("SVar(0) resolves to SVar(1) after the var~var bind")
    )
    | Option.None(_) => trap("distinct vars must NOT trip occurs — SVar(0) ~ SVar(1) binds")

@test
def us-bool-unifies-var-free() =
  // TyBool ~ TyBool: a var-free unify — succeeds with the Subst UNCHANGED (no bindings). Pins the non-int scalar
  // path (a Bool carries no sign/width axis to solve). A trivial-but-permanent pin the emit cap previously blocked.
  match unify-ty-su(subst-empty(), Ty.TyBool, Ty.TyBool) with
    | Option.Some(_) => unit
    | Option.None(_) => trap("TyBool ~ TyBool must unify (var-free, no binding)")

@test
def us-fn-params-thread-and-bind() =
  // the DEEPEST path in the module (self-recursive unify-ty-su over TyFn — this is v-wasm-opt's no-local-slot
  // probe shape, now emit-clean): unify (fn (SVarInt) -> SVarInt) ~ (fn Int64 -> Int64). The param list threads
  // through unify-ty-list-su (list recursion) binding the sign/width vars, then the result unifies on the grown
  // Subst (ty-su → ty-list-su → ty-su → int-su → sign-su/width-su). The shared var(0)/(1) in BOTH param + result
  // stays solved across the recursion → applying it yields Int64.
  match unify-ty-su(
      subst-empty(),
      Ty.TyFn(
        List.push([] : List(Ty), Ty.TyInt(IntType.IntType(Sign.SVar(0), Width.WVar(1)))),
        Ty.TyInt(IntType.IntType(Sign.SVar(0), Width.WVar(1)))
      ),
      Ty.TyFn(List.push([] : List(Ty), ty-int64()), ty-int64())
    ) with
    | Option.Some(su) => (
      match apply(su, Ty.TyInt(IntType.IntType(Sign.SVar(0), Width.WVar(1)))) with
      | Ty.TyInt(IntType.IntType(Sign.Signed, Width.WFixed(w))) =>
        if w == 64 then unit else trap("param bound to Int64")
      | _ => trap("fn param sign/width bind through the list")
    )
    | Option.None(_) => trap("(fn SVarInt -> SVarInt) ~ (fn Int64 -> Int64) unifies")

// ---- B3: whole-type TyVar binding (rcdzc unify.rs:243-256) ----
@test
def us-b3-tyvar-binds-to-concrete() =
  // unify TyVar 0 ~ TyBool → binds 0 := TyBool; applying to TyVar 0 yields TyBool. The whole-type analog of
  // the sign/width var bind, mirroring rcdzc unify.rs:244.
  match unify-ty-su(subst-empty(), Ty.TyVar(0), Ty.TyBool) with
    | Option.Some(su) => (
      match apply(su, Ty.TyVar(0)) with
      | Ty.TyBool => unit
      | _ => trap("TyVar 0 ~ TyBool binds 0 to TyBool")
    )
    | Option.None(_) => trap("TyVar 0 ~ TyBool must unify (bind)")

@test
def us-b3-tyvar-binds-on-either-side() =
  // symmetric: TyBool ~ TyVar 0 (var on the RIGHT) also binds 0 := TyBool (rcdzc's `(t, Var v)` case).
  match unify-ty-su(subst-empty(), ty-int64(), Ty.TyVar(0)) with
    | Option.Some(su) => (
      match apply(su, Ty.TyVar(0)) with
      | Ty.TyInt(IntType.IntType(Sign.Signed, Width.WFixed(w))) =>
        if w == 64 then unit else trap("var binds to Int64")
      | _ => trap("Int64 ~ TyVar 0 binds 0 to Int64 (var on the right)")
    )
    | Option.None(_) => trap("Int64 ~ TyVar 0 must unify")

@test
def us-b3-same-var-already-equal() =
  // TyVar 0 ~ TyVar 0 → already equal, no binding, Subst unchanged (rcdzc `(Var v, Var w) if v==w`).
  match unify-ty-su(subst-empty(), Ty.TyVar(0), Ty.TyVar(0)) with
    | Option.Some(_) => unit
    | Option.None(_) => trap("TyVar 0 ~ TyVar 0 is already equal")

@test
def us-b3-bound-var-stays-solved-conflict() =
  // THE real-solve pin: bind TyVar 0 := TyBool, then unify TyVar 0 ~ Int64 on that Subst → CONFLICT (0 resolves
  // to TyBool via apply, and TyBool ~ Int64 is a concrete conflict). A whole-type var solved once stays solved.
  match unify-ty-su(subst-empty(), Ty.TyVar(0), Ty.TyBool) with
    | Option.Some(su) => (
      match unify-ty-su(su, Ty.TyVar(0), ty-int64()) with
      | Option.None(_) => unit
      | Option.Some(_) => trap("a var bound to TyBool must conflict with Int64")
    )
    | Option.None(_) => trap("first unify binds")

@test
def us-b3-occurs-check-rejects-infinite() =
  // occurs-check: unify TyVar 0 ~ (fn (TyVar 0) -> Bool) → 0 occurs in the fn param → REJECT (infinite type),
  // mirroring rcdzc's occurs guard before the bind. Returns None.
  let f = Ty.TyFn(List.push([] : List(Ty), Ty.TyVar(0)), Ty.TyBool) in
  match unify-ty-su(subst-empty(), Ty.TyVar(0), f) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("TyVar 0 ~ (fn (TyVar0) -> Bool) must fail the occurs-check")

@test
def us-b3-var-to-var-then-concrete-propagates() =
  // TyVar 0 ~ TyVar 1 binds 0:=1; then TyVar 1 ~ TyBool binds 1:=Bool; TyVar 0 resolves THROUGH the chain to Bool.
  match unify-ty-su(subst-empty(), Ty.TyVar(0), Ty.TyVar(1)) with
    | Option.Some(su1) => (
      match unify-ty-su(su1, Ty.TyVar(1), Ty.TyBool) with
      | Option.Some(su2) => (
        match apply(su2, Ty.TyVar(0)) with
        | Ty.TyBool => unit
        | _ => trap("TyVar 0 resolves through 0->1->Bool")
      )
      | Option.None(_) => trap("bind 1 := Bool")
    )
    | Option.None(_) => trap("bind 0 := 1")

export { unify-sign-su, unify-width-su, unify-int-su, unify-ty-su, unify-ty-list-su }
