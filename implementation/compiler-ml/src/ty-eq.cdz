/// ⚠ BANKED FUTURE-HM SPIKE — NOT wired into the pipeline (parametric-polymorphic HM prototype; the LIVE
/// pipeline uses monomorphic deferred-int HM in infer-db.cdz). Kept + tested + banked for when the source
/// language gains generic defs. See unify.cdz's banner for the full note.
///
/// ty-eq.cdz — structural type EQUALITY over a recursive `Ty` sum, written the IDIOMATIC way: a SINGLE
  /// `match (a, b)` on the TUPLE of both types, with same-constructor arms and a self-recursive call on the
  /// payload sub-terms. This is the natural HM type-checker dispatch (`unify`/`ty-eq`/`subtype` all take it).
  ///
  /// It is a permanent SOURCE-LEVEL regression witness for the tuple-of-sums CSE-key collision fixed on
  /// trunk: the shared-sum-payload-prefix CSE keyed its slot on (scrutinee, prefix LENGTH), so a
  /// `match (a, b)` over two sums produced TWO same-length payload prefixes off the one tuple scrutinee that
  /// COLLIDED — `b`'s payload read `a`'s — and a self-recursive `eq(a2, b2)` silently became `eq(a2, a2)`
  /// (returned equal when it should differ). The fix keys on the full prefix STEPS. This module exercises
  /// exactly that shape, so it stays green only while the fix holds — and the compiler-ml @test suite is now
  /// wired into `cargo xtask check`, so this guards the fix fleet-wide, not just in an rcdzc unit test.
  ///
  /// (`unify.cdz` and `apply-ty.cdz` deliberately used NESTED single-sum matches to sidestep the bug while
  /// it was open; now that it's fixed, this module records that the idiomatic `match (a, b)` form is safe.)
  type Ty =
  | TInt
  | TBool
  | TVar(Int64)
  | TArrow(Ty, Ty)

/// Structural equality of two types, dispatching on the PAIR (the idiomatic simultaneous match). A `TVar`
/// is equal only to the same-numbered `TVar`; a `TArrow` recurses on both components (self-recursive call
/// on the payload binders — the shape the CSE collision broke).
def ty-eq(a: Ty, b: Ty) = match (a, b) with
  | (Ty.TInt, Ty.TInt) => true
  | (Ty.TBool, Ty.TBool) => true
  | (Ty.TVar(i), Ty.TVar(j)) => i == j
  | (Ty.TArrow(a1, a2), Ty.TArrow(b1, b2)) => (if ty-eq(a1, b1) then ty-eq(a2, b2) else false)
  | (_, _) => false

/// Builders.
def arrow(from: Ty, to: Ty) = Ty.TArrow(from, to)

@test
def te-int-int() = if ty-eq(Ty.TInt, Ty.TInt) then unit else trap("Int = Int")

@test
def te-int-bool() = if ty-eq(Ty.TInt, Ty.TBool) then trap("Int != Bool") else unit

@test
def te-var-same() = if ty-eq(Ty.TVar(3), Ty.TVar(3)) then unit else trap("var 3 = var 3")

@test
def te-var-diff() = if ty-eq(Ty.TVar(3), Ty.TVar(4)) then trap("var 3 != var 4") else unit

@test
def te-arrow-equal() =
  // (Int -> Bool) = (Int -> Bool)
  if ty-eq(arrow(Ty.TInt, Ty.TBool), arrow(Ty.TInt, Ty.TBool)) then unit else trap("equal arrows")

@test
def te-arrow-result-differs() =
  // (Int -> Bool) != (Int -> Int) — the RESULT types differ. THE REGRESSION CASE: under the CSE-key
  // collision this wrongly returned true (b2 read a's payload → ty-eq(a2,a2)). Must be false.
  if ty-eq(arrow(Ty.TInt, Ty.TBool), arrow(Ty.TInt, Ty.TInt)) then
    trap("Int->Bool != Int->Int (result differs)")
  else
    unit

@test
def te-arrow-arg-differs() =
  // (Bool -> Int) != (Int -> Int) — the ARGUMENT types differ (the other-side regression). Must be false.
  if ty-eq(arrow(Ty.TBool, Ty.TInt), arrow(Ty.TInt, Ty.TInt)) then
    trap("Bool->Int != Int->Int (arg differs)")
  else
    unit

@test
def te-nested-arrow-equal() =
  // ((Int -> Int) -> Bool) = the same — recursion through a nested arrow on both sides.
  let t = arrow(arrow(Ty.TInt, Ty.TInt), Ty.TBool) in
  if ty-eq(t, t) then unit else trap("nested arrows equal to themselves")

@test
def te-nested-arrow-deep-differ() =
  // ((Int -> Int) -> Bool) != ((Int -> Bool) -> Bool) — differ only in a DEEPLY nested result type;
  // the self-recursion must carry the difference up. Under the collision this leaked to true.
  let l = arrow(arrow(Ty.TInt, Ty.TInt), Ty.TBool) in
  let r = arrow(arrow(Ty.TInt, Ty.TBool), Ty.TBool) in
  if ty-eq(l, r) then trap("deep nested difference must propagate to false") else unit

@test
def te-arrow-vs-leaf() =
  // (Int -> Int) != Int — a compound vs a leaf takes the wildcard arm → false.
  if ty-eq(arrow(Ty.TInt, Ty.TInt), Ty.TInt) then trap("arrow != leaf") else unit

@test
def te-var-inside-arrow() =
  // (a -> a) = (a -> a) with the SAME var, but (a -> a) != (a -> b): the recursion compares TVar numbers.
  let same = arrow(Ty.TVar(0), Ty.TVar(0)) in
  let diff = arrow(Ty.TVar(0), Ty.TVar(1)) in
  if ty-eq(same, same) then
    if ty-eq(same, diff) then trap("a->a != a->b") else unit
  else
    trap("a->a = a->a")

export { ty-eq }
