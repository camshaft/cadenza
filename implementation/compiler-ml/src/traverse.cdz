/// traverse.cdz — higher-order combinators over lists and the `Ast` (the `List.map`/`filter`/`fold`
/// the prelude lacks, plus Ast-shaped traversals). These are the workhorses a compiler pass leans on:
/// map over every child, filter a symbol list, fold constraints, count nodes matching a predicate.
///
/// NOTE on the annotations: each higher-order parameter carries an explicit ARROW type (`f: Int64 ->
/// Int64`, `p: Ast -> Bool`). That is not decoration — it is REQUIRED here: an unannotated closure
/// passed to a SELF-RECURSIVE HOF fails to infer its parameter types (they are left unsolved →
/// "a closure's parameter type has no machine representation"). See
/// `repros/reject-inferred-closure-param-through-recursive-hof.sexp`. Annotating the HOF's function
/// parameter (or the closure's params) gives inference the anchor it can't derive through the
/// recursion; the arrow annotation is the idiomatic fix and reads well.
import { Ast } from "ast"

/// Map a function over an Int64 list (the `List.map` the prelude lacks).
def map-list(f: Int64 -> Int64, xs: List(Int64)) = match xs with
  | [] => []
  | [h, .. t] => List.concat([f(h)], map-list(f, t))

/// Keep the elements a predicate accepts.
def filter-list(p: Int64 -> Bool, xs: List(Int64)) = match xs with
  | [] => []
  | [h, .. t] => if p(h) then List.concat([h], filter-list(p, t)) else filter-list(p, t)

/// Left fold: thread an accumulator through `f` across the list.
def fold-list(f: Int64 -> Int64 -> Int64, acc: Int64, xs: List(Int64)) = match xs with
  | [] => acc
  | [h, .. t] => fold-list(f, f(h, acc), t)

/// Count the nodes of an `Ast` that satisfy `p` (pre-order over the whole tree).
def count-where(p: Ast -> Bool, node: Ast) =
  (if p(node) then 1 else 0)
    + (match node with
      | Ast.List(es) => count-where-list(p, es)
      | _ => 0)

def count-where-list(p: Ast -> Bool, xs: List(Ast)) = match xs with
  | [] => 0
  | [h, .. t] => count-where(p, h) + count-where-list(p, t)

/// Sum every Int leaf of an `Ast` via a fold over its children (folding `Ast`-valued accumulation).
def int-total(node: Ast) = match node with
  | Ast.Int(v) => v
  | Ast.List(es) => int-total-list(es)
  | _ => 0

def int-total-list(xs: List(Ast)) = match xs with
  | [] => 0
  | [h, .. t] => int-total(h) + int-total-list(t)

def is-int-node(node: Ast) = match node with
  | Ast.Int(_) => true
  | _ => false

def is-list-node(node: Ast) = match node with
  | Ast.List(_) => true
  | _ => false

@test
def map-square() =
  if int-list-eq(map-list(fn(x) => x * x, [1, 2, 3]), [1, 4, 9]) then unit else trap("map square")

@test
def filter-positive() =
  if int-list-eq(filter-list(fn(x) => x > 0, [1, 0 - 2, 3, 0 - 4]), [1, 3]) then
    unit
  else
    trap("filter positive")

@test
def fold-sum() = if fold-list(fn(x, a) => a + x, 0, [5, 7, 30]) == 42 then unit else trap("fold sum")

@test
def fold-empty() = if fold-list(fn(x, a) => a + x, 99, []) == 99 then unit else trap("fold empty")

@test
def map-filter-fold-pipeline() =
  let xs = [1, 0 - 2, 3] in
  if fold-list(fn(x, a) => a + x, 0, map-list(fn(x) => x * x, filter-list(fn(x) => x > 0, xs))) == 10 then
    unit
  else
    trap("1,3 -> 1,9 -> 10")

@test
def count-int-nodes() =
  let tree = Ast.List([Ast.Int(5), Ast.List([Ast.Int(7), Ast.Name("f")]), Ast.Int(9)]) in
  if count-where(is-int-node, tree) == 3 then unit else trap("3 int nodes")

@test
def count-list-nodes() =
  let tree = Ast.List([Ast.Int(5), Ast.List([Ast.Int(7)])]) in
  if count-where(is-list-node, tree) == 2 then unit else trap("2 list nodes")

@test
def int-total-nested() =
  let tree = Ast.List([Ast.Int(5), Ast.List([Ast.Int(7), Ast.Bool(true)]), Ast.Int(30)]) in
  if int-total(tree) == 42 then unit else trap("total 42")

@test
def count-where-none() =
  if count-where(is-int-node, Ast.Name("x")) == 0 then unit else trap("no int in a Name")

/// Structural Int64-list equality (test helper).
def int-list-eq(a: List(Int64), b: List(Int64)) = match a with
  | [] => (match b with | [] => true | _ => false)
  | [x, .. xs] => (match b with
    | [] => false
    | [y, .. ys] => if x == y then int-list-eq(xs, ys) else false)

export { map-list, filter-list, fold-list, count-where, int-total }
