/// db-query-perfield.cdz — THE demand type_of spine on the per-field single-family DbState contract, the
/// operator-mandated lazy-memoized-database-via-effects architecture (mirror rcdzc's demand+memoize type_of
/// SEMANTICS, but carry the Db in an effect handler rather than threading &mut Db — the intended divergence
/// from the rust version).
///
/// DbState is ONE effect FAMILY with FINER-GRAINED PER-FIELD ops — get-ty/set-ty (types column),
/// get-resolved (resolved column), node-of (read-only ast) — NOT one whole-Db getter/setter. The single
/// handler installed for the family carries ALL columns as its shared state and serves every op, reading or
/// writing ONLY that op's slice (so a middleware/log layer can intercept one field at a time — the operator's
/// rationale). The performer threads a scalar NodeId per op; the whole Db is never threaded through an op.
///
/// type-of / compute-type / cache-type are a mutually-recursive GROUP, each performing per-field ops — the
/// idiomatic salsa/demand shape (a memoized query pulls sub-queries recursively over one state). This LOWERS
/// as of the effect group-aware recursive-perform fold (floor #2866 + group-fold #2877 + slot-fix #2889): the
/// mutual 3-performer cycle specializes and runs end-to-end.
///
/// STATUS: this is the demand-type_of spine, live as a tested module. The NIf and NLet arms now call the REAL
/// infer-db if-type/let-type via a get-tcol projection (the pure tcol-only combiners — they read child facts
/// from the current types column, which each child type-of has already memoized). NBin still uses a simplified
/// combine-bin stand-in (bin-type also needs tree access for its literal-operand range-check — a follow-on with
/// scalar node projection) and NMatch a combine-match stand-in (match-type is not yet exported from infer-db).
/// The get-tcol op is a compound Map effect-return (verified emit-valid on trunk); the arms demand all children
/// FIRST then do one tail get-tcol perform, so they stay clear of the demand-perform-demand fold gap (the
/// arg-passing NApp arm that needs a perform BETWEEN two demands is held pending a v-effects specializer fix).
/// The live-pipeline flip (route run-of-db / ty-of-db through this) is a later differential-guarded slice.
import { Node, Tree, node-at, def-body-of, call-is-recursive } from "parse-db"
import { Db, db-of, db-tree, require-ty, fill-ty, require-resolved, fill-resolved } from "db"
import { Ty } from "ty"
import { Resolved } from "resolve-db"
import { bin-type, if-type, let-type, var-type, t-int-deferred, mk-int, int-parts-of } from "infer-db"

/// The DbState effect FAMILY — ONE group, per-field ops over the shared column state (operator-confirmed).
/// Reads return Option (Absent/Filled = the Slot semantics); writes take the scalar payload and resume Unit.
/// node-of is a read-only ast op; def-body-of/is-recursive are read-only ast-derived ops (SCALAR: NodeId in,
/// Option(NodeId)/Bool out) so the callee-body demand + recursive-call fixpoint never thread the wide Tree.
/// The handler (below) carries the whole Db and serves every op.
  effect DbState =
  | get-ty : Int64 -> Option(Ty)
  | set-ty : Tuple(Int64, Ty) -> Unit
  | get-resolved : Int64 -> Option(Resolved)
  | node-of : Int64 -> Option(Node)
  | def-body-node : Int64 -> Option(Int64)     // callee NAME -> its def-body NodeId (rcdzc def-body-of)
  | call-recursive : Int64 -> Bool             // callee NAME -> body transitively calls back (fixpoint guard)
  | get-tcol : -> Map(Int64, Ty)               // project the current types column (for the pure tcol-only combiners)

/// DEMAND the type at `id` (rcdzc type_of@43): per-field memo check via get-ty; HIT returns, MISS computes +
/// caches. Performs get-ty (scalar NodeId in, Option(Ty) out). Member of the mutual performer group.
def type-of(id: Int64) = match DbState.get-ty(id) with
  | Option.Some(t) => t
  | Option.None(_) => cache-type(id, compute-type(id))

/// MISS cache path — performs set-ty (per-field write, scalar payload). Mutual-group member.
def cache-type(id: Int64, t: Ty) = match DbState.set-ty((id, t)) with
  | _ => t

/// COMPUTE a node's type, DEMANDING children via type-of (recursion) + combining via infer-db's rules.
/// Reads the node via node-of + resolution via get-resolved (per-field read ops). Mutual-group member.
/// NB: the infer-db combiners (bin-type/if-type/let-type/var-type) still take an explicit tcol Map today;
/// under the effect spine that column lives in the handler state, so the combiners read it via a rebuilt
/// tcol projection. For the acceptance test we thread a small tcol snapshot via type-of's demanded facts —
/// the combiners are PURE over the child types they are handed, so the effect axis is isolated to get/set.
def compute-type(id: Int64) = match DbState.node-of(id) with
  | Option.Some(Node.NLit(_)) => t-int-deferred()
  | Option.Some(Node.NBoolLit(_)) => Ty.TyBool
  | Option.Some(Node.NAnnLit(_, sflag, w)) => mk-int((if sflag == 1 then true else false), w)
  | Option.Some(Node.NVar(_)) =>
      (match DbState.get-resolved(id) with
        | Option.Some(Resolved.RBound(binder)) => (let _bt = type-of(binder) in _bt)
        | _ => Ty.TyErr)
  | Option.Some(Node.NBin(op, l, r)) =>
      (let lt = type-of(l) in (let rt = type-of(r) in combine-bin(op, lt, rt)))
  | Option.Some(Node.NLet(_, valId, bodyId)) =>
      // FAITHFUL: demand val + body (memoizing each into the types column), then call the REAL infer-db let-type
      // over the current column (get-tcol). let-type declines TErr if the value is TErr, else the let's type IS
      // the body's type. All demands come FIRST, then one tail get-tcol perform + pure combiner (the demands-
      // then-perform shape the fold handles — NOT a perform sandwiched between two demands).
      (let _v = type-of(valId) in (let _b = type-of(bodyId) in let-type(DbState.get-tcol(), valId, bodyId)))
  | Option.Some(Node.NIf(c, t, e)) =>
      // FAITHFUL: demand cond + then + else, then the REAL infer-db if-type over the column. if-type requires a
      // Bool cond and JOINS the branches width-aware (join-branch-types) — so mismatched-width branches decline
      // TErr, which the old stand-in combine-if did not enforce.
      (let _c = type-of(c) in (let _t = type-of(t) in (let _e = type-of(e) in if-type(DbState.get-tcol(), c, t, e))))
  | Option.Some(Node.NMatch(scrutId, litId, thenId, elseId)) =>
      // M1-a integer match: demand all four children (scrut + literal-pattern get compared, then/else branches),
      // then combine — scrut+lit must be non-error, then/else join (mirrors combine-if's discipline). Simplified
      // stand-in like combine-bin/combine-if; the faithful upgrade calls infer-db match-type via get-tcol.
      (let st = type-of(scrutId) in (let lt = type-of(litId) in
        (let tt = type-of(thenId) in (let et = type-of(elseId) in combine-match(st, lt, tt, et)))))
  | Option.Some(Node.NApp(calleeName, argId)) =>
      // slice-2 NULLARY call `(mk)` = NApp(name, -1): its type is the callee BODY's type (beta-reduction over
      // zero args). A RECURSIVE call must NOT descend the body (the demand would loop) — stamp Int64 directly,
      // the 1-step fixpoint (mirror rcdzc infer.rs:157 / infer-db's recursive-nullary slice). A call WITH an
      // arg (argId != -1) is the param slice — not yet covered here → TErr. This is the minimal-correct nullary
      // NApp; the arg-passing + HO-param + ctor-use cases are follow-on increments.
      (if argId == -1 then
         (if DbState.call-recursive(calleeName) then mk-int(true, 64)
          else (match DbState.def-body-node(calleeName) with
            | Option.Some(bodyId) => type-of(bodyId)
            | Option.None(_) => Ty.TyErr))
       else Ty.TyErr)
  | Option.Some(_) => Ty.TyErr
  | Option.None(_) => Ty.TyErr

/// PURE arith combine over the two operand types — the effect-free half (isolates the effect axis to get/set).
/// A faithful spine would call bin-type over the shared tcol; here the operand types are handed in directly.
def combine-bin(op: Int64, lt: Ty, rt: Ty) =
  (if op == 60 then Ty.TyBool
   else (if op == 61 then Ty.TyBool
     else (if op == 62 then Ty.TyBool
       else (match lt with | Ty.TyErr => Ty.TyErr | _ => (match rt with | Ty.TyErr => Ty.TyErr | _ => lt)))))

/// PURE integer-match combine: scrut + literal-pattern must both be non-error (they get compared), then/else
/// join to the branch type. Any TErr child → TErr (simplified stand-in; faithful = infer-db match-type).
def combine-match(st: Ty, lt: Ty, tt: Ty, et: Ty) =
  (match st with | Ty.TyErr => Ty.TyErr
    | _ => (match lt with | Ty.TyErr => Ty.TyErr
      | _ => (match tt with | Ty.TyErr => Ty.TyErr
        | _ => (match et with | Ty.TyErr => Ty.TyErr | _ => tt))))

/// Project the types column out of the Db (for get-tcol — the pure tcol-only combiners read child facts here).
def types-col(db: Db) = match db with | Db.Db(_, _, tc, _) => tc

/// Driver: install ONE handler for the DbState family carrying the whole Db as shared state. Each per-field op
/// reads/writes ONLY its column slice via the existing db.cdz accessors, then resumes threading the (updated)
/// Db. The performer never destructures the Db — only these handler arms do — the finer-grained-ops-over-one-
/// shared-state shape the operator confirmed + v-effects' fold targets.
def run-type-of(db0: Db, root: Int64) =
  handle DbState(db0) with
    | get-ty(id, db) => resume(require-ty(db, id), db)
    | set-ty(pair, db) => (match pair with | (id, t) => resume(unit, fill-ty(db, id, t)))
    | get-resolved(id, db) => resume(require-resolved(db, id), db)
    | node-of(id, db) => resume(node-at(db-tree(db), id), db)
    | def-body-node(name, db) => resume(def-body-of(db-tree(db), name), db)
    | call-recursive(name, db) => resume(call-is-recursive(db-tree(db), name), db)
    | get-tcol(db) => resume(types-col(db), db)
  in
  type-of(root)

export { run-type-of }

// ---- acceptance test exercising the mutual-performer group over the per-field family ----
import { Tok, parse-tokens, empty-tree, add-node, record-def } from "parse-db"
import { is-int-ty } from "ty"
import { resolve-into-db } from "db-resolve"
@test
def pfq-arith() = match parse-tokens([Tok.TNum(1), Tok.TOp(43), Tok.TNum(2)]) with
  | (root, tree) => (let db = resolve-into-db(db-of(tree), root) in (if is-int-ty(run-type-of(db, root)) then unit else trap("int")))

@test
def pfq-match() =
  // NMatch arm: hand-built `match 1 (0 => 10) (_ => 20)` (parse-tokens doesn't build NMatch; hand-build the
  // arena). Exercises the 4-child demand arm under the group fold → an int type. This was the shape that
  // tripped the invalid-wasm emit bug (now fixed by the boundary-name dedup 6431b69a4).
  (match add-node(empty-tree(), Node.NLit(1)) with | (scrutId, t1) =>
    (match add-node(t1, Node.NLit(0)) with | (litId, t2) =>
      (match add-node(t2, Node.NLit(10)) with | (thenId, t3) =>
        (match add-node(t3, Node.NLit(20)) with | (elseId, t4) =>
          (match add-node(t4, Node.NMatch(scrutId, litId, thenId, elseId)) with | (root, tree) =>
            (let db = resolve-into-db(db-of(tree), root) in
              (if is-int-ty(run-type-of(db, root)) then unit else trap("integer match is int"))))))))

@test
def pfq-napp-recursive-nullary() =
  // NApp arm, recursive nullary: `def f() = f()` — the body IS the call NApp(900, -1); record-def keys 900 →
  // that node so call-recursive(900) fires → the spine stamps Int64 WITHOUT descending (the 1-step fixpoint;
  // descending would loop the demand). Mirrors infer-db's recursive-nullary slice. Hand-built (parse-tokens
  // doesn't read def-forms).
  (match add-node(empty-tree(), Node.NApp(900, -1)) with | (callId, t1) =>
    (let tree = record-def(t1, 900, callId) in
     (let db = resolve-into-db(db-of(tree), callId) in
       (if is-int-ty(run-type-of(db, callId)) then unit else trap("recursive nullary call types Int64")))))

@test
def pfq-if-faithful-carries-width() =
  // FAITHFUL if-type upgrade: `if true then (: 5 Int8) else (: 9 Int8)` — both branches Int8, so the real
  // if-type JOINS them to Int8 (width 8), carrying the narrow width. The old combine-if stand-in returned the
  // then-branch type without a width-aware join; this pins that the faithful join preserves the narrow width.
  (match add-node(empty-tree(), Node.NBoolLit(1)) with | (condId, t1) =>
    (match add-node(t1, Node.NAnnLit(5, 1, 8)) with | (thenId, t2) =>
      (match add-node(t2, Node.NAnnLit(9, 1, 8)) with | (elseId, t3) =>
        (match add-node(t3, Node.NIf(condId, thenId, elseId)) with | (root, tree) =>
          (let db = resolve-into-db(db-of(tree), root) in
            (match int-parts-of(run-type-of(db, root)) with
              | (s, w) => (if s and (w == 8) then unit else trap("if with two Int8 branches joins to Int8 width 8"))))))))

@test
def pfq-if-faithful-mismatched-width-declines() =
  // FAITHFUL if-type REJECTS mismatched-width branches: `if true then (: 5 Int8) else (: 9 Int16)` — the
  // branches don't share a ground type, so join-branch-types → TyErr → the if is TyErr. The OLD combine-if
  // stand-in WRONGLY accepted this (returned the then-branch Int8, masking the mismatch). This is the concrete
  // correctness the faithful combiner buys over the stand-in.
  (match add-node(empty-tree(), Node.NBoolLit(1)) with | (condId, t1) =>
    (match add-node(t1, Node.NAnnLit(5, 1, 8)) with | (thenId, t2) =>
      (match add-node(t2, Node.NAnnLit(9, 1, 16)) with | (elseId, t3) =>
        (match add-node(t3, Node.NIf(condId, thenId, elseId)) with | (root, tree) =>
          (let db = resolve-into-db(db-of(tree), root) in
            (match run-type-of(db, root) with
              | Ty.TyErr => unit
              | _ => trap("if with mismatched-width branches Int8 Int16 must decline TyErr")))))))
