/// parse-db.cdz — Increment 1 of the Cadenza-in-Cadenza compiler: the PARSE COLUMN. Source tokens → an
/// AST stored as an ARENA of nodes keyed by a stable `NodeId` (Int64), mirroring rcdzc's arena where every
/// node has an identity (`StructId`) that the downstream query columns (resolve/infer/lower) key by.
///
/// The AST is not a pointer tree but a `Map(NodeId, Node)` where a `Bin` node references its children BY
/// ID — exactly the shape the lazy query-DB needs: a fact about a node is keyed by its id, and a producer
/// walks children by demanding their ids. NodeIds are assigned by a counter threaded through the build
/// (the `fresh`/`anf` discipline), so they are stable and dense (0..n-1) for a given parse.
///
/// The grammar is the integer language the re-charter targets: `Int` literals, variable references, `let
/// NAME = expr in expr` bindings, `+ - *` with precedence (`*` binds tighter than `+`/`-`), and parentheses.
/// `parse-tokens` returns `(rootId, Tree)` — the root node's id plus the arena — so a caller (the compiler
/// driver / the DB's `ast` column) has both the entry point and the store. (This intentionally re-declares
/// its own `Tok`/`Node` rather than importing lex's — lex does not export its `Token` type, and a self-
/// contained column keeps the surface minimal.)
///
/// Inc-2 prep: `let`/variable syntax is added HERE (the parse column) so the upcoming resolve column has real
/// name→binding structure to resolve. Names are interned to an `Int64` name-id (the mirror of a real lexer's
/// string-interning); the grammar now covers the milestone program `let x = 2 in x * 3 + 1`.
/// A token (the lexer's output; here constructed directly by tests / a future lex adapter).
type Tok =
  | TNum(Int64)
  | TBoolTok(Int64) // a boolean literal `true`/`false`, carried as 1/0
  | TName(Int64) // an identifier, interned to a name-id (Int64)
  | TOp(Int64) // 43 = +, 45 = -, 42 = *, 60 = <, 61 = ==
  | TLet
  | TIn
  | TEq // the `=` of a let binding
  | TIf
  | TThen
  | TElse
  | TNeg // the prefix unary minus `-` (distinct from binary `-` = TOp 45)
  | TLParen
  | TRParen
  | TEnd

/// An AST node in the arena. A `Bin` references its operands BY NodeId (not inline) — the arena shape. `NVar`
/// carries a name-id (resolve turns it into a binding); `NLet` carries `(nameId, valueId, bodyId)` — value
/// and body are child NodeIds, so a `let` is a node whose scope the resolve column will walk by id.
type Node =
  | NLit(Int64)
  | NBoolLit(Int64) // NBoolLit(1|0) — a boolean literal true/false
  | NVar(Int64) // NVar(nameId) — a variable reference
  | NBin(Int64, Int64, Int64) // NBin(op, leftId, rightId)
  | NLet(Int64, Int64, Int64) // NLet(nameId, valueId, bodyId)
  | NIf(Int64, Int64, Int64) // NIf(condId, thenId, elseId) — children by id
  | NAnnLit(Int64, Int64, Int64) // NAnnLit(value, signed(1|0), width) — a WIDTH-ANNOTATED int literal
  // `(: v IntN)`; carries its (signed, width) so infer types it TIntW and
  // lower builds a NARROW CNum. Bool-as-Int64 for the signed flag (1|0).
  | NApp(Int64, Int64) // NApp(calleeName, argId) — a function APPLICATION `(f arg)` / `(mk)`.
  // `calleeName` is the callee's NAME-ID (forward-ref: the reader keys the call
  // by name, not the def-body node, so a call to a not-yet-read def is accepted;
  // resolve/infer/lower map name→bodyId via def-body-of AFTER the do-block is
  // recorded). `argId` is the single argument's node, or -1 = the NULLARY-call
  // sentinel `(mk)` (no argument). The nullary slice uses argId = -1 and lowers
  // by inlining the callee body; a param slice (later) lowers `(f a)` to
  // CLet(param, arg, body) — a call binds its param exactly like a let.
  | NMatch(Int64, Int64, Int64, Int64) // M1-a INTEGER MATCH (first match slice): NMatch(scrutId, litId,
  // thenId, elseId) for a TWO-ARM literal-or-wildcard match `(match scrut (LIT
  // then) (_ else))` — scrutinee node, the literal-PATTERN node to compare, the
  // matched-arm body, the wildcard `_`-arm body. LOWERS to CIf(CBin(61 ==, scrut,
  // lit), then, else) — reuses existing Core, so eval/emit need NO new handling.
  // A general N-arm + sum-ctor-pattern match is a later slice; this pins the
  // reader→resolve→infer→lower NMatch pipeline on the simplest shape.
  | NMatchCtor(Int64, Int64, List(Int64), Int64, Int64) // M2-b-2b-ii-c PAYLOAD ctor-pattern arm: NMatchCtor(scrutId,
  // patCtorName, binderIds, bodyId, restId) for `(match scrut ((Ctor x y…) body) REST…)`.
  // binderIds is a LIST (compound-payload: one id per payload field, positionally;
  // a single-binder pattern is [id], a nullary/no-binder pattern is [], a compound is
  // [id0, id1, …], and a `_`-wildcard field is the -1 no-binder SENTINEL at that slot
  // (ignore-field: counts for arity, binds nothing). The reader PRODUCES all of these
  // (multi-binder + wildcard behavior slices LANDED); the schema carries the full list.
  // scrutId = the scrutinee node; patCtorName = the pattern ctor's NAME-id — the
  // SINGLE source of truth (ii-c2b-2, per v-inference): ONE ct-table lookup yields
  // BOTH the ctor's DECL (infer's ctor-decl-of → cross-type reject: scrutinee
  // TSum(decl) vs pattern ctor's decl, tags collide across sums since each restarts
  // at 0 so tag-only matching is unsound) AND its TAG (lower's ctor-tag-of →
  // CMatchSum discriminant). Carrying name-id and deriving both means they cannot
  // drift. binderId = the NVar node the payload binds to (`x`), bound in the body
  // scope; bodyId = the matched-arm body; restId = the next arm (a chain, like NMatch).
  // LOWERS to CMatchSum(scrut, tag, binderIds, body, rest): eval reads the sum
  // handle's store-tag; if == tag, binds payload[i] to binderIds[i] for each field
  // (skipping -1 wildcard slots, consuming the slot either way) + evals body, else
  // rest. Multi-scalar-field (Int<N>/UInt<N>) + wildcard fields all round-trip; a
  // Bool field declines soundly (its VALUE round-trip's rcdzc emit is not-yet-landed).
  | NTuple(List(Int64)) // COMPOUND-VALUE slice (first stage — READER): a positional tuple literal
  // `(tuple e0 e1 …)` → NTuple(elementIds), one node-id per element form in
  // order (a List, like NMatchCtor's binderIds; arbitrary arity). This stage
  // wires ONLY the reader + parse node; resolve/infer/lower/eval/emit have no
  // NTuple arm yet, so a tuple falls to infer's `_ => TyErr` catch-all and
  // run-src DECLINES cleanly (coverage-not-yet, never a miscompile). The
  // TTuple type + CTuple lowering + tuple Value + wasm emit are later stages.
  | NProj(Int64, Int64) // POSITIONAL TUPLE PROJECTION `(. t i)` → NProj(operandId, indexId): read the
  // projected operand FORM (operandId) + the index FORM (indexId, a numeric
  // literal position). STAGE A wires ONLY the reader + parse node; resolve/infer/
  // lower have DECLINE arms (resolve→col, infer→TyErr, lower→None), so `(. t i)`
  // PARSES but run-src DECLINES (coverage-not-yet, never a miscompile — the
  // rcdzc-wasm oracle RUNS a valid projection to a scalar, so a decline is safe).
  // STAGE B (infer the i-th element type + CProj lowering + eval store-payload)
  // makes projection RUN to a scalar. Numeric-index projection matches rcdzc's
  // `(. t <int>)` surface; a non-int index / non-tuple operand / out-of-bounds
  // index all DECLINE (coverage-not-yet; the oracle rejects them CDZ0201).
  | NRecord(List(Int64), List(Int64)) // COMPOUND-VALUE slice — NAMED-FIELD RECORD `(record (f0 v0) (f1 v1) …)`
  // → NRecord(fieldNameIds, valueIds): two PARALLEL positional lists — the field
  // NAME-ids and the field VALUE node-ids, in source order (a field is a
  // `(name value)` pair, read like a `let` binding). STAGE A wires ONLY the reader
  // + parse node; resolve/infer/lower DECLINE an NRecord (resolve→col, infer→TyErr,
  // lower→None) for match totality, so a record literal PARSES but run-src DECLINES
  // (coverage-not-yet, never a miscompile). STAGE B adds a TyRecord type + lowering
  // (likely CCtor(0, values-in-sorted-key-order) reusing the tuple SumStore rep) +
  // eval, and extends NProj so `(. r fieldname)` (a NAME index on a TyRecord) reads
  // the field — the field-access face of the same `.` head tuples project with.
  | NStr(String) // STRINGS frontier (S1): a string literal carrying its BYTES inline as a String
  // (name-ids are one-way hashes, so a literal cannot ride one). infer types it
  // TyString; the reader produces it; lower declines it (no Core string rep yet).
  // Placed LAST so this new variant does NOT shift the discriminant tags of the
  // existing variants (a mid-enum insert regressed the resolve RBound path).
  | NCharLit(Int64) // STRINGS frontier (S-w2a): a CHARACTER literal carrying its Unicode CODEPOINT

// inline. infer types it TyChar; lower emits CNum(codepoint) (a char rides as
// its codepoint Int at runtime, like Bool as 0/1 — no Core/Value char variant).
// The reader const-folds `(String.at <str-lit> <idx-lit>)` to it (S-w2a producer,
// next slice). Placed LAST (after NStr) so no existing discriminant tag shifts.
/// The arena: nodes keyed by NodeId, the next fresh id, a DEF-TABLE (`Map(nameId, bodyNodeId)`), AND a
/// PARAM-TABLE (`Map(nameId, paramNodeId)`) — the module's `(def (name) body)` / `(def (name p) body)` forms,
/// so a call `(name)` resolves its head to the def's body node (user-functions slice-3) and a call `(name arg)`
/// finds the def's single PARAMETER node to key the `CLet(param, arg, body)` a param-call lowers to (slice-3c).
/// (Named `Tree`, NOT `Ast` — a type named `Ast` collides with the built-in metaprog `Ast`, drawing CDZ0201
/// "two types with the same name".) BOTH tables are EMPTY for a bare-token parse (`parse-tokens` — no defs)
/// and populated only by the s-expr module reader (`sread.read-do-form`). The param-table is ADDITIVE: a
/// NULLARY def records only its body (no param entry), so `param-of` returns `None` — preserving slice-2/3b
/// behavior exactly; only a parameterized def (slice-3c) adds a param entry.
/// The 7th table (`ptty`) is the PARAM-TYPE table (narrow-int-enforcement foundation, slice annotation-2):
/// `Map(paramNodeId, encodedType)` where a typed param `(: a Int8)` records its declared `(signed, width)`
/// ENCODED as `width * 2 + signflag` (signflag 1=signed/0=unsigned; width ≤ 64 so the encoding is unambiguous —
/// decode via `pt-width`/`pt-signed`). Keyed by the param NODE-id (the reader has it when it builds the NVar
/// binder; infer's NApp arm has it via `param-of`). ADDITIVE + behavior-neutral: only a recognized int-typed
/// param records an entry, and NOTHING reads it yet (the infer fit-check that DECLINES an out-of-range constant
/// arg — `(f 200)` to an `Int8` param, corpus CDZ0302 — is the next slice). A nullary/untyped param records none.
/// The 8th + 9th tables (`p3`, `a3`) are the THIRD param-table + THIRD arg-table (3-param functions, slice-3e)
/// — `param3-of(nameId)` = a def's 3rd param node, `arg3-of(nAppId)` = a 3-arg call's 3rd arg node, mirroring
/// `p2`/`a2`. A def/call with ≤2 params/args records neither, so `param3-of`/`arg3-of` return `None` (which
/// distinguishes a 2-param/2-arg def/call from a 3-param/3-arg one). The full 3-param pipeline is WIRED (sread
/// `read-third-param` records these; resolve binds param3 in the body scope; `infer-param3` types it; lower
/// nests a 3rd CLet) — so `(def (f a b c) …)` + `(f x y z)` runs. A >3-param signature still declines
/// (`read-third-param` reads exactly one 3rd param then requires `)`); 4+-param is a later slice.
/// The 10th + 11th tables (`p4`, `a4`) are the FOURTH param-table + FOURTH arg-table (4-param functions,
/// slice-3f) — `param4-of(nameId)` = a def's 4th param node, `arg4-of(nAppId)` = a 4-arg call's 4th arg node,
/// mirroring `p3`/`a3`. A def/call with ≤3 params/args records neither → `None` (distinguishes 3 from 4).
/// (NB: the growing per-arity table set is a known trade-off; a List-based N-ary param/arg rep is the
/// eventual idiomatic cleanup — see the queue follow-up. 4 args covers the corpus's widest helpers.)
type Tree =
  | Arena(Map(Int64, Node), Int64, Map(Int64, Int64), Map(Int64, Int64), Map(Int64, Int64), Map(
    Int64,
    Int64
  ), Map(Int64, Int64), Map(Int64, Int64), Map(Int64, Int64), Map(Int64, Int64), Map(Int64, Int64), Map(
    Int64,
    Tuple(Int64, Int64, List(Int64))
  ))

// The 12th table `ct` (M2-b-2b-ii) is the CTOR-TAG table: `Map(ctorNameId,
// (declName, tag, argTypes))` (M2-b TySum: the value is a `(declName, tag,
// List(Int64))` tuple — declName so a ctor use also types `TSum(declName)` not
// just its tag, + argTypes the per-payload-field encoded type LIST, slice-1a/1b)
// for a USER SUM-TYPE constructor (both nullary + payload) recorded by
// read-do-ctors. lower reads it to turn a payload-ctor CALL `(Some 5)` =
// NApp(Some, arg) into `CCtor(tag, args)` (distinguishing it from an over-applied
// nullary def, which has no ct entry). Empty for a bare-token parse; populated
// only by the s-expr `(type …)` reader. ADDITIVE + behavior-neutral until read.
def empty-tree() =
  Tree.Arena(
    Map.empty,
    0,
    Map.empty,
    Map.empty,
    Map.empty,
    Map.empty,
    Map.empty,
    Map.empty,
    Map.empty,
    Map.empty,
    Map.empty,
    Map.empty
  )

/// Intern a node into the arena, returning `(its fresh NodeId, tree')`. The def + param tables ride unchanged.
def add-node(tree: Tree, n: Node) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  (next, Tree.Arena(Map.insert(m, next, n), next + 1, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct))

/// The node at `id`, or `None` (absence — a caller that requires it declines).
def node-at(tree: Tree, id: Int64) =
  let Tree.Arena(m, _, _, _, _, _, _, _, _, _, _, _) = tree in
  Map.lookup(m, id)

/// REPLACE the node at an EXISTING `id` (Map.insert over the node map — NOT a fresh append like add-node).
/// Used by the reader to rewrite an exhaustive no-wildcard match's last arm in place (its poison rest → its
/// own body = an unconditional else). `id` must already exist; a fresh id would just add a detached node.
def set-node(tree: Tree, id: Int64, n: Node) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(Map.insert(m, id, n), next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct)

/// How many nodes the arena holds (also the next fresh id).
def node-count(tree: Tree) =
  let Tree.Arena(m, _, _, _, _, _, _, _, _, _, _, _) = tree in
  Map.len(m)

/// Record a `(def (name) body)` in the def-table: name-id → its body node-id. Returns the updated tree.
/// (The param-tables are untouched — a nullary def has no param; a parameterized def calls `record-param` too.)
def record-def(tree: Tree, nameId: Int64, bodyId: Int64) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(m, next, Map.insert(dt, nameId, bodyId), pt, p2, a2, ptty, p3, a3, p4, a4, ct)

/// The body node-id a def-name binds, or `None` (name not a known def) — a call `(name)` looks its head up here.
def def-body-of(tree: Tree, nameId: Int64) =
  let Tree.Arena(_, _, dt, _, _, _, _, _, _, _, _, _) = tree in
  Map.lookup(dt, nameId)

/// The def-table as a `(nameId, bodyId)` list — for a WHOLE-PROGRAM pass over EVERY top-level def, not just
/// the ones reachable from `main` (e.g. checking an UNCALLED sibling def's body is well-typed: an unbound
/// name in it must still reject, per rcdzc's whole-program scope check).
def def-table-entries(tree: Tree) =
  let Tree.Arena(_, _, dt, _, _, _, _, _, _, _, _, _) = tree in
  Map.to-list(dt)

/// forward-ref RECURSION GUARD (does the subtree at `id` reach a CALL to `target`, within `fuel` steps?).
/// Since a call is now inlined by resolve/infer/lower (they descend into the callee's def-body), a self/mutual
/// recursive call would inline INFINITELY. This bounded static check lets those passes DECLINE a recursive call
/// (keeping recursion a clean decline, as before the reader change) instead of hanging: at an NApp arm, before
/// descending into the callee body `b` (name `cn`), if `subtree-calls-name(tree, b, cn, FUEL)` is true, the call
/// is recursive → decline. `fuel` bounds the whole transitive walk (arena nodes are finite + small; FUEL well
/// above any corpus def's node count guarantees termination while never false-positiving a non-recursive def).
/// Walks the AST children of `id` AND, at each NApp, recurses into the CALLED def's body (transitive/mutual
/// recursion). Returns `(found, fuelLeft)`; `found` = a call to `target` was reached.
def subtree-calls-name(tree: Tree, id: Int64, target: Int64, fuel: Int64) =
  if fuel <= 0 then
    (true, 0) // out of fuel → conservatively treat as recursive (decline, never hang)
  else
    match node-at(tree, id) with
      | Option.Some(Node.NApp(calleeName, argId)) => (
        if calleeName == target then
          (true, fuel - 1) // a direct call to target → recursive
        else
          // else recurse into: this call's ARG(s) + the CALLED def's body (transitive/mutual). arg2/3/4 keyed
          // by this NApp node-id `id`.
          match subtree-calls-name-arg(tree, argId, target, fuel - 1) with
            | (true, fl) => (true, fl)
            | (false, fl) => // scan arg2/arg3/arg4 (PR#785: arg3/arg4 were missed) in sequence, THEN descend the callee
              // body (transitive/mutual). Any arg or the callee body reaching `target` → recursive.
              match subtree-calls-name-opt(tree, arg2-of(tree, id), target, fl) with
                | (true, f2) => (true, f2)
                | (false, f2) =>
                  match subtree-calls-name-opt(tree, arg3-of(tree, id), target, f2) with
                    | (true, f3) => (true, f3)
                    | (false, f3) =>
                      match subtree-calls-name-opt(tree, arg4-of(tree, id), target, f3) with
                        | (true, f4) => (true, f4)
                        | (false, f4) => subtree-calls-callee(tree, calleeName, target, f4)
      )
      | Option.Some(Node.NBin(_, l, r)) => (
        match subtree-calls-name(tree, l, target, fuel - 1) with
          | (true, fl) => (true, fl)
          | (false, fl) => subtree-calls-name(tree, r, target, fl)
      )
      | Option.Some(Node.NLet(_, v, b)) => (
        match subtree-calls-name(tree, v, target, fuel - 1) with
          | (true, fl) => (true, fl)
          | (false, fl) => subtree-calls-name(tree, b, target, fl)
      )
      | Option.Some(Node.NIf(c, t, e)) => (
        match subtree-calls-name(tree, c, target, fuel - 1) with
          | (true, fl) => (true, fl)
          | (false, fl) =>
            match subtree-calls-name(tree, t, target, fl) with
              | (true, f2) => (true, f2)
              | (false, f2) => subtree-calls-name(tree, e, target, f2)
      )
      | Option.Some(Node.NMatch(sc, li, th, el)) => (
        // M1-a: scan all 4 match children for a transitive call
        match subtree-calls-name(tree, sc, target, fuel - 1) with
          | (true, fl) => (true, fl)
          | (false, fl) =>
            match subtree-calls-name(tree, li, target, fl) with
              | (true, f2) => (true, f2)
              | (false, f2) =>
                match subtree-calls-name(tree, th, target, f2) with
                  | (true, f3) => (true, f3)
                  | (false, f3) => subtree-calls-name(tree, el, target, f3)
      )
      | Option.Some(Node.NMatchCtor(sc, _pcn, _bn, bd, rst)) => (
        // M2-b-2b-ii-c: scan scrut/body/rest (patName+binder = no call)
        match subtree-calls-name(tree, sc, target, fuel - 1) with
          | (true, fl) => (true, fl)
          | (false, fl) =>
            match subtree-calls-name(tree, bd, target, fl) with
              | (true, f2) => (true, f2)
              | (false, f2) => subtree-calls-name(tree, rst, target, f2)
      )
      | _ => (false, fuel - 1)

// NLit/NBoolLit/NVar/NAnnLit — no call
/// Helper: an NApp arg is -1 (nullary, no arg) or a node-id to scan.
def subtree-calls-name-arg(tree: Tree, argId: Int64, target: Int64, fuel: Int64) =
  if argId == -1 then (false, fuel) else subtree-calls-name(tree, argId, target, fuel)

/// Helper: scan an OPTIONAL higher-arg slot (arg2/arg3/arg4-of → `Option(Int64)`) for a transitive call to
/// `target`. Absent slot → pass fuel through (false). The arg3/arg4 slots were originally missed (PR#785).
def subtree-calls-name-opt(tree: Tree, argOpt: Option(Int64), target: Int64, fuel: Int64) = match argOpt with
  | Option.Some(a) => subtree-calls-name(tree, a, target, fuel)
  | Option.None(_) => (false, fuel)

/// Helper: recurse into a CALLED def's body (transitive/mutual recursion). Look up `calleeName`'s body; if it
/// reaches `target`, recursion. A name with no def-body (unknown / a param used as a value) contributes nothing.
def subtree-calls-callee(tree: Tree, calleeName: Int64, target: Int64, fuel: Int64) =
  if fuel <= 0 then
    (true, 0)
  else
    match def-body-of(tree, calleeName) with
      | Option.Some(b) => subtree-calls-name(tree, b, target, fuel - 1)
      | Option.None(_) => (false, fuel - 1)

/// Is a call to `calleeName` RECURSIVE (its body transitively calls back to `calleeName`)? The NApp-arm guard
/// resolve/infer/lower use to DECLINE a recursive call rather than inline-hang. `def-body-of` miss → not a call
/// to a known def → not recursive (the unknown-name decline path handles it).
def call-is-recursive(tree: Tree, calleeName: Int64) = match def-body-of(tree, calleeName) with
  | Option.Some(b) =>
    let (found, _) = subtree-calls-name(tree, b, calleeName, 4000) in
    found
  | Option.None(_) => false

/// slice-B1b-p3: does `id`'s subtree call `target` DIRECTLY (a self-call), WITHOUT descending into OTHER
/// callees' bodies? Same structural walk as `subtree-calls-name` but it does NOT follow `subtree-calls-callee`
/// — so `ev`'s body calling `od` is NOT a self-call of `ev` (mutual recursion is excluded). Used only to decide
/// def-env INCLUSION for eval dispatch: a DIRECTLY self-recursive def (fac) runs via the def-env; a merely
/// MUTUALLY-recursive def (ev/od) stays out → its cross-call CCall leaf hits a def-env miss → eval declines
/// cleanly (mutual runtime recursion is out of Slice-B scope). NOT for the lower's cycle-guard, which needs the
/// transitive `call-is-recursive` to avoid inline-hang.
def subtree-calls-self(tree: Tree, id: Int64, target: Int64, fuel: Int64) =
  if fuel <= 0 then
    (false, 0) // out of fuel → NOT self-recursive (conservative for INCLUSION: leave it out)
  else
    match node-at(tree, id) with
      | Option.Some(Node.NApp(calleeName, argId)) => (
        if calleeName == target then
          (true, fuel - 1) // a DIRECT call to target → self-recursive
        else
          // else scan ALL the ARG subtrees (a nested self-call can hide in any arg) — NEVER descend the callee
          // body. arg1 (argId) + arg2/arg3/arg4 keyed by this NApp node-id `id`. arg3/arg4 were originally
          // MISSED (PR#785) → a 3-/4-arg self-recursive call was not detected → decl excluded from def-env →
          // self-recursion wrongly declined. Now each higher arg is scanned in sequence, threading the fuel.
          match subtree-calls-self-arg(tree, argId, target, fuel - 1) with
            | (true, fl) => (true, fl)
            | (false, fl) =>
              match subtree-calls-self-opt(tree, arg2-of(tree, id), target, fl) with
                | (true, f2) => (true, f2)
                | (false, f2) =>
                  match subtree-calls-self-opt(tree, arg3-of(tree, id), target, f2) with
                    | (true, f3) => (true, f3)
                    | (false, f3) => subtree-calls-self-opt(tree, arg4-of(tree, id), target, f3)
      )
      | Option.Some(Node.NBin(_, l, r)) => (
        match subtree-calls-self(tree, l, target, fuel - 1) with
          | (true, fl) => (true, fl)
          | (false, fl) => subtree-calls-self(tree, r, target, fl)
      )
      | Option.Some(Node.NLet(_, v, b)) => (
        match subtree-calls-self(tree, v, target, fuel - 1) with
          | (true, fl) => (true, fl)
          | (false, fl) => subtree-calls-self(tree, b, target, fl)
      )
      | Option.Some(Node.NIf(c, t, e)) => (
        match subtree-calls-self(tree, c, target, fuel - 1) with
          | (true, fl) => (true, fl)
          | (false, fl) =>
            match subtree-calls-self(tree, t, target, fl) with
              | (true, f2) => (true, f2)
              | (false, f2) => subtree-calls-self(tree, e, target, f2)
      )
      | Option.Some(Node.NMatch(sc, li, th, el)) => (
        // M1-a: scan all 4 match children for a DIRECT self-call
        match subtree-calls-self(tree, sc, target, fuel - 1) with
          | (true, fl) => (true, fl)
          | (false, fl) =>
            match subtree-calls-self(tree, li, target, fl) with
              | (true, f2) => (true, f2)
              | (false, f2) =>
                match subtree-calls-self(tree, th, target, f2) with
                  | (true, f3) => (true, f3)
                  | (false, f3) => subtree-calls-self(tree, el, target, f3)
      )
      | Option.Some(Node.NMatchCtor(sc, _pcn, _bn, bd, rst)) => (
        // M2-b-2b-ii-c: scan scrut/body/rest for a self-call
        match subtree-calls-self(tree, sc, target, fuel - 1) with
          | (true, fl) => (true, fl)
          | (false, fl) =>
            match subtree-calls-self(tree, bd, target, fl) with
              | (true, f2) => (true, f2)
              | (false, f2) => subtree-calls-self(tree, rst, target, f2)
      )
      | _ => (false, fuel - 1)

/// Helper: an NApp arg is -1 (nullary) or a node-id to scan for a DIRECT self-call.
def subtree-calls-self-arg(tree: Tree, argId: Int64, target: Int64, fuel: Int64) =
  if argId == -1 then (false, fuel) else subtree-calls-self(tree, argId, target, fuel)

/// Helper: scan an OPTIONAL higher-arg slot (arg2/arg3/arg4-of, which return `Option(Int64)`) for a DIRECT
/// self-call. Absent slot → pass the fuel through unchanged (false). Mirrors infer/lower's optional-arg walk.
def subtree-calls-self-opt(tree: Tree, argOpt: Option(Int64), target: Int64, fuel: Int64) = match argOpt with
  | Option.Some(a) => subtree-calls-self(tree, a, target, fuel)
  | Option.None(_) => (false, fuel)

/// Is `calleeName` DIRECTLY self-recursive (its own body calls itself), as opposed to merely mutually
/// recursive? The def-env inclusion predicate for B1b-p3: only directly-self-recursive defs eval via the
/// def-env; mutual pairs stay out and decline. `def-body-of` miss → not a known def → not self-recursive.
def call-is-self-recursive(tree: Tree, calleeName: Int64) = match def-body-of(tree, calleeName) with
  | Option.Some(b) =>
    let (found, _) = subtree-calls-self(tree, b, calleeName, 4000) in
    found
  | Option.None(_) => false

/// Record a def's FIRST PARAMETER node-id: name-id → its param node-id (slice-3c). A `(name arg)` call looks
/// this up to build `CLet(paramId, argCore, bodyCore)`. Only a PARAMETERIZED def records a param; a nullary
/// def never calls this, so `param-of` stays `None` for it (additive — nullary behavior unchanged).
def record-param(tree: Tree, nameId: Int64, paramId: Int64) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(m, next, dt, Map.insert(pt, nameId, paramId), p2, a2, ptty, p3, a3, p4, a4, ct)

/// The first-parameter node-id a def-name declares, or `None` (a nullary def, or not a known def) — a
/// `(name arg)` call reads this to key the `CLet` binder. Absence = no parameter (nullary), distinct from a value.
def param-of(tree: Tree, nameId: Int64) =
  let Tree.Arena(_, _, _, pt, _, _, _, _, _, _, _, _) = tree in
  Map.lookup(pt, nameId)

/// Record a def's SECOND PARAMETER node-id (multi-param foundation, slice-3d): name-id → its 2nd param node-id.
/// A 2-arg call `(name a b)` reads this to build the NESTED CLet(param1, a, CLet(param2, b, body)). Only a
/// TWO-param def records it; single-param/nullary defs never call this, so `param2-of` stays `None` — ADDITIVE
/// + behavior-preserving (single-param slice-3c unaffected; param2-of None distinguishes 1-param from 2-param).
def record-param2(tree: Tree, nameId: Int64, param2Id: Int64) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(m, next, dt, pt, Map.insert(p2, nameId, param2Id), a2, ptty, p3, a3, p4, a4, ct)

/// The second-parameter node-id a def-name declares, or `None` (a def with < 2 params, or not a known def).
/// Absence = fewer than 2 params (nullary/single), distinct from a value — a 2-arg call reads this for the
/// inner CLet binder.
def param2-of(tree: Tree, nameId: Int64) =
  let Tree.Arena(_, _, _, _, p2, _, _, _, _, _, _, _) = tree in
  Map.lookup(p2, nameId)

/// Record a 2-arg call's SECOND ARGUMENT node-id, keyed by the CALL's NApp NODE-ID (2-arg-call foundation,
/// slice-3d). A `(name a b)` call reads as `NApp(bodyId, arg1)` (carrying arg1) PLUS an arg2-table entry
/// `nAppId → arg2`; lower reads BOTH to build the nested `CLet(param1, arg1, CLet(param2, arg2, body))`. Keyed
/// by the NApp node-id (not name/body) since a callee may be applied at multiple call sites with different
/// args. ADDITIVE: a 1-arg/nullary call records no arg2, so `arg2-of` stays `None` (distinguishes 1-arg from 2-arg).
def record-arg2(tree: Tree, nAppId: Int64, arg2Id: Int64) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(m, next, dt, pt, p2, Map.insert(a2, nAppId, arg2Id), ptty, p3, a3, p4, a4, ct)

/// The second-argument node-id a call (NApp node `nAppId`) carries, or `None` (a 1-arg/nullary call, or not a
/// call). Absence = fewer than 2 args — lower reads this for the inner CLet's value in a 2-arg call.
def arg2-of(tree: Tree, nAppId: Int64) =
  let Tree.Arena(_, _, _, _, _, a2, _, _, _, _, _, _) = tree in
  Map.lookup(a2, nAppId)

/// Record a def's THIRD PARAMETER node-id, keyed by name-id (3-param-function foundation, slice-3e — the
/// mirror of `record-param2`). Only a 3-param def records it; a ≤2-param def never calls this, so `param3-of`
/// stays `None` (distinguishes 2-param from 3-param). ADDITIVE + behavior-neutral until the reader +
/// resolve/infer/lower wiring populates + consumes it. Keyed by name-id like param/param2.
def record-param3(tree: Tree, nameId: Int64, param3Id: Int64) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(m, next, dt, pt, p2, a2, ptty, Map.insert(p3, nameId, param3Id), a3, p4, a4, ct)

/// The THIRD param node-id a def-name declares, or `None` (a ≤2-param def, or not a known def). A 3-arg call
/// `(f a b c)` reads this to key the innermost `CLet(param3, arg3, body)`.
def param3-of(tree: Tree, nameId: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, p3, _, _, _, _) = tree in
  Map.lookup(p3, nameId)

/// Record a 3-arg call's THIRD ARGUMENT node-id, keyed by the CALL's NApp NODE-ID (3-arg-call foundation,
/// slice-3e — the mirror of `record-arg2`). A `(f a b c)` call records `nAppId → arg3`; lower reads it (plus
/// arg2) to build the 3-deep nested CLet. ADDITIVE: a ≤2-arg call records no arg3, so `arg3-of` stays `None`.
def record-arg3(tree: Tree, nAppId: Int64, arg3Id: Int64) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, Map.insert(a3, nAppId, arg3Id), p4, a4, ct)

/// The third-argument node-id a call (NApp node `nAppId`) carries, or `None` (a ≤2-arg call, or not a call).
def arg3-of(tree: Tree, nAppId: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, _, a3, _, _, _) = tree in
  Map.lookup(a3, nAppId)

/// Record a def's FOURTH PARAMETER node-id, keyed by name-id (4-param-function foundation, slice-3f — the
/// mirror of `record-param3`). Only a 4-param def records it; a ≤3-param def never calls this, so `param4-of`
/// stays `None` (distinguishes 3-param from 4-param). ADDITIVE + behavior-neutral otherwise.
def record-param4(tree: Tree, nameId: Int64, param4Id: Int64) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, Map.insert(p4, nameId, param4Id), a4, ct)

/// The FOURTH param node-id a def-name declares, or `None` (a ≤3-param def, or not a known def). A 4-arg call
/// `(f a b c d)` reads this to key the innermost `CLet(param4, arg4, body)`.
def param4-of(tree: Tree, nameId: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, _, _, p4, _, _) = tree in
  Map.lookup(p4, nameId)

/// Record a 4-arg call's FOURTH ARGUMENT node-id, keyed by the CALL's NApp NODE-ID (slice-3f — the mirror of
/// `record-arg3`). A `(f a b c d)` call records `nAppId → arg4`; lower reads it (plus arg2/arg3) to build the
/// 4-deep nested CLet. ADDITIVE: a ≤3-arg call records no arg4, so `arg4-of` stays `None`.
def record-arg4(tree: Tree, nAppId: Int64, arg4Id: Int64) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, Map.insert(a4, nAppId, arg4Id), ct)

/// The fourth-argument node-id a call (NApp node `nAppId`) carries, or `None` (a ≤3-arg call, or not a call).
def arg4-of(tree: Tree, nAppId: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, _, _, _, a4, _) = tree in
  Map.lookup(a4, nAppId)

/// Record a typed param's declared integer type (narrow-int-enforcement foundation, slice annotation-2), keyed
/// by the param NODE-id. The `(signed, width)` is ENCODED as `width * 2 + signflag` (signflag 1=signed,
/// 0=unsigned) into a single Int64 — width ≤ 64 fits, and the encoding round-trips via `pt-width`/`pt-signed`.
/// Only a RECOGNIZED int-typed param records here (sread `read-typed-param-body`); a nullary/untyped param does
/// not, so `param-type-of` stays `None` — ADDITIVE + behavior-neutral (NOTHING reads it yet; the infer fit-check
/// that DECLINES an out-of-range constant arg to a narrow param — corpus CDZ0302 — is the next slice).
def record-param-type(tree: Tree, paramId: Int64, encoded: Int64) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(m, next, dt, pt, p2, a2, Map.insert(ptty, paramId, encoded), p3, a3, p4, a4, ct)

/// The declared int type a typed param carries (ENCODED `width*2+signflag`), or `None` (an untyped/nullary
/// param, or not a param node). Absence = no declared narrow type — the arg's own type flows, as today.
def param-type-of(tree: Tree, paramId: Int64) =
  let Tree.Arena(_, _, _, _, _, _, ptty, _, _, _, _, _) = tree in
  Map.lookup(ptty, paramId)

/// Record a USER SUM-TYPE constructor's TAG (M2-b-2b-ii), keyed by the ctor's name-id. Both nullary AND payload
/// ctors record here (sread `read-do-ctors`); lower reads it to turn a payload-ctor CALL `(Some 5)` into
/// `CCtor(tag, args)` — the ct entry is what DISTINGUISHES a payload-ctor call from an over-applied nullary def
/// (which has a def-body but NO ct entry → the existing decline path). ADDITIVE: only a `(type …)` ctor records.
def record-ctor-tag(tree: Tree, ctorName: Int64, declName: Int64, tag: Int64) =
  record-ctor-tag-typed(tree, ctorName, declName, tag, 0)

/// M2-b-2b-ii-c2b payload-argType variant: record a ctor with its SINGLE payload's DECLARED TYPE `argType`
/// (an encoded int type per encode-param-type, or 0 = none/Int64-placeholder for a nullary ctor or an as-yet-
/// unparsed payload). infer seeds a payload binder from this instead of the Int64 placeholder (non-Int payloads).
/// `record-ctor-tag` is the argType=0 shorthand (unchanged callers). The ct value is (declName, tag, List(Int64)):
/// this single-field shim wraps `argType` as a 1-element list `[argType]` (compound-payload slice-1a — the ct
/// argType is now a per-field LIST; a nullary/1-field ctor is `[argType]`, a multi-field ctor uses the -list
/// variant below). ctor-argtype-of (head-or-0) preserves every existing single-field caller unchanged.
def record-ctor-tag-typed(tree: Tree, ctorName: Int64, declName: Int64, tag: Int64, argType: Int64) =
  record-ctor-tag-typed-list(tree, ctorName, declName, tag, List.push([], argType))

/// compound-payload slice-1a: record a ctor with its per-field payload argType LIST (each element encoded like
/// the single argType: 0=none/Int64, 1=Bool, -1=unsupported, ≥2=int via encode-param-type). A nullary ctor is
/// `[]` (or the single-field shim's `[0]`); a 1-field ctor `[enc]`; a multi-field `(Pair Int64 Bool)` → `[65, 1]`.
/// The ct value's 3rd slot is this list (v-inference t443 steer: co-located tag+argTypes in ONE ct entry, feeds
/// CMatchSum's binder-list positionally). Same 12th arena field, so only the ct accessors change (no arena ripple).
def record-ctor-tag-typed-list(
  tree: Tree,
  ctorName: Int64,
  declName: Int64,
  tag: Int64,
  argTypes: List(Int64)
) =
  let Tree.Arena(m, next, dt, pt, p2, a2, ptty, p3, a3, p4, a4, ct) = tree in
  Tree.Arena(
    m,
    next,
    dt,
    pt,
    p2,
    a2,
    ptty,
    p3,
    a3,
    p4,
    a4,
    Map.insert(ct, ctorName, (declName, tag, argTypes))
  )

/// The TAG of a user sum-type constructor by name-id, or `None` (not a recorded ctor — a normal def/var).
/// lower's NApp arm consults this: `Some tag` + args present → a payload-ctor call → `CCtor(tag, loweredArgs)`.
def ctor-tag-of(tree: Tree, ctorName: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, _, _, _, _, ct) = tree in
  match Map.lookup(ct, ctorName) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(dt2) =>
      let (_declName, tag, _argTypes) = dt2 in
      Option.Some(tag)

/// M2-b-2b-ii-c2b: the DECL NAME-id of the sum type a ctor belongs to, or `None` (not a recorded ctor). infer
/// types a ctor-app/pattern as `TySum(declName)` — this is what gives a ctor VALUE its sum identity so a
/// cross-type ctor pattern (Color.Red vs a Bit scrutinee) is REJECTED (different declName → unify None).
def ctor-decl-of(tree: Tree, ctorName: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, _, _, _, _, ct) = tree in
  match Map.lookup(ct, ctorName) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(dt2) =>
      let (declName, _tag, _argTypes) = dt2 in
      Option.Some(declName)

/// M2-b-2b-ii-c2b payload-argType accessor (SINGLE-FIELD fast path, v-inference t443 refinement): the ENCODED
/// declared type of a ctor's FIRST payload (0 = none/Int64-placeholder — a nullary ctor or an as-yet-unparsed
/// payload), or `None` (not a recorded ctor). infer seeds a single payload binder from this (decode via
/// pt-signed/pt-width) instead of the hardcoded Int64, so a narrow INT payload (an Int8/Int32 binder) types at its
/// declared width. A Bool payload (sentinel 1) now decodes to TBool (the Bool value round-trip is WIRED — a
/// `(BB Bool)` binder types TBool, arith on it still declines); an unsupported payload (-1) DECLINES to TErr.
/// Now that the 3rd ct slot is a LIST (slice-1a), this returns the HEAD-or-0: `[]`→0 (nullary/none), `[enc]`→enc,
/// `[e0, e1…]`→e0 (first field). This preserves EVERY existing single-field caller unchanged — a multi-field
/// consumer uses `ctor-argtypes-of` (the full list) instead.
def ctor-argtype-of(tree: Tree, ctorName: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, _, _, _, _, ct) = tree in
  match Map.lookup(ct, ctorName) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(dt2) =>
      let (_declName, _tag, argTypes) = dt2 in
      match List.at(argTypes, 0) with
        | Option.Some(a0) => Option.Some(a0)
        | Option.None(_) => Option.Some(0)

/// compound-payload slice-1a: the FULL per-field payload argType LIST of a ctor (each element encoded like the
/// single argType), or `None` (not a recorded ctor). A nullary ctor is `[]`/`[0]` (single-field shim), a 1-field
/// ctor `[enc]`, a multi-field `[e0, e1, …]`. infer's multi-binder pattern arm seeds binder[i] from argTypes[i].
def ctor-argtypes-of(tree: Tree, ctorName: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, _, _, _, _, ct) = tree in
  match Map.lookup(ct, ctorName) with
    | Option.None(_) => Option.None(unit)
    | Option.Some(dt2) =>
      let (_declName, _tag, argTypes) = dt2 in
      Option.Some(argTypes)

/// M2-b-2b-ii-c2 ENUM-DISC REPRESENTATION predicate (ii-c2b-2, v-inference-confirmed against rcdzc db.rs:2789):
/// is `declName` a C-style enum — `>= 2` constructors, EVERY one NULLARY (no payload)? Such a sum value carries
/// no data beyond WHICH variant, so it reps as a BARE tag (the ordinal Int it lowers to), NOT a boxed store
/// handle — matching rcdzc's `is_enum_disc` (enum_disc set = decls with ≥2 variants all payload-empty; a
/// single-variant nullary sum is a newtype Unit, a DIFFERENT rep, so the `>= 2` gate is REQUIRED to match the
/// reference — don't drop it). A MIXED sum (any payload ctor) is boxed. Used by eval/export to dispatch a TSum
/// value's rep: an enum-disc-decl TSum IS its bare tag (read directly); a boxed-decl TSum is a store handle.
/// Distinguishes nullary from payload per-ctor via `def-body-of`: a nullary ctor records a def-body (its NLit
/// tag, read-do-ctors) — Some; a payload ctor records only a ct entry — None. Scans the ct-table for the decl's
/// ctors (keyed by ctorName → (declName, tag, argTypes)), counting matches + requiring each nullary.
def decl-is-enum-disc(tree: Tree, declName: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, _, _, _, _, ct) = tree in
  decl-enum-disc-go(tree, Map.to-list(ct), declName, 0, 0, 0)

/// Fold the ct-entry list for `decl-is-enum-disc` by INDEX `i`: `nullary` counts the decl's NULLARY ctors,
/// `payload` its PAYLOAD ctors. Enum-disc iff (payload == 0) AND (nullary >= 2). A payload ctor of the decl
/// makes the rep boxed (any payload → not enum-disc). Index recursion over the (ctorName, (declName, tag, argTypes))
/// entries (no list-tail — the arena has no generic list-tail; `List.at(entries, i)` walks positionally).
def decl-enum-disc-go(
  tree: Tree,
  entries: List(Tuple(Int64, Tuple(Int64, Int64, List(Int64)))),
  declName: Int64,
  i: Int64,
  nullary: Int64,
  payload: Int64
) =
  if i == List.len(entries) then
    if payload == 0 then nullary >= 2 else false
  else
    match List.at(entries, i) with
      | Option.None(_) => if payload == 0 then nullary >= 2 else false
      | Option.Some(e) =>
        let (ctorName, dt) = e in
        let (dn, _tag, _argTypes) = dt in
        if dn == declName then
          match def-body-of(tree, ctorName) with
            // nullary ctor has a def-body; payload doesn't
            | Option.Some(_) =>
              decl-enum-disc-go(tree, entries, declName, i + 1, nullary + 1, payload)
            | Option.None(_) =>
              decl-enum-disc-go(tree, entries, declName, i + 1, nullary, payload + 1)
        else
          decl-enum-disc-go(tree, entries, declName, i + 1, nullary, payload)

/// Count the ctors DECLARED for `declName` (nullary + payload). Mirrors decl-enum-disc-go's ct-table scan but
/// just totals entries whose declName matches. The reader uses it for EXHAUSTIVENESS of a no-wildcard sum/enum
/// match (distinct arm ctors == this count → covers every variant → last arm needs no fall-through).
def decl-ctor-count(tree: Tree, declName: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, _, _, _, _, ct) = tree in
  decl-ctor-count-go(tree, Map.to-list(ct), declName, 0, 0)

/// Index fold for decl-ctor-count: count ct-entries whose declName == `declName` (mirrors decl-enum-disc-go).
def decl-ctor-count-go(
  tree: Tree,
  entries: List(Tuple(Int64, Tuple(Int64, Int64, List(Int64)))),
  declName: Int64,
  i: Int64,
  n: Int64
) =
  if i == List.len(entries) then
    n
  else
    match List.at(entries, i) with
      | Option.None(_) => n
      | Option.Some(e) =>
        let (_ctorName, dt) = e in
        let (dn, _tag, _argTypes) = dt in
        if dn == declName then
          decl-ctor-count-go(tree, entries, declName, i + 1, n + 1)
        else
          decl-ctor-count-go(tree, entries, declName, i + 1, n)

/// gap-B-C registry: is `nameId` the name of a DECLARED type? Every `(type Name …)` records its `Name` name-id
/// as the `declName` VALUE of each of its ctors' ct-entries (record-ctor-tag[-typed-list]), so the set of
/// declared type names = the set of distinct declNames in the ct-table. Scans the ct-entry list for ANY entry
/// whose declName == nameId. WHOLE-PROGRAM: called AFTER the full program is read, so a FORWARD-referenced type
/// (`(type B (Mk A)) (type A …)`) is already registered (matches the oracle: forward refs are valid). Index
/// recursion over the entries (mirrors decl-enum-disc-go). Codegen-note: this fold is at READER time (read-source
/// completion), NOT in the run closure — the guest emit ceiling bounds only the run closure, so a fold here is safe.
def decl-name-registered(tree: Tree, nameId: Int64) =
  let Tree.Arena(_, _, _, _, _, _, _, _, _, _, _, ct) = tree in
  decl-name-registered-go(Map.to-list(ct), nameId, 0)

def decl-name-registered-go(
  entries: List(Tuple(Int64, Tuple(Int64, Int64, List(Int64)))),
  nameId: Int64,
  i: Int64
) =
  if i == List.len(entries) then
    false
  else
    match List.at(entries, i) with
      | Option.None(_) => false
      | Option.Some(e) =>
        let (_ctorName, dt) = e in
        let (dn, _tag, _argTypes) = dt in
        if dn == nameId then true else decl-name-registered-go(entries, nameId, i + 1)

/// Encode a param's declared `(signed, width)` into the single Int64 the param-type table stores: `width*2 +
/// (1 if signed else 0)`. Width ≤ 64, so the low bit is the sign and the rest is the width — unambiguous.
def encode-param-type(signed: Bool, width: Int64) = width * 2 + (if signed then 1 else 0)

/// ii-c2b-2 ctor-argType Bool sentinel: encode-param-type only spans int types (width*2+sign → 2..129); value
/// 1 (width=0, signed bit) is UNUSED + non-colliding, so it's the reserved BOOL encoding for a ctor's payload
/// argType (v-inference's steer). 0 = none/Int64-placeholder, -1 = unsupported (non-int-non-bool), 1 = Bool,
/// ≥2 = an int type. infer decodes 1 → Typed.TBool (the Bool value round-trip is WIRED — a `(BB Bool)` binder
/// types TBool and runs as an `if` cond; Bool is i64 0/1 in Core; arith on it still declines).
/// (This is the ct-argType space ONLY — the param-type table never stores a Bool, so no collision with
/// encode-param-type's consumers there.)
def encode-bool-type() = 1

/// Is an encoded ct-argType the Bool sentinel (value 1)?
def argtype-is-bool(encoded: Int64) = encoded == 1

/// Decode the WIDTH from an encoded param type (`encoded / 2` — the sign is the low bit).
def pt-width(encoded: Int64) = encoded / 2

/// Decode the SIGN from an encoded param type (the low bit: 1 = signed, 0 = unsigned).
def pt-signed(encoded: Int64) = encoded % 2 == 1

/// The token at index `i`, or `TEnd` past the end (a total indexed read).
def tok-at(ts: List(Tok), i: Int64) = match List.at(ts, i) with
  | Option.Some(t) => t
  | Option.None(_) => Tok.TEnd

/// The op code of a token if it is `TOp op`, else `None` (not an operator token). Typed absence, not an
/// in-band `-1`: each caller matches `Some(op)` to dispatch on the operator and `None` to stop (no operator
/// here), so a non-operator can never be mistaken for a real op code.
def op-code(t: Tok) = match t with
  | Tok.TOp(op) => Option.Some(op)
  | _ => Option.None(unit)

/// parse-factor: an Int literal, a boolean literal, a variable reference, or a parenthesized expression. A
/// paren nests the FULL grammar (`parse-any`, so `(let x = 1 in x)` parses). Returns `(nodeId, nextIndex, tree')`.
def parse-factor(ts: List(Tok), i: Int64, tree: Tree) = match tok-at(ts, i) with
  | Tok.TNum(v) =>
    let (id, t1) = add-node(tree, Node.NLit(v)) in
    (id, i + 1, t1)
  | Tok.TBoolTok(b) =>
    let (id, t1) = add-node(tree, Node.NBoolLit(b)) in
    (id, i + 1, t1)
  | Tok.TNeg => // prefix unary minus `-x`, DESUGARED at parse time into `0 - x` = NBin(45, NLit 0, x). No new node type,
    // so resolve/infer/lower/eval need no `NNeg` arm — it is exactly a subtraction. Binds tight (a factor):
    // `-x * 2` = `(-x) * 2`, and `- -x` = `0 - (0 - x)`. Uses NLit 0 as the left operand.
    let (zeroId, t0) = add-node(tree, Node.NLit(0)) in
    let (opnd, j, t1) = parse-factor(ts, i + 1, t0) in
    let (id, t2) = add-node(t1, Node.NBin(45, zeroId, opnd)) in
    (id, j, t2)
  | Tok.TName(nm) =>
    let (id, t1) = add-node(tree, Node.NVar(nm)) in
    (id, i + 1, t1)
  | Tok.TLParen => (
    let (inner, j, t1) = parse-any(ts, i + 1, tree) in
    // consume the matching ')' if present (j points at it); tolerate a missing one.
    match tok-at(ts, j) with
      | Tok.TRParen => (inner, j + 1, t1)
      | _ => (inner, j, t1)
  )
  | _ =>
    let (id, t1) = add-node(tree, Node.NLit(0)) in
    (id, i + 1, t1) // error recovery: 0

/// parse-term: factor ((`*`|`/`|`%`) factor)* — the multiplicative tier, tighter than `+`/`-` and
/// left-associative. Op codes 42 `*`, 47 `/`, 37 `%` all bind here; each builds an `NBin` (op-agnostic), so
/// `/` and `%` join by widening the op test — no new grammar function (SCC-safe).
def parse-term(ts: List(Tok), i: Int64, tree: Tree) =
  let (lhs, j, t1) = parse-factor(ts, i, tree) in
  parse-term-tail(ts, j, lhs, t1)

def parse-term-tail(ts: List(Tok), i: Int64, lhs: Int64, tree: Tree) = match op-code(tok-at(ts, i)) with
  | Option.None(_) => (lhs, i, tree)
  | Option.Some(op) =>
    if op == 42 then
      mul-tail-add(ts, i, lhs, tree, 42)
    else if op == 47 then
      mul-tail-add(ts, i, lhs, tree, 47)
    else if op == 37 then
      mul-tail-add(ts, i, lhs, tree, 37)
    else
      (lhs, i, tree)

def mul-tail-add(ts: List(Tok), i: Int64, lhs: Int64, tree: Tree, op: Int64) =
  let (rhs, j, t1) = parse-factor(ts, i + 1, tree) in
  let (id, t2) = add-node(t1, Node.NBin(op, lhs, rhs)) in
  parse-term-tail(ts, j, id, t2)

/// parse-expr: term ((`+`|`-`) term)* — left-associative additive layer.
def parse-expr(ts: List(Tok), i: Int64, tree: Tree) =
  let (lhs, j, t1) = parse-term(ts, i, tree) in
  parse-expr-tail(ts, j, lhs, t1)

def parse-expr-tail(ts: List(Tok), i: Int64, lhs: Int64, tree: Tree) = match op-code(tok-at(ts, i)) with
  | Option.None(_) => (lhs, i, tree)
  | Option.Some(op) =>
    if op == 43 then
      add-tail(ts, i, lhs, tree, 43)
    else if op == 45 then
      add-tail(ts, i, lhs, tree, 45)
    else
      (lhs, i, tree)

def add-tail(ts: List(Tok), i: Int64, lhs: Int64, tree: Tree, op: Int64) =
  let (rhs, j, t1) = parse-term(ts, i + 1, tree) in
  let (id, t2) = add-node(t1, Node.NBin(op, lhs, rhs)) in
  parse-expr-tail(ts, j, id, t2)

/// parse-any: the top of the grammar — a `let NAME = expr in expr` binding, or a comparison expression. `let`
/// nests `parse-any` in both the value and body positions, so `let a = 1 in let b = 2 in a + b` parses and
/// the body is itself a let node (nested scopes the resolve column will walk by id).
def parse-any(ts: List(Tok), i: Int64, tree: Tree) = match tok-at(ts, i) with
  | Tok.TLet => parse-let(ts, i + 1, tree)
  | Tok.TIf => parse-if(ts, i + 1, tree)
  | _ => parse-cmp(ts, i, tree)

/// parse-if: after the `if` keyword — `COND then <any> else <any>`, building `NIf(condId, thenId, elseId)`.
/// The condition is a comparison expression (`parse-cmp`, so `if x < 2 then …` parses without parens); the
/// branches nest the FULL grammar (`parse-any`, so `if c then let x = 1 in x else 0` and nested ifs parse).
/// Tolerates a missing `then`/`else` (error recovery: parse straight through). All three children are BY ID.
def parse-if(ts: List(Tok), i: Int64, tree: Tree) =
  let (condId, j, t1) = parse-cmp(ts, i, tree) in
  let k = match tok-at(ts, j) with
      | Tok.TThen => j + 1
      | _ => j in
  let (thenId, m, t2) = parse-any(ts, k, t1) in
  let p = match tok-at(ts, m) with
      | Tok.TElse => m + 1
      | _ => m in
  let (elseId, q, t3) = parse-any(ts, p, t2) in
  let (id, t4) = add-node(t3, Node.NIf(condId, thenId, elseId)) in
  (id, q, t4)

/// parse-cmp: the comparison layer — `expr [CMP expr]`, looser than `+`/`-` (so `1 + 2 < 3 + 4` groups the
/// additions under the comparison) and NON-associative (one comparison; a chained second is not an
/// expression). Op codes: 60 `<`, 61 `==`, 62 `>`, 63 `<=`, 64 `>=`, 65 `!=` (all distinct from `TEq`, the
/// let-binding `=`). A comparison builds an `NBin` just like arithmetic; infer gives it `TBool`. Adding the
/// four new relational ops is just more op codes in THIS existing layer — no new grammar function (SCC-safe).
def parse-cmp(ts: List(Tok), i: Int64, tree: Tree) =
  let (lhs, j, t1) = parse-expr(ts, i, tree) in
  match op-code(tok-at(ts, j)) with
    | Option.None(_) => (lhs, j, t1)
    | Option.Some(op) =>
      if op >= 60 then
        if op <= 65 then cmp-tail(ts, j, lhs, t1, op) else (lhs, j, t1)
      else
        (lhs, j, t1)

def cmp-tail(ts: List(Tok), i: Int64, lhs: Int64, tree: Tree, op: Int64) =
  let (rhs, j, t1) = parse-expr(ts, i + 1, tree) in
  let (id, t2) = add-node(t1, Node.NBin(op, lhs, rhs)) in
  (id, j, t2)

/// parse-let: after the `let` keyword — `NAME = <any> in <any>`, building an `NLet(nameId, valueId, bodyId)`.
/// Tolerates a missing `=`/`in` (error recovery: parse straight through). The value and body are children BY
/// ID, matching the arena shape.
def parse-let(ts: List(Tok), i: Int64, tree: Tree) = match tok-at(ts, i) with
  | Tok.TName(nm) =>
    let j = match tok-at(ts, i + 1) with
        | Tok.TEq => i + 2
        | _ => i + 1 in
    let (valId, k, t1) = parse-any(ts, j, tree) in
    let m = match tok-at(ts, k) with
        | Tok.TIn => k + 1
        | _ => k in
    let (bodyId, p, t2) = parse-any(ts, m, t1) in
    let (id, t3) = add-node(t2, Node.NLet(nm, valId, bodyId)) in
    (id, p, t3)
  | _ => parse-expr(ts, i, tree) // recovery: `let` with no name → parse as expression

/// The parse COLUMN entry: tokens → `(rootId, Tree)` — the root node id and the arena. TRAILING-TOKEN GUARD:
/// `parse-any` returns the index it stopped at; if that is NOT the end of the token list, the input had
/// LEFTOVER tokens the grammar couldn't consume (e.g. a CHAINED comparison `1 < 2 < 3` — `parse-cmp` is
/// non-associative, so it parses `1 < 2` and leaves `< 3` dangling). Silently dropping them and running the
/// PREFIX (`1 < 2` → 1) is a wrong outcome — the reference REJECTS `1 < 2 < 3` (bool `<` int), and dropping
/// input fabricates a value that disagrees. So an incomplete parse DECLINES: return an `NVar(0)` poison root
/// (unbound → resolve RPoison → infer TErr → eval None), the same "unsupported → decline, never a partial
/// value" discipline the s-expr reader uses for trailing junk (`se-trailing-junk-declines`). A fully-consumed
/// parse returns its real root unchanged.
def parse-tokens(ts: List(Tok)) =
  let (root, endIdx, tree) = parse-any(ts, 0, empty-tree()) in
  if endIdx == List.len(ts) then
    (root, tree)
  else
    let (poison, t1) = add-node(tree, Node.NVar(0)) in
    (poison, t1)

/// A structural probe: is the node at `id` a `Bin` with op `op`?
def is-bin-op(tree: Tree, id: Int64, op: Int64) = match node-at(tree, id) with
  | Option.Some(Node.NBin(o, _, _)) => o == op
  | _ => false

def is-lit(tree: Tree, id: Int64, v: Int64) = match node-at(tree, id) with
  | Option.Some(Node.NLit(x)) => x == v
  | _ => false

/// Is the node at `id` a variable reference to name-id `nm`?
def is-var(tree: Tree, id: Int64, nm: Int64) = match node-at(tree, id) with
  | Option.Some(Node.NVar(x)) => x == nm
  | _ => false

/// Is the node at `id` a `let` binding name-id `nm`?
def is-let(tree: Tree, id: Int64, nm: Int64) = match node-at(tree, id) with
  | Option.Some(Node.NLet(x, _, _)) => x == nm
  | _ => false

/// Is the node at `id` an `if` node?
def is-if(tree: Tree, id: Int64) = match node-at(tree, id) with
  | Option.Some(Node.NIf(_, _, _)) => true
  | _ => false

/// Is the node at `id` a boolean literal with value `b` (1|0)?
def is-bool-lit(tree: Tree, id: Int64, b: Int64) = match node-at(tree, id) with
  | Option.Some(Node.NBoolLit(x)) => x == b
  | _ => false

/// Is the node at `id` a width-annotated literal `NAnnLit(v, signed(1|0), width)`? Checks value + signed + width.
def is-annlit(tree: Tree, id: Int64, v: Int64, sflag: Int64, width: Int64) = match node-at(tree, id) with
  | Option.Some(Node.NAnnLit(x, s, w)) => x == v and (s == sflag and w == width)
  | _ => false

/// Is the node at `id` a function application `NApp(callee, arg)` with the given callee + arg node-ids?
/// (`arg` = -1 pins a NULLARY call.) The probe downstream columns + tests use to recognize a call node.
def is-app(tree: Tree, id: Int64, callee: Int64, arg: Int64) = match node-at(tree, id) with
  | Option.Some(Node.NApp(c, a)) => c == callee and a == arg
  | _ => false

/// Builders (test ergonomics).
def n(v: Int64) = Tok.TNum(v)

def var(nm: Int64) = Tok.TName(nm)

def plus() = Tok.TOp(43)

def minus() = Tok.TOp(45)

def times() = Tok.TOp(42)

def divop() = Tok.TOp(47)

// `/`
def modop() = Tok.TOp(37)

// `%`
def letkw() = Tok.TLet

def inkw() = Tok.TIn

def eq() = Tok.TEq

def lt() = Tok.TOp(60)

// `<`
def eqop() = Tok.TOp(61)

// `==` (comparison, distinct from the let-binding TEq)
def gt() = Tok.TOp(62)

// `>`
def le() = Tok.TOp(63)

// `<=`
def ne() = Tok.TOp(65)

// `!=`
def ifkw() = Tok.TIf

def thenkw() = Tok.TThen

def elsekw() = Tok.TElse

def truelit() = Tok.TBoolTok(1)

def falselit() = Tok.TBoolTok(0)

def neg() = Tok.TNeg

@test
def pd-single-literal() =
  // "5" → one NLit node, root is it.
  let (root, tree) = parse-tokens([n(5)]) in
  if node-count(tree) == 1 then
    if is-lit(tree, root, 5) then unit else trap("root is Lit 5")
  else
    trap("one node")

@test
def pd-simple-add() =
  // "1 + 2" → NLit 1, NLit 2, NBin(+, ..) ; 3 nodes, root is a + Bin.
  let (root, tree) = parse-tokens([n(1), plus(), n(2)]) in
  if node-count(tree) == 3 then
    if is-bin-op(tree, root, 43) then unit else trap("root is + Bin")
  else
    trap("3 nodes")

@test
def pd-precedence-mul-tighter() =
  // "1 + 2 * 3" → root is + , whose RIGHT child is a * Bin (mul binds tighter). Verify the shape by ids.
  let (root, tree) = parse-tokens([n(1), plus(), n(2), times(), n(3)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NBin(op, _, r)) =>
      if op == 43 then
        if is-bin-op(tree, r, 42) then unit else trap("+ 's right child is * ")
      else
        trap("root is +")
    | _ => trap("root is a Bin")

@test
def pd-parens-override() =
  // "(1 + 2) * 3" → root is * , whose LEFT child is a + Bin (parens grouped the add under the mul).
  let (root, tree) = parse-tokens([Tok.TLParen, n(1), plus(), n(2), Tok.TRParen, times(), n(3)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NBin(op, l, _)) =>
      if op == 42 then
        if is-bin-op(tree, l, 43) then unit else trap("* 's left child is + ")
      else
        trap("root is * ")
    | _ => trap("root is a Bin")

@test
def pd-left-assoc-subtraction() =
  // "10 - 3 - 2" → left-associative: ((10 - 3) - 2), so root is - whose LEFT child is also a - Bin.
  let (root, tree) = parse-tokens([n(10), minus(), n(3), minus(), n(2)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NBin(op, l, _)) =>
      if op == 45 then
        if is-bin-op(tree, l, 45) then unit else trap("left child is the inner - ")
      else
        trap("root is - ")
    | _ => trap("root is a Bin")

@test
def pd-node-ids-stable-and-dense() =
  // node ids are dense 0..n-1: "1 + 2" has 3 nodes at ids 0,1,2 — every id in range resolves to a node.
  let (_, tree) = parse-tokens([n(1), plus(), n(2)]) in
  match node-at(tree, 0) with
    | Option.Some(_) => (
      match node-at(tree, 1) with
        | Option.Some(_) => (
          match node-at(tree, 2) with
            | Option.Some(_) => (
              match node-at(tree, 3) with
                | Option.None(_) => unit
                | Option.Some(_) => trap("no node at 3")
            )
            | Option.None(_) => trap("node at 2")
        )
        | Option.None(_) => trap("node at 1")
    )
    | Option.None(_) => trap("node at 0")

@test
def pd-deep-nesting() =
  // "((1))" → parens collapse to just the literal; one node.
  let (root, tree) = parse-tokens([Tok.TLParen, Tok.TLParen, n(1), Tok.TRParen, Tok.TRParen]) in
  if is-lit(tree, root, 1) then
    if node-count(tree) == 1 then unit else trap("one node")
  else
    trap("root is Lit 1")

@test
def pd-children-by-id-not-inline() =
  // the arena shape: a Bin's children are ID references into the same arena, resolvable via node-at.
  let (root, tree) = parse-tokens([n(7), times(), n(8)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NBin(_, l, r)) =>
      if is-lit(tree, l, 7) then
        if is-lit(tree, r, 8) then unit else trap("right child id → Lit 8")
      else
        trap("left child id → Lit 7")
    | _ => trap("root is a Bin")

@test
def pd-single-var() =
  // "x" (name-id 1) → one NVar node, root is it.
  let (root, tree) = parse-tokens([var(1)]) in
  if node-count(tree) == 1 then
    if is-var(tree, root, 1) then unit else trap("root is Var 1")
  else
    trap("one node")

@test
def pd-let-binding-shape() =
  // "let x = 2 in x" → root is a NLet naming x(=1); its value is NLit 2, its body is NVar x.
  let (root, tree) = parse-tokens([letkw(), var(1), eq(), n(2), inkw(), var(1)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NLet(nm, valId, bodyId)) =>
      if nm == 1 then
        if is-lit(tree, valId, 2) then
          if is-var(tree, bodyId, 1) then unit else trap("body is Var x")
        else
          trap("value is Lit 2")
      else
        trap("let binds name-id 1")
    | _ => trap("root is a Let")

@test
def pd-let-milestone-program() =
  // THE MILESTONE program `let x = 2 in x * 3 + 1`: root is a let of x; its BODY is `x*3+1` = a + Bin whose
  // left is a * Bin (x * 3) and right is Lit 1 — the shape the DB pipeline will resolve/infer/lower/run to 7.
  let (root, tree) = parse-tokens(
      [letkw(), var(1), eq(), n(2), inkw(), var(1), times(), n(3), plus(), n(1)]
    ) in
  match node-at(tree, root) with
    | Option.Some(Node.NLet(nm, valId, bodyId)) =>
      if nm == 1 then
        if is-lit(tree, valId, 2) then
          match node-at(tree, bodyId) with
            | Option.Some(Node.NBin(op, l, r)) =>
              if op == 43 then
                if is-bin-op(tree, l, 42) then
                  if is-lit(tree, r, 1) then unit else trap("+ 's right is Lit 1")
                else
                  trap("+ 's left is a * Bin")
              else
                trap("body root is +")
            | _ => trap("body is a Bin")
        else
          trap("value is Lit 2")
      else
        trap("let binds x")
    | _ => trap("root is a Let")

@test
def pd-nested-let-scopes() =
  // "let a = 1 in let b = 2 in a + b" → root let (a); its BODY is itself a let (b) — nested scopes by id.
  let (root, tree) = parse-tokens(
      [
        letkw(),
        var(1),
        eq(),
        n(1),
        inkw(),
        letkw(),
        var(2),
        eq(),
        n(2),
        inkw(),
        var(1),
        plus(),
        var(2)
      ]
    ) in
  match node-at(tree, root) with
    | Option.Some(Node.NLet(nm, _, bodyId)) =>
      if nm == 1 then
        if is-let(tree, bodyId, 2) then unit else trap("outer let's body is the inner let (b)")
      else
        trap("outer binds a")
    | _ => trap("root is a Let")

@test
def pd-let-in-parens() =
  // "(let x = 5 in x) * 2" → parens let the full grammar (incl. let) nest under an operator: root is a * Bin
  // whose LEFT child is a let node. Proves parse-factor's paren nests parse-any, not just parse-expr.
  let (root, tree) = parse-tokens(
      [Tok.TLParen, letkw(), var(1), eq(), n(5), inkw(), var(1), Tok.TRParen, times(), n(2)]
    ) in
  match node-at(tree, root) with
    | Option.Some(Node.NBin(op, l, _)) =>
      if op == 42 then
        if is-let(tree, l, 1) then unit else trap("* 's left child is a let")
      else
        trap("root is * ")
    | _ => trap("root is a Bin")

@test
def pd-comparison-lt() =
  // "1 < 2" → root is an NBin with op 60 (<).
  let (root, tree) = parse-tokens([n(1), lt(), n(2)]) in
  if is-bin-op(tree, root, 60) then unit else trap("root is a < Bin")

@test
def pd-comparison-looser-than-arith() =
  // "1 + 2 < 3" → root is `<` (op 60) whose LEFT child is a `+` Bin (comparison is looser than additive).
  let (root, tree) = parse-tokens([n(1), plus(), n(2), lt(), n(3)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NBin(op, l, _)) =>
      if op == 60 then
        if is-bin-op(tree, l, 43) then unit else trap("< 's left is a + Bin")
      else
        trap("root is <")
    | _ => trap("root is a Bin")

@test
def pd-equality-op() =
  // "3 == 3" → root is an NBin with op 61 (==), distinct from the let-binding TEq.
  let (root, tree) = parse-tokens([n(3), eqop(), n(3)]) in
  if is-bin-op(tree, root, 61) then unit else trap("root is a == Bin")

@test
def pd-if-shape() =
  // "if 1 < 2 then 10 else 20" → root is an NIf; cond is a < Bin, then/else are the literals.
  let (root, tree) = parse-tokens([ifkw(), n(1), lt(), n(2), thenkw(), n(10), elsekw(), n(20)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NIf(cond, thn, els)) =>
      if is-bin-op(tree, cond, 60) then
        if is-lit(tree, thn, 10) then
          if is-lit(tree, els, 20) then unit else trap("else is Lit 20")
        else
          trap("then is Lit 10")
      else
        trap("cond is a < Bin")
    | _ => trap("root is an NIf")

@test
def pd-if-branches-nest-full-grammar() =
  // "if 1 then let x = 5 in x else 0" → the THEN branch is a let node (branches nest parse-any, not parse-cmp).
  let (root, tree) = parse-tokens(
      [ifkw(), n(1), thenkw(), letkw(), var(1), eq(), n(5), inkw(), var(1), elsekw(), n(0)]
    ) in
  match node-at(tree, root) with
    | Option.Some(Node.NIf(_, thn, _)) =>
      if is-let(tree, thn, 1) then unit else trap("then branch is a let")
    | _ => trap("root is an NIf")

@test
def pd-nested-if-in-else() =
  // "if 1 then 2 else if 3 then 4 else 5" → else-branch is itself an NIf (else-if chaining).
  let (root, tree) = parse-tokens(
      [ifkw(), n(1), thenkw(), n(2), elsekw(), ifkw(), n(3), thenkw(), n(4), elsekw(), n(5)]
    ) in
  match node-at(tree, root) with
    | Option.Some(Node.NIf(_, _, els)) =>
      if is-if(tree, els) then unit else trap("else branch is a nested if")
    | _ => trap("root is an NIf")

@test
def pd-bool-literal-true() =
  // "true" → one NBoolLit(1) node.
  let (root, tree) = parse-tokens([truelit()]) in
  if is-bool-lit(tree, root, 1) then unit else trap("root is NBoolLit 1")

@test
def pd-bool-literal-false() =
  // "false" → NBoolLit(0).
  let (root, tree) = parse-tokens([falselit()]) in
  if is-bool-lit(tree, root, 0) then unit else trap("root is NBoolLit 0")

@test
def pd-bool-in-if-cond() =
  // "if true then 1 else 2" → cond is a bool literal (proves a bool literal parses as a factor in cond pos).
  let (root, tree) = parse-tokens([ifkw(), truelit(), thenkw(), n(1), elsekw(), n(2)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NIf(cond, _, _)) =>
      if is-bool-lit(tree, cond, 1) then unit else trap("cond is bool literal true")
    | _ => trap("root is an NIf")

@test
def pd-unary-minus-desugars-to-sub() =
  // "-5" → NBin(45, NLit 0, NLit 5): unary minus desugars to `0 - 5` (no new node type).
  let (root, tree) = parse-tokens([neg(), n(5)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NBin(op, l, r)) =>
      if op == 45 then
        if is-lit(tree, l, 0) then
          if is-lit(tree, r, 5) then unit else trap("right is Lit 5")
        else
          trap("left is Lit 0")
      else
        trap("op is - (45)")
    | _ => trap("root is a - Bin")

@test
def pd-unary-minus-binds-tight() =
  // "-x * 2" → `(-x) * 2` = NBin(*, NBin(-, 0, x), 2): unary minus is a factor, so it binds tighter than *.
  let (root, tree) = parse-tokens([neg(), var(1), times(), n(2)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NBin(op, l, _)) =>
      if op == 42 then
        if is-bin-op(tree, l, 45) then unit else trap("* 's left is the unary-minus Bin")
      else
        trap("root is *")
    | _ => trap("root is a Bin")

@test
def pd-gt-op() =
  // "3 > 2" → NBin with op 62.
  let (root, tree) = parse-tokens([n(3), gt(), n(2)]) in
  if is-bin-op(tree, root, 62) then unit else trap("root is a > Bin")

@test
def pd-le-op() =
  // "2 <= 3" → NBin with op 63.
  let (root, tree) = parse-tokens([n(2), le(), n(3)]) in
  if is-bin-op(tree, root, 63) then unit else trap("root is a <= Bin")

@test
def pd-ne-looser-than-arith() =
  // "1 + 1 != 3" → root is `!=` (65) whose left is a `+` Bin (relational looser than additive).
  let (root, tree) = parse-tokens([n(1), plus(), n(1), ne(), n(3)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NBin(op, l, _)) =>
      if op == 65 then
        if is-bin-op(tree, l, 43) then unit else trap("!= 's left is a + Bin")
      else
        trap("root is !=")
    | _ => trap("root is a Bin")

@test
def pd-div-op() =
  // "8 / 2" → NBin with op 47.
  let (root, tree) = parse-tokens([n(8), divop(), n(2)]) in
  if is-bin-op(tree, root, 47) then unit else trap("root is a / Bin")

@test
def pd-op-code-is-option() =
  // Pins op-code's Option contract (the B10 sentinel-elimination invariant): a TOp token yields Some(code),
  // any non-operator token yields None — never an in-band -1. Guards the parse-tail dispatch against a future
  // change re-introducing a magic miss value that would be compared as if it were a real op code.
  match op-code(plus()) with
    | Option.Some(c) =>
      if c == 43 then
        match op-code(n(7)) with
          // a number token is not an operator
          | Option.None(_) => (
            match op-code(var(99)) with
              // nor is a name token
              | Option.None(_) => unit
              | Option.Some(_) => trap("a TName token has no op-code (None)")
          )
          | Option.Some(_) => trap("a TNum token has no op-code (None)")
      else
        trap("op-code(TOp 43) = Some(43)")
    | Option.None(_) => trap("op-code of a TOp token is Some(code)")

@test
def pd-mod-same-precedence-as-mul() =
  // "1 + 6 % 4" → root is `+` whose RIGHT is a `%` Bin (% binds tighter than +, same tier as *).
  let (root, tree) = parse-tokens([n(1), plus(), n(6), modop(), n(4)]) in
  match node-at(tree, root) with
    | Option.Some(Node.NBin(op, _, r)) =>
      if op == 43 then
        if is-bin-op(tree, r, 37) then unit else trap("+ 's right is a % Bin")
      else
        trap("root is +")
    | _ => trap("root is a Bin")

// ---- NApp: the function-application node (SLICE-1 foundation for USER FUNCTIONS) ----
// NApp has no producing Tok yet (calls come from the sread s-expr surface, added in a later slice); this
// slice lands the arena NODE + probe as the tested foundation the resolve/infer/lower/eval arms build on.
// Build the arena DIRECTLY (like the lower-db NAnnLit tests).
@test
def pd-nullary-app-node() =
  // a NULLARY call `(mk)` → NApp(bodyId, -1): callee = the def-body node it names, arg = -1 (no argument).
  // Build a body `42` (NLit), then the NApp referencing it. is-app pins the (callee, arg) shape.
  let (bodyId, t1) = add-node(empty-tree(), Node.NLit(42)) in
  let (appId, t2) = add-node(t1, Node.NApp(bodyId, -1)) in
  if is-app(t2, appId, bodyId, -1) then
    unit
  else
    trap("NApp(bodyId, -1) is a nullary application node")

@test
def pd-app-with-arg-node() =
  // a 1-arg call `(f a)` → NApp(bodyId, argId) with a real arg node (argId != -1) — the shape the param
  // slice will lower to CLet(param, arg, body). Here just pins the node carries both child ids.
  let (bodyId, t1) = add-node(empty-tree(), Node.NLit(7)) in
  let (argId, t2) = add-node(t1, Node.NLit(5)) in
  let (appId, t3) = add-node(t2, Node.NApp(bodyId, argId)) in
  if is-app(t3, appId, bodyId, argId) then
    unit
  else
    trap("NApp(bodyId, argId) carries callee + arg")

// ---- def-table (slice-3 foundation for user-functions call resolution) ----
@test
def pd-def-table-empty-by-default() =
  // a fresh tree / a bare-token parse has an EMPTY def-table: def-body-of any name → None (no defs recorded).
  if (match def-body-of(empty-tree(), 1) with
      | Option.None(_) => true
      | Option.Some(_) => false
    ) then
    let (_, tree) = parse-tokens([Tok.TNum(5)]) in
    if (match def-body-of(tree, 1) with
        | Option.None(_) => true
        | Option.Some(_) => false
      ) then
      unit
    else
      trap("token parse has no defs")
  else
    trap("empty-tree def-table is empty")

@test
def pd-record-def-then-lookup() =
  // record a def `name 1 → body node b`, then def-body-of(name 1) returns b; a DIFFERENT name → None.
  let (b, t1) = add-node(empty-tree(), Node.NLit(42)) in
  let t2 = record-def(t1, 1, b) in
  match def-body-of(t2, 1) with
    | Option.Some(x) =>
      if x == b then
        match def-body-of(t2, 2) with
          | Option.None(_) => unit
          | Option.Some(_) => trap("unrecorded name → None")
      else
        trap("def-body-of returns the recorded body")
    | Option.None(_) => trap("a recorded def is found")

@test
def pd-record-param-then-lookup() =
  // slice-3c foundation: the PARAM-TABLE. record-param(name 1 → param node p) then param-of(name 1) = p;
  // an unrecorded name → None. AND the param-table is ORTHOGONAL to the def-table: recording a param does not
  // create a def-body entry, and recording a def does not create a param entry — a nullary def (def-body only)
  // has param-of = None, distinct from a value. Pins the additive param-table a `(name arg)` call reads.
  let (bodyId, t1) = add-node(empty-tree(), Node.NLit(7)) in
  let (paramId, t2) = add-node(t1, Node.NVar(1)) in
  let t3 = record-def(t2, 1, bodyId) in // name 1 = a NULLARY def (body only, no param)
  let t4 = record-param(t3, 2, paramId) in // name 2 = a def with a param (param recorded)
  match param-of(t4, 2) with
    | Option.Some(p) =>
      if p == paramId then
        match param-of(t4, 1) with
          // name 1 is nullary → NO param entry
          | Option.None(_) => (
            match def-body-of(t4, 2) with
              // name 2 recorded a param, NOT a def-body
              | Option.None(_) => unit
              | Option.Some(_) =>
                trap("param-table is orthogonal to def-table (name 2 has no def-body)")
          )
          | Option.Some(_) => trap("a nullary def has NO param entry (param-of → None)")
      else
        trap("param-of returns the recorded param node")
    | Option.None(_) => trap("a recorded param is found")

@test
def pd-record-param2-then-lookup() =
  // multi-param foundation (slice-3d): the SECOND param-table. record-param2(name → p2) then param2-of(name) = p2.
  // ORTHOGONAL to param1: a 2-param def records BOTH param + param2; a SINGLE-param def records only param1 →
  // param2-of = None (distinguishes 1-param from 2-param). ADDITIVE — single/nullary behavior unchanged.
  let (p1, t1) = add-node(empty-tree(), Node.NVar(10)) in
  let (p2, t2) = add-node(t1, Node.NVar(11)) in
  let ta = record-param(t2, 5, p1) in // name 5 = a def; record its 1st param
  let tb = record-param2(ta, 5, p2) in // + its 2nd param → a 2-param def
  match param2-of(tb, 5) with
    | Option.Some(x) =>
      if x == p2 then
        match param-of(tb, 5) with
          // param1 still there (both recorded)
          | Option.Some(y) =>
            if y == p1 then
              match param2-of(tb, 99) with
                // an unrecorded name → None
                | Option.None(_) => unit
                | Option.Some(_) => trap("unrecorded name has no param2")
            else
              trap("param-of still returns param1 for a 2-param def")
          | Option.None(_) => trap("a 2-param def keeps its param1")
      else
        trap("param2-of returns the recorded 2nd param")
    | Option.None(_) => trap("a recorded param2 is found")

@test
def pd-record-arg2-then-lookup() =
  // 2-arg-call foundation (slice-3d): the ARG2-table, keyed by the CALL's NApp NODE-ID. record-arg2(nAppId → arg2)
  // then arg2-of(nAppId) = arg2. A 1-arg/nullary call records no arg2 → arg2-of = None (distinguishes 1-arg from
  // 2-arg). Keyed by node-id (not name) since one callee can be applied at multiple sites with different args.
  let (arg2Id, t1) = add-node(empty-tree(), Node.NLit(2)) in
  let (callId, t2) = add-node(t1, Node.NApp(7, 5)) in // a call node NApp(body=7, arg1=5)
  let t3 = record-arg2(t2, callId, arg2Id) in
  match arg2-of(t3, callId) with
    | Option.Some(x) =>
      if x == arg2Id then
        match arg2-of(t3, 999) with
          // an unrecorded call node → None
          | Option.None(_) => unit
          | Option.Some(_) => trap("unrecorded call node has no arg2")
      else
        trap("arg2-of returns the recorded 2nd arg")
    | Option.None(_) => trap("a recorded arg2 is found")

@test
def pd-record-param3-and-arg3-then-lookup() =
  // 3-param/3-arg foundation (slice-3e): the THIRD param-table + arg3-table, mirroring param2/arg2.
  // record-param3(name → p3) then param3-of(name) = p3; record-arg3(nAppId → arg3) then arg3-of(nAppId) = arg3.
  // A ≤2-param def / ≤2-arg call records neither → param3-of/arg3-of = None (distinguishes 3 from ≤2). ADDITIVE
  // — the record-param2/arg2 (and param/arg) entries are untouched, so 1-/2-param behavior is unchanged.
  let (p3, t1) = add-node(empty-tree(), Node.NVar(3)) in // a 3rd param binder node
  let (arg3Id, t2) = add-node(t1, Node.NLit(9)) in // a 3rd arg node
  let t3 = record-param3(t2, 5, p3) in // name 5 = a def; record its 3rd param
  let t4 = record-arg3(t3, 42, arg3Id) in // NApp node 42 = a call; record its 3rd arg
  match param3-of(t4, 5) with
    | Option.Some(x) =>
      if x == p3 then
        match arg3-of(t4, 42) with
          | Option.Some(y) =>
            if y == arg3Id then
              match param3-of(t4, 99) with
                // an unrecorded name → None
                | Option.None(_) => (
                  match arg3-of(t4, 999) with
                    // an unrecorded call node → None
                    | Option.None(_) => unit
                    | Option.Some(_) => trap("unrecorded call node has no arg3")
                )
                | Option.Some(_) => trap("unrecorded name has no param3")
            else
              trap("arg3-of returns the recorded 3rd arg")
          | Option.None(_) => trap("a recorded arg3 is found")
      else
        trap("param3-of returns the recorded 3rd param")
    | Option.None(_) => trap("a recorded param3 is found")

@test
def pd-param3-arg3-none-when-unrecorded() =
  // a fresh tree (no defs/calls) has NO param3/arg3 for any key → both None (the ≤2-param/arg default, so a
  // 1-/2-param def or call reads None here exactly as before this foundation).
  match param3-of(empty-tree(), 1) with
    | Option.None(_) => (
      match arg3-of(empty-tree(), 1) with
        | Option.None(_) => unit
        | Option.Some(_) => trap("empty tree has no arg3")
    )
    | Option.Some(_) => trap("empty tree has no param3")

@test
def pd-record-param4-and-arg4-then-lookup() =
  // 4-param/4-arg foundation (slice-3f): the FOURTH param-table + arg4-table, mirroring param3/arg3.
  // record-param4(name → p4) then param4-of(name) = p4; record-arg4(nAppId → arg4) then arg4-of(nAppId) = arg4.
  // A ≤3-param def / ≤3-arg call records neither → param4-of/arg4-of = None. ADDITIVE — the param/param2/param3
  // (+ arg2/arg3) entries are untouched, so 1-/2-/3-param behavior is unchanged.
  let (p4, t1) = add-node(empty-tree(), Node.NVar(4)) in // a 4th param binder node
  let (arg4Id, t2) = add-node(t1, Node.NLit(9)) in // a 4th arg node
  let t3 = record-param4(t2, 5, p4) in // name 5 = a def; record its 4th param
  let t4 = record-arg4(t3, 42, arg4Id) in // NApp node 42 = a call; record its 4th arg
  match param4-of(t4, 5) with
    | Option.Some(x) =>
      if x == p4 then
        match arg4-of(t4, 42) with
          | Option.Some(y) =>
            if y == arg4Id then
              match param4-of(t4, 99) with
                // an unrecorded name → None
                | Option.None(_) => (
                  match arg4-of(t4, 999) with
                    // an unrecorded call node → None
                    | Option.None(_) => unit
                    | Option.Some(_) => trap("unrecorded call node has no arg4")
                )
                | Option.Some(_) => trap("unrecorded name has no param4")
            else
              trap("arg4-of returns the recorded 4th arg")
          | Option.None(_) => trap("a recorded arg4 is found")
      else
        trap("param4-of returns the recorded 4th param")
    | Option.None(_) => trap("a recorded param4 is found")

@test
def pd-param4-arg4-none-when-unrecorded() =
  // a fresh tree has NO param4/arg4 → both None (the ≤3-param/arg default).
  match param4-of(empty-tree(), 1) with
    | Option.None(_) => (
      match arg4-of(empty-tree(), 1) with
        | Option.None(_) => unit
        | Option.Some(_) => trap("empty tree has no arg4")
    )
    | Option.Some(_) => trap("empty tree has no param4")

@test
def pd-self-call-in-arg3-detected-pr785() =
  // PR#785 regression pin: a DIRECT self-call nested in a call's 3rd ARG must be detected by subtree-calls-self
  // (so the def is included in the def-env and self-recursion RUNS, not declines). Build `f` (name 900) whose body
  // is `(g a1 a2 (f))` — a call to g (name 901) with the self-call NApp(900,-1) in arg3. subtree-calls-self
  // originally capped at arg2 → this was MISSED. call-is-self-recursive(tree, 900) MUST be true. Pins the arg3 scan.
  let (selfCall, t1) = add-node(empty-tree(), Node.NApp(900, -1)) in // the self-call `(f)` in arg3
  let (a1, t2) = add-node(t1, Node.NLit(1)) in // arg1 (a plain literal)
  let (a2, t3) = add-node(t2, Node.NLit(2)) in // arg2 (a plain literal)
  let (body, t4) = add-node(t3, Node.NApp(901, a1)) in // body = `(g a1 …)`, argId=a1
  let t5 = record-arg2(t4, body, a2) in // its 2nd arg (keyed by the body NApp id)
  let t6 = record-arg3(t5, body, selfCall) in // its 3rd arg = the self-call
  let t7 = record-def(t6, 900, body) in // f (900) body = this call
  if call-is-self-recursive(t7, 900) then
    unit
  else
    trap("a self-call in arg3 is detected → f is directly self-recursive (PR#785)")

@test
def pd-transitive-call-in-arg4-detected-pr785() =
  // PR#785 sibling pin (subtree-calls-name, the TRANSITIVE walker used for lower's recursion cycle-guard): a call
  // back to the target nested in a 4th ARG must be detected. Build `f` (900) whose body is `(g a1 a2 a3 (f))` — a
  // 4-arg call to g with the recursive call NApp(900,-1) in arg4. call-is-recursive(tree, 900) MUST be true (else
  // the cycle-guard would try to INLINE the cycle → inline-hang risk). Pins the arg4 scan of the transitive walker.
  let (recCall, t1) = add-node(empty-tree(), Node.NApp(900, -1)) in // the recursive call `(f)` in arg4
  let (a1, t2) = add-node(t1, Node.NLit(1)) in
  let (a2, t3) = add-node(t2, Node.NLit(2)) in
  let (a3, t4) = add-node(t3, Node.NLit(3)) in
  let (body, t5) = add-node(t4, Node.NApp(901, a1)) in // body = `(g a1 …)`, argId=a1
  let t6 = record-arg2(t5, body, a2) in
  let t7 = record-arg3(t6, body, a3) in
  let t8 = record-arg4(t7, body, recCall) in // its 4th arg = the recursive call
  let t9 = record-def(t8, 900, body) in
  if call-is-recursive(t9, 900) then
    unit
  else
    trap("a recursive call in arg4 is detected by the transitive walker (PR#785)")

@test
def pd-multi-field-ctor-argtypes-list() =
  // compound-payload slice-1a: a MULTI-field ctor records its per-field argType LIST via record-ctor-tag-typed-list,
  // and ctor-argtypes-of returns the whole list. Pair (870) of decl 800, tag 0, fields [Int64-enc, Bool-enc] =
  // [encode-param-type(true,64), encode-bool-type()] = [129, 1]. Pins the co-located per-field List rep (v-inference t443 Q1).
  let ints = List.push(List.push([], encode-param-type(true, 64)), encode-bool-type()) in // [129, 1]
  let tree = record-ctor-tag-typed-list(empty-tree(), 870, 800, 0, ints) in
  match ctor-argtypes-of(tree, 870) with
    | Option.Some(lst) =>
      if List.len(lst) == 2 then
        match List.at(lst, 0) with
          | Option.Some(f0) => (
            match List.at(lst, 1) with
              | Option.Some(f1) =>
                if f0 == encode-param-type(true, 64) and f1 == encode-bool-type() then
                  unit
                else
                  trap("argTypes = [Int64-enc, Bool-enc]")
              | Option.None(_) => trap("field 1 present")
          )
          | Option.None(_) => trap("field 0 present")
      else
        trap("a 2-field ctor records a 2-element argTypes list")
    | Option.None(_) => trap("a recorded multi-field ctor has an argTypes list")

@test
def pd-multi-field-ctor-argtype-of-returns-head() =
  // slice-1a fast-path preservation: ctor-argtype-of (single-field callers) returns the HEAD of the list for a
  // multi-field ctor — so existing single-field consumers read field 0 unchanged (never crash on a multi-field ctor).
  let ints = List.push(List.push([], encode-param-type(true, 64)), encode-bool-type()) in // [129, 1]
  let tree = record-ctor-tag-typed-list(empty-tree(), 871, 800, 0, ints) in
  match ctor-argtype-of(tree, 871) with
    | Option.Some(a0) =>
      if a0 == encode-param-type(true, 64) then
        unit
      else
        trap("ctor-argtype-of returns field 0 (head) of a multi-field ctor")
    | Option.None(_) => trap("a recorded multi-field ctor has a head argType")

@test
def pd-single-field-shim-wraps-as-one-element-list() =
  // slice-1a backward-compat: the single-field shim record-ctor-tag-typed(…, enc) stores [enc], so ctor-argtypes-of
  // is a 1-element list AND ctor-argtype-of returns enc — the exact pre-slice-1a single-field behavior, now via the list.
  let tree = record-ctor-tag-typed(empty-tree(), 872, 800, 0, encode-bool-type()) in // 1-field Bool, shim
  match ctor-argtypes-of(tree, 872) with
    | Option.Some(lst) =>
      if List.len(lst) == 1 then
        match ctor-argtype-of(tree, 872) with
          | Option.Some(a0) =>
            if a0 == encode-bool-type() then unit else trap("head = the Bool sentinel")
          | Option.None(_) => trap("single-field head present")
      else
        trap("the single-field shim stores a 1-element list")
    | Option.None(_) => trap("shim-recorded ctor has an argTypes list")

@test
def pd-nullary-shim-argtype-head-is-zero() =
  // slice-1a: record-ctor-tag (nullary shorthand, argType 0) → [0], so ctor-argtype-of returns 0 (the Int64/none
  // placeholder) exactly as before — a nullary ctor's absent payload still reads 0 through the list head.
  let tree = record-ctor-tag(empty-tree(), 873, 800, 0) in
  match ctor-argtype-of(tree, 873) with
    | Option.Some(a0) => if a0 == 0 then unit else trap("a nullary ctor's argType head is 0")
    | Option.None(_) => trap("nullary ctor recorded")

@test
def pd-record-param-type-then-lookup() =
  // narrow-int-enforcement foundation (slice annotation-2): the PARAM-TYPE table, keyed by the param NODE-id.
  // record-param-type(paramId → encode-param-type(signed, width)) then param-type-of(paramId) round-trips to the
  // same (signed, width) via pt-signed/pt-width. An untyped/unrecorded param → None (the arg's own type flows).
  let (paramId, t1) = add-node(empty-tree(), Node.NVar(1)) in // a param binder node
  let enc = encode-param-type(true, 8) in // Int8 = signed, width 8
  let t2 = record-param-type(t1, paramId, enc) in
  match param-type-of(t2, paramId) with
    | Option.Some(e) =>
      if pt-width(e) == 8 and pt-signed(e) then
        match param-type-of(t2, 999) with
          // an unrecorded param node → None
          | Option.None(_) => unit
          | Option.Some(_) => trap("an unrecorded param has no declared type")
      else
        trap("param-type round-trips to (signed, width=8)")
    | Option.None(_) => trap("a recorded param type is found")

@test
def pd-encode-param-type-unsigned-and-widths() =
  // the encoding `width*2 + signflag` is unambiguous across the width set + both signs: decode round-trips.
  // UInt32 (unsigned, 32) and Int64 (signed, 64) must not collide, and the sign bit reads back correctly.
  let u32 = encode-param-type(false, 32) in
  let i64 = encode-param-type(true, 64) in
  if pt-width(u32) == 32 and (if pt-signed(u32) then false else true) then
    if pt-width(i64) == 64 and pt-signed(i64) then
      if u32 == i64 then trap("distinct (signed,width) must encode distinctly") else unit
    else
      trap("Int64 decodes to signed width 64")
  else
    trap("UInt32 decodes to unsigned width 32")

@test
def pd-trailing-tokens-decline() =
  // TRAILING-TOKEN GUARD: an incomplete parse (leftover tokens the grammar couldn't consume) DECLINES rather
  // than silently dropping the tail + running the prefix. `1 < 2 < 3` — parse-cmp is non-associative, so it
  // parses `1 < 2` and leaves `< 3` dangling; the guard turns the leftover into an NVar(0) poison root (→
  // resolve RPoison → infer TErr → eval None), matching rcdzc's reject (dropping `< 3` + running `1<2`→1 was a
  // fabricated value). Pins the root is the poison Var(0), NOT the `1<2` comparison Bin.
  let (root, tree) = parse-tokens([Tok.TNum(1), Tok.TOp(60), Tok.TNum(2), Tok.TOp(60), Tok.TNum(3)]) in
  if is-var(tree, root, 0) then
    unit
  else
    trap(
      "`1 < 2 < 3` has leftover `< 3` → the root must be the NVar(0) poison (decline), not `1<2`"
    )

@test
def pd-fully-consumed-parse-keeps-its-root() =
  // the guard fires ONLY on leftover tokens: a fully-consumed parse returns its REAL root. `1 < 2` consumes
  // every token → the root is the comparison Bin (op 60), NOT a poison. Pins the guard doesn't over-decline.
  let (root, tree) = parse-tokens([Tok.TNum(1), Tok.TOp(60), Tok.TNum(2)]) in
  if is-bin-op(tree, root, 60) then
    unit
  else
    trap("`1 < 2` consumes all tokens → root is the `<` Bin, not a poison")

// ---- ii-c2b-2 decl-is-enum-disc: the sum-rep predicate (>=2 ctors, all nullary → bare tag; else boxed) ----
// Builds a ct-table directly (record-ctor-tag + record-def for nullary ctors, record-ctor-tag ALONE for payload
// ctors — mirroring read-do-ctors) so the predicate is unit-tested without the s-expr reader. A nullary ctor's
// def-body is what marks it nullary; a payload ctor has a ct entry but no def-body.
@test
def pd-enum-disc-all-nullary-two-plus() =
  // decl 100 with TWO nullary ctors (1→tag0, 2→tag1) — a C-style enum → enum-disc TRUE (bare tag rep).
  let (b0, t1) = add-node(empty-tree(), Node.NLit(0)) in
  let (b1, t2) = add-node(t1, Node.NLit(1)) in
  let t3 = record-def(t2, 1, b0) in // ctor 1 nullary (def-body b0)
  let t4 = record-ctor-tag(t3, 1, 100, 0) in
  let t5 = record-def(t4, 2, b1) in // ctor 2 nullary (def-body b1)
  let t6 = record-ctor-tag(t5, 2, 100, 1) in
  if decl-is-enum-disc(t6, 100) then
    unit
  else
    trap("a decl with >=2 nullary ctors is enum-disc (bare-tag rep)")

@test
def pd-enum-disc-mixed-is-boxed() =
  // decl 200 with a nullary ctor (3→tag0) AND a PAYLOAD ctor (4→tag1, ct entry but NO def-body) → NOT enum-disc
  // (a mixed sum is boxed — any payload ctor makes the rep a store handle).
  let (b0, t1) = add-node(empty-tree(), Node.NLit(0)) in
  let t2 = record-def(t1, 3, b0) in // ctor 3 nullary
  let t3 = record-ctor-tag(t2, 3, 200, 0) in
  let t4 = record-ctor-tag(t3, 4, 200, 1) in // ctor 4 PAYLOAD (ct entry, no record-def)
  if decl-is-enum-disc(t4, 200) then
    trap("a MIXED sum (has a payload ctor) is NOT enum-disc — it's boxed")
  else
    unit

@test
def pd-enum-disc-single-variant-not-enum() =
  // decl 300 with ONE nullary ctor (5→tag0) → NOT enum-disc: the >=2 gate (matches rcdzc — a single-variant
  // nullary sum is a newtype Unit, a DIFFERENT rep). Guards the parity rule that the >=2 requirement is not dropped.
  let (b0, t1) = add-node(empty-tree(), Node.NLit(0)) in
  let t2 = record-def(t1, 5, b0) in
  let t3 = record-ctor-tag(t2, 5, 300, 0) in
  if decl-is-enum-disc(t3, 300) then
    trap("a SINGLE-variant nullary sum is NOT enum-disc (>=2 required, newtype Unit otherwise)")
  else
    unit

// ---- ii-c2b-2 ctor-argtype-of: the ct 3rd slot (payload's declared type; 0 = none/Int64-placeholder) ----
@test
def pd-ctor-argtype-default-zero() =
  // record-ctor-tag (the argType=0 shorthand) records argType 0 → ctor-argtype-of = Some(0) (Int64-placeholder /
  // no declared type). The tag + decl accessors still project correctly from the 3-tuple. Behavior-neutral default.
  let t1 = record-ctor-tag(empty-tree(), 7, 400, 2) in
  match ctor-argtype-of(t1, 7) with
    | Option.Some(a) =>
      if a == 0 then
        match ctor-tag-of(t1, 7) with
          | Option.Some(tg) =>
            if tg == 2 then
              match ctor-decl-of(t1, 7) with
                | Option.Some(dn) => if dn == 400 then unit else trap("decl 400")
                | Option.None(_) => trap("decl present")
            else
              trap("tag 2")
          | Option.None(_) => trap("tag present")
      else
        trap("record-ctor-tag records argType 0 (placeholder)")
    | Option.None(_) => trap("a recorded ctor has an argType slot")

@test
def pd-ctor-argtype-typed-records() =
  // record-ctor-tag-typed records a declared payload type: encode-param-type(false, 1) = a Bool-ish encoding (a
  // non-zero argType). ctor-argtype-of reads it back; tag + decl still project. Pins the typed-payload ct entry.
  let enc = encode-param-type(false, 8) in // an encoded UInt8 (non-zero) as a stand-in payload type
  let t1 = record-ctor-tag-typed(empty-tree(), 8, 500, 0, enc) in
  match ctor-argtype-of(t1, 8) with
    | Option.Some(a) =>
      if a == enc then
        match ctor-tag-of(t1, 8) with
          | Option.Some(tg) => if tg == 0 then unit else trap("tag 0")
          | Option.None(_) => trap("tag present")
      else
        trap("record-ctor-tag-typed records the given argType")
    | Option.None(_) => trap("a typed ctor has its argType")

@test
def pd-ctor-argtype-unrecorded-none() =
  // an UNrecorded ctor name → ctor-argtype-of None (same absence discipline as ctor-tag-of/ctor-decl-of).
  match ctor-argtype-of(empty-tree(), 999) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("an unrecorded ctor has no argType")

