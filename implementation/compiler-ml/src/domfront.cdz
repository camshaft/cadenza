/// domfront.cdz — DOMINANCE FRONTIER, the precise input to SSA φ-function placement. The dominance
/// frontier of a block `N` is the set of blocks `B` where `N`'s dominance "runs out": `N` dominates a
/// PREDECESSOR of `B`, but does NOT strictly dominate `B` itself. Intuitively, `DF(N)` is the set of merge
/// points just beyond `N`'s dominated region — exactly the blocks where a value defined in `N` may need a
/// φ-node because control can also arrive from outside `N`'s region.
///
///   DF(N) = { B : ∃ pred P of B with N dominates P, and N does not strictly dominate B }
///
/// Dominance is computed as in dominators.cdz — `d` dominates `n` iff removing `d` makes `n` unreachable
/// from the entry (`reach-avoiding`). This module is self-contained (it re-derives dominance) so it can be
/// gated alone; it is the bridge from the control-flow analyses to SSA construction.
///
///   - `in-df entry n b`   — is `b` in the dominance frontier of `n`?
///   - `dom-frontier entry n` — the set `DF(n)`.
///   - `df-size` / `iterated-df` — cardinality, and the iterated frontier DF+(S) of a set of defs (the
///     fixpoint that gives the exact φ-placement blocks for a variable defined in the blocks of `S`).

type Term =
  | Return
  | Jump(Int64)
  | CondJump(Int64, Int64)

type Block =
  | Blk(Int64, Term)

def succs(t: Term) = match t with
  | Term.Return => []
  | Term.Jump(a) => [a]
  | Term.CondJump(a, b) => [a, b]

def find-block(bs: List(Block), id: Int64) = match bs with
  | [] => Option.None(unit)
  | [b, .. r] => (match b with | Block.Blk(i, t) => if i == id then Option.Some(t) else find-block(r, id))

def list-has(xs: List(Int64), y: Int64) = match xs with
  | [] => false
  | [h, .. t] => if h == y then true else list-has(t, y)

def reach-avoiding(bs: List(Block), avoid: Int64, work: List(Int64), seen: Set(Int64)) = match work with
  | [] => seen
  | [id, .. rest] =>
    if id == avoid then reach-avoiding(bs, avoid, rest, seen)
    else (if Set.contains(seen, id) then reach-avoiding(bs, avoid, rest, seen)
      else (match find-block(bs, id) with
        | Option.None(_) => reach-avoiding(bs, avoid, rest, Set.insert(seen, id))
        | Option.Some(t) => reach-avoiding(bs, avoid, List.concat(succs(t), rest), Set.insert(seen, id))))

def reachable(bs: List(Block), entry: Int64) = reach-avoiding(bs, 0 - 1, [entry], Set.of([]))

/// `d` dominates `n`: self always; else `n` reachable and removing `d` makes `n` unreachable.
def dominates(bs: List(Block), entry: Int64, d: Int64, n: Int64) =
  if d == n then true
  else (if Set.contains(reachable(bs, entry), n) == false then false
    else Set.contains(reach-avoiding(bs, d, [entry], Set.of([])), n) == false)

def strictly-dom(bs: List(Block), entry: Int64, d: Int64, n: Int64) =
  ((d == n) == false) and dominates(bs, entry, d, n)

/// Predecessors of `b` — blocks whose terminator lists `b` as a successor.
def preds-of(rest: List(Block), b: Int64, acc: List(Int64)) = match rest with
  | [] => acc
  | [x, .. more] => (match x with | Block.Blk(id, t) =>
    preds-of(more, b, (if list-has(succs(t), b) then List.concat([id], acc) else acc)))

def dominates-any(bs: List(Block), entry: Int64, n: Int64, ps: List(Int64)) = match ps with
  | [] => false
  | [p, .. rest] => if dominates(bs, entry, n, p) then true else dominates-any(bs, entry, n, rest)

/// Is `b` in the dominance frontier of `n` — `n` dominates a pred of `b`, but not strictly `b`?
def in-df(bs: List(Block), entry: Int64, n: Int64, b: Int64) =
  dominates-any(bs, entry, n, preds-of(bs, b, [])) and (strictly-dom(bs, entry, n, b) == false)

/// The dominance frontier of `n`: the set of block ids `b` with `in-df`.
def dom-frontier(bs: List(Block), entry: Int64, n: Int64) = df-scan(bs, bs, entry, n, Set.of([]))

def df-scan(all: List(Block), rest: List(Block), entry: Int64, n: Int64, acc: Set(Int64)) = match rest with
  | [] => acc
  | [b, .. more] => (match b with | Block.Blk(bid, _) =>
    df-scan(all, more, entry, n, (if in-df(all, entry, n, bid) then Set.insert(acc, bid) else acc)))

def df-size(bs: List(Block), entry: Int64, n: Int64) = Set.len(dom-frontier(bs, entry, n))

/// The ITERATED dominance frontier DF+(S) of a set of def-blocks `S`: the fixpoint of unioning each block's
/// frontier, adding the frontiers of newly-found blocks too. This is exactly the set of blocks needing a
/// φ-node for a variable defined in the blocks of `S`. Fuel bounds the iteration (≤ block count).
def iterated-df(bs: List(Block), entry: Int64, defs: List(Int64)) =
  idf(bs, entry, defs, Set.of([]), List.len(bs))

def idf(bs: List(Block), entry: Int64, work: List(Int64), acc: Set(Int64), fuel: Int64) = match work with
  | [] => acc
  | [n, .. rest] =>
    let fr = dom-frontier(bs, entry, n) in
    let new-ids = Set.to-list(fr) in
    let acc2 = union-list(new-ids, acc) in
    // add frontier blocks not yet processed to the worklist (bounded by fuel)
    (if fuel <= 0 then acc2 else idf(bs, entry, List.concat(fresh-of(new-ids, acc), rest), acc2, fuel - 1))

def fresh-of(ids: List(Int64), acc: Set(Int64)) = match ids with
  | [] => []
  | [h, .. t] => if Set.contains(acc, h) then fresh-of(t, acc) else List.concat([h], fresh-of(t, acc))

def union-list(ids: List(Int64), acc: Set(Int64)) = match ids with
  | [] => acc
  | [h, .. t] => union-list(t, Set.insert(acc, h))

/// Builders.
def blk(id: Int64, t: Term) = Block.Blk(id, t)

@test
def df-diamond-merge() =
  // diamond 0→cond(1,2); 1→3; 2→3; 3→ret. DF(1) = {3} (the merge); DF(2) = {3}.
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Jump(3)), blk(2, Term.Jump(3)), blk(3, Term.Return)] in
  if df-size(bs, 0, 1) == 1 then
    (if in-df(bs, 0, 1, 3) then (if df-size(bs, 0, 2) == 1 then unit else trap("DF(2)={3}")) else trap("3 in DF(1)"))
  else trap("DF(1) has one block")

@test
def df-entry-empty() =
  // the entry dominates everything → its dominance never "runs out" → DF(entry) is empty.
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Jump(3)), blk(2, Term.Jump(3)), blk(3, Term.Return)] in
  if df-size(bs, 0, 0) == 0 then unit else trap("DF(entry) is empty")

@test
def df-merge-empty() =
  // the merge block 3 dominates nothing beyond itself → DF(3) empty.
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Jump(3)), blk(2, Term.Jump(3)), blk(3, Term.Return)] in
  if df-size(bs, 0, 3) == 0 then unit else trap("DF(merge) is empty")

@test
def df-linear-all-empty() =
  // a straight line 0→1→2 has no merge points → every DF empty.
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.Jump(2)), blk(2, Term.Return)] in
  if df-size(bs, 0, 0) == 0 then (if df-size(bs, 0, 1) == 0 then unit else trap("DF(1) empty")) else trap("linear: all DF empty")

@test
def df-loop-header-self() =
  // loop 0→1; 1→cond(1,2); 2→ret. The header 1 has a back edge to itself → DF(1) contains 1 (a value
  // defined in the loop body needs a φ at the header). Here 1's pred includes 1 (self back edge); 1 does
  // not strictly dominate itself → 1 ∈ DF(1).
  let bs = [blk(0, Term.Jump(1)), blk(1, Term.CondJump(1, 2)), blk(2, Term.Return)] in
  if in-df(bs, 0, 1, 1) then unit else trap("loop header is in its own dominance frontier")

@test
def df-iterated-single-def() =
  // DF+({1}) in the diamond = {3} (one round: DF(1)={3}, DF(3)={} → fixpoint).
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Jump(3)), blk(2, Term.Jump(3)), blk(3, Term.Return)] in
  let idf = iterated-df(bs, 0, [1]) in
  if Set.len(idf) == 1 then (if Set.contains(idf, 3) then unit else trap("3 in DF+")) else trap("DF+({1}) = {3}")

@test
def df-iterated-both-arms() =
  // DF+({1,2}) = {3} (both arms' frontiers are the merge; union = {3}).
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Jump(3)), blk(2, Term.Jump(3)), blk(3, Term.Return)] in
  let idf = iterated-df(bs, 0, [1, 2]) in
  if Set.len(idf) == 1 then (if Set.contains(idf, 3) then unit else trap("3")) else trap("DF+({1,2}) = {3}")

@test
def df-nested-diamond-stops-at-dominated-merge() =
  // two stacked diamonds: 0→c(1,2); 1→3; 2→3; 3→c(4,5); 4→6; 5→6; 6→ret.
  // DF(1)={3}. The SECOND merge 6 is STRICTLY DOMINATED by 3 (every path to 6 goes through 3), so 6 is NOT
  // in DF(3) — a value defined in 1 that flows through 3 needs a φ only at 3, not again at 6 (3 already
  // merged it). So DF+({1}) = {3} exactly — the iteration does NOT spuriously add the dominated merge 6.
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Jump(3)), blk(2, Term.Jump(3)),
            blk(3, Term.CondJump(4, 5)), blk(4, Term.Jump(6)), blk(5, Term.Jump(6)), blk(6, Term.Return)] in
  let idf = iterated-df(bs, 0, [1]) in
  if Set.contains(idf, 3) then (if Set.contains(idf, 6) then trap("6 is dominated by 3, not in DF+") else (if Set.len(idf) == 1 then unit else trap("DF+ = {3}"))) else trap("3 in DF+")

@test
def df-def-in-both-merges-iterates() =
  // to exercise the ITERATION genuinely: define the var in blocks {1, 4}. DF({1})={3}, DF({4})={6}. The
  // iterated frontier is the union {3, 6}. (Two independent merges, each fed by a def.)
  let bs = [blk(0, Term.CondJump(1, 2)), blk(1, Term.Jump(3)), blk(2, Term.Jump(3)),
            blk(3, Term.CondJump(4, 5)), blk(4, Term.Jump(6)), blk(5, Term.Jump(6)), blk(6, Term.Return)] in
  let idf = iterated-df(bs, 0, [1, 4]) in
  if Set.len(idf) == 2 then (if Set.contains(idf, 3) then (if Set.contains(idf, 6) then unit else trap("6")) else trap("3")) else trap("DF+({1,4}) = {3,6}")

export { in-df, dom-frontier, df-size, iterated-df }
