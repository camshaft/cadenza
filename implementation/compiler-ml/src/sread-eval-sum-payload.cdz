/// sread-eval-sum-payload.cdz — the PAYLOAD/DECONSTRUCTION half of the sum end-to-end tests, split from
/// sread-eval-sum.cdz (throughput: sread-eval-sum was the heaviest remaining run-src file at 43 @tests). This
/// file holds the payload-pattern / multifield / wildcard-binder / Bool-payload / cross-type-reject / nested
/// cohort (ss-payload-pattern-binds-and-reads … ss-int-payload-binder-still-runs); sread-eval-sum.cdz keeps the
/// construction / nullary / enum-tag / basic-ctor-match cohort. Same run-src engine (imported from sread-eval),
/// so every @test is behavior-identical to before the split — only the file boundary moved. Sibling auto-discovered.
import { run-src } from "sread-eval"

@test
def ss-payload-pattern-binds-and-reads() =
  // match (Some 5) ((Some x) x) (_ 0) → 5. Construct Some 5 (CCtor→handle), match on its tag, bind payload[0]=5
  // to x, eval the body x → 5. THE payoff: a payload sum round-trips through construct + deconstruct.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 5) ((Some x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 5 then unit else trap("(match (Some 5) ((Some x) x)(_ 0)) → 5")
    | Option.None(_) => trap("a payload ctor pattern binds + reads its payload")

@test
def ss-payload-pattern-arith-on-binding() =
  // the bound payload is an ordinary value: match (Some 20) ((Some x) (+ x 1)) (_ 0) → 21.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 20) ((Some x) (+ x 1)) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 21 then unit else trap("(Some 20) bound x, x+1 → 21")
    | Option.None(_) => trap("arith on a bound payload runs")

@test
def ss-narrow-int-payload-binds-typed() =
  // ii-c2b-2 ct-argType: a NARROW-int payload `(Wrap Int8)` records its declared type in the ct table; infer
  // seeds the pattern binder as Int8 (via ctor-argtype-of) instead of the Int64 placeholder. match (Wrap 5)
  // ((Wrap x) (+ x 1)) (_ 0) → 6 — the Int8 binder computes normally (x=5, x+1). Pins the reader records the
  // payload int type + infer reads it (an Int8 binder still round-trips; the type is now the DECLARED narrow one).
  match run-src(
      "(do (type W (Wrap Int8)) (def (main) (match (Wrap 5) ((Wrap x) (+ x 1)) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 6 then unit else trap("(Wrap 5) Int8 payload binds x=5, x+1 → 6")
    | Option.None(_) => trap("a narrow-int payload binds its binder as the declared type + runs")

@test
def ss-payload-pattern-falls-to-wildcard() =
  // scrutinee tag differs from the pattern's ctor → the wildcard arm. match (None) ((Some x) x) (_ 99) → 99
  // (None is tag 1, the Some pattern is tag 0 → mismatch → wildcard). Pins the CMatchSum else-path.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (None) ((Some x) x) (_ 99))) (export main))"
    ) with
    | Option.Some(v) => if v == 99 then unit else trap("(None) vs (Some x) pattern → wildcard → 99")
    | Option.None(_) => trap("a payload-pattern tag mismatch takes the wildcard arm")

@test
def ss-mixed-payload-and-nullary-arms-compose() =
  // the realistic Option idiom: ONE match with BOTH a payload arm `((Some x) …)` AND a nullary arm `(None …)`
  // over the same MIXED sum — proving they compose in one N-arm chain (both read the boxed handle: the Some arm
  // via CMatchSum binding payload[0], the None arm via CMatchSum on its tag). match (Some 8) ((Some x) (+ x 1))
  // (None 0) → 9 (Some arm binds x=8, x+1). The None sibling being present must not disturb the Some match.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 8) ((Some x) (+ x 1)) (None 0) (_ 5))) (export main))"
    ) with
    | Option.Some(v) => if v == 9 then
      unit
    else
      trap("mixed Some+None arms: (Some 8) → Some arm x+1 → 9")
    | Option.None(_) => trap(
      "a match with both a payload arm and a nullary arm over a mixed sum runs"
    )

@test
def ss-mixed-nullary-arm-hits-on-none() =
  // the complement: the SAME match shape, scrutinee (None) → the None arm (tag 1), NOT the Some arm (tag 0).
  // match (None) ((Some x) (+ x 1)) (None 77) → 77. Pins the nullary arm of a mixed match fires on its own tag.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (None) ((Some x) (+ x 1)) (None 77) (_ 5))) (export main))"
    ) with
    | Option.Some(v) => if v == 77 then unit else trap("mixed match on (None) → the None arm → 77")
    | Option.None(_) => trap("the nullary arm of a mixed payload+nullary match fires on (None)")

@test
def ss-payload-ctor-in-helper-roundtrip() =
  // construct in one def, deconstruct in main: (def (mk) (Some 7)) ; match (mk) ((Some x) x) (_ 0) → 7.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (mk) (Some 7)) (def (main) (match (mk) ((Some x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 7 then unit else trap("(mk)=Some 7, match ((Some x) x) → 7")
    | Option.None(_) => trap("a payload sum constructed in a helper deconstructs in main")

// ---- PR#835 reader-correctness: an unknown-ctor or no-binder ctor-pattern arm DECLINES cleanly ----
// read-ctor-pattern-arm's decline path must skip the WHOLE arm (pattern + body + arm close) so the remaining
// arms + the enclosing (match …) still parse — the decline surfaces as None (poison), NEVER a mis-parse of the
// later arms or a fabricated value. Two shapes: (1) an UNKNOWN ctor in a payload-shaped pattern; (2) a payload
// ctor pattern with NO binder `((Some) body)` (previously a silent empty-name NVar).
@test
def ss-ctor-pattern-unknown-ctor-declines-cleanly() =
  // ((Nope x) …) — Nope is not a recorded ctor → decline. The trailing (_ 0) arm follows the declined arm; the
  // fix's whole-arm skip means the reader still reaches it and the match declines (None), not a corrupt parse.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 5) ((Nope x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap(
      "an unknown-ctor pattern arm must DECLINE (None), never fabricate a value"
    )
    | Option.None(_) => unit

@test
def ss-ctor-pattern-no-binder-declines-cleanly() =
  // ((Some) x) — a payload ctor pattern with NO binder → decline (doc: "ctor with NO binder → decline"), rather
  // than silently binding an empty-name NVar. The following (_ 0) arm is still reached; result is a clean None.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 5) ((Some) 1) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap(
      "a no-binder ctor pattern arm must DECLINE (None), never bind an empty name"
    )
    | Option.None(_) => unit

// ---- payload ctor-pattern match ARMS must JOIN (an infer soundness fix) ----
// The NMatchCtor infer arm previously took the body arm's type unconditionally, ignoring the rest/else arm — so
// a match with mismatched arm types (Int body vs Bool else) typed as Int instead of declining. Now the arms
// join like the integer NMatch / if: an Int body under a Bool else → TErr → the program declines (None).
@test
def ss-payload-pattern-arm-type-mismatch-declines() =
  // match (Some 5) ((Some x) x) (_ true) — body arm is Int (x), else arm is Bool (true). The arms don't join →
  // TErr → decline (None). Guards the arm-join in the NMatchCtor infer arm.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 5) ((Some x) x) (_ true))) (export main))"
    ) with
    | Option.Some(_) => trap(
      "a payload-pattern match with mismatched arm types (Int body / Bool else) must DECLINE"
    )
    | Option.None(_) => unit

@test
def ss-payload-pattern-arms-join-still-runs() =
  // the join is NON-regressive: matching arms (both Int) still type + run. match (Some 5) ((Some x) x) (_ 0) → 5
  // (already pinned by ss-payload-pattern-binds-and-reads, restated here as the positive side of the join guard).
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 9) ((Some x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 9 then unit else trap("matching Int arms join + run → 9")
    | Option.None(_) => trap("a payload-pattern match with joining Int arms must still run")

// ---- MULTI-FIELD payload ctors: CONSTRUCT + deconstruct (arg-N infer wired) ----
// The multi-field payload slice IS wired: infer types ALL payload args (arg2/3/4-of, not just arg1), so a
// multi-field ctor `(P Int64 Int64)` types + lowers (lower-rec-args gathers arg2/3/4 into the CCtor) + runs —
// (P 3 4) constructs a store handle, and `((P x y) …)` binds both fields. The tests below pin CONSTRUCT (bare),
// const-both-binders, runtime-boxed, + the `_`-wildcard binder (a -1-sentinel field types nothing). (This header
// formerly said multi-field DECLINES — stale pre-arg-N-infer; corrected.)
@test
def ss-multifield-payload-ctor-bare-constructs() =
  // (P 3 4) as main's result — a 2-field payload construct now CONSTRUCTS + runs (returns the store HANDLE),
  // exactly like the single-field `(Some 5)` bare result in ss-payload-ctor-USE-constructs. The arg-N infer fix
  // (type ALL payload args, not just arg1) makes multi-field construction TYPE+LOWER consistently with single-
  // field; the earlier "decline" was an ACCIDENT of the infer gap (arg2 untyped → didn't lower), NOT a designed
  // result-boundary check. So (P 3 4) is in-subset and runs (opaque handle value; a match arm reads it back).
  match run-src("(do (type Pair (P Int64 Int64)) (def (main) (P 3 4)) (export main))") with
    | Option.Some(_) => unit
    | Option.None(_) => trap(
      "a 2-field payload ctor (P 3 4) now constructs + runs (handle), like single-field (Some 5)"
    )

@test
def ss-multifield-payload-ctor-const-both-binders() =
  // BEHAVIOR slice (multi-binder): (match (P 3 4) ((P x y) (+ x y)) (_ 0)) — construct a 2-field payload, deconstruct
  // BOTH binders positionally (x←payload[0]=3, y←payload[1]=4), body (+ x y) → 7. CONST scrutinee (interpreter path).
  match run-src(
      "(do (type Pair (P Int64 Int64)) (def (main) (match (P 3 4) ((P x y) (+ x y)) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 7 then
      unit
    else
      trap("(P 3 4) matched ((P x y) (+ x y)) must bind x=3,y=4 → 7")
    | Option.None(_) => trap(
      "a 2-field payload ctor with a 2-binder pattern must RUN (behavior slice), not decline"
    )

@test
def ss-multifield-payload-ctor-runtime-boxed() =
  // 🪤 THE COMPILED-GATE WITNESS (v-inference mandate): a RUNTIME + BOXED multi-binder round-trip that CANNOT fold —
  // scrutinee `(if (> n 0) (P 3 4) (P 10 20))` is a runtime branch over a MULTI-VARIANT-ish boxed sum (both arms build
  // a store handle), so const-fold + newtype-erasure can't collapse it; the payload must actually store→extract both
  // fields. n=1 → (> 1 0) true → (P 3 4) → ((P x y) (+ x y)) → 7. run-src is the INTERPRETER check here (necessary,
  // not sufficient); the COMPILED path (rcdzc→wasm) is exercised by pr-sync's `cdz test` gate on this file — that is
  // the real value-feature verification (interpreter tolerates i64-as-anything; compiled store/extract is the true test).
  match run-src(
      "(do (type Pair (P Int64 Int64)) (def (go n) (match (if (> n 0) (P 3 4) (P 10 20)) ((P x y) (+ x y)) (_ 0))) (def (main) (go 1)) (export main))"
    ) with
    | Option.Some(v) => if v == 7 then
      unit
    else
      trap("runtime-boxed (P 3 4) via (if n>0) → ((P x y) (+ x y)) must round-trip both fields → 7")
    | Option.None(_) => trap(
      "a runtime-boxed 2-field payload multi-binder match must RUN → 7 (compiled gate verifies the store/extract)"
    )

@test
def ss-wildcard-binder-ignores-field-const() =
  // WILDCARD slice: (match (P 3 4) ((P _ y) y) (_ 0)) — field-0 `_` IGNORES payload[0]=3, binds y←payload[1]=4 → 4.
  // Proves `_` in field 0 does NOT shift field-1's read (y must be 4, the SECOND field, not 3). CONST (interpreter).
  match run-src(
      "(do (type Pair (P Int64 Int64)) (def (main) (match (P 3 4) ((P _ y) y) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 4 then
      unit
    else
      trap(
        "((P _ y) y): `_` ignores field 0, y binds field 1 = 4 (got 3 = _ wrongly shifted the slot)"
      )
    | Option.None(_) => trap(
      "a wildcard-binder pattern ((P _ y) y) must RUN (bind-elision), not decline"
    )

@test
def ss-wildcard-both-fields-no-collision() =
  // TWO wildcards (match (P 3 4) ((P _ _) 9) (_ 0)) → 9. Pins the sentinel-per-position representation: two `_`
  // never collide (no shared name-id(_) key — each is an independent -1 slot); body is the constant 9.
  match run-src(
      "(do (type Pair (P Int64 Int64)) (def (main) (match (P 3 4) ((P _ _) 9) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 9 then
      unit
    else
      trap("((P _ _) 9): both fields ignored → 9 (two `_` must not collide)")
    | Option.None(_) => trap("a two-wildcard pattern ((P _ _) 9) must RUN, not decline/collide")

@test
def ss-wildcard-binder-runtime-boxed() =
  // 🪤 THE COMPILED-GATE WITNESS (v-inference mandate): a RUNTIME + BOXED wildcard round-trip that CANNOT fold.
  // MIRRORS the proven-green ss-multifield-payload-ctor-runtime-boxed shape EXACTLY (same type Pair, same
  // (if (> n 0)(P 3 4)(P 10 20)) same-variant runtime scrutinee, same (_ 0) catch-all, same go(1) wrapper) —
  // changing ONLY the arm binder x→_ in field 0. So this isolates the `_`-wildcard feature from any other match
  // shape (a mixed sibling / a 2nd real ctor-arm — those are separate surfaces). n=1 → (> 1 0) true → (P 3 4) →
  // ((P _ y) y): `_` ignores payload[0]=3, y binds payload[1]=4 → 4 (NOT 3 — proving `_` in field 0 CONSUMES slot
  // 0 without shifting y's read). Non-foldable (runtime branch, both arms box). Compiled gate verifies slot-advance.
  match run-src(
      "(do (type Pair (P Int64 Int64)) (def (go n) (match (if (> n 0) (P 3 4) (P 10 20)) ((P _ y) y) (_ 0))) (def (main) (go 1)) (export main))"
    ) with
    | Option.Some(v) => if v == 4 then
      unit
    else
      trap(
        "runtime-boxed ((P _ y) y) via go(1): `_` ignores field 0, y binds field 1 = 4 (got 3 = slot not advanced)"
      )
    | Option.None(_) => trap(
      "a runtime-boxed wildcard-binder match must RUN → 4 (compiled gate verifies slot-advance)"
    )

// ---- NESTED single-field payloads round-trip: a payload whose value is ITSELF a sum handle ----
// (Some (Some 5)) — the outer ctor's payload IS the inner ctor's store handle. Constructing nests one handle
// inside another's cell; deconstructing reads the outer payload back as the inner handle, then reads THAT.
// Within the single-field subset, so it must round-trip (returns 5), NOT fabricate or mis-store the inner handle.
@test
def ss-nested-payload-some-of-some-roundtrips() =
  // (Some (Some 5)): match outer → y = inner handle; match y → x = 5. Two levels of store handle round-trip → 5.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some (Some 5)) ((Some y) (match y ((Some x) x) (_ 0))) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 5 then
      unit
    else
      trap("nested (Some (Some 5)) must round-trip to 5, not a fabricated value")
    | Option.None(_) => trap(
      "nested (Some (Some 5)) must round-trip (a single-field-payload handle nested in another)"
    )

// ---- ii-c2b-2 CROSS-TYPE ctor-pattern REJECT (soundness) ----
// Tags restart at 0 per sum decl, so a pattern ctor from a DIFFERENT sum (e.g. MkB : B) tag-collides with a
// scrutinee of another sum (MkA : A, also tag 0) and would UNSOUNDLY match on tag alone. The NMatchCtor node
// now carries the pattern ctor's name-id; infer looks up its decl (ctor-decl-of) and REJECTS (TErr → decline)
// when the scrutinee is a TSum whose decl differs. Was a confirmed miscompile (B-pattern returned an A-value).
@test
def ss-crosstype-payload-pattern-rejects() =
  // (match (MkA 5) ((MkB x) x) (_ 0)) — MkB belongs to B, scrutinee (MkA 5) is TSum(A). Different decls (both
  // tag 0) → REJECT → decline (None). Previously this matched and returned 5 (unsound). The soundness payoff.
  match run-src(
      "(do (type A (MkA Int64)) (type B (MkB Int64)) (def (main) (match (MkA 5) ((MkB x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap(
      "a cross-type ctor pattern (MkB over an A scrutinee) must REJECT, never match a wrong-sum value"
    )
    | Option.None(_) => unit

@test
def ss-crosstype-nullary-pattern-rejects() =
  // ii-c2b-2: the cross-type reject also covers NULLARY (enum-disc) patterns now that they route through
  // NMatchCtor. (match (Green) (On 1) (_ 0)) — Green : Color, On : Bit (different decls, both enum-disc, tags
  // collide: Green=1, On=1). ctor-pattern-cross-type sees scrut TSum(Color) != On's decl Bit → REJECT → None.
  // Without the reject, On (tag 1) would tag-match Green (tag 1) via CMatchEnum → an unsound cross-sum match.
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (type Bit (Off) (On)) (def (main) (match (Green) (On 1) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap(
      "a cross-type nullary pattern (On:Bit over a Color scrutinee) must REJECT, not tag-match"
    )
    | Option.None(_) => unit

@test
def ss-sametype-payload-pattern-still-matches() =
  // control: a SAME-type pattern must still match. (match (MkA 5) ((MkA x) x) (_ 0)) → 5. Guards the reject is
  // not over-broad (it only fires on a decl MISMATCH, not on every ctor pattern).
  match run-src(
      "(do (type A (MkA Int64)) (type B (MkB Int64)) (def (main) (match (MkA 5) ((MkA x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 5 then
      unit
    else
      trap("same-type pattern (MkA over an A scrutinee) → 5")
    | Option.None(_) => trap(
      "a same-type payload pattern must still match (reject only on decl mismatch)"
    )

@test
def ss-terr-scrutinee-taints-ctor-match() =
  // PR#849: a TErr scrutinee (an ill-typed subtree being matched) must taint the WHOLE match → decline (None),
  // NOT be masked by well-typed arms. (+ true 5) is TErr (bool+int); match it with a ((MkA x) x) arm → the arm
  // is well-typed but the scrutinee is TErr → the match is TErr → None. Pins the "Any TErr propagates" discipline.
  match run-src(
      "(do (type A (MkA Int64)) (def (main) (match (+ true 5) ((MkA x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap(
      "a TErr scrutinee (ill-typed (+ true 5)) must taint the match → decline, not be masked by the arms"
    )
    | Option.None(_) => unit

// ---- BOOL payload binder: RUNS as a cond (value path wired); arith on it still declines ----
// ii-c2b-2 Bool sentinel: a Bool payload `(BB Bool)` records the ct argType Bool sentinel (encode-bool-type=1),
// and infer now seeds the pattern binder as Typed.TBool (decode-argtype-enc(1)→TBool), so a Bool binder used AS a
// cond `(if b …)` RUNS — Bool is i64 0/1 in Core, so store→bind→cond is identical to an Int payload feeding a CIf.
// The former "b128 wasm-unreachable" was a MALFORMED test witness `(if b then 1 else 0)` (the reader has no
// then/else keywords), NOT an emit bug. Arith on a Bool STILL declines (`(+ b 1)`: arith-result-type maps TBool→
// None), so a Bool payload is never silently an int. Ground-payload: int widths + Bool COMPLETE; nested/compound
// payloads → -1 → decline (parked).
@test
def ss-bool-payload-binder-runs-as-cond() =
  // (BB true) matched ((BB b) (if b 1 0)) — b is a Bool payload used as an `if` cond. The Bool-payload VALUE path
  // is WIRED: ctor-payload-binder-type enc==1 → TBool (decode-argtype-enc), so b:TBool → the `if` cond is TBool →
  // if-type yields TIntW → lower-ok → runs. Bool is i64 0/1 in Core, so (BB true)'s payload = 1, bound to b, used
  // as the CIf cond → nonzero → then-branch → 1. (Reader `if` is the 3-form `(if cond then-expr else-expr)` — NO
  // then/else keywords; the former "b128 wasm-unreachable" was the MALFORMED witness `(if b then 1 else 0)` parsing
  // `then` as an unbound symbol → TErr, never an emit bug.)
  match run-src(
      "(do (type BoxB (BB Bool)) (def (main) (match (BB true) ((BB b) (if b 1 0)) (_ 9))) (export main))"
    ) with
    | Option.Some(v) => if v == 1 then unit else trap("(BB true) payload b=true → (if b 1 0) → 1")
    | Option.None(_) => trap(
      "a Bool payload binder used as a cond must RUN (b:TBool → if cond → 1), not decline"
    )

@test
def ss-bool-payload-binder-runtime-boxed-multivariant() =
  // STRONGER witness (v-inference's runtime-boxed bar): a NON-const Bool payload `(BB (> n 0))` in a MULTI-variant
  // decl `(BB Bool) (BI Int64)` — so no const-fold erasure, real runtime store/dispatch. go(5): (> 5 0)=true →
  // (BB true) → ((BB b) (if b 1 0)) → 1. Guards the Bool value path on the runtime path, not just a const literal.
  match run-src(
      "(do (type BoxB (BB Bool) (BI Int64)) (def (go n) (match (BB (> n 0)) ((BB b) (if b 1 0)) ((BI x) x) (_ 9))) (def (main) (go 5)) (export main))"
    ) with
    | Option.Some(v) => if v == 1 then
      unit
    else
      trap("runtime-boxed (BB (> 5 0))=true → (if b 1 0) → 1")
    | Option.None(_) => trap("runtime-boxed Bool payload cond must RUN → 1, not decline")

@test
def ss-bool-payload-binder-used-as-int-declines() =
  // THE SOUNDNESS GUARD: a Bool payload binder used ARITHMETICALLY `(+ b 1)` must DECLINE. b's binder is now TBool
  // (Bool value path wired → ctor-payload-binder-type enc==1 → TBool), and arith is INTEGER-ONLY: arith-result-type
  // maps a TBool operand → None (typed-to-ty-defer), so `(+ b 1)` → TErr → decline. A Bool payload is NEVER silently
  // treated as an int (the tick-415 int-misread trap stays shut) — the Bool value path enables `(if b …)`, not arith.
  match run-src(
      "(do (type BoxB (BB Bool)) (def (main) (match (BB true) ((BB b) (+ b 1)) (_ 9))) (export main))"
    ) with
    | Option.Some(_) => trap(
      "a Bool payload binder used as int must DECLINE (TBool operand to arith → TErr)"
    )
    | Option.None(_) => unit

@test
def ss-int-payload-binder-still-runs() =
  // control: an Int payload used as Int still runs. (BI 7) match ((BI x) (+ x 1)) → 8. Guards the boundary is not
  // over-broad — a well-typed Int payload binder must still deconstruct + compute.
  match run-src(
      "(do (type BoxI (BI Int64)) (def (main) (match (BI 7) ((BI x) (+ x 1)) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => if v == 8 then unit else trap("Int payload (BI 7), x+1 → 8")
    | Option.None(_) => trap("an Int payload binder used as Int must still run")

@test
def ss-exhaustive-payload-last-arm-runs() =
  // EXHAUSTIVE no-wildcard sum match whose LAST arm is a PAYLOAD ctor: `(None 0) ((Some x) x)` covers both Opt
  // ctors, no `_`. The reader rewrites the last (Some) arm to an unconditional else (rewrite-last-arm-unconditional,
  // safe now that resolve-node is memoized so the shared body node's binder `x` is not re-poisoned). scrut None →
  // the None arm → 0.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (None) (None 0) ((Some x) x))) (export main))"
    ) with
    | Option.Some(v) => if v == 0 then
      unit
    else
      trap("exhaustive payload-last-arm match (None) → 0")
    | Option.None(_) => trap(
      "an EXHAUSTIVE no-wildcard sum match with a PAYLOAD last arm must run (memoized resolve)"
    )

@test
def ss-exhaustive-payload-last-arm-binds-payload() =
  // the same shape, scrut = the PAYLOAD ctor (Some 5) → the Some arm binds x=5 → 5. Pins that the last (payload)
  // arm still binds its payload correctly after the unconditional-else rewrite (the tag-check still runs; the
  // dead else is never taken).
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 5) (None 0) ((Some x) x))) (export main))"
    ) with
    | Option.Some(v) => if v == 5 then
      unit
    else
      trap("exhaustive payload-last-arm match (Some 5) → 5")
    | Option.None(_) => trap("exhaustive payload-last-arm, payload-ctor scrutinee, must bind + run")

@test
def ss-exhaustive-single-payload-ctor-runs() =
  // a SINGLE-ctor decl matched with its one (payload) ctor, no wildcard: `(match (Pt 3 4) ((Pt x y) (+ x y)))`
  // is exhaustive (Pt is the only ctor). Multi-field payload binder x=3,y=4 → 7.
  match run-src(
      "(do (type P (Pt Int64 Int64)) (def (main) (match (Pt 3 4) ((Pt x y) (+ x y)))) (export main))"
    ) with
    | Option.Some(v) => if v == 7 then
      unit
    else
      trap("exhaustive single-payload-ctor match (Pt 3 4) → 7")
    | Option.None(_) => trap("an exhaustive single-payload-ctor no-wildcard match must run")
