/// sread-eval-sum.cdz — M2-a USER SUM TYPES (nullary-constructor slice) end-to-end run pins. A user sum type
/// `(type Name (C0) (C1) …)` whose constructors are all NULLARY desugars in the READER to one nullary def per
/// constructor, `Ck → NLit(k)` (its ordinal TAG). So a constructor use `(Ck)` runs through the existing
/// nullary-call pipeline (NApp(name,-1) → inline NLit → eval) to its tag, with ZERO new pipeline machinery —
/// mirroring M1-b's reader-only desugar. This is the FIRST sum-type slice; ctor-PATTERNS in match, the TySum
/// type, and PAYLOAD-carrying constructors are later coordinated slices (v-inference / v-runtime).
///
/// A small SIBLING (not folded into sread-eval-fns.cdz) to stay under the per-file gate budget.
import { run-src } from "sread-eval"

@test
def ss-first-ctor-is-tag-zero() =
  // the FIRST constructor of a sum type is tag 0. (type Color (Red)(Green)(Blue)) → (Red) = 0.
  match run-src("(do (type Color (Red) (Green) (Blue)) (def (main) (Red)) (export main))") with
    | Option.Some(v) => (if v == 0 then unit else trap("(Red) is the 0th ctor → tag 0"))
    | Option.None(_) => trap("a nullary constructor use runs (first ctor)")

@test
def ss-second-ctor-is-tag-one() =
  // the SECOND constructor is tag 1. (Green) = 1.
  match run-src("(do (type Color (Red) (Green) (Blue)) (def (main) (Green)) (export main))") with
    | Option.Some(v) => (if v == 1 then unit else trap("(Green) is the 1st ctor → tag 1"))
    | Option.None(_) => trap("a nullary constructor use runs (second ctor)")

@test
def ss-third-ctor-is-tag-two() =
  // the THIRD constructor is tag 2. (Blue) = 2.
  match run-src("(do (type Color (Red) (Green) (Blue)) (def (main) (Blue)) (export main))") with
    | Option.Some(v) => (if v == 2 then unit else trap("(Blue) is the 2nd ctor → tag 2"))
    | Option.None(_) => trap("a nullary constructor use runs (third ctor)")

@test
def ss-ctor-int-literal-match-declines() =
  // ii-c2b-2 (ruling a): a ctor use is TSum(Color), NOT an int — so matching it against INT-LITERAL patterns
  // `(match (Green) (0 100) (1 200) (_ 300))` is a type mismatch → DECLINE (None). Retires the M2-a rep-leak
  // (this test previously expected 200, treating (Green) as its tag int). rcdzc rejects this CDZ0203. The
  // idiomatic form is a CTOR-pattern match `(match (Green) (Red …) (Green …) …)` — see ss-match-on-ctor-pattern-*.
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (def (main) (match (Green) (0 100) (1 200) (_ 300))) (export main))"
    ) with
    | Option.Some(_) => trap("an int-literal match over a ctor (Green : Color, not int) must DECLINE per ruling (a)")
    | Option.None(_) => unit

@test
def ss-ctor-in-arith-declines() =
  // ii-c2b-2 (ruling a): a ctor use is TSum(Color), NOT an int, so `(+ (Blue) (Green))` is arithmetic on a
  // non-int → DECLINE (None). Retires the rep-leak (previously expected 3). rcdzc rejects `(+ (Blue)(Green))`
  // CDZ0201 "arithmetic is not defined on Color". The idiomatic way to use a ctor's ordinal is a ctor-pattern match.
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (def (main) (+ (Blue) (Green))) (export main))"
    ) with
    | Option.Some(_) => trap("arithmetic over ctors (Blue/Green : Color, not int) must DECLINE per ruling (a)")
    | Option.None(_) => unit

@test
def ss-ctor-used-in-helper-def() =
  // a constructor use inside a HELPER def body, called from main. (def (pick) (Green)) ; (pick) → 1.
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (def (pick) (Green)) (def (main) (pick)) (export main))"
    ) with
    | Option.Some(v) => (if v == 1 then unit else trap("(pick) returns (Green) → tag 1"))
    | Option.None(_) => trap("a ctor use in a helper def runs")

@test
def ss-two-sum-types-independent-tagging() =
  // TWO sum types in one module tag INDEPENDENTLY (each ctor list restarts at 0). Bit's (Off)(On) → On = 1;
  // used alongside Color. (def (main) (On)) with both types declared → 1 (On is Bit's 1st ctor, not affected
  // by Color's 3 ctors). Pins that ordinals are per-type (each read-do-type call starts tag at 0).
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (type Bit (Off) (On)) (def (main) (On)) (export main))"
    ) with
    | Option.Some(v) => (if v == 1 then
      unit
    else
      trap("(On) is Bit's 1st ctor → tag 1 (independent of Color)"))
    | Option.None(_) => trap("two sum types tag independently")

@test
def ss-payload-ctor-USE-constructs() =
  // M2-b-2b-ii-b: a PAYLOAD constructor USE `(Some 5)` now CONSTRUCTS — the reader records `Some→tag` in the ct
  // table, lower turns NApp(Some, 5) into CCtor(tag, [5]), eval store-allocs the payload sum and returns its
  // Int64 HANDLE. So it RUNS (Some handle), no longer declines. (The handle value is an opaque store index — a
  // matching arm to READ the payload back is ii-c; here we only pin that construction TYPES + LOWERS + RUNS.)
  match run-src("(do (type Opt (Some Int64) (None)) (def (main) (Some 5)) (export main))") with
    | Option.Some(_) => unit
    | Option.None(_) => trap("a payload constructor USE (Some 5) should now construct + run, not decline")

@test
def ss-nullary-sibling-of-payload-ctor-runs() =
  // a MIXED type `(type Opt (Some Int64) (None))` registers its NULLARY sibling: `None` = tag 1 (after Some's
  // tag-0 slot). ii-c2b-2: (None) is TSum(Opt), a MIXED decl → it BOXES to CCtor(1, []) (a store handle, sharing
  // Some's rep), NOT a bare tag int. So we can't read its bare value; instead MATCH it on its tag to prove it
  // constructs + deconstructs: match (None) (None 7) (_ 9) → 7 (the None-arm, tag 1, via the boxed store-tag —
  // a nullary ctor-NAME pattern `(None body)`, single paren, lowered to CMatchSum since Opt is a MIXED decl).
  match run-src("(do (type Opt (Some Int64) (None)) (def (main) (match (None) (None 7) (_ 9))) (export main))") with
    | Option.Some(v) => (if v == 7 then unit else trap("(None) boxes (mixed decl) + matches its own tag → 7"))
    | Option.None(_) => trap("a nullary sibling of a payload ctor must run (payload ctor skips, not aborts)")

@test
def ss-nullary-before-payload-is-tag-zero() =
  // the complement: a NULLARY ctor BEFORE a payload ctor is tag 0. `(type Res (Ok) (Err Int64))` → (Ok) = 0.
  match run-src("(do (type Res (Ok) (Err Int64)) (def (main) (Ok)) (export main))") with
    | Option.Some(v) => (if v == 0 then unit else trap("(Ok) is the 1st ctor → tag 0 (payload Err doesn't shift it)"))
    | Option.None(_) => trap("a nullary ctor before a payload ctor must run")

@test
def ss-nullary-sibling-of-payload-matches-on-tag() =
  // the fixed nullary sibling composes with ctor-pattern match: match (None) (Some ...) can't be written (Some
  // has no def), but (None) as a scrutinee vs its own tag works. match (None) (None 100) (_ 200) → 100.
  match run-src("(do (type Opt (Some Int64) (None)) (def (main) (match (None) (None 100) (_ 200))) (export main))") with
    | Option.Some(v) => (if v == 100 then unit else trap("match (None) hits the None-pattern → 100"))
    | Option.None(_) => trap("a nullary sibling of a payload ctor matches on its tag")

// ---- nullary CTOR-PATTERNS in match: `(match c (Red 1) (Green 2) (_ 0))` matches on ctor names ----
// A nullary ctor is a nullary def `Ck → NLit(tag)`, so a pattern `Ck` desugars to its tag literal and reuses
// the integer-match lowering (CIf(CBin(==, scrut, tag))). No pipeline change beyond the reader.

@test
def ss-match-on-ctor-pattern-first() =
  // match (Red) (Red 100) (Green 200) (_ 300) — scrut (Red)=tag 0, pattern Red=tag 0 → the Red-arm → 100.
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (def (main) (match (Red) (Red 100) (Green 200) (_ 300))) (export main))"
    ) with
    | Option.Some(v) => (if v == 100 then unit else trap("match (Red) hits the Red-pattern arm → 100"))
    | Option.None(_) => trap("a nullary ctor pattern in match runs (first arm)")

@test
def ss-match-on-ctor-pattern-middle() =
  // match (Green) (Red 100) (Green 200) (_ 300) — (Green)=tag 1, matches the Green pattern → 200.
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (def (main) (match (Green) (Red 100) (Green 200) (_ 300))) (export main))"
    ) with
    | Option.Some(v) => (if v == 200 then unit else trap("match (Green) hits the Green-pattern arm → 200"))
    | Option.None(_) => trap("a nullary ctor pattern in match runs (middle arm)")

@test
def ss-match-on-ctor-pattern-wildcard() =
  // match (Blue) (Red 100) (Green 200) (_ 300) — (Blue)=tag 2, no Red/Green pattern matches → wildcard → 300.
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (def (main) (match (Blue) (Red 100) (Green 200) (_ 300))) (export main))"
    ) with
    | Option.Some(v) => (if v == 300 then unit else trap("match (Blue) falls to _ → 300"))
    | Option.None(_) => trap("a nullary ctor pattern match wildcard fallthrough runs")

@test
def ss-match-ctor-pattern-over-bound-var() =
  // the scrutinee is a BOUND VARIABLE holding a ctor tag: (def (classify c) (match c (Red 10) (Green 20) (_ 30)))
  // called with (Green) → c = tag 1 → the Green arm → 20. Proves ctor patterns work when the scrutinee is a
  // param, not a literal ctor use (the shape a real Option/Result matcher takes).
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (def (classify c) (match c (Red 10) (Green 20) (_ 30))) (def (main) (classify (Green))) (export main))"
    ) with
    | Option.Some(v) => (if v == 20 then unit else trap("classify (Green) → match c on tag 1 → 20"))
    | Option.None(_) => trap("a ctor pattern over a bound-var scrutinee runs")

@test
def ss-match-mixed-int-literal-over-ctor-declines() =
  // ii-c2b-2 (ruling a): an INT-LITERAL pattern `(0 100)` over a TSum scrutinee `(Green)` is a type mismatch →
  // the whole match DECLINES (None). Previously this test MIXED an int-literal arm with a ctor arm and expected
  // 200 (treating (Green) as its tag int) — that rep-leak is retired. The idiomatic form uses ONLY ctor-name
  // patterns (see ss-match-on-ctor-pattern-*); an int literal over a sum scrutinee is rejected like rcdzc's CDZ0203.
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (def (main) (match (Green) (0 100) (Green 200) (_ 300))) (export main))"
    ) with
    | Option.Some(_) => trap("an int-literal pattern (0 100) over a TSum scrutinee (Green) must DECLINE per ruling (a)")
    | Option.None(_) => unit

// ---- M2-b-2b-ii-c PAYLOAD ctor-pattern DECONSTRUCT: ((Some x) body) binds + reads the payload back ----
// A payload ctor USE (Some 5) constructs a store handle (ii-b); a payload PATTERN ((Some x) body) reads its
// payload[0] back into x. Lowers to CMatchSum(scrut, tag, [binder], body, rest). END-TO-END: construct+deconstruct.

@test
def ss-payload-pattern-binds-and-reads() =
  // match (Some 5) ((Some x) x) (_ 0) → 5. Construct Some 5 (CCtor→handle), match on its tag, bind payload[0]=5
  // to x, eval the body x → 5. THE payoff: a payload sum round-trips through construct + deconstruct.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 5) ((Some x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => (if v == 5 then unit else trap("(match (Some 5) ((Some x) x)(_ 0)) → 5"))
    | Option.None(_) => trap("a payload ctor pattern binds + reads its payload")

@test
def ss-payload-pattern-arith-on-binding() =
  // the bound payload is an ordinary value: match (Some 20) ((Some x) (+ x 1)) (_ 0) → 21.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 20) ((Some x) (+ x 1)) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => (if v == 21 then unit else trap("(Some 20) bound x, x+1 → 21"))
    | Option.None(_) => trap("arith on a bound payload runs")

@test
def ss-payload-pattern-falls-to-wildcard() =
  // scrutinee tag differs from the pattern's ctor → the wildcard arm. match (None) ((Some x) x) (_ 99) → 99
  // (None is tag 1, the Some pattern is tag 0 → mismatch → wildcard). Pins the CMatchSum else-path.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (None) ((Some x) x) (_ 99))) (export main))"
    ) with
    | Option.Some(v) => (if v == 99 then unit else trap("(None) vs (Some x) pattern → wildcard → 99"))
    | Option.None(_) => trap("a payload-pattern tag mismatch takes the wildcard arm")

@test
def ss-payload-ctor-in-helper-roundtrip() =
  // construct in one def, deconstruct in main: (def (mk) (Some 7)) ; match (mk) ((Some x) x) (_ 0) → 7.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (mk) (Some 7)) (def (main) (match (mk) ((Some x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => (if v == 7 then unit else trap("(mk)=Some 7, match ((Some x) x) → 7"))
    | Option.None(_) => trap("a payload sum constructed in a helper deconstructs in main")

// ---- PR#835 reader-correctness: an unknown-ctor or no-binder ctor-pattern arm DECLINES cleanly ----
// read-ctor-pattern-arm's decline path must skip the WHOLE arm (pattern + body + arm close) so the remaining
// arms + the enclosing (match …) still parse — the decline surfaces as None (poison), NEVER a mis-parse of the
// later arms or a fabricated value. Two shapes: (1) an UNKNOWN ctor in a payload-shaped pattern; (2) a payload
// ctor pattern with NO binder `((Some) body)` (previously a silent empty-name NVar).

@test
def ss-ctor-pattern-unknown-ctor-declines-cleanly() =
  // ((Nope x) …) — Nope is not a recorded ctor → decline. The trailing (_ 0) arm follows the declined arm; the
  // fix's whole-arm skip means the reader still reaches it and the match declines (None), not a corrupt parse.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 5) ((Nope x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap("an unknown-ctor pattern arm must DECLINE (None), never fabricate a value")
    | Option.None(_) => unit

@test
def ss-ctor-pattern-no-binder-declines-cleanly() =
  // ((Some) x) — a payload ctor pattern with NO binder → decline (doc: "ctor with NO binder → decline"), rather
  // than silently binding an empty-name NVar. The following (_ 0) arm is still reached; result is a clean None.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 5) ((Some) 1) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap("a no-binder ctor pattern arm must DECLINE (None), never bind an empty name")
    | Option.None(_) => unit

// ---- payload ctor-pattern match ARMS must JOIN (an infer soundness fix) ----
// The NMatchCtor infer arm previously took the body arm's type unconditionally, ignoring the rest/else arm — so
// a match with mismatched arm types (Int body vs Bool else) typed as Int instead of declining. Now the arms
// join like the integer NMatch / if: an Int body under a Bool else → TErr → the program declines (None).

@test
def ss-payload-pattern-arm-type-mismatch-declines() =
  // match (Some 5) ((Some x) x) (_ true) — body arm is Int (x), else arm is Bool (true). The arms don't join →
  // TErr → decline (None). Guards the arm-join in the NMatchCtor infer arm.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 5) ((Some x) x) (_ true))) (export main))"
    ) with
    | Option.Some(_) => trap("a payload-pattern match with mismatched arm types (Int body / Bool else) must DECLINE")
    | Option.None(_) => unit

@test
def ss-payload-pattern-arms-join-still-runs() =
  // the join is NON-regressive: matching arms (both Int) still type + run. match (Some 5) ((Some x) x) (_ 0) → 5
  // (already pinned by ss-payload-pattern-binds-and-reads, restated here as the positive side of the join guard).
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some 9) ((Some x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => (if v == 9 then unit else trap("matching Int arms join + run → 9"))
    | Option.None(_) => trap("a payload-pattern match with joining Int arms must still run")

// ---- MULTI-FIELD payload ctors are OUT of the wired subset → clean DECLINE (boundary guard) ----
// ii-b/ii-c wired SINGLE-field payloads only. A multi-field ctor `(P Int64 Int64)` must DECLINE cleanly (None),
// never fabricate a value (lower's lower-rec-args gathers arg2/3/4 into the CCtor, but the well-typed gate
// declines the under-typed node first). Locks the boundary the ii-c2b-2 slice builds up FROM — verified by a
// probe this cycle; a future ctor-typing change must not silently start fabricating multi-field payloads.

@test
def ss-multifield-payload-ctor-bare-declines() =
  // (P 3 4) as main's result — a 2-field payload construct is out of subset → clean decline (None).
  match run-src(
      "(do (type Pair (P Int64 Int64)) (def (main) (P 3 4)) (export main))"
    ) with
    | Option.Some(_) => trap("a 2-field payload ctor (P 3 4) must DECLINE, never fabricate a value")
    | Option.None(_) => unit

@test
def ss-multifield-payload-ctor-in-match-declines() =
  // (match (P 3 4) ((P x) x) (_ 0)) — constructing + deconstructing a 2-field payload is out of subset → decline.
  match run-src(
      "(do (type Pair (P Int64 Int64)) (def (main) (match (P 3 4) ((P x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap("a 2-field payload ctor in a match must DECLINE, never fabricate/mis-bind")
    | Option.None(_) => unit

// ---- NESTED single-field payloads round-trip: a payload whose value is ITSELF a sum handle ----
// (Some (Some 5)) — the outer ctor's payload IS the inner ctor's store handle. Constructing nests one handle
// inside another's cell; deconstructing reads the outer payload back as the inner handle, then reads THAT.
// Within the single-field subset, so it must round-trip (returns 5), NOT fabricate or mis-store the inner handle.

@test
def ss-nested-payload-some-of-some-roundtrips() =
  // (Some (Some 5)): match outer → y = inner handle; match y → x = 5. Two levels of store handle round-trip → 5.
  match run-src(
      "(do (type Opt (Some Int64) (None)) (def (main) (match (Some (Some 5)) ((Some y) (match y ((Some x) x) (_ 0))) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => (if v == 5 then unit else trap("nested (Some (Some 5)) must round-trip to 5, not a fabricated value"))
    | Option.None(_) => trap("nested (Some (Some 5)) must round-trip (a single-field-payload handle nested in another)")

// ---- ii-c2b-2 CROSS-TYPE ctor-pattern REJECT (soundness) ----
// Tags restart at 0 per sum decl, so a pattern ctor from a DIFFERENT sum (e.g. MkB : B) tag-collides with a
// scrutinee of another sum (MkA : A, also tag 0) and would UNSOUNDLY match on tag alone. The NMatchCtor node
// now carries the pattern ctor's name-id; infer looks up its decl (ctor-decl-of) and REJECTS (TErr → decline)
// when the scrutinee is a TSum whose decl differs. Was a confirmed miscompile (B-pattern returned an A-value).

@test
def ss-crosstype-payload-pattern-rejects() =
  // (match (MkA 5) ((MkB x) x) (_ 0)) — MkB belongs to B, scrutinee (MkA 5) is TSum(A). Different decls (both
  // tag 0) → REJECT → decline (None). Previously this matched and returned 5 (unsound). The soundness payoff.
  match run-src(
      "(do (type A (MkA Int64)) (type B (MkB Int64)) (def (main) (match (MkA 5) ((MkB x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap("a cross-type ctor pattern (MkB over an A scrutinee) must REJECT, never match a wrong-sum value")
    | Option.None(_) => unit

@test
def ss-crosstype-nullary-pattern-rejects() =
  // ii-c2b-2: the cross-type reject also covers NULLARY (enum-disc) patterns now that they route through
  // NMatchCtor. (match (Green) (On 1) (_ 0)) — Green : Color, On : Bit (different decls, both enum-disc, tags
  // collide: Green=1, On=1). ctor-pattern-cross-type sees scrut TSum(Color) != On's decl Bit → REJECT → None.
  // Without the reject, On (tag 1) would tag-match Green (tag 1) via CMatchEnum → an unsound cross-sum match.
  match run-src(
      "(do (type Color (Red) (Green) (Blue)) (type Bit (Off) (On)) (def (main) (match (Green) (On 1) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap("a cross-type nullary pattern (On:Bit over a Color scrutinee) must REJECT, not tag-match")
    | Option.None(_) => unit

@test
def ss-sametype-payload-pattern-still-matches() =
  // control: a SAME-type pattern must still match. (match (MkA 5) ((MkA x) x) (_ 0)) → 5. Guards the reject is
  // not over-broad (it only fires on a decl MISMATCH, not on every ctor pattern).
  match run-src(
      "(do (type A (MkA Int64)) (type B (MkB Int64)) (def (main) (match (MkA 5) ((MkA x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => (if v == 5 then unit else trap("same-type pattern (MkA over an A scrutinee) → 5"))
    | Option.None(_) => trap("a same-type payload pattern must still match (reject only on decl mismatch)")

@test
def ss-terr-scrutinee-taints-ctor-match() =
  // PR#849: a TErr scrutinee (an ill-typed subtree being matched) must taint the WHOLE match → decline (None),
  // NOT be masked by well-typed arms. (+ true 5) is TErr (bool+int); match it with a ((MkA x) x) arm → the arm
  // is well-typed but the scrutinee is TErr → the match is TErr → None. Pins the "Any TErr propagates" discipline.
  match run-src(
      "(do (type A (MkA Int64)) (def (main) (match (+ true 5) ((MkA x) x) (_ 0))) (export main))"
    ) with
    | Option.Some(_) => trap("a TErr scrutinee (ill-typed (+ true 5)) must taint the match → decline, not be masked by the arms")
    | Option.None(_) => unit

// ---- NON-Int payload binder is OUT of subset → clean DECLINE (boundary guard) ----
// The payload binder is typed Int64 placeholder (ct records only (declName,tag), not arg-types yet). A ctor with
// a NON-Int payload used AS that type (e.g. a Bool payload in `(if b …)`) mis-types against the Int64 placeholder
// → clean decline (None), never fabricate. Locks the boundary the ct-argTypes follow-up (binder<-argTypes[i])
// builds up from; a future binder-typing change must not silently start running an under-typed non-Int payload.

@test
def ss-bool-payload-binder-declines() =
  // (BB true) matched ((BB b) (if b then 1 else 0)) — b is a Bool payload but typed Int64 placeholder; (if b …)
  // needs b : Bool → mis-type → decline (None). Was verified by a probe; pins the non-Int-payload boundary.
  match run-src(
      "(do (type BoxB (BB Bool)) (def (main) (match (BB true) ((BB b) (if b then 1 else 0)) (_ 9))) (export main))"
    ) with
    | Option.Some(_) => trap("a non-Int (Bool) payload binder used as Bool must DECLINE while the binder is an Int64 placeholder")
    | Option.None(_) => unit

@test
def ss-int-payload-binder-still-runs() =
  // control: an Int payload used as Int still runs. (BI 7) match ((BI x) (+ x 1)) → 8. Guards the boundary is not
  // over-broad — a well-typed Int payload binder must still deconstruct + compute.
  match run-src(
      "(do (type BoxI (BI Int64)) (def (main) (match (BI 7) ((BI x) (+ x 1)) (_ 0))) (export main))"
    ) with
    | Option.Some(v) => (if v == 8 then unit else trap("Int payload (BI 7), x+1 → 8"))
    | Option.None(_) => trap("an Int payload binder used as Int must still run")
