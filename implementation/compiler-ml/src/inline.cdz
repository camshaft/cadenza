/// inline.cdz — LINEAR INLINING of `let` bindings: replace `let x = rhs in body` by `body[x := rhs]` when
/// `x` occurs AT MOST ONCE in `body`. This is the size-safe inlining heuristic a real optimizer runs — a
/// binding used zero or one times can always be inlined without duplicating code (zero uses → the binding
/// vanishes, one use → the rhs moves to the single use site). A binding used TWICE or more is KEPT, so the
/// pass never grows the program. It composes occurrence counting (`occ`) with capture-avoiding
/// substitution (`subst`) and the same `let`-shadowing discipline the constprop/deadlet passes use.
///
/// Contract: `inline` PRESERVES meaning — `eval(inline(e)) == eval(e)` for every closed expression — and a
/// linearly-used binding leaves no residual `let`. It is the dual of dead-let elimination: DLE drops a
/// binding used zero times; linear inlining additionally folds a binding used exactly once into its use.
///
/// NOTE: linear inlining is unconditional because the language is PURE (no effects/traps to reorder or
/// duplicate) — moving `rhs` to its single use, or dropping it when unused, cannot change observable
/// behavior. A pass over an effectful language would additionally require `rhs` to be pure before inlining.

type Ex =
  | Num(Int64)
  | Var(String)
  | Add(Ex, Ex)
  | Mul(Ex, Ex)
  | Let(String, Ex, Ex)

/// Count FREE occurrences of `x` in `e` (shadowing-aware: an inner `let x = …` shadows, so its body's `x`
/// is not counted for the outer binding).
def occ(x: String, e: Ex) = match e with
  | Ex.Num(_) => 0
  | Ex.Var(y) => (if x == y then 1 else 0)
  | Ex.Add(l, r) => occ(x, l) + occ(x, r)
  | Ex.Mul(l, r) => occ(x, l) + occ(x, r)
  | Ex.Let(y, rhs, body) => occ(x, rhs) + (if x == y then 0 else occ(x, body))

/// Substitute `s` for free `x` in `e`. Capture-avoiding enough for the inliner's use (the `rhs` we inline
/// is evaluated in the outer scope; an inner `let y = …` that shadows `x` stops the substitution into its
/// body, and a `let x = …` binding removes `x` from scope for its body).
def subst(x: String, s: Ex, e: Ex) = match e with
  | Ex.Num(n) => Ex.Num(n)
  | Ex.Var(y) => (if x == y then s else Ex.Var(y))
  | Ex.Add(l, r) => Ex.Add(subst(x, s, l), subst(x, s, r))
  | Ex.Mul(l, r) => Ex.Mul(subst(x, s, l), subst(x, s, r))
  | Ex.Let(y, rhs, body) =>
    Ex.Let(y, subst(x, s, rhs), (if x == y then body else subst(x, s, body)))

/// Linear inlining. Bottom-up: inline the sub-terms first, then decide this `let`. A binding whose variable
/// occurs at most once in the (already-inlined) body is folded into it; otherwise the `let` is kept.
def inline(e: Ex) = match e with
  | Ex.Num(n) => Ex.Num(n)
  | Ex.Var(x) => Ex.Var(x)
  | Ex.Add(l, r) => Ex.Add(inline(l), inline(r))
  | Ex.Mul(l, r) => Ex.Mul(inline(l), inline(r))
  | Ex.Let(x, rhs, body) =>
    let rhs2 = inline(rhs) in
    let body2 = inline(body) in
    (if occ(x, body2) <= 1 then subst(x, rhs2, body2) else Ex.Let(x, rhs2, body2))

/// Reference evaluator (a free var reads as -1).
def ev(e: Ex, env: Map(String, Int64)) = match e with
  | Ex.Num(n) => n
  | Ex.Var(x) => (match Map.lookup(env, x) with | Option.Some(v) => v | Option.None(_) => 0 - 1)
  | Ex.Add(l, r) => ev(l, env) + ev(r, env)
  | Ex.Mul(l, r) => ev(l, env) * ev(r, env)
  | Ex.Let(x, rhs, body) => ev(body, Map.insert(env, x, ev(rhs, env)))

def eval(e: Ex) = ev(e, Map.empty)

/// Does `e` contain any `let`? (0 = fully inlined / no residual bindings.)
def let-count(e: Ex) = match e with
  | Ex.Add(l, r) => let-count(l) + let-count(r)
  | Ex.Mul(l, r) => let-count(l) + let-count(r)
  | Ex.Let(_, rhs, body) => 1 + let-count(rhs) + let-count(body)
  | _ => 0

/// Builders.
def lt(x: String, rhs: Ex, body: Ex) = Ex.Let(x, rhs, body)
def v(x: String) = Ex.Var(x)
def n(k: Int64) = Ex.Num(k)

@test
def occ-counts-uses() =
  // x appears twice in x + (x * 2)
  if occ("x", Ex.Add(v("x"), Ex.Mul(v("x"), n(2)))) == 2 then unit else trap("x occurs twice")

@test
def occ-shadowed-not-counted() =
  // let x = 9 in x  shadows the outer x, so the body's x is not an outer occurrence
  if occ("x", lt("x", n(9), v("x"))) == 0 then unit else trap("shadowed x not counted for outer")

@test
def inline-single-use() =
  // let x = 5 in x + 1 → x used once → inline → 5 + 1, no residual let, eval 6.
  let e = lt("x", n(5), Ex.Add(v("x"), n(1))) in
  let o = inline(e) in
  if let-count(o) == 0 then (if eval(o) == 6 then unit else trap("eval 6")) else trap("no residual let")

@test
def inline-zero-use-drops-binding() =
  // let x = 99 in 7 → x unused → binding dropped → Num 7, no let.
  let e = lt("x", n(99), n(7)) in
  let o = inline(e) in
  if let-count(o) == 0 then (if eval(o) == 7 then unit else trap("eval 7")) else trap("dead binding dropped")

@test
def inline-keeps-multi-use() =
  // let x = (3 + 4) in x * x → x used TWICE → binding KEPT (no duplication of the 3+4).
  let e = lt("x", Ex.Add(n(3), n(4)), Ex.Mul(v("x"), v("x"))) in
  let o = inline(e) in
  if let-count(o) == 1 then (if eval(o) == 49 then unit else trap("eval 49")) else trap("multi-use let kept")

@test
def inline-preserves-meaning() =
  // meaning is preserved whether or not inlining fires.
  let e = lt("a", n(2), lt("b", Ex.Add(v("a"), n(1)), Ex.Mul(v("b"), n(10)))) in
  if eval(inline(e)) == eval(e) then unit else trap("inline preserves meaning")

@test
def inline-nested-single-uses-collapse() =
  // let a = 2 in let b = a + 3 in b * 10 → a used once (in b's rhs), b used once → both inline → (2+3)*10
  // = 50, no residual lets.
  let e = lt("a", n(2), lt("b", Ex.Add(v("a"), n(3)), Ex.Mul(v("b"), n(10)))) in
  let o = inline(e) in
  if let-count(o) == 0 then (if eval(o) == 50 then unit else trap("eval 50")) else trap("both collapse")

@test
def inline-shadowing-correct() =
  // let x = 1 in (let x = 10 in x) + x → inner x used once (inline to 10), outer x used once (the trailing
  // +x) → 10 + 1 = 11. Shadowing must be respected (the trailing x is the OUTER 1).
  let inner = lt("x", n(10), v("x")) in
  let e = lt("x", n(1), Ex.Add(inner, v("x"))) in
  if eval(inline(e)) == 11 then (if eval(e) == 11 then unit else trap("eval 11")) else trap("shadowing = 11")

@test
def inline-does-not-duplicate-multiuse-rhs() =
  // let x = (1 + 2) in x + x → x twice → KEPT. The 1+2 must appear ONCE (in the binding), not duplicated
  // into both uses. let-count 1 confirms the binding survives; a duplicating inliner would give let-count 0
  // with two (1+2) subtrees.
  let e = lt("x", Ex.Add(n(1), n(2)), Ex.Add(v("x"), v("x"))) in
  let o = inline(e) in
  if let-count(o) == 1 then (if eval(o) == 6 then unit else trap("eval 6")) else trap("multi-use rhs not duplicated")

export { inline, occ, subst, eval }
