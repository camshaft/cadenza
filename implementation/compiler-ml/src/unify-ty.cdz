/// unify-ty.cdz — Tier-1 convergence: UNIFICATION over ty.cdz's shared `Ty`. The orthogonal sign/width
/// lattice (already ported into unify.cdz's own `Ty`) re-expressed over the CANONICAL `ty.cdz` universe —
/// so infer's operand-combining + if-join and the HM unify converge onto ONE type + one unification, the
/// last piece of divergence #3 (two type systems → one). Mirrors rcdzc's unify_sign/unify_width (INDEPENDENT
/// axes) producing a combined `IntType`, plus type-level unify for Bool.
///
/// `unify-ty(a, b)` returns `Option(Ty)`: `Some(t)` = the two types unify to `t` (a deferred axis GROUNDS to
/// the other; two concrete axes must AGREE; deferred~deferred stays deferred); `None` = they conflict (a
/// Fixed sign/width mismatch — the CDZ0301 no-silent-promotion reject — or a cross-kind int~Bool). This is
/// the value-combining form infer uses (arith result type = unify of operand types); it does not thread a
/// substitution (compiler-ml's int types carry no unification VARs yet — that's the deferred Sign/Width
/// Var slice, later). TyErr never unifies (poison propagates as None → the caller yields TErr).
import { Sign, Width, IntType, Ty, ty-eq, int-list-eq } from "ty"

/// Combine two signs (rcdzc unify_sign): a DEFERRED sign takes the other; two FIXED signs must be EQUAL
/// (Signed/Signed or Unsigned/Unsigned) else conflict. `Some(sign)` = the combined sign, `None` = mismatch.
def unify-sign(a: Sign, b: Sign) = match a with
  | Sign.SignDef => Option.Some(b) // deferred ~ anything → the other
  // ARC-A1: an un-bound var unifies like deferred — takes the other side (INERT; no binding recorded until
  // ARC-B3 threads a Subst and records `var := b`). Keeps unify TOTAL over the 3-state axis with no behavior
  // change (nothing produces an SVar yet). B3 replaces this arm with a Subst-binding form.
  | Sign.SVar(_) => Option.Some(b)
  | Sign.Signed => (match b with
    | Sign.SignDef => Option.Some(Sign.Signed)
    | Sign.SVar(_) => Option.Some(Sign.Signed) // ARC-A1: b is an un-bound var → takes `a` (Signed)
    | Sign.Signed => Option.Some(Sign.Signed)
    | Sign.Unsigned => Option.None(unit)
  )
  | Sign.Unsigned => match b with
    | Sign.SignDef => Option.Some(Sign.Unsigned)
    | Sign.SVar(_) => Option.Some(Sign.Unsigned) // ARC-A1: b is an un-bound var → takes `a` (Unsigned)
    | Sign.Unsigned => Option.Some(Sign.Unsigned)
    | Sign.Signed => Option.None(unit)

/// Combine two widths (rcdzc unify_width): a DEFERRED width takes the other; two FIXED widths must be EQUAL
/// else conflict. INDEPENDENT of sign (the orthogonal-axis rule).
def unify-width(a: Width, b: Width) = match a with
  | Width.WidthDef => Option.Some(b) // deferred ~ anything → the other
  | Width.WVar(_) => Option.Some(b) // ARC-A1: un-bound var ~ anything → the other (INERT until B3's Subst)
  | Width.WFixed(n) => match b with
    | Width.WidthDef => Option.Some(Width.WFixed(n))
    | Width.WVar(_) => Option.Some(Width.WFixed(n)) // ARC-A1: b un-bound var → takes `a`
    | Width.WFixed(m) => if n == m then Option.Some(Width.WFixed(n)) else Option.None(unit)

/// Unify two integer types: unify SIGN and WIDTH independently; both must combine (a Fixed mismatch on
/// EITHER axis is a conflict, checked regardless of the other axis's state). `Some(IntType)` = the combined
/// type, `None` = conflict (CDZ0301 analog).
def unify-int(a: IntType, b: IntType) =
  let IntType.IntType(sa, wa) = a in
  let IntType.IntType(sb, wb) = b in
    match unify-sign(sa, sb) with
    | Option.Some(s) => (match unify-width(wa, wb) with
      | Option.Some(w) => Option.Some(IntType.IntType(s, w))
      | Option.None(_) => Option.None(unit)
    )
    | Option.None(_) => Option.None(unit)

/// UNIFY two `Ty`: two integers unify per unify-int (orthogonal sign+width); Bool~Bool → Bool; anything with
/// TyErr, or a cross-kind (int~Bool), → None. The combining primitive infer's arith-result + if-join use.
def unify-ty(a: Ty, b: Ty) = match a with
  | Ty.TyInt(ita) => (match b with
    | Ty.TyInt(itb) => (match unify-int(ita, itb) with
      | Option.Some(it) => Option.Some(Ty.TyInt(it))
      | Option.None(_) => Option.None(unit)
    )
    | _ => Option.None(unit)
  )
  | Ty.TyBool => (match b with
    | Ty.TyBool => Option.Some(Ty.TyBool)
    | _ => Option.None(unit)
  )
  | Ty.TyChar => (match b with
    | Ty.TyChar => Option.Some(Ty.TyChar)
    | _ => Option.None(unit)
  )
  | Ty.TyString => (match b with
    | Ty.TyString => Option.Some(Ty.TyString)
    | _ => Option.None(unit)
  )
  | Ty.TyErr => Option.None(unit)
  // HIGHER-ORDER: two function types unify iff SAME arity, params unify PAIRWISE, and results unify (rcdzc
  // unify.rs:209 `(Fn(pa,ra),Fn(pb,rb)) => unify(pa,pb); unify(ra,rb)`, generalized to N-ary). Any arity/param/
  // result conflict → None (poison propagates). A TyFn never unifies with an int/bool/err (cross-kind → None).
  | Ty.TyFn(psa, ra) => (match b with
    | Ty.TyFn(psb, rb) => if List.len(psa) == List.len(psb) then
      match unify-ty-list(psa, psb, 0) with
        | Option.Some(ps) => (match unify-ty(ra, rb) with
          | Option.Some(r) => Option.Some(Ty.TyFn(ps, r))
          | Option.None(_) => Option.None(unit)
        )
        | Option.None(_) => Option.None(unit)
    else
      Option.None(unit) // arity mismatch → conflict
    | _ => Option.None(unit)
  ) // fn ~ non-fn → conflict
  // M2-b-2b-ii-c2 USER SUM: DECL-IDENTITY unify — two sum types unify (to themselves) iff SAME decl name-id,
  // never structural inner (closes recursive sums; a cross-type ctor pattern → different decl → None → reject).
  | Ty.TySum(na) => (match b with
    | Ty.TySum(nb) => if na == nb then Option.Some(Ty.TySum(na)) else Option.None(unit)
    | _ => Option.None(unit)
  ) // sum ~ non-sum → conflict
  // COMPOUND TUPLE: two tuple types unify iff SAME arity and elements unify PAIRWISE (mirrors the TyFn param
  // arm, minus a result). Any arity/element conflict → None; a tuple ~ non-tuple → conflict.
  | Ty.TyTuple(esa) => (match b with
    | Ty.TyTuple(esb) => if List.len(esa) == List.len(esb) then
      match unify-ty-list(esa, esb, 0) with
        | Option.Some(es) => Option.Some(Ty.TyTuple(es))
        | Option.None(_) => Option.None(unit)
    else
      Option.None(unit) // arity mismatch → conflict
    | _ => Option.None(unit)
  ) // tuple ~ non-tuple → conflict
  // COMPOUND RECORD: unify iff SAME field names AND paired types unify pairwise (mirrors TyTuple + a name check).
  | Ty.TyRecord(na, ta) => (match b with
    | Ty.TyRecord(nb, tb) => if List.len(na) == List.len(nb) and int-list-eq(na, nb, 0) then
      match unify-ty-list(ta, tb, 0) with
        | Option.Some(ts) => Option.Some(Ty.TyRecord(na, ts))
        | Option.None(_) => Option.None(unit)
    else
      Option.None(unit) // field-name/arity mismatch → conflict
    | _ => Option.None(unit)
  ) // record ~ non-record → conflict
  // ARC-B5 B1: this STATELESS combiner (the pre-HM live-infer primitive) has no Subst to bind a var into, so a
  // TyVar declines here — the real var-binding unify is unify-subst.cdz's unify-ty-su (Subst-threading, B3). A
  // TyVar never reaches this stateless path in the current live pipeline; the arm is for exhaustiveness.
  | Ty.TyVar(_) => Option.None(unit)

/// Unify two same-length param-type lists PAIRWISE (index recursion). `Some(list)` = every pair unified (the
/// combined param types, in order); `None` = any pair conflicted. Callers guarantee equal length.
def unify-ty-list(a: List(Ty), b: List(Ty), i: Int64) =
  if i == List.len(a) then
    Option.Some([] : List(Ty))
  else
    match List.at(a, i) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(ta) => match List.at(b, i) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(tb) => match unify-ty(ta, tb) with
          | Option.None(_) => Option.None(unit)
          | Option.Some(t) => match unify-ty-list(a, b, i + 1) with
            | Option.None(_) => Option.None(unit)
            | Option.Some(rest) => Option.Some(List.concat(List.push([], t), rest))

// ---- TESTS: orthogonal sign/width unification over the shared Ty ------------------------------------
import { ty-int64, ty-fixed-int, ty-deferred-int } from "ty"

/// Some-Ty equal to `want` via ty-eq, else fail.
def unifies-to(r: Option(Ty), want: Ty) = match r with
  | Option.Some(t) => ty-eq(t, want)
  | Option.None(_) => false

def conflicts(r: Option(Ty)) = match r with
  | Option.None(_) => true
  | Option.Some(_) => false

@test
def ut-same-concrete() =
  // Int64 ~ Int64 → Int64; UInt8 ~ UInt8 → UInt8.
  if unifies-to(unify-ty(ty-int64(), ty-int64()), ty-int64()) then
    if unifies-to(unify-ty(ty-fixed-int(false, 8), ty-fixed-int(false, 8)), ty-fixed-int(false, 8)) then
      unit
    else
      trap("UInt8~UInt8")
  else
    trap("Int64~Int64")

@test
def ut-deferred-grounds-to-concrete() =
  // a bare deferred literal ~ Int8 → Int8 (the literal grounds); symmetric.
  if unifies-to(unify-ty(ty-deferred-int(), ty-fixed-int(true, 8)), ty-fixed-int(true, 8)) then
    if unifies-to(unify-ty(ty-fixed-int(true, 8), ty-deferred-int()), ty-fixed-int(true, 8)) then
      unit
    else
      trap("Int8~deferred")
  else
    trap("deferred~Int8")

@test
def ut-deferred-meets-deferred() =
  // deferred ~ deferred → deferred (unconstrained; grounds at the root later).
  if unifies-to(unify-ty(ty-deferred-int(), ty-deferred-int()), ty-deferred-int()) then
    unit
  else
    trap("deferred~deferred")

@test
def ut-width-conflict() =
  // Int8 ~ Int16 → conflict (Fixed width mismatch).
  if conflicts(unify-ty(ty-fixed-int(true, 8), ty-fixed-int(true, 16))) then
    unit
  else
    trap("Int8~Int16 conflict")

@test
def ut-sign-conflict() =
  // Int8 ~ UInt8 → conflict (Fixed sign mismatch, same width — orthogonal).
  if conflicts(unify-ty(ty-fixed-int(true, 8), ty-fixed-int(false, 8))) then
    unit
  else
    trap("Int8~UInt8 conflict")

@test
def ut-orthogonal-sign-checked-under-deferred-width() =
  // a SIGNED deferred-width (IntType Signed, WidthDef) ~ UInt8 → conflict on SIGN even though a width is
  // deferred (the orthogonal rule: sign checked independent of width).
  if conflicts(
      unify-ty(Ty.TyInt(IntType.IntType(Sign.Signed, Width.WidthDef)), ty-fixed-int(false, 8))
    ) then
    unit
  else
    trap("signed-deferred-width ~ UInt8 conflicts on sign")

@test
def ut-cross-axis-grounding() =
  // THE orthogonality proof (each axis grounds from a DIFFERENT operand, then merges): a (Signed, WidthDef)
  // meets a (SignDef, WFixed 8) → the width grounds from the RIGHT, the sign grounds from the LEFT, and the
  // two INDEPENDENT groundings COMBINE into a fully-fixed Int8. Not a mere pass-through of one operand — each
  // operand contributes exactly one axis. This is the invariant corrected-2b's arith-result-type leans on and
  // the future deferred-bare-literal-width-unifies slice will exercise; symmetric.
  if unifies-to(
      unify-ty(
        Ty.TyInt(IntType.IntType(Sign.Signed, Width.WidthDef)),
        Ty.TyInt(IntType.IntType(Sign.SignDef, Width.WFixed(8)))
      ),
      ty-fixed-int(true, 8)
    ) then
    if unifies-to(
        unify-ty(
          Ty.TyInt(IntType.IntType(Sign.SignDef, Width.WFixed(8))),
          Ty.TyInt(IntType.IntType(Sign.Signed, Width.WidthDef))
        ),
        ty-fixed-int(true, 8)
      ) then
      unit
    else
      trap("cross-axis grounding is symmetric")
  else
    trap(
      "(Signed, WidthDef) ~ (SignDef, WFixed 8) → Int8 (each axis grounds from a different operand)"
    )

@test
def ut-bool-unifies() =
  // Bool ~ Bool → Bool; Bool ~ Int64 → conflict; Int64 ~ TyErr → conflict.
  if unifies-to(unify-ty(Ty.TyBool, Ty.TyBool), Ty.TyBool) then
    if conflicts(unify-ty(Ty.TyBool, ty-int64())) then
      if conflicts(unify-ty(ty-int64(), Ty.TyErr)) then unit else trap("Int64~TyErr conflict")
    else
      trap("Bool~Int64 conflict")
  else
    trap("Bool~Bool")

// ---- HIGHER-ORDER: arrow (TyFn) unification -------------------------------------------------------
/// A 1-param fn type `(a) -> r`.
def fn1(a: Ty, r: Ty) = Ty.TyFn(List.push([], a), r)

@test
def ut-fn-same-unifies() =
  // (Int64) -> Int64  ~  (Int64) -> Int64  →  (Int64) -> Int64.
  if unifies-to(
      unify-ty(fn1(ty-int64(), ty-int64()), fn1(ty-int64(), ty-int64())),
      fn1(ty-int64(), ty-int64())
    ) then
    unit
  else
    trap("(Int64)->Int64 self-unify")

@test
def ut-fn-param-grounds() =
  // (deferred) -> Int64  ~  (Int8) -> Int64  →  (Int8) -> Int64 (the param arg grounds pairwise).
  if unifies-to(
      unify-ty(fn1(ty-deferred-int(), ty-int64()), fn1(ty-fixed-int(true, 8), ty-int64())),
      fn1(ty-fixed-int(true, 8), ty-int64())
    ) then
    unit
  else
    trap("fn param grounds via pairwise unify")

@test
def ut-fn-result-conflict() =
  // (Int64) -> Int8  ~  (Int64) -> Int16  →  conflict (results differ).
  if conflicts(
      unify-ty(fn1(ty-int64(), ty-fixed-int(true, 8)), fn1(ty-int64(), ty-fixed-int(true, 16)))
    ) then
    unit
  else
    trap("fn result conflict")

@test
def ut-fn-arity-conflict() =
  // (Int64) -> Int64  ~  (Int64, Int64) -> Int64  →  conflict (arity differs).
  if conflicts(
      unify-ty(
        fn1(ty-int64(), ty-int64()),
        Ty.TyFn(List.push(List.push([], ty-int64()), ty-int64()), ty-int64())
      )
    ) then
    unit
  else
    trap("fn arity conflict")

@test
def ut-fn-vs-int-conflict() =
  // a fn type never unifies with an int (cross-kind) — nor with Bool/Err.
  if conflicts(unify-ty(fn1(ty-int64(), ty-int64()), ty-int64())) then
    if conflicts(unify-ty(ty-int64(), fn1(ty-int64(), ty-int64()))) then
      unit
    else
      trap("int~fn conflict (sym)")
  else
    trap("fn~int conflict")

@test
def ut-sum-same-decl() =
  // M2-b-2b-ii-c2 DECL-IDENTITY: two sum types with the SAME decl name-id unify to that sum (never structural
  // inner). TySum(7) ~ TySum(7) → Some(TySum(7)).
  if unifies-to(unify-ty(Ty.TySum(7), Ty.TySum(7)), Ty.TySum(7)) then
    unit
  else
    trap("TySum(7)~TySum(7) → TySum(7)")

@test
def ut-sum-diff-decl-conflict() =
  // two DIFFERENT sum decls never unify (a Color vs a Bit scrutinee is a cross-type reject).
  if conflicts(unify-ty(Ty.TySum(7), Ty.TySum(8))) then unit else trap("TySum(7)~TySum(8) conflict")

@test
def ut-sum-vs-non-sum-conflict() =
  // a sum type never unifies with a non-sum (int / bool / fn) — nor symmetrically.
  if conflicts(unify-ty(Ty.TySum(7), ty-int64())) then
    if conflicts(unify-ty(ty-int64(), Ty.TySum(7))) then
      if conflicts(unify-ty(Ty.TySum(7), Ty.TyBool)) then unit else trap("sum~bool conflict")
    else
      trap("int~sum conflict (sym)")
  else
    trap("sum~int conflict")

export { unify-sign, unify-width, unify-int, unify-ty, unify-ty-list }
