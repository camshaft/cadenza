effect Test =
  | gen : Unit -> Int64
  | fail : String -> Unit

def assert(cond, msg: String) =
  if cond then
    unit
  else
    host Test in (
      Test.fail(msg);
      trap("assertion failed")
    )

def assert_eq(a, b, msg: String) =
  if a == b then
    unit
  else
    host Test in (
      Test.fail(msg);
      trap("assertion failed")
    )

def assert_ne(a, b, msg: String) =
  if a == b then
    host Test in (
      Test.fail(msg);
      trap("assertion failed")
    )
  else
    unit

@test def arithmetic_holds() =
  assert_eq(1 + 1, 2, "1 + 1 should be 2")

@test def comparison_holds() =
  assert(3 > 2, "3 should be greater than 2")

@test def values_differ() =
  assert_ne(1, 2, "1 and 2 should differ")

@test def a_failing_example() =
  assert_eq(2 + 2, 5, "expected 2 + 2 to be 5 (it is not — this test fails on purpose)")

@test def negation_is_involutive(n: Int64) =
  assert_eq(0 - (0 - n), n, "negating twice returns the original")

@test def and_with_true_is_identity(b: Bool) =
  assert(if b then (b and true) else ((b and true) == false), "b and true equals b")

@test def generated_int_is_reflexive() =
  host Test in (
    let n = Test.gen() in
    assert(n == n, "a generated int equals itself")
  )

@test def a_generated_pair_negates_involutively() =
  host Test in (
    let a = Test.gen() in
    let b = Test.gen() in
    assert(
      (0 - (0 - a)) == a,
      "negating a generated value twice returns it (for each field of a generated pair)"
    );
    assert((0 - (0 - b)) == b, "…and the second field too")
  )
