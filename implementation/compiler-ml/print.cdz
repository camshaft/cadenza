type Ast =
  | Int(Int64)
  | Str(String)
  | Bool(Bool)
  | Name(String)
  | List(List(Ast))

def digit(x: Int64) =
  if x == 0 then
    "0"
  else
    if x == 1 then
      "1"
    else
      if x == 2 then
        "2"
      else
        if x == 3 then
          "3"
        else
          if x == 4 then
            "4"
          else
            if x == 5 then
              "5"
            else
              if x == 6 then "6" else if x == 7 then "7" else if x == 8 then "8" else "9"

def itoa-pos(n: Int64) = if n < 10 then digit(n) else String.concat(itoa-pos(n / 10), digit(n % 10))

def itoa(n: Int64) = if n < 0 then String.concat("-", itoa-pos(0 - n)) else itoa-pos(n)

def print(node: Ast) = match node with
  | Ast.Int(n) => itoa(n)
  | Ast.Str(s) => String.concat("\"", String.concat(s, "\""))
  | Ast.Bool(b) => (if b then "true" else "false")
  | Ast.Name(nm) => nm
  | Ast.List(es) => String.concat("(", String.concat(print-list(es), ")"))

def print-list(es: List(Ast)) = match es with
  | [] => ""
  | [x, .. rest] => match rest with
    | [] => print(x)
    | _ => String.concat(print(x), String.concat(" ", print-list(rest)))

@test
def print-int() = if print(Ast.Int(42)) == "42" then unit else trap("Int 42")

@test
def print-neg() = if print(Ast.Int(0 - 7)) == "-7" then unit else trap("Int -7")

@test
def print-big() = if print(Ast.Int(12345)) == "12345" then unit else trap("Int 12345")

@test
def print-name() = if print(Ast.Name("foo")) == "foo" then unit else trap("Name foo")

@test
def print-bool() = if print(Ast.Bool(true)) == "true" then unit else trap("Bool true")

@test
def print-str() = if print(Ast.Str("hi")) == "\"hi\"" then unit else trap("Str hi")

@test
def print-flat-list() =
  if print(Ast.List([Ast.Name("add"), Ast.Int(1), Ast.Int(2)])) == "(add 1 2)" then
    unit
  else
    trap("flat list")

@test
def print-nested() =
  if print(Ast.List([Ast.Name("f"), Ast.List([Ast.Int(1), Ast.Int(2)])])) == "(f (1 2))" then
    unit
  else
    trap("nested list")

@test
def print-empty-list() = if print(Ast.List([])) == "()" then unit else trap("empty list")

export { print }
