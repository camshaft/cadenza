/// iter.cdz — a lazy, pull-driven iterator, realizing the `iterators-as-lazy-pull-computations`
/// proposal in runnable Cadenza. An iterator is a lazy sequence pulled one element at a time;
/// transformers (map/filter/take/…) build a new iterator without forcing anything, and a consumer
/// (fold/count/collect/…) drives the pull.
///
/// ENCODING — reified (defunctionalized), not a thunk. The proposal's alternative form is a thunk
/// `Iter(a) = Susp(Unit -> Option (a, Iter(a)))`. That once DECLINED — a `Unit`-parameter closure boxed
/// into a heap sum was rejected ("a closure's parameter type has no machine representation") — but that
/// gap is now RESOLVED (queue: `mlrepro-decline-unit-param-closure-boxed-in-sum`, pinned by
/// `unit-param-closure-boxed-regression` below), so the thunk form is expressible today. The reified form
/// is RETAINED anyway: it makes each step-shape inspectable, needs no per-pull closure allocation, and the
/// generic story is blocked on OTHER open gaps (see ELEMENT TYPE), so a thunk rewrite would not unlock the
/// generic version. An iterator is a SUM of the known step-shapes and `next` interprets one step — still
/// lazy (`map`/`filter` build a wrapping variant and force nothing until `next` pulls), each closure stored
/// over the ELEMENT type, never `Unit`.
///
/// ELEMENT TYPE — this iterator is monomorphic over `Int64`. A fully generic `Iter(a)` type-checks for
/// the producers/transformers with unannotated signatures, but a generic recursive CONSUMER that
/// threads a closure through its recursion (`fold`/`find`) fails to determine the type argument, and
/// exporting a generic combinator is rejected at the component boundary — see
/// `mlrepro-decline-generic-recursive-consumer-threads-closure.cdz` (queue) and
/// `mlrepro-reject-user-generic-type-var-in-annotation.cdz` (queue). `Int64` is the port's pervasive element
/// type, so a monomorphic iterator is the honest, working shape today; the generic version is a
/// documented follow-up gated on those fixes.
///
/// HIGHER-ORDER PARAMETERS carry an explicit ARROW annotation (`f: Int64 -> Int64 -> Int64`,
/// `p: Int64 -> Bool`). That is still required, but NOT for the reason it once was: an unannotated
/// closure threaded through a self-recursive HOF used to fail to infer its parameter types (CDZ0203,
/// "no machine representation" — the constraint `traverse.cdz` documented). That inference gap is now
/// RESOLVED upstream. What the annotation buys today is the ELEMENT TYPE: dropping it from a self-recursive
/// consumer like `fold` reports CDZ0201 (the recursive-generic element tie — see the ELEMENT TYPE note
/// above), not a param-type failure. The arrow pins the element to `Int64` so the monomorphic consumer
/// type-checks; it is the anchor for the element type, no longer for the closure's param types.
/// The reified iterator. Each variant is a step-shape `next` knows how to interpret.
///   - `FromList(xs)`      — yield the list's elements in order.
///   - `RangeI((lo, hi))`  — yield `lo, lo+1, …, hi-1` (half-open).
///   - `MapI((f, src))`    — yield `f(x)` for each `x` from `src`.
///   - `FilterI((p, src))` — yield each `x` from `src` for which `p(x)` holds.
///   - `TakeI((n, src))`   — yield at most the first `n` elements of `src`.
///   - `DropI((n, src))`   — yield `src` with its first `n` elements skipped.
///   - `TakeWhileI((p, src))` — yield `src`'s leading run for which `p` holds, then stop.
///   - `ChainI((a, b))`       — yield all of `a`, then all of `b` (concatenation).
///   - `ZipWithI((f, (a, b)))`— yield `f(x, y)` for each pair `x` from `a`, `y` from `b`; stops when
///                              either runs out (the shorter one bounds the result).
///   - `ScanI((f, acc, src))` — inclusive left scan: yield the running accumulator `f(acc, x)` for
///                              each `x` from `src`.
///   - `IterateI((f, cur))`   — the INFINITE iterator `cur, f(cur), f(f(cur)), …`; bound it with
///                              `take`/`take-while` to make it finite.
///   - `StepRangeI((lo, hi, step))` — yield `lo, lo+step, lo+2·step, …` while `< hi` (half-open); the
///                              step is assumed positive (a non-positive step yields nothing).
///   - `DownRangeI((hi, lo))` — the DESCENDING half-open range: yield `hi-1, hi-2, …, lo`. Empty when
///                              `hi <= lo`. The reverse of `RangeI((lo, hi))`.
///   - `InclRangeI((lo, hi))` — the INCLUSIVE range `[lo, hi]`: yield `lo, lo+1, …, hi`. A dedicated
///                              variant (not `RangeI((lo, hi+1))`) so `hi == Int64.max` cannot overflow.
///   - `FlatMapI((f, cur, src))` — map each `x` from `src` to a sub-iterator `f(x)` and flatten in
///                              order; `cur` is the sub-iterator currently being drained (starts empty).
///   - `IntersperseI((sep, pending, src))` — yield `src`'s elements with `sep` between each pair; no
///                              trailing separator. `pending` = "a separator is due before the next
///                              element" (false before the very first element).
///   - `StepByI((n, src))`    — yield every `n`-th element of `src` (the 1st, then skip `n-1`): src's
///                              elements at indices 0, n, 2n, … A non-positive `n` yields nothing.
///   - `DedupI((have, prev, src))` — drop CONSECUTIVE duplicates: yield an element only if it differs
///                              from the one just yielded. `have` = "a previous element exists"; `prev`
///                              = that element. (Local, not global dedup — `[1,1,2,1]` → `[1,2,1]`.)
type Iter =
  | FromList(List(Int64))
  | RangeI(Tuple(Int64, Int64))
  | MapI(Tuple(Int64 -> Int64, Iter))
  | FilterI(Tuple(Int64 -> Bool, Iter))
  | TakeI(Tuple(Int64, Iter))
  | DropI(Tuple(Int64, Iter))
  | TakeWhileI(Tuple(Int64 -> Bool, Iter))
  | ChainI(Tuple(Iter, Iter))
  | ZipWithI(Tuple(Int64 -> Int64 -> Int64, Tuple(Iter, Iter)))
  | ScanI(Tuple(Int64 -> Int64 -> Int64, Tuple(Int64, Iter)))
  | IterateI(Tuple(Int64 -> Int64, Int64))
  | StepRangeI(Tuple(Int64, Tuple(Int64, Int64)))
  | DownRangeI(Tuple(Int64, Int64))
  | InclRangeI(Tuple(Int64, Int64))
  | FlatMapI(Tuple(Int64 -> Iter, Tuple(Iter, Iter)))
  | IntersperseI(Tuple(Int64, Tuple(Bool, Iter)))
  | StepByI(Tuple(Int64, Iter))
  | DedupI(Tuple(Bool, Tuple(Int64, Iter)))

/// Step once: yield `Option((element, rest))` — `None` at exhaustion, never a trap. Total and pure;
/// `rest` is a fresh iterator for the remainder, so an iterator is re-steppable and shareable.
def next(it) = match it with
  | Iter.FromList(xs) => (
    match xs with
      | [] => Option.None(unit)
      | [h, .. t] => Option.Some((h, Iter.FromList(t)))
  )
  | Iter.RangeI(r) =>
    let (lo, hi) = r in
    if lo < hi then Option.Some((lo, Iter.RangeI((lo + 1, hi)))) else Option.None(unit)
  | Iter.MapI(mf) => (
    let (f, src) = mf in
    match next(src) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(p) =>
        let (v, rest) = p in
        Option.Some((f(v), Iter.MapI((f, rest))))
  )
  | Iter.FilterI(pf) => (
    let (p, src) = pf in
    match next(src) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(pr) =>
        let (v, rest) = pr in
        if p(v) then Option.Some((v, Iter.FilterI((p, rest)))) else next(Iter.FilterI((p, rest)))
  )
  | Iter.TakeI(nf) => (
    let (n, src) = nf in
    if n <= 0 then
      Option.None(unit)
    else
      match next(src) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(p) =>
          let (v, rest) = p in
          Option.Some((v, Iter.TakeI((n - 1, rest))))
  )
  | Iter.DropI(nf) => (
    let (n, src) = nf in
    if n <= 0 then
      next(src)
    else
      match next(src) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(p) =>
          let (v, rest) = p in
          next(Iter.DropI((n - 1, rest)))
  )
  | Iter.TakeWhileI(pf) => (
    let (p, src) = pf in
    match next(src) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(pr) =>
        let (v, rest) = pr in
        if p(v) then Option.Some((v, Iter.TakeWhileI((p, rest)))) else Option.None(unit)
  )
  | Iter.ChainI(ab) => (
    let (a, b) = ab in
    match next(a) with
      // drain `a` first; when `a` is exhausted, step straight into `b`
      | Option.None(_) => next(b)
      | Option.Some(p) =>
        let (v, rest) = p in
        Option.Some((v, Iter.ChainI((rest, b))))
  )
  | Iter.ZipWithI(zf) => (
    let (f, ab) = zf in
    let (a, b) = ab in
    match next(a) with
      // stop as soon as EITHER side runs out — the shorter iterator bounds the result
      | Option.None(_) => Option.None(unit)
      | Option.Some(pa) =>
        let (va, ra) = pa in
        match next(b) with
          | Option.None(_) => Option.None(unit)
          | Option.Some(pb) =>
            let (vb, rb) = pb in
            Option.Some((f(va, vb), Iter.ZipWithI((f, (ra, rb)))))
  )
  | Iter.ScanI(sf) => (
    let (f, acc-src) = sf in
    let (acc, src) = acc-src in
    // yield the running accumulator, threading the new acc into the rest
    match next(src) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(p) =>
        let (v, rest) = p in
        let acc2 = f(acc, v) in
        Option.Some((acc2, Iter.ScanI((f, (acc2, rest)))))
  )
  | Iter.IterateI(itf) =>
    let (f, cur) = itf in
    // never exhausts: yield `cur`, and the rest resumes from `f(cur)`
    Option.Some((cur, Iter.IterateI((f, f(cur)))))
  | Iter.StepRangeI(sr) =>
    let (lo, hi-step) = sr in
    let (hi, step) = hi-step in
    // yield `lo` while below `hi`, advancing by `step`. Guards: a non-positive step never advances
    // (no infinite pull); and `lo + step` is only computed when it cannot overflow — if `lo` is within
    // `step` of `Int64.max` there is no representable next element below `hi`, so the rest is empty.
    // `next` stays TOTAL (never traps) even for a range abutting `Int64.max`.
    if step <= 0 then
      Option.None(unit)
    else if lo < hi then
      if lo > Int64.max - step then
        Option.Some((lo, Iter.StepRangeI((hi, (hi, step)))))
      else
        Option.Some((lo, Iter.StepRangeI((lo + step, (hi, step)))))
    else
      Option.None(unit)
  | Iter.DownRangeI(dr) =>
    let (hi, lo) = dr in
    // descending half-open: yield `hi-1` while it is still `>= lo`, then continue from `hi-1`
    if hi > lo then Option.Some((hi - 1, Iter.DownRangeI((hi - 1, lo)))) else Option.None(unit)
  | Iter.InclRangeI(ir) =>
    let (lo, hi) = ir in
    // inclusive `[lo, hi]`: yield `lo` while `lo <= hi`. `lo + 1` is computed ONLY when `lo < hi`, so
    // it is at most `hi <= Int64.max` — no overflow even when `hi == Int64.max` (the last element is
    // yielded with an empty rest rather than an overflowing `lo + 1`). Total: `next` never traps.
    if lo > hi then
      Option.None(unit)
    else if lo < hi then
      Option.Some((lo, Iter.InclRangeI((lo + 1, hi))))
    else
      Option.Some((lo, Iter.FromList([])))
  | Iter.FlatMapI(ff) => (
    let (f, cur-src) = ff in
    let (cur, src) = cur-src in
    // drain the current sub-iterator; when it is empty, pull the next source element `x` and open
    // `f(x)` as the new current sub-iterator (recursing to skip any empty sub-iterators)
    match next(cur) with
      | Option.Some(p) =>
        let (v, rest) = p in
        Option.Some((v, Iter.FlatMapI((f, (rest, src)))))
      | Option.None(_) =>
        match next(src) with
          | Option.None(_) => Option.None(unit)
          | Option.Some(ps) =>
            let (x, srest) = ps in
            next(Iter.FlatMapI((f, (f(x), srest))))
  )
  | Iter.IntersperseI(isp) => (
    let (sep, pending-src) = isp in
    let (pending, src) = pending-src in
    // if a separator is pending AND the source still has an element, yield `sep` (then next yields the
    // element); otherwise yield the next source element and mark a separator pending before the one after
    if pending then
      match next(src) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(_) => Option.Some((sep, Iter.IntersperseI((sep, (false, src)))))
    else
      match next(src) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(p) =>
          let (v, rest) = p in
          Option.Some((v, Iter.IntersperseI((sep, (true, rest)))))
  )
  | Iter.StepByI(sb) => (
    let (n, src) = sb in
    // yield the head, then advance the rest by dropping the next `n-1` elements (via the lazy DropI).
    // A non-positive `n` yields nothing (guards against a zero/negative stride).
    if n <= 0 then
      Option.None(unit)
    else
      match next(src) with
        | Option.None(_) => Option.None(unit)
        | Option.Some(p) =>
          let (v, rest) = p in
          Option.Some((v, Iter.StepByI((n, Iter.DropI((n - 1, rest))))))
  )
  | Iter.DedupI(dd) =>
    let (have, prev-src) = dd in
    let (prev, src) = prev-src in
    // yield an element only if it differs from the one just yielded (`prev`, valid when `have`). A
    // duplicate recurses to skip it, threading the same `prev`; a new value yields + becomes the new `prev`.
    match next(src) with
      | Option.None(_) => Option.None(unit)
      | Option.Some(p) =>
        let (v, rest) = p in
        if have then
          if v == prev then
            next(Iter.DedupI((true, (prev, rest))))
          else
            Option.Some((v, Iter.DedupI((true, (v, rest)))))
        else
          Option.Some((v, Iter.DedupI((true, (v, rest)))))

// ── Producers ──────────────────────────────────────────────────────────────────────────────────
/// The empty iterator — yields nothing.
def empty() = Iter.FromList([])

/// Yield the elements of a list, in order.
def from-list(xs) = Iter.FromList(xs)

/// Yield `lo, lo+1, …, hi-1` (half-open interval). Empty when `lo >= hi`.
def range(lo, hi) = Iter.RangeI((lo, hi))

/// The INFINITE iterator `seed, f(seed), f(f(seed)), …`. Bound it with `take`/`take-while`.
def iterate(seed, f: Int64 -> Int64) = Iter.IterateI((f, seed))

/// Yield `lo, lo+1, …, hi` — the INCLUSIVE interval `[lo, hi]` (Rust's `lo..=hi`). Empty when
/// `lo > hi`. This is the semantic target of the future `lo..=hi` surface sugar. Uses a dedicated
/// `InclRangeI` variant rather than `RangeI((lo, hi+1))` so `hi == Int64.max` cannot overflow.
def range-inclusive(lo, hi) = Iter.InclRangeI((lo, hi))

/// Yield `lo, lo+step, lo+2·step, …` while `< hi` (half-open), for a positive `step`. A non-positive
/// step yields nothing. This is the semantic target of a future stepped-range surface.
def range-step(lo, hi, step) = Iter.StepRangeI((lo, (hi, step)))

/// Yield `hi-1, hi-2, …, lo` — the DESCENDING half-open range, the reverse of `range(lo, hi)`. Empty
/// when `hi <= lo`. Handy for counting down (`range-down(5, 0)` → 4, 3, 2, 1, 0).
def range-down(hi, lo) = Iter.DownRangeI((hi, lo))

/// Iterate a SET's elements in CANONICAL (sorted) element order. Bridges a collection into the lazy
/// pull-iterator via `Set.to-list` (the deterministic-order enumeration) + `from-list`, so every
/// iterator transformer/consumer (map/filter/fold/…) composes over a set. Monomorphic `Set Int64` here
/// (iter.cdz is Int64), matching the iterator's element type.
def iter-set(s) = Iter.FromList(Set.to-list(s))

// project the keys / values out of a `List (Tuple Int64 Int64)` (what `Map.to-list` yields) into a
// bare `List Int64` the monomorphic-Int64 iterator can carry. Preserves canonical KEY order.
def map-keys-list(pairs: List(Tuple(Int64, Int64))) = match pairs with
  | [] => []
  | [h, .. t] =>
    let (k, _v) = h in
    List.concat([k], map-keys-list(t))

def map-vals-list(pairs: List(Tuple(Int64, Int64))) = match pairs with
  | [] => []
  | [h, .. t] =>
    let (_k, v) = h in
    List.concat([v], map-vals-list(t))

/// Iterate a MAP's KEYS in CANONICAL key order. Bridges a map into the Int64 iterator via
/// `Map.to-list` (canonical-key-order entries) + a key projection, so map keys drop into every
/// transformer/consumer. (A full pair-element `iter-map` needs a generic/tuple-element iterator —
/// gated on the recursive-generic tie fix; keys/values are the Int64-typed halves available today.)
def iter-map-keys(m) = Iter.FromList(map-keys-list(Map.to-list(m)))

/// Iterate a MAP's VALUES in CANONICAL key order (each value paired with its key's sort position).
def iter-map-values(m) = Iter.FromList(map-vals-list(Map.to-list(m)))

// ── EntryIter: a pull-iterator over a map's (key, value) ENTRIES ─────────────────────────────────
// The main `Iter` is monomorphic over the Int64 ELEMENT; a map ENTRY is a `(Int64, Int64)` pair, a
// distinct element shape. `EntryIter` is the small companion that carries pairs, so `iter-map-entries`
// can walk key AND value together in one pass — which `iter-map-keys`/`iter-map-values` (Int64 halves)
// cannot. Minimal on purpose (a `next` + the entry consumers below), NOT a full parallel transformer
// API; the general pair/tuple-element iterator is the any-element-type follow-up (gated on the
// recursive-generic tie fix). Entries come in CANONICAL KEY order (from `Map.to-list`).
type EntryIter =
  | EFromList(List(Tuple(Int64, Int64)))

/// Step an `EntryIter`: yield `Option(((key, value), rest))`, `None` at exhaustion. Total and pure.
def entry-next(it) =
  let EntryIter.EFromList(xs) = it in
  match xs with
    | [] => Option.None(unit)
    | [h, .. t] => Option.Some((h, EntryIter.EFromList(t)))

/// Iterate a MAP's ENTRIES as `(key, value)` pairs in CANONICAL key order.
def iter-map-entries(m) = EntryIter.EFromList(Map.to-list(m))

// build the `(index, element)` pair list by walking an Int64 iterator with a running index. Forces the
// source (materializes into the EntryIter's list) — enumerate is EAGER, unlike the lazy Iter transformers.
def index-pairs-from(it, i) = match next(it) with
  | Option.None(_) => []
  | Option.Some(p) =>
    let (v, rest) = p in
    List.concat([(i, v)], index-pairs-from(rest, i + 1))

/// Pair each element of an iterator with its zero-based INDEX, as an `EntryIter` of `(index, element)`.
/// The index-carrying companion of `iter-map-entries` — walk index AND value together
/// (`fold-entries(enumerate(it), …, fn(acc, i, x) => …)`). Reuses the `(Int64, Int64)` EntryIter, so no
/// generic/tuple element is needed. NB: eager (drains the source), so bound an infinite source with
/// `take` FIRST (`enumerate(take(iterate(…), n))`).
def enumerate(it) = EntryIter.EFromList(index-pairs-from(it, 0))

// build the adjacent-pair list `(prev, cur)` by walking with the previous element. `have` = "a previous
// element exists" (skips emitting until the 2nd element). Eager, like enumerate.
def adjacent-pairs-from(it, have, prev) = match next(it) with
  | Option.None(_) => []
  | Option.Some(p) =>
    let (v, rest) = p in
    if have then
      List.concat([(prev, v)], adjacent-pairs-from(rest, true, v))
    else
      adjacent-pairs-from(rest, true, v)

/// Pair each element with its PREDECESSOR: `[a, b, c, d]` → `(a,b), (b,c), (c,d)` as an `EntryIter`.
/// `n` elements yield `n-1` pairs (a 0/1-element source yields none). The sliding-window-of-2 view — walk
/// consecutive pairs together (`fold-entries(pairwise(it), …, fn(acc, prev, cur) => …)`), e.g. for deltas
/// `cur - prev`. Reuses the `(Int64, Int64)` EntryIter (no generic element). Eager, like `enumerate`.
def pairwise(it) = EntryIter.EFromList(adjacent-pairs-from(it, false, 0))

// build the element-wise pair list of two iterators, stopping when EITHER runs out. Eager.
def zip-pairs-from(a, b) = match next(a) with
  | Option.None(_) => []
  | Option.Some(pa) =>
    let (x, ra) = pa in
    match next(b) with
      | Option.None(_) => []
      | Option.Some(pb) =>
        let (y, rb) = pb in
        List.concat([(x, y)], zip-pairs-from(ra, rb))

/// Zip two iterators element-wise into an `EntryIter` of `(a_i, b_i)` pairs, stopping at the shorter.
/// The PAIR-yielding companion of `zip-with` (which combines each pair into one scalar via `f`) — keeps
/// both elements, so you can `fold-entries` over `(x, y)` (e.g. a dot product `acc + x*y`). Reuses the
/// `(Int64, Int64)` EntryIter (no generic element). Eager; bound infinite sources with `take` first.
def zip-to-entries(a, b) = EntryIter.EFromList(zip-pairs-from(a, b))

/// Left fold over entries: thread `acc` through `f(acc, key, value)` for every entry, in key order.
def fold-entries(it, acc, f: Int64 -> Int64 -> Int64 -> Int64) = match entry-next(it) with
  | Option.None(_) => acc
  | Option.Some(p) =>
    let (kv, rest) = p in
    let (k, v) = kv in
    fold-entries(rest, f(acc, k, v), f)

/// Number of entries the entry-iterator yields (the map's entry count).
def entry-count(it) = fold-entries(it, 0, fn(a, _k, _v) => a + 1)

// ── Transformers (lazy — build a wrapping step, force nothing) ──────────────────────────────────
/// Map `f` over every element.
def map(it, f: Int64 -> Int64) = Iter.MapI((f, it))

/// Keep the elements `p` accepts.
def filter(it, p: Int64 -> Bool) = Iter.FilterI((p, it))

/// Yield at most the first `n` elements.
def take(it, n) = Iter.TakeI((n, it))

/// Skip the first `n` elements.
def drop(it, n) = Iter.DropI((n, it))

/// Yield the leading run of elements for which `p` holds, then stop.
def take-while(it, p: Int64 -> Bool) = Iter.TakeWhileI((p, it))

/// Yield every `n`-th element of `it`: the element at index 0, then n, 2n, … (keep one, skip `n-1`).
/// A non-positive `n` yields nothing. Generalizes `range-step` to any iterator source.
def step-by(it, n) = Iter.StepByI((n, it))

/// Drop CONSECUTIVE duplicate elements: yield each element only when it differs from the one just
/// yielded (`[1,1,2,2,3,1]` → `[1,2,3,1]`). Local, not global — on a sorted/grouped source it removes
/// all duplicates; on an arbitrary source only runs of equal neighbors collapse.
def dedup(it) = Iter.DedupI((false, (0, it)))

/// Concatenate: yield all of `it`, then all of `other`.
def chain(it, other) = Iter.ChainI((it, other))

/// Zip two iterators with `f`: yield `f(x, y)` for paired elements, stopping when either runs out.
def zip-with(it, other, f: Int64 -> Int64 -> Int64) = Iter.ZipWithI((f, (it, other)))

/// Inclusive left scan: yield the running accumulator `f(acc, x)` for each element, seeded with `init`.
def scan(it, init, f: Int64 -> Int64 -> Int64) = Iter.ScanI((f, (init, it)))

/// Map each element to a sub-iterator via `f` and flatten the results in order. The current
/// sub-iterator starts empty, so the first `next` pulls the first source element and opens `f(x)`.
/// (`f`'s `Int64 -> Iter` closure returns the iterator sum itself; this was previously blocked by a
/// closure-dispatch + closure-param-type gap, both now fixed upstream — see the retired
/// `mlrepro-decline-two-distinct-closure-typed-variants-in-one-sum` finding.)
def flat-map(it, f: Int64 -> Iter) = Iter.FlatMapI((f, (empty(), it)))

/// Insert `sep` between consecutive elements (no leading or trailing separator). An empty or
/// single-element source is unchanged. E.g. intersperse([1,2,3], 0) yields 1, 0, 2, 0, 3.
def intersperse(it, sep) = Iter.IntersperseI((sep, (false, it)))

// ── Consumers (drive the pull) ──────────────────────────────────────────────────────────────────
/// Left fold: thread `acc` through `f(acc, elem)` over every element.
def fold(it, acc, f: Int64 -> Int64 -> Int64) = match next(it) with
  | Option.None(_) => acc
  | Option.Some(p) =>
    let (v, rest) = p in
    fold(rest, f(acc, v), f)

/// Fold WITHOUT an initial accumulator: seed with the first element, then combine the rest with `f`.
/// `None` for an empty iterator (there is no element to seed with). Useful for `max`/`min`/`gcd`-style
/// reductions where the identity is the first value.
def reduce(it, f: Int64 -> Int64 -> Int64) = match next(it) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(p) =>
    let (v, rest) = p in
    Option.Some(fold(rest, v, f))

/// Number of elements the iterator yields.
def count(it) = fold(it, 0, fn(a, v) => a + 1)

/// Sum of the elements.
def sum(it) = fold(it, 0, fn(a, v) => a + v)

/// Product of the elements (empty iterator → 1, the multiplicative identity).
def product(it) = fold(it, 1, fn(a, v) => a * v)

/// Does the iterator yield `target`? (short-circuits on the first match)
def contains(it, target) = match next(it) with
  | Option.None(_) => false
  | Option.Some(p) =>
    let (v, rest) = p in
    if v == target then true else contains(rest, target)

// zero-based position of the first element equal to `target`, threading the running index
def position-from(it, target, i) = match next(it) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(p) =>
    let (v, rest) = p in
    if v == target then Option.Some(i) else position-from(rest, target, i + 1)

/// The zero-based INDEX of the first element equal to `target`, or `None` (the index counterpart of
/// `contains`; short-circuits on the first match).
def position(it, target) = position-from(it, target, 0)

/// Drive the pull for its effect: apply `f` to every element in order, returning `unit`. This is the
/// imperative consumer a future `for x in it` form desugars to. Diverges on an infinite source, so
/// bound one with `take` first.
def for-each(it, f: Int64 -> Unit) = match next(it) with
  | Option.None(_) => unit
  | Option.Some(p) =>
    let (v, rest) = p in
    let _ = f(v) in
    for-each(rest, f)

/// Materialize the iterator back into a list (the bridge from computation back to data).
def collect-list(it) = match next(it) with
  | Option.None(_) => []
  | Option.Some(p) =>
    let (v, rest) = p in
    List.concat([v], collect-list(rest))

/// The first element `p` accepts, or `None`.
def find(it, p: Int64 -> Bool) = match next(it) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(pr) =>
    let (v, rest) = pr in
    if p(v) then Option.Some(v) else find(rest, p)

/// Does any element satisfy `p`? (short-circuits)
def any(it, p: Int64 -> Bool) = match find(it, p) with
  | Option.Some(_) => true
  | Option.None(_) => false

/// Do all elements satisfy `p`? (short-circuits on the first failure)
def all(it, p: Int64 -> Bool) = match next(it) with
  | Option.None(_) => true
  | Option.Some(pr) =>
    let (v, rest) = pr in
    if p(v) then all(rest, p) else false

/// How many elements satisfy `p` — the count of the sub-sequence `filter(it, p)` would yield, without
/// materializing it. (The predicate companion of `count`.)
def count-where(it, p: Int64 -> Bool) = match next(it) with
  | Option.None(_) => 0
  | Option.Some(pr) =>
    let (v, rest) = pr in
    if p(v) then 1 + count-where(rest, p) else count-where(rest, p)

/// Does the iterator yield NO elements? `true` iff the first pull is exhaustion (does not drain the
/// whole iterator — the O(1) emptiness test).
def is-empty(it) = match next(it) with
  | Option.None(_) => true
  | Option.Some(_) => false

/// The last element, or `None` if the iterator is empty. Diverges on an infinite iterator, so bound
/// such a source with `take` first.
def last(it) = match next(it) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(p) =>
    let (v, rest) = p in
    match next(rest) with
      | Option.None(_) => Option.Some(v)
      | Option.Some(_) => last(rest)

/// The element at zero-based index `n`, or `None` if the iterator is shorter.
def nth(it, n) = match next(it) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(p) =>
    let (v, rest) = p in
    if n <= 0 then Option.Some(v) else nth(rest, n - 1)

// running helpers keep the current best while pulling the rest (closure-free — no fold combinator)
def max-from(it, best) = match next(it) with
  | Option.None(_) => best
  | Option.Some(p) =>
    let (v, rest) = p in
    if v > best then max-from(rest, v) else max-from(rest, best)

def min-from(it, best) = match next(it) with
  | Option.None(_) => best
  | Option.Some(p) =>
    let (v, rest) = p in
    if v < best then min-from(rest, v) else min-from(rest, best)

/// The largest element, or `None` if empty.
def max(it) = match next(it) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(p) =>
    let (v, rest) = p in
    Option.Some(max-from(rest, v))

/// The smallest element, or `None` if empty.
def min(it) = match next(it) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(p) =>
    let (v, rest) = p in
    Option.Some(min-from(rest, v))

// keep the element whose `key` is largest so far, threading (best-elem, best-key)
def max-by-from(it, best, best-key, key: Int64 -> Int64) = match next(it) with
  | Option.None(_) => best
  | Option.Some(p) =>
    let (v, rest) = p in
    let k = key(v) in
    if k > best-key then max-by-from(rest, v, k, key) else max-by-from(rest, best, best-key, key)

def min-by-from(it, best, best-key, key: Int64 -> Int64) = match next(it) with
  | Option.None(_) => best
  | Option.Some(p) =>
    let (v, rest) = p in
    let k = key(v) in
    if k < best-key then min-by-from(rest, v, k, key) else min-by-from(rest, best, best-key, key)

/// The element with the largest `key(elem)`, or `None` if empty. Ties keep the first seen.
def max-by(it, key: Int64 -> Int64) = match next(it) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(p) =>
    let (v, rest) = p in
    Option.Some(max-by-from(rest, v, key(v), key))

/// The element with the smallest `key(elem)`, or `None` if empty. Ties keep the first seen.
def min-by(it, key: Int64 -> Int64) = match next(it) with
  | Option.None(_) => Option.None(unit)
  | Option.Some(p) =>
    let (v, rest) = p in
    Option.Some(min-by-from(rest, v, key(v), key))

// ── Tests ────────────────────────────────────────────────────────────────────────────────────────
def int-list-eq(a, b) = match a with
  | [] => (
    match b with
      | [] => true
      | _ => false
  )
  | [x, .. xs] =>
    match b with
      | [] => false
      | [y, .. ys] => if x == y then int-list-eq(xs, ys) else false

@test
def empty-yields-nothing() = match next(empty()) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("empty should be None")

@test
def range-counts() = if count(range(0, 5)) == 5 then unit else trap("range 0..5 has 5 elements")

@test
def range-sums() = if sum(range(1, 5)) == 10 then unit else trap("1+2+3+4 = 10")

@test
def range-empty-when-lo-ge-hi() = if count(range(5, 5)) == 0 then unit else trap("empty range")

@test
def from-list-collects() =
  if int-list-eq(collect-list(from-list([3, 1, 4, 1, 5])), [3, 1, 4, 1, 5]) then
    unit
  else
    trap("collect round-trips the list")

@test
def map-doubles() =
  if int-list-eq(collect-list(map(from-list([1, 2, 3]), fn(x) => x * 2)), [2, 4, 6]) then
    unit
  else
    trap("map *2")

@test
def filter-evens() =
  if int-list-eq(collect-list(filter(range(0, 8), fn(x) => x % 2 == 0)), [0, 2, 4, 6]) then
    unit
  else
    trap("filter evens of 0..8")

@test
def map-filter-sum-pipeline() =
  // 1..5 -> evens[2,4] -> doubled[4,8] -> sum 12
  if sum(map(filter(range(1, 5), fn(x) => x % 2 == 0), fn(x) => x * 2)) == 12 then
    unit
  else
    trap("pipeline should be 12")

@test
def take-is-lazy-over-a-huge-range() =
  // take 3 of a million-element range pulls exactly 3 — laziness observable in what is produced
  if int-list-eq(collect-list(take(range(0, 1000000), 3)), [0, 1, 2]) then
    unit
  else
    trap("take 3 of a huge range")

@test
def drop-skips() =
  if int-list-eq(collect-list(drop(range(0, 6), 4)), [4, 5]) then unit else trap("drop 4 of 0..6")

@test
def take-while-stops-at-first-failure() =
  if int-list-eq(collect-list(take-while(from-list([2, 4, 5, 6]), fn(x) => x % 2 == 0)), [2, 4]) then
    unit
  else
    trap("take-while even stops at 5")

@test
def find-hits() = match find(range(0, 10), fn(x) => x > 5) with
  | Option.Some(v) => if v == 6 then unit else trap("first > 5 is 6")
  | Option.None(_) => trap("should find 6")

@test
def find-misses() = match find(range(0, 3), fn(x) => x > 5) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("nothing > 5 in 0..3")

@test
def any-true() = if any(range(0, 5), fn(x) => x == 3) then unit else trap("3 is in 0..5")

@test
def all-true() = if all(range(0, 5), fn(x) => x < 100) then unit else trap("all < 100")

@test
def all-false() = if all(range(0, 5), fn(x) => x < 3) then trap("4 is not < 3") else unit

/// EMPTY-SOURCE EDGE for the predicate/search consumers — the degenerate boundary where vacuous-truth
/// bugs hide. `empty()` yields `None` on the first `next`, so each consumer's base arm value IS the
/// observable result: `any` → false (no witness), `all` → true (vacuously — no counterexample),
/// `count`/`count-where` → 0, `find`/`position` → None, `contains` → false. Pinned so a future change
/// to a consumer's base arm (or a fusion/step-layer rewrite) can't silently flip a vacuous case — the
/// classic `all []` → false off-by-one. (Mirrors the same pins in adapter.cdz.)
@test
def any-of-empty-is-false() =
  if any(empty(), fn(x) => x > 0) then trap("any empty() must be false (no witness)") else unit

@test
def all-of-empty-is-vacuously-true() =
  if all(empty(), fn(x) => x > 0) then unit else trap("all empty() must be vacuously true")

@test
def count-of-empty-is-zero() = if count(empty()) == 0 then unit else trap("count empty() = 0")

@test
def count-where-of-empty-is-zero() =
  if count-where(empty(), fn(x) => x > 0) == 0 then unit else trap("count-where empty() = 0")

@test
def find-of-empty-is-none() = match find(empty(), fn(x) => x > 0) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("find empty() must be None")

@test
def position-of-empty-is-none() = match position(empty(), 5) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("position empty() must be None")

@test
def contains-in-empty-is-false() =
  if contains(empty(), 5) then trap("contains empty() must be false") else unit

@test
def re-steppable() =
  // an iterator is a value: stepping does not consume it — both reads see the same first element
  let it = range(10, 20) in
  match next(it) with
    | Option.None(_) => trap("should yield")
    | Option.Some(p1) =>
      let (a, _) = p1 in
      match next(it) with
        | Option.None(_) => trap("should still yield")
        | Option.Some(p2) =>
          let (b, _) = p2 in
          if a == 10 then
            if b == 10 then unit else trap("second read differs")
          else
            trap("first read wrong")

@test
def compose-take-drop() =
  // drop 2 then take 2 of 0..10 -> [2,3]
  if int-list-eq(collect-list(take(drop(range(0, 10), 2), 2)), [2, 3]) then
    unit
  else
    trap("drop2 take2")

@test
def chain-concatenates() =
  if int-list-eq(collect-list(chain(from-list([1, 2]), from-list([3, 4]))), [1, 2, 3, 4]) then
    unit
  else
    trap("chain [1,2]++[3,4] = [1,2,3,4]")

@test
def chain-with-empty-left() =
  if int-list-eq(collect-list(chain(empty(), range(0, 3))), [0, 1, 2]) then
    unit
  else
    trap("[]++0..3")

@test
def chain-with-empty-right() =
  if int-list-eq(collect-list(chain(range(0, 3), empty())), [0, 1, 2]) then
    unit
  else
    trap("0..3++[]")

@test
def chain-is-lazy() =
  // take 2 across a chain whose right side is a huge range pulls only from the left
  if int-list-eq(collect-list(take(chain(from-list([7, 8]), range(0, 1000000)), 2)), [7, 8]) then
    unit
  else
    trap("chain take 2")

@test
def zip-with-adds() =
  if int-list-eq(
      collect-list(zip-with(from-list([1, 2, 3]), from-list([10, 20, 30]), fn(x, y) => x + y)),
      [11, 22, 33]
    ) then
    unit
  else
    trap("zip-with + = [11,22,33]")

@test
def zip-with-stops-at-shorter() =
  // left has 5, right has 2 -> only 2 pairs
  if int-list-eq(
      collect-list(zip-with(range(0, 5), from-list([100, 200]), fn(x, y) => x + y)),
      [100, 201]
    ) then
    unit
  else
    trap("zip stops at shorter side")

@test
def zip-with-is-lazy() =
  // both sides huge, take 3 -> only 3 pairs pulled
  if int-list-eq(
      collect-list(take(zip-with(range(0, 1000000), range(0, 1000000), fn(x, y) => x * y), 3)),
      [0, 1, 4]
    ) then
    unit
  else
    trap("zip-with lazy take 3 of squares")

@test
def scan-running-sum() =
  // running sums of 1..5 -> 1,3,6,10
  if int-list-eq(collect-list(scan(range(1, 5), 0, fn(a, x) => a + x)), [1, 3, 6, 10]) then
    unit
  else
    trap("scan running sum = [1,3,6,10]")

@test
def scan-empty-yields-nothing() =
  // scanning an empty source yields nothing (an empty range is the empty producer here — comparing a
  // collected result to the bare `[]` literal hits an unrelated generic-empty-list-eq gap, so assert
  // on the count instead)
  if count(scan(range(5, 5), 0, fn(a, x) => a + x)) == 0 then
    unit
  else
    trap("scan of an empty source is empty")

@test
def scan-is-lazy() =
  // running sum over a huge range, take 3 -> 0,1,3 (seeded 0: 0+0,+1,+2)
  if int-list-eq(collect-list(take(scan(range(0, 1000000), 0, fn(a, x) => a + x), 3)), [0, 1, 3]) then
    unit
  else
    trap("scan lazy take 3")

@test
def iterate-doubles() =
  // 1, 2, 4, 8, 16 — take 5 of the doubling sequence
  if int-list-eq(collect-list(take(iterate(1, fn(x) => x * 2), 5)), [1, 2, 4, 8, 16]) then
    unit
  else
    trap("iterate *2 take 5")

@test
def iterate-is-lazy() =
  // an infinite iterator is only safe because `take` bounds the pull
  if int-list-eq(collect-list(take(iterate(0, fn(x) => x + 3), 4)), [0, 3, 6, 9]) then
    unit
  else
    trap("iterate +3 take 4")

@test
def iterate-take-while() =
  // bound an infinite source with take-while: powers of 2 under 100
  if int-list-eq(
      collect-list(take-while(iterate(1, fn(x) => x * 2), fn(x) => x < 100)),
      [1, 2, 4, 8, 16, 32, 64]
    ) then
    unit
  else
    trap("powers of 2 under 100")

@test
def last-of-range() = match last(range(0, 5)) with
  | Option.Some(v) => if v == 4 then unit else trap("last of 0..5 is 4")
  | Option.None(_) => trap("should have a last")

@test
def last-of-empty() = match last(empty()) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("empty has no last")

@test
def nth-hits() = match nth(range(10, 20), 3) with
  | Option.Some(v) => if v == 13 then unit else trap("nth 3 of 10.. is 13")
  | Option.None(_) => trap("should have index 3")

@test
def nth-past-end() = match nth(range(0, 3), 5) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("no index 5 in 0..3")

@test
def max-finds-largest() = match max(from-list([3, 1, 4, 1, 5, 9, 2, 6])) with
  | Option.Some(v) => if v == 9 then unit else trap("max is 9")
  | Option.None(_) => trap("should have a max")

@test
def min-finds-smallest() = match min(from-list([3, 1, 4, 1, 5, 9, 2, 6])) with
  | Option.Some(v) => if v == 1 then unit else trap("min is 1")
  | Option.None(_) => trap("should have a min")

@test
def max-of-empty() = match max(empty()) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("empty has no max")

@test
def min-of-empty() = match min(empty()) with
  // mirror of max-of-empty: min's base arm is None on an empty source. Pinned so a step-layer/fusion
  // rewrite can't silently flip the empty-reduction result (the same class as `all []` off-by-one).
  | Option.None(_) => unit
  | Option.Some(_) => trap("empty has no min")

@test
def range-inclusive-includes-hi() =
  // 1..=5 -> 1,2,3,4,5 (the endpoint is INCLUDED, unlike the half-open range)
  if int-list-eq(collect-list(range-inclusive(1, 5)), [1, 2, 3, 4, 5]) then
    unit
  else
    trap("range-inclusive 1..=5 = [1,2,3,4,5]")

@test
def range-inclusive-single() =
  // lo == hi is a single-element inclusive range
  if int-list-eq(collect-list(range-inclusive(3, 3)), [3]) then unit else trap("3..=3 = [3]")

@test
def range-inclusive-empty-when-lo-gt-hi() =
  if count(range-inclusive(5, 4)) == 0 then unit else trap("5..=4 is empty")

@test
def range-step-by-two() =
  // 0, 2, 4, 6, 8 — step 2 over [0, 10)   (NB: the test name avoids a numeric kebab segment like
  // `-2`; a segment starting with a digit is not a valid WIT label and silently breaks the whole
  // test component — see the `mlrepro-decline-test-name-numeric-kebab-segment` queue item)
  if int-list-eq(collect-list(range-step(0, 10, 2)), [0, 2, 4, 6, 8]) then
    unit
  else
    trap("range-step 0..10 by 2")

@test
def range-step-overshoots-hi() =
  // step lands past hi: 1, 4, 7 (10 would be >= 10, excluded)
  if int-list-eq(collect-list(range-step(1, 10, 3)), [1, 4, 7]) then
    unit
  else
    trap("range-step 1..10 by 3")

@test
def range-step-nonpositive-yields-nothing() =
  // a zero/negative step never advances — yields nothing rather than looping forever
  if count(range-step(0, 10, 0)) == 0 then unit else trap("step 0 yields nothing")

@test
def range-step-composes-with-map() =
  // the stepped range drops into the existing iterator ops
  if int-list-eq(collect-list(map(range-step(0, 6, 2), fn(x) => x * x)), [0, 4, 16]) then
    unit
  else
    trap("squares of 0,2,4")

@test
def product-of-range() =
  // 1*2*3*4 = 24 (factorial-ish over 1..5)
  if product(range(1, 5)) == 24 then unit else trap("product 1..5 = 24")

@test
def product-of-empty-is-one() =
  // the multiplicative identity, mirroring sum's 0
  if product(empty()) == 1 then unit else trap("product of empty is 1")

@test
def sum-of-empty-is-zero() =
  // the additive identity — the fold seed for an empty source. Pinned alongside product's 1 so the
  // empty-reduction seeds of both folds are guarded symmetrically against a base-arm/seed regression.
  if sum(empty()) == 0 then unit else trap("sum of empty is 0")

@test
def contains-hit() = if contains(range(0, 10), 7) then unit else trap("7 is in 0..10")

@test
def contains-miss() = if contains(range(0, 5), 9) then trap("9 is not in 0..5") else unit

@test
def contains-short-circuits-on-infinite() =
  // an infinite source is searchable because contains stops at the first match
  if contains(iterate(0, fn(x) => x + 1), 100) then unit else trap("100 is reachable")

@test
def range-down-counts-down() =
  // range-down(5, 0) -> 4, 3, 2, 1, 0 (the reverse of range(0, 5))
  if int-list-eq(collect-list(range-down(5, 0)), [4, 3, 2, 1, 0]) then
    unit
  else
    trap("range-down 5..0 = [4,3,2,1,0]")

@test
def range-down-empty-when-hi-le-lo() =
  if count(range-down(3, 3)) == 0 then unit else trap("range-down 3..3 is empty")

@test
def range-down-reverses-range() =
  // range-down(hi, lo) yields exactly range(lo, hi) reversed — check via the shared bound
  if int-list-eq(collect-list(range-down(8, 5)), [7, 6, 5]) then
    unit
  else
    trap("range-down 8..5 = [7,6,5]")

@test
def range-down-composes-with-map() =
  // descending range drops into the existing ops
  if int-list-eq(collect-list(map(range-down(4, 0), fn(x) => x * 2)), [6, 4, 2, 0]) then
    unit
  else
    trap("doubled countdown")

@test
def position-hits() = match position(from-list([10, 20, 30, 40]), 30) with
  | Option.Some(i) => if i == 2 then unit else trap("30 is at index 2")
  | Option.None(_) => trap("should find 30")

@test
def position-first-of-duplicates() = match position(from-list([5, 7, 5, 7]), 5) with
  | Option.Some(i) => if i == 0 then unit else trap("first 5 is at index 0")
  | Option.None(_) => trap("should find 5")

@test
def position-misses() = match position(range(0, 5), 9) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("9 is not in 0..5")

@test
def for-each-visits-every-element() =
  // f traps if it ever sees a value OUTSIDE 0..5, so a clean return proves for-each visited exactly
  // the range's elements (and none beyond it)
  let _ = for-each(range(0, 5), fn(x) =>
      if x >= 0 then if x < 5 then unit else trap("visited too high") else trap("visited too low")) in
  unit

@test
def for-each-over-empty-is-a-noop() =
  let _ = for-each(empty(), fn(_x) => trap("empty should never call f")) in
  unit

// ── Edge-of-range totality (PR #384 regression): `next` must never trap, even abutting Int64.max ──
@test
def range-inclusive-at-int64-max-does-not-overflow() =
  // range-inclusive(max, max) is the single-element range [max]; the old RangeI((lo, hi+1)) form
  // trapped computing max+1. next must yield max then None, never trap.
  match next(range-inclusive(Int64.max, Int64.max)) with
    | Option.None(_) => trap("should yield Int64.max once")
    | Option.Some(p) =>
      let (v, rest) = p in
      if v == Int64.max then
        match next(rest) with
          | Option.None(_) => unit
          | Option.Some(_) => trap("inclusive range at max should have exactly one element")
      else
        trap("first element should be Int64.max")

@test
def range-inclusive-near-max-yields-both-endpoints() =
  // [max-1, max] : two elements, no overflow
  if int-list-eq(
      collect-list(range-inclusive(Int64.max - 1, Int64.max)),
      [Int64.max - 1, Int64.max]
    ) then
    unit
  else
    trap("range-inclusive (max-1)..=max = [max-1, max]")

@test
def range-step-near-int64-max-does-not-overflow() =
  // range-step(max-1, max, 2): yields max-1, then the rest (max-1)+2 would overflow — must terminate
  // cleanly (yield max-1, then None) rather than trap while building the rest iterator.
  if int-list-eq(collect-list(range-step(Int64.max - 1, Int64.max, 2)), [Int64.max - 1]) then
    unit
  else
    trap("range-step near max yields exactly [max-1]")

@test
def range-inclusive-step-free-path-still-totals-near-max() =
  // range-step is HALF-OPEN (hi excluded), so (max-2)..max by 2 yields max-2 then max-2+2==max which
  // is not < max → excluded; result is [max-2]. The point: computing that excluded next value must
  // not trap. (For an inclusive endpoint use range-inclusive.)
  if int-list-eq(collect-list(range-step(Int64.max - 2, Int64.max, 2)), [Int64.max - 2]) then
    unit
  else
    trap("range-step (max-2) step 2, hi=max (half-open) = [max-2]")

@test
def reduce-sums-from-first() =
  // reduce with + over 1..5 seeds with 1 then adds 2,3,4 -> 10
  match reduce(range(1, 5), fn(a, b) => a + b) with
    | Option.Some(v) => if v == 10 then unit else trap("reduce + of 1..5 is 10")
    | Option.None(_) => trap("non-empty should reduce")

@test
def reduce-single-element() = match reduce(from-list([42]), fn(a, b) => a + b) with
  | Option.Some(v) => if v == 42 then unit else trap("single element reduces to itself")
  | Option.None(_) => trap("one element should reduce")

@test
def reduce-empty-is-none() = match reduce(empty(), fn(a, b) => a + b) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("empty has no reduction")

@test
def reduce-can-express-max() =
  // reduce with a max-combiner reproduces `max`
  match reduce(from-list([3, 9, 2, 9, 5]), fn(a, b) => if a > b then a else b) with
    | Option.Some(v) => if v == 9 then unit else trap("reduce-max is 9")
    | Option.None(_) => trap("should reduce")

@test
def max-by-picks-largest-key() =
  // key = distance from 0 (abs via a branch); over [-5, 3, -2, 4] the max |x| is -5
  match max-by(from-list([-5, 3, -2, 4]), fn(x) => if x < 0 then 0 - x else x) with
    | Option.Some(v) => if v == -5 then unit else trap("max |x| element is -5")
    | Option.None(_) => trap("should have a max-by")

@test
def min-by-picks-smallest-key() =
  // key = x*x; the element with the smallest square in [-5, 3, -2, 4] is -2
  match min-by(from-list([-5, 3, -2, 4]), fn(x) => x * x) with
    | Option.Some(v) => if v == -2 then unit else trap("min x^2 element is -2")
    | Option.None(_) => trap("should have a min-by")

@test
def max-by-empty-is-none() = match max-by(empty(), fn(x) => x) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("empty has no max-by")

@test
def min-by-empty-is-none() =
  // mirror of max-by-empty-is-none — the keyed-min base arm on an empty source is None
  match min-by(empty(), fn(x) => x) with
    | Option.None(_) => unit
    | Option.Some(_) => trap("empty has no min-by")

// ── Algebraic laws (cross-combinator invariants a future change must not break) ──────────────────
@test
def law-collect-round-trips-from-list() =
  // collect-list ∘ from-list = identity, for several shapes
  let xs = [7, 0, 0 - 3, 42, 5] in
  if int-list-eq(collect-list(from-list(xs)), xs) then unit else trap("collect ∘ from-list ≠ id")

@test
def law-count-equals-collected-length() =
  // count(it) == length(collect-list(it)) — the two ways of measuring agree
  let it = filter(range(0, 20), fn(x) => x % 3 == 0) in
  if count(it) == count(from-list(collect-list(it))) then unit else trap("count ≠ collected length")

@test
def law-chain-is-associative() =
  // (a ++ b) ++ c  ==  a ++ (b ++ c)
  let a = from-list([1, 2]) in
  let b = from-list([3]) in
  let c = from-list([4, 5]) in
  if int-list-eq(
      collect-list(chain(chain(a, b), c)),
      collect-list(chain(from-list([1, 2]), chain(from-list([3]), from-list([4, 5]))))
    ) then
    unit
  else
    trap("chain not associative")

@test
def law-map-fusion() =
  // map(map(it, g), f) == map(it, f∘g) — mapping twice fuses into one composed map. (Uses two fresh
  // range sources since an iterator is re-steppable but each pipeline consumes its own.)
  if int-list-eq(
      collect-list(map(map(range(0, 6), fn(x) => x + 1), fn(y) => y * 2)),
      collect-list(map(range(0, 6), fn(x) => (x + 1) * 2))
    ) then
    unit
  else
    trap("map fusion law broken")

@test
def law-take-drop-splits() =
  // take(it, n) ++ drop(it, n) reconstructs it (for a finite, re-steppable source)
  let full = collect-list(range(0, 10)) in
  let split = collect-list(chain(take(range(0, 10), 4), drop(range(0, 10), 4))) in
  if int-list-eq(split, full) then unit else trap("take n ++ drop n ≠ whole")

@test
def law-sum-equals-fold-plus() =
  // sum is the + fold; reduce with + over a non-empty range matches sum
  match reduce(range(1, 6), fn(a, b) => a + b) with
    | Option.Some(v) => if v == sum(range(1, 6)) then unit else trap("reduce+ ≠ sum")
    | Option.None(_) => trap("range 1..6 is non-empty")

// laws for the second half of the API (flat-map / scan / zip-with / step-by / intersperse)
@test
def law-flat-map-single-is-map() =
  // flat-map(it, x -> [f(x)]) == map(it, f) — a single-element sub-iterator is exactly a map
  if int-list-eq(
      collect-list(flat-map(range(0, 5), fn(x) => from-list([x * x]))),
      collect-list(map(range(0, 5), fn(x) => x * x))
    ) then
    unit
  else
    trap("flat-map of a singleton ≠ map")

@test
def law-flat-map-with-empty-is-empty() =
  // flat-map(it, _ -> empty) yields nothing, whatever the source
  if count(flat-map(range(0, 10), fn(_x) => empty())) == 0 then
    unit
  else
    trap("flat-map to empty ≠ empty")

@test
def law-scan-last-is-fold() =
  // the LAST element of an inclusive scan equals the full fold with the same seed and combiner
  match last(scan(range(1, 5), 0, fn(a, x) => a + x)) with
    | Option.Some(v) =>
      if v == fold(range(1, 5), 0, fn(a, x) => a + x) then unit else trap("scan-last ≠ fold")
    | Option.None(_) => trap("a non-empty scan has a last")

@test
def law-zip-length-is-min() =
  // count(zip-with(a, b, f)) == min(count a, count b) — the shorter side bounds the result
  if count(zip-with(range(0, 3), range(0, 7), fn(x, y) => x + y)) == 3 then
    unit
  else
    trap("zip length ≠ min")

@test
def law-step-by-one-is-identity() =
  // step-by(it, 1) keeps every element — identical to the source
  if int-list-eq(collect-list(step-by(range(0, 6), 1)), collect-list(range(0, 6))) then
    unit
  else
    trap("step-by 1 ≠ id")

@test
def law-intersperse-length() =
  // intersperse of n elements (n >= 1) yields 2n-1 (n elements + n-1 separators)
  if count(intersperse(range(0, 4), 99)) == 7 then unit else trap("intersperse length ≠ 2n-1")

// ── flat-map (unblocked: the Int64 -> Iter closure now lowers correctly) ─────────────────────────
@test
def flat-map-expands() =
  // each x -> [x, x*10]; [1,2] -> [1,10,2,20]
  if int-list-eq(
      collect-list(flat-map(from-list([1, 2]), fn(x) => from-list([x, x * 10]))),
      [1, 10, 2, 20]
    ) then
    unit
  else
    trap("flat-map [x, x*10]")

@test
def flat-map-with-ranges() =
  // each x -> range(0, x); [1,2,3] -> [0][0,1][0,1,2] = [0,0,1,0,1,2]
  if int-list-eq(
      collect-list(flat-map(from-list([1, 2, 3]), fn(x) => range(0, x))),
      [0, 0, 1, 0, 1, 2]
    ) then
    unit
  else
    trap("flat-map range(0,x)")

@test
def flat-map-skips-empty-subiters() =
  // odd x -> [x], even x -> [] ; [1,2,3,4] -> [1,3]
  if int-list-eq(
      collect-list(
        flat-map(from-list([1, 2, 3, 4]), fn(x) => if x % 2 == 0 then empty() else from-list([x]))
      ),
      [1, 3]
    ) then
    unit
  else
    trap("flat-map with empty sub-iterators")

@test
def flat-map-is-lazy() =
  // each x -> a huge range; take 3 across the flattened stream pulls only 3
  if int-list-eq(
      collect-list(take(flat-map(range(0, 1000000), fn(_x) => range(0, 1000000)), 3)),
      [0, 1, 2]
    ) then
    unit
  else
    trap("flat-map lazy take 3")

@test
def flat-map-coexists-with-scan() =
  // the historical decline: FlatMapI (Int64->Iter) + ScanI (Int64->Int64->Int64) in one program.
  // Both must compile and run now.
  let a = collect-list(flat-map(from-list([1, 2]), fn(x) => from-list([x, x]))) in
  let b = collect-list(scan(range(1, 4), 0, fn(acc, x) => acc + x)) in
  if int-list-eq(a, [1, 1, 2, 2]) then
    if int-list-eq(b, [1, 3, 6]) then unit else trap("scan")
  else
    trap("flat-map")

@test
def intersperse-inserts-between() =
  // [1,2,3] with sep 0 -> [1,0,2,0,3] — no leading/trailing separator
  if int-list-eq(collect-list(intersperse(from-list([1, 2, 3]), 0)), [1, 0, 2, 0, 3]) then
    unit
  else
    trap("intersperse [1,2,3] 0 = [1,0,2,0,3]")

@test
def intersperse-single-element-unchanged() =
  if int-list-eq(collect-list(intersperse(from-list([9]), 0)), [9]) then
    unit
  else
    trap("single stays [9]")

@test
def intersperse-empty-is-empty() =
  if count(intersperse(empty(), 0)) == 0 then unit else trap("intersperse of empty is empty")

@test
def intersperse-two-elements() =
  // exactly one separator between two elements: [5,7] -> [5,0,7]
  if int-list-eq(collect-list(intersperse(from-list([5, 7]), 0)), [5, 0, 7]) then
    unit
  else
    trap("[5,0,7]")

@test
def intersperse-is-lazy() =
  // take 3 of an interspersed huge range pulls only what is needed: [0, 99, 1]
  if int-list-eq(collect-list(take(intersperse(range(0, 1000000), 99), 3)), [0, 99, 1]) then
    unit
  else
    trap("intersperse lazy take 3")

@test
def step-by-every-third() =
  // every 3rd of 0..10 -> 0, 3, 6, 9
  if int-list-eq(collect-list(step-by(range(0, 10), 3)), [0, 3, 6, 9]) then
    unit
  else
    trap("step-by 3 of 0..10 = [0,3,6,9]")

@test
def step-by-one-is-identity() =
  // stride 1 keeps every element
  if int-list-eq(collect-list(step-by(range(0, 5), 1)), [0, 1, 2, 3, 4]) then
    unit
  else
    trap("step-by 1 = id")

@test
def step-by-larger-than-length() =
  // a stride past the end yields just the first element
  if int-list-eq(collect-list(step-by(from-list([7, 8, 9]), 10)), [7]) then
    unit
  else
    trap("stride > len = [first]")

@test
def step-by-nonpositive-yields-nothing() =
  if count(step-by(range(0, 5), 0)) == 0 then unit else trap("stride 0 yields nothing")

@test
def step-by-is-lazy() =
  // every 2nd of a huge range, take 3 -> 0, 2, 4
  if int-list-eq(collect-list(take(step-by(range(0, 1000000), 2), 3)), [0, 2, 4]) then
    unit
  else
    trap("step-by lazy take 3")

// ── Corner cases (empty sides, out-of-range counts, negatives, deep pipelines) ───────────────────
@test
def drop-past-length-is-empty() =
  if count(drop(range(0, 3), 10)) == 0 then unit else trap("drop past the end yields nothing")

@test
def take-zero-is-empty() =
  if count(take(range(0, 100), 0)) == 0 then unit else trap("take 0 yields nothing")

@test
def take-negative-is-empty() =
  if count(take(range(0, 100), -5)) == 0 then
    unit
  else
    trap("take of a negative count yields nothing")

@test
def zip-with-empty-left-side() =
  if count(zip-with(empty(), range(0, 5), fn(a, b) => a + b)) == 0 then
    unit
  else
    trap("zip with empty left")

@test
def zip-with-empty-right-side() =
  if count(zip-with(range(0, 5), empty(), fn(a, b) => a + b)) == 0 then
    unit
  else
    trap("zip with empty right")

@test
def negative-range-counts-up-through-zero() =
  if int-list-eq(collect-list(range(-3, 2)), [-3, -2, -1, 0, 1]) then
    unit
  else
    trap("range(-3, 2) = [-3,-2,-1,0,1]")

@test
def chain-of-two-empties-is-empty() =
  if count(chain(empty(), empty())) == 0 then unit else trap("chain of two empties is empty")

@test
def filter-all-out-is-empty() =
  if count(filter(range(0, 10), fn(x) => x > 100)) == 0 then
    unit
  else
    trap("filter that keeps nothing")

@test
def deep-pipeline-map-filter-take() =
  // squares of the evens in 0..100, first 4 -> [0, 4, 16, 36]
  if int-list-eq(
      collect-list(take(map(filter(range(0, 100), fn(x) => x % 2 == 0), fn(x) => x * x), 4)),
      [0, 4, 16, 36]
    ) then
    unit
  else
    trap("deep map∘filter∘take pipeline")

// ── iter-set: a Set bridges into the iterator (canonical order) ──────────────────────────────────
@test
def iter-set-canonical-order() =
  // {5,2,8,2} -> canonical sorted iteration [2,5,8]
  if int-list-eq(collect-list(iter-set(#(5, 2, 8, 2))), [2, 5, 8]) then
    unit
  else
    trap("iter-set canonical order = [2,5,8]")

@test
def iter-set-count-is-cardinality() =
  // dedup: {3,1,2,1,3} has 3 distinct elements
  if count(iter-set(#(3, 1, 2, 1, 3))) == 3 then unit else trap("iter-set count = 3")

@test
def iter-set-composes-with-transformers() =
  // a set drops into the existing ops: sum of the doubled evens of {1,2,3,4,5,6} = 2*(2+4+6) = 24
  if sum(map(filter(iter-set(#(1, 2, 3, 4, 5, 6)), fn(x) => x % 2 == 0), fn(x) => x * 2)) == 24 then
    unit
  else
    trap("iter-set |> filter even |> map *2 |> sum = 24")

@test
def iter-set-sum-canonical() =
  // sum over an iterated set = sum of its distinct elements: {10,20,30} -> 60
  if sum(iter-set(#(10, 20, 30, 10))) == 60 then unit else trap("iter-set sum = 60")

// ── iter-map-keys / iter-map-values: a Map's keys/values bridge into the iterator ────────────────
@test
def iter-map-keys-canonical-order() =
  // keys of {5:50, 2:20, 8:80} in canonical KEY order -> [2, 5, 8]
  let m = Map.insert(Map.insert(Map.insert(Map.empty(), 5, 50), 2, 20), 8, 80) in
  if int-list-eq(collect-list(iter-map-keys(m)), [2, 5, 8]) then unit else trap("keys = [2,5,8]")

@test
def iter-map-values-in-key-order() =
  // values of {5:50, 2:20, 8:80} paired to canonical key order (2,5,8) -> [20, 50, 80]
  let m = Map.insert(Map.insert(Map.insert(Map.empty(), 5, 50), 2, 20), 8, 80) in
  if int-list-eq(collect-list(iter-map-values(m)), [20, 50, 80]) then
    unit
  else
    trap("values = [20,50,80]")

@test
def iter-map-keys-sum() =
  // keys drop into the consumers: sum of keys {1,2,3} = 6
  let m = Map.insert(Map.insert(Map.insert(Map.empty(), 1, 10), 2, 20), 3, 30) in
  if sum(iter-map-keys(m)) == 6 then unit else trap("key sum = 6")

@test
def iter-map-values-compose() =
  // values compose with transformers: doubled values of {1:2, 2:4} -> [4, 8], sum 12
  let m = Map.insert(Map.insert(Map.empty(), 1, 2), 2, 4) in
  if sum(map(iter-map-values(m), fn(x) => x * 2)) == 12 then unit else trap("2*(2+4) = 12")

@test
def iter-map-keys-empty() =
  // a map with its sole entry removed yields no keys
  let m = Map.remove(Map.insert(Map.empty(), 1, 10), 1) in
  if count(iter-map-keys(m)) == 0 then unit else trap("empty map has no keys")

// ── dedup: drop consecutive duplicates ───────────────────────────────────────────────────────────
@test
def dedup-collapses-runs() =
  // [1,1,2,2,2,3,1,1] -> [1,2,3,1] (consecutive runs collapse; the trailing 1 survives, distinct run)
  if int-list-eq(collect-list(dedup(from-list([1, 1, 2, 2, 2, 3, 1, 1]))), [1, 2, 3, 1]) then
    unit
  else
    trap("dedup runs -> [1,2,3,1]")

@test
def dedup-no-duplicates-unchanged() =
  // already-distinct-neighbors input is unchanged
  if int-list-eq(collect-list(dedup(from-list([1, 2, 3, 4]))), [1, 2, 3, 4]) then
    unit
  else
    trap("no dups")

@test
def dedup-all-same-collapses-to-one() =
  if int-list-eq(collect-list(dedup(from-list([7, 7, 7, 7]))), [7]) then
    unit
  else
    trap("all same -> [7]")

@test
def dedup-empty-is-empty() =
  if count(dedup(empty())) == 0 then unit else trap("dedup of empty is empty")

@test
def dedup-of-sorted-range-is-unchanged() =
  // a range has no equal neighbors, so dedup is identity over it
  if int-list-eq(collect-list(dedup(range(0, 5))), [0, 1, 2, 3, 4]) then
    unit
  else
    trap("range dedup = id")

@test
def dedup-composes-with-map() =
  // map can CREATE adjacent duplicates that dedup then collapses: [1,2,3,4] |> /2 (int) -> [0,1,1,2] -> dedup [0,1,2]
  if int-list-eq(collect-list(dedup(map(from-list([1, 2, 3, 4]), fn(x) => x / 2))), [0, 1, 2]) then
    unit
  else
    trap("dedup after map -> [0,1,2]")

@test
def dedup-is-lazy() =
  // take 3 distinct from a long run-heavy source: [5,5,5,6,6,7,7,7,...] take 3 -> [5,6,7]
  if int-list-eq(collect-list(take(dedup(from-list([5, 5, 5, 6, 6, 7, 7, 7, 8])), 3)), [5, 6, 7]) then
    unit
  else
    trap("dedup lazy take 3")

// ── count-where / is-empty consumers ─────────────────────────────────────────────────────────────
@test
def count-where-evens() =
  // how many evens in 0..10 -> 5 (0,2,4,6,8)
  if count-where(range(0, 10), fn(x) => x % 2 == 0) == 5 then unit else trap("5 evens in 0..10")

@test
def count-where-none-match() =
  if count-where(range(0, 5), fn(x) => x > 100) == 0 then unit else trap("no element > 100")

@test
def count-where-all-match() =
  if count-where(range(0, 4), fn(x) => x >= 0) == 4 then unit else trap("all 4 are >= 0")

@test
def count-where-agrees-with-filter-count() =
  // count-where p == count(filter(it, p)) — the law tying it to the transformer
  if count-where(range(0, 20), fn(x) => x % 3 == 0)
      == count(filter(range(0, 20), fn(x) => x % 3 == 0)) then
    unit
  else
    trap("count-where ≠ count∘filter")

@test
def is-empty-of-empty() = if is-empty(empty()) then unit else trap("empty() is empty")

@test
def is-empty-of-nonempty() = if is-empty(range(0, 3)) then trap("0..3 is not empty") else unit

@test
def is-empty-of-filtered-out() =
  // an iterator whose every element is filtered away is empty
  if is-empty(filter(range(0, 5), fn(x) => x > 100)) then unit else trap("all filtered -> empty")

// ── iter-map-entries: walk (key, value) pairs together in one pass ───────────────────────────────
@test
def entries-fold-key-times-value() =
  // {2:10, 3:100} -> sum of key*value = 2*10 + 3*100 = 320 (key AND value in one pass)
  let m = Map.insert(Map.insert(Map.empty(), 2, 10), 3, 100) in
  if fold-entries(iter-map-entries(m), 0, fn(acc, k, v) => acc + k * v) == 320 then
    unit
  else
    trap("320")

@test
def entries-count-is-entry-count() =
  // {1:_,2:_,3:_} with a dup key -> 3 distinct entries
  let m = Map.insert(Map.insert(Map.insert(Map.insert(Map.empty(), 1, 1), 2, 2), 3, 3), 1, 9) in
  if entry-count(iter-map-entries(m)) == 3 then unit else trap("3 entries")

@test
def entries-canonical-key-order() =
  // first entry (by entry-next) has the smallest key; fold that picks the first key = 2 of {5,2,8}
  let m = Map.insert(Map.insert(Map.insert(Map.empty(), 5, 50), 2, 20), 8, 80) in
  match entry-next(iter-map-entries(m)) with
    | Option.None(_) => trap("nonempty")
    | Option.Some(p) =>
      let (kv, _) = p in
      let (k, v) = kv in
      if k == 2 then
        if v == 20 then unit else trap("first value 20")
      else
        trap("first key should be min 2")

@test
def entries-of-empty-map() =
  let m = Map.remove(Map.insert(Map.empty(), 1, 10), 1) in
  if entry-count(iter-map-entries(m)) == 0 then unit else trap("empty map has no entries")

@test
def entries-sum-keys-matches-iter-map-keys() =
  // fold-entries summing keys agrees with sum(iter-map-keys …) — the two map views are consistent
  let m = Map.insert(Map.insert(Map.insert(Map.empty(), 4, 40), 6, 60), 2, 20) in
  if fold-entries(iter-map-entries(m), 0, fn(acc, k, _v) => acc + k) == sum(iter-map-keys(m)) then
    unit
  else
    trap("entry-key-sum ≠ iter-map-keys sum")

// ── enumerate: pair each element with its index ──────────────────────────────────────────────────
@test
def enumerate-index-dot-value() =
  // enumerate [10,20,30] -> (0,10),(1,20),(2,30); sum of index*value = 0 + 20 + 60 = 80
  if fold-entries(enumerate(from-list([10, 20, 30])), 0, fn(acc, i, v) => acc + i * v) == 80 then
    unit
  else
    trap("sum i*v = 80")

@test
def enumerate-count-matches-length() =
  // enumerate produces one pair per element
  if entry-count(enumerate(range(0, 7))) == 7 then unit else trap("7 pairs")

@test
def enumerate-first-index-is-zero() =
  // the first pair's index is 0 and its value is the source's first element
  match entry-next(enumerate(from-list([42, 43]))) with
    | Option.None(_) => trap("nonempty")
    | Option.Some(p) =>
      let (kv, _) = p in
      let (i, v) = kv in
      if i == 0 then if v == 42 then unit else trap("first value 42") else trap("first index 0")

@test
def enumerate-empty() =
  if entry-count(enumerate(empty())) == 0 then unit else trap("enumerate of empty is empty")

@test
def enumerate-over-a-transformed-iter() =
  // enumerate composes after a transformer: evens of 0..10 = [0,2,4,6,8], indexed, sum of index = 0+1+2+3+4=10
  if fold-entries(enumerate(filter(range(0, 10), fn(x) => x % 2 == 0)), 0, fn(acc, i, _v) => acc + i)
      == 10 then
    unit
  else
    trap("index sum of 5 evens = 10")

@test
def enumerate-of-bounded-infinite() =
  // an infinite source bounded by take first, then enumerated: take 3 of iterate*2 = [1,2,4] -> indices 0,1,2
  if fold-entries(enumerate(take(iterate(1, fn(x) => x * 2), 3)), 0, fn(acc, i, _v) => acc + i) == 3 then
    unit
  else
    trap("index sum 0+1+2 = 3")

// ── pairwise: adjacent (prev, cur) pairs ─────────────────────────────────────────────────────────
@test
def pairwise-deltas-telescope() =
  // [1,2,4,7] -> (1,2),(2,4),(4,7); sum of (cur-prev) = 1+2+3 = 6 (telescopes to last-first = 7-1)
  if fold-entries(pairwise(from-list([1, 2, 4, 7])), 0, fn(acc, prev, cur) => acc + (cur - prev))
      == 6 then
    unit
  else
    trap("delta sum = 6")

@test
def pairwise-count-is-one-less-than-length() =
  // 5 elements -> 4 adjacent pairs
  if entry-count(pairwise(from-list([10, 20, 30, 40, 50]))) == 4 then unit else trap("4 pairs")

@test
def pairwise-singleton-has-no-pairs() =
  if entry-count(pairwise(from-list([9]))) == 0 then unit else trap("singleton -> 0 pairs")

@test
def pairwise-empty-has-no-pairs() =
  if entry-count(pairwise(empty())) == 0 then unit else trap("empty -> 0 pairs")

@test
def pairwise-first-pair() =
  // the first pair is (elem0, elem1)
  match entry-next(pairwise(from-list([3, 5, 8]))) with
    | Option.None(_) => trap("should have a pair")
    | Option.Some(p) =>
      let (kv, _) = p in
      let (a, b) = kv in
      if a == 3 then if b == 5 then unit else trap("second is 5") else trap("first is 3")

@test
def pairwise-over-a-range() =
  // pairwise(range(0,5)) deltas are all 1: sum = 4 (four pairs, each cur-prev == 1)
  if fold-entries(pairwise(range(0, 5)), 0, fn(acc, prev, cur) => acc + (cur - prev)) == 4 then
    unit
  else
    trap("range deltas sum = 4")

// ── zip-to-entries: element-wise pairs of two iterators ──────────────────────────────────────────
@test
def zip-entries-dot-product() =
  // zip [1,2,3] with [10,20,30] -> (1,10),(2,20),(3,30); dot product = 10+40+90 = 140
  if fold-entries(zip-to-entries(from-list([1, 2, 3]), from-list([10, 20, 30])), 0, fn(acc, x, y) =>
        acc + x * y) == 140 then
    unit
  else
    trap("dot product = 140")

@test
def zip-entries-stops-at-shorter() =
  // range(0,5) zip [100,200] -> only 2 pairs (the shorter side bounds it)
  if entry-count(zip-to-entries(range(0, 5), from-list([100, 200]))) == 2 then
    unit
  else
    trap("2 pairs")

@test
def zip-entries-empty-side() =
  if entry-count(zip-to-entries(empty(), range(0, 9))) == 0 then
    unit
  else
    trap("empty side -> 0 pairs")

@test
def zip-entries-first-pair() = match entry-next(
    zip-to-entries(from-list([7, 8]), from-list([70, 80]))
  ) with
  | Option.None(_) => trap("should have a pair")
  | Option.Some(p) =>
    let (kv, _) = p in
    let (x, y) = kv in
    if x == 7 then if y == 70 then unit else trap("second is 70") else trap("first is 7")

@test
def zip-entries-bounds-infinite() =
  // both sides infinite: zip iterate(1,*2) with range(0,inf-ish), take-bound the LEFT to 3 -> 3 pairs
  if entry-count(zip-to-entries(take(iterate(1, fn(x) => x * 2), 3), range(0, 1000000))) == 3 then
    unit
  else
    trap("bounded zip -> 3 pairs")

/// A minimal thunk (`Unit -> a` closure boxed into a heap sum) — the shape the thunk-based iterator
/// `Iter(a) = Susp(Unit -> Option (a, Iter(a)))` would use. It once DECLINED ("a closure's parameter type
/// has no machine representation"); kept here only to pin that the gap is fixed (see the ENCODING note).
type Susp =
  | Thunk(Unit -> Int64)

def force-susp(s: Susp) =
  let Susp.Thunk(f) = s in
  f(unit)

@test
def unit-param-closure-boxed-regression() =
  // REGRESSION: a Unit-parameter closure boxed into a heap sum (`Susp.Thunk(fn(_) => 42)`) once declined
  // at emit. Must now compile and force to its value — this is why the thunk-based iterator is expressible.
  if force-susp(Susp.Thunk(fn(_u) => 42)) == 42 then unit else trap("forced thunk yields 42")

export { Iter.* }
