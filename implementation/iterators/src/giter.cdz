def intersperse-singleton-has-no-separator() =
  if int-list-eq(collect(intersperse(from-list([7]), 0)), [7]) then
    unit
  else
    trap("intersperse singleton unchanged")

@test
def intersperse-empty-is-empty() =
  if count(intersperse(take(from-list([1]), 0), 0)) == 0 then
    unit
  else
    trap("intersperse empty is empty")

/// SLICE-12: `step-by` — closure-free, keeps every n-th element from index 0, pinned at two element types,
/// the identity (n=1) case, and the `n <= 0` degenerate (which is ALSO the identity — see `step-by`'s doc).
@test
def step-by-keeps-every-second-int() =
  if int-list-eq(collect(step-by(from-list([1, 2, 3, 4, 5, 6]), 2)), [1, 3, 5]) then
    unit
  else
    trap("step-by 2 over ints")

@test
def step-by-one-is-identity-strings() =
  if str-list-eq(collect(step-by(from-list(["a", "b", "c"]), 1)), ["a", "b", "c"]) then
    unit
  else
    trap("step-by 1 is identity (String source)")

@test
def step-by-three-keeps-first-and-fourth() =
  if int-list-eq(collect(step-by(from-list([1, 2, 3, 4, 5, 6, 7]), 3)), [1, 4, 7]) then
    unit
  else
    trap("step-by 3 keeps indices 0,3,6")

/// `step-by(it, 0)` (and any `n <= 0`) degenerates to the IDENTITY, not "just the first element": the reset
/// countdown `n - 1` never goes positive, so every element yields. Pins the true behavior the docstring now
/// describes (a v-iterators review caught the old comment claiming it kept only the first) — benign, no trap.
@test
def step-by-zero-degenerates-to-identity() =
  if int-list-eq(collect(step-by(from-list([1, 2, 3, 4]), 0)), [1, 2, 3, 4]) then
    unit
  else
    trap("step-by 0 is the identity (keeps all)")

/// SLICE-13: `position` — closure-storing, the 0-based index of the first predicate match (the index sibling
/// of `find`), pinned at two element types, a miss, and the first-element hit.
@test
def position-finds-first-matching-int-index() = match position(from-list([10, 20, 30]), fn(x) =>
    x == 20) with
  | Option.None(_) => trap("position int must find")
  | Option.Some(i) => if i == 1 then unit else trap("position int index")

