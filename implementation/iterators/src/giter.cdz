    unit
  else
    trap("count-if none match")

/// EMPTY-SOURCE EDGE for the predicate/search consumers — the degenerate boundary where vacuous-truth
/// bugs hide. giter is a materialized cons-cell, so `take(from-list([1]), 0)` is the TYPED empty (a
/// `GIter.Nil` at a fixed element type — a bare `empty()`/unconstrained `GIter.Nil` at these consumers
/// declines CDZ0201, correct-to-reject; see the header note). Each consumer's `Nil` arm value IS the
/// observable result: `all` → true (vacuously), `any` → false, `count`/`count-if` → 0, `find`/`position`
/// → None. Pinned so a future `Nil`-arm change can't silently flip a vacuous case (the classic `all []`
/// → false). Mirrors the same pins in adapter.cdz + iter.cdz.
@test
def all-of-empty-is-vacuously-true() =
  if all(take(from-list([1]), 0), fn(x) => x > 0) then
    unit
  else
    trap("all empty must be vacuously true")

@test
def any-of-empty-is-false() =
  if any(take(from-list([1]), 0), fn(x) => x > 0) then trap("any empty must be false") else unit

@test
def count-of-empty-is-zero() =
  if count(take(from-list([1]), 0)) == 0 then unit else trap("count empty = 0")

@test
def count-if-of-empty-is-zero() =
  if count-if(take(from-list([1]), 0), fn(x) => x > 0) == 0 then
    unit
  else
    trap("count-if empty = 0")

@test
def find-of-empty-is-none() = match find(take(from-list([1]), 0), fn(x) => x > 0) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("find empty must be None")

@test
def position-of-empty-is-none() = match position(take(from-list([1]), 0), fn(x) => x > 0) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("position empty must be None")

// last / last-where complete the empty-source block: both have a GIter.Nil base arm returning None (the
// same base-arm-on-empty class as find/position above — their non-empty hits/misses are pinned, but the
// empty source was not). Typed-empty via take(from-list([1]), 0) like the rest of the block.
@test
def last-of-empty-is-none() = match last(take(from-list([1]), 0)) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("last empty must be None")

@test
def last-where-of-empty-is-none() = match last-where(take(from-list([1]), 0), fn(x) => x > 0) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("last-where empty must be None")

/// SLICE-17: `map-while` — closure-storing, fused map + take-while over an Option-returning closure
/// (element-changing), pinned at two source element types, the stop-at-None, and the all-Some cases.
@test
def map-while-stops-at-first-none-ints() =
  if int-list-eq(
      collect(
        map-while(from-list([1, 2, 3, 4]), fn(x) =>
          if x < 3 then Option.Some(x * 10) else Option.None(unit))
      ),
      [10, 20]
    ) then
    unit
  else
    trap("map-while stops at first None")

@test
def map-while-all-some-maps-every-element-strings() =
  if int-list-eq(
      collect(map-while(from-list(["a", "bb", "ccc"]), fn(s) => Option.Some(String.byte-len(s)))),
      [1, 2, 3]
    ) then
    unit
  else
    trap("map-while String source, all Some")

@test
def map-while-first-none-is-empty() =
  // (The `x * 10` payload is incidental — an identity `Some(x)` also composes now that rcdzc `565f6d184`
  // resolved the former identity-closure residual; kept as-is since it still exercises the first-None stop.)
  if count(
        map-while(from-list([5, 1, 2]), fn(x) =>
          if x < 3 then Option.Some(x * 10) else Option.None(unit))
      ) == 0 then
    unit
  else
    trap("map-while first element None is empty")

/// SLICE-18: `interleave` — closure-free, alternate two iterators then append the remainder, pinned at two
/// element types and the uneven-length case.
@test
def interleave-alternates-ints() =
  if int-list-eq(
      collect(interleave(from-list([1, 3, 5]), from-list([2, 4, 6]))),
      [1, 2, 3, 4, 5, 6]
    ) then
    unit
  else
    trap("interleave alternates ints")

@test
def interleave-appends-remainder-when-uneven() =
  if int-list-eq(collect(interleave(from-list([1, 3, 5]), from-list([2]))), [1, 2, 3, 5]) then
    unit
  else
    trap("interleave uneven appends remainder")

@test
def interleave-strings-second-source-type() =
  if str-list-eq(collect(interleave(from-list(["a", "c"]), from-list(["b"]))), ["a", "b", "c"]) then
    unit
  else
    trap("interleave String source (2nd element type)")

/// SLICE-21: `last-where` — closure-storing, the last predicate match (the from-the-end `find`), pinned at
/// two element types and a miss.
@test
def last-where-finds-last-matching-int() = match last-where(from-list([1, 2, 3, 4]), fn(x) => x < 4) with
  | Option.None(_) => trap("last-where int must find")
  | Option.Some(v) => if v == 3 then unit else trap("last-where int value")

@test
def last-where-finds-last-matching-string() = match last-where(from-list(["a", "bb", "c"]), fn(s) =>
    String.byte-len(s) == 1) with
  | Option.None(_) => trap("last-where str must find")
  | Option.Some(v) => if v == "c" then unit else trap("last-where str value")

@test
def last-where-miss-is-none() = match last-where(from-list([1, 2, 3]), fn(x) => x > 100) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("last-where miss must be None")

/// SLICE-22: `span-len` — closure-storing consumer, the leading-run length (Int64 result), pinned at two
/// element types, all-pass, and first-fail edges.
@test
def span-len-counts-leading-run-ints() =
  if span-len(from-list([1, 2, 5, 1]), fn(x) => x < 3) == 2 then unit else trap("span-len ints")

@test
def span-len-strings-second-source-type() =
  if span-len(from-list(["a", "b", "cc"]), fn(s) => String.byte-len(s) == 1) == 2 then
    unit
  else
    trap("span-len String source (2nd element type)")

@test
def span-len-first-fails-is-zero() =
  if span-len(from-list([9, 1, 2]), fn(x) => x < 3) == 0 then
    unit
  else
    trap("span-len first-fail is zero")

export { GIter.* }
