def position-finds-first-matching-string-index() = match position(from-list(["a", "bb", "ccc"]), fn(s) =>
    String.byte-len(s) == 3) with
  | Option.None(_) => trap("position str must find")
  | Option.Some(i) => if i == 2 then unit else trap("position str index")

@test
def position-miss-is-none() = match position(from-list([1, 2, 3]), fn(x) => x > 100) with
  | Option.None(_) => unit
  | Option.Some(_) => trap("position miss must be None")

@test
def position-first-element-hit-is-zero() = match position(from-list([5, 6, 7]), fn(x) => x == 5) with
  | Option.None(_) => trap("position first hit must find")
  | Option.Some(i) => if i == 0 then unit else trap("position first hit index 0")

