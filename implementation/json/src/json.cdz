// A REAL pure-userspace Cadenza JSON codec (operator directive 2026-09-13, 759/761/776): a genuine
// recursive-descent tokenizer+parser and a structural encoder, over the guest Bytes primitives ONLY — the
// compiler and runtime stay JSON-unaware. This REPLACES the #8933 byte-scan stopgap
// (cdz-platform/guests/json-lib.cdz), which merely substring-searched for known tokens and spliced byte
// literals; this one parses the full JSON grammar into a value AST and serializes it back.
//
// TWO OPERATOR REFINEMENTS (776) shape the design:
//   * PARSER uses BINARY PATTERN MATCHING (`b[...]`) — "exactly what we built it for - parsers." The parser
//     matches byte patterns / literal bytes / structural tokens directly and threads the REMAINING bytes as
//     a `bytes(rest)` tail binding, rather than a manual Int64 cursor + Bytes.at. It reads cleanly: e.g.
//     `| b[u8(110), u8(117), u8(108), u8(108), bytes(rest)] => ...` matches the literal bytes of `null`.
//   * NUMBERS are LOSSLESS via BigInt (NOT f64, NOT verbatim-only). A JSON number is an exact decimal
//     value = (if neg then -1 else 1) * coeff * 10^exp10, where `coeff` is a BigInt (arbitrary precision —
//     every significant digit, exact) and `exp10` an Int64 power of ten. `raw` retains the canonical byte
//     form for trivial lossless re-emit (e.g. echoing a JSON-RPC `id` verbatim). Accessors (I6) derive an
//     Int64 / BigInt / Float64 on demand. (Option B, eager i64/f64, was rejected as lossy.)
//
// BUILD ORDER (gated increments, one per landing):
//   I1 — value type (BigInt-backed Num) + whitespace + literals (null/true/false) + `parse` entry   [THIS SLICE]
//   I2 — string decode (escapes " \ / b f n r t and \uXXXX incl surrogate pairs)
//   I3 — number decode (int / frac / exp / negatives -> BigInt coeff + exp10, spec validation)
//   I4 — array + object (recursive nesting)
//   I5 — encoder (Json -> Bytes, correct escaping; BigInt -> decimal digits) + round-trip tests
//   I6 — accessors (get / index / as-int64 / as-bigint / as-float / as-string) + JSON-RPC convenience
//   I7 — migrate mcp-server + a2a-server off the stopgap (coordinate v-hivemind), retire json-lib exports
//
// Self-contained: imports nothing but the prelude, so a guest that adds src/json.cdz to its `libs` manifest
// drags in no schemas (exactly like the stopgap it replaces).

// ── The JSON value AST (a recursive sum; the whole type is declared up front, filled in across I1-I4) ───────
// JStr and an object key hold the DECODED UTF-8 bytes (escapes already resolved), NOT the raw quoted token.
type Json =
  | JNull
  | JBool(Bool)
  | JNum(Num)
  | JStr(Bytes)
  | JArr(List(Json))
  | JObj(List(Member))

// A lossless JSON number: value = (if neg then -1 else 1) * coeff * 10^exp10. `coeff` is an arbitrary-
// precision BigInt magnitude (all significant digits, exact); `exp10` shifts the decimal point; `raw` is the
// canonical byte rendering (the verbatim input slice for a parsed number) for exact re-emit. (Filled by I3.)
type Num = | Num(Record(neg: Bool, coeff: BigInt, exp10: Int64, raw: Bytes))

// One object member: a decoded-string key and its value (a single-constructor sum used as a struct — the
// checker-lib `Pair` idiom).
type Member = | Member(Record(key: Bytes, value: Json))

// ── Parse state ─────────────────────────────────────────────────────────────────────────────────────────
// A parse step consumes a prefix of the input and yields either a value + the REMAINING bytes, or a parse
// error. The remaining bytes are threaded via binary matching's `bytes(rest)` tail. Internal (not exported).
type Parsed =
  | POk(Record(value: Json, rest: Bytes))
  | PErr

// The result of decoding a string body: the decoded (escape-resolved) bytes + the bytes after the closing
// quote, or a parse error. Internal.
type StrParsed =
  | SOk(Record(str: Bytes, rest: Bytes))
  | SErr

// The result of parsing a number: the lossless Num + the bytes after it, or a parse error. Internal.
type NumParsed =
  | NOk(Record(num: Num, rest: Bytes))
  | NErr

// A run of decimal digits accumulated into a BigInt `coeff` with their `count`, plus the remaining bytes.
// Internal (the digit-accumulation carrier for the number parser).
type Digits =
  | Digits(Record(coeff: BigInt, count: Int64, rest: Bytes))

// The result of parsing an array's elements / an object's members: the collected list + the bytes after the
// closing bracket, or a parse error. Internal (carriers for the recursive container parsers).
type ArrParsed =
  | AOk(Record(elems: List(Json), rest: Bytes))
  | AErr
type ObjParsed =
  | OOk(Record(members: List(Member), rest: Bytes))
  | OErr

// ── Whitespace ──────────────────────────────────────────────────────────────────────────────────────────
// Drop leading JSON insignificant whitespace — space (32), tab (9), line feed (10), carriage return (13) —
// and return the remaining bytes. A clean recursive binary match: peel one whitespace byte, recurse on rest.
def skip-ws(inp: Bytes) -> Bytes =
  (match inp with
   | b[u8(32), bytes(rest)] => skip-ws(rest)
   | b[u8(9), bytes(rest)]  => skip-ws(rest)
   | b[u8(10), bytes(rest)] => skip-ws(rest)
   | b[u8(13), bytes(rest)] => skip-ws(rest)
   | _ => inp)

// ── Strings ─────────────────────────────────────────────────────────────────────────────────────────────
// Append one decoded byte to the accumulator, the IDEAL way (operator 781: write the ideal code, file the
// gap, do NOT work around). NOTE: this currently hits a seed codegen bug — CDZ0910 "expected i32, found i64"
// (a `bin`-bound UInt8 used as a Bytes.of list element is mis-widthed). Filed to v-binary-matching, fix in
// flight; this ideal form passes once it lands. Until then the wasm gate (cad-test-json) is RED here BY DESIGN.
def push-byte(acc: Bytes, c: UInt8) -> Bytes =
  Bytes.concat(acc, Bytes.of([c]))

// Decode a string BODY (input is the bytes AFTER the opening quote), accumulating escape-resolved bytes into
// `acc`. A closing quote (34) ends it; a backslash (92) begins an escape; a raw control byte (< 32) is
// invalid per JSON (they must be escaped); any other byte — including a UTF-8 continuation byte — is copied
// verbatim. Running out of input before the closing quote is an unterminated-string error.
//   (\uXXXX unicode escapes arrive in I2b; until then a `\u` is an invalid escape and rejects.)
def parse-str(inp: Bytes, acc: Bytes) -> StrParsed =
  (match inp with
   | b[u8(34), bytes(rest)]  => StrParsed.SOk({ str = acc, rest = rest })
   | b[u8(92), bytes(after)] => parse-escape(after, acc)
   | b[u8(c), bytes(rest)]   =>
       if c < 32 then StrParsed.SErr
       else parse-str(rest, push-byte(acc, c))
   | _ => StrParsed.SErr)

// Decode the character AFTER a backslash and continue the string body. The eight JSON escapes:
//   \" (34)  \\ (92)  \/ (47)  \b -> backspace (8)  \f -> formfeed (12)  \n (10)  \r (13)  \t (9)
// Any other escape byte (or end of input) is an invalid escape.
def parse-escape(inp: Bytes, acc: Bytes) -> StrParsed =
  (match inp with
   | b[u8(34), bytes(rest)]  => parse-str(rest, push-byte(acc, 34))
   | b[u8(92), bytes(rest)]  => parse-str(rest, push-byte(acc, 92))
   | b[u8(47), bytes(rest)]  => parse-str(rest, push-byte(acc, 47))
   | b[u8(98), bytes(rest)]  => parse-str(rest, push-byte(acc, 8))
   | b[u8(102), bytes(rest)] => parse-str(rest, push-byte(acc, 12))
   | b[u8(110), bytes(rest)] => parse-str(rest, push-byte(acc, 10))
   | b[u8(114), bytes(rest)] => parse-str(rest, push-byte(acc, 13))
   | b[u8(116), bytes(rest)] => parse-str(rest, push-byte(acc, 9))
   | b[u8(117), u8(h1), u8(h2), u8(h3), u8(h4), bytes(rest)] =>
       (match hex4(h1, h2, h3, h4) with
        | Option.None      => StrParsed.SErr
        | Option.Some(cu)  => parse-unicode(cu, rest, acc))
   | _ => StrParsed.SErr)

// ── I2b: unicode escapes (\uXXXX + surrogate pairs) ─────────────────────────────────────────────────────
// The numeric value 0..15 of a hex digit byte, or None if it is not a hex digit ('0'-'9' 'A'-'F' 'a'-'f').
def hex-val(b: UInt8) -> Option(Int64) =
  if b >= 48 and b <= 57 then Option.Some(Int64.of(b) - 48)
  else if b >= 65 and b <= 70 then Option.Some(Int64.of(b) - 55)
  else if b >= 97 and b <= 102 then Option.Some(Int64.of(b) - 87)
  else Option.None

// Decode four hex-digit bytes (big-endian) into a 16-bit code UNIT (0..65535), or None if any is not hex.
def hex4(b1: UInt8, b2: UInt8, b3: UInt8, b4: UInt8) -> Option(Int64) =
  (match hex-val(b1) with
   | Option.None => Option.None
   | Option.Some(v1) =>
       (match hex-val(b2) with
        | Option.None => Option.None
        | Option.Some(v2) =>
            (match hex-val(b3) with
             | Option.None => Option.None
             | Option.Some(v3) =>
                 (match hex-val(b4) with
                  | Option.None => Option.None
                  | Option.Some(v4) => Option.Some(v1 * 4096 + v2 * 256 + v3 * 16 + v4)))))

// UTF-8 encode a Unicode scalar value `cp` (0..0x10FFFF, non-surrogate) into its 1–4 bytes. Byte fields are
// masked (`/`,`%` by powers of 64) so each provably fits a UInt8; UInt8.of is the checked (ideal) narrowing.
def utf8(cp: Int64) -> Bytes =
  if cp < 128 then Bytes.of([UInt8.of(cp)])
  else if cp < 2048 then
    Bytes.of([UInt8.of(192 + cp / 64), UInt8.of(128 + cp % 64)])
  else if cp < 65536 then
    Bytes.of([UInt8.of(224 + cp / 4096), UInt8.of(128 + (cp / 64) % 64), UInt8.of(128 + cp % 64)])
  else
    Bytes.of([UInt8.of(240 + cp / 262144), UInt8.of(128 + (cp / 4096) % 64), UInt8.of(128 + (cp / 64) % 64), UInt8.of(128 + cp % 64)])

// Resolve a decoded \uXXXX code unit `cu` to a scalar, handling UTF-16 surrogate pairs, then emit its UTF-8
// bytes and continue the string body. A HIGH surrogate (0xD800..0xDBFF) MUST be followed by a `\u` LOW
// surrogate (0xDC00..0xDFFF): combined to a supplementary scalar. A lone low surrogate, or a high surrogate
// not followed by a valid low `\u`, is an invalid escape sequence.
def parse-unicode(cu: Int64, rest: Bytes, acc: Bytes) -> StrParsed =
  if cu >= 55296 and cu <= 56319 then
    (match rest with
     | b[u8(92), u8(117), u8(l1), u8(l2), u8(l3), u8(l4), bytes(rest2)] =>
         (match hex4(l1, l2, l3, l4) with
          | Option.None => StrParsed.SErr
          | Option.Some(lo) =>
              if lo >= 56320 and lo <= 57343 then
                let cp = 65536 + (cu - 55296) * 1024 + (lo - 56320) in
                parse-str(rest2, Bytes.concat(acc, utf8(cp)))
              else StrParsed.SErr)
     | _ => StrParsed.SErr)
  else if cu >= 56320 and cu <= 57343 then StrParsed.SErr
  else parse-str(rest, Bytes.concat(acc, utf8(cu)))

// ── I3: numbers (lossless, BigInt-backed) ───────────────────────────────────────────────────────────────
// A JSON number is  -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?  and is stored LOSSLESSLY as
// value = (if neg then -1 else 1) * coeff * 10^exp10:  `coeff` accumulates EVERY significant digit (integer
// and fraction, concatenated) as a BigInt; `exp10` = (explicit exponent) - (number of fraction digits).
// The verbatim token is retained as `raw`.

// Accumulate consecutive decimal-digit bytes into a BigInt coefficient, counting them; stop at the first
// non-digit (returning it as `rest`).
def parse-digits(inp: Bytes, coeff: BigInt, count: Int64) -> Digits =
  (match inp with
   | b[u8(d), bytes(rest)] =>
       if d >= 48 and d <= 57 then
         parse-digits(rest, coeff * 10N + BigInt.of(Int64.of(d) - 48), count + 1)
       else Digits({ coeff = coeff, count = count, rest = inp })
   | _ => Digits({ coeff = coeff, count = count, rest = inp }))

// Parse a number token from the front of `inp` (whose first byte is '-' or a digit). `orig` is retained for
// slicing the verbatim `raw`. Threads through int -> frac -> exp, validating the JSON grammar at each stage.
def parse-number(inp: Bytes) -> NumParsed =
  (match inp with
   | b[u8(45), bytes(rest)] => parse-int(true, rest, inp)
   | _ => parse-int(false, inp, inp))

// Integer part, enforcing the no-leading-zero rule: a lone '0' is fine (and may be followed by '.'/'e'/end),
// but '0' immediately followed by another digit is invalid; '1'-'9' consumes the whole digit run.
def parse-int(neg: Bool, inp: Bytes, orig: Bytes) -> NumParsed =
  (match inp with
   | b[u8(48), bytes(rest)] =>
       (match rest with
        | b[u8(d2), bytes(_)] =>
            if d2 >= 48 and d2 <= 57 then NumParsed.NErr
            else parse-frac(neg, 0N, 0, rest, orig)
        | _ => parse-frac(neg, 0N, 0, rest, orig))
   | b[u8(d), bytes(_)] =>
       if d >= 49 and d <= 57 then
         (match parse-digits(inp, 0N, 0) with
          | Digits(di) => parse-frac(neg, di.coeff, 0, di.rest, orig))
       else NumParsed.NErr
   | _ => NumParsed.NErr)

// Optional fraction: a '.' MUST be followed by at least one digit. Each fraction digit extends `coeff` and
// decrements `exp10` by one.
def parse-frac(neg: Bool, coeff: BigInt, exp10: Int64, inp: Bytes, orig: Bytes) -> NumParsed =
  (match inp with
   | b[u8(46), bytes(rest)] =>
       (match parse-digits(rest, coeff, 0) with
        | Digits(di) =>
            if di.count == 0 then NumParsed.NErr
            else parse-exp(neg, di.coeff, exp10 - di.count, di.rest, orig))
   | _ => parse-exp(neg, coeff, exp10, inp, orig))

// Optional exponent introducer 'e'/'E'.
def parse-exp(neg: Bool, coeff: BigInt, exp10: Int64, inp: Bytes, orig: Bytes) -> NumParsed =
  (match inp with
   | b[u8(101), bytes(rest)] => parse-exp-sign(neg, coeff, exp10, rest, orig)
   | b[u8(69), bytes(rest)]  => parse-exp-sign(neg, coeff, exp10, rest, orig)
   | _ => finish-number(neg, coeff, exp10, inp, orig))

// Optional exponent sign.
def parse-exp-sign(neg: Bool, coeff: BigInt, exp10: Int64, inp: Bytes, orig: Bytes) -> NumParsed =
  (match inp with
   | b[u8(43), bytes(rest)] => parse-exp-digits(neg, coeff, exp10, true, rest, orig)
   | b[u8(45), bytes(rest)] => parse-exp-digits(neg, coeff, exp10, false, rest, orig)
   | _ => parse-exp-digits(neg, coeff, exp10, true, inp, orig))

// Exponent digits (at least one required); folds the explicit exponent into `exp10`.
def parse-exp-digits(neg: Bool, coeff: BigInt, exp10: Int64, epos: Bool, inp: Bytes, orig: Bytes) -> NumParsed =
  (match parse-digits(inp, 0N, 0) with
   | Digits(di) =>
       if di.count == 0 then NumParsed.NErr
       else
         let ev = Int64.of(di.coeff) in
         finish-number(neg, coeff, (if epos then exp10 + ev else exp10 - ev), di.rest, orig))

// Assemble the Num, slicing the verbatim `raw` token (the bytes of `orig` consumed before `rest`).
def finish-number(neg: Bool, coeff: BigInt, exp10: Int64, rest: Bytes, orig: Bytes) -> NumParsed =
  (match Bytes.slice(orig, 0, Bytes.len(orig) - Bytes.len(rest)) with
   | Option.Some(raw) => NumParsed.NOk({ num = Num.Num({ neg = neg, coeff = coeff, exp10 = exp10, raw = raw }), rest = rest })
   | Option.None      => NumParsed.NErr)

// ── The value dispatch ──────────────────────────────────────────────────────────────────────────────────
// Parse a single JSON value from the front of `inp` (after leading whitespace). I1 recognizes the three
// keyword literals by matching their exact bytes; strings/numbers/arrays/objects are added in I2-I4 (until
// then a non-literal front is a PErr). No trailing-delimiter check here — the top-level `parse` requires
// end-of-input, and a value inside a container (I4) is followed by a required ',' / ']' / '}', so a bareword
// like `truer` is rejected there (its `rest` is non-empty / non-delimiter).
//   null  = 110 117 108 108        true  = 116 114 117 101        false = 102 97 108 115 101
def parse-value(inp: Bytes) -> Parsed =
  let s = skip-ws(inp) in
  (match s with
   | b[u8(110), u8(117), u8(108), u8(108), bytes(rest)] =>
       Parsed.POk({ value = Json.JNull, rest = rest })
   | b[u8(116), u8(114), u8(117), u8(101), bytes(rest)] =>
       Parsed.POk({ value = Json.JBool(true), rest = rest })
   | b[u8(102), u8(97), u8(108), u8(115), u8(101), bytes(rest)] =>
       Parsed.POk({ value = Json.JBool(false), rest = rest })
   | b[u8(34), bytes(after)] =>
       (match parse-str(after, b"") with
        | StrParsed.SOk(sp) => Parsed.POk({ value = Json.JStr(sp.str), rest = sp.rest })
        | StrParsed.SErr    => Parsed.PErr)
   | b[u8(91), bytes(after)]  => parse-array(after)
   | b[u8(123), bytes(after)] => parse-object(after)
   | b[u8(45), bytes(_)] => number-value(s)
   | b[u8(dd), bytes(_)] =>
       if dd >= 48 and dd <= 57 then number-value(s) else Parsed.PErr
   | _ => Parsed.PErr)

// Dispatch a number value: parse the token and wrap it, or fail.
def number-value(s: Bytes) -> Parsed =
  (match parse-number(s) with
   | NumParsed.NOk(n) => Parsed.POk({ value = Json.JNum(n.num), rest = n.rest })
   | NumParsed.NErr   => Parsed.PErr)

// ── I4: arrays + objects (recursive, mutually recursive with parse-value) ───────────────────────────────
// An array is  [ ws (value (ws , ws value)*)? ws ]  — `inp` is the bytes AFTER the opening '['.
def parse-array(inp: Bytes) -> Parsed =
  (match skip-ws(inp) with
   | b[u8(93), bytes(rest)] => Parsed.POk({ value = Json.JArr([]), rest = rest })
   | _ =>
       (match parse-array-elems(inp) with
        | ArrParsed.AErr    => Parsed.PErr
        | ArrParsed.AOk(a)  => Parsed.POk({ value = Json.JArr(a.elems), rest = a.rest })))

// Parse one element, then either ',' (more) or ']' (done). Builds the list forward via [head, .. tail].
def parse-array-elems(inp: Bytes) -> ArrParsed =
  (match parse-value(inp) with
   | Parsed.PErr    => ArrParsed.AErr
   | Parsed.POk(r)  =>
       (match skip-ws(r.rest) with
        | b[u8(93), bytes(rest)] => ArrParsed.AOk({ elems = [r.value], rest = rest })
        | b[u8(44), bytes(rest)] =>
            (match parse-array-elems(rest) with
             | ArrParsed.AErr   => ArrParsed.AErr
             | ArrParsed.AOk(a) => ArrParsed.AOk({ elems = [r.value, .. a.elems], rest = a.rest }))
        | _ => ArrParsed.AErr))

// An object is  { ws (string ws : ws value (ws , ws string ws : ws value)*)? ws }  — `inp` is AFTER '{'.
def parse-object(inp: Bytes) -> Parsed =
  (match skip-ws(inp) with
   | b[u8(125), bytes(rest)] => Parsed.POk({ value = Json.JObj([]), rest = rest })
   | _ =>
       (match parse-object-members(inp) with
        | ObjParsed.OErr   => Parsed.PErr
        | ObjParsed.OOk(o) => Parsed.POk({ value = Json.JObj(o.members), rest = o.rest })))

// Parse one "key": value member (key MUST be a JSON string), then ',' (more) or '}' (done).
def parse-object-members(inp: Bytes) -> ObjParsed =
  (match skip-ws(inp) with
   | b[u8(34), bytes(after)] =>
       (match parse-str(after, b"") with
        | StrParsed.SErr   => ObjParsed.OErr
        | StrParsed.SOk(k) =>
            (match skip-ws(k.rest) with
             | b[u8(58), bytes(afterc)] =>
                 (match parse-value(afterc) with
                  | Parsed.PErr   => ObjParsed.OErr
                  | Parsed.POk(v) =>
                      (match skip-ws(v.rest) with
                       | b[u8(125), bytes(rest)] =>
                           ObjParsed.OOk({ members = [Member.Member({ key = k.str, value = v.value })], rest = rest })
                       | b[u8(44), bytes(rest)] =>
                           (match parse-object-members(rest) with
                            | ObjParsed.OErr   => ObjParsed.OErr
                            | ObjParsed.OOk(o) =>
                                ObjParsed.OOk({ members = [Member.Member({ key = k.str, value = v.value }), .. o.members], rest = o.rest }))
                       | _ => ObjParsed.OErr))
             | _ => ObjParsed.OErr))
   | _ => ObjParsed.OErr)

// ── The public decode entry ─────────────────────────────────────────────────────────────────────────────
// Parse a complete JSON document: one value, optionally surrounded by whitespace, with NO trailing garbage.
// Returns None on any malformed input (a real parse, not a substring probe). `b[]` matches an empty tail —
// i.e. the value consumed the whole (whitespace-trimmed) input.
def parse(inp: Bytes) -> Option(Json) =
  (match parse-value(inp) with
   | Parsed.POk(r) =>
       (match skip-ws(r.rest) with
        | b[] => Option.Some(r.value)
        | _   => Option.None)
   | Parsed.PErr => Option.None)

// ── Early accessors (the accessor surface grows in I6) ──────────────────────────────────────────────────
def is-null(v: Json) -> Bool =
  (match v with | Json.JNull => true | _ => false)

// The boolean of a JBool, or None for any other value shape.
def as-bool(v: Json) -> Option(Bool) =
  (match v with | Json.JBool(b) => Option.Some(b) | _ => Option.None)

// The decoded (escape-resolved, UTF-8) bytes of a JStr, or None for any other value shape.
def as-str-bytes(v: Json) -> Option(Bytes) =
  (match v with | Json.JStr(s) => Option.Some(s) | _ => Option.None)

// The lossless Num of a JNum, or None for any other value shape. (Richer numeric accessors — as-int64 /
// as-bigint / as-float — arrive in I6; Num's fields are directly readable meanwhile.)
def num-of(v: Json) -> Option(Num) =
  (match v with | Json.JNum(n) => Option.Some(n) | _ => Option.None)

// The elements of a JArr, or None for any other value shape.
def as-array(v: Json) -> Option(List(Json)) =
  (match v with | Json.JArr(xs) => Option.Some(xs) | _ => Option.None)

// The members of a JObj, or None for any other value shape.
def as-object(v: Json) -> Option(List(Member)) =
  (match v with | Json.JObj(ms) => Option.Some(ms) | _ => Option.None)

// ── Tests (executed by `cdz test implementation/json`, gated as check cad-test-json) ────────────────────
// A @test def returns unit on success and traps on failure (the ast.cdz idiom).

def parses-null(inp: Bytes) -> Bool =
  (match parse(inp) with | Option.Some(v) => is-null(v) | Option.None => false)

def parses-bool(inp: Bytes, want: Bool) -> Bool =
  (match parse(inp) with
   | Option.Some(v) => (match as-bool(v) with | Option.Some(b) => b == want | Option.None => false)
   | Option.None => false)

def rejects(inp: Bytes) -> Bool =
  (match parse(inp) with | Option.None => true | Option.Some(_) => false)

def parses-str(inp: Bytes, want: Bytes) -> Bool =
  (match parse(inp) with
   | Option.Some(v) => (match as-str-bytes(v) with | Option.Some(s) => s == want | Option.None => false)
   | Option.None => false)

@test
def t-null() =
  if parses-null(b"null") then unit else trap("`null` parses to JNull")

@test
def t-true() =
  if parses-bool(b"true", true) then unit else trap("`true` parses to JBool(true)")

@test
def t-false() =
  if parses-bool(b"false", false) then unit else trap("`false` parses to JBool(false)")

@test
def t-leading-ws() =
  if parses-null(b"   null") then unit else trap("leading whitespace before a value is skipped")

@test
def t-trailing-ws() =
  if parses-bool(b"true   ", true) then unit else trap("trailing whitespace after a value is allowed")

@test
def t-surrounding-mixed-ws() =
  if parses-bool(b" \t\r\n false \n ", false) then unit
  else trap("space/tab/CR/LF around a value are all insignificant whitespace")

@test
def t-reject-empty() =
  if rejects(b"") then unit else trap("empty input is not a JSON document")

@test
def t-reject-only-ws() =
  if rejects(b"   ") then unit else trap("whitespace-only input has no value")

@test
def t-reject-trailing-garbage() =
  if rejects(b"null null") then unit else trap("a second value after the first is trailing garbage")

@test
def t-reject-bareword-suffix() =
  if rejects(b"truer") then unit else trap("`truer` is not the literal `true` — trailing `r` is garbage")

@test
def t-reject-truncated-literal() =
  if rejects(b"nul") then unit else trap("a truncated keyword `nul` does not parse")

@test
def t-reject-unknown-token() =
  if rejects(b"None") then unit else trap("an unknown token is rejected (numbers arrive in I3)")

// ── I2a: string decoding (simple escapes; \uXXXX arrives in I2b) ─────────────────────────────────────────

@test
def t-str-plain() =
  if parses-str(b"\"hello\"", b"hello") then unit else trap("a plain string decodes to its bytes")

@test
def t-str-empty() =
  if parses-str(b"\"\"", b"") then unit else trap("the empty string decodes to empty bytes")

@test
def t-str-escaped-quote() =
  if parses-str(b"\"a\\\"b\"", b"a\"b") then unit else trap("\\\" decodes to a literal quote")

@test
def t-str-escaped-backslash() =
  if parses-str(b"\"a\\\\b\"", b"a\\b") then unit else trap("\\\\ decodes to a single backslash")

@test
def t-str-escaped-solidus() =
  if parses-str(b"\"a\\/b\"", b"a/b") then unit else trap("\\/ decodes to a solidus")

@test
def t-str-escaped-controls() =
  // \n \t \r \b \f decode to LF(10) TAB(9) CR(13) BS(8) FF(12); build the expected bytes explicitly with
  // b[u8(N)] rather than relying on b"..." literal escapes for \b/\f (their byte-literal meaning is not assumed).
  let want =
    Bytes.concat(b[u8(10)],
      Bytes.concat(b[u8(9)],
        Bytes.concat(b[u8(13)],
          Bytes.concat(b[u8(8)], b[u8(12)])))) in
  if parses-str(b"\"\\n\\t\\r\\b\\f\"", want) then unit
  else trap("\\n \\t \\r \\b \\f decode to LF TAB CR BS FF")

@test
def t-str-surrounding-ws-and-trailing() =
  if parses-str(b"  \"hi\"  ", b"hi") then unit else trap("a string value tolerates surrounding whitespace")

@test
def t-str-reject-unterminated() =
  if rejects(b"\"abc") then unit else trap("a string with no closing quote is rejected")

@test
def t-str-reject-lone-backslash() =
  if rejects(b"\"abc\\\"") then unit else trap("a trailing backslash (escaping the closing quote) leaves the string unterminated")

@test
def t-str-reject-bad-escape() =
  if rejects(b"\"a\\xb\"") then unit else trap("\\x is not a valid JSON escape")

@test
def t-str-reject-raw-control() =
  // a literal newline (byte 10) inside a string is a raw control char — JSON requires it be escaped
  if rejects(b"\"a\nb\"") then unit else trap("a raw control character inside a string is rejected")

// ── I2b: unicode escape tests (\uXXXX + surrogate pairs) ────────────────────────────────────────────────

@test
def t-uni-ascii() =
  // \u0041 -> "A" (U+0041, one UTF-8 byte)
  if parses-str(b"\"\\u0041\"", b"A") then unit else trap("\\u0041 decodes to A")

@test
def t-uni-mixed() =
  // surrounding literal chars: "a\u0041b" -> "aAb"
  if parses-str(b"\"a\\u0041b\"", b"aAb") then unit else trap("\\u0041 amid literals decodes to A")

@test
def t-uni-two-byte() =
  // \u00e9 -> é (U+00E9) -> UTF-8 0xC3 0xA9 (195 169)
  if parses-str(b"\"\\u00e9\"", Bytes.of([195, 169])) then unit else trap("\\u00e9 -> C3 A9")

@test
def t-uni-three-byte() =
  // \u20ac -> € (U+20AC) -> UTF-8 0xE2 0x82 0xAC (226 130 172)
  if parses-str(b"\"\\u20ac\"", Bytes.of([226, 130, 172])) then unit else trap("\\u20ac -> E2 82 AC")

@test
def t-uni-uppercase-hex() =
  // hex digits are case-insensitive: \u20AC == \u20ac
  if parses-str(b"\"\\u20AC\"", Bytes.of([226, 130, 172])) then unit else trap("\\u20AC (uppercase) -> E2 82 AC")

@test
def t-uni-surrogate-pair() =
  // \uD83D\uDE00 -> 😀 (U+1F600) -> UTF-8 0xF0 0x9F 0x98 0x80 (240 159 152 128)
  if parses-str(b"\"\\uD83D\\uDE00\"", Bytes.of([240, 159, 152, 128])) then unit
  else trap("\\uD83D\\uDE00 surrogate pair -> U+1F600 -> F0 9F 98 80")

@test
def t-uni-reject-lone-high() =
  // a high surrogate not followed by a \u low surrogate is invalid
  if rejects(b"\"\\uD83D\"") then unit else trap("a lone high surrogate is rejected")

@test
def t-uni-reject-lone-low() =
  // a low surrogate with no preceding high surrogate is invalid
  if rejects(b"\"\\uDE00\"") then unit else trap("a lone low surrogate is rejected")

@test
def t-uni-reject-high-then-nonlow() =
  // high surrogate followed by a NON-surrogate \u escape is invalid
  if rejects(b"\"\\uD83D\\u0041\"") then unit else trap("a high surrogate followed by a non-low \\u is rejected")

@test
def t-uni-reject-bad-hex() =
  if rejects(b"\"\\u00zz\"") then unit else trap("\\u with non-hex digits is rejected")

@test
def t-uni-reject-truncated() =
  // only three hex digits before the closing quote
  if rejects(b"\"\\u041\"") then unit else trap("\\u with fewer than four hex digits is rejected")

// ── I3: number tests (lossless BigInt: value = sign * coeff * 10^exp10) ─────────────────────────────────

def parses-num(inp: Bytes, wneg: Bool, wcoeff: Int64, wexp10: Int64) -> Bool =
  (match parse(inp) with
   | Option.Some(v) =>
       (match num-of(v) with
        | Option.Some(n) =>
            (match n with
             | Num.Num(r) => (r.neg == wneg) and (Int64.of(r.coeff) == wcoeff) and (r.exp10 == wexp10))
        | Option.None => false)
   | Option.None => false)

def parses-num-raw(inp: Bytes, wraw: Bytes) -> Bool =
  (match parse(inp) with
   | Option.Some(v) =>
       (match num-of(v) with
        | Option.Some(n) => (match n with | Num.Num(r) => r.raw == wraw)
        | Option.None => false)
   | Option.None => false)

@test
def t-num-zero() =
  if parses-num(b"0", false, 0, 0) then unit else trap("0 -> coeff 0, exp10 0")

@test
def t-num-int() =
  if parses-num(b"42", false, 42, 0) then unit else trap("42 -> coeff 42, exp10 0")

@test
def t-num-neg() =
  if parses-num(b"-42", true, 42, 0) then unit else trap("-42 -> neg, coeff 42")

@test
def t-num-frac() =
  // 3.14 -> coeff 314, exp10 -2  (value 314 * 10^-2)
  if parses-num(b"3.14", false, 314, 0 - 2) then unit else trap("3.14 -> coeff 314, exp10 -2")

@test
def t-num-exp() =
  if parses-num(b"1e3", false, 1, 3) then unit else trap("1e3 -> coeff 1, exp10 3")

@test
def t-num-frac-exp() =
  // 1.5e2 -> coeff 15, exp10 (2 - 1) = 1  (value 150)
  if parses-num(b"1.5e2", false, 15, 1) then unit else trap("1.5e2 -> coeff 15, exp10 1")

@test
def t-num-neg-frac() =
  // -0.001 -> neg, coeff 1, exp10 -3
  if parses-num(b"-0.001", true, 1, 0 - 3) then unit else trap("-0.001 -> neg coeff 1 exp10 -3")

@test
def t-num-cap-e-neg() =
  if parses-num(b"1E-2", false, 1, 0 - 2) then unit else trap("1E-2 -> coeff 1 exp10 -2")

@test
def t-num-exp-plus() =
  if parses-num(b"6e+1", false, 6, 1) then unit else trap("6e+1 -> coeff 6 exp10 1")

@test
def t-num-raw() =
  if parses-num-raw(b"3.14", b"3.14") then unit else trap("the verbatim token 3.14 is retained as raw")

@test
def t-num-raw-neg() =
  if parses-num-raw(b"-42", b"-42") then unit else trap("the verbatim token -42 is retained as raw")

@test
def t-num-trailing-ws() =
  if parses-num(b"  42  ", false, 42, 0) then unit else trap("a number tolerates surrounding whitespace")

@test
def t-num-reject-leading-zero() =
  if rejects(b"01") then unit else trap("a leading zero (01) is not a valid JSON number")

@test
def t-num-reject-no-int() =
  if rejects(b".5") then unit else trap("a number must have an integer part (.5 is invalid)")

@test
def t-num-reject-bare-dot() =
  if rejects(b"1.") then unit else trap("a '.' must be followed by at least one digit")

@test
def t-num-reject-empty-exp() =
  if rejects(b"1e") then unit else trap("an exponent must have at least one digit")

@test
def t-num-reject-lone-minus() =
  if rejects(b"-") then unit else trap("a lone minus is not a number")

@test
def t-num-reject-plus() =
  if rejects(b"+5") then unit else trap("a leading plus is not a valid JSON number")

@test
def t-num-reject-double-dot() =
  if rejects(b"1.2.3") then unit else trap("1.2.3 has trailing garbage after the number")

@test
def t-num-reject-trailing-garbage() =
  if rejects(b"42x") then unit else trap("42x has trailing garbage")

// ── I4: array + object tests (recursive nesting) ────────────────────────────────────────────────────────

def arr-len(inp: Bytes) -> Int64 =
  (match parse(inp) with
   | Option.Some(v) => (match as-array(v) with | Option.Some(xs) => List.len(xs) | Option.None => 0 - 1)
   | Option.None => 0 - 1)

def obj-len(inp: Bytes) -> Int64 =
  (match parse(inp) with
   | Option.Some(v) => (match as-object(v) with | Option.Some(ms) => List.len(ms) | Option.None => 0 - 1)
   | Option.None => 0 - 1)

// The key bytes of the first member of a parsed object, or None.
def obj-key0(inp: Bytes) -> Option(Bytes) =
  (match parse(inp) with
   | Option.Some(v) =>
       (match as-object(v) with
        | Option.Some(ms) =>
            (match List.at(ms, 0) with
             | Option.Some(m) => (match m with | Member.Member(r) => Option.Some(r.key))
             | Option.None => Option.None)
        | Option.None => Option.None)
   | Option.None => Option.None)

@test
def t-arr-empty() =
  if arr-len(b"[]") == 0 then unit else trap("[] is an empty array")

@test
def t-arr-one() =
  if arr-len(b"[1]") == 1 then unit else trap("[1] has one element")

@test
def t-arr-three() =
  if arr-len(b"[1,2,3]") == 3 then unit else trap("[1,2,3] has three elements")

@test
def t-arr-mixed() =
  // [true, null, "x"] — three elements of different kinds
  (match parse(b"[true, null, \"x\"]") with
   | Option.Some(v) =>
       (match as-array(v) with
        | Option.Some(xs) => if List.len(xs) == 3 then unit else trap("mixed array len 3")
        | Option.None => trap("is array"))
   | Option.None => trap("[true, null, \"x\"] parses"))

@test
def t-arr-ws() =
  if arr-len(b"[ 1 , 2 ]") == 2 then unit else trap("whitespace between array tokens is insignificant")

@test
def t-arr-nested() =
  // [[1],[2,3]] — outer len 2; second inner element is an array of len 2
  (match parse(b"[[1],[2,3]]") with
   | Option.Some(v) =>
       (match as-array(v) with
        | Option.Some(xs) =>
            (match List.at(xs, 1) with
             | Option.Some(inner) =>
                 (match as-array(inner) with
                  | Option.Some(ys) => if List.len(ys) == 2 then unit else trap("inner array len 2")
                  | Option.None => trap("inner is an array"))
             | Option.None => trap("outer has a 2nd element"))
        | Option.None => trap("outer is an array"))
   | Option.None => trap("[[1],[2,3]] parses"))

@test
def t-obj-empty() =
  if obj-len(b"{}") == 0 then unit else trap("{} is an empty object")

@test
def t-obj-one() =
  if obj-len(b"{\"a\":1}") == 1 then unit else trap("{\"a\":1} has one member")

@test
def t-obj-two() =
  if obj-len(b"{\"a\":1,\"b\":2}") == 2 then unit else trap("two members")

@test
def t-obj-key() =
  (match obj-key0(b"{\"name\":true}") with
   | Option.Some(k) => if k == b"name" then unit else trap("first key is 'name'")
   | Option.None => trap("object has a first key"))

@test
def t-obj-ws() =
  if obj-len(b"{ \"a\" : 1 }") == 1 then unit else trap("whitespace around object tokens is insignificant")

@test
def t-obj-nested() =
  // {"a":{"b":2}} — one member whose value is an object of one member
  (match parse(b"{\"a\":{\"b\":2}}") with
   | Option.Some(v) =>
       (match as-object(v) with
        | Option.Some(ms) =>
            (match List.at(ms, 0) with
             | Option.Some(m) =>
                 (match m with
                  | Member.Member(r) =>
                      (match as-object(r.value) with
                       | Option.Some(inner) => if List.len(inner) == 1 then unit else trap("inner object len 1")
                       | Option.None => trap("member value is an object")))
             | Option.None => trap("object has a member"))
        | Option.None => trap("outer is an object"))
   | Option.None => trap("{\"a\":{\"b\":2}} parses"))

@test
def t-obj-array-value() =
  // {"arr":[1,2]} — member value is an array of len 2
  (match parse(b"{\"arr\":[1,2]}") with
   | Option.Some(v) =>
       (match as-object(v) with
        | Option.Some(ms) =>
            (match List.at(ms, 0) with
             | Option.Some(m) =>
                 (match m with
                  | Member.Member(r) =>
                      (match as-array(r.value) with
                       | Option.Some(xs) => if List.len(xs) == 2 then unit else trap("array value len 2")
                       | Option.None => trap("member value is an array")))
             | Option.None => trap("object has a member"))
        | Option.None => trap("is an object"))
   | Option.None => trap("{\"arr\":[1,2]} parses"))

@test
def t-arr-reject-trailing-comma() =
  if rejects(b"[1,]") then unit else trap("a trailing comma in an array is rejected")

@test
def t-arr-reject-missing-comma() =
  if rejects(b"[1 2]") then unit else trap("two array elements need a comma between them")

@test
def t-arr-reject-unterminated() =
  if rejects(b"[1,") then unit else trap("an unterminated array is rejected")

@test
def t-arr-reject-bare-open() =
  if rejects(b"[") then unit else trap("a lone [ is rejected")

@test
def t-obj-reject-unquoted-key() =
  if rejects(b"{a:1}") then unit else trap("an unquoted object key is rejected")

@test
def t-obj-reject-missing-colon() =
  if rejects(b"{\"a\" 1}") then unit else trap("a missing colon is rejected")

@test
def t-obj-reject-trailing-comma() =
  if rejects(b"{\"a\":1,}") then unit else trap("a trailing comma in an object is rejected")

@test
def t-obj-reject-bare-open() =
  if rejects(b"{") then unit else trap("a lone { is rejected")

export { Json.*, Num.*, Member.*, parse, is-null, as-bool, as-str-bytes, num-of, as-array, as-object }
